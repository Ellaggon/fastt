    "test:tours:playwright": "FASTT_DATA_ENV=test playwright test",
    "test:tours:playwright:ui": "FASTT_DATA_ENV=test playwright test --ui",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "db:pg:generate-initial": "tsx scripts/db/generate-postgres-initial-migration.ts",
    "db:explain:provider-integrations": "tsx scripts/db/explain-provider-integration-operations.ts",
