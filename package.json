    "check:ui:staged": "node scripts/check-ui-raw-objects.mjs --staged",
    "prepare": "husky",
    "test:search": "FASTT_DATA_ENV=test vitest tests/search tests/integration/search-v2.test.ts tests/integration/search-availability.test.ts",
    "test:marketplace:certification": "FASTT_DATA_ENV=test vitest run tests/shared/data-environment.test.ts tests/marketplace/public-data-isolation.test.ts tests/marketplace/public-marketplace-certification.test.ts tests/marketplace/public-destination-routes.test.ts tests/ui/marketplace-listing-surface.test.ts tests/pricing/price-quote-contract.test.ts tests/catalog/tour-p0a-flows.test.ts",
