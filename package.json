    "test:postgres": "FASTT_DATA_ENV=test vitest run tests/postgres",
    "db:validate:tour-category-backfill": "tsx scripts/db/validate-tour-category-backfill-idempotent.ts",
    "db:validate:tour-p2-trust": "tsx scripts/db/validate-tour-p2-trust-idempotent.ts",
    "test:tours:phase6": "FASTT_DATA_ENV=test TOURS_CHECKOUT_ENABLED=true TOURS_REFUND_HOURS_ENABLED=true TOURS_CHECKIN_ENABLED=true TOURS_PUBLIC_SEARCH_ENABLED=true TOURS_ROLLOUT_STAGE=general TOURS_ROLLOUT_MIN_DWELL_MS=0 node --import dotenv/config ./node_modules/vitest/vitest.mjs run tests/integration/tour-booking-e2e.test.ts tests/policies/cancellation-hours-deadline.test.ts tests/integration/tour-check-in-and-guest-trip.test.ts tests/integration/tour-discovery-filters.test.ts tests/integration/tour-p2-runtime-trust.test.ts tests/integration/vertical-maturity.test.ts tests/catalog/tour-ops-admin-quality.test.ts tests/catalog/tour-feature-flags.test.ts tests/catalog/tour-rollout-observability.test.ts tests/catalog/tour-rollout-canary.test.ts tests/catalog/tour-pdp-browser-surface.test.ts tests/catalog/tour-ticket-occupancy.test.ts tests/catalog/tour-canary-observation.test.ts tests/catalog/tour-prometheus-rules.test.ts tests/catalog/tour-redis-multipod.test.ts tests/catalog/tour-slot-profile.test.ts tests/catalog/tour-difficulty.test.ts tests/catalog/tour-p0a-flows.test.ts tests/guardrails/no-manual-occupancy-key.test.ts tests/guardrails/tour-public-surfaces.test.ts tests/guardrails/tour-p3-deferred-capabilities.test.ts",
    "test:governance": "FASTT_DATA_ENV=test FASTT_ENFORCE_PROVIDER_GOVERNANCE=1 vitest run tests/integration/provider-governance.test.ts tests/integration/provider-payment-accounts.test.ts tests/integration/provider-admin-compliance.test.ts tests/integration/provider-phase2-maturity.test.ts",
    "test:invite-email": "FASTT_DATA_ENV=test vitest run tests/integration/provider-invite-accept-email.e2e.test.ts tests/ui/provider-invite-email.test.ts",
    "check:email-staging": "tsx src/scripts/check-email-staging-ready.ts",
    "smoke:invite-resend": "tsx src/scripts/smoke-provider-invitation-resend.ts",
    "query:settings-funnel": "tsx src/scripts/query-settings-funnel.ts",
    "query:integration-ux": "tsx src/scripts/query-provider-integration-ux.ts",
    "bootstrap:channex-staging": "tsx src/scripts/bootstrap-channex-staging.ts",
    "bootstrap:channex-certification": "tsx src/scripts/bootstrap-channex-certification-fixture.ts",
    "run:channex-certification-full-sync": "tsx src/scripts/run-channex-certification-full-sync.ts",
    "run:channex-certification-incrementals": "tsx src/scripts/run-channex-certification-incrementals.ts",
    "smoke:channex-staging": "tsx src/scripts/smoke-channex-staging.ts",
    "perf:html-budget": "node scripts/perf/html-budget.mjs",
    "perf:infra-region": "node scripts/perf/infra-region-compare.mjs",
    "perf:pagespeed": "node scripts/perf/pagespeed-public.mjs",
    "test": "FASTT_DATA_ENV=test vitest"
