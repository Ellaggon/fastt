---
import MarketplaceDestinationResults from "@/components/marketplace/MarketplaceDestinationResults.astro"
import {
	getPublicDestinationListings,
	resolvePublicDestination,
} from "@/lib/marketplace/publicDestinationListings"
import {
	publicSearchHref,
	type PublicMarketplaceVertical,
} from "@/lib/marketplace/publicDestinationRoutes"

const rawVertical = Astro.params.vertical ?? ""
const vertical: PublicMarketplaceVertical | null =
	rawVertical === "alojamientos" || rawVertical === "tours" ? rawVertical : null
if (!vertical) return Astro.redirect("/", 308)

const sourceDestination = Astro.url.searchParams.get("destino")
const resolvedDestination = await resolvePublicDestination(sourceDestination)
const canonicalPath = resolvedDestination?.canonicalPath ?? null
if (canonicalPath && Astro.url.searchParams.get("destino") !== canonicalPath) {
	return Astro.redirect(publicSearchHref(vertical, Astro.url.searchParams, canonicalPath), 308)
}

const { destination, listings } = canonicalPath
	? await getPublicDestinationListings({ path: canonicalPath, vertical })
	: { destination: null, listings: [] }
---

<MarketplaceDestinationResults
	vertical={vertical}
	destination={destination}
	listings={listings}
	searchParams={Astro.url.searchParams}
/>
