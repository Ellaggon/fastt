---
import UILayout from "@/layouts/UILayout.astro"
---

<UILayout title="Buscar viviendas completas">
	<main class="mx-auto max-w-3xl space-y-4 px-4 py-10">
		<h1 class="text-3xl font-semibold text-slate-950">Buscar viviendas completas</h1>
		<p class="text-slate-600">
			Abre una propiedad para consultar sus fechas, huéspedes, precio y condiciones de reserva.
		</p>
		<a
			class="inline-flex rounded border border-slate-300 px-4 py-2 font-medium text-slate-800"
			href="/homes">Ver viviendas</a
		>
	</main>
</UILayout>
