---
import MarketplaceListingSurface from "@/components/marketplace/MarketplaceListingSurface.astro"
import {
	publicDestinationHref,
	publicGeoPlacePath,
} from "@/lib/marketplace/publicDestinationRoutes"

const destinationHref = (place: string) =>
	publicDestinationHref(publicGeoPlacePath(place), "alojamientos")

const popularDestinations = [
	{ label: "La Paz", href: destinationHref("geo:bo:la-paz-city") },
	{ label: "Uyuni", href: destinationHref("geo:bo:uyuni") },
	{ label: "Santa Cruz", href: destinationHref("geo:bo:santa-cruz-de-la-sierra") },
	{ label: "Copacabana", href: destinationHref("geo:bo:copacabana") },
	{ label: "Cochabamba", href: destinationHref("geo:bo:cochabamba-city") },
]

const exploreGroups = [
	{
		title: "Tipo de estadía",
		links: [
			{ label: "Hoteles", href: "/buscar/alojamientos" },
			{ label: "Hostales", href: "/buscar/alojamientos" },
			{ label: "Apart hoteles", href: "/buscar/alojamientos" },
		],
	},
	{
		title: "Para tu viaje",
		links: [
			{ label: "Escapadas de fin de semana", href: "/buscar/alojamientos" },
			{ label: "Viajes en familia", href: "/buscar/alojamientos" },
			{ label: "Viajes de trabajo", href: "/buscar/alojamientos" },
		],
	},
	{
		title: "Regiones",
		links: [
			{ label: "Altiplano", href: destinationHref("geo:bo:la-paz-department") },
			{ label: "Valles", href: destinationHref("geo:bo:cochabamba") },
			{ label: "Amazonía", href: destinationHref("geo:bo:beni") },
		],
	},
	{
		title: "Ayuda",
		links: [
			{ label: "Cómo reservar", href: "/help" },
			{ label: "Gestionar una reserva", href: "/trips" },
		],
	},
]
---

<MarketplaceListingSurface
	vertical="hotels"
	title="Alojamientos en Bolivia"
	description="Encuentra hoteles, hostales y apart hoteles para cada tipo de viaje."
	canonicalPath="/hotels"
	popularDestinations={popularDestinations}
	exploreGroups={exploreGroups}
/>
