											</Button>
											{funnelStatus && (
												<div class="space-y-2 border-t border-slate-200 pt-3">
													<h3 class="font-semibold">Diagnóstico de configuración</h3>
													<p class="text-slate-600">{funnelStatus.hostLabel}</p>
													{funnelSummary ? (
														<dl class="flex flex-wrap gap-x-4 gap-y-1 text-slate-700">
															<div>
																<dt>Bloqueos mostrados</dt>
																<dd>{funnelSummary.blockerShown}</dd>
															</div>
															<div>
																<dt>Acciones abiertas</dt>
																<dd>{funnelSummary.ctaClicked}</dd>
															</div>
															<div>
																<dt>Áreas completadas</dt>
																<dd>{funnelSummary.domainComplete}</dd>
															</div>
														</dl>
													) : (
														<p class="text-slate-600">
															{funnelStatus.queryable
																? "No se pudieron cargar las métricas."
																: funnelStatus.adminHint}
														</p>
													)}
												</div>
											)}
										</>
									</div>
								</>
							</details>
						</aside>
					</div>
				</section>
			)
		)
	}
</InternalAdminLayout>

<script>
	import { bindAgreementForms } from "@/lib/commercial-policy/agreement-forms"
	bindAgreementForms()
	document.addEventListener("astro:page-load", bindAgreementForms)
	function previewDeadline(target: EventTarget | null) {
		if (!(target instanceof Element)) return
		const form =
			target.closest("[data-case-deadline]") ?? target.querySelector("[data-case-deadline]")
		const hours = form?.querySelector<HTMLInputElement>('input[name="deadlineHours"]')
		const output = form?.querySelector("output")
		if (!hours || !output) return
		output.textContent = hours.validity.valid
			? "Vencimiento estimado: " +
				new Intl.DateTimeFormat("es-CL", {
					dateStyle: "medium",
					timeStyle: "short",
					timeZone: "America/Santiago",
				}).format(new Date(Date.now() + hours.valueAsNumber * 3_600_000))
			: ""
	}
	document.addEventListener("toggle", (event) => previewDeadline(event.target), true)
	document.addEventListener("input", (event) => previewDeadline(event.target))
	async function copyTextToClipboard(value: string): Promise<boolean> {
		try {
			if (navigator.clipboard?.writeText) {
				await navigator.clipboard.writeText(value)
				return true
			}
		} catch {
			/* fall through to legacy copy */
		}
		try {
			const input = document.createElement("textarea")
			input.value = value
			input.setAttribute("readonly", "")
			input.style.position = "fixed"
			input.style.top = "0"
			input.style.left = "0"
			input.style.opacity = "0"
			document.body.appendChild(input)
			input.focus()
			input.select()
			input.setSelectionRange(0, value.length)
			const copied = document.execCommand("copy")
			input.remove()
			return copied
		} catch {
			return false
		}
	}

	function setCopyFeedback(button: HTMLButtonElement, ok: boolean) {
		const label = button.querySelector<HTMLElement>("[data-copy-label]")
		const status = document.querySelector<HTMLElement>("[data-copy-status]")
		if (label) label.textContent = ok ? "Copiado" : "No se pudo copiar"
		if (status) {
			status.textContent = ok
				? "ID interno copiado al portapapeles"
				: "No se pudo copiar el ID interno"
		}
		window.setTimeout(() => {
			if (label) label.textContent = "Copiar ID"
			if (status) status.textContent = ""
		}, 1800)
	}

	const globalState = window as typeof window & { __fasttCopyProviderIdBound?: boolean }
	if (!globalState.__fasttCopyProviderIdBound) {
		globalState.__fasttCopyProviderIdBound = true
		document.addEventListener("click", (event) => {
			const target = event.target
			if (!(target instanceof Element)) return
			const button = target.closest<HTMLButtonElement>("[data-copy-provider-id]")
			if (!button) return
			const providerId = button.dataset.copyProviderId
			if (!providerId) return
			event.preventDefault()
			void copyTextToClipboard(providerId).then((ok) => setCopyFeedback(button, ok))
		})
	}
</script>
