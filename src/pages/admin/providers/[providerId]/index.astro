---
import { ChevronDown, FileText, ShieldMinus } from "@lucide/astro"
import { getFeatureFlag } from "@/config/featureFlags"
import CaseStatusBadge from "@/components/admin/cases/CaseStatusBadge.astro"
import InternalAccessDenied from "@/components/admin/InternalAccessDenied.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import InternalAdminLayout from "@/layouts/InternalAdminLayout.astro"
import {
	principalHasPermission,
	requireInternalPermission,
} from "@/lib/auth/internal-authorization"
import { listProviderDocuments, providerDocumentTypes } from "@/lib/provider-documents"
import DocumentReuseForm from "@/components/admin/DocumentReuseForm.astro"
import { listPublishedDocumentDefinitions } from "@/lib/documents/document-definitions"
import { definedUploadType } from "@/lib/documents/definition-upload-type"
import {
	and,
	db,
	eq,
	inArray,
	ProviderDocument,
	ComplianceCase,
	sql,
} from "@/shared/infrastructure/db/compat"
import { listRecentProviderComplianceAudit } from "@/lib/provider-admin-compliance"
import {
	getSettingsFunnelQueryStatus,
	summarizeProviderSettingsFunnel,
} from "@/lib/provider-settings-funnel"
import {
	ACTIVE_CASE_STATUSES,
	getProvider360,
	PROVIDER_WORK_VOCABULARY,
} from "@/modules/casework/public"

let authorized = false
let accessRestricted = false
let principal: Awaited<ReturnType<typeof requireInternalPermission>> | null = null
try {
	principal = await requireInternalPermission(Astro.request, "provider.compliance.read")
	authorized = true
} catch (response) {
	if (response instanceof Response && response.status === 401) return Astro.redirect("/SignInPage")
	if (response instanceof Response && response.status === 403) accessRestricted = true
	else throw response
}

const providerId = String(Astro.params.providerId ?? "")
const view = authorized ? await getProvider360(providerId) : null
if (authorized && !view) return new Response("Proveedor no encontrado", { status: 404 })
const canReadComplianceHistory = Boolean(
	view && principal && principalHasPermission(principal, "internal.admin.access")
)
const complianceHistory = canReadComplianceHistory
	? await listRecentProviderComplianceAudit({ providerId, limit: 8 }).catch(() => null)
	: []
const funnelStatus = canReadComplianceHistory ? getSettingsFunnelQueryStatus() : null
const funnelSummary = funnelStatus?.queryable
	? await summarizeProviderSettingsFunnel({ providerId }).catch(() => null)
	: null
const verifiedDocuments =
	view &&
	principal &&
	principalHasPermission(principal, "provider.document.review", {
		type: "provider",
		id: providerId,
	})
		? (await listProviderDocuments(providerId)).filter((doc) => doc.status === "verified")
		: []

const fmt = new Intl.DateTimeFormat("es-BO", { dateStyle: "medium" })
const reuseDefinitions =
	verifiedDocuments.length && view?.provider.status !== "archived"
		? (await listPublishedDocumentDefinitions()).filter((def) => def.key.startsWith("bo.holder."))
		: []
const activeStatuses = new Set(["open", "in_review", "waiting_information", "blocked"])
const activeCasesTotal = view
	? Object.values(view.caseCounts.activeByDomain).reduce((total, amount) => total + amount, 0)
	: 0
const pendingCases = view?.pendingCases ?? []
const documentsWithoutCase =
	view &&
	view.provider.status !== "archived" &&
	principal &&
	principalHasPermission(principal, "case.decision.propose") &&
	principalHasPermission(principal, "provider.document.review", {
		type: "provider",
		id: providerId,
	}) &&
	getFeatureFlag("COMMAND_CENTER_V2_COMMANDS_ENABLED", { request: Astro.request })
		? await db
				.select({
					id: ProviderDocument.id,
					type: ProviderDocument.type,
				})
				.from(ProviderDocument)
				.where(
					and(
						eq(ProviderDocument.providerId, providerId),
						eq(ProviderDocument.status, "pending"),
						sql`not exists (select 1 from ${ComplianceCase} where
					${ComplianceCase.providerId} = ${ProviderDocument.providerId}
					and ${ComplianceCase.domain} = 'documents'
					and ${ComplianceCase.sourceType} = 'ProviderDocument'
					and ${ComplianceCase.sourceRef} = ${ProviderDocument.id}
					and ${inArray(ComplianceCase.status, [...ACTIVE_CASE_STATUSES])})`
					)
				)
		: []
const canAssignPendingCase = Boolean(
	view &&
	view.provider.status !== "archived" &&
	principal &&
	principalHasPermission(principal, "case.assign") &&
	getFeatureFlag("COMMAND_CENTER_V2_COMMANDS_ENABLED", { request: Astro.request })
)
const nextCase = pendingCases[0] ?? null
const visiblePendingCases = pendingCases.slice(0, 6)
const closedCases = (view?.cases ?? [])
	.filter((item) => !activeStatuses.has(item.status))
	.slice(0, 8)
const shortProviderId = view ? `${view.provider.id.slice(0, 8)}…${view.provider.id.slice(-4)}` : ""
const accountStatusLabels: Record<string, string> = {
	draft: "Borrador",
	active: "Activo",
	inactive: "Inactivo",
	suspended: "Suspendido",
}
const accountPurposeLabels: Record<string, string> = {
	commercial: "Comercial",
	integration_certification: "Certificación · datos de prueba",
	internal_qa: "Pruebas internas",
}
const operational = view?.operational ?? null

function caseTitle(item: { summary: string | null; domain: string }) {
	return (
		item.summary
			?.trim()
			.replaceAll("government_id", "documento de identidad")
			.replaceAll("tax_document", "documento fiscal")
			.replaceAll("business_registration", "registro mercantil")
			.replaceAll("cuenta de payout", "cuenta para desembolsos") ||
		`Revisión de ${PROVIDER_WORK_VOCABULARY.domains[item.domain as keyof typeof PROVIDER_WORK_VOCABULARY.domains] ?? item.domain}`
	)
}
function deadlineLabel(item: (typeof pendingCases)[number]) {
	if (item.slaStatus === "overdue") return "SLA vencido"
	if (item.slaStatus === "due_soon")
		return item.slaDueAt ? `Vence ${fmt.format(item.slaDueAt)}` : "Por vencer"
	if (item.slaDueAt) return `Vence ${fmt.format(item.slaDueAt)}`
	return "Sin plazo definido"
}
function nextActionExplanation(item: (typeof pendingCases)[number] | null) {
	if (!item) return "No hay revisiones activas para este proveedor."
	const domain =
		PROVIDER_WORK_VOCABULARY.domains[
			item.domain as keyof typeof PROVIDER_WORK_VOCABULARY.domains
		] ?? item.domain
	if (item.status === "waiting_information")
		return `Esperamos información del proveedor para continuar con ${domain.toLowerCase()}. Revisa qué se solicitó en el expediente.`
	return `${deadlineLabel(item)}. ${item.assigneeEmail ? `Responsable: ${item.assigneeEmail}.` : "Sin responsable asignado."}`
}
function sourceDateLabel(value: Date | null) {
	return value ? fmt.format(value) : "Sin evaluación registrada"
}
function operationalTone(status: string) {
	if (status === "verified") return "bg-emerald-100 text-emerald-800"
	if (status === "attention") return "bg-red-100 text-red-800"
	if (status === "reconciliation_needed") return "bg-amber-100 text-amber-800"
	if (status === "in_review") return "bg-sky-100 text-sky-800"
	return "bg-slate-100 text-slate-700"
}
function availabilityLabel(value: boolean | null) {
	return value === true
		? "Habilitado"
		: value === false
			? "Restringido"
			: "Sin evaluación específica"
}
---

<InternalAdminLayout
	title={view
		? `${view.provider.displayName || view.provider.legalName || "Proveedor"} · Ficha`
		: "Ficha del proveedor"}
>
	{
		accessRestricted ? (
			<section class="space-y-6">
				<InternalAccessDenied />
			</section>
		) : (
			view && (
				<section class="space-y-6">
					{Astro.url.searchParams.get("result") === "document_reuse_pending" && (
						<p
							role="status"
							class="fastt-notice rounded-md border border-emerald-700 bg-emerald-950/50 p-4 text-sm text-emerald-100"
						>
							Revisión creada con el archivo existente. Queda pendiente de inspección y revisión; la
							aprobación anterior no se transfirió.
						</p>
					)}
					<header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
						<div>
							<p class="text-xs font-semibold tracking-[0.16em] text-amber-300 uppercase">
								Ficha del proveedor
							</p>
							<h1 class="mt-2 text-3xl font-semibold text-white">
								{view.provider.displayName || view.provider.legalName || "Proveedor sin nombre"}
							</h1>
							{view.provider.dataClassification === "fixture" && (
								<p class="mt-2 font-semibold text-amber-200">
									Datos de prueba · no usar para decisiones comerciales
								</p>
							)}
							<p class="mt-2 text-sm text-slate-300">
								{view.provider.legalName || "Razón social no registrada"}
							</p>
							<div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-400">
								<span>ID interno: {shortProviderId}</span>
								<button
									type="button"
									data-copy-provider-id={view.provider.id}
									class="fastt-button inline-flex items-center gap-1 rounded px-1 font-semibold text-white underline decoration-slate-500 underline-offset-4 hover:decoration-white focus:ring-2 focus:ring-white focus:outline-none"
								>
									<span aria-hidden="true">⧉</span> <span data-copy-label>Copiar ID</span>
								</button>
								<span class="sr-only" data-copy-status aria-live="polite" />
							</div>
						</div>
						<Button href="#historial" variant="onDark">
							Ver historial
						</Button>
					</header>

					<div class="grid gap-6 xl:grid-cols-[1fr_22rem]">
						<div class="space-y-6">
							<Card>
								<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
									<>
										<h2 class="text-lg font-semibold">Pendientes</h2>
										<p class="text-sm text-slate-600">
											{activeCasesTotal}{" "}
											{activeCasesTotal === 1 ? "revisión activa" : "revisiones activas"}
										</p>
									</>
								</div>
								{visiblePendingCases.length || documentsWithoutCase.length ? (
									<ol class="mt-4 divide-y divide-slate-200">
										{visiblePendingCases.map((item) => (
											<li class="grid gap-3 py-4 lg:grid-cols-[minmax(0,1fr)_auto_auto_auto] lg:items-center">
												<div>
													{item.id === nextCase?.id && (
														<p class="mb-1 text-xs font-semibold text-amber-800">Próxima acción</p>
													)}
													<p class="font-semibold text-slate-950">{caseTitle(item)}</p>
													<p class="mt-1 text-sm text-slate-600">
														{
															PROVIDER_WORK_VOCABULARY.domains[
																item.domain as keyof typeof PROVIDER_WORK_VOCABULARY.domains
															]
														}{" "}
														· {deadlineLabel(item)} · {item.assigneeEmail || "Sin asignar"}
													</p>
													{item.id === nextCase?.id && (
														<p class="mt-1 text-sm text-slate-600">{nextActionExplanation(item)}</p>
													)}
												</div>
												<CaseStatusBadge value={item.status} />
												<CaseStatusBadge value={item.slaStatus} />
												<div class="space-y-2">
													<div class="flex flex-wrap gap-2">
														<Button href={`/admin/cases/${item.id}`} variant="secondary" size="sm">
															{PROVIDER_WORK_VOCABULARY.actions.openCase}
														</Button>
														{canAssignPendingCase &&
															!item.assigneeUserId &&
															!item.assigneeEmail && (
																<form
																	method="post"
																	action={`/api/admin/v1/cases/${encodeURIComponent(item.id)}/assign`}
																	data-agreement-form
																	data-agreement-json
																	data-idempotent-command
																>
																	<input type="hidden" name="caseVersion" value={item.version} />
																	<Button type="submit" size="sm" variant="secondary">
																		Asignarme
																	</Button>
																	{!item.slaDueAt && (
																		<p class="text-xs text-slate-600">
																			Vence en 48 horas desde la asignación.
																		</p>
																	)}
																	<p role="status" data-agreement-feedback class="text-sm" />
																</form>
															)}
													</div>
												</div>
												{canAssignPendingCase &&
													!["paused", "stopped"].includes(item.slaStatus) && (
														<details class="group min-w-0 text-sm lg:col-span-full">
															<summary class="inline-flex min-h-8 cursor-pointer list-none items-center gap-2 rounded-md px-2 font-semibold text-slate-700 hover:bg-slate-100 focus-visible:outline-2 [&::-webkit-details-marker]:hidden">
																<ChevronDown
																	class="size-4 shrink-0 group-open:rotate-180"
																	aria-hidden="true"
																/>
																{item.slaDueAt ? "Cambiar plazo" : "Fijar plazo"}
															</summary>
															<form
																class="fastt-soft-box mt-2 rounded-lg border border-slate-200 bg-slate-50 p-3"
																method="post"
																action={`/api/admin/v1/cases/${encodeURIComponent(item.id)}/assign`}
																data-agreement-form
																data-agreement-json
																data-idempotent-command
																data-case-deadline
															>
																<input type="hidden" name="caseVersion" value={item.version} />
																<label for={`deadline-hours-${item.id}`} class="block font-medium">
																	Plazo desde que guardes
																</label>
																<div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-2">
																	<div class="flex shrink-0 items-baseline gap-2">
																		<input
																			id={`deadline-hours-${item.id}`}
																			class="fastt-field w-24 text-center tabular-nums"
																			type="number"
																			name="deadlineHours"
																			min="1"
																			max="168"
																			value="48"
																			required
																		/>
																		<span class="text-slate-600">horas</span>
																	</div>
																	<output
																		class="min-w-0 grow basis-44 text-sm text-slate-600"
																		data-deadline-preview
																	/>
																	<Button type="submit" size="sm" variant="secondary">
																		Guardar plazo
																	</Button>
																</div>
																<p
																	role="status"
																	data-agreement-feedback
																	class="mt-2 text-sm empty:hidden"
																/>
															</form>
														</details>
													)}
											</li>
										))}
										{documentsWithoutCase.map((doc) => (
											<li class="flex flex-wrap items-center justify-between gap-3 py-4">
												<div class="min-w-0">
													<p class="font-semibold">
														{providerDocumentTypes.find(({ value }) => value === doc.type)?.label ??
															"Documento"}
													</p>
													<p class="text-sm break-words text-slate-600">Sin expediente</p>
												</div>
												<form
													method="post"
													action="/api/admin/providers/start-document-review"
													data-agreement-form
													data-follow-command-redirect
												>
													<input type="hidden" name="providerId" value={providerId} />
													<input type="hidden" name="documentId" value={doc.id} />
													<Button type="submit" variant="secondary" size="sm">
														Iniciar revisión
													</Button>
													<p role="status" data-agreement-feedback class="text-sm" />
												</form>
											</li>
										))}
									</ol>
								) : (
									<p class="mt-4 text-sm text-slate-600">
										{PROVIDER_WORK_VOCABULARY.results.noActiveCases}.
									</p>
								)}
								{activeCasesTotal > visiblePendingCases.length && (
									<a
										href={`/admin/queues/all?providerId=${encodeURIComponent(view.provider.id)}`}
										class="mt-4 inline-flex text-sm font-semibold text-slate-900 underline underline-offset-4"
									>
										{PROVIDER_WORK_VOCABULARY.actions.viewAllPending}
									</a>
								)}
							</Card>

							<Card>
								<h2 class="text-lg font-semibold">Estado por área</h2>
								<p class="mt-2 text-sm text-slate-600">
									Cada resultado indica su fuente, la fecha de evaluación y la evidencia que falta.
								</p>
								<div class="mt-4 grid gap-4 sm:grid-cols-2">
									{Object.entries(PROVIDER_WORK_VOCABULARY.domains).map(([domain, label]) => {
										const area = operational?.areas[domain as keyof typeof operational.areas]
										const replacements = operational?.identityDocumentsToReplace ?? []
										const needsIdentityReplacement =
											domain === "verification" && replacements.length > 0
										const missingEvidence = [
											...new Set([
												...(area?.missingEvidence ?? []),
												...(needsIdentityReplacement ? replacements : []),
											]),
										]
										const activeCase = pendingCases.find((item) => item.domain === domain)
										const areaDocuments = verifiedDocuments.filter((doc) => {
											if (doc.type === "government_id" || doc.type === "business_registration")
												return domain === "verification"
											if (doc.type === "tax_document") return domain === "fiscal"
											return domain === "documents"
										})
										return (
											<article class="rounded-xl border border-slate-200 p-4">
												<div class="flex items-start justify-between gap-3">
													<h3 class="font-semibold text-slate-950">
														{domain === "documents" ? "Archivo documental" : label}
													</h3>
													{area && (
														<span
															class={`rounded-full px-2 py-1 text-xs font-semibold ${operationalTone(needsIdentityReplacement ? "attention" : area.status)}`}
														>
															{needsIdentityReplacement
																? "Respaldos por reemplazar"
																: area.statusLabel}
														</span>
													)}
												</div>
												{area && (
													<>
														<p class="mt-3 text-sm text-slate-700">
															{needsIdentityReplacement
																? area.status === "verified"
																	? "La verificación anterior sigue registrada."
																	: area.reason
																: area.reason}
														</p>
														<dl class="mt-3 space-y-1 text-xs text-slate-500">
															<div>
																<dt class="inline font-semibold text-slate-600">Fuente: </dt>
																<dd class="inline">{area.source}</dd>
															</div>
															<div>
																<dt class="inline font-semibold text-slate-600">
																	Revisión registrada:{" "}
																</dt>
																<dd class="inline">
																	{sourceDateLabel(area.sourceEvaluatedAt ?? null)}
																</dd>
																<dt class="inline font-semibold text-slate-600">
																	{" "}
																	· Fuente actualizada:{" "}
																</dt>
																<dd class="inline">{sourceDateLabel(area.sourceUpdatedAt)}</dd>
															</div>
														</dl>
														{missingEvidence.length > 0 && (
															<p class="mt-3 text-sm text-slate-700">
																<span class="font-semibold">
																	{domain === "documents" && area.status === "attention"
																		? "Archivos rechazados: "
																		: "Falta: "}
																</span>
																{missingEvidence.join(", ")}
															</p>
														)}
													</>
												)}
												{areaDocuments.length > 0 && (
													<details class="mt-4 border-y border-slate-200 py-3">
														<summary class="cursor-pointer font-semibold">
															Verificaciones documentales
														</summary>
														{areaDocuments.map((doc) => (
															<div class="mt-3 rounded-lg border border-slate-200 p-3">
																<div class="flex items-start gap-2.5">
																	<FileText
																		class="mt-0.5 size-4 shrink-0 text-slate-500"
																		aria-hidden="true"
																	/>
																	<div class="min-w-0 flex-1">
																		<p class="text-sm font-semibold text-slate-950">
																			{doc.typeLabel}
																		</p>
																		{doc.fileName && (
																			<p class="mt-1 text-xs break-all text-slate-500">
																				{doc.fileName}
																			</p>
																		)}
																	</div>
																	<span class="shrink-0 text-xs font-medium text-emerald-700">
																		Verificado
																	</span>
																</div>
																<DocumentReuseForm
																	document={doc}
																	definitions={reuseDefinitions.filter(
																		(def) =>
																			definedUploadType(def) === doc.type &&
																			def.id !== doc.definitionVersionId
																	)}
																/>
																<details class="group mt-3">
																	<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-md px-2 py-1.5 text-sm font-medium text-rose-700 hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden">
																		<ShieldMinus class="size-4" aria-hidden="true" />
																		Retirar verificación
																		<ChevronDown
																			class="size-4 transition-transform group-open:rotate-180"
																			aria-hidden="true"
																		/>
																	</summary>
																	<form
																		action="/api/admin/providers/documents"
																		method="post"
																		data-agreement-form
																		data-idempotent-command
																		class="mt-2 space-y-3 border-t border-slate-200 pt-3"
																	>
																		<input type="hidden" name="providerId" value={providerId} />
																		<input type="hidden" name="documentId" value={doc.id} />
																		<input type="hidden" name="status" value="rejected" />
																		<input type="hidden" name="withdrawVerification" value="true" />
																		<label class="block text-sm font-medium text-slate-800">
																			Motivo visible para el proveedor
																			<textarea
																				name="reviewNotes"
																				required
																				minlength="10"
																				maxlength="500"
																				rows="3"
																				class="fastt-field mt-1 block w-full resize-y"
																			/>
																		</label>
																		<Button
																			type="submit"
																			variant="secondary"
																			class="border-rose-200 text-rose-700 hover:bg-rose-50"
																		>
																			Confirmar retiro
																		</Button>
																		<p role="status" data-agreement-feedback class="text-sm" />
																	</form>
																</details>
															</div>
														))}
													</details>
												)}
												{activeCase && (
													<div class="mt-4">
														<a
															href={`/admin/cases/${activeCase.id}`}
															class="text-sm font-semibold text-slate-900 underline underline-offset-4"
														>
															Abrir revisión activa
														</a>
													</div>
												)}
											</article>
										)
									})}
								</div>
								<p class="mt-4 text-xs text-slate-500">
									Evaluación de esta ficha:{" "}
									{operational ? fmt.format(operational.evaluatedAt) : "No disponible"}. Los casos
									enlazados sirven para revisar o decidir; no sustituyen esta evaluación.
								</p>
							</Card>

							<Card id="historial">
								<div class="flex items-baseline justify-between gap-3">
									<>
										<h2 class="text-lg font-semibold">Historial reciente</h2>
										<span class="text-sm text-slate-500">
