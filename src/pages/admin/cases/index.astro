---
const params = new URLSearchParams(Astro.url.search)
params.delete("cursor")
const providerId = params.get("providerId")
const destination = providerId
	? `/admin/providers/${encodeURIComponent(providerId)}#historial`
	: `/admin/providers/directory${params.size ? `?${params}` : ""}`

return Astro.redirect(destination, 302)
---
