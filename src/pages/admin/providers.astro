																data-domain="payments"
															>
																<option value="">Plantilla de motivo…</option>
																{templatesFor("payments").map((item) => (
																	<option value={item.body}>{item.label}</option>
																))}
															</select>
															<Textarea
																name="reason"
																rows="2"
																required
																minlength="2"
																className="w-full"
																placeholder="Motivo (requiere atención)"
																data-case-reason
															/>
															<Button type="submit" variant="danger" className="w-fit">
																Requiere atención
															</Button>
														</form>
														<AdminComplianceSlaAssign
															providerId={account.providerId}
															domain="payments"
															entityId={account.id}
															assignment={account.assignment}
															currentAdminEmail={adminEmail}
															assigneeShortcuts={assigneeShortcuts}
														/>
													</Card>
												))}

												{!focusedDetail.pending.verification &&
												focusedDetail.pending.fiscal === 0 &&
												focusedDetail.pending.documents === 0 &&
												focusedDetail.pending.payments === 0 ? (
													<p class="text-sm text-slate-600" data-case-templates-empty>
														Sin acciones pendientes en este caso.
													</p>
												) : null}
											</section>

											{focusedDetail.audit.length ? (
												<div class="overflow-x-auto">
													<p class="mb-2 text-sm font-semibold text-slate-900">
														Auditoría reciente
													</p>
													<table class="min-w-full divide-y divide-slate-200 text-sm">
														<thead>
															<tr class="text-left text-xs tracking-wide text-slate-600 uppercase">
																<th class="px-2 py-1">Cuándo</th>
																<th class="px-2 py-1">Acción</th>
																<th class="px-2 py-1">Actor</th>
															</tr>
														</thead>
														<tbody class="divide-y divide-slate-200">
															{focusedDetail.audit.slice(0, 8).map((row) => (
																<tr>
																	<td class="px-2 py-2 text-slate-700">
																		{row.createdAt ? fmt.format(new Date(row.createdAt)) : "—"}
																	</td>
																	<td class="px-2 py-2 text-slate-900">{row.actionLabel}</td>
																	<td class="px-2 py-2 text-slate-600">
																		{row.actorEmail || row.actorUserId || "—"}
																	</td>
																</tr>
															))}
														</tbody>
													</table>
												</div>
											) : (
												<p class="text-sm text-slate-600">Sin eventos de auditoría recientes.</p>
											)}
										</aside>
									</>
								) : null}
							</div>
						</div>
					</>
				)
			}
		</div>
	</section>
</InternalAdminLayout>

<script is:inline>
	const feedback = document.getElementById("admin-compliance-feedback")

	function showFeedback(kind, message) {
		if (!feedback) return
		feedback.classList.remove(
			"hidden",
			"border-emerald-200",
			"bg-emerald-50",
			"text-emerald-900",
			"border-red-200",
			"bg-red-50",
			"text-red-900",
			"border-amber-200",
			"bg-amber-50",
			"text-amber-950"
		)
		if (kind === "success") {
			feedback.classList.add("border-emerald-200", "bg-emerald-50", "text-emerald-900")
		} else if (kind === "warning") {
			feedback.classList.add("border-amber-200", "bg-amber-50", "text-amber-950")
		} else {
			feedback.classList.add("border-red-200", "bg-red-50", "text-red-900")
		}
		feedback.textContent = message
	}

	document.querySelectorAll("[data-reject-template]").forEach((select) => {
		select.addEventListener("change", () => {
			const form = select.closest("form")
			if (!form) return
			const textarea = form.querySelector("textarea")
			if (!textarea || !select.value) return
			textarea.value = select.value
		})
	})

	document.querySelectorAll("[data-preview-document]").forEach((button) => {
		button.addEventListener("click", async () => {
			const documentId = button.getAttribute("data-preview-document")
			const providerId = button.getAttribute("data-provider-id")
			if (!documentId || !providerId) return
			button.setAttribute("disabled", "true")
			try {
				const res = await fetch(
					`/api/admin/providers/documents/preview?providerId=${encodeURIComponent(providerId)}&documentId=${encodeURIComponent(documentId)}&reason=case_review`
				)
				const body = await res.json().catch(() => ({}))
				if (!res.ok || !body.url) {
					showFeedback("warning", body.error || "No se pudo abrir el archivo")
					return
				}
				window.open(body.url, "_blank", "noopener,noreferrer")
			} finally {
				button.removeAttribute("disabled")
			}
		})
	})

	async function postJson(url, payload) {
		const res = await fetch(url, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(payload),
		})
		if (res.status === 200) {
			showFeedback("success", "Estado actualizado. Recargando...")
			window.location.reload()
			return
		}
		if (res.status === 403) {
			showFeedback("error", "Not authorized")
			return
		}
		let msg = "Error"
		try {
			const body = await res.json()
			msg = body?.error || msg
		} catch {}
		showFeedback(res.status === 400 ? "warning" : "error", msg)
	}

	document.querySelectorAll("[data-approve-provider]").forEach((button) => {
		button.addEventListener("click", async () => {
			const providerId = button.getAttribute("data-approve-provider")
			if (!providerId) return
			button.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/verification", { providerId, status: "approved" })
			button.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-reject-form]").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			const providerId = form.getAttribute("data-provider-id")
			const reasonInput = form.querySelector("textarea[name='reason']")
			const submitButton = form.querySelector("button[type='submit']")
			if (!providerId || !reasonInput) return
			const reason = reasonInput.value.trim()
			if (reason.length < 2) {
				showFeedback("warning", "El motivo debe tener al menos 2 caracteres.")
				return
			}
			if (submitButton) submitButton.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/verification", {
				providerId,
				status: "rejected",
				reason,
			})
			if (submitButton) submitButton.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-verify-tax]").forEach((button) => {
		button.addEventListener("click", async () => {
			const providerId = button.getAttribute("data-verify-tax")
			if (!providerId) return
			button.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/tax-configuration", {
				providerId,
				status: "verified",
			})
			button.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-tax-attention-form]").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			const providerId = form.getAttribute("data-provider-id")
			const reasonInput = form.querySelector("textarea[name='reason']")
			const submitButton = form.querySelector("button[type='submit']")
			if (!providerId || !reasonInput) return
			const reason = reasonInput.value.trim()
			if (reason.length < 2) {
				showFeedback("warning", "El motivo debe tener al menos 2 caracteres.")
				return
			}
			if (submitButton) submitButton.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/tax-configuration", {
				providerId,
				status: "requires_attention",
				reason,
			})
			if (submitButton) submitButton.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-verify-document]").forEach((button) => {
		button.addEventListener("click", async () => {
			const documentId = button.getAttribute("data-verify-document")
			const providerId = button.getAttribute("data-provider-id")
			if (!documentId || !providerId) return
			button.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/documents", {
				providerId,
				documentId,
				status: "verified",
			})
			button.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-reject-document-form]").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			const documentId = form.getAttribute("data-document-id")
			const providerId = form.getAttribute("data-provider-id")
			const notesInput = form.querySelector("textarea[name='reviewNotes']")
			const submitButton = form.querySelector("button[type='submit']")
			if (!documentId || !providerId || !notesInput) return
			const reviewNotes = notesInput.value.trim()
			if (reviewNotes.length < 2) {
				showFeedback("warning", "El motivo debe tener al menos 2 caracteres.")
				return
			}
			if (submitButton) submitButton.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/documents", {
				providerId,
				documentId,
				status: "rejected",
				reviewNotes,
			})
			if (submitButton) submitButton.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-verify-payment]").forEach((button) => {
		button.addEventListener("click", async () => {
			const accountId = button.getAttribute("data-verify-payment")
			const providerId = button.getAttribute("data-provider-id")
			if (!accountId || !providerId) return
			button.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/payment-accounts", {
				providerId,
				accountId,
				status: "verified",
			})
			button.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-micro-deposit]").forEach((button) => {
		button.addEventListener("click", async () => {
			const accountId = button.getAttribute("data-micro-deposit")
			const providerId = button.getAttribute("data-provider-id")
			if (!accountId || !providerId) return
			button.setAttribute("disabled", "true")
			try {
				const res = await fetch("/api/admin/providers/payment-accounts", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						providerId,
						accountId,
						action: "initiate_micro_deposit",
					}),
				})
				const body = await res.json().catch(() => ({}))
				if (res.status === 200) {
					const cents = Array.isArray(body.depositAmountsCents) ? body.depositAmountsCents : null
					const railMode = body.rail?.mode || "simulated"
					let msg = "Micro-depósito iniciado."
					if (cents && cents.length === 2) {
						msg += ` Montos de prueba (solo ops): ${cents[0]}¢ y ${cents[1]}¢.`
					}
					if (railMode !== "live") {
						msg += " Rail simulado — no salió ACH bancario real."
					}
					showFeedback("success", msg + " Recargando...")
					window.setTimeout(() => window.location.reload(), 1400)
					return
				}
				if (res.status === 403) {
					showFeedback("error", "Not authorized")
					return
				}
				showFeedback(res.status === 400 ? "warning" : "error", body.error || "Error")
			} finally {
				button.removeAttribute("disabled")
			}
		})
	})

	document.querySelectorAll("[data-assign-ops]").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			const providerId = form.getAttribute("data-provider-id")
			const domain = form.getAttribute("data-domain")
			const entityId = form.getAttribute("data-entity-id")
			const emailInput = form.querySelector("input[name='assigneeEmail']")
			const slaInput = form.querySelector("input[name='slaHours']")
			const submitButton = form.querySelector("button[type='submit']")
			if (!providerId || !domain || !entityId) return
			if (submitButton) submitButton.setAttribute("disabled", "true")
			const assigneeEmail = emailInput instanceof HTMLInputElement ? emailInput.value : ""
			await postJson("/api/admin/providers/compliance-assignments", {
				providerId,
				domain,
				entityId,
				assigneeEmail,
				slaHours: slaInput instanceof HTMLInputElement ? Number(slaInput.value) : 48,
			})
			const normalized = String(assigneeEmail || "")
				.trim()
				.toLowerCase()
			if (normalized) {
				try {
					const key = "fastt.admin.assigneeShortcuts"
					const prev = JSON.parse(localStorage.getItem(key) || "[]")
					const next = [normalized, ...(Array.isArray(prev) ? prev : [])]
						.filter((value, index, all) => value && all.indexOf(value) === index)
						.slice(0, 5)
					localStorage.setItem(key, JSON.stringify(next))
				} catch {}
			}
			if (submitButton) submitButton.removeAttribute("disabled")
		})
	})

	document.querySelectorAll("[data-assignee-shortcut]").forEach((button) => {
		button.addEventListener("click", () => {
			const email = button.getAttribute("data-assignee-shortcut")
			const root = button.closest("[data-assignee-shortcuts-root]")
			const input = root?.querySelector("[data-assignee-email-input]")
			if (!email || !(input instanceof HTMLInputElement)) return
			input.value = email
			input.focus()
		})
	})

	document.querySelectorAll("[data-case-template]").forEach((button) => {
		button.addEventListener("click", () => {
			const body = button.getAttribute("data-template-body")
			const card = button.closest("[data-case-domain]")
			const textarea = card?.querySelector("[data-case-reason]")
			const select = card?.querySelector("[data-reject-template]")
			if (!body || !(textarea instanceof HTMLTextAreaElement)) return
			textarea.value = body
			if (select instanceof HTMLSelectElement) {
				select.value = body
			}
			textarea.focus()
		})
	})
	;(function setupCaseDrawerA11y() {
		const drawer = document.querySelector("[data-case-drawer]")
		if (!(drawer instanceof HTMLElement)) return
		const closeHref =
			document.querySelector("[data-case-drawer-close]")?.getAttribute("href") || "/admin/providers"
		const focusableSelector =
			'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'

		function getFocusable() {
			return Array.from(drawer.querySelectorAll(focusableSelector)).filter(
				(el) => el instanceof HTMLElement && !el.hasAttribute("disabled")
			)
		}

		const closeControl = drawer.querySelector("[data-case-drawer-close]")
		if (closeControl instanceof HTMLElement) {
			closeControl.focus()
		} else {
			drawer.focus()
		}

		const isMobile = window.matchMedia("(max-width: 1023px)").matches
		if (isMobile) {
			document.body.style.overflow = "hidden"
		}

		function onKeyDown(event) {
			if (event.key === "Escape") {
				event.preventDefault()
				window.location.href = closeHref
				return
			}
			if (event.key !== "Tab") return
			const focusable = getFocusable()
			if (focusable.length === 0) return
			const first = focusable[0]
			const last = focusable[focusable.length - 1]
			const active = document.activeElement
			if (event.shiftKey && active === first) {
				event.preventDefault()
				last.focus()
			} else if (!event.shiftKey && active === last) {
				event.preventDefault()
				first.focus()
			}
		}

		document.addEventListener("keydown", onKeyDown)
		window.addEventListener("pagehide", () => {
			document.body.style.overflow = ""
			document.removeEventListener("keydown", onKeyDown)
		})
	})()

	document.querySelectorAll("[data-payment-attention-form]").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			const accountId = form.getAttribute("data-account-id")
			const providerId = form.getAttribute("data-provider-id")
			const reasonInput = form.querySelector("textarea[name='reason']")
			const submitButton = form.querySelector("button[type='submit']")
			if (!accountId || !providerId || !reasonInput) return
			const reason = reasonInput.value.trim()
			if (reason.length < 2) {
				showFeedback("warning", "El motivo debe tener al menos 2 caracteres.")
				return
			}
			if (submitButton) submitButton.setAttribute("disabled", "true")
			await postJson("/api/admin/providers/payment-accounts", {
				providerId,
				accountId,
				status: "requires_attention",
				reason,
			})
			if (submitButton) submitButton.removeAttribute("disabled")
		})
	})
</script>
