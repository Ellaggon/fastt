---
import AdminComplianceSlaAssign from "@/components/admin/AdminComplianceSlaAssign.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Textarea from "@/components/ui/Textarea.astro"
import InternalAdminLayout from "@/layouts/InternalAdminLayout.astro"
import { requireInternalAdmin } from "@/lib/auth/requireInternalAdmin"
import {
	adminComplianceRejectTemplates,
	loadProviderComplianceConsole,
	loadProviderComplianceDetail,
	parseProviderComplianceQueueFilter,
} from "@/lib/provider-admin-compliance"
import { getPayoutRailStatus } from "@/lib/payout-rail"
import {
	getSettingsFunnelQueryStatus,
	summarizeProviderSettingsFunnel,
} from "@/lib/provider-settings-funnel"

let isAdmin = false
let adminEmail = ""
try {
	const { user } = await requireInternalAdmin(Astro.request)
	isAdmin = true
	adminEmail = String(user.email ?? "")
		.trim()
		.toLowerCase()
} catch (response) {
	if (response instanceof Response && response.status === 401) return Astro.redirect("/SignInPage")
	isAdmin = false
}

const filter = parseProviderComplianceQueueFilter(Astro.url.searchParams.get("filter"))
const focusedProviderId = String(Astro.url.searchParams.get("providerId") ?? "").trim()

const consolePayload = isAdmin
	? await loadProviderComplianceConsole({ filter, auditLimit: filter === "audit" ? 80 : 25 })
	: null
const focusedDetail =
	isAdmin && focusedProviderId ? await loadProviderComplianceDetail(focusedProviderId) : null

const payoutRail = getPayoutRailStatus()
const funnelStatus = getSettingsFunnelQueryStatus()
const funnelSummary = isAdmin
	? await summarizeProviderSettingsFunnel({
			providerId: focusedProviderId || null,
		}).catch(() => null)
	: null

const counts = consolePayload?.counts ?? {
	verification: 0,
	fiscal: 0,
	documents: 0,
	payments: 0,
	total: 0,
	overdue: 0,
	dueSoon: 0,
}
const sections = consolePayload?.sections ?? {
	verification: false,
	fiscal: false,
	documents: false,
	payments: false,
	audit: false,
}
const rows = consolePayload?.verification ?? []
const taxRows = consolePayload?.fiscal ?? []
const documentRows = consolePayload?.documents ?? []
const paymentRows = consolePayload?.payments ?? []
const auditRows = consolePayload?.audit ?? []
const assigneeShortcuts = Array.from(
	new Set(
		(consolePayload?.assignments ?? [])
			.map((row) =>
				String(row.assigneeEmail ?? "")
					.trim()
					.toLowerCase()
			)
			.filter(Boolean)
	)
).slice(0, 5)
const isSlaFilter = filter === "overdue" || filter === "due_soon"
const slaTotal = rows.length + taxRows.length + documentRows.length + paymentRows.length
const caseTemplates = focusedDetail?.rejectTemplates ?? adminComplianceRejectTemplates

function templatesFor(domain: "verification" | "fiscal" | "documents" | "payments") {
	return caseTemplates.filter((item) => item.domain === domain)
}

const fmt = new Intl.DateTimeFormat("es-CL", {
	dateStyle: "short",
	timeStyle: "short",
})

function queueHref(next: string) {
	return `/admin/providers?filter=${next}`
}

function caseHref(providerId: string) {
	return `/admin/providers?filter=${encodeURIComponent(filter)}&providerId=${encodeURIComponent(providerId)}`
}

const caseCloseHref = queueHref(filter)

const queueButtons = [
	{ id: "overdue", label: "Vencidas", count: counts.overdue, sla: "overdue" as const },
	{ id: "due_soon", label: "Por vencer", count: counts.dueSoon, sla: "due_soon" as const },
	{ id: "all", label: "Pendientes", count: counts.total, sla: null },
	{ id: "verification", label: "Verificación", count: counts.verification, sla: null },
	{ id: "fiscal", label: "Fiscal", count: counts.fiscal, sla: null },
	{ id: "documents", label: "Documentos", count: counts.documents, sla: null },
	{ id: "payments", label: "Pagos", count: counts.payments, sla: null },
	{ id: "audit", label: "Auditoría", count: null as number | null, sla: null },
] as const

const activeQueueLabel =
	queueButtons.find((button) => button.id === filter)?.label ?? "Cola de revisión"
---

<InternalAdminLayout title="Admin · Cumplimiento de proveedores">
	<section class="min-h-screen text-slate-200">
		<div class="mx-auto max-w-7xl space-y-6 px-6">
			<header class="space-y-2">
				<h1 class="text-2xl font-semibold text-white">Cumplimiento de proveedores</h1>
				<p class="text-sm text-slate-300">
					Workbench ops: una cola activa (default SLA vencidas), abre un caso en el panel lateral.
					El proveedor envía; solo el equipo interno valida. Toda decisión queda en auditoría.
				</p>
			</header>

			{
				!isAdmin ? (
					<Card class="bg-slate-100">
						<div class="space-y-2">
							<p class="text-xl font-semibold text-slate-900">Forbidden</p>
							<p class="text-sm text-slate-600">Su usuario no tiene permisos para esta sección.</p>
						</div>
					</Card>
				) : (
					<>
						<div
							class="space-y-6"
							data-admin-workbench
							data-drawer-open={focusedDetail ? "true" : "false"}
						>
							{counts.overdue > 0 && filter !== "overdue" ? (
								<div
									data-sla-alert="overdue"
									class="fastt-notice rounded-[var(--fastt-radius-card)] border border-red-400/60 bg-red-950/40 px-4 py-3 text-sm text-red-100"
									role="alert"
								>
									<p class="font-semibold text-white">
										{counts.overdue} asignación{counts.overdue === 1 ? "" : "es"} vencida
										{counts.overdue === 1 ? "" : "s"} de SLA
									</p>
									<p class="mt-1 text-red-200">
										Hay dominios de cumplimiento sin resolver más allá del objetivo interno.
									</p>
									<a href={queueHref("overdue")} class="mt-2 inline-block font-semibold underline">
										Ver cola vencida
									</a>
								</div>
							) : null}

							<nav
								class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-700 bg-slate-900/80 p-3"
								aria-label="Colas de cumplimiento"
								data-admin-queue-nav
							>
								<div class="mb-3 flex flex-wrap items-end justify-between gap-2">
									<div>
										<p class="text-xs font-semibold tracking-[0.14em] text-slate-400 uppercase">
											Workbench ops
										</p>
										<p class="mt-1 text-sm text-slate-300">
											Cola activa: <strong class="text-white">{activeQueueLabel}</strong>
											{filter === "overdue" ? " (default SLA)" : ""}. Una cola a la vez; abre un
											caso para el panel lateral.
										</p>
									</div>
									{focusedDetail ? (
										<p
											class="text-xs text-amber-200"
											data-case-drawer-hint
											data-row-reject-deferred
										>
											Caso abierto · {focusedDetail.provider.displayName} · rechazo solo en el
											drawer
										</p>
									) : null}
								</div>
								<div class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1 sm:flex-wrap sm:overflow-visible">
									{queueButtons.map((button) => (
										<a
											href={queueHref(button.id)}
											data-sla-queue={button.sla || undefined}
											data-queue-tab={button.id}
											aria-current={filter === button.id ? "page" : undefined}
											class={`shrink-0 rounded-full border px-3 py-1.5 text-sm font-semibold transition ${
												filter === button.id
													? button.sla === "overdue"
														? "border-red-400/70 bg-red-950/50 text-white"
														: button.sla === "due_soon"
															? "border-amber-400/70 bg-amber-950/40 text-white"
															: "border-amber-400/60 bg-slate-800 text-white"
													: "border-slate-600 bg-slate-950/60 text-slate-200 hover:border-slate-400"
											}`}
										>
											{button.label}
											{typeof button.count === "number" ? ` (${button.count})` : ""}
										</a>
									))}
								</div>
							</nav>

							<div
								id="admin-compliance-feedback"
								class="fastt-notice hidden rounded-[var(--fastt-radius-card)] border px-3 py-2 text-sm"
							/>

							<Card
								class="bg-slate-100"
								data-admin-settings-funnel
								data-funnel-sink={funnelStatus.sink}
								data-funnel-queryable={funnelStatus.queryable ? "true" : "false"}
							>
								<div class="flex flex-wrap items-start justify-between gap-3">
									<div class="space-y-1">
										<p class="text-sm font-semibold text-slate-900">Settings funnel</p>
										<p class="text-xs leading-5 text-slate-600">{funnelStatus.hostLabel}</p>
										<p class="text-xs leading-5 text-slate-500">{funnelStatus.adminHint}</p>
									</div>
									{funnelSummary ? (
										<div
											class="flex flex-wrap gap-3 text-xs text-slate-700"
											data-admin-funnel-summary
										>
											<span>Blockers: {funnelSummary.blockerShown}</span>
											<span>CTAs: {funnelSummary.ctaClicked}</span>
											<span>Completes: {funnelSummary.domainComplete}</span>
											{funnelSummary.ctaRatePercent != null ? (
												<span>CTA rate: {funnelSummary.ctaRatePercent}%</span>
											) : null}
										</div>
									) : null}
								</div>
								<p class="mt-2 text-xs text-slate-500">
									API:{" "}
									<code class="rounded bg-slate-200 px-1">
										GET /api/admin/providers/settings-funnel
									</code>
									{focusedProviderId ? `?providerId=${focusedProviderId}` : ""}
								</p>
							</Card>

							<div
								class:list={[
									"grid gap-6",
									focusedDetail ? "lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)]" : null,
								]}
								data-admin-workbench-grid
							>
								<div
									class:list={["min-w-0 space-y-6", focusedDetail ? "max-lg:hidden" : null]}
									data-admin-queue-panel
								>
									{isSlaFilter && slaTotal === 0 ? (
										<Card class="bg-slate-100">
											<p class="text-sm text-slate-700" data-sla-empty>
												No hay asignaciones {filter === "overdue" ? "vencidas" : "por vencer"} en
												este momento.
											</p>
											<div class="mt-3 flex flex-wrap gap-2">
												<Button href={queueHref("due_soon")} variant="secondary" size="sm">
													Ver por vencer
												</Button>
												<Button href={queueHref("all")} variant="secondary" size="sm">
													Ver pendientes
												</Button>
											</div>
										</Card>
									) : null}
									{sections.verification && (
										<Card class="bg-slate-100">
											<div class="mb-4 space-y-1">
												<p class="text-lg font-semibold text-slate-900">
													Verificación de cumplimiento
												</p>
												<p class="text-sm text-slate-600">
													Aprobar o rechazar al proveedor en bloque (decisión append-only en
													ProviderVerification).
												</p>
											</div>
											<div class="overflow-x-auto">
												<table class="min-w-full divide-y divide-slate-200">
													<thead>
														<tr class="text-left text-xs tracking-wide text-slate-600 uppercase">
															<th class="px-3 py-2">Proveedor</th>
															<th class="px-3 py-2">Estado</th>
															<th class="px-3 py-2">Actualizado</th>
															<th class="px-3 py-2">Acciones</th>
														</tr>
													</thead>
													<tbody class="divide-y divide-slate-200">
														{rows.map((row) => (
															<tr data-provider-row={row.providerId}>
																<td class="px-3 py-3 align-top">
																	<p class="text-sm font-semibold text-slate-900">
																		{row.displayName}
																	</p>
																	<p class="text-sm text-slate-700">{row.legalName}</p>
																	<p class="text-xs text-slate-500">ID: {row.providerId}</p>
																	<a
																		href={caseHref(row.providerId)}
																		class="mt-2 inline-block text-xs font-medium text-slate-900 underline"
																		data-case-open
																	>
																		Abrir caso
																	</a>
																</td>
																<td class="px-3 py-3 align-top">
																	{row.verificationStatus === "approved" ? (
																		<Badge variant="success">Aprobado</Badge>
																	) : row.verificationStatus === "rejected" ? (
																		<div class="space-y-2">
																			<Badge variant="error">Rechazado</Badge>
																			<p class="text-xs text-slate-700">
																				{row.verificationReason || "Sin motivo informado"}
																			</p>
																		</div>
																	) : (
																		<Badge variant="warning">Pendiente</Badge>
																	)}
																</td>
																<td class="px-3 py-3 align-top text-sm text-slate-700">
																	{row.verificationUpdatedAt
																		? fmt.format(new Date(row.verificationUpdatedAt))
																		: "Sin registros"}
																	{row.assignment ? (
																		<p
																			class:list={[
																				"mt-1 text-xs",
																				row.assignment.slaState === "overdue"
																					? "text-red-700"
																					: row.assignment.slaState === "due_soon"
																						? "text-amber-700"
																						: "text-slate-500",
																			]}
																		>
																			{row.assignment.assigneeEmail || "sin responsable"} ·{" "}
																			{row.assignment.slaState}
																		</p>
																	) : null}
																</td>
																<td class="px-3 py-3 align-top">
																	<div class="flex min-w-[340px] flex-col gap-2">
																		{row.verificationStatus !== "approved" && (
																			<Button
																				variant="primary"
																				data-approve-provider={row.providerId}
																				className="w-fit"
																			>
																				Aprobar
																			</Button>
																		)}
																		{row.verificationStatus === "pending" && !focusedDetail && (
																			<form
																				class="flex flex-col gap-2"
																				data-reject-form
																				data-row-reject
																				data-provider-id={row.providerId}
																			>
																				<select
																					class="fastt-field w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm"
																					data-reject-template
																					data-domain="verification"
																				>
																					<option value="">Plantilla de motivo…</option>
																					{adminComplianceRejectTemplates
																						.filter((item) => item.domain === "verification")
																						.map((item) => (
																							<option value={item.body}>{item.label}</option>
																						))}
																				</select>
																				<Textarea
																					name="reason"
																					rows="2"
																					required
																					minlength="2"
																					className="w-full"
																					placeholder="Motivo del rechazo"
																				/>
																				<Button type="submit" variant="danger" className="w-fit">
																					Rechazar
																				</Button>
																			</form>
																		)}
																		<AdminComplianceSlaAssign
																			providerId={row.providerId}
																			domain="verification"
																			entityId={row.providerId}
																			assignment={row.assignment}
																			currentAdminEmail={adminEmail}
																			assigneeShortcuts={assigneeShortcuts}
																		/>
																	</div>
																</td>
															</tr>
														))}
													</tbody>
												</table>
												{rows.length === 0 && (
													<p class="px-3 py-6 text-sm text-slate-600">
														No hay proveedores pendientes de verificación.
													</p>
												)}
											</div>
										</Card>
									)}

									{sections.fiscal && (
										<Card class="bg-slate-100">
											<div class="mb-4 space-y-1">
												<p class="text-lg font-semibold text-slate-900">Identidad fiscal</p>
												<p class="text-sm text-slate-600">
													Validar taxpayer info enviada por el proveedor (no puede auto-marcarse
													verificado).
												</p>
											</div>
											<div class="overflow-x-auto">
												<table class="min-w-full divide-y divide-slate-200">
													<thead>
														<tr class="text-left text-xs tracking-wide text-slate-600 uppercase">
															<th class="px-3 py-2">Proveedor</th>
															<th class="px-3 py-2">Datos</th>
															<th class="px-3 py-2">Estado</th>
															<th class="px-3 py-2">Acciones</th>
														</tr>
													</thead>
													<tbody class="divide-y divide-slate-200">
														{taxRows.map((row) => (
															<tr>
																<td class="px-3 py-3 align-top">
																	<p class="text-sm font-semibold text-slate-900">
																		{row.displayName}
																	</p>
																	<p class="text-xs text-slate-500">ID: {row.providerId}</p>
																</td>
																<td class="px-3 py-3 align-top text-sm text-slate-700">
																	<p>País: {row.taxResidenceCountry || "—"}</p>
																	<p>Registro: {row.businessRegistrationNumber || "—"}</p>
																	<p>Régimen: {row.taxRegime || "—"}</p>
																	{row.tinBureau ? (
																		<div
																			class="mt-2 space-y-1"
																			data-admin-tin-bureau={row.tinBureau.matchStatus}
																		>
																			<p class="text-xs font-semibold text-slate-800">
																				Bureau: {row.tinBureau.matchLabel}
																				{row.tinBureau.mode ? ` · ${row.tinBureau.mode}` : ""}
																			</p>
																			<p class="text-xs leading-5 text-slate-600">
																				{row.tinBureau.adminNarrative || row.tinBureau.message}
																			</p>
																		</div>
																	) : null}
																	{row.updatedAt ? (
																		<p class="text-xs text-slate-500">
																			{fmt.format(new Date(row.updatedAt))}
																		</p>
																	) : null}
																</td>
																<td class="px-3 py-3 align-top">
																	{row.status === "verified" ? (
																		<Badge variant="success">{row.statusLabel}</Badge>
																	) : row.status === "requires_attention" ? (
																		<Badge variant="error">{row.statusLabel}</Badge>
																	) : (
																		<Badge variant="warning">{row.statusLabel}</Badge>
																	)}
																	{row.assignment ? (
																		<p
																			class:list={[
																				"mt-1 text-xs",
																				row.assignment.slaState === "overdue"
																					? "text-red-700"
																					: row.assignment.slaState === "due_soon"
																						? "text-amber-700"
																						: "text-slate-500",
																			]}
																		>
																			{row.assignment.assigneeEmail || "sin responsable"} ·{" "}
																			{row.assignment.slaState}
																		</p>
																	) : null}
																</td>
																<td class="px-3 py-3 align-top">
																	<div class="flex min-w-[320px] flex-col gap-2">
																		{row.status !== "verified" && (
																			<Button
																				variant="primary"
																				className="w-fit"
																				data-verify-tax={row.providerId}
																			>
																				Marcar verificado
																			</Button>
																		)}
																		{!focusedDetail && (
																			<form
																				class="flex flex-col gap-2"
																				data-tax-attention-form
																				data-row-reject
																				data-provider-id={row.providerId}
																			>
																				<select
																					class="fastt-field w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm"
																					data-reject-template
																					data-domain="fiscal"
																				>
																					<option value="">Plantilla de motivo…</option>
																					{adminComplianceRejectTemplates
																						.filter((item) => item.domain === "fiscal")
																						.map((item) => (
																							<option value={item.body}>{item.label}</option>
																						))}
																				</select>
																				<Textarea
																					name="reason"
																					rows="2"
																					required
																					minlength="2"
																					className="w-full"
																					placeholder="Motivo (requiere atención)"
																				/>
																				<Button type="submit" variant="danger" className="w-fit">
																					Requiere atención
																				</Button>
																			</form>
																		)}
																		<AdminComplianceSlaAssign
																			providerId={row.providerId}
																			domain="fiscal"
																			entityId={row.providerId}
																			assignment={row.assignment}
																			currentAdminEmail={adminEmail}
																			assigneeShortcuts={assigneeShortcuts}
																		/>
																	</div>
																</td>
															</tr>
														))}
													</tbody>
												</table>
												{taxRows.length === 0 && (
													<p class="px-3 py-6 text-sm text-slate-600">
														No hay perfiles fiscales pendientes de revisión.
													</p>
												)}
											</div>
										</Card>
									)}

									{sections.documents && (
										<Card class="bg-slate-100">
											<div class="mb-4 space-y-1">
												<p class="text-lg font-semibold text-slate-900">
													Documentos de cumplimiento
												</p>
												<p class="text-sm text-slate-600">
													Verificar o rechazar respaldos enviados por el proveedor.
												</p>
											</div>
											<div class="overflow-x-auto">
												<table class="min-w-full divide-y divide-slate-200">
													<thead>
														<tr class="text-left text-xs tracking-wide text-slate-600 uppercase">
															<th class="px-3 py-2">Proveedor</th>
															<th class="px-3 py-2">Documento</th>
															<th class="px-3 py-2">Enviado</th>
															<th class="px-3 py-2">Acciones</th>
														</tr>
													</thead>
													<tbody class="divide-y divide-slate-200">
														{documentRows.map((doc) => (
															<tr>
																<td class="px-3 py-3 align-top">
																	<p class="text-sm font-semibold text-slate-900">
																		{doc.displayName}
																	</p>
