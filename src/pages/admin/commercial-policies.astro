										<div class="border-t border-slate-200 pt-3 text-sm text-slate-700">
											<p class="font-semibold">Retiro no disponible para esta cuenta</p>
											<p>
												Se requiere el permiso específico de retiro de políticas comerciales de
												Tours.
											</p>
										</div>
									)}
								{version.status === "draft" && !approved.length && canEdit && (
									<details>
										<summary class="cursor-pointer text-sm font-semibold">Añadir requisito</summary>
										<form
											action="/api/admin/commercial-policies"
											method="post"
											class="mt-4 space-y-4"
											data-agreement-form
										>
											<input type="hidden" name="action" value="rule" />
											<input type="hidden" name="versionId" value={version.id} />
											<PolicyEvidenceAlternatives
												definitions={documentDefinitions}
												versionId={version.id}
												allowLegacy={!composition}
											/>
											<div class="grid gap-4 sm:grid-cols-2">
												<FormField
													label="Clave estable del requisito"
													htmlFor={`${version.id}-key`}
													required
												>
													<Input
														id={`${version.id}-key`}
														name="requirementKey"
														required
														pattern="[a-z][a-z0-9_.]{2,100}"
													/>
												</FormField>
												<FormField label="Área" htmlFor={`${version.id}-domain`} required>
													<Select id={`${version.id}-domain`} name="domain">
														<option value="verification">Identidad</option>
														<option value="fiscal">Fiscalidad</option>
														<option value="documents">Documentos</option>
													</Select>
												</FormField>
												<fieldset data-policy-legacy-evidence>
													<FormField
														label="Categoría histórica"
														htmlFor={`${version.id}-evidence`}
														required
													>
														<Select id={`${version.id}-evidence`} name="evidence">
															<option value="government_id">Identidad</option>
															<option value="business_registration">Registro mercantil</option>
															<option value="tax_document">Documento fiscal</option>
															<option value="operating_license">Licencia</option>
															<option value="insurance">Seguro</option>
														</Select>
													</FormField>
												</fieldset>
												<FormField label="Alcance" htmlFor={`${version.id}-scope`} required>
													<Select id={`${version.id}-scope`} name="evidenceScope">
														<option value="product">Experiencia</option>
														<option value="provider">Proveedor</option>
														<option value="operation">Operación</option>
													</Select>
												</FormField>
												<FormField
													label="Responsable de revisión"
													htmlFor={`${version.id}-owner`}
													required
												>
													<Input
														id={`${version.id}-owner`}
														name="reviewOwner"
														required
														minlength="3"
													/>
												</FormField>
												<FormField label="Fuente" htmlFor={`${version.id}-source`} required>
													<Select id={`${version.id}-source`} name="sourceKind">
														<option value="legal">Normativa</option>
														<option value="contract">Contrato</option>
														<option value="fastt_policy">Política Fastt</option>
													</Select>
												</FormField>
												<FormField
													label="Referencia verificable"
													htmlFor={`${version.id}-reference`}
													required
												>
													<Input
														id={`${version.id}-reference`}
														name="sourceReference"
														required
														minlength="8"
													/>
												</FormField>
												<FormField
													label="Fecha de consulta"
													htmlFor={`${version.id}-checked`}
													required
												>
													<Input
														id={`${version.id}-checked`}
														name="sourceCheckedAt"
														type="date"
														required
													/>
												</FormField>
											</div>
											<FormField label="Acción si falta" htmlFor={`${version.id}-action`} required>
												<Textarea
													id={`${version.id}-action`}
													name="blockingAction"
													required
													minlength="10"
												/>
											</FormField>
											<fieldset class="flex flex-wrap gap-4">
												<legend class="mb-2 text-sm font-medium">Capacidades afectadas</legend>
												<Checkbox name="capabilities" value="publish" label="Publicar" />
												<Checkbox name="capabilities" value="booking" label="Reservar" />
												<Checkbox name="capabilities" value="integrations" label="Integraciones" />
											</fieldset>
											<Button type="submit">Guardar requisito</Button>
											<p role="status" data-agreement-feedback class="text-sm text-slate-600" />
										</form>
									</details>
								)}
								{version.status === "draft" && (
									<div class="space-y-3 border-t border-slate-200 pt-4">
										{areas.every(
											(area) =>
												approved.some((signature) => signature.approvalArea === area.id) &&
												principalHasPermission(principal, area.permission)
										) && (
											<form
												action={`/api/admin/commercial-policies/${version.id}/approvals`}
												data-agreement-form
												data-agreement-json
												class="flex flex-wrap items-end gap-3"
											>
												<input type="hidden" name="approvalArea" value="policy" />
												<input type="hidden" name="resumePublication" value="true" />
												<FormField
													label="Motivo de recuperación de publicación"
													for={`${version.id}-publication-recovery`}
													required
													class="min-w-60 flex-1"
												>
													<Input
														id={`${version.id}-publication-recovery`}
														name="approvalReference"
														required
														minlength="8"
													/>
												</FormField>
												<Button type="submit" variant="secondary">
													Completar publicación
												</Button>
												<p
													role="status"
													data-agreement-feedback
													class="w-full text-sm text-slate-600"
												/>
											</form>
										)}
										{areas.map((area) =>
											approved.some((s) => s.approvalArea === area.id) ? (
												<p class="text-sm text-slate-700">{area.label}: aprobada</p>
											) : principalHasPermission(principal, area.permission) ? (
												<form
													action={`/api/admin/commercial-policies/${version.id}/approvals`}
													data-agreement-form
													data-agreement-json
													class="flex flex-wrap items-end gap-3"
												>
													<input type="hidden" name="approvalArea" value={area.id} />
													<FormField
														label={`Referencia de aprobación · ${area.label}`}
														htmlFor={`${version.id}-${area.id}-approval`}
														required
														class="min-w-60 flex-1"
													>
														<Input
															id={`${version.id}-${area.id}-approval`}
															name="approvalReference"
															required
															minlength="8"
														/>
													</FormField>
													<Button type="submit" variant="secondary">
														Aprobar {area.label}
													</Button>
													<p
														role="status"
														data-agreement-feedback
														class="w-full text-sm text-slate-600"
													/>
												</form>
											) : (
												<p class="text-sm text-slate-500">
													{area.label}: pendiente del revisor autorizado
												</p>
											)
										)}
									</div>
								)}
							</Card>
						)
					})}
				</div>
				{!focusedVersionId && (
					<div data-compliance-panel="simulation" hidden={workspaceView !== "simulation"}>
						{providerId ? (
							<PolicyCompositionSimulation providerId={providerId} />
						) : (
							<p class="text-sm text-slate-500">
								Abre esta herramienta desde el expediente de un proveedor para comprobar una
								experiencia concreta.
							</p>
						)}
					</div>
				)}
				{!focusedVersionId && (
					<div data-compliance-panel="documents" hidden={workspaceView !== "documents"}>
						<DocumentDefinitionCatalog
							canEdit={canEdit}
							canPublish={principalHasPermission(principal, "policy.publish")}
						/>
					</div>
				)}
			</div>
		)
	}</InternalAdminLayout
>
<script>
	function selectComplianceView(view: string) {
		document.querySelectorAll<HTMLElement>("[data-compliance-panel]").forEach((panel) => {
			panel.hidden = panel.dataset.compliancePanel !== view
		})
		document.querySelectorAll<HTMLAnchorElement>("[data-compliance-view]").forEach((link) => {
			if (link.dataset.complianceView === view) link.setAttribute("aria-current", "page")
			else link.removeAttribute("aria-current")
		})
	}
	document.addEventListener("click", (event) => {
		if (
			!(event.target instanceof Element) ||
			!(event instanceof MouseEvent) ||
			event.metaKey ||
			event.ctrlKey ||
			event.shiftKey ||
			event.altKey ||
			event.button !== 0
		)
			return
		const back = event.target.closest<HTMLAnchorElement>("[data-policy-editor-back]")
		if (back) {
			const navigation = (
				window as Window & {
					navigation?: {
						currentEntry: { index: number } | null
						entries(): Array<{ url: string | null }>
					}
				}
			).navigation
			const index = navigation?.currentEntry?.index ?? 0
			const previous = index > 0 ? navigation?.entries()[index - 1]?.url : null
			const normalizeListUrl = (href: string) => {
				const url = new URL(href)
				if (url.searchParams.get("view") === "policies") url.searchParams.delete("view")
				url.searchParams.sort()
				url.hash = ""
				return url.href
			}
			if (previous && normalizeListUrl(previous) === normalizeListUrl(back.href)) {
				event.preventDefault()
				history.back()
			}
			return
		}
		const link = event.target.closest<HTMLAnchorElement>("[data-compliance-view]")
		if (!link) return
		event.preventDefault()
		selectComplianceView(link.dataset.complianceView!)
		history.pushState(null, "", link.href)
	})
	window.addEventListener("popstate", () =>
		selectComplianceView(new URL(location.href).searchParams.get("view") ?? "policies")
	)
	import { bindAgreementForms } from "@/lib/commercial-policy/agreement-forms"
	bindAgreementForms()
	function bindCompositionFields() {
		document.querySelectorAll<HTMLSelectElement>('[name="contractMode"]').forEach((mode) => {
			if (mode.dataset.compositionBound) return
			mode.dataset.compositionBound = "true"
			const fields = mode.form?.querySelector<HTMLFieldSetElement>(
				"[data-policy-composition-fields]"
			)
			const kind = mode.form?.querySelector<HTMLSelectElement>('[name="policyKind"]')
			const sync = () => {
				if (!fields) return
				fields.disabled = mode.value !== "composable"
				fields.classList.toggle("hidden", fields.disabled)
				fields.classList.toggle("grid", !fields.disabled)
				fields.querySelectorAll<HTMLInputElement>('[name="requiredFamilies"]').forEach((input) => {
					input.disabled = fields.disabled || kind?.value !== "admission"
				})
			}
			mode.addEventListener("change", sync)
			kind?.addEventListener("change", sync)
			sync()
		})
	}
	bindCompositionFields()
	document.addEventListener("astro:page-load", bindCompositionFields)
	function bindPolicyDates() {
		document.querySelectorAll<HTMLSelectElement>("[data-policy-start-mode]").forEach((mode) => {
			if (mode.dataset.bound) return
			mode.dataset.bound = "true"
			const field = mode.form?.querySelector<HTMLInputElement>('[name="effectiveFrom"]')
			const wrapper = mode.form?.querySelector<HTMLElement>("[data-policy-start-date]")
			const sync = () => {
				const scheduled = mode.value === "scheduled"
				if (field) {
					field.disabled = !scheduled
					field.required = scheduled
				}
				if (wrapper) wrapper.hidden = !scheduled
			}
			mode.addEventListener("change", sync)
			sync()
		})
	}
	bindPolicyDates()
	document.addEventListener("astro:page-load", bindPolicyDates)
	document.addEventListener("astro:page-load", bindAgreementForms)
</script>
