---
import { canRetireCommercialVersion } from "@/lib/commercial-policy/retirement-access"
import PolicyBusinessNavigation from "@/components/admin/PolicyBusinessNavigation.astro"
import CommercialPolicyCatalog from "@/components/admin/CommercialPolicyCatalog.astro"
import TerritorialPolicyRedesign from "@/components/admin/TerritorialPolicyRedesign.astro"
import {
	readOperatingPlaces,
	readTerritoryAncestors,
	resolveOperatingPlaceAliases,
} from "@/lib/tours/operating-geography"
import {
	buildCatalogTerritoryTree,
	catalogTerritoryPath,
	matchesCatalogTerritory,
} from "@/lib/commercial-policy/catalog-territories"
import DocumentDefinitionCatalog from "@/components/admin/DocumentDefinitionCatalog.astro"
import CommercialPolicyReviewDetails from "@/components/admin/CommercialPolicyReviewDetails.astro"
import CommercialPolicyPackageReview from "@/components/admin/CommercialPolicyPackageReview.astro"
import { documentAcceptanceSchema } from "@/shared/domain/document-acceptance"
import SegmentedControl from "@/components/ui/SegmentedControl.astro"
import PolicyCompositionSimulation from "@/components/admin/PolicyCompositionSimulation.astro"
import PolicyEvidenceAlternatives from "@/components/admin/PolicyEvidenceAlternatives.astro"
import ProviderPublicationPolicyBlockers from "@/components/admin/ProviderPublicationPolicyBlockers.astro"
import OperatingTerritoryPicker from "@/components/provider/OperatingTerritoryPicker.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Checkbox from "@/components/ui/Checkbox.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import Textarea from "@/components/ui/Textarea.astro"
import InternalAdminLayout from "@/layouts/InternalAdminLayout.astro"
import {
	principalHasPermission,
	requireInternalPermission,
} from "@/lib/auth/internal-authorization"
import { loadAdminPolicyBlockers } from "@/lib/commercial-policy/admin-publication-blockers"
import {
	commercialPolicyVersionLabel,
	compositionSchema,
	policyFamilies,
	policyFamilyLabels,
} from "@/lib/commercial-policy/composition"
import { listPublishedDocumentDefinitions } from "@/lib/documents/document-definitions"
import {
	tourComplianceActivityClasses,
	tourComplianceActivityLabels,
	tourOperatingRoles,
} from "@/lib/tours/tour-compliance-context"
import { EXPERIENCE_FORMATS } from "@/shared/domain/experience-format"
import { legalForms } from "@/shared/domain/legal-forms"
import { executionLabels, executionModes } from "@/shared/domain/tour-operation"
import {
	and,
	CommercialPolicyApproval,
	CompliancePolicySet,
	CompliancePolicyVersion,
	ComplianceRequirementRule,
	DocumentDefinition,
	DocumentDefinitionVersion,
	GeoPlace,
	db,
	desc,
	eq,
	inArray,
} from "@/shared/infrastructure/db/compat"
let principal
try {
	principal = await requireInternalPermission(Astro.request, "internal.admin.access")
} catch (error) {
	if (error instanceof Response) return error
	throw error
}
const providerId = Astro.url.searchParams.get("providerId")?.trim() ?? ""
const business = ["lodging", "transport"].includes(Astro.url.searchParams.get("business") ?? "")
	? Astro.url.searchParams.get("business")!
	: "tour"
const creatingVersion = Astro.url.searchParams.get("editor") === "create"
const baseVersionId = creatingVersion
	? (Astro.url.searchParams.get("base") ?? "").trim().slice(0, 200)
	: ""
const focusedVersionId = creatingVersion
	? ""
	: (Astro.url.searchParams.get("version") ?? "").trim().slice(0, 160)
const canEdit = principalHasPermission(principal, "policy.edit")
const workspaceViews = [
	{ id: "policies", label: "Políticas" },
	{ id: "documents", label: "Catálogo documental" },
	{ id: "simulation", label: "Comprobar cobertura" },
]
const workspaceView = workspaceViews.some((view) => view.id === Astro.url.searchParams.get("view"))
	? Astro.url.searchParams.get("view")!
	: "policies"
if (
	providerId &&
	!principalHasPermission(principal, "provider.compliance.read", {
		type: "provider",
		id: providerId,
	})
) {
	return new Response("Forbidden", { status: 403 })
}
let policyReadFailed = false
const policyBlockers =
	providerId && !creatingVersion
		? await loadAdminPolicyBlockers(providerId).catch((error) => {
				policyReadFailed = true
				console.error("admin.policy_diagnosis_failed", error)
				return []
			})
		: []
const rows =
	business !== "tour" || (creatingVersion && !canEdit)
		? []
		: await db
				.select({ version: CompliancePolicyVersion, set: CompliancePolicySet })
				.from(CompliancePolicyVersion)
				.innerJoin(
					CompliancePolicySet,
					eq(CompliancePolicySet.id, CompliancePolicyVersion.policySetId)
				)
				.where(
					and(
						eq(CompliancePolicySet.policyScope, "commercial"),
						eq(CompliancePolicySet.vertical, "tour"),
						focusedVersionId || baseVersionId
							? eq(CompliancePolicyVersion.id, focusedVersionId || baseVersionId)
							: undefined
					)
				)
				.orderBy(desc(CompliancePolicyVersion.createdAt))
				.limit(50)
const replacementOptions = rows.filter(
	(row) =>
		row.version.status === "published" &&
		compositionSchema.safeParse(
			(row.version.contextJson as Record<string, unknown> | null)?.composition
		).success
)
const ids = creatingVersion ? [] : rows.map((row) => row.version.id)
const [rules, signatures] = ids.length
	? await Promise.all([
			db
				.select()
				.from(ComplianceRequirementRule)
				.where(inArray(ComplianceRequirementRule.policyVersionId, ids)),
			db
				.select()
				.from(CommercialPolicyApproval)
				.where(inArray(CommercialPolicyApproval.policyVersionId, ids)),
		])
	: [[], []]
const listUrl = new URL(Astro.url)
listUrl.searchParams.delete("editor")
listUrl.searchParams.delete("base")
listUrl.searchParams.delete("version")
listUrl.searchParams.set("view", "policies")
const policyListHref = listUrl.pathname + listUrl.search
const createUrl = new URL(listUrl)
createUrl.searchParams.set("editor", "create")
if (creatingVersion && !canEdit) Astro.response.status = 403
const baseRow =
	baseVersionId && rows[0]?.version.status === "published" && rows[0].set.status === "active"
		? rows[0]
		: null
const evidenceIds = [
	...new Set(
		rules.flatMap((rule) => {
			const parsed = documentAcceptanceSchema.safeParse(rule.acceptedEvidenceJson)
			return parsed.success
				? parsed.data.alternatives.flatMap((alternative) =>
						alternative.allOf.map((part) => part.definitionVersionId)
					)
				: []
		})
	),
]
const territoryIds = [
	...new Set(
		rows.flatMap((row) => {
			const context = row.version.contextJson as { jurisdictionCodes?: unknown } | null
			return Array.isArray(context?.jurisdictionCodes)
				? context.jurisdictionCodes.filter((id): id is string => typeof id === "string")
				: []
		})
	),
]
const canonicalTerritoryIds = territoryIds.length
	? await resolveOperatingPlaceAliases(territoryIds)
	: []
const canonicalByAlias = new Map(
	territoryIds.map((id, index) => [id, canonicalTerritoryIds[index]])
)
const catalogAncestors = canonicalTerritoryIds.length
	? await readTerritoryAncestors(canonicalTerritoryIds)
	: {}
const catalogPlaces = await readOperatingPlaces([
	...new Set([...canonicalTerritoryIds, ...Object.values(catalogAncestors).flat()]),
])
const catalogTerritoryNodes = buildCatalogTerritoryTree(
	catalogPlaces,
	rows.map((row) => row.set.country)
)
const [reviewDefinitions, reviewTerritories] =
	!creatingVersion && workspaceView === "policies"
		? await Promise.all([
				evidenceIds.length
					? db
							.select({
								id: DocumentDefinitionVersion.id,
								key: DocumentDefinition.key,
								label: DocumentDefinitionVersion.label,
								description: DocumentDefinitionVersion.description,
								version: DocumentDefinitionVersion.version,
								capture: DocumentDefinitionVersion.captureJson,
							})
							.from(DocumentDefinitionVersion)
							.innerJoin(
								DocumentDefinition,
								eq(DocumentDefinition.id, DocumentDefinitionVersion.definitionId)
							)
							.where(inArray(DocumentDefinitionVersion.id, evidenceIds))
					: [],
				territoryIds.length
					? db
							.select({ id: GeoPlace.id, name: GeoPlace.canonicalName, kind: GeoPlace.placeType })
							.from(GeoPlace)
							.where(inArray(GeoPlace.id, territoryIds))
					: [],
			])
		: [[], []]
const holderFilter = ["entidad", "persona_natural"].includes(
	Astro.url.searchParams.get("holder") ?? ""
)
	? Astro.url.searchParams.get("holder")
	: null
const familyFilter: string = Astro.url.searchParams.get("family") ?? ""
const statusFilter = Astro.url.searchParams.get("status") ?? "current"
const requestedTerritory = Astro.url.searchParams.get("territory") ?? ""
const territoryFilter = canonicalByAlias.get(requestedTerritory) ?? requestedTerritory
const search = (Astro.url.searchParams.get("q") ?? "").trim().toLocaleLowerCase()
const applicableRows = rows.filter((row) => !holderFilter || row.set.holderType === holderFilter)
const catalogRows = applicableRows.filter(({ set, version }) => {
	const scope = version.contextJson as { jurisdictionCodes?: string[] } | null
	if (
		!matchesCatalogTerritory(
			territoryFilter,
			set.country,
			(scope?.jurisdictionCodes ?? []).map((id) => canonicalByAlias.get(id) ?? id),
			catalogAncestors
		)
	)
		return false
	const composition = getComposition(version.contextJson)
	const family =
		composition?.kind === "admission"
			? "admission"
			: (composition?.family ??
				(set.jurisdictionRole === "holder"
					? "identity"
					: set.jurisdictionRole === "tax"
						? "fiscal"
						: "other"))
	return (
		(!familyFilter || familyFilter === family) &&
		(!search ||
			`${set.label} ${set.key} ${catalogFamilyLabel(family)}`
				.toLocaleLowerCase()
				.includes(search)) &&
		(statusFilter === "all" ||
			(statusFilter === "draft"
				? version.status === "draft"
				: policyLifecycle(version) === "Vigente"))
	)
})
const catalogGroups = new Map<string, typeof rows>()
for (const row of catalogRows)
	catalogGroups.set(row.set.id, [...(catalogGroups.get(row.set.id) ?? []), row])
const visibleRows = focusedVersionId ? rows : []
const documentDefinitions =
	canEdit && !creatingVersion ? await listPublishedDocumentDefinitions() : []
function getComposition(context: unknown) {
	if (!context || typeof context !== "object") return null
	const parsed = compositionSchema.safeParse((context as Record<string, unknown>).composition)
	return parsed.success ? parsed.data : null
}
function catalogFamilyLabel(family: string | undefined) {
	if (family === "admission") return "Admisión"
	if (family === "other") return "Otras"
	if (family && (policyFamilies as readonly string[]).includes(family))
		return policyFamilyLabels[family as (typeof policyFamilies)[number]]
	return family ?? ""
}
function policyLifecycle(version: (typeof rows)[number]["version"]) {
	if (version.status === "draft") return "Borrador"
	if (version.status === "retired") return "Retirada"
	if (version.effectiveFrom.getTime() > Date.now()) return "Programada"
	if (version.effectiveTo && version.effectiveTo.getTime() <= Date.now()) return "Finalizada"
	return "Vigente"
}
const publishedSuccessors = new Map<string, string[]>()
for (const { version, set } of rows) {
	if (set.status !== "active" || policyLifecycle(version) !== "Vigente") continue
	for (const replacedId of getComposition(version.contextJson)?.replacesVersionIds ?? []) {
		const successors = publishedSuccessors.get(replacedId) ?? []
		successors.push(`Versión ${version.version}`)
		publishedSuccessors.set(replacedId, successors)
	}
}
const areas = [
	{ id: "policy", label: "Políticas", permission: "commercial_policy.policy.approve" as const },
	{ id: "finance", label: "Finanzas", permission: "commercial_policy.finance.approve" as const },
	{
		id: "tour_operations",
		label: "Operaciones Tours",
		permission: "commercial_policy.tour_operations.approve" as const,
	},
]
---

<InternalAdminLayout title="Políticas comerciales"
	>{
		Astro.url.searchParams.get("task") === "reorganization" ? (
			<TerritorialPolicyRedesign canEdit={canEdit} principal={principal} />
		) : !creatingVersion &&
		  !focusedVersionId &&
		  workspaceView === "policies" &&
		  Astro.url.searchParams.get("task") !== "ratification" ? (
			<CommercialPolicyCatalog
				business={business}
				family={familyFilter}
				holder={holderFilter}
				search={search}
				status={statusFilter}
				territory={territoryFilter}
				territoryNodes={catalogTerritoryNodes}
				canEdit={canEdit}
				territories={territoryIds.map((id) => ({
					id,
					label:
						reviewTerritories.find((place) => place.id === id || `geo:${place.id}` === id)?.name ??
						id.replace(/^geo:/, "").replaceAll("-", " "),
				}))}
				groups={[...catalogGroups.values()]
					.map((group) => {
						const { set, version } = group[0]
						const composition = getComposition(version.contextJson)
						const family =
							composition?.kind === "admission"
								? "Admisión"
								: composition
									? policyFamilyLabels[composition.family]
									: set.jurisdictionRole === "holder"
										? "Identidad y representación"
										: "Fiscalidad"
						return {
							id: set.id,
							label: commercialPolicyVersionLabel(set.label, version.contextJson),
							holder: set.holderType,
							country: set.country,
							territorialScope: (() => {
								const scope = version.contextJson as { jurisdictionCodes?: string[] } | null
								const codes = scope?.jurisdictionCodes ?? []
								const countryName =
									catalogTerritoryPath(`country:${set.country}`, catalogTerritoryNodes) ||
									set.country
								return codes.length
									? codes.map((id) => {
											const canonical = canonicalByAlias.get(id) ?? id
											const place = catalogPlaces.find((item) => item.id === canonical)
											if (place?.placeType === "country") return `${countryName} · Nacional`
											return (
												catalogTerritoryPath(canonical, catalogTerritoryNodes) ||
												`${countryName} · Territorio sin identificar`
											)
										})
									: [`${countryName} · Sin territorio especificado`]
							})(),
							family,
							versions: group.map(({ version: item }) => ({
								id: item.id,
								number: item.version,
								state: policyLifecycle(item),
								substituted: publishedSuccessors.has(item.id),
							})),
						}
					})
					.sort((a, b) => a.family.localeCompare(b.family) || a.label.localeCompare(b.label))}
			/>
		) : business !== "tour" ? (
			<section class="space-y-6">
				<h1 class="text-2xl font-semibold text-white">Políticas comerciales</h1>
				<PolicyBusinessNavigation business={business} />
				<div class="border-t border-slate-700 py-8 text-slate-200">
					<h2 class="text-lg font-semibold">
						{business === "lodging" ? "Alojamientos" : "Transporte"}
					</h2>
					<p class="mt-2 text-sm text-slate-300">
						El catálogo de esta línea de negocio todavía no está integrado en esta herramienta.
					</p>
				</div>
			</section>
		) : creatingVersion ? (
			<section class="mx-auto max-w-5xl space-y-6">
				<header class="space-y-2">
					<a
						href={policyListHref}
						data-policy-editor-back
						class="text-sm font-medium text-slate-200 underline"
					>
						Volver a políticas
					</a>
					<h1 class="text-2xl font-semibold text-white">
						{baseVersionId ? "Nueva versión" : "Nueva política de Tours"}
					</h1>
					<p class="text-sm text-slate-300">La versión se guardará como borrador.</p>
				</header>
				{canEdit && baseVersionId ? (
					baseRow ? (
						<form
							action="/api/admin/commercial-policies"
							method="post"
							class="space-y-6"
							data-agreement-form
							data-follow-command-redirect
						>
							<input type="hidden" name="action" value="create_version" />
							<input type="hidden" name="baseVersionId" value={baseRow.version.id} />
							<Card class="space-y-3">
								<p class="text-sm text-slate-600">
									Tours ·{" "}
									{getComposition(baseRow.version.contextJson)?.kind === "admission"
										? "Admisión"
										: catalogFamilyLabel(getComposition(baseRow.version.contextJson)?.family) ||
											"Política integral"}
								</p>
								<h2 class="text-lg font-semibold">{baseRow.set.label}</h2>
								<p class="text-sm text-slate-600">
									Versión de origen: {baseRow.version.version}. El borrador copiará su alcance y
									requisitos, sin copiar aprobaciones.
								</p>
								{getComposition(baseRow.version.contextJson) && (
									<Checkbox
										name="replaceBase"
										value="1"
										label="Proponer que el borrador sustituya a esta versión al publicarse"
									/>
								)}
								{getComposition(baseRow.version.contextJson)?.kind === "admission" && (
									<fieldset class="space-y-2 border-t border-slate-200 pt-3">
										<legend class="text-sm font-semibold">Quitar familias del borrador</legend>
										{getComposition(baseRow.version.contextJson)?.requiredFamilies.map((family) => (
											<label class="fastt-row-card flex min-h-10 cursor-pointer items-center gap-3 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-800 hover:bg-slate-50 has-checked:border-slate-500 has-checked:bg-slate-100">
												<input
													type="checkbox"
													name="removeRequiredFamily"
													value={family}
													class="fastt-check-input size-4 shrink-0 cursor-pointer appearance-auto"
												/>
												{policyFamilyLabels[family]}
											</label>
										))}
									</fieldset>
								)}
							</Card>
							<div class="flex flex-wrap justify-end gap-2">
								<Button href={policyListHref} variant="onDark" data-policy-editor-back>
									Cancelar
								</Button>
								<Button type="submit" variant="selection">
									Guardar borrador
								</Button>
							</div>
							<p role="status" data-agreement-feedback class="text-sm text-slate-200" />
						</form>
					) : (
						<Card>La versión de origen no está disponible.</Card>
					)
				) : canEdit ? (
					<form
						action="/api/admin/commercial-policies"
						method="post"
						class="space-y-6"
						data-agreement-form
						data-follow-command-redirect
					>
						<input type="hidden" name="action" value="create" />
						<Card class="space-y-4">
							<fieldset class="grid gap-4 sm:grid-cols-3">
								<legend class="mb-3 text-sm font-semibold">Política y composición</legend>
								<FormField label="Modelo" htmlFor="policy-contract-mode">
									<Select name="contractMode" id="policy-contract-mode">
										<>
											<option value="legacy">Política integral existente</option>
											<option value="composable">Familias componibles</option>
										</>
									</Select>
								</FormField>
								<fieldset
									data-policy-composition-fields
									disabled
									class="hidden gap-4 sm:col-span-3 sm:grid-cols-3"
								>
									<FormField label="Clave del conjunto" htmlFor="policy-code" required>
										<Input
											name="policyCode"
											id="policy-code"
											value="base"
											pattern="[a-z][a-z0-9_-]{0,80}"
											required
										/>
									</FormField>
									<FormField label="Función" htmlFor="policy-kind">
										<Select name="policyKind" id="policy-kind">
											<>
												<option value="admission">Admisión de la operación</option>
												<option value="requirements">Requisitos de una familia</option>
											</>
										</Select>
									</FormField>
									<FormField label="Familia" htmlFor="policy-family">
										<Select name="policyFamily" id="policy-family">
											{policyFamilies.map((family) => (
												<option value={family}>{policyFamilyLabels[family]}</option>
											))}
										</Select>
									</FormField>
									<fieldset class="space-y-2 sm:col-span-3">
										<>
											<legend class="text-sm font-medium">
												Familias requeridas por la admisión
											</legend>
											<div class="flex flex-wrap gap-4">
												{policyFamilies.map((family) => (
													<Checkbox
														name="requiredFamilies"
														value={family}
														label={policyFamilyLabels[family]}
													/>
												))}
											</div>
										</>
									</fieldset>
									<details class="sm:col-span-3">
										<>
											<summary class="cursor-pointer text-sm font-medium">
												Sustituir versiones aprobadas
											</summary>
											<div class="mt-3 grid gap-2">
												{replacementOptions.map((row) => (
													<Checkbox
														name="replacesVersionIds"
														value={row.version.id}
														label={`${row.set.label} · v${row.version.version}`}
													/>
												))}
											</div>
										</>
									</details>
								</fieldset>
							</fieldset>
						</Card>
						<Card class="space-y-5">
							<h2 class="font-semibold">A quién y dónde aplica</h2>
							<div class="grid gap-4 sm:grid-cols-3">
								<>
									<FormField label="País (código)" htmlFor="policy-country" required>
										<Input
											id="policy-country"
											name="country"
											pattern="[A-Z]{2}"
											required
											placeholder="BO"
										/>
									</FormField>
									<FormField label="Titular" htmlFor="policy-holder" required>
										<Select id="policy-holder" name="holderType">
											<>
												<option value="persona_natural">Persona natural</option>
												<option value="entidad">Entidad</option>
											</>
										</Select>
									</FormField>
									<FormField label="Ámbito" htmlFor="policy-role" required>
										<Select id="policy-role" name="jurisdictionRole">
											<>
												<option value="holder">Titular</option>
												<option value="product">Experiencia</option>
												<option value="tax">Fiscalidad</option>
											</>
										</Select>
									</FormField>
								</>
							</div>

							<fieldset class="space-y-2">
								<legend class="mb-2 font-medium">Papeles operativos</legend>
								{tourOperatingRoles.map((role) => (
									<Checkbox
										name="operatingRoles"
										value={role}
										label={
											{
												guide: "Guía independiente",
												operator: "Empresa operadora",
												intermediary: "Intermediario",
											}[role]
										}
									/>
								))}
							</fieldset>
							<fieldset class="grid gap-2 sm:grid-cols-3">
								<legend class="mb-2 font-medium">Actividades</legend>
								{tourComplianceActivityClasses
									.filter((activity) => activity !== "water_air")
									.map((activity) => (
										<Checkbox
											name="activityClasses"
											value={activity}
											label={tourComplianceActivityLabels[activity]}
										/>
									))}
							</fieldset>
							<fieldset class="grid gap-2 sm:grid-cols-3">
								<legend class="mb-2 font-medium">Territorios cubiertos</legend>
								<OperatingTerritoryPicker name="jurisdictionCodes" places={[]} />
							</fieldset>
							<fieldset class="grid gap-2 sm:grid-cols-2">
								<legend class="mb-2 font-medium">Formatos</legend>
								{EXPERIENCE_FORMATS.map((format) => (
									<Checkbox
										name="experienceFormats"
										value={format}
										label={
