---
import { parseCommandCenterQueueFilters } from "@/modules/casework/public"

const { filters } = parseCommandCenterQueueFilters(
	String(Astro.params.queueId ?? "all"),
	Astro.url.searchParams
)
const query = new URLSearchParams()
for (const key of [
	"domain",
	"priority",
	"riskTier",
	"status",
	"providerId",
	"sla",
	"cursor",
] as const) {
	const value = filters[key] ?? Astro.url.searchParams.get(key)
	if (value) query.set(key, value)
}
const search = Astro.url.searchParams.get("q")
if (search) query.set("q", search)
if (filters.unassigned || Astro.url.searchParams.get("unassigned") === "1")
	query.set("unassigned", "1")
return Astro.redirect(
	query.size ? `/admin/providers/directory?${query}` : "/admin/providers/directory",
	302
)
---
