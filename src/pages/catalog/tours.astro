---
import { ArrowLeft, Map, Plus } from "@lucide/astro"

import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import WorkspaceMetricStat from "@/components/ui/WorkspaceMetricStat.astro"
import WorkspaceMetricStats from "@/components/ui/WorkspaceMetricStats.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { getProductVerticalEntry } from "@/lib/catalog/productVerticalRegistry"
import { getProviderCatalogSummary } from "@/lib/catalog/providerCatalogSummary"
import { buildCompleteToPublishEntryHref } from "@/lib/playbook/complete-to-publish"
import { summarizeProductPreparation } from "@/lib/playbook/summarize-product-preparation"
import { routes } from "@/lib/routes"
import { summarizeTourCatalog } from "@/lib/tours/tourDiagnosticPresentation"
import { buildTourCommercialLinks, contextualizeTourLink } from "@/lib/tours/tourProviderNavigation"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const vertical = getProductVerticalEntry("tour")
const catalog = await getProviderCatalogSummary(providerId, vertical.productType)
const taskRows = await Promise.all(
	catalog.products.map(async (product) => {
		const preparation = await summarizeProductPreparation({
			productId: product.id,
			providerId,
			status: product.status.state,
			request: Astro.request,
			url: Astro.url,
		})
		const baseLinks = buildTourCommercialLinks({
			productId: product.id,
			variantId:
				preparation?.tourContext && "variantId" in preparation.tourContext
					? preparation.tourContext.variantId
					: null,
			ratePlanId:
				preparation?.tourContext && "ratePlanId" in preparation.tourContext
					? preparation.tourContext.ratePlanId
					: null,
		})
		const context = preparation?.tourContext
		const links =
			context && "options" in context
				? (Object.fromEntries(
						Object.entries(baseLinks).map(([key, href]) => [
							key,
							contextualizeTourLink(href, context),
						])
					) as typeof baseLinks)
				: baseLinks
		const primaryTask = preparation?.tourPresentation
			? {
					label:
						product.status.state === "published"
							? preparation.tourPresentation.primaryAction.label
							: preparation.tourPresentation.preparation.complete
								? "Publicar tour"
								: "Continuar preparación",
					href:
						product.status.state === "published"
							? preparation.tourPresentation.primaryAction.href
							: preparation.tourPresentation.preparation.complete
								? preparation.previewHref
								: preparation.continuePreparationHref,
				}
			: product.status.state === "published"
				? { label: "Revisar disponibilidad", href: links.calendarHref }
				: preparation?.readyToPublish
					? { label: "Revisar y publicar", href: preparation.previewHref }
					: {
							label: preparation?.nextStepCta ?? "Continuar preparación",
							href:
								preparation?.continuePreparationHref ?? buildCompleteToPublishEntryHref(product.id),
						}
		return {
			product,
			preparation,
			links,
			primaryTask,
			detailHref:
				context && "options" in context
					? contextualizeTourLink(routes.productDetail(product.id), context)
					: routes.productDetail(product.id),
		}
	})
)
const evaluatedSummary = summarizeTourCatalog(
	taskRows.map(({ product, preparation }) => ({
		published: product.status.state === "published",
		presentation: preparation?.tourPresentation,
	}))
)
---

<WorkspaceLayout title="Tours">
	<section class="space-y-6">
		<Card variant="dark" class="!border-neutral-800 !bg-black">
			<div class="flex flex-wrap items-start justify-between gap-5">
				<div class="max-w-3xl space-y-3">
					<a
						href={routes.dashboard()}
						class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 hover:text-white"
					>
						<ArrowLeft class="h-4 w-4" aria-hidden="true" />Inicio</a
					>
					<div class="space-y-2">
						<p
							class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.14em] text-neutral-500 uppercase"
						>
							<Map class="h-4 w-4" aria-hidden="true" />
							Tours
						</p>
						<h1 class="text-3xl font-semibold tracking-tight text-white">Tours</h1>
						<p class="text-sm leading-6 text-neutral-400">
							Prepara experiencias con punto de encuentro, duración, itinerario, fotos, cupos y
							disponibilidad sin mezclarlo con la operación hotelera.
						</p>
					</div>
				</div>
				<Button href={vertical.routes.workspaceCreateHref} variant="onDark">
					<Plus class="h-4 w-4" aria-hidden="true" />
					Crear tour
				</Button>
			</div>
		</Card>

		<WorkspaceMetricStats class="md:grid-cols-4" ariaLabel="Resumen de tours">
			<WorkspaceMetricStat label="Tours">{evaluatedSummary.total}</WorkspaceMetricStat>
			<WorkspaceMetricStat label="Publicados">{evaluatedSummary.published}</WorkspaceMetricStat>
			<WorkspaceMetricStat label="Fichas preparadas"
				>{evaluatedSummary.prepared}</WorkspaceMetricStat
			>
			<WorkspaceMetricStat label="Listos para publicar"
				>{evaluatedSummary.readyToPublish}</WorkspaceMetricStat
			>
		</WorkspaceMetricStats>

		<section class="space-y-4">
			<div class="space-y-1">
				<h2 class="text-xl font-semibold text-white">Qué necesita atención</h2>
				<p class="text-sm leading-6 text-slate-400">
					Continúa el requisito exacto de cada tour o abre directamente su operación diaria.
				</p>
			</div>
			{
				taskRows.length === 0 ? (
					<Card class="grid gap-4 bg-white md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
						<div class="space-y-1">
							<h3 class="text-lg font-semibold text-slate-950">Todavía no hay tours</h3>
							<p class="text-sm leading-6 text-slate-500">
								Crea una ficha inicial y completa contenido, itinerario, tickets, salida, precio y
								cupo para poder publicarla.
							</p>
						</div>
						<Button href={vertical.routes.workspaceCreateHref}>Crear tour</Button>
					</Card>
				) : (
					<div class="grid gap-3">
						{taskRows.map(({ product, preparation, links, primaryTask, detailHref }) => (
							<Card class="grid gap-5 bg-white p-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
								<div class="min-w-0 space-y-3">
									<div class="flex flex-wrap items-center gap-2">
										<h3 class="truncate text-base font-semibold text-slate-950">{product.name}</h3>
										<Badge variant={product.status.state === "published" ? "success" : "neutral"}>
											{product.status.state === "published" ? "Publicado" : "Borrador"}
										</Badge>
										<Badge
											variant={preparation?.tourPresentation?.catalogStatus.variant ?? "warning"}
										>
											{preparation?.tourPresentation?.catalogStatus.label ?? "Evaluación pendiente"}
										</Badge>
									</div>
									{preparation && !preparation.isPublished ? (
										<>
											<div class="flex max-w-xl items-center gap-3">
												<div
													class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200"
													role="progressbar"
													aria-label="Preparación del tour"
													aria-valuemin={0}
													aria-valuemax={100}
													aria-valuenow={preparation.readinessPercent}
												>
													<div
														class="h-full rounded-full bg-slate-950"
														style={`width: ${Math.max(0, Math.min(100, preparation.readinessPercent))}%`}
													/>
												</div>
												<span class="text-xs font-medium text-slate-500 tabular-nums">
													{preparation.readinessPercent}%
												</span>
											</div>
											<p class="text-sm text-slate-600">
												<span class="font-semibold text-slate-900">Siguiente:</span>{" "}
												{preparation.nextStepLabel ?? "Revisar preparación"}
												{preparation.nextStepBody ? ` · ${preparation.nextStepBody}` : ""}
											</p>
										</>
									) : (
										<p class="text-sm text-slate-600">
											{preparation?.tourPresentation?.support ??
												"No se pudo evaluar la oferta. Vuelve a revisar su preparación."}
										</p>
									)}
								</div>
								<div class="flex max-w-xl flex-wrap justify-start gap-2 lg:justify-end">
									<Button href={primaryTask.href} variant="selection" size="sm">
										{primaryTask.label}
									</Button>
									<Button
										href={preparation?.previewHref ?? routes.productPreview(product.id)}
										variant="secondary"
										size="sm"
									>
										Vista previa
									</Button>
									<Button href={detailHref} variant="secondary" size="sm">
										Editar ficha
									</Button>
									{product.primaryVariantId ? (
										<>
											<Button href={links.priceHref} variant="ghost" size="sm">
												Precio
											</Button>
											<Button href={links.calendarHref} variant="ghost" size="sm">
												Disponibilidad
											</Button>
										</>
									) : null}
								</div>
							</Card>
						))}
					</div>
				)
			}
		</section>
	</section>
</WorkspaceLayout>
