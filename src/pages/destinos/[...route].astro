---
import MarketplaceDestinationResults from "@/components/marketplace/MarketplaceDestinationResults.astro"
import { getPublicDestinationListings } from "@/lib/marketplace/publicDestinationListings"
import {
	publicDestinationHref,
	type PublicMarketplaceVertical,
} from "@/lib/marketplace/publicDestinationRoutes"

const routeParts = (Astro.params.route ?? "").split("/").filter(Boolean)
const rawVertical = routeParts.pop() ?? ""
const vertical: PublicMarketplaceVertical | null =
	rawVertical === "alojamientos" || rawVertical === "tours" ? rawVertical : null
if (!vertical || routeParts.length === 0) return Astro.redirect("/", 308)

const requestedPath = routeParts.join("/")
const { destination, listings } = await getPublicDestinationListings({
	path: requestedPath,
	vertical,
})
if (!destination) return Astro.redirect(vertical === "alojamientos" ? "/hotels" : "/tours", 302)

if (requestedPath !== destination.canonicalPath) {
	return Astro.redirect(publicDestinationHref(destination.canonicalPath, vertical), 308)
}
---

<MarketplaceDestinationResults
	vertical={vertical}
	destination={destination}
	listings={listings}
	searchParams={Astro.url.searchParams}
/>
