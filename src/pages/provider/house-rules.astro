---
import { and, db, eq, first, ne, Product, Variant } from "@/shared/infrastructure/db/compat"

import Badge from "@/components/ui/Badge.astro"
import BottomToast from "@/components/ui/BottomToast.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import HouseRuleEditorRow from "@/components/house-rules/HouseRuleEditorRow.astro"
import HouseRuleVariantOverrideRow from "@/components/house-rules/HouseRuleVariantOverrideRow.astro"
import RatePlanArrivalExceptionPanel from "@/components/house-rules/RatePlanArrivalExceptionPanel.astro"
import TabsOutsidePanel from "@/components/ui/TabsOutsidePanel.astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import { CircleCheck, ClipboardList } from "@lucide/astro"
import { requireProvider } from "@/lib/auth/requireProvider"
import { buildPlaybookHref } from "@/lib/playbook/launch-accommodation"
import { resolvePlaybookFromUrl } from "@/lib/playbook/resolve-playbook"
import { refreshProductOperationalSurfaceAfterMutation } from "@/lib/product/productOperationalSurface"
import { syncHotelArrivalPolicy } from "@/lib/policies/syncHotelArrivalPolicy"
import {
	getRatePlanArrivalContext,
	removeRatePlanArrivalException,
	upsertRatePlanArrivalException,
} from "@/lib/policies/ratePlanArrivalException"
import { routes } from "@/lib/routes"
import {
	essentialHouseRuleTypes,
	houseRuleCopy,
	houseRuleGroups,
	houseRuleQuickSetups,
	houseRuleTypes,
	spaceVariantEditorTypes,
} from "@/modules/house-rules/presentation/houseRulePresentation"
import {
	buildHouseRuleGuestSummary,
	createHouseRule,
	deleteHouseRule,
	isVariantOverrideHouseRuleType,
	listEffectiveHouseRules,
	listHouseRulesByProduct,
	listHouseRulesByProductIds,
	type HouseRule,
	type HouseRulePayload,
	type HouseRuleType,
} from "@/modules/house-rules/public"

const auth = await requireProvider(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

type ProductOption = {
	id: string
	name: string
	productType: string
}

async function loadProviderProducts(providerId: string): Promise<ProductOption[]> {
	const rows = await db
		.select({
			id: Product.id,
			name: Product.name,
			productType: Product.productType,
		})
		.from(Product)
		.where(eq(Product.providerId, providerId))

	return rows.map((row) => ({
		id: String(row.id),
		name: String(row.name),
		productType: String(row.productType ?? "Alojamiento"),
	}))
}

async function loadRulesByProduct(products: ProductOption[]) {
	return (await listHouseRulesByProductIds(products.map((product) => product.id))) as Map<
		string,
		HouseRule[]
	>
}

async function findOwnedHouseRule(
	products: ProductOption[],
	rulesByProduct: Map<string, HouseRule[]>,
	ruleId: string,
	variantId?: string
): Promise<HouseRule | null> {
	for (const rules of rulesByProduct.values()) {
		const found = rules.find((rule) => rule.id === ruleId)
		if (found) return found
	}
	const roomId = String(variantId ?? "").trim()
	if (!roomId) return null
	for (const product of products) {
		const effective = await listEffectiveHouseRules(product.id, roomId)
		const found = effective.find((rule) => rule.id === ruleId && rule.source === "override")
		if (found) return found
	}
	return null
}

function boolFromForm(form: FormData, key: string): boolean | undefined {
	const raw = String(form.get(key) ?? "").trim()
	if (raw === "true") return true
	if (raw === "false") return false
	return undefined
}

function listFromForm(form: FormData, key: string): string[] {
	return form
		.getAll(key)
		.map((item) => String(item ?? "").trim())
		.filter(Boolean)
}

function payloadFromForm(type: HouseRuleType, form: FormData): HouseRulePayload {
	const note = String(form.get("note") ?? "").trim()
	const base: HouseRulePayload = { kind: type }
	if (note) base.note = note

	switch (type) {
		case "Pets":
			return {
				...base,
				allowed: boolFromForm(form, "allowed"),
				feeNote: String(form.get("feeNote") ?? "").trim() || undefined,
			}
		case "Children":
			return {
				...base,
				allowed: boolFromForm(form, "allowed"),
				conditions: String(form.get("conditions") ?? "").trim() || undefined,
			}
		case "Smoking":
			return {
				...base,
				allowed: boolFromForm(form, "allowed"),
				area: (String(form.get("smokingArea") ?? "").trim() || undefined) as any,
			}
		case "Parties":
			return { ...base, allowed: boolFromForm(form, "allowed") }
		case "QuietHours":
			return {
				...base,
				start: String(form.get("quietStart") ?? "").trim() || undefined,
				end: String(form.get("quietEnd") ?? "").trim() || undefined,
			}
		case "Parking":
			return {
				...base,
				available: boolFromForm(form, "available"),
				parkingType: (String(form.get("parkingType") ?? "").trim() || undefined) as any,
			}
		case "CheckIn":
		case "Access":
			return {
				...base,
				method: (String(form.get("checkInMethod") ?? "").trim() || undefined) as any,
				checkInFrom: String(form.get("checkInFrom") ?? "").trim() || undefined,
				checkInUntil: String(form.get("checkInUntil") ?? "").trim() || undefined,
				instructions: String(form.get("instructions") ?? "").trim() || undefined,
				idRequired: form.get("idRequired") === "on",
				cardRequired: form.get("cardRequired") === "on",
			}
		case "Checkout":
			return {
				...base,
				time: String(form.get("checkoutTime") ?? "").trim() || undefined,
				tasks: listFromForm(form, "checkoutTasks"),
				instructions: String(form.get("instructions") ?? "").trim() || undefined,
			}
		default:
			return {
				...base,
				instructions: String(form.get("instructions") ?? "").trim() || undefined,
			}
	}
}

let actionError: string | null = null
const requestedProductId = String(Astro.url.searchParams.get("productId") ?? "").trim()
const requestedVariantId = String(Astro.url.searchParams.get("variantId") ?? "").trim()
const requestedRatePlanId = String(Astro.url.searchParams.get("ratePlanId") ?? "").trim()
const focus = String(Astro.url.searchParams.get("focus") ?? "").trim()
const requestedReturnTo = String(Astro.url.searchParams.get("returnTo") ?? "").trim()
const safeReturnTo =
	requestedReturnTo.startsWith("/") && !requestedReturnTo.startsWith("//") ? requestedReturnTo : ""
const houseRuleViews = ["essential", "arrival", "optional", "preview"] as const
type HouseRuleView = (typeof houseRuleViews)[number]
const houseRuleEditorViews = ["essential", "arrival", "optional"] as const

function redirectToHouseRules(success: string, productId?: string, view?: string) {
	const params = new URLSearchParams({ success })
	const contextualProductId = String(productId ?? "").trim()
	if (contextualProductId) params.set("productId", contextualProductId)
	const vista = String(view ?? Astro.url.searchParams.get("vista") ?? "").trim()
	if (houseRuleViews.includes(vista as HouseRuleView)) {
		params.set("vista", vista)
	} else if (focus === "arrival") {
		params.set("focus", "arrival")
	}
	if (safeReturnTo) params.set("returnTo", safeReturnTo)
	const activePlaybook = resolvePlaybookFromUrl(Astro.url, { isHotel: true })
	const contextualVariantId = String(Astro.url.searchParams.get("variantId") ?? "").trim()
	const contextualRatePlanId = String(Astro.url.searchParams.get("ratePlanId") ?? "").trim()
	if (
		contextualRatePlanId &&
		activePlaybook.playbookId !== "launch" &&
		activePlaybook.playbookId !== "complete-to-publish"
	) {
		params.set("ratePlanId", contextualRatePlanId)
		params.set("focus", "arrival")
		params.delete("variantId")
	} else if (
		contextualVariantId &&
		activePlaybook.playbookId !== "launch" &&
		activePlaybook.playbookId !== "complete-to-publish"
	) {
		params.set("variantId", contextualVariantId)
	}
	if (activePlaybook.playbookId === "launch") {
		params.set("playbook", "launch")
		params.set("step", "house-rules")
		params.set("flow", "create")
	} else if (activePlaybook.playbookId === "complete-to-publish") {
		params.set("playbook", "complete-to-publish")
		params.set("step", "houseRules")
		params.set("flow", "complete")
	}
	return Astro.redirect(`${routes.providerHouseRules()}?${params.toString()}`)
}

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData()
	const action = String(form.get("action") ?? "").trim()
	const postedView = String(form.get("vista") ?? Astro.url.searchParams.get("vista") ?? "").trim()
	try {
		const products = await loadProviderProducts(auth.providerId)
		const ownedProductIds = new Set(products.map((product) => product.id))
		if (action === "create-house-rule") {
			const productId = String(form.get("productId") ?? "").trim()
			const type = String(form.get("type") ?? "").trim() as HouseRuleType
			const variantId = String(form.get("variantId") ?? "").trim()
			const scope =
				variantId && String(form.get("scope") ?? "").trim() === "variant" ? "variant" : "product"
			const payload = payloadFromForm(type, form)
			if (!ownedProductIds.has(productId)) throw new Error("El alojamiento no está disponible")
			if (!houseRuleTypes.includes(type)) throw new Error("Tipo de regla no compatible")
			if (scope === "variant") {
				if (!variantId) throw new Error("La habitación no está disponible")
				if (!isVariantOverrideHouseRuleType(type)) {
					throw new Error("Este tipo de regla no admite excepciones por habitación")
				}
				if (!spaceVariantEditorTypes.includes(type)) {
					throw new Error("Este tipo de regla no se edita en este espacio")
				}
				await createHouseRule({
					productId,
					type,
					payload,
					scope: "variant",
					scopeId: variantId,
				})
			} else {
				await createHouseRule({ productId, type, payload })
				if (type === "CheckIn" || type === "Checkout") {
					await syncHotelArrivalPolicy({
						providerId: auth.providerId,
						productId,
						actorUserId: auth.user.id,
						rules: (await listHouseRulesByProduct(productId)) as HouseRule[],
					})
				}
			}
			await refreshProductOperationalSurfaceAfterMutation({
				productId,
				providerId: auth.providerId,
				request: Astro.request,
				url: Astro.url,
				source:
					scope === "variant"
						? "provider.house-rules.create-variant-override"
						: "provider.house-rules.create",
			})
			return redirectToHouseRules(
				scope === "variant" ? "override-saved" : "created",
				productId,
				postedView
			)
		}
		if (action === "apply-quick-setup") {
			const productId = String(form.get("productId") ?? "").trim()
			const presetKey = String(form.get("presetKey") ?? "").trim()
			const preset = houseRuleQuickSetups.find((item) => item.key === presetKey)
			if (!ownedProductIds.has(productId)) throw new Error("El alojamiento no está disponible")
			if (!preset) throw new Error("La configuración rápida no está disponible")

			const rulesByProduct = await loadRulesByProduct(products)
			const existingTypes = new Set(
				(rulesByProduct.get(productId) ?? []).map((rule) => String(rule.type ?? "Other"))
			)
			for (const item of preset.rules) {
				if (existingTypes.has(item.type)) continue
				await createHouseRule({ productId, type: item.type, payload: item.payload })
				existingTypes.add(item.type)
			}
			await syncHotelArrivalPolicy({
				providerId: auth.providerId,
				productId,
				actorUserId: auth.user.id,
				rules: (await listHouseRulesByProduct(productId)) as HouseRule[],
			})
			await refreshProductOperationalSurfaceAfterMutation({
				productId,
				providerId: auth.providerId,
				request: Astro.request,
				url: Astro.url,
				source: "provider.house-rules.quick-setup",
			})
			return redirectToHouseRules("preset-applied", productId, postedView)
		}
		if (action === "delete-house-rule") {
			const ruleId = String(form.get("ruleId") ?? "").trim()
			const variantId = String(form.get("variantId") ?? "").trim()
			const rulesByProduct = await loadRulesByProduct(products)
			const ownedRule = await findOwnedHouseRule(products, rulesByProduct, ruleId, variantId)
			if (!ownedRule) throw new Error("La regla no está disponible")
			if (ownedRule.scope === "variant") {
				if (!variantId || ownedRule.scopeId !== variantId) {
					throw new Error("La excepción no pertenece a este espacio")
				}
			}
			await deleteHouseRule(ruleId)
			if (
				ownedRule.scope === "product" &&
				(ownedRule.type === "CheckIn" || ownedRule.type === "Checkout")
			) {
				await syncHotelArrivalPolicy({
					providerId: auth.providerId,
					productId: ownedRule.productId,
					actorUserId: auth.user.id,
					rules: (await listHouseRulesByProduct(ownedRule.productId)) as HouseRule[],
				})
			}
			await refreshProductOperationalSurfaceAfterMutation({
				productId: ownedRule.productId,
				providerId: auth.providerId,
				request: Astro.request,
				url: Astro.url,
				source:
					ownedRule.scope === "variant"
						? "provider.house-rules.delete-variant-override"
						: "provider.house-rules.delete",
			})
			return redirectToHouseRules(
				ownedRule.scope === "variant" ? "override-removed" : "deleted",
				ownedRule.productId,
				postedView
			)
		}
		if (action === "upsert-rate-arrival-exception") {
			const productId = String(form.get("productId") ?? "").trim()
			const ratePlanId = String(form.get("ratePlanId") ?? "").trim()
			if (!ownedProductIds.has(productId)) throw new Error("El alojamiento no está disponible")
			const context = await getRatePlanArrivalContext({ productId, ratePlanId })
			if (!context) throw new Error("La tarifa no está disponible")
			await upsertRatePlanArrivalException({
				providerId: auth.providerId,
				ratePlanId,
				actorUserId: auth.user.id,
				schedule: {
					checkInFrom: String(form.get("checkInFrom") ?? "").trim(),
					checkInUntil: String(form.get("checkInUntil") ?? "").trim(),
					checkOutUntil: String(form.get("checkOutUntil") ?? "").trim(),
				},
			})
			await refreshProductOperationalSurfaceAfterMutation({
				productId,
				providerId: auth.providerId,
				request: Astro.request,
				url: Astro.url,
				source: "provider.house-rules.rate-arrival-upsert",
			})
			return redirectToHouseRules("rate-arrival-saved", productId, "arrival")
		}
		if (action === "remove-rate-arrival-exception") {
			const productId = String(form.get("productId") ?? "").trim()
			const ratePlanId = String(form.get("ratePlanId") ?? "").trim()
			if (!ownedProductIds.has(productId)) throw new Error("El alojamiento no está disponible")
			const context = await getRatePlanArrivalContext({ productId, ratePlanId })
			if (!context) throw new Error("La tarifa no está disponible")
			await removeRatePlanArrivalException({
				providerId: auth.providerId,
				ratePlanId,
				actorUserId: auth.user.id,
			})
			await refreshProductOperationalSurfaceAfterMutation({
				productId,
				providerId: auth.providerId,
				request: Astro.request,
				url: Astro.url,
				source: "provider.house-rules.rate-arrival-remove",
			})
			return redirectToHouseRules("rate-arrival-removed", productId, "arrival")
		}
	} catch (error) {
		actionError = error instanceof Error ? error.message : "No se pudo actualizar la regla"
	}
}

const products = await loadProviderProducts(auth.providerId)
const rulesByProduct = await loadRulesByProduct(products)
const success = String(Astro.url.searchParams.get("success") ?? "").trim()
const playbook = resolvePlaybookFromUrl(Astro.url, { isHotel: true })
const isLaunchWizard =
	playbook.playbookId === "launch" && (playbook.stepId ?? "house-rules") === "house-rules"
const isCompleteWizard =
	playbook.playbookId === "complete-to-publish" &&
	(playbook.stepId === "houseRules" || playbook.stepId === "house-rules")
const isGuidedRules = isLaunchWizard || isCompleteWizard
const requestedView = String(Astro.url.searchParams.get("vista") ?? "").trim()
const activeView: HouseRuleView =
	focus === "arrival"
		? "arrival"
		: isGuidedRules && requestedView === "preview"
			? "essential"
			: houseRuleViews.includes(requestedView as HouseRuleView)
				? (requestedView as HouseRuleView)
				: "essential"
const selectedProduct =
	products.find((product) => product.id === requestedProductId) ?? products[0] ?? null
const selectedProductId = selectedProduct?.id ?? ""
const hasProductContext = Boolean(requestedProductId && selectedProduct)
const rateArrivalContext =
	!isGuidedRules && selectedProductId && requestedRatePlanId
		? await getRatePlanArrivalContext({
				productId: selectedProductId,
				ratePlanId: requestedRatePlanId,
			})
		: null
const isRateContext = Boolean(rateArrivalContext)
const spaceRoom =
	!isGuidedRules && !isRateContext && selectedProductId && requestedVariantId
		? await db
				.select({ id: Variant.id, name: Variant.name })
				.from(Variant)
				.where(
					and(
						eq(Variant.id, requestedVariantId),
						eq(Variant.productId, selectedProductId),
						eq(Variant.kind, "hotel_room"),
						ne(Variant.lifecycleState, "archived")
					)
				)
				.then(first)
		: null
const spaceContext = spaceRoom
	? { id: String(spaceRoom.id), name: String(spaceRoom.name || "Habitación") }
	: null
const isSpaceContext = Boolean(spaceContext) && !isRateContext
const spaceEffectiveRules =
	isSpaceContext && selectedProductId && spaceContext
		? await listEffectiveHouseRules(selectedProductId, spaceContext.id)
		: []
const spaceOverrideCount = spaceEffectiveRules.filter((rule) => rule.source === "override").length
const spaceOverrideByType = new Map<HouseRuleType, HouseRule>()
for (const rule of spaceEffectiveRules) {
	if (rule.source === "override") {
		spaceOverrideByType.set(String(rule.type ?? "Other") as HouseRuleType, rule)
	}
}
const visibleProducts = hasProductContext && selectedProduct ? [selectedProduct] : products
const stateByProduct = products.map((product) => {
	const rules = rulesByProduct.get(product.id) ?? []
	const typeSet = new Set(rules.map((rule) => String(rule.type ?? "Other") as HouseRuleType))
	const missingEssentials = essentialHouseRuleTypes.filter((type) => !typeSet.has(type))
	return {
		product,
		rules,
		typeSet,
		missingEssentials,
		ready: missingEssentials.length === 0,
	}
})
const selectedState =
	(hasProductContext
		? stateByProduct.find((item) => item.product.id === selectedProductId)
		: stateByProduct.find((item) => item.rules.length)) ?? stateByProduct[0]
const previewRules = selectedState?.rules ?? []
const productRulesByType = new Map<HouseRuleType, HouseRule>()
for (const rule of previewRules) {
	productRulesByType.set(String(rule.type ?? "Other") as HouseRuleType, rule)
}
const previewRulesByGroup = houseRuleGroups.map((group) => ({
	...group,
	rules: previewRules.filter((rule) =>
		group.types.includes(String(rule.type ?? "Other") as HouseRuleType)
	),
}))
const missingCount = selectedState?.missingEssentials.length ?? essentialHouseRuleTypes.length
const selectedReady = Boolean(selectedState?.ready)
const essentialReadyCount = essentialHouseRuleTypes.length - missingCount
const selectedRulesByType = new Map<HouseRuleType, HouseRule[]>()
for (const rule of previewRules) {
	const type = String(rule.type ?? "Other") as HouseRuleType
	const rules = selectedRulesByType.get(type) ?? []
	rules.push(rule)
	selectedRulesByType.set(type, rules)
}
const flow = Astro.url.searchParams.get("flow") === "create" ? "create" : "edit"
if (Astro.request.method === "GET" && requestedRatePlanId && !rateArrivalContext) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.delete("ratePlanId")
	const query = params.toString()
	return Astro.redirect(`${routes.providerHouseRules()}${query ? `?${query}` : ""}`)
}
if (Astro.request.method === "GET" && requestedVariantId && !spaceContext && !isRateContext) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.delete("variantId")
	const query = params.toString()
	return Astro.redirect(`${routes.providerHouseRules()}${query ? `?${query}` : ""}`)
}
if (Astro.request.method === "GET" && !requestedProductId && products.length === 1) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("productId", products[0].id)
	return Astro.redirect(`${routes.providerHouseRules()}?${params.toString()}`)
}
if (!playbook.active && flow === "create" && selectedProductId) {
	return Astro.redirect(
		buildPlaybookHref(
			`${routes.providerHouseRules()}?productId=${encodeURIComponent(selectedProductId)}`,
			"house-rules"
		)
	)
}
const showProductIndex = products.length > 1 && !hasProductContext && !playbook.active

const ruleTypesByView: Record<HouseRuleView, HouseRuleType[]> = {
	essential: essentialHouseRuleTypes,
	arrival: ["CheckIn", "Checkout", "Access", "Parking"],
	optional: ["Children", "Safety", "ExtraBeds", "Other"],
	preview: [],
}
const optionalReadyCount = ruleTypesByView.optional.filter(
	(type) => (selectedRulesByType.get(type) ?? []).length > 0
).length
function houseRulesViewHref(view: HouseRuleView) {
	const params = new URLSearchParams()
	if (selectedProductId) params.set("productId", selectedProductId)
	params.set("vista", view)
	if (rateArrivalContext) {
		params.set("ratePlanId", rateArrivalContext.ratePlanId)
		params.set("focus", "arrival")
	} else if (spaceContext) {
		params.set("variantId", spaceContext.id)
	}
	if (safeReturnTo) params.set("returnTo", safeReturnTo)
	if (isLaunchWizard) {
		params.set("playbook", "launch")
		params.set("step", "house-rules")
		params.set("flow", "create")
	} else if (isCompleteWizard) {
		params.set("playbook", "complete-to-publish")
		params.set("step", "houseRules")
		params.set("flow", "complete")
	}
	return `${routes.providerHouseRules()}?${params.toString()}`
}

function productHouseRulesHref(productId: string) {
	const params = new URLSearchParams({ productId })
	return `${routes.providerHouseRules()}?${params.toString()}`
}

const missingEssentials = selectedState?.missingEssentials ?? [...essentialHouseRuleTypes]
const houseRulesProgressPercent = Math.max(
	0,
	Math.min(100, (essentialReadyCount / essentialHouseRuleTypes.length) * 100)
)
const houseRulesEyebrow = isRateContext
	? "Horario de esta tarifa"
	: isSpaceContext
		? "Este espacio"
		: "Reglas del alojamiento"
const houseRulesTitle = isRateContext
	? rateArrivalContext?.ratePlanName
	: isSpaceContext
		? spaceContext?.name
		: "Reglas esenciales"
const houseRulesLead = isRateContext
	? rateArrivalContext?.hasException
		? `Esta tarifa tiene un horario distinto. El resto de reglas sigue viniendo de ${selectedProduct?.name ?? "el alojamiento"}.`
		: `El horario se hereda de ${selectedProduct?.name ?? "el alojamiento"}. Puedes definir una excepción solo para llegada y salida.`
	: isSpaceContext
		? spaceOverrideCount > 0
			? `Hereda las reglas de ${selectedProduct?.name ?? "el alojamiento"}. ${spaceOverrideCount} excepción${spaceOverrideCount === 1 ? "" : "es"} activa${spaceOverrideCount === 1 ? "" : "s"} en este espacio.`
			: `Hereda las reglas de ${selectedProduct?.name ?? "el alojamiento"}. Puedes definir excepciones puntuales abajo.`
		: selectedReady
			? "Las expectativas principales ya están listas para mostrarse al huésped."
			: "El huésped las ve antes de reservar. Sin ellas la ficha queda a medias."
const hotelRulesHref = (() => {
	const params = new URLSearchParams()
	if (selectedProductId) params.set("productId", selectedProductId)
	params.set("vista", isRateContext ? "arrival" : activeView)
	if (safeReturnTo) params.set("returnTo", safeReturnTo)
	return `${routes.providerHouseRules()}?${params.toString()}`
})()
const commercialConditionsHref = rateArrivalContext
	? routes.ratePlanPolicies(rateArrivalContext.ratePlanId)
	: selectedProductId
		? `${routes.rates()}?productId=${encodeURIComponent(selectedProductId)}`
		: routes.rates()

function spaceVariantActionHref() {
	const params = new URLSearchParams()
	if (selectedProductId) params.set("productId", selectedProductId)
	if (spaceContext) params.set("variantId", spaceContext.id)
	if (safeReturnTo) params.set("returnTo", safeReturnTo)
	return `${routes.providerHouseRules()}?${params.toString()}`
}

function rateArrivalActionHref() {
	const params = new URLSearchParams()
	if (selectedProductId) params.set("productId", selectedProductId)
	if (rateArrivalContext) {
		params.set("ratePlanId", rateArrivalContext.ratePlanId)
		params.set("focus", "arrival")
	}
	if (safeReturnTo) params.set("returnTo", safeReturnTo)
	return `${routes.providerHouseRules()}?${params.toString()}`
}

function essentialRuleHref(type: HouseRuleType) {
	const view: HouseRuleView =
		(type === "CheckIn" || type === "Checkout") && activeView === "arrival"
			? "arrival"
			: "essential"
	return `${houseRulesViewHref(view)}#house-rule-${view}-${type}`
}

const ruleTabs = [
	{
		id: "essential",
		label: "Esenciales",
		meta: `${essentialReadyCount}/${essentialHouseRuleTypes.length}`,
	},
	{
		id: "arrival",
		label: "Llegada y salida",
		meta: `${["CheckIn", "Checkout"].filter((type) => selectedRulesByType.has(type as HouseRuleType)).length}/2`,
	},
	{ id: "optional", label: "Opcionales", meta: optionalReadyCount },
	...(isGuidedRules
		? []
		: [{ id: "preview" as const, label: "Vista huésped", meta: previewRules.length }]),
] satisfies Array<{ id: HouseRuleView; label: string; meta: string | number }>
const previewPlaybookHref = selectedProductId
	? buildPlaybookHref(routes.productPreview(selectedProductId), "preview")
	: null
const guidedContinueLabel = isLaunchWizard ? "Continuar a vista previa →" : "Continuar →"
const guidedContinueDisabledTitle = isLaunchWizard
	? "Completa las reglas esenciales para pasar a la vista previa."
	: "Completa las reglas esenciales para continuar la preparación."
const successMessage =
	success === "created"
		? missingCount > 0
			? `Cambio guardado. Quedan ${missingCount} regla${missingCount === 1 ? "" : "s"} esencial${missingCount === 1 ? "" : "es"} por definir.`
			: "Cambio guardado. Las reglas esenciales están completas."
		: success === "preset-applied"
			? missingCount > 0
				? `Base aplicada. Quedan ${missingCount} regla${missingCount === 1 ? "" : "s"} por completar en otras categorías.`
				: "Base aplicada. Las reglas esenciales están listas para revisar."
			: success === "deleted"
				? "Regla eliminada. Puedes definir una nueva versión cuando lo necesites."
				: success === "override-saved"
					? "Excepción guardada. El huésped verá este espacio con la regla personalizada."
					: success === "override-removed"
						? "Excepción eliminada. Este espacio vuelve a heredar del alojamiento."
						: success === "rate-arrival-saved"
							? "Horario de la tarifa guardado. Solo afecta llegada y salida de esta tarifa."
							: success === "rate-arrival-removed"
								? "Excepción de horario eliminada. Esta tarifa vuelve a heredar del alojamiento."
								: null
---

<PlaybookLayout
	title="Reglas para huéspedes"
	active={playbook.active}
	playbookId={playbook.playbookId}
	stepId={isCompleteWizard ? "houseRules" : (playbook.stepId ?? "house-rules")}
	productId={selectedProductId}
	isHotel={true}
	continueHref={isLaunchWizard ? previewPlaybookHref : null}
	continueLabel={guidedContinueLabel}
	continueDisabled={isGuidedRules && !selectedReady}
	continueDisabledTitle={guidedContinueDisabledTitle}
>
	<section class="space-y-6 md:space-y-8" data-house-rules-workspace>
		<header class="flex flex-col gap-2">
			<h1 class="sr-only">Reglas para huéspedes</h1>
			{
				isLaunchWizard ||
				isCompleteWizard ||
				showProductIndex ||
				isRateContext ||
				isSpaceContext ? (
					<p class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6">
						{isLaunchWizard
							? "Configura las reglas básicas que el huésped debe aceptar antes de reservar. Podrás revisar cómo se ven en el siguiente paso."
							: isCompleteWizard
								? "Completa las reglas pendientes para poder publicar este alojamiento."
								: showProductIndex
									? "Configura expectativas de estadía por alojamiento. Las habitaciones describen espacios; las tarifas definen condiciones comerciales."
									: isRateContext
										? "Horario de esta tarifa. Cancelación, pago y no presentación siguen en Condiciones."
										: "Este espacio hereda las reglas del alojamiento. Cancelación, pago y no presentación siguen en cada tarifa, en Condiciones."}
					</p>
				) : null
			}
		</header>

		{
			actionError && (
				<Card className="border-red-200 bg-red-50 text-red-900">
					<p class="text-sm font-semibold">No se pudo actualizar la regla</p>
					<p class="mt-1 text-sm">{actionError}</p>
				</Card>
			)
		}

		{
			!products.length ? (
				<Card className="bg-white text-slate-800">
					<p class="text-sm text-slate-600">Crea un alojamiento antes de agregar reglas.</p>
					<div class="mt-3">
						<Button
							href="/product/create?playbook=launch&step=create&flow=create"
							variant="primary"
						>
							Crear alojamiento
						</Button>
					</div>
				</Card>
			) : showProductIndex ? (
				<section class="space-y-4">
					<Card className="bg-white text-slate-900">
						<div class="flex flex-wrap items-start justify-between gap-4">
							<div class="space-y-1">
								<p class="text-lg font-semibold text-slate-950">Elige un alojamiento</p>
								<p class="max-w-3xl text-sm leading-6 text-slate-600">
									Cada propiedad puede tener horarios, acceso, normas y operación distintos. Edita
									las reglas desde el alojamiento correcto para evitar contradicciones con tarifas y
									preview.
								</p>
							</div>
							<Badge variant="neutral">{products.length} alojamientos</Badge>
						</div>
					</Card>

					<div class="grid gap-3 lg:grid-cols-2">
						{stateByProduct.map((item) => {
							const readyCount = essentialHouseRuleTypes.length - item.missingEssentials.length
							const completion = (readyCount / essentialHouseRuleTypes.length) * 100
							return (
								<Card className="bg-white text-slate-900">
									<div class="flex h-full flex-col gap-4">
										<div class="flex flex-wrap items-start justify-between gap-3">
											<div class="space-y-1">
												<p class="text-base font-semibold text-slate-950">{item.product.name}</p>
												<p class="text-sm text-slate-600">
													{readyCount} de {essentialHouseRuleTypes.length} reglas esenciales listas
												</p>
											</div>
											<Badge variant={item.ready ? "success" : "warning"}>
												{item.ready ? "Listo" : `Faltan ${item.missingEssentials.length}`}
											</Badge>
										</div>

										<div class="h-1.5 overflow-hidden rounded-full bg-slate-100">
											<div
												class="h-full rounded-full"
												style={`width: ${completion}%; background-color: var(--fastt-color-selection);`}
											/>
										</div>

										{item.missingEssentials.length ? (
											<div class="flex flex-wrap gap-2">
												{item.missingEssentials.map((type) => (
													<Badge variant="neutral">{houseRuleCopy[type].label}</Badge>
												))}
											</div>
										) : (
											<p class="text-sm leading-6 text-slate-600">
												Las expectativas principales ya están listas para mostrarse al huésped.
											</p>
										)}

										<div class="mt-auto flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-4">
											<Button
												href={routes.productPreview(item.product.id)}
												variant="secondary"
												size="sm"
											>
												Vista previa
											</Button>
											<Button
												href={productHouseRulesHref(item.product.id)}
												variant="primary"
												size="sm"
											>
												Editar reglas
											</Button>
										</div>
									</div>
								</Card>
							)
						})}
					</div>
				</section>
			) : (
				<div class="space-y-6">
					{isGuidedRules ? null : (
						<section
							class="space-y-4"
							data-house-rules-coach
							data-house-rules-scope={isRateContext ? "rate" : isSpaceContext ? "space" : "hotel"}
						>
							<Card variant="dark" class="!border-neutral-800 !bg-black">
								<div class="space-y-5">
									<div class="flex items-start justify-between gap-4">
										<div class="flex min-w-0 items-start gap-3">
											<span class="fastt-section-icon">
												{selectedReady || isRateContext || isSpaceContext ? (
													<CircleCheck class="size-4" aria-hidden="true" />
												) : (
													<ClipboardList class="size-4" aria-hidden="true" />
												)}
											</span>
											<div class="min-w-0">
												<p class="text-xs font-semibold tracking-[0.14em] text-neutral-500 uppercase">
													{houseRulesEyebrow}
												</p>
												<h2 class="mt-1 truncate text-xl font-semibold text-white">
													{houseRulesTitle}
												</h2>
												<p class="mt-1 max-w-xl text-sm leading-6 text-neutral-400">
													{houseRulesLead}
												</p>
											</div>
										</div>
										<Badge
											variant={
												isRateContext
													? rateArrivalContext?.hasException
														? "darkSuccess"
														: "darkNeutral"
													: isSpaceContext
														? spaceOverrideCount > 0
															? "darkSuccess"
															: "darkNeutral"
														: selectedReady
															? "darkSuccess"
															: "darkWarning"
											}
										>
											{isRateContext
												? rateArrivalContext?.hasException
													? "Excepción de horario"
													: "Hereda horario"
												: isSpaceContext
													? spaceOverrideCount > 0
														? `${spaceOverrideCount} excepción${spaceOverrideCount === 1 ? "" : "es"}`
														: "Hereda"
													: selectedReady
														? "Listas"
														: "Pendiente"}
										</Badge>
									</div>

									{isRateContext ? (
										<p class="text-sm leading-6 text-neutral-500">
											Cancelación, pago y no presentación se editan en{" "}
											<a
												href={commercialConditionsHref}
												class="font-medium text-neutral-300 underline-offset-2 hover:text-white hover:underline"
											>
												Condiciones de la tarifa
											</a>
											. Aquí solo llegada y salida.
										</p>
									) : !isSpaceContext ? (
										<div class="flex items-center gap-3">
											<div class="h-1 flex-1 overflow-hidden rounded-full bg-white/10">
												<div
													class="h-full rounded-full"
													style={`width: ${houseRulesProgressPercent}%; background-color: var(--fastt-color-selection);`}
												/>
											</div>
											<p class="shrink-0 text-xs font-medium text-neutral-400 tabular-nums">
												{essentialReadyCount} de {essentialHouseRuleTypes.length}
											</p>
										</div>
									) : (
										<p class="text-sm leading-6 text-neutral-500">
											Horarios, silencio y llegada se editan en{" "}
											<a
												href={hotelRulesHref}
												class="font-medium text-neutral-300 underline-offset-2 hover:text-white hover:underline"
											>
												Reglas del alojamiento
											</a>
											. Aquí solo excepciones puntuales de este espacio.
										</p>
									)}

									{!isSpaceContext && !isRateContext && missingEssentials.length ? (
										<div class="flex flex-wrap gap-2">
											{missingEssentials.map((type) => (
												<a href={essentialRuleHref(type)}>
													<Badge
														variant="darkNeutral"
														class="transition hover:border-white/30 hover:bg-white/15 hover:text-white"
													>
														{houseRuleCopy[type].label}
													</Badge>
												</a>
											))}
										</div>
									) : null}

									{focus === "arrival" && !isSpaceContext && !isRateContext ? (
										<p class="text-sm leading-6 text-neutral-500">
											Estos horarios se heredan en las condiciones de tarifa.
										</p>
									) : null}
									{!isSpaceContext && !isRateContext ? (
										<p
											class="text-sm leading-6 text-neutral-500"
											data-house-rules-commercial-boundary
										>
											Define comportamiento, llegada y salida del alojamiento. Cancelación, pago y
											no presentación no se editan aquí. Van en cada tarifa, en{" "}
											<a
												href={commercialConditionsHref}
												class="font-medium text-neutral-300 underline-offset-2 hover:text-white hover:underline"
											>
												Condiciones
											</a>
											.
										</p>
									) : null}
									{isSpaceContext || isRateContext ? (
										<div class="flex flex-wrap gap-2">
											<Button href={hotelRulesHref} variant="onDark" size="sm">
												Reglas del alojamiento
											</Button>
											{isRateContext ? (
												<Button href={commercialConditionsHref} variant="onDark" size="sm">
													Condiciones de la tarifa
												</Button>
											) : null}
										</div>
									) : null}
								</div>
							</Card>
						</section>
					)}

					<div
						class={isGuidedRules ? "space-y-3" : "grid gap-5 xl:grid-cols-[minmax(0,1fr)_360px]"}
					>
						<section class={isGuidedRules ? "flex flex-col gap-3" : "space-y-3"}>
							{isRateContext && rateArrivalContext ? (
								<Card className="bg-white text-slate-900" data-house-rules-rate-editor>
									<div class="space-y-1 border-b border-slate-100 px-5 py-4">
										<p class="text-base font-semibold text-slate-950">
											Horario de {rateArrivalContext.ratePlanName}
										</p>
										<p class="max-w-2xl text-sm leading-6 text-slate-600">
											Solo llegada y salida. Se guarda como PolicyAssignment de esta tarifa; no crea
											house rules nuevas ni toca mascotas, fumar o silencio.
										</p>
									</div>
									<div class="bg-slate-50/90 p-4 sm:p-5">
										<RatePlanArrivalExceptionPanel
											actionHref={rateArrivalActionHref()}
											productId={selectedProductId}
											ratePlanId={rateArrivalContext.ratePlanId}
											ratePlanName={rateArrivalContext.ratePlanName}
											hotelSchedule={rateArrivalContext.hotelSchedule}
											rateSchedule={rateArrivalContext.rateSchedule}
											hotelRulesHref={hotelRulesHref}
											conditionsHref={commercialConditionsHref}
										/>
									</div>
								</Card>
							) : isSpaceContext && spaceContext ? (
								<Card className="bg-white text-slate-900" data-house-rules-variant-editor>
									<div class="space-y-1 border-b border-slate-100 px-5 py-4">
										<p class="text-base font-semibold text-slate-950">
											Excepciones de {spaceContext.name}
										</p>
										<p class="max-w-2xl text-sm leading-6 text-slate-600">
											Cada fila muestra lo heredado del alojamiento y, si hace falta, una excepción
											solo para este espacio. Cancelación, pago y no presentación siguen en
											Condiciones de cada tarifa.
										</p>
									</div>
									<div class="space-y-3 bg-slate-50/90 p-4 sm:p-5">
										{spaceVariantEditorTypes.map((type) => (
											<HouseRuleVariantOverrideRow
												type={type}
												inheritedRule={productRulesByType.get(type) ?? null}
												overrideRule={spaceOverrideByType.get(type) ?? null}
												actionHref={spaceVariantActionHref()}
												productId={selectedProductId}
												variantId={spaceContext.id}
											/>
										))}
									</div>
								</Card>
							) : (
								<>
									<div class={isGuidedRules ? "order-1" : ""}>
										<Card className="bg-white text-slate-900">
											<div class="space-y-1">
												<p class="text-base font-semibold text-slate-950">
													{isGuidedRules ? "Elige una base para empezar" : "Plantillas rápidas"}
												</p>
												{isGuidedRules ? (
													<p class="max-w-2xl text-sm leading-6 text-slate-600">
														Puedes ajustar cualquier regla después. Esto carga una base clara para
														avanzar hacia la publicación.
													</p>
												) : (
													<p class="text-sm leading-6 text-slate-600">
														Aplica una base común y ajusta solo lo que cambia para este alojamiento.
													</p>
												)}
											</div>
											<div class="mt-4 grid gap-3 md:grid-cols-2">
												{houseRuleQuickSetups.map((preset, index) => (
													<form
														action={houseRulesViewHref(activeView)}
														method="POST"
														class={`bg-slate-50 ring-1 ring-slate-900/[0.06] transition hover:bg-white hover:shadow-[var(--fastt-shadow-row)] ${
															isGuidedRules
																? index === 0
																	? "rounded-xl p-3 ring-[var(--fastt-color-selection)]"
																	: "rounded-xl p-3"
																: "rounded-2xl p-4"
														}`}
													>
														<input type="hidden" name="action" value="apply-quick-setup" />
														<input type="hidden" name="presetKey" value={preset.key} />
														<input type="hidden" name="productId" value={selectedProductId} />
														<input
															type="hidden"
															name="vista"
															value={activeView}
															data-house-rules-vista
														/>
														<div class="flex flex-wrap items-center gap-2">
															<p class="text-sm font-semibold text-slate-950">{preset.title}</p>
															{isGuidedRules && index === 0 ? (
																<Badge variant="neutral">Recomendado</Badge>
															) : null}
														</div>
														<p
															class={`mt-1 text-sm leading-5 text-slate-600 ${isGuidedRules ? "" : "min-h-10"}`}
														>
															{preset.description}
														</p>
														<div class="mt-4 flex justify-end">
															<Button type="submit" variant="secondary" size="sm">
																{isGuidedRules ? "Usar esta base" : "Aplicar base"}
															</Button>
														</div>
													</form>
												))}
											</div>
										</Card>
									</div>

									<div class={isGuidedRules ? "order-3" : ""}>
										<Card
											variant="flush"
											className="overflow-hidden bg-white text-slate-900"
											data-house-rules-tabs
										>
											<div class="flex flex-wrap items-center justify-between gap-3 border-b border-sky-100 bg-white px-4 pt-4">
												<TabsOutsidePanel class="mb-3" aria-label="Secciones de reglas">
													{ruleTabs.map((tab) => (
														<a
															href={houseRulesViewHref(tab.id)}
															data-house-rules-tab={tab.id}
															aria-current={activeView === tab.id ? "page" : undefined}
															data-active={activeView === tab.id ? "true" : "false"}
															class={`fastt-tabs-outside-panel__item px-3 py-2 text-sm font-semibold whitespace-nowrap ${
																activeView === tab.id
																	? ""
																	: "text-slate-600 hover:bg-sky-100/80 hover:text-sky-950"
															}`}
														>
															{tab.label} <span class="ml-1 text-xs opacity-70">{tab.meta}</span>
														</a>
													))}
												</TabsOutsidePanel>
												{isGuidedRules ? (
													<div class="mb-3">
														<Badge variant={selectedReady ? "success" : "warning"}>
															{`${essentialReadyCount} de ${essentialHouseRuleTypes.length} listas`}
														</Badge>
													</div>
												) : null}
											</div>
											<div>
												{isGuidedRules ? null : (
													<div data-house-rules-panel="preview" hidden={activeView !== "preview"}>
														<div class="p-4 sm:p-5">
															<div class="rounded-2xl bg-slate-50 p-5">
																<p class="text-base font-semibold text-slate-950">Vista huésped</p>
																<p class="mt-1 text-sm leading-6 text-slate-600">
																	Revisa en el panel lateral el resumen agrupado tal como acompañará
																	la ficha pública.
																</p>
															</div>
														</div>
													</div>
												)}

												{houseRuleEditorViews.map((view) => {
													const types = ruleTypesByView[view]
													const pendingTypes = types.filter(
														(type) => (selectedRulesByType.get(type) ?? []).length === 0
													)
													const completeTypes = types.filter(
														(type) => (selectedRulesByType.get(type) ?? []).length > 0
													)
													return (
														<div data-house-rules-panel={view} hidden={activeView !== view}>
															<header class="border-b border-sky-100 bg-sky-50/80 px-5 py-4">
																<div class="flex flex-wrap items-center justify-between gap-3">
																	<h2 class="text-lg font-semibold text-slate-950">Pendientes</h2>
																	<Badge variant={pendingTypes.length ? "info" : "success"}>
																		{pendingTypes.length ? pendingTypes.length : "Listo"}
																	</Badge>
																</div>
																<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
																	Una regla a la vez. El huésped las verá antes de reservar.
																</p>
															</header>
															<div class="space-y-3 bg-slate-50/90 p-4 sm:p-5">
																{pendingTypes.map((type) => (
																	<HouseRuleEditorRow
																		type={type}
																		rules={selectedRulesByType.get(type) ?? []}
																		isEssential={essentialHouseRuleTypes.includes(type)}
																		isGuidedRules={isGuidedRules}
																		isComplete={false}
																		actionHref={houseRulesViewHref(view)}
																		vista={view}
																		hasProductContext={hasProductContext}
																		selectedProductId={selectedProductId}
																		visibleProducts={visibleProducts}
																	/>
																))}
																{completeTypes.length ? (
																	<details
																		class="fastt-soft-box group border border-slate-200 bg-white"
																		open={!pendingTypes.length}
																		data-house-rules-complete-areas
																	>
																		<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 [&::-webkit-details-marker]:hidden">
																			<span class="inline-flex items-center gap-2">
																				<CircleCheck
																					class="size-4 text-emerald-600"
																					aria-hidden="true"
																				/>
																				Áreas completadas ({completeTypes.length})
																			</span>
																			<span class="text-xs font-medium text-slate-500 group-open:hidden">
																				Mostrar
																			</span>
																			<span class="hidden text-xs font-medium text-slate-500 group-open:inline">
																				Ocultar
																			</span>
																		</summary>
																		<div class="space-y-3 border-t border-slate-100 p-3">
																			{completeTypes.map((type) => (
																				<HouseRuleEditorRow
																					type={type}
																					rules={selectedRulesByType.get(type) ?? []}
																					isEssential={essentialHouseRuleTypes.includes(type)}
																					isGuidedRules={isGuidedRules}
																					isComplete={true}
																					actionHref={houseRulesViewHref(view)}
																					vista={view}
																					hasProductContext={hasProductContext}
																					selectedProductId={selectedProductId}
																					visibleProducts={visibleProducts}
																				/>
																			))}
																		</div>
																	</details>
																) : null}
															</div>
														</div>
													)
												})}
											</div>
										</Card>
									</div>
								</>
							)}
						</section>

						<aside class={isGuidedRules ? "hidden" : "hidden space-y-4 xl:order-none xl:block"}>
							<Card className="bg-white text-slate-900 xl:sticky xl:top-6">
								<div class="flex flex-wrap items-start justify-between gap-3">
									<div>
										<p class="text-base font-semibold text-slate-950">Así lo verá el huésped</p>
										<p class="mt-1 text-sm text-slate-600">
											{isSpaceContext
												? `Resumen efectivo para ${spaceContext?.name ?? "este espacio"}.`
												: `Resumen visible antes de reservar en ${selectedProduct?.name ?? "el alojamiento"}.`}
										</p>
									</div>
									<Badge
										variant={
											isSpaceContext
												? spaceOverrideCount
													? "info"
													: "neutral"
												: selectedReady
													? "success"
													: "warning"
										}
									>
										{isSpaceContext
											? spaceOverrideCount
												? `${spaceOverrideCount} excepción${spaceOverrideCount === 1 ? "" : "es"}`
												: "Hereda todo"
											: selectedReady
												? "Listo"
												: `Faltan ${missingCount}`}
									</Badge>
								</div>

								{selectedProduct ? (
									<div class="mt-4">
										<Button
											href={
												isSpaceContext && spaceContext
													? routes.productRoomDetail(selectedProduct.id, spaceContext.id)
													: routes.productPreview(selectedProduct.id)
											}
											variant="secondary"
											size="sm"
										>
											{isSpaceContext ? "Ver ficha del espacio" : "Ver ficha completa"}
										</Button>
									</div>
								) : null}

								{isSpaceContext ? (
									spaceEffectiveRules.filter((rule) =>
										spaceVariantEditorTypes.includes(String(rule.type) as HouseRuleType)
									).length ? (
										<div class="mt-5 space-y-2">
											{spaceEffectiveRules
												.filter((rule) =>
													spaceVariantEditorTypes.includes(String(rule.type) as HouseRuleType)
												)
												.map((rule) => {
													const type = String(rule.type ?? "Other") as HouseRuleType
													const summary = buildHouseRuleGuestSummary(type, rule.payloadJson)
													return (
														<div class="rounded-2xl bg-slate-50 px-3 py-2.5 text-sm leading-6 text-slate-700">
															<div class="flex flex-wrap items-center gap-2">
																<span class="font-medium text-slate-900">
																	{houseRuleCopy[type]?.label ?? "Regla"}:
																</span>
																<Badge variant={rule.source === "override" ? "info" : "neutral"}>
																	{rule.source === "override" ? "Excepción" : "Heredada"}
																</Badge>
															</div>
															<p class="mt-1">{summary}</p>
														</div>
													)
												})}
										</div>
									) : (
										<div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4">
											<p class="text-sm font-semibold text-slate-900">
												Sin excepciones en este espacio.
											</p>
											<p class="mt-1 text-sm text-slate-600">
												El huésped verá las reglas del alojamiento para estas categorías.
											</p>
										</div>
									)
								) : previewRules.length ? (
									<div class="mt-5 space-y-4">
										{previewRulesByGroup.map((group) => {
											if (!group.rules.length) return null
											return (
												<div>
													<p class="text-sm font-semibold text-slate-950">{group.label}</p>
													<ul class="mt-2 space-y-2 text-sm leading-6 text-slate-700">
														{group.rules.map((rule) => {
															const type = String(rule.type ?? "Other") as HouseRuleType
															const summary = buildHouseRuleGuestSummary(type, rule.payloadJson)
															return (
																<li class="rounded-2xl bg-slate-50 px-3 py-2.5">
																	<span class="font-medium text-slate-900">
																		{houseRuleCopy[type]?.label ?? "Otra regla"}:
																	</span>{" "}
																	{summary}
																</li>
															)
														})}
													</ul>
												</div>
											)
										})}
									</div>
								) : (
									<div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4">
										<p class="text-sm font-semibold text-slate-900">Aún no hay reglas visibles.</p>
										<p class="mt-1 text-sm text-slate-600">
											Agrega las reglas principales para que la ficha sea clara.
										</p>
									</div>
								)}
							</Card>
						</aside>
					</div>
				</div>
			)
		}
	</section>

	{
		successMessage ? (
			<BottomToast message={successMessage} variant="success" clearQueryParam="success" />
		) : null
	}
</PlaybookLayout>

<style>
	[data-house-rules-panel][hidden] {
		display: none !important;
	}
</style>

<script>
	import { navigate } from "astro:transitions/client"
	import { installHouseRulesTabsController } from "./_client/house-rules-tabs"

	installHouseRulesTabsController()

	if (!document.documentElement.dataset.houseRulesMutationsBound) {
		document.documentElement.dataset.houseRulesMutationsBound = "true"
		document.addEventListener("submit", async (event) => {
			const form = event.target
			if (!(form instanceof HTMLFormElement)) return
			if (!form.closest("[data-house-rules-workspace]") || form.method.toLowerCase() !== "post")
				return
			event.preventDefault()
			const submitter = event.submitter instanceof HTMLButtonElement ? event.submitter : null
			const previousLabel = submitter?.textContent ?? ""
			if (submitter) {
				submitter.disabled = true
				submitter.textContent = "Guardando…"
			}
			try {
				const response = await fetch(form.action || window.location.href, {
					method: "POST",
					body: new FormData(form),
					headers: { Accept: "text/html" },
				})
				if (!response.ok) throw new Error(`house_rules_${response.status}`)
				await navigate(response.url || window.location.href, { history: "replace" })
			} catch {
				if (submitter) {
					submitter.disabled = false
					submitter.textContent = previousLabel
				}
				window.alert("No se pudo guardar el cambio. Inténtalo nuevamente.")
			}
		})
	}
</script>
