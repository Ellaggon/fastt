---
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import ProviderInformationRequestInbox from "@/components/provider/ProviderInformationRequestInbox.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { listProviderInformationRequests } from "@/modules/casework/public"
import { getFeatureFlag, isCommandCenterV2PilotProvider } from "@/config/featureFlags"
const session = await requireProviderSessionSurface(Astro.request).catch((error) => {
	if (error instanceof Response && error.status === 401) return null
	throw error
})
if (!session) return Astro.redirect("/SignInPage")
const requests = await listProviderInformationRequests(session.provider.providerId, session.user.id)
const enabled =
	getFeatureFlag("COMMAND_CENTER_V2_COMMANDS_ENABLED", { request: Astro.request }) &&
	isCommandCenterV2PilotProvider(session.provider.providerId)
Astro.response.headers.set("Cache-Control", "private, no-store")
const permissions = session.provider.permissions
const canReadRequests = Boolean(
	permissions &&
	(permissions.canEditProfile ||
		permissions.canManageDocuments ||
		permissions.canManageFiscality ||
		permissions.canManagePayments)
)
---

<ProviderSettingsLayout
	title="Solicitudes del equipo"
	heading="Solicitudes del equipo"
	description="Responde a las aclaraciones que Fastt necesita para revisar tu cuenta."
	showSettingsTabs={false}
>
	<div class="max-w-3xl">
		<ProviderInformationRequestInbox
			requests={requests}
			enabled={enabled}
			canReadRequests={canReadRequests}
			actorId={session.user.id}
		/>
	</div>
</ProviderSettingsLayout>
<script>
	import {
		canDiscardCaseCommand,
		prepareCaseCommand,
		type PendingCaseCommand,
	} from "@/modules/casework/command-recovery"
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-information-response]")) {
		const decisionId = String(new FormData(form).get("decisionId") ?? "")
		const storageKey = `casework:provider-response:${form.dataset.actorId}:${decisionId}`
		let pending: PendingCaseCommand | null = null
		try {
			const stored = JSON.parse(sessionStorage.getItem(storageKey) || "null")
			if (stored && typeof stored.key === "string" && typeof stored.body === "string") {
				const values = JSON.parse(stored.body) as Record<string, string>
				if (
					values.decisionId === decisionId &&
					values.requestKey === stored.key &&
					typeof values.message === "string"
				) {
					pending = stored
					form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!.value =
						values.message
					form.querySelector<HTMLInputElement>('input[name="requestKey"]')!.value = stored.key
				}
			}
		} catch {
			/* In-memory retry remains available. */
		}
		let busy = false
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			if (busy) return
			busy = true
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
			const status = form.querySelector<HTMLElement>("[data-response-status]")!
			button.disabled = true
			form.setAttribute("aria-busy", "true")
			status.textContent = "Enviando respuesta…"
			const values = Object.fromEntries(new FormData(form))
			pending = prepareCaseCommand(pending, JSON.stringify(values), () => String(values.requestKey))
			try {
				sessionStorage.setItem(storageKey, JSON.stringify(pending))
			} catch {
				/* In-memory recovery. */
			}
			const payload = new FormData()
			for (const [name, value] of Object.entries(
				JSON.parse(pending.body) as Record<string, string>
			))
				payload.set(name, value)
			try {
				const response = await fetch(form.action, { method: "POST", body: payload })
				if (
					response.redirected &&
					new URL(response.url).pathname === "/provider/compliance/requests" &&
					new URL(response.url).searchParams.get("result") === "received"
				) {
					try {
						sessionStorage.removeItem(storageKey)
					} catch {}
					window.location.assign(response.url)
					return
				}
				const body = await response.json().catch(() => ({}))
				if (canDiscardCaseCommand(response.status, body.error)) {
					pending = null
					try {
						sessionStorage.removeItem(storageKey)
					} catch {}
				}
				status.textContent =
					response.status === 401
						? "Tu sesión venció. Conserva el texto e inicia sesión antes de volver a intentar."
						: response.status === 422
							? "Revisa tu respuesta: debe tener entre 12 y 4000 caracteres."
							: response.status === 403
								? "El envío no está habilitado para tu acceso. Contacta al titular o a Soporte."
								: "No se confirmó la recepción. Tu texto sigue aquí. El reintento consultará la misma referencia con el mensaje original."
			} catch {
				status.textContent =
					"Respuesta sin confirmar. Vuelve a intentar: se consultará la misma referencia con el mensaje original."
			} finally {
				busy = false
				button.disabled = false
				form.removeAttribute("aria-busy")
			}
		})
	}
</script>
