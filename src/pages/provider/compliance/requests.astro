---
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import Textarea from "@/components/ui/Textarea.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import {
	listProviderInformationRequests,
	PROVIDER_WORK_VOCABULARY,
} from "@/modules/casework/public"
import { getFeatureFlag, isCommandCenterV2PilotProvider } from "@/config/featureFlags"
const session = await requireProviderSessionSurface(Astro.request).catch((error) => {
	if (error instanceof Response && error.status === 401) return null
	throw error
})
if (!session) return Astro.redirect("/SignInPage")
const requests = await listProviderInformationRequests(session.provider.providerId, session.user.id)
const enabled =
	getFeatureFlag("COMMAND_CENTER_V2_COMMANDS_ENABLED", { request: Astro.request }) &&
	isCommandCenterV2PilotProvider(session.provider.providerId)
Astro.response.headers.set("Cache-Control", "private, no-store")
const fmt = new Intl.DateTimeFormat("es-BO", {
	dateStyle: "medium",
	timeStyle: "short",
	timeZone: "America/La_Paz",
})
---

<ProviderSettingsLayout
	title="Solicitudes de revisión"
	heading="Solicitudes de revisión"
	description="Consulta qué información necesita el equipo y responde en este canal seguro."
	showSettingsTabs={false}
>
	<div class="mx-auto max-w-3xl space-y-5">
		{
			Astro.url.searchParams.get("result") === "received" && (
				<Notice variant="success">
					Respuesta recibida. El equipo debe revisarla; todavía no implica aprobación.
				</Notice>
			)
		}
		{
			!requests.length && (
				<Notice variant="neutral">No hay solicitudes publicadas para tus permisos actuales.</Notice>
			)
		}
		{
			requests.map((item) => (
				<Card class="p-5 text-slate-950">
					<h2 class="text-lg font-semibold">
						{
							PROVIDER_WORK_VOCABULARY.domains[
								item.domain as keyof typeof PROVIDER_WORK_VOCABULARY.domains
							]
						}{" "}
						· {item.caseNumber}
					</h2>
					<p class="mt-2 text-sm text-slate-600">Publicada {fmt.format(item.publishedAt)}</p>
					<p class="mt-4 whitespace-pre-wrap">{item.message}</p>
					{item.response ? (
						<div class="mt-4 border-t border-slate-200 pt-4">
							<h3 class="font-semibold">Tu respuesta · pendiente de revisión</h3>
							<p class="mt-2 whitespace-pre-wrap">{item.response}</p>
							<p class="mt-2 text-sm">Recibida {fmt.format(item.respondedAt!)}</p>
						</div>
					) : enabled && item.status === "waiting_information" ? (
						<form
							method="post"
							action="/api/provider/compliance/respond"
							class="mt-4 space-y-3"
							data-information-response
							data-actor-id={session.user.id}
						>
							<input type="hidden" name="decisionId" value={item.decisionId} />
							<input type="hidden" name="requestKey" value={crypto.randomUUID()} />
							<label class="block font-semibold">
								Respuesta
								<Textarea
									name="message"
									required
									minlength="12"
									maxlength="4000"
									className="mt-2 min-h-32"
								/>
							</label>
							<p class="text-sm text-slate-600">
								No incluyas contraseñas, números bancarios ni documentos aquí. Actualiza las
								evidencias en su sección segura y describe qué corregiste.
							</p>
							<Button type="submit">Enviar respuesta</Button>
							<p role="status" data-response-status />
						</form>
					) : (
						<p class="mt-4">La respuesta no está habilitada en este momento.</p>
					)}
				</Card>
			))
		}
	</div>
</ProviderSettingsLayout>
<script>
	import {
		canDiscardCaseCommand,
		prepareCaseCommand,
		type PendingCaseCommand,
	} from "@/modules/casework/command-recovery"
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-information-response]")) {
		const decisionId = String(new FormData(form).get("decisionId") ?? "")
		const storageKey = `casework:provider-response:${form.dataset.actorId}:${decisionId}`
		let pending: PendingCaseCommand | null = null
		try {
			pending = JSON.parse(sessionStorage.getItem(storageKey) || "null")
		} catch {
			/* In-memory retry remains available. */
		}
		if (pending) {
			const values = JSON.parse(pending.body) as Record<string, string>
			for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
				"input[name],textarea[name]"
			))
				if (values[field.name] != null) field.value = values[field.name]
		}
		let busy = false
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			if (busy) return
			busy = true
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
			const status = form.querySelector<HTMLElement>("[data-response-status]")!
			button.disabled = true
			status.textContent = "Enviando respuesta…"
			const values = Object.fromEntries(new FormData(form))
			pending = prepareCaseCommand(pending, JSON.stringify(values), () => String(values.requestKey))
			try {
				sessionStorage.setItem(storageKey, JSON.stringify(pending))
			} catch {
				/* In-memory recovery. */
			}
			const payload = new FormData()
			for (const [name, value] of Object.entries(
				JSON.parse(pending.body) as Record<string, string>
			))
				payload.set(name, value)
			try {
				const response = await fetch(form.action, { method: "POST", body: payload })
				if (
					response.redirected &&
					new URL(response.url).pathname === "/provider/compliance/requests" &&
					new URL(response.url).searchParams.get("result") === "received"
				) {
					try {
						sessionStorage.removeItem(storageKey)
					} catch {}
					window.location.assign(response.url)
					return
				}
				const body = await response.json().catch(() => ({}))
				if (canDiscardCaseCommand(response.status, body.error)) {
					pending = null
					try {
						sessionStorage.removeItem(storageKey)
					} catch {}
				}
				status.textContent =
					response.status === 401
						? "Tu sesión venció. Conserva el texto e inicia sesión antes de volver a intentar."
						: "No se confirmó la recepción. Tu texto sigue aquí. El reintento consultará la misma referencia con el mensaje original."
			} catch {
				status.textContent =
					"Respuesta sin confirmar. Vuelve a intentar: se consultará la misma referencia con el mensaje original."
			} finally {
				busy = false
				button.disabled = false
			}
		})
	}
</script>
