---
import ProviderProfileForm from "@/components/provider/ProviderProfileForm.astro"
import ProviderRegisterForm from "@/components/provider/ProviderRegisterForm.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderOnboardingLayout from "@/layouts/ProviderOnboardingLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import {
	PROVIDER_ONBOARDING_SELECTION_COOKIE,
	providerOnboardingBusinessHref,
	providerOnboardingProductCreateHref,
	resolveProviderOnboardingVertical,
} from "@/lib/onboarding/providerOnboarding"
import {
	providerOnboardingLegacyHref,
	resolveProviderOnboardingRollout,
} from "@/lib/onboarding/providerOnboardingRollout"
import { PROVIDER_FORM_FLASH_COOKIE, readProviderFormFlash } from "@/lib/provider-form-flash"
import { isHolderStorageAvailable, readProviderHolderProfile } from "@/lib/provider-holder-profile"
import { getProviderFullAggregate } from "@/modules/catalog/public"

const user = await getUserFromRequest(Astro.request)
const vertical = resolveProviderOnboardingVertical(Astro.url.searchParams.get("vertical"))
if (!vertical) return Astro.redirect("/provider/onboarding?intent=provider")
const currentPath = `${Astro.url.pathname}${Astro.url.search}`
if (!user?.id) return Astro.redirect(`/SignInPage?returnTo=${encodeURIComponent(currentPath)}`)
const rollout = resolveProviderOnboardingRollout({ userId: user.id, host: Astro.url.host })
if (!rollout.enabled) return Astro.redirect(providerOnboardingLegacyHref())

const providerId = await getProviderIdFromRequest(Astro.request, user)
const aggregate = providerId ? await getProviderFullAggregate(providerId, user.id) : null
const provider = aggregate?.provider ?? null
const holderProfile = providerId ? await readProviderHolderProfile(providerId) : null
const holderStorageReady = await isHolderStorageAvailable()
const profile = aggregate?.profile ?? null
const hasProvider = Boolean(provider?.id)
const needsIdentity = !hasProvider || (holderStorageReady && !holderProfile)
const success = String(Astro.url.searchParams.get("success") ?? "")
const error = String(Astro.url.searchParams.get("error") ?? "")
const identityFlash = readProviderFormFlash(
	Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value,
	"identity"
)
const profileFlash = readProviderFormFlash(
	Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value,
	"profile"
)
if (identityFlash || profileFlash)
	Astro.cookies.delete(PROVIDER_FORM_FLASH_COOKIE, { path: "/provider" })
const serviceLabel = vertical === "tour" ? "tour" : "alojamiento"
Astro.cookies.set(PROVIDER_ONBOARDING_SELECTION_COOKIE, vertical, {
	path: "/",
	httpOnly: true,
	sameSite: "lax",
	secure: Astro.url.protocol === "https:",
	maxAge: 60 * 60 * 24 * 30,
})
const identityNext = providerOnboardingBusinessHref(vertical)
const productNext = providerOnboardingProductCreateHref(vertical)
---

<ProviderOnboardingLayout title={`Preparar ${serviceLabel} · Datos del negocio`}>
	<div class="space-y-6">
		<header class="space-y-3">
			<h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
				{
					needsIdentity
						? hasProvider
							? `Completa quién ofrecerá tu ${serviceLabel}`
							: `Crea tu negocio para ofrecer un ${serviceLabel}`
						: `Prepara cómo operará tu ${serviceLabel}`
				}
			</h1>
			<p class="max-w-2xl text-sm leading-6 text-slate-300">
				{
					needsIdentity
						? `Paso 1 de 2. Identifica quién ofrecerá el ${serviceLabel}; después definirás sus datos operativos.`
						: `Paso 2 de 2. Define los datos operativos y después crearás el borrador de tu ${serviceLabel}.`
				}
			</p>
		</header>

		{
			success === "identity_saved" && !needsIdentity ? (
				<Notice variant="success" title="Datos del negocio guardados">
					Ahora completa los datos operativos para crear el borrador de tu {serviceLabel}.
				</Notice>
			) : null
		}
		{
			error ? (
				<Notice variant="error" title="No se pudo guardar">
					{error === "validation_error"
						? "Revisa los campos marcados e inténtalo de nuevo."
						: "Intenta de nuevo en unos momentos."}
				</Notice>
			) : null
		}
		<Notice variant="info" title="Podrás guardar un borrador">
			Guardar estos datos o crear la oferta no publica el servicio ni habilita reservas. Antes de
			publicar, Fastt mostrará los requisitos pendientes del negocio y de la oferta, con la acción
			para resolverlos.
		</Notice>

		{
			!needsIdentity ? (
				<ProviderProfileForm
					isProviderAvailable={true}
					profile={profile}
					supportEmailRequired={true}
					showRelatedDomains={false}
					redirectTo={productNext}
					cancelHref="/provider/onboarding?intent=provider&change=1"
					draft={profileFlash}
					fieldErrors={profileFlash?.errors}
					onboarding={true}
					serviceLabel={serviceLabel}
					submitLabel={`Guardar y crear mi ${serviceLabel}`}
				/>
			) : (
				<ProviderRegisterForm
					provider={provider}
					holderProfile={holderProfile}
					holderStorageReady={holderStorageReady}
					hasProvider={hasProvider}
					onboardingNext={identityNext}
					backHref="/provider/onboarding?intent=provider&change=1"
					draft={identityFlash}
					fieldErrors={identityFlash?.errors}
					onboarding={true}
					serviceLabel={serviceLabel}
					submitLabel="Guardar y continuar"
				/>
			)
		}
	</div>
</ProviderOnboardingLayout>
