---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { getProviderSessionSurfaceFromRequest } from "@/lib/auth/providerSessionSurface"
import { logRoutePerformance } from "@/lib/observability/performanceLog"
import { createServerTimingRecorder } from "@/lib/observability/serverTiming"
import { buildProviderSettingsSummary } from "@/lib/provider-settings-summary"
import { routes } from "@/lib/routes"

const startedAt = performance.now()
const timing = createServerTimingRecorder()

const providerSession = await timing.time("authProvider", () =>
	getProviderSessionSurfaceFromRequest(Astro.request)
)
if (!providerSession) return Astro.redirect("/SignInPage")
const userId = providerSession.userId
const providerId = providerSession.providerId

const summary = await timing.time("settingsSummary", () =>
	buildProviderSettingsSummary({
		providerId,
		userId,
		timing,
	})
)

const blockers = summary?.blockers ?? []
const risks = summary?.risks ?? []
const capabilities = summary?.capabilities ?? {
	publish: false,
	booking: false,
	payments: false,
	integrations: false,
}
const counts = summary?.counts ?? {
	documents: 0,
	verifiedDocuments: 0,
	paymentAccounts: 0,
	verifiedPaymentAccounts: 0,
	integrations: 0,
	connectedIntegrations: 0,
	auditEvents: 0,
	teamMembers: 0,
}
const progressPercent = Number(summary?.progress?.progressPercent ?? 0)
const progressLabel =
	summary?.progress?.message ??
	(blockers.length
		? `${blockers.length} bloqueo${blockers.length === 1 ? "" : "s"} pendiente${blockers.length === 1 ? "" : "s"}.`
		: "Configuración base lista.")
const providerName = String(
	summary?.provider?.displayName || summary?.provider?.legalName || "Proveedor"
)
const primaryCtaHref = String(
	summary?.actions?.primaryCtaAction || routes.providerSettingsProfile()
)
const primaryCtaLabel = String(
	summary?.actions?.primaryCtaLabel ||
		(blockers[0]?.label ? `Continuar: ${blockers[0].label}` : "Continuar configuración")
)
const secondaryCtaHref = String(summary?.actions?.secondaryCtaAction || "#estado-cuenta")
const secondaryCtaLabel = String(
	summary?.actions?.secondaryCtaLabel ||
		(blockers.length ? "Ver todas las áreas" : "Revisar estado de áreas")
)
const hasBlockers = blockers.length > 0
const nextStepLabel = blockers[0]?.label ? String(blockers[0].label) : "Configuración base lista"
const nextStepBody = blockers[0]
	? "Un solo paso a la vez: resuelve esto para desbloquear publicación, reservas o cobros."
	: "Ya puedes operar lo básico. Revisa las áreas si quieres afinar fiscalidad, pagos o equipo."
const readiness = summary?.readiness ?? []
const incompleteAreas = readiness.filter((item: { complete?: boolean }) => !item.complete)
const completeAreas = readiness.filter((item: { complete?: boolean }) => item.complete)

const professionalToolsEnabled = providerSession.professionalToolsEnabled
const professionalToolsParam = String(Astro.url.searchParams.get("professionalTools") ?? "").trim()
const professionalToolsSaved = professionalToolsParam === "saved"
const professionalToolsError = professionalToolsParam === "error"

const summaryBootstrap = summary ? JSON.stringify(summary).replace(/</g, "\\u003c") : "null"

const capabilityRows = [
	{ key: "publish", label: "Publicación", on: "Habilitada", off: "Bloqueada" },
	{ key: "booking", label: "Reservas", on: "Habilitadas", off: "Bloqueadas" },
	{ key: "payments", label: "Cobros", on: "Habilitados", off: "Bloqueados" },
	{ key: "integrations", label: "Integraciones", on: "Listas", off: "Sin activar" },
] as const

timing.addTotal("providerSettingsPage")
timing.setHeader(Astro.response.headers)
logRoutePerformance({
	name: "provider-settings-page",
	request: Astro.request,
	url: Astro.url,
	status: 200,
	startedAt,
	timing,
	userId,
	providerId,
})
---

<ProviderSettingsLayout
	title="Configuración del proveedor"
	heading="Resumen de configuración"
	description="Un próximo paso claro cuando hay bloqueos; el resto queda plegado."
>
	{
		professionalToolsSaved ? (
			<Notice variant="success" title="Herramientas profesionales actualizadas">
				El sidebar se ajustará según la preferencia del proveedor, escala y rol.
			</Notice>
		) : null
	}
	{
		professionalToolsError ? (
			<Notice variant="warning" title="No se pudo actualizar">
				Revisa que la migración de preferencias del proveedor esté aplicada.
			</Notice>
		) : null
	}

	<section
		class="space-y-4"
		data-settings-coach
		data-settings-hub-density={hasBlockers ? "blocker" : "clear"}
	>
		<Card class="border-slate-800 bg-slate-950 text-white">
			<div class="space-y-6">
				<div class="flex flex-wrap items-start justify-between gap-4">
					<div>
						<p class="text-sm text-slate-400">Proveedor</p>
						<h2 class="mt-1 text-2xl font-semibold text-white" data-settings-provider-name>
							{providerName}
						</h2>
					</div>
					<Badge variant={hasBlockers ? "warning" : "success"} data-settings-base-badge>
						{hasBlockers ? "Con bloqueos" : "Base lista"}
					</Badge>
				</div>

				<div class="h-2 overflow-hidden rounded-full bg-slate-800">
					<div
						class="h-full bg-white"
						style={`width: ${Math.max(0, Math.min(100, progressPercent))}%`}
						data-settings-progress-bar
					>
					</div>
				</div>
				<p class="text-sm leading-6 text-slate-300" data-settings-progress-label>
					{progressLabel}
				</p>

				<div
					class="fastt-notice rounded-2xl border border-white/10 bg-white/5 p-5"
					data-settings-blockers-notice
					data-settings-next-step
					data-funnel-blocker-id={blockers[0]?.id || undefined}
					data-funnel-domain={blockers[0]?.id || undefined}
					data-funnel-surface="hub_coach"
				>
					<p class="text-xs font-semibold tracking-[0.14em] text-slate-400 uppercase">
						Próximo paso
					</p>
					<p class="mt-2 text-xl font-semibold text-white" data-settings-next-step-label>
						{nextStepLabel}
					</p>
					<p class="mt-2 text-sm leading-6 text-slate-300" data-settings-next-step-body>
						{nextStepBody}
					</p>
					<div class="mt-5 flex flex-wrap gap-3">
						<Button
							href={primaryCtaHref}
							data-settings-primary-cta
							data-funnel-cta="primary"
							data-funnel-domain={blockers[0]?.id || undefined}
							data-funnel-blocker-id={blockers[0]?.id || undefined}
							data-funnel-surface="hub_coach"
						>
							{primaryCtaLabel}
						</Button>
						<a
							href={secondaryCtaHref}
							class="fastt-notice inline-flex items-center justify-center rounded-xl border border-white/20 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
							data-settings-secondary-cta
							data-funnel-cta="secondary"
							data-funnel-domain={blockers[0]?.id || undefined}
							data-funnel-surface="hub_coach"
						>
							{secondaryCtaLabel}
						</a>
					</div>
				</div>

				{
					hasBlockers ? (
						<details
							class="fastt-notice rounded-2xl border border-white/10 bg-white/5 p-4"
							data-settings-details-capabilities
						>
							<summary class="cursor-pointer text-sm font-semibold text-white">
								Capacidades y conteo de bloqueos
							</summary>
							<div class="mt-4 flex flex-wrap gap-2" data-settings-capabilities-strip>
								{capabilityRows.map((row) => {
									const enabled = Boolean(capabilities[row.key])
									return (
										<div class="fastt-notice flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5">
											<span class="text-xs font-medium text-slate-300">{row.label}</span>
											<Badge
												variant={
													enabled ? "success" : row.key === "integrations" ? "neutral" : "warning"
												}
												data-capability={row.key}
											>
												{enabled ? row.on : row.off}
											</Badge>
										</div>
									)
								})}
							</div>
							<p class="mt-4 text-xs text-slate-500">
								<span data-settings-blockers-count>{blockers.length}</span> bloqueo
								{blockers.length === 1 ? "" : "s"} ·{" "}
								<span data-settings-risks-count>{risks.length}</span> riesgo
								{risks.length === 1 ? "" : "s"} a revisar
							</p>
						</details>
					) : (
						<>
							<div class="flex flex-wrap gap-2" data-settings-capabilities-strip>
								{capabilityRows.map((row) => {
									const enabled = Boolean(capabilities[row.key])
									return (
										<div class="fastt-notice flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5">
											<span class="text-xs font-medium text-slate-300">{row.label}</span>
											<Badge
												variant={
													enabled ? "success" : row.key === "integrations" ? "neutral" : "warning"
												}
												data-capability={row.key}
											>
												{enabled ? row.on : row.off}
											</Badge>
										</div>
									)
								})}
							</div>
							<p class="text-xs text-slate-500">
								<span data-settings-blockers-count>{blockers.length}</span> bloqueo
								{blockers.length === 1 ? "" : "s"} ·{" "}
								<span data-settings-risks-count>{risks.length}</span> riesgo
								{risks.length === 1 ? "" : "s"} a revisar
							</p>
						</>
					)
				}
			</div>
		</Card>
	</section>

	<section id="estado-cuenta" class="scroll-mt-24 space-y-4" data-settings-estado-min>
		<Card>
			<div class="space-y-4">
				<div>
					<h2 class="text-xl font-semibold text-slate-950">Estado de tu cuenta</h2>
					<p class="mt-2 text-sm leading-6 text-slate-600">
						{
							hasBlockers
								? "Áreas pendientes primero. El detalle de capacidades está plegado arriba."
								: "Primero lo pendiente; lo completo queda al final."
						}
					</p>
				</div>
				<div class="space-y-3" data-settings-readiness>
					{
						readiness.length ? (
							[...incompleteAreas, ...completeAreas].map((item) => (
								<a href={item.href || "#"} class="block">
									<Card
										variant="soft"
										class="flex items-center justify-between gap-4 transition hover:border-slate-300 hover:bg-white"
									>
										<div>
											<p class="text-sm font-semibold text-slate-950">{item.label}</p>
											<p class="mt-1 text-sm text-slate-600">
												{item.complete ? "Listo para operar" : "Requiere configuración"}
											</p>
										</div>
										<Badge variant={item.complete ? "success" : "warning"}>
											{item.complete ? "Completo" : "Pendiente"}
										</Badge>
									</Card>
								</a>
							))
						) : (
							<Card variant="soft" class="text-sm text-slate-600">
								Aún no hay estado de tu cuenta disponible.
							</Card>
						)
					}
				</div>
			</div>
		</Card>
	</section>

	<details
		class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
		data-settings-details-risks
	>
		<summary class="cursor-pointer text-lg font-semibold text-slate-950">
			Riesgos y señales ({risks.length})
		</summary>
		<p class="mt-2 text-sm leading-6 text-slate-600">
			No bloquean todo, pero conviene revisarlas antes de escalar.
		</p>
		<div class="mt-4 space-y-3" data-settings-risks>
			{
				risks.length ? (
					risks.map((risk) => (
						<a href={risk.href || "#"} class="block">
							<Card variant="soft" class="transition hover:border-slate-300 hover:bg-white">
								<div class="flex items-start justify-between gap-4">
									<p class="text-sm font-semibold text-slate-950">{risk.label}</p>
									<Badge variant={risk.severity === "medium" ? "warning" : "neutral"}>
										{risk.severity === "medium"
											? "Medio"
											: risk.severity === "high"
												? "Alto"
												: "Bajo"}
									</Badge>
								</div>
							</Card>
						</a>
					))
				) : (
					<Card variant="soft" class="text-sm text-slate-600">
						No hay riesgos activos en el resumen actual.
					</Card>
				)
			}
		</div>
	</details>

	<details
		class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
		data-settings-details-counts
	>
		<summary class="cursor-pointer text-lg font-semibold text-slate-950">
			Números de apoyo
		</summary>
		<p class="mt-2 text-sm leading-6 text-slate-600">
			Conteos útiles para soporte; no son el trabajo principal de esta pantalla.
		</p>
		<section class="mt-4 grid gap-4 md:grid-cols-4">
			<Card variant="soft" class="bg-white">
				<p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Documentos</p>
				<p class="mt-2 text-2xl font-semibold text-slate-950" data-count="documents">
					{Number(counts.verifiedDocuments ?? 0)} / {Number(counts.documents ?? 0)}
				</p>
			</Card>
			<Card variant="soft" class="bg-white">
				<p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
					Cuentas de pago
				</p>
				<p class="mt-2 text-2xl font-semibold text-slate-950" data-count="paymentAccounts">
					{Number(counts.verifiedPaymentAccounts ?? 0)} / {Number(counts.paymentAccounts ?? 0)}
				</p>
			</Card>
			<Card variant="soft" class="bg-white">
				<p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Conectores</p>
				<p class="mt-2 text-2xl font-semibold text-slate-950" data-count="integrations">
					{Number(counts.connectedIntegrations ?? 0)} / {Number(counts.integrations ?? 0)}
				</p>
			</Card>
			<Card variant="soft" class="bg-white">
				<p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Auditoría</p>
				<p class="mt-2 text-2xl font-semibold text-slate-950" data-count="auditEvents">
					{Number(counts.auditEvents ?? 0)}
				</p>
			</Card>
		</section>
	</details>

	<details
		class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
		open={false}
		data-settings-details-ops
	>
		<summary class="cursor-pointer text-lg font-semibold text-slate-950">
			Detalle operativo (capacidades, simulación, auditoría)
		</summary>
		<p class="mt-2 text-sm leading-6 text-slate-600">
			Matriz de bloqueos por capacidad, simulación fiscal/pagos y eventos recientes.
		</p>
		<div data-settings-deferred-root class="mt-4 space-y-4"></div>
	</details>

	<details
		class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
		open={!hasBlockers}
		data-settings-details-prefs
	>
		<summary class="cursor-pointer text-lg font-semibold text-slate-950">
			Preferencias del espacio de trabajo
		</summary>
		<p class="mt-2 text-sm leading-6 text-slate-600">
			Preferencias que cambian cómo se organiza el sidebar y las herramientas visibles.
		</p>
		<Card class="mt-4">
			<form method="post" action="/api/provider/preferences/professional-tools" class="space-y-5">
				<input type="hidden" name="returnTo" value={routes.providerSettings()} />
				<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
					<div class="max-w-2xl space-y-2">
						<div class="flex flex-wrap items-center gap-3">
							<h2 class="text-xl font-semibold text-slate-900">Herramientas profesionales</h2>
							<Badge variant={professionalToolsEnabled ? "success" : "neutral"}>
								{professionalToolsEnabled ? "Activadas" : "Desactivadas"}
							</Badge>
						</div>
						<p class="text-sm leading-6 text-slate-600">
							Activa herramientas para manejar muchas tarifas, reglas, inventario físico y
							operaciones masivas.
						</p>
						<p class="text-sm leading-6 text-slate-600">
							Recomendado si administras varios hoteles, muchas habitaciones o reglas recurrentes.
						</p>
					</div>
					<div
						class="fastt-tabs min-w-[220px] border border-slate-200 bg-white p-1 text-sm font-semibold text-slate-700 shadow-sm"
						role="radiogroup"
						aria-label="Modo de experiencia"
					>
						<label class="block">
							<input
								type="radio"
								name="mode"
								value="simple"
								checked={!professionalToolsEnabled}
								class="peer sr-only fastt-check-input"
							/>
							<span
								class="fastt-tab block cursor-pointer px-4 py-2 text-center text-slate-600 transition peer-checked:bg-slate-950 peer-checked:text-white"
							>
								Simple
							</span>
						</label>
						<label class="mt-1 block">
							<input
								type="radio"
								name="mode"
								value="professional"
								checked={professionalToolsEnabled}
								class="peer sr-only fastt-check-input"
							/>
							<span
								class="fastt-tab block cursor-pointer px-4 py-2 text-center text-slate-600 transition peer-checked:bg-slate-950 peer-checked:text-white"
							>
								Pro
							</span>
						</label>
					</div>
				</div>
				<Card variant="soft">
					<p class="text-sm font-semibold text-slate-900">Modo Simple</p>
					<p class="mt-1 text-sm leading-6 text-slate-600">
						Muestra la operación diaria: Tarifas y Calendario. El contrato se completa dentro de
						cada tarifa.
					</p>
					<p class="mt-3 text-sm font-semibold text-slate-900">Modo Pro</p>
					<p class="mt-1 text-sm leading-6 text-slate-600">
						El sidebar puede mostrar Reglas de venta y herramientas profesionales. Las operaciones
						de cupo y disponibilidad siguen dentro de Calendario.
					</p>
				</Card>
				<div class="flex justify-end">
					<Button type="submit">Guardar preferencia</Button>
				</div>
			</form>
		</Card>
	</details>

	<script type="application/json" id="settings-summary-bootstrap" set:html={summaryBootstrap} />

	<script>
		import "@/pages/provider/settings/_client/settings-summary-hydration.js"
	</script>
</ProviderSettingsLayout>
