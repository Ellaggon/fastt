---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import ProviderIntegrationsLayout from "@/layouts/ProviderIntegrationsLayout.astro"
import { requireProvider } from "@/lib/auth/requireProvider"
import { getProviderIntegrationsCatalogReadModel } from "@/lib/provider-integration-read-models"
import { routes } from "@/lib/routes"
import { ArrowRight, CalendarSync, Network } from "@lucide/astro"

const auth = await requireProvider(Astro.request).catch((error: any) => {
	if (error instanceof Response && error.status === 401) return "__REDIRECT_LOGIN__"
	if (error instanceof Response && error.status === 403) return "__REDIRECT_PROVIDER__"
	throw error
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const catalogState = await getProviderIntegrationsCatalogReadModel(auth.providerId)

const catalogItems = [
	{
		key: "channel_manager",
		category: "Distribución",
		name: "Channel manager",
		description:
			"Centraliza disponibilidad, tarifas y restricciones con Cloudbeds, Channex u otro proveedor.",
		outcome: "Evita diferencias de inventario entre Fastt y tus canales de venta.",
		icon: Network,
		href: routes.providerSettingsIntegrationsConnectChannelManager(),
		action: "Conectar channel manager",
		recommended: true,
	},
	{
		key: "external_calendars",
		category: "Calendarios",
		name: "Calendarios externos",
		description: "Importa o exporta feeds iCal para bloquear fechas ocupadas en otras plataformas.",
		outcome: "Protege disponibilidad cuando todavía no utilizas un channel manager.",
		icon: CalendarSync,
		href: routes.ratesCalendarConnections(),
		action: "Configurar calendarios",
		recommended: false,
	},
] as const

function connectorIsConfigured(key: string) {
	if (key === "external_calendars") return catalogState.calendars.length > 0
	return catalogState.connections.some(
		(connection) =>
			connection.connectorKey === key &&
			connection.status !== "not_configured" &&
			connection.status !== "revoked"
	)
}

function catalogStatus(key: string) {
	if (key === "external_calendars" && catalogState.calendars.length) {
		const hasError = catalogState.calendars.some((calendar) => calendar.status === "error")
		if (hasError || catalogState.openConflictCount) {
			return { label: "Requiere atención", tone: "warning" as const }
		}
		return { label: "Funcionando", tone: "success" as const }
	}
	const statuses = catalogState.connections
		.filter((connection) => connection.connectorKey === key)
		.map((connection) => connection.status)
	if (!statuses.length) return null
	if (statuses.includes("connected")) return { label: "Funcionando", tone: "success" as const }
	if (statuses.includes("error") || statuses.includes("requires_attention")) {
		return { label: "Requiere atención", tone: "warning" as const }
	}
	return { label: "Configuración pendiente", tone: "info" as const }
}
---

<ProviderIntegrationsLayout
	title="Catálogo de integraciones"
	eyebrow="Integraciones · Catálogo"
	heading="Conectar un servicio"
	description="Elige qué necesitas sincronizar. Antes de activar una conexión podrás revisar su alcance y validarla."
>
	<div slot="actions">
		<Button href={routes.providerSettingsIntegrationsConnections()} variant="secondary">
			Volver a conexiones
		</Button>
	</div>

	<section class="space-y-4" data-integration-catalog>
		<div class="max-w-2xl">
			<h2 class="text-xl font-semibold text-white">Servicios disponibles</h2>
			<p class="mt-1 text-sm leading-6 text-slate-400">
				Empieza por el sistema que hoy controla tu inventario. Puedes sumar otras conexiones
				después.
			</p>
		</div>

		<div class="grid gap-3 lg:grid-cols-2">
			{
				catalogItems.map((item) => {
					const status = catalogStatus(item.key)
					const Icon = item.icon
					return (
						<article
							class="fastt-notice grid min-h-64 gap-5 rounded-lg border border-slate-200 bg-white p-5 text-slate-900 shadow-[var(--fastt-shadow-row)]"
							data-catalog-connector={item.key}
						>
							<div class="flex items-start justify-between gap-4">
								<div class="fastt-notice flex size-10 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700">
									<Icon class="size-5" aria-hidden="true" />
								</div>
								<div class="flex flex-wrap justify-end gap-2">
									{item.recommended ? <Badge variant="info">Recomendado</Badge> : null}
									{status ? <Badge variant={status.tone}>{status.label}</Badge> : null}
								</div>
							</div>
							<div>
								<p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
									{item.category}
								</p>
								<h3 class="mt-1.5 text-lg font-semibold text-slate-950">{item.name}</h3>
								<p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
								<p class="mt-2 text-xs leading-5 text-slate-500">{item.outcome}</p>
							</div>
							<a
								href={item.href}
								class="fastt-button mt-auto inline-flex h-10 items-center justify-center gap-2 justify-self-start rounded-lg bg-slate-950 px-4 text-sm font-semibold text-white transition hover:bg-slate-800"
							>
								{connectorIsConfigured(item.key) ? "Administrar" : item.action}
								<ArrowRight class="size-4" aria-hidden="true" />
							</a>
						</article>
					)
				})
			}
		</div>
	</section>
</ProviderIntegrationsLayout>
