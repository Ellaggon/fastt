---
import ChannelManagerOperationsPanel from "@/components/provider/integrations/ChannelManagerOperationsPanel.astro"
import InitialAriSyncPanel from "@/components/provider/integrations/InitialAriSyncPanel.astro"
import IntegrationDiagnosticsPanel from "@/components/provider/integrations/IntegrationDiagnosticsPanel.astro"
import IntegrationExecutionPanel from "@/components/provider/integrations/IntegrationExecutionPanel.astro"
import IntegrationLifecycle from "@/components/provider/integrations/IntegrationLifecycle.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Input from "@/components/ui/Input.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderIntegrationsLayout from "@/layouts/ProviderIntegrationsLayout.astro"
import { requireProvider } from "@/lib/auth/requireProvider"
import { getChannelManagerVendor } from "@/lib/provider-channel-manager-vendors"
import { mapProviderIntegrationError } from "@/lib/provider-integration-errors"
import { deriveProviderIntegrationOperationalState } from "@/lib/provider-integration-operational-state"
import { getProviderChannelManagerOperationalReadModel } from "@/lib/provider-integration-read-models"
import {
	isProviderIntegrationWorkspaceConnector,
	listProviderConnectorCatalog,
} from "@/lib/provider-integrations"
import { routes } from "@/lib/routes"
import { ArrowLeft, Link2, ShieldCheck } from "@lucide/astro"

const auth = await requireProvider(Astro.request).catch((error: unknown) => {
	if (error instanceof Response && error.status === 401) return "__REDIRECT_LOGIN__"
	if (error instanceof Response && error.status === 403) return "__REDIRECT_PROVIDER__"
	throw error
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const connectionId = String(Astro.params.connectionId ?? "")
const operational = await getProviderChannelManagerOperationalReadModel({
	providerId: auth.providerId,
	connectionId,
})
const connection = operational?.connection ?? null
if (
	!operational ||
	!connection ||
	!isProviderIntegrationWorkspaceConnector(connection.connectorKey)
) {
	return Astro.redirect(routes.providerSettingsIntegrationsConnections(), 302)
}
const connector =
	listProviderConnectorCatalog().find((item) => item.key === connection.connectorKey) ?? null
const vendor = getChannelManagerVendor(connection.vendorKey)
const displayName = String(connection.displayName ?? "").trim() || connector?.name || "Conexión"
const scopes = Array.isArray(connection.scopesJson)
	? connection.scopesJson.map(String)
	: (connector?.defaultScopes ?? [])
const success = Astro.url.searchParams.get("success")
const error = Astro.url.searchParams.get("error")
const productionResult = Astro.url.searchParams.get("production")
const returnTo = routes.providerSettingsIntegrationConnection(connection.id)

function formatDate(value: Date | null) {
	if (!value) return "Sin actividad"
	return new Intl.DateTimeFormat("es", {
		dateStyle: "medium",
		timeStyle: "short",
	}).format(value)
}

function modeLabel(mode: string) {
	return mode === "production" ? "Producción" : "Pruebas"
}

function permissionLabel(scope: string) {
	if (scope === "availability:sync") return "Disponibilidad"
	if (scope === "rates:sync") return "Tarifas"
	if (scope === "restrictions:sync") return "Restricciones"
	if (scope === "inventory:read") return "Consultar inventario"
	if (scope === "rates:read") return "Consultar tarifas"
	if (scope === "calendar:import") return "Importar bloqueos"
	return "Acceso operativo"
}

function endpointHost(value: string | null) {
	if (!value) return "Administrado por el proveedor"
	try {
		return new URL(value).hostname
	} catch {
		return "Endpoint configurado"
	}
}

const state = deriveProviderIntegrationOperationalState({
	connectionStatus: String(connection.status),
	accessValidated: operational.accessValidated,
	coverageComplete: operational.coverage.complete,
	initialSyncState: operational.initialSyncState,
	hasAttention: operational.openIncidents.some((item) =>
		["error", "critical"].includes(String(item.severity))
	),
})
const initialSucceeded = operational.initialSyncState === "succeeded"
const initialBusy = ["queued", "running"].includes(operational.initialSyncState)
const reconnectHref = `${routes.providerSettingsIntegrationsConnectChannelManager()}?step=access&connectionId=${encodeURIComponent(connection.id)}&vendor=${encodeURIComponent(String(connection.vendorKey ?? "generic"))}&env=${connection.mode === "production" ? "production" : "sandbox"}`
const latestRun = operational.latestRun
const latestSummary =
	latestRun?.summaryJson && typeof latestRun.summaryJson === "object"
		? (latestRun.summaryJson as Record<string, any>)
		: null
const warningCount = Number(
	latestSummary?.totals?.warned ?? latestSummary?.request?.warned ?? latestRun?.skippedCount ?? 0
)
const rejectedCount = Number(
	latestSummary?.totals?.rejected ?? latestSummary?.request?.rejected ?? latestRun?.failedCount ?? 0
)
---

<ProviderIntegrationsLayout
	title={displayName}
	eyebrow="Integraciones · Detalle de conexión"
	heading={displayName}
	description={`${connector?.name ?? "Integración"}${connection.connectorKey === "channel_manager" && vendor.key !== "generic" ? ` · ${vendor.name}` : ""}`}
>
	<div slot="actions" class="flex flex-wrap gap-2">
		<Button href={routes.providerSettingsIntegrationsConnections()} variant="onDark" size="sm">
			<ArrowLeft class="size-4" aria-hidden="true" />
			Conexiones
		</Button>
	</div>

	{
		success === "sync_tested" ? (
			<Notice variant="success" title="Acceso validado">
				Fastt pudo comunicarse con el servicio correctamente.
			</Notice>
		) : success === "reference_checked" ? (
			<Notice variant="info" title="Referencia comprobada">
				La referencia es válida, pero el proveedor todavía no confirmó una prueba completa.
			</Notice>
		) : null
	}
	{
		error ? (
			<Notice variant="warning" title="No pudimos validar la conexión">
				{mapProviderIntegrationError(error)}
			</Notice>
		) : null
	}
	{
		productionResult === "activated" ? (
			<Notice variant="success" title="Producción activada">
				La cobertura se validó nuevamente. Ya puedes ejecutar la sincronización inicial.
			</Notice>
		) : productionResult === "blocked" ? (
			<Notice variant="warning" title="Producción sigue bloqueada">
				No se confirmó la acción o algún requisito cambió. Revisa la cobertura antes de intentarlo.
			</Notice>
		) : null
	}

	<IntegrationLifecycle
		currentStepIndex={state.stepIndex}
		accessComplete={operational.accessValidated}
		mappingComplete={operational.coverage.complete}
		initialComplete={initialSucceeded}
		operationalComplete={initialSucceeded}
	/>

	<ChannelManagerOperationsPanel
		connectionId={connection.id}
		state={state}
		syncEnabled={connection.syncEnabled}
		accessValidated={operational.accessValidated}
		coverageComplete={operational.coverage.complete}
		initialSucceeded={initialSucceeded}
		initialBusy={initialBusy}
		mode={connection.mode === "production" ? "production" : "sandbox"}
		isRevoked={connection.status === "revoked"}
		credentialRevoked={operational.credentialRevoked}
		mappingHref={routes.providerSettingsIntegrationMapping(connection.id)}
		incidentsHref={routes.providerSettingsIntegrationsIncidents()}
		reconnectHref={reconnectHref}
		testAction={`/api/provider/integrations/${connection.connectorKey}/sync`}
		returnTo={returnTo}
	/>

	<section
		class="fastt-notice grid gap-px overflow-hidden rounded-lg border border-slate-200 bg-slate-200 text-slate-900 md:grid-cols-3"
		aria-label="Resumen operativo"
		data-integration-operational-summary
	>
		<div class="bg-white p-4">
			<p class="text-xs font-semibold text-slate-500">Cobertura de mapping</p>
			<p class="mt-1 text-xl font-semibold text-slate-950">{operational.coverage.percent}%</p>
			<p class="mt-1 text-xs leading-5 text-slate-500">
				{operational.coverage.rooms.mapped}/{operational.coverage.rooms.total} habitaciones · {
					operational.coverage.rates.mapped
				}/{operational.coverage.rates.total} tarifas
			</p>
		</div>
		<div class="bg-white p-4">
			<p class="text-xs font-semibold text-slate-500">Último resultado</p>
			<p class="mt-1 text-sm font-semibold text-slate-950">
				{
					latestRun
						? latestRun.status === "succeeded"
							? "Completado"
							: latestRun.status === "partial"
								? "Con advertencias"
								: latestRun.status === "failed"
									? "Fallido"
									: "En curso"
						: "Sin sincronizaciones"
				}
			</p>
			<p class="mt-1 text-xs leading-5 text-slate-500">
				{
					latestRun
						? formatDate(latestRun.finishedAt ?? latestRun.startedAt)
						: "Aún no hay evidencia comercial."
				}
			</p>
		</div>
		<div class="bg-white p-4">
			<p class="text-xs font-semibold text-slate-500">Próxima ejecución</p>
			<p class="mt-1 text-sm font-semibold text-slate-950">
				{
					initialSucceeded
						? connection.syncEnabled
							? formatDate(operational.nextExecutionAt)
							: "Pausada"
						: initialBusy
							? "En curso"
							: "Aún no programada"
				}
			</p>
			<p class="mt-1 text-xs leading-5 text-slate-500">
				{
					!initialSucceeded
						? initialBusy
							? "El primer envío está siendo procesado."
							: "Se programará después de la sincronización inicial."
						: operational.activeJob
							? operational.activeJob.status === "running"
								? "Hay un proceso en ejecución."
								: "Hay cambios esperando al worker."
							: connection.syncEnabled
								? "Los cambios nuevos se agrupan automáticamente."
								: "Reanuda para volver a enviar y recibir."
				}
			</p>
		</div>
	</section>

	{
		latestRun?.status === "partial" || warningCount > 0 || rejectedCount > 0 ? (
			<Notice variant="warning" title="Advertencias parciales">
				<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
					<span>{warningCount} observados</span>
					<span>{rejectedCount} rechazados</span>
					<a
						href={routes.providerSettingsIntegrationsIncidents()}
						class="font-semibold underline underline-offset-2"
					>
						Revisar incidencias
					</a>
				</div>
			</Notice>
		) : null
	}

	<div class="grid gap-5" data-integration-connection-health>
		<Card>
			<div class="flex items-start gap-3 border-b border-slate-200 pb-4">
				<div
					class="fastt-notice flex size-10 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700"
				>
					<ShieldCheck class="size-5" aria-hidden="true" />
				</div>
				<div>
					<h2 class="text-lg font-semibold text-slate-950">Estado y alcance</h2>
					<p class="mt-1 text-sm leading-6 text-slate-600">{state.description}</p>
				</div>
			</div>
			<dl class="divide-y divide-slate-200">
				<div class="grid gap-1 py-3 sm:grid-cols-[10rem_1fr]">
					<dt class="text-sm font-medium text-slate-500">Entorno</dt>
					<dd class="text-sm font-semibold text-slate-950">{modeLabel(String(connection.mode))}</dd>
				</div>
				<div class="grid gap-1 py-3 sm:grid-cols-[10rem_1fr]">
					<dt class="text-sm font-medium text-slate-500">Origen</dt>
					<dd class="text-sm font-semibold text-slate-950">
						{connection.connectorKey === "channel_manager" ? vendor.name : connector?.name}
					</dd>
				</div>
				<div class="grid gap-1 py-3 sm:grid-cols-[10rem_1fr]">
					<dt class="text-sm font-medium text-slate-500">Propiedad externa</dt>
					<dd class="text-sm font-semibold text-slate-950">
						{connection.externalPropertyId ?? "Sin seleccionar"}
					</dd>
				</div>
				<div class="grid gap-1 py-3 sm:grid-cols-[10rem_1fr]">
					<dt class="text-sm font-medium text-slate-500">Servicio remoto</dt>
					<dd class="text-sm font-semibold text-slate-950">
						{endpointHost(connection.endpointUrl)}
					</dd>
				</div>
				<div class="grid gap-1 py-3 sm:grid-cols-[10rem_1fr]">
					<dt class="text-sm font-medium text-slate-500">Última respuesta</dt>
					<dd class="text-sm font-semibold text-slate-950">{formatDate(connection.lastSyncAt)}</dd>
				</div>
			</dl>
			<div class="border-t border-slate-200 pt-4">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<p class="text-sm font-semibold text-slate-950">Permisos concedidos</p>
						<div class="mt-2 flex flex-wrap gap-2">
							{
								scopes.length ? (
									scopes.map((scope) => <Badge variant="neutral">{permissionLabel(scope)}</Badge>)
								) : (
									<span class="text-sm text-slate-600">Sin permisos declarados.</span>
								)
							}
						</div>
					</div>
					{
						connection.connectorKey === "channel_manager" ? (
							<Button
								href={routes.providerSettingsIntegrationMapping(connection.id)}
								size="sm"
								variant="secondary"
							>
								<Link2 class="size-4" aria-hidden="true" />
								Abrir mapeo
							</Button>
						) : null
					}
				</div>
			</div>
		</Card>
	</div>

	{
		connection.status !== "revoked" &&
		operational.coverage.complete &&
		!initialSucceeded &&
		(connection.mode !== "production" || connection.syncEnabled) ? (
			<InitialAriSyncPanel
				connectionId={connection.id}
				environment={connection.mode === "production" ? "production" : "sandbox"}
				canStart={operational.accessValidated && !initialBusy}
			/>
		) : null
	}

	<IntegrationDiagnosticsPanel connectionId={connection.id} />

	<IntegrationExecutionPanel
		connectionId={connection.id}
		description="Las ejecuciones y los procesos en cola no se consultan hasta que abras este historial."
	/>

	{
		connection.status !== "revoked" ? (
			<Card data-disconnect-confirmation>
				<details>
					<summary class="cursor-pointer text-sm font-semibold text-slate-700">
						Administrar acceso
					</summary>
					<div class="mt-4 border-t border-slate-200 pt-4">
						<h2 class="text-base font-semibold text-slate-950">Desconectar servicio</h2>
						<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
							Fastt dejará de sincronizar esta conexión. El historial permanecerá disponible para
							auditoría.
						</p>
						<form
							method="post"
							action={`/api/provider/integrations/${connection.connectorKey}/revoke`}
							class="mt-4 grid max-w-md gap-3"
						>
							<input type="hidden" name="uiMode" value="simple" />
							<input type="hidden" name="connectionId" value={connection.id} />
							<input type="hidden" name="returnTo" value={routes.providerSettingsIntegrations()} />
							<label for="confirm-disconnect" class="text-sm font-medium text-slate-700">
								Escribe DESCONECTAR para confirmar
							</label>
							<Input id="confirm-disconnect" name="confirmDisconnect" autocomplete="off" required />
							<div>
								<Button type="submit" variant="danger">
									Desconectar
								</Button>
							</div>
						</form>
					</div>
				</details>
			</Card>
		) : null
	}
</ProviderIntegrationsLayout>
