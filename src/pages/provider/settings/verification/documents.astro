---
import ProviderDocumentsAccessDenied from "@/components/provider/ProviderDocumentsAccessDenied.astro"
import ProviderVerificationOptionals from "@/components/provider/ProviderVerificationOptionals.astro"
import Button from "@/components/ui/Button.astro"
import Notice from "@/components/ui/Notice.astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { safeVerificationReturn, safeRatePlanPlaybookReturn } from "@/lib/auth/returnTo"
import { listOpenComplianceAssignments } from "@/lib/provider-compliance-ops"
import {
	listProviderDocuments,
	providerDocumentTypes,
	requiredKycDocumentTypes,
} from "@/lib/provider-documents"
import { formatProviderRoleLabel } from "@/lib/provider-permissions"
import {
	copyVerificationNavigationQuery,
	resolveVerificationNavigation,
	tourDocumentWorkspaceHref,
} from "@/lib/verification/navigation"
import { routes } from "@/lib/routes"
import { loadProviderVerificationResolution } from "@/lib/verification/requirement-context"
import { packDocumentTypes, packUploadOptions } from "@/lib/verification/requirement-resolver"
import { asc, db, eq, Product } from "@/shared/infrastructure/db/compat"

const auth = await requireProviderSessionSurface(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const providerId = typeof auth === "string" ? null : auth.provider.providerId
const sessionPermissions = typeof auth === "string" ? null : auth.provider.permissions
const providerRoleLabel =
	typeof auth === "string" ? "Operaciones" : formatProviderRoleLabel(auth.provider.role)

const summaryPromise = fetch(new URL("/api/provider/settings/summary", Astro.url), {
	headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
})
	.then((res) => (res.ok ? res.json() : null))
	.catch(() => null)
const documentsPromise = providerId ? listProviderDocuments(providerId).catch(() => []) : []
const productsPromise = providerId
	? db
			.select({ id: Product.id, name: Product.name, productType: Product.productType })
			.from(Product)
			.where(eq(Product.providerId, providerId))
			.orderBy(asc(Product.creationDate))
			.catch(() => [])
	: []
const openAssignmentsPromise = providerId
	? listOpenComplianceAssignments({ providerId }).catch(() => [])
	: []

const [summary, documents, openAssignments, products] = await Promise.all([
	summaryPromise,
	documentsPromise,
	openAssignmentsPromise,
	productsPromise,
])
const availableProducts = products
	.filter((product) => product.productType === "tour" || product.productType === "hotel")
	.map((product) => ({
		id: product.id,
		name: product.name,
		kind: product.productType === "hotel" ? ("lodging" as const) : ("tour" as const),
	}))
const permissions = sessionPermissions ?? summary?.permissions ?? {}
const canManageDocuments = Boolean(permissions.canManageDocuments)

const documentAssignmentById = Object.fromEntries(
	openAssignments
		.filter((row) => row.domain === "documents")
		.map((row) => [row.entityId, row] as const)
)

const loadedResolution = providerId ? await loadProviderVerificationResolution(providerId) : null
const legacyOptionalTypes = providerDocumentTypes.filter(
	(item) => !(requiredKycDocumentTypes as readonly string[]).includes(item.value)
)
const resolvedPack =
	loadedResolution?.enforced && loadedResolution.resolution ? loadedResolution.resolution : null
const optionalDocumentTypes = resolvedPack ? packUploadOptions(resolvedPack) : legacyOptionalTypes
const packTypes = new Set<string>(
	resolvedPack ? packDocumentTypes(resolvedPack) : legacyOptionalTypes.map((item) => item.value)
)
const optionalDocuments = documents.filter((doc) => packTypes.has(doc.type))
const renewalDocumentId = String(Astro.url.searchParams.get("renewDocumentId") ?? "").trim() || null

const result = Astro.url.searchParams.get("result")
const requestedType = String(Astro.url.searchParams.get("type") ?? "").trim()
const navigation = resolveVerificationNavigation({
	url: Astro.url,
	lines: loadedResolution?.lines ?? [...new Set(availableProducts.map((product) => product.kind))],
	experienceIds: availableProducts
		.filter((product) => product.kind === "tour")
		.map((product) => product.id),
	fasttCollects: false,
})
const tourWorkspaceHref = tourDocumentWorkspaceHref({
	url: Astro.url,
	navigation,
	requirements: resolvedPack?.requirements ?? [],
})
if (tourWorkspaceHref) return Astro.redirect(tourWorkspaceHref)
const defaultOptionalUploadType = optionalDocumentTypes.some((item) => item.value === requestedType)
	? requestedType
	: (optionalDocumentTypes.find((item) => item.value.startsWith(`${requestedType}::`))?.value ??
		optionalDocumentTypes[0]?.value)
const uploadError = String(Astro.url.searchParams.get("error") ?? "").trim()

const resultMessages: Record<
	string,
	{ title: string; body: string; variant: "success" | "warning" }
> = {
	submitted: {
		title: "Documento enviado",
		body: "Quedó en revisión. Contará para el requisito aplicable solo cuando Fastt verifique su vigencia y alcance.",
		variant: "success",
	},
	verified: {
		title: "Documento verificado",
		body: "El respaldo fue verificado. Su alcance determinará en qué oferta cuenta.",
		variant: "success",
	},
	rejected: {
		title: "Documento requiere cambios",
		body: "Revisa el motivo y envía una versión corregida.",
		variant: "warning",
	},
}

const playbookReturnHref = safeRatePlanPlaybookReturn(Astro.url.searchParams.get("returnTo"))
const evidenceReturnHref = safeVerificationReturn(Astro.url.searchParams.get("returnTo"))
const playbookReturnUrl = playbookReturnHref
	? new URL(playbookReturnHref, "http://fastt.local")
	: null
const playbookDetour = Boolean(playbookReturnUrl)
const detourPlaybookId = String(playbookReturnUrl?.searchParams.get("playbook") ?? "")
const detourVertical = Astro.url.searchParams.get("playbookVertical") === "hotel" ? "hotel" : "tour"
const detourStep =
	String(playbookReturnUrl?.searchParams.get("step") ?? "").trim() ||
	(detourPlaybookId === "complete-to-publish" ? "bookingPolicies" : "conditions")
const scopeProductId =
	String(Astro.url.searchParams.get("scopeProductId") ?? "").trim() ||
	String(playbookReturnUrl?.searchParams.get("productId") ?? "").trim() ||
	null
const verificationBackUrl = copyVerificationNavigationQuery(
	new URL(routes.providerSettingsVerification(), Astro.url),
	Astro.url
)
const verificationBackHref = `${verificationBackUrl.pathname}${verificationBackUrl.search}`
---

{
	playbookDetour && playbookReturnHref && playbookReturnUrl ? (
		<PlaybookLayout
			title="Licencias y seguro"
			playbookId={
				detourPlaybookId === "complete-to-publish" ? "complete-to-publish" : "launch-tour"
			}
			active
			stepId={detourStep}
			productId={String(playbookReturnUrl.searchParams.get("productId") ?? "")}
			variantId={String(playbookReturnUrl.searchParams.get("variantId") ?? "")}
			ratePlanId={String(playbookReturnUrl.searchParams.get("ratePlanId") ?? "")}
			isHotel={detourVertical === "hotel"}
			playbookVertical={detourVertical}
			hideFooter
			lightweight
		>
			<section class="space-y-6">
				<header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
					<div class="max-w-2xl space-y-2">
						<h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl md:text-3xl">
							Licencias y seguro
						</h1>
						<p class="text-sm leading-6 text-slate-300">
							Este paso de la guía sigue abierto. Sube la licencia o el seguro y vuelve a las
							condiciones de la tarifa.
						</p>
					</div>
					<Button href={playbookReturnHref} variant="secondary" className="shrink-0">
						Volver a condiciones
					</Button>
				</header>
				{result && resultMessages[result] ? (
					<Notice variant={resultMessages[result].variant} title={resultMessages[result].title}>
						{resultMessages[result].body}
					</Notice>
				) : null}
				{uploadError === "document_not_applicable" ? (
					<Notice variant="warning" title="Este documento no corresponde a tu línea">
						La prueba de titularidad y la licencia del establecimiento son de alojamiento. Un guía
						no las sube aquí.
					</Notice>
				) : null}
				{resolvedPack && optionalDocumentTypes.length === 0 ? (
					<Notice variant="info" title="Todavía no hay un documento de línea para subir">
						Declara la actividad, el territorio y el papel de cada experiencia. Eso afina la
						credencial o el seguro. La identidad sigue en Verificación.
					</Notice>
				) : null}
				{canManageDocuments ? (
					<ProviderVerificationOptionals
						documents={optionalDocuments}
						documentTypes={optionalDocumentTypes}
						canManageDocuments={canManageDocuments}
						defaultUploadType={defaultOptionalUploadType}
						documentAssignments={documentAssignmentById}
						playbookReturnTo={playbookReturnHref}
						playbookVertical={detourVertical}
						scopeProductId={scopeProductId}
						availableProducts={availableProducts}
						renewalDocumentId={renewalDocumentId}
					/>
				) : (
					<ProviderDocumentsAccessDenied roleLabel={providerRoleLabel} surface="optional" />
				)}
			</section>
		</PlaybookLayout>
	) : (
		<ProviderSettingsLayout
			title="Evidencia y documentos"
			heading="Evidencia y documentos"
			description="Documentos de tu línea. La identidad, el registro de la entidad y el NIT, cuando corresponden, se piden una vez en Verificación."
			showSettingsTabs={false}
		>
			<div slot="actions" class="flex flex-wrap gap-3">
				{evidenceReturnHref ? (
					<Button href={evidenceReturnHref} variant="secondary">
						{evidenceReturnHref.startsWith("/rates/plans/")
							? "Volver a la tarifa"
							: "Volver a la experiencia"}
					</Button>
				) : null}
				<Button href={verificationBackHref} variant="secondary">
					Volver a verificación
				</Button>
				<Button href={routes.providerSettings()} variant="secondary">
					Configuración
				</Button>
			</div>

			{result && resultMessages[result] ? (
				<Notice variant={resultMessages[result].variant} title={resultMessages[result].title}>
					{resultMessages[result].body}
				</Notice>
			) : null}
			{scopeProductId ? (
				<Notice variant="info" title="Evidencia para una experiencia concreta">
					El documento quedará vinculado a esta experiencia. Solo contará si la revisión confirma su
					titular, vigencia, territorio, actividad y demás alcance declarado.
				</Notice>
			) : null}
			{uploadError === "document_not_applicable" ? (
				<Notice variant="warning" title="Este documento no corresponde a tu línea">
					La prueba de titularidad y la licencia del establecimiento son de alojamiento. Un guía no
					las sube aquí.
				</Notice>
			) : null}
			{resolvedPack && optionalDocumentTypes.length === 0 ? (
				<Notice variant="info" title="Todavía no hay un documento de línea para subir">
					Declara la actividad, el territorio y el papel de cada experiencia. Eso afina la
					credencial o el seguro. La identidad sigue en Verificación.
				</Notice>
			) : null}

			{canManageDocuments ? (
				<ProviderVerificationOptionals
					documents={optionalDocuments}
					documentTypes={optionalDocumentTypes}
					canManageDocuments={canManageDocuments}
					defaultUploadType={defaultOptionalUploadType}
					documentAssignments={documentAssignmentById}
					playbookReturnTo={evidenceReturnHref}
					scopeProductId={scopeProductId}
					availableProducts={availableProducts}
					renewalDocumentId={renewalDocumentId}
				/>
			) : (
				<ProviderDocumentsAccessDenied roleLabel={providerRoleLabel} surface="optional" />
			)}
		</ProviderSettingsLayout>
	)
}
