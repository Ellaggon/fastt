---
import ProviderTaxProfileCard from "@/components/provider/ProviderTaxProfileCard.astro"
import ProviderTrustMapRail from "@/components/provider/ProviderTrustMapRail.astro"
import Button from "@/components/ui/Button.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { listOpenComplianceAssignments } from "@/lib/provider-compliance-ops"
import { TRUST_GLOSSARY } from "@/lib/provider-trust-map"
import { buildProviderVerificationTrustSnapshot } from "@/lib/provider-verification-trust-snapshot"
import { routes } from "@/lib/routes"

const auth = await requireProviderSessionSurface(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const providerId = typeof auth === "string" ? null : auth.provider.providerId
const sessionPermissions = typeof auth === "string" ? null : auth.provider.permissions
const result = Astro.url.searchParams.get("result")

const trustSnapshotPromise = providerId
	? buildProviderVerificationTrustSnapshot({ providerId }).catch(() => null)
	: null
const openAssignmentsPromise = providerId
	? listOpenComplianceAssignments({ providerId }).catch(() => [])
	: []

const [trustSnapshot, openAssignments] = await Promise.all([
	trustSnapshotPromise,
	openAssignmentsPromise,
])

const permissions = (sessionPermissions ?? {}) as { canManageFiscality?: boolean }
const canManageFiscality = Boolean(permissions.canManageFiscality)
const fiscalAssignment = providerId
	? (openAssignments.find((row) => row.domain === "fiscal" && row.entityId === providerId) ?? null)
	: null
const trustLinks = trustSnapshot?.trustLinks ?? []
const trustMapComplete = Boolean(trustSnapshot?.trustMapComplete)
const listaReady = Boolean(trustSnapshot?.listaReady)
const wizardStepNumber = trustSnapshot?.wizardStepNumber ?? 0
const wizardProgressPercent = trustSnapshot?.wizardProgressPercent ?? 0
const taxConfiguration = trustSnapshot?.taxConfiguration ?? null
---

<ProviderSettingsLayout
	title="Verificación fiscal"
	eyebrow={TRUST_GLOSSARY.page.eyebrow}
	heading={TRUST_GLOSSARY.page.heading}
	description={TRUST_GLOSSARY.page.description}
	showSettingsTabs={false}
	progressStep={trustLinks.length ? wizardStepNumber : null}
	progressTotal={trustLinks.length ? trustLinks.length : null}
	progressPercent={trustLinks.length ? wizardProgressPercent : null}
>
	<div slot="actions" class="flex flex-wrap items-center gap-3">
		<Button href={routes.providerSettingsVerification()} variant="secondary" size="sm">
			{TRUST_GLOSSARY.returnToVerification.label}
		</Button>
	</div>

	<div
		class="space-y-4"
		data-verification-fiscal-page
		data-verification-lista={listaReady ? "true" : "false"}
		data-trust-map-complete={trustMapComplete ? "true" : "false"}
	>
		{
			result === "tax_profile_saved" ? (
				<Notice variant="success" title="Identidad fiscal enviada">
					<p>
						Guardamos tu registro fiscal. Quedó en revisión; el resultado aparecerá en este eslabón
						cuando el equipo Fastt termine.
					</p>
					<p
						class="mt-3 flex flex-wrap gap-3"
						data-post-save-cta
						data-funnel-domain="fiscality"
						data-funnel-surface="verification_fiscal"
					>
						<a class="font-semibold underline" href={routes.providerSettingsVerificationPayments()}>
							Continuar a pagos
						</a>
					</p>
				</Notice>
			) : null
		}

		<div data-verification-trust-nav>
			<ProviderTrustMapRail links={trustLinks} activeId="fiscal" />
		</div>

		<Notice variant="info" title="Fiscal">
			Completa residencia fiscal, NIT/TIN o registro comercial y modo de facturación. Esto permite
			revisar tu identidad tributaria para liquidaciones; no define los impuestos que cobras al
			huésped.
		</Notice>

		<details
			class="fastt-notice rounded-[var(--fastt-radius-card)] border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"
			data-fiscal-withhold-explainer
			data-long-copy-collapsed="true"
		>
			<summary class="cursor-pointer font-semibold">Retenciones y liquidaciones</summary>
			<div class="mt-3 text-amber-950/85">
				<p class="mb-2">
					Sin NIT/registro y residencia fiscal verificados, Fastt puede <strong
						>retener o retrasar liquidaciones</strong
					> hasta confirmar tu identidad tributaria.
				</p>
				<ul class="list-disc space-y-1 pl-5 text-sm leading-6">
					<li>
						<strong>Con registro verificado:</strong> las liquidaciones a tu cuenta de cobros pueden seguir
						el calendario normal tras payout verificado.
					</li>
					<li>
						<strong>Sin registro o en revisión:</strong> los cobros a huéspedes pueden continuar, pero
						el desembolso al proveedor queda sujeto a retención o espera de cumplimiento.
					</li>
					<li>
						Esto es independiente de los impuestos al huésped: la retención se aplica a <em>tu</em>{
							" "
						}
						liquidación, no al precio de la reserva.
					</li>
				</ul>
			</div>
		</details>

		<ProviderTaxProfileCard
			taxConfiguration={taxConfiguration}
			canManageFiscality={canManageFiscality}
			reviewAssignment={fiscalAssignment}
			formReturnTo="verificationFiscal"
		/>
	</div>
</ProviderSettingsLayout>
