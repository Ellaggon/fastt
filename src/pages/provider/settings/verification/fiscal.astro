---
import ProviderVerificationWorkspace from "@/components/provider/ProviderVerificationWorkspace.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { formatProviderRoleLabel } from "@/lib/provider-permissions"
import { TRUST_GLOSSARY } from "@/lib/provider-trust-map"
import { loadProviderVerificationWorkspace } from "@/lib/provider-verification-workspace"
import { routes } from "@/lib/routes"

const auth = await requireProviderSessionSurface(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const providerId = typeof auth === "string" ? null : auth.provider.providerId
const sessionPermissions = typeof auth === "string" ? null : auth.provider.permissions
const providerRoleLabel =
	typeof auth === "string" ? "Operaciones" : formatProviderRoleLabel(auth.provider.role)

if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const model = await loadProviderVerificationWorkspace({
	providerId,
	sessionPermissions,
	providerRoleLabel,
	url: Astro.url,
})
const { trustLinks, listaReady, trustMapComplete, wizardStepNumber, wizardProgressPercent } = model
const showWizardProgress = trustLinks.length > 0
---

<ProviderSettingsLayout
	title="Verificación fiscal"
	eyebrow={TRUST_GLOSSARY.page.eyebrow}
	heading={TRUST_GLOSSARY.page.heading}
	description={TRUST_GLOSSARY.page.description}
	showSettingsTabs={false}
	progressStep={trustLinks.length ? wizardStepNumber : null}
	progressTotal={trustLinks.length ? trustLinks.length : null}
	progressPercent={trustLinks.length ? wizardProgressPercent : null}
>
	<div
		class="space-y-6 md:space-y-8"
		data-verification-fiscal-page
		data-verification-lista={listaReady ? "true" : "false"}
		data-trust-map-complete={trustMapComplete ? "true" : "false"}
	>
		<ProviderVerificationWorkspace model={model} />
	</div>
</ProviderSettingsLayout>
