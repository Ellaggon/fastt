---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Input from "@/components/ui/Input.astro"
import Notice from "@/components/ui/Notice.astro"
import Select from "@/components/ui/Select.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { parseInvitationMailStatus } from "@/lib/email/invitationMailStatus"
import {
	formatProviderRoleLabel,
	providerRoleDescriptions,
	providerRoleLabels,
} from "@/lib/provider-permissions"
import { routes } from "@/lib/routes"

const auth = await requireProviderSessionSurface(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const summaryRes = await fetch(new URL("/api/provider/settings/summary", Astro.url), {
	headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
})
const summary = summaryRes.ok ? await summaryRes.json() : null
const users = Array.isArray(summary?.users) ? summary.users : []
const invitations = Array.isArray(summary?.invitations) ? summary.invitations : []
const permissions = summary?.permissions ?? {}
const result = Astro.url.searchParams.get("result")
const mailStatus = parseInvitationMailStatus(Astro.url.searchParams.get("mail"))
const error = Astro.url.searchParams.get("error")
const pendingInvitations = invitations.filter(
	(invitation: any) => invitation.status === "pending" || invitation.status === "expired"
)
const canInviteTeam = Boolean(permissions.canInviteTeam)
const canManageMembers = auth.provider.role === "owner"
const visibleInvitations = canInviteTeam ? pendingInvitations : []
const ownerCount = users.filter((user: any) => user.role === "owner").length

type InviteNotice = { title: string; body: string; variant: "success" | "info" | "warning" }

function resolveInviteResultNotice(
	resultKey: string | null,
	mail: ReturnType<typeof parseInvitationMailStatus>
): InviteNotice | null {
	if (!resultKey) return null
	if (resultKey === "canceled")
		return {
			variant: "success",
			title: "Invitación cancelada",
			body: "La invitación ya no se puede aceptar.",
		}
	if (resultKey === "joined")
		return {
			variant: "success",
			title: "Te uniste al equipo",
			body: "Ya puedes operar con el rol asignado.",
		}
	if (resultKey === "invited")
		if (mail === "logged")
			return {
				variant: "info",
				title: "Invitación creada",
				body: "El correo no está configurado en este entorno. Copia el enlace de aceptación y compártelo con la persona invitada.",
			}
	if (resultKey === "invited")
		return {
			variant: mail === "failed" ? "warning" : "success",
			title: mail === "failed" ? "Invitación creada" : "Invitación enviada",
			body:
				mail === "failed"
					? "No pudimos enviar el correo. Copia el enlace de aceptación y compártelo con la persona invitada."
					: "La persona debe aceptarla con el mismo correo dentro de 14 días.",
		}
	if (resultKey === "resent")
		if (mail === "logged")
			return {
				variant: "info",
				title: "Invitación renovada",
				body: "El correo no está configurado en este entorno. Comparte el enlace de aceptación actualizado.",
			}
	if (resultKey === "resent")
		return {
			variant: mail === "failed" ? "warning" : "success",
			title: "Invitación renovada",
			body:
				mail === "failed"
					? "No pudimos enviar el correo. Comparte el enlace de aceptación actualizado."
					: "La invitación volvió a estar activa durante 14 días.",
		}
	if (resultKey === "member_updated")
		return {
			variant: "success",
			title: "Acceso actualizado",
			body: "El rol de la persona se actualizó.",
		}
	if (resultKey === "member_removed")
		return {
			variant: "success",
			title: "Acceso retirado",
			body: "La persona ya no puede entrar al proveedor.",
		}
	return null
}

const resultNotice = resolveInviteResultNotice(result, mailStatus)
const errorMessages: Record<string, string> = {
	duplicate_pending_invitation: "Ya hay una invitación pendiente para ese correo.",
	forbidden: "Tu rol no permite gestionar el equipo.",
	not_found: "No encontramos a esa persona.",
	not_pending: "Esa invitación ya no está pendiente.",
	not_resendable: "Esa invitación no se puede reenviar.",
	owner_protected: "La propiedad de la cuenta no se cambia desde esta pantalla.",
	last_owner_protected: "Debe existir al menos un propietario en el proveedor.",
	self_protected: "No puedes retirar ni cambiar tu propio acceso.",
	validation_error: "Revisa los datos e inténtalo de nuevo.",
}

function roleLabelFor(userOrInvite: { role?: string; roleLabel?: string }) {
	return userOrInvite.roleLabel || formatProviderRoleLabel(userOrInvite.role)
}

function formatMemberDate(value: string | Date | null | undefined) {
	if (!value) return "Fecha no disponible"
	return new Intl.DateTimeFormat("es-BO", {
		day: "numeric",
		month: "short",
		year: "numeric",
	}).format(new Date(value))
}
---

<ProviderSettingsLayout
	title="Equipo y permisos"
	heading="Equipo"
	description="Controla quién puede operar este proveedor y protege sus áreas sensibles."
>
	{
		resultNotice ? (
			<Notice variant={resultNotice.variant} title={resultNotice.title}>
				{resultNotice.body}
			</Notice>
		) : null
	}
	{
		error ? (
			<Notice variant="warning" title="No se pudo completar la acción">
				{errorMessages[error] || "Revisa los datos e inténtalo de nuevo."}
			</Notice>
		) : null
	}

	<div class="grid gap-4 xl:grid-cols-[1.1fr_0.9fr]">
		<Card class="p-0">
			<div
				class="flex flex-col gap-3 border-b border-slate-200 px-5 py-5 sm:flex-row sm:items-start sm:justify-between"
			>
				<div>
					<p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">Acceso</p>
					<h2 class="mt-1 text-xl font-semibold text-slate-950">Miembros activos</h2>
					<p class="mt-1 text-sm leading-6 text-slate-600">
						{
							canManageMembers
								? "Gestiona quién puede operar este proveedor y con qué nivel de acceso."
								: "Personas que actualmente pueden operar este proveedor."
						}
					</p>
				</div>
				<Badge variant="neutral">{users.length} con acceso</Badge>
			</div>
			{
				users.length ? (
					<div class="divide-y divide-slate-200">
						{users.map((user: any) => (
							<article class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
								<div class="flex min-w-0 items-center gap-3">
									<div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-700">
										{user.email?.slice(0, 1).toUpperCase()}
									</div>
									<div class="min-w-0">
										<p class="truncate text-sm font-semibold text-slate-950">{user.email}</p>
										<p class="mt-1 text-sm text-slate-600">
											{roleLabelFor(user)} · Acceso desde {formatMemberDate(user.createdAt)}
										</p>
									</div>
								</div>
								<div class="flex shrink-0 items-center gap-2 self-start sm:self-auto">
									<Badge variant="success">Activo</Badge>
									{canManageMembers &&
									user.id !== auth.user.id &&
									(user.role !== "owner" || ownerCount > 1) ? (
										<details class="relative">
											<summary class="fastt-button cursor-pointer list-none rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50">
												Gestionar
											</summary>
											<div class="fastt-card absolute right-0 z-20 mt-2 w-72 space-y-4 rounded-lg border border-slate-200 bg-white p-4 shadow-lg">
												<form
													class="space-y-3"
													method="post"
													action="/api/provider/settings/team-members"
													data-astro-reload
												>
													<input type="hidden" name="action" value="update_role" />
													<input type="hidden" name="userId" value={user.id} />
													<label class="grid gap-2 text-sm font-medium text-slate-700">
														Rol
														<Select name="role">
															<option value="admin" selected={user.role === "admin"}>
																{providerRoleLabels.admin}
															</option>
															<option value="staff" selected={user.role === "staff"}>
																{providerRoleLabels.staff}
															</option>
														</Select>
													</label>
													<Button type="submit" variant="secondary" size="sm">
														Guardar rol
													</Button>
												</form>
												<div class="border-t border-slate-200 pt-3">
													<form
														method="post"
														action="/api/provider/settings/team-members"
														data-astro-reload
													>
														<input type="hidden" name="action" value="remove" />
														<input type="hidden" name="userId" value={user.id} />
														<Button type="submit" variant="danger" size="sm">
															Retirar acceso
														</Button>
													</form>
												</div>
											</div>
										</details>
									) : null}
								</div>
							</article>
						))}
					</div>
				) : (
					<div class="px-5 py-8 text-sm text-slate-600">Aún no hay personas con acceso.</div>
				)
			}
		</Card>

		<Card>
			{
				canInviteTeam ? (
					<form
						class="space-y-4"
						method="post"
						action="/api/provider/settings/invitations"
						data-astro-reload
					>
						<div>
							<h2 class="text-xl font-semibold text-slate-950">Invitar persona</h2>
							<p class="mt-2 text-sm leading-6 text-slate-600">
								La persona recibirá una invitación para este correo y tendrá 14 días para aceptarla.
							</p>
						</div>
						<label class="grid gap-2 text-sm font-medium text-slate-700">
							Correo
							<Input type="email" name="email" placeholder="persona@empresa.com" required />
						</label>
						<label class="grid gap-2 text-sm font-medium text-slate-700">
							Rol
							<Select name="role" required>
								<option value="admin">{providerRoleLabels.admin}</option>
								<option value="staff">{providerRoleLabels.staff}</option>
							</Select>
						</label>
						<p class="text-xs leading-5 text-slate-500">
							<strong>{providerRoleLabels.admin}:</strong> {providerRoleDescriptions.admin}
							<br />
							<strong>{providerRoleLabels.staff}:</strong> {providerRoleDescriptions.staff}
						</p>
						<Button type="submit">Enviar invitación</Button>
					</form>
				) : (
					<div class="space-y-2">
						<>
							<h2 class="text-xl font-semibold text-slate-950">Acceso restringido</h2>
							<p class="text-sm leading-6 text-slate-600">
								Solo el propietario puede administrar personas y sus roles.
							</p>
						</>
					</div>
				)
			}
		</Card>
	</div>

	{
		canInviteTeam ? (
			<Card>
				<div class="space-y-4">
					<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
						<div>
							<>
								<h2 class="text-xl font-semibold text-slate-950">Invitaciones pendientes</h2>
								<p class="mt-1 text-sm leading-6 text-slate-600">
									Solo quienes gestionan equipo pueden ver y compartir estos enlaces.
								</p>
							</>
						</div>
						<Badge variant={visibleInvitations.length ? "warning" : "success"}>
							{visibleInvitations.length} pendiente{visibleInvitations.length === 1 ? "" : "s"}
						</Badge>
					</div>
					{visibleInvitations.length ? (
						<div class="space-y-3">
							{visibleInvitations.map((invitation: any) => (
								<div class="rounded-lg border border-slate-200 p-4">
									<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
										<div>
											<p class="text-sm font-semibold text-slate-950">{invitation.email}</p>
											<p class="mt-1 text-sm text-slate-600">
												{invitation.statusLabel || "Pendiente de aceptación"} ·{" "}
												{roleLabelFor(invitation)} · Expira:{" "}
												{formatMemberDate(invitation.expiresAt)}
											</p>
										</div>
										<div class="flex flex-wrap gap-2">
											{invitation.status !== "expired" ? (
												<form
													method="post"
													action="/api/provider/settings/invitations"
													data-astro-reload
												>
													<input type="hidden" name="action" value="resend" />
													<input type="hidden" name="id" value={invitation.id} />
													<Button type="submit" variant="secondary" size="sm">
														Reenviar
													</Button>
												</form>
											) : null}
											<form
												method="post"
												action="/api/provider/settings/invitations"
												data-astro-reload
											>
												<input type="hidden" name="action" value="cancel" />
												<input type="hidden" name="id" value={invitation.id} />
												<Button type="submit" variant="secondary" size="sm">
													Cancelar
												</Button>
											</form>
										</div>
									</div>
									{invitation.acceptPath ? (
										<details class="mt-4 border-t border-slate-200 pt-3">
											<summary class="cursor-pointer text-sm font-medium text-slate-700">
												Copiar enlace de aceptación
											</summary>
											<div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
												<Input
													class="fastt-field font-mono text-xs"
													type="text"
													readonly
													value={new URL(invitation.acceptPath, Astro.url).toString()}
													data-invite-accept-url
												/>
												<Button type="button" variant="secondary" size="sm" data-copy-invite-link>
													Copiar
												</Button>
											</div>
										</details>
									) : null}
								</div>
							))}
						</div>
					) : (
						<div class="rounded-lg bg-slate-50 px-4 py-5 text-sm text-slate-600">
							No hay invitaciones en curso.
						</div>
					)}
				</div>
			</Card>
		) : null
	}
</ProviderSettingsLayout>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-copy-invite-link]").forEach((button) => {
		button.addEventListener("click", async () => {
			const urlInput = button.parentElement?.querySelector<HTMLInputElement>(
				"[data-invite-accept-url]"
			)
			if (!urlInput) return
			await navigator.clipboard?.writeText(urlInput.value)
			button.textContent = "Copiado"
			window.setTimeout(() => (button.textContent = "Copiar"), 1600)
		})
	})
</script>
