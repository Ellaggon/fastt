---
import FiscalActivity from "@/components/tax-fees/FiscalActivity"
import FiscalOperations from "@/components/tax-fees/FiscalOperations"
import FiscalWorkspaceLayout from "@/layouts/FiscalWorkspaceLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { getProviderTaxConfiguration } from "@/lib/provider-tax-configuration"
const auth = await requireProviderSessionSurface(Astro.request).catch(() => "__DENIED__" as const)
if (auth === "__DENIED__") return Astro.redirect("/SignInPage")
const configuration = await getProviderTaxConfiguration(auth.provider.providerId).catch(() => null)
const requestedView = Astro.url.searchParams.get("view")
const view =
	requestedView === "reports" || requestedView === "reconciliation" || requestedView === "exports"
		? requestedView
		: "activity"
---

<FiscalWorkspaceLayout
	activeTab="activity"
	identityLabel={configuration?.statusLabel ?? "No configurada"}
	isIdentityConfigured={Boolean(configuration?.isConfigured)}
	canManageFiscality={auth.provider.permissions.canManageFiscality}
	primaryLabel="Exportar"
	primaryHref="/api/provider/tax-fees/reports?format=csv"
>
	<nav class="mb-5 flex gap-4 border-b border-slate-200 text-sm">
		<a
			class={`pb-3 ${view === "activity" ? "border-b-2 border-slate-950 font-semibold text-slate-950" : "text-slate-600"}`}
			href="/provider/settings/tax-fees/activity">Actividad</a
		><a
			class={`pb-3 ${view === "reports" ? "border-b-2 border-slate-950 font-semibold text-slate-950" : "text-slate-600"}`}
			href="?view=reports">Reportes</a
		><a
			class={`pb-3 ${view === "reconciliation" ? "border-b-2 border-slate-950 font-semibold text-slate-950" : "text-slate-600"}`}
			href="?view=reconciliation">Conciliación</a
		><a
			class={`pb-3 ${view === "exports" ? "border-b-2 border-slate-950 font-semibold text-slate-950" : "text-slate-600"}`}
			href="?view=exports">Exportaciones</a>
	</nav>
	{
		view === "activity" ? (
			<FiscalActivity client:load />
		) : (
			<FiscalOperations client:load view={view} />
		)
	}
</FiscalWorkspaceLayout>
