---
import TaxFeePage from "@/components/tax-fees/TaxFeePage"
import FiscalWorkspaceLayout from "@/layouts/FiscalWorkspaceLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { getProviderTaxConfiguration } from "@/lib/provider-tax-configuration"
import { routes } from "@/lib/routes"
import { getFiscalWorkspaceResources } from "@/lib/taxes-fees/fiscal-workspace-resources"
import { getJurisdictionTaxRuleSuggestion } from "@/modules/taxes-fees/public"

const auth = await requireProviderSessionSurface(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const create = Astro.url.searchParams.get("create")
const edit = Astro.url.searchParams.get("edit")
const duplicate = Astro.url.searchParams.get("duplicate")
const review = Astro.url.searchParams.get("review") === "1"
const initialSuggestion = getJurisdictionTaxRuleSuggestion(Astro.url.searchParams.get("suggestion"))
const result = Astro.url.searchParams.get("result")
if (result === "tax_profile_saved") {
	return Astro.redirect(`${routes.providerSettingsVerificationFiscal()}?result=${result}`)
}

const cookie = Astro.request.headers.get("cookie") ?? ""
const providerId = typeof auth === "string" ? "" : auth.provider.providerId
const canManageFiscality =
	typeof auth === "string" ? false : auth.provider.permissions.canManageFiscality
const [defsRes, taxConfiguration, initialResources] = await Promise.all([
	fetch(new URL("/api/provider/tax-fees/definitions", Astro.url), { headers: { cookie } }),
	getProviderTaxConfiguration(providerId).catch(() => null),
	getFiscalWorkspaceResources(providerId),
])
const defsBody = defsRes.ok ? await defsRes.json() : null
const initialDefinitions = Array.isArray(defsBody?.definitions) ? defsBody.definitions : []
const initialWarnings = Array.isArray(defsBody?.warnings) ? defsBody.warnings : []
const auditFindings = Array.isArray(defsBody?.audit?.findings) ? defsBody.audit.findings : []
const initialMode = create === "1" || duplicate ? "creating" : edit ? "editing" : "idle"
const definitionCount = initialDefinitions.length
const activeCount = initialDefinitions.filter(
	(item: any) => item.operationalStatus === "active"
).length
const conflictCount = auditFindings.filter(
	(finding: any) => finding.code === "duplicate_active_assignment"
).length
const assignmentCount = initialDefinitions.reduce(
	(total: number, definition: any) =>
		total +
		(definition.assignments?.filter((assignment: any) => assignment.status === "active").length ??
			0),
	0
)
const selectedScopeId = Astro.url.searchParams.get("scope") || null
---

<FiscalWorkspaceLayout
	contentLayout="stacked"
	activeTab="definitions"
	identityLabel={taxConfiguration?.statusLabel ?? "No configurado"}
	isIdentityConfigured={Boolean(taxConfiguration?.isConfigured)}
	identityStatus={taxConfiguration?.status ?? "not_configured"}
	canManageFiscality={canManageFiscality}
	conflictCount={conflictCount}
	primaryLabel="Nueva definición"
	primaryButtonClass="!bg-[#171717] hover:!bg-[#262626] focus:ring-[#171717]"
	primaryHref={`${routes.providerSettingsTaxFees()}?create=1${selectedScopeId ? `&scope=${encodeURIComponent(selectedScopeId)}` : ""}`}
	tabCounts={{ definitions: definitionCount, assignments: assignmentCount }}
>
	<TaxFeePage
		client:load
		initialDefinitions={initialDefinitions}
		initialWarnings={initialWarnings}
		initialMode={initialMode}
		initialDefinitionId={edit}
		initialDuplicateDefinitionId={duplicate}
		initialSuggestion={initialSuggestion}
		initialReview={review}
		initialScopeId={selectedScopeId}
		canManageFiscality={canManageFiscality}
		initialResources={initialResources}
	/>
</FiscalWorkspaceLayout>
