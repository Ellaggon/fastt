---
import FiscalAssignmentsMatrix from "@/components/tax-fees/FiscalAssignmentsMatrix"
import FiscalWorkspaceLayout from "@/layouts/FiscalWorkspaceLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { getAggregateCache } from "@/lib/cache/ssrAggregateCache"
import { getProviderTaxConfiguration } from "@/lib/provider-tax-configuration"
import { db, eq, Product } from "@/shared/infrastructure/db/compat"

const auth = await requireProviderSessionSurface(Astro.request).catch(() => "__DENIED__" as const)
if (auth === "__DENIED__") return Astro.redirect("/SignInPage")
const [configuration, products] = await Promise.all([
	getProviderTaxConfiguration(auth.provider.providerId).catch(() => null),
	db
		.select({ id: Product.id, name: Product.name })
		.from(Product)
		.where(eq(Product.providerId, auth.provider.providerId))
		.catch(() => []),
])
const cachedDefinitions = getAggregateCache<{ audit?: { findings?: Array<{ code?: string }> } }>(
	`fiscal:definitions:${auth.provider.providerId}`
)
const conflictCount = Array.isArray(cachedDefinitions?.audit?.findings)
	? cachedDefinitions.audit.findings.filter(
			(finding) => finding.code === "duplicate_active_assignment"
		).length
	: 0
const selectedDefinitionId = Astro.url.searchParams.get("definitionId")?.trim() || null
const initialTargetScope = Astro.url.searchParams.get("targetScope")?.trim() || null
const initialTargetId = Astro.url.searchParams.get("targetId")?.trim() || null
---

<FiscalWorkspaceLayout
	activeTab="assignments"
	identityLabel={configuration?.statusLabel ?? "No configurada"}
	isIdentityConfigured={Boolean(configuration?.isConfigured)}
	canManageFiscality={auth.provider.permissions.canManageFiscality}
	conflictCount={conflictCount}
	scopeOptions={products.map((product) => ({
		id: String(product.id),
		label: String(product.name || "Producto"),
	}))}
	selectedScopeId={Astro.url.searchParams.get("scope")}
>
	<FiscalAssignmentsMatrix
		client:load
		canManage={auth.provider.permissions.canManageFiscality}
		selectedScopeId={Astro.url.searchParams.get("scope")}
		initialDefinitionId={selectedDefinitionId}
		initialTargetScope={initialTargetScope}
		initialTargetId={initialTargetId}
	/>
</FiscalWorkspaceLayout>
