---
import FiscalSimulator from "@/components/tax-fees/FiscalSimulator"
import FiscalWorkspaceLayout from "@/layouts/FiscalWorkspaceLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { getProviderTaxConfiguration } from "@/lib/provider-tax-configuration"
import { getFiscalSimulationReadiness } from "@/lib/taxes-fees/fiscal-simulation-readiness"
import { getFiscalWorkspaceResources } from "@/lib/taxes-fees/fiscal-workspace-resources"

const auth = await requireProviderSessionSurface(Astro.request).catch(() => "__DENIED__" as const)
if (auth === "__DENIED__") return Astro.redirect("/SignInPage")
const cookie = Astro.request.headers.get("cookie") ?? ""
const [configuration, response, resources] = await Promise.all([
	getProviderTaxConfiguration(auth.provider.providerId).catch(() => null),
	fetch(new URL("/api/provider/tax-fees/definitions", Astro.url), { headers: { cookie } }),
	getFiscalWorkspaceResources(auth.provider.providerId),
])
const body = response.ok ? await response.json() : { definitions: [], audit: { findings: [] } }
const conflicts = Array.isArray(body.audit?.findings)
	? body.audit.findings.filter((finding: any) => finding.code === "duplicate_active_assignment")
			.length
	: 0
const initialDefinitionId = Astro.url.searchParams.get("definitionId")
const requestedScopeId = Astro.url.searchParams.get("scope")
const manualMode = Astro.url.searchParams.get("mode") === "manual"
const initialProductId = resources.products.some((product) => product.id === requestedScopeId)
	? requestedScopeId
	: null
const readiness = initialDefinitionId
	? await getFiscalSimulationReadiness({
			providerId: auth.provider.providerId,
			definitionId: initialDefinitionId,
			resources,
			workspaceProductId: initialProductId,
			manualMode,
		}).catch(() => null)
	: null
const recommendedContext = manualMode ? null : (readiness?.context ?? null)
const requestedReturnTo = Astro.url.searchParams.get("returnTo")
const returnTo = requestedReturnTo?.startsWith("/provider/settings/tax-fees")
	? requestedReturnTo
	: null
---

<FiscalWorkspaceLayout
	activeTab="simulator"
	identityLabel={configuration?.statusLabel ?? "No configurado"}
	isIdentityConfigured={Boolean(configuration?.isConfigured)}
	identityStatus={configuration?.status ?? "not_configured"}
	canManageFiscality={auth.provider.permissions.canManageFiscality}
	conflictCount={conflicts}
>
	<FiscalSimulator
		client:load
		definitions={Array.isArray(body.definitions) ? body.definitions : []}
		resources={resources}
		canManage={auth.provider.permissions.canManageFiscality}
		initialDefinitionId={initialDefinitionId}
		initialProductId={initialProductId}
		recommendedContext={recommendedContext}
		simulationIssues={readiness?.issues ?? []}
		coverageIssues={readiness?.coverageIssues ?? []}
		simulationNotice={readiness?.notice ?? null}
		returnTo={returnTo}
	/>
</FiscalWorkspaceLayout>
