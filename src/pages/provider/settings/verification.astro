---
import ProviderVerificationWorkspace from "@/components/provider/ProviderVerificationWorkspace.astro"
import Button from "@/components/ui/Button.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { safeVerificationReturn } from "@/lib/auth/returnTo"
import { providerDocumentTypes, requiredKycDocumentTypes } from "@/lib/provider-documents"
import { informationRequestPresentation } from "@/lib/provider-information-request-presentation"
import { formatProviderRoleLabel } from "@/lib/provider-permissions"
import {
	buildVerificationPageGuidance,
	buildVerificationPageGuidanceByTab,
	TRUST_GLOSSARY,
} from "@/lib/provider-trust-map"
import { loadProviderVerificationWorkspace } from "@/lib/provider-verification-workspace"
import { routes } from "@/lib/routes"
import { experienceRequirementsHref } from "@/lib/verification/experience-requirements-navigation"
import {
	copyVerificationNavigationQuery,
	tourDocumentWorkspaceHref,
	verificationOperationalSummary,
} from "@/lib/verification/navigation"
import { loadProviderVerificationResolution } from "@/lib/verification/requirement-context"
import { requestedTypeRoutesToPack } from "@/lib/verification/requirement-resolver"
import { listProviderInformationRequests } from "@/modules/casework/public"

const auth = await requireProviderSessionSurface(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const providerId = typeof auth === "string" ? null : auth.provider.providerId
const sessionPermissions = typeof auth === "string" ? null : auth.provider.permissions
const providerRoleLabel =
	typeof auth === "string" ? "Operaciones" : formatProviderRoleLabel(auth.provider.role)

const requestedType = String(Astro.url.searchParams.get("type") ?? "").trim()
const optionalTypeValues = new Set<string>(
	providerDocumentTypes
		.filter((item) => !(requiredKycDocumentTypes as readonly string[]).includes(item.value))
		.map((item) => item.value)
)

if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const loadedResolution = requestedType ? await loadProviderVerificationResolution(providerId) : null
const routesToPack =
	loadedResolution?.enforced && loadedResolution.resolution
		? requestedTypeRoutesToPack(loadedResolution.resolution, requestedType)
		: optionalTypeValues.has(requestedType)
const [model, reviewRequests] = await Promise.all([
	loadProviderVerificationWorkspace({
		providerId,
		sessionPermissions,
		providerRoleLabel,
		url: Astro.url,
		verificationResolution: loadedResolution ?? undefined,
	}),
	typeof auth !== "string"
		? listProviderInformationRequests(providerId, auth.user.id).catch((error) => {
				console.error(
					"verification_requests_unavailable",
					error instanceof Error ? error.name : "unknown"
				)
				return null
			})
		: Promise.resolve(null),
])
const pendingReviewRequests =
	reviewRequests?.filter((item) => informationRequestPresentation(item).canRespond).length ?? null
const legacyExperienceTab =
	Astro.url.searchParams.get("tab") ?? Astro.url.searchParams.get("tourTab")
const businessDocument = (requiredKycDocumentTypes as readonly string[]).includes(
	requestedType.split("::")[0]
)
if (
	model.navigation?.line === "tour" &&
	!businessDocument &&
	(["activity", "safety"].includes(legacyExperienceTab ?? "") ||
		(requestedType &&
			!(requiredKycDocumentTypes as readonly string[]).includes(requestedType.split("::")[0])) ||
		Astro.url.searchParams.has("renewDocumentId"))
) {
	return Astro.redirect(
		Astro.url.searchParams.get("experience") && model.navigation.experienceId
			? experienceRequirementsHref(model.navigation.experienceId, Astro.url)
			: "/catalog/tours?scope=tour"
	)
}
if (requestedType && routesToPack) {
	const tourHref = model.navigation
		? tourDocumentWorkspaceHref({
				url: Astro.url,
				navigation: model.navigation,
				requirements: loadedResolution?.resolution?.requirements ?? [],
			})
		: null
	if (tourHref) {
		if (tourHref !== Astro.url.pathname + Astro.url.search) return Astro.redirect(tourHref)
	} else {
		const target = copyVerificationNavigationQuery(
			new URL(routes.providerSettingsVerificationDocuments(), Astro.url),
			Astro.url
		)
		target.searchParams.set("type", requestedType)
		return Astro.redirect(target.pathname + target.search)
	}
}

const { trustLinks, listaReady, trustMapComplete, nextActionId, activeSectionId } = model
const returnHref = safeVerificationReturn(Astro.url.searchParams.get("returnTo"))
const showWizardProgress = trustLinks.length > 0 || model.tourPlaybook.length > 0
const operationalSummary = verificationOperationalSummary(
	model.navigation?.line === "tour"
		? model.tourPlaybook
		: trustLinks.map((link) => ({
				...link,
				responsible:
					link.uiState === "ready"
						? ("none" as const)
						: link.uiState === "in_review"
							? ("fastt" as const)
							: ("provider" as const),
			}))
)
const pageGuidanceByTab = buildVerificationPageGuidanceByTab({
	trustLinks,
	nextActionId,
	trustMapComplete,
})
const pageGuidance =
	pageGuidanceByTab[activeSectionId as keyof typeof pageGuidanceByTab] ??
	buildVerificationPageGuidance({
		trustLinks,
		nextActionId,
		trustMapComplete,
		activeSectionId: "identity",
	})
---

<ProviderSettingsLayout
	title={model.navigation?.line === "tour"
		? "Verificación del negocio"
		: "Verificación y documentos"}
	eyebrow={TRUST_GLOSSARY.page.eyebrow}
	heading={model.navigation?.line === "tour"
		? "Verificación del negocio"
		: model.navigation?.line === "lodging"
			? "Verificación de alojamientos"
			: TRUST_GLOSSARY.page.heading}
	description={model.navigation?.line === "tour"
		? "Revisa tu identidad, los datos del negocio y su información fiscal."
		: model.navigation?.line === "lodging"
			? "Completa identidad, negocio, fiscalidad y pagos del alojamiento."
			: pageGuidance}
	verificationPageGuidanceByTab={model.screen
		? null
		: showWizardProgress
			? pageGuidanceByTab
			: null}
	showSettingsTabs={false}
	verificationSummary={operationalSummary}
	verificationProgress={model.navigation?.line === "tour"
		? { completed: operationalSummary.completedCount, total: operationalSummary.totalCount }
		: null}
	pendingReviewRequests={pendingReviewRequests}
>
	<div
		class="space-y-6 md:space-y-8"
		data-verification-page
		data-verification-lista={listaReady ? "true" : "false"}
		data-trust-map-complete={trustMapComplete ? "true" : "false"}
	>
		{
			returnHref && (
				<Button href={returnHref} variant="secondary">
					Volver al recorrido anterior
				</Button>
			)
		}
		<ProviderVerificationWorkspace model={model} />
	</div>
</ProviderSettingsLayout>
