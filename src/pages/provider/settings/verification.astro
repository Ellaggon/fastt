---
import ProviderVerificationWorkspace from "@/components/provider/ProviderVerificationWorkspace.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { requireProviderSessionSurface } from "@/lib/auth/requireProvider"
import { providerDocumentTypes, requiredKycDocumentTypes } from "@/lib/provider-documents"
import { formatProviderRoleLabel } from "@/lib/provider-permissions"
import {
	buildVerificationPageGuidance,
	buildVerificationPageGuidanceByTab,
	TRUST_GLOSSARY,
} from "@/lib/provider-trust-map"
import { loadProviderVerificationWorkspace } from "@/lib/provider-verification-workspace"
import { routes } from "@/lib/routes"

const auth = await requireProviderSessionSurface(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const providerId = typeof auth === "string" ? null : auth.provider.providerId
const sessionPermissions = typeof auth === "string" ? null : auth.provider.permissions
const providerRoleLabel =
	typeof auth === "string" ? "Operaciones" : formatProviderRoleLabel(auth.provider.role)

const requestedType = String(Astro.url.searchParams.get("type") ?? "").trim()
const optionalTypeValues = new Set<string>(
	providerDocumentTypes
		.filter((item) => !(requiredKycDocumentTypes as readonly string[]).includes(item.value))
		.map((item) => item.value)
)
// Optionals live on /verification/documents — keep this page to mínimos + wait.
if (requestedType && optionalTypeValues.has(requestedType)) {
	const target = new URL(routes.providerSettingsVerificationDocuments(), Astro.url)
	target.searchParams.set("type", requestedType)
	return Astro.redirect(target.pathname + target.search)
}

if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const model = await loadProviderVerificationWorkspace({
	providerId,
	sessionPermissions,
	providerRoleLabel,
	url: Astro.url,
})
const {
	trustLinks,
	listaReady,
	trustMapComplete,
	readyCount,
	totalCount,
	inReviewCount,
	actionRequiredCount,
	notStartedCount,
	readinessPercent,
	nextActionId,
	activeSectionId,
} = model
const showWizardProgress = trustLinks.length > 0
const pageGuidanceByTab = buildVerificationPageGuidanceByTab({
	trustLinks,
	nextActionId,
	trustMapComplete,
})
const pageGuidance =
	pageGuidanceByTab[activeSectionId] ??
	buildVerificationPageGuidance({
		trustLinks,
		nextActionId,
		trustMapComplete,
		activeSectionId,
	})
---

<ProviderSettingsLayout
	title="Verificación y documentos"
	eyebrow={TRUST_GLOSSARY.page.eyebrow}
	heading={TRUST_GLOSSARY.page.heading}
	description={pageGuidance}
	verificationPageGuidanceByTab={showWizardProgress ? pageGuidanceByTab : null}
	showSettingsTabs={false}
	readyCount={showWizardProgress ? readyCount : null}
	totalCount={showWizardProgress ? totalCount : null}
	inReviewCount={showWizardProgress ? inReviewCount : null}
	actionRequiredCount={showWizardProgress ? actionRequiredCount : null}
	notStartedCount={showWizardProgress ? notStartedCount : null}
	readinessPercent={showWizardProgress ? readinessPercent : null}
>
	<div
		class="space-y-6 md:space-y-8"
		data-verification-page
		data-verification-lista={listaReady ? "true" : "false"}
		data-trust-map-complete={trustMapComplete ? "true" : "false"}
	>
		<ProviderVerificationWorkspace model={model} />
	</div>
</ProviderSettingsLayout>
