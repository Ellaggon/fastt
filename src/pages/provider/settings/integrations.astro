---
import IntegrationEmptyState from "@/components/provider/integrations/IntegrationEmptyState.astro"
import IntegrationNextAction from "@/components/provider/integrations/IntegrationNextAction.astro"
import IntegrationStatusRow from "@/components/provider/integrations/IntegrationStatusRow.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderIntegrationsLayout from "@/layouts/ProviderIntegrationsLayout.astro"
import { requireProvider } from "@/lib/auth/requireProvider"
import { getChannelManagerVendor } from "@/lib/provider-channel-manager-vendors"
import { mapProviderIntegrationError } from "@/lib/provider-integration-errors"
import { getProviderIntegrationsSummaryReadModel } from "@/lib/provider-integration-read-models"
import { routes } from "@/lib/routes"

const legacyMode = Astro.url.searchParams.get("mode")
if (legacyMode === "simple" || legacyMode === "pro") {
	const destination = new URL(
		legacyMode === "pro"
			? routes.providerSettingsIntegrationsCatalog()
			: routes.providerSettingsIntegrations(),
		Astro.url
	)
	Astro.url.searchParams.forEach((value: string, key: string) => {
		if (key !== "mode") destination.searchParams.set(key, value)
	})
	return Astro.redirect(`${destination.pathname}${destination.search}${destination.hash}`, 302)
}

const auth = await requireProvider(Astro.request).catch((error: any) => {
	if (error instanceof Response && error.status === 401) return "__REDIRECT_LOGIN__"
	if (error instanceof Response && error.status === 403) return "__REDIRECT_PROVIDER__"
	throw error
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const readModel = await getProviderIntegrationsSummaryReadModel(auth.providerId)
const channelConnections = readModel.connections.filter(
	(connection) =>
		connection.connectorKey === "channel_manager" &&
		connection.status !== "not_configured" &&
		connection.status !== "revoked"
)
const primaryChannel =
	channelConnections.find((connection) => connection.isPrimary) ?? channelConnections[0] ?? null
const calendarStatus = readModel.calendars.some((calendar) => calendar.status === "error")
	? "error"
	: readModel.calendars.some((calendar) => calendar.status === "pending")
		? "pending"
		: "connected"
const configuredConnectors = [
	...(primaryChannel
		? [
				{
					key: "channel_manager" as const,
					name: "Channel manager",
					status: String(primaryChannel.status),
					lastSyncAt: primaryChannel.lastSyncAt,
					errorMessage: primaryChannel.errorMessage,
					connectionId: primaryChannel.id,
					description:
						primaryChannel.vendorKey && primaryChannel.vendorKey !== "generic"
							? `${getChannelManagerVendor(primaryChannel.vendorKey).name}${primaryChannel.externalPropertyId ? ` · Propiedad ${primaryChannel.externalPropertyId}` : ""}`
							: "Sincroniza disponibilidad, tarifas y restricciones.",
				},
			]
		: []),
	...(readModel.calendars.length
		? [
				{
					key: "external_calendars" as const,
					name: "Calendarios externos",
					status: calendarStatus,
					lastSyncAt:
						readModel.calendars
							.map((calendar) => calendar.lastSyncAt)
							.filter((value): value is Date => value instanceof Date)
							.sort((a, b) => b.getTime() - a.getTime())[0] ?? null,
					errorMessage: null,
					connectionId: null,
					description: `${readModel.calendars.length} ${readModel.calendars.length === 1 ? "calendario activo" : "calendarios activos"}.`,
				},
			]
		: []),
]
const attentionConnectors = configuredConnectors.filter((connector) =>
	["pending", "requires_attention", "error"].includes(connector.status)
)
const healthyConnectors = configuredConnectors.filter(
	(connector) => connector.status === "connected"
)
const nextConnector = attentionConnectors[0] ?? configuredConnectors[0] ?? null

const success = Astro.url.searchParams.get("success")
const error = Astro.url.searchParams.get("error")

const successMessages: Record<string, string> = {
	integration_saved: "La conexión quedó guardada. Ahora valida el acceso antes de activarla.",
	integration_revoked: "La integración fue desconectada.",
	sync_tested: "La prueba terminó correctamente.",
	reference_checked: "La referencia es válida. Todavía falta validar al proveedor.",
}

function connectorAnchor(connector: (typeof configuredConnectors)[number]) {
	if (connector.key === "external_calendars") return routes.ratesCalendarConnections()
	if (connector.connectionId) {
		return routes.providerSettingsIntegrationConnection(connector.connectionId)
	}
	return `${routes.providerSettingsIntegrationsCatalog()}#connector-${connector.key}`
}

function statusLabel(status: string) {
	if (status === "connected") return "Acceso validado"
	if (status === "pending") return "Falta validar"
	if (status === "syncing") return "Actualizando"
	if (status === "requires_attention" || status === "error") return "Requiere atención"
	return "Por configurar"
}

function statusTone(status: string) {
	if (status === "connected") return "success"
	if (status === "pending" || status === "syncing") return "info"
	if (status === "requires_attention") return "warning"
	if (status === "error") return "error"
	return "neutral"
}

function scopeLabel(key: string) {
	if (key === "channel_manager") return "Disponibilidad, tarifas y restricciones"
	return "Bloqueos de calendario"
}

function connectorDescription(connector: (typeof configuredConnectors)[number]) {
	return connector.description
}

function formatActivity(value: Date | null) {
	if (!value) return "Sin pruebas todavía"
	return `Última actividad: ${new Intl.DateTimeFormat("es", {
		dateStyle: "medium",
		timeStyle: "short",
	}).format(value)}`
}

function actionLabel(status: string) {
	if (status === "connected") return "Administrar"
	if (status === "requires_attention" || status === "error") return "Revisar conexión"
	return "Continuar configuración"
}

const nextAction = nextConnector
	? {
			title:
				nextConnector.status === "connected"
					? `${nextConnector.name} tiene acceso validado`
					: `${nextConnector.name} necesita un paso más`,
			description:
				nextConnector.status === "connected"
					? "Puedes revisar qué sincroniza, cuándo se actualizó y administrar la conexión."
					: nextConnector.errorMessage
						? mapProviderIntegrationError(nextConnector.errorMessage)
						: "Completa la validación para confirmar que Fastt puede comunicarse con el servicio.",
			actionLabel: actionLabel(nextConnector.status),
			actionHref: connectorAnchor(nextConnector),
			tone: nextConnector.status === "connected" ? ("success" as const) : ("attention" as const),
		}
	: null
---

<ProviderIntegrationsLayout
	title="Integraciones"
	eyebrow="Distribución · Integraciones"
	heading="Integraciones"
	description="Conecta calendarios o un channel manager para mantener disponibilidad y tarifas actualizadas."
>
	<div slot="actions">
		<Button href={routes.providerSettingsIntegrationsCatalog()}>Conectar servicio</Button>
	</div>

	{
		success && successMessages[success] ? (
			<Notice variant="success" title="Cambio aplicado">
				{successMessages[success]}
			</Notice>
		) : null
	}
	{
		error ? (
			<Notice variant="warning" title="No se pudo completar la acción">
				{mapProviderIntegrationError(error)}
			</Notice>
		) : null
	}

	{nextAction ? <IntegrationNextAction {...nextAction} /> : null}

	<Card>
		<div
			class="flex flex-col gap-3 border-b border-slate-200 pb-4 sm:flex-row sm:items-end sm:justify-between"
		>
			<div>
				<p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
					Estado actual
				</p>
				<h2 class="mt-1.5 text-xl font-semibold text-slate-950">Tus conexiones</h2>
				<p class="mt-1 text-sm leading-6 text-slate-600">
					Revisa qué está funcionando y dónde necesitas actuar.
				</p>
			</div>
			{
				configuredConnectors.length ? (
					<div class="flex flex-wrap gap-2">
						<Badge variant={healthyConnectors.length ? "success" : "neutral"}>
							{healthyConnectors.length} con acceso validado
						</Badge>
						{attentionConnectors.length ? (
							<Badge variant="warning">{attentionConnectors.length} por revisar</Badge>
						) : null}
					</div>
				) : null
			}
		</div>

		{
			configuredConnectors.length ? (
				<div data-integration-status-list>
					{configuredConnectors.map((connector) => (
						<IntegrationStatusRow
							name={connector.name}
							description={connectorDescription(connector)}
							statusLabel={statusLabel(connector.status)}
							statusTone={statusTone(connector.status)}
							scopeLabel={scopeLabel(connector.key)}
							lastActivityLabel={formatActivity(connector.lastSyncAt)}
							actionLabel={actionLabel(connector.status)}
							actionHref={connectorAnchor(connector)}
							kind={
								connector.key === "external_calendars"
									? "external_calendars"
									: connector.key === "channel_manager"
										? "channel_manager"
										: "other"
							}
						/>
					))}
				</div>
			) : (
				<div class="pt-5">
					<IntegrationEmptyState catalogHref={routes.providerSettingsIntegrationsCatalog()} />
				</div>
			)
		}
	</Card>

	<p class="text-sm leading-6 text-slate-400" data-integration-summary-help>
		Fastt no activará una conexión hasta completar una prueba real. Antes de continuar podrás
		revisar qué información controla cada sistema.
	</p>
</ProviderIntegrationsLayout>
