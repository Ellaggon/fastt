												open={false}
												data-connector-scopes
											>
												<summary class="cursor-pointer text-sm font-semibold text-slate-900">
													Permisos ({connector.availableScopes.length})
												</summary>
												<div class="mt-3 grid gap-2">
													{connector.availableScopes.map((scope) => (
														<label class="flex items-center gap-2 text-sm text-slate-700">
															<input
																type="checkbox"
																name="scopes"
																value={scope.key}
																checked={connector.scopes.includes(scope.key)}
																class="fastt-check-input h-4 w-4 rounded border-slate-300"
															/>
															<span>{scope.label}</span>
														</label>
													))}
												</div>
											</details>
										) : null}

										<div class="flex flex-wrap gap-2">
											<Button type="submit" size="sm" variant="secondary">
												Guardar
											</Button>
										</div>
									</div>
								</form>
								{oauthConnectAvailable ? (
									<form
										method="post"
										action={`/api/provider/integrations/${connector.key}/oauth/start`}
										class="mt-3"
									>
										<input type="hidden" name="uiMode" value={modeQuery} />
										<input type="hidden" name="mode" value={connector.mode} />
										{!isSimple
											? connector.scopes.map((scope) => (
													<input type="hidden" name="scopes" value={scope} />
												))
											: null}
										<Button
											type="submit"
											size="sm"
											variant="primary"
											data-connector-oauth-start={connector.key}
										>
											{oauthStatus.mode === "oauth_live"
												? "Conectar con OAuth"
												: "Probar OAuth (scaffold)"}
										</Button>
									</form>
								) : null}
							</Card>

							{!isSimple ? (
								<Card variant="plain" class="p-4">
									<div>
										<p class="text-sm font-semibold text-slate-950">
											Conexiones ({connector.connectionCount})
										</p>
										<div class="mt-3 grid gap-3">
											{connector.instances.length ? (
												connector.instances.map((instance) => (
													<div class="border-b border-slate-200 pb-3 last:border-0 last:pb-0">
														<div class="flex flex-wrap items-start justify-between gap-2">
															<div>
																<p class="text-sm font-semibold text-slate-900">
																	{instance.displayName}
																</p>
																<p class="mt-1 text-xs text-slate-500">
																	{instance.lastSyncAt
																		? `Última prueba ${formatDate(instance.lastSyncAt)}`
																		: "Sin pruebas todavía"}
																</p>
															</div>
															<div class="flex flex-wrap gap-2">
																{instance.isPrimary ? (
																	<Badge variant="neutral">Principal</Badge>
																) : null}
																{connector.key === "channel_manager" ? (
																	<Badge variant="info">{instance.vendorLabel}</Badge>
																) : null}
																{connector.key === "channel_manager" ? (
																	<Badge variant="neutral">
																		{authTypeLabel(instance.authType)}
																	</Badge>
																) : null}
																{instance.hasVaultCredential ? (
																	<Badge variant="success">Vault activo</Badge>
																) : null}
																<Badge variant={instance.tone}>{instance.statusLabel}</Badge>
															</div>
														</div>
														{instance.hasVaultCredential ? (
															<p class="mt-2 text-xs text-slate-500">
																Credencial cifrada
																{instance.tokenExpiresAt
																	? ` · expira ${formatDate(instance.tokenExpiresAt)}`
																	: " · sin expiración publicada"}
															</p>
														) : null}
														{connector.key === "channel_manager" && instance.externalPropertyId ? (
															<p class="mt-2 text-xs text-slate-500">
																Propiedad externa: {instance.externalPropertyId}
															</p>
														) : null}
														<div class="mt-3 flex flex-wrap gap-2">
															{instance.status !== "revoked" ? (
																<form
																	method="post"
																	action={`/api/provider/integrations/${connector.key}/sync`}
																>
																	<input type="hidden" name="uiMode" value={modeQuery} />
																	<input type="hidden" name="connectionId" value={instance.id} />
																	<Button type="submit" size="sm" variant="secondary">
																		Probar
																	</Button>
																</form>
															) : null}
															{!instance.isPrimary && instance.status !== "revoked" ? (
																<form
																	method="post"
																	action={`/api/provider/integrations/operations/connections/${instance.id}/primary`}
																>
																	<Button type="submit" size="sm" variant="ghost">
																		Usar como principal
																	</Button>
																</form>
															) : null}
															{instance.status !== "revoked" ? (
																<details
																	class="fastt-notice rounded-md border border-rose-200 bg-rose-50 p-2"
																	data-disconnect-confirmation
																>
																	<summary class="cursor-pointer text-sm font-semibold text-rose-950">
																		Desconectar
																	</summary>
																	<form
																		method="post"
																		action={`/api/provider/integrations/${connector.key}/revoke`}
																		class="mt-3 grid gap-2"
																	>
																		<input type="hidden" name="uiMode" value={modeQuery} />
																		<input type="hidden" name="connectionId" value={instance.id} />
																		<label class="grid gap-1 text-xs font-semibold text-rose-950">
																			Escribe DESCONECTAR
																			<Input name="confirmDisconnect" autocomplete="off" required />
																		</label>
																		<Button type="submit" size="sm" variant="danger">
																			Confirmar desconexión
																		</Button>
																	</form>
																</details>
															) : null}
														</div>
														{instance.status !== "revoked"
															? (() => {
																	const preset = mappingPresetForConnector(connector.key)
																	const localOptions = mappingOptionsForEntity(
																		preset.localEntityType
																	)
																	const instanceMappings = integrationOperations.mappings.filter(
																		(mapping) => mapping.connectionId === instance.id
																	)
																	return (
																		<details
																			class="fastt-notice mt-3 rounded-lg border border-slate-200 bg-slate-50 p-3"
																			data-integration-mapping-builder
																		>
																			<summary class="cursor-pointer text-sm font-semibold text-slate-900">
																				Mapeos ({instanceMappings.length})
																			</summary>
																			<div class="mt-3 grid gap-4">
																				<p class="text-xs leading-5 text-slate-600">
																					{preset.helper} Usa OAuth/API cuando el proveedor entregue
																					catálogo remoto; mientras tanto pega el ID externo exacto.
																				</p>
																				<form
																					method="post"
																					action="/api/provider/integrations/operations/mappings"
																					class="fastt-notice grid gap-3 rounded-md border border-white bg-white p-3"
																					data-integration-mapping-form
																				>
																					<input
																						type="hidden"
																						name="connectionId"
																						value={instance.id}
																					/>
																					<input
																						type="hidden"
																						name="mappingType"
																						value={preset.mappingType}
																					/>
																					<input
																						type="hidden"
																						name="localEntityType"
																						value={preset.localEntityType}
																					/>
																					<input
																						type="hidden"
																						name="externalEntityType"
																						value={preset.externalEntityType}
																					/>
																					<input
																						type="hidden"
																						name="direction"
																						value={preset.direction}
																					/>
																					<div>
																						<p class="text-sm font-semibold text-slate-950">
																							{preset.title}
																						</p>
																						<p class="mt-1 text-xs text-slate-500">
																							Local: {mappingTypeLabel(preset.mappingType)} ·{" "}
																							{directionLabel(preset.direction)}
																						</p>
																					</div>
																					<label class="grid gap-2 text-sm font-semibold text-slate-900">
																						Entidad local
																						<Select name="localEntityId" required>
																							<option value="">
																								{localOptions.length
																									? "Selecciona en Fastt"
																									: "No hay entidades locales disponibles"}
																							</option>
																							{localOptions.map((option) => (
																								<option value={option.id}>{option.label}</option>
																							))}
																						</Select>
																					</label>
																					<label class="grid gap-2 text-sm font-semibold text-slate-900">
																						ID externo
																						<Input
																							name="externalEntityId"
																							placeholder="Ej. remote-room-123"
																							required
																						/>
																					</label>
																					<label class="grid gap-2 text-sm font-semibold text-slate-900">
																						Nombre externo
																						<Input
																							name="externalEntityName"
																							placeholder="Ej. Deluxe King en el channel manager"
																						/>
																					</label>
																					<Button
																						type="submit"
																						size="sm"
																						variant="secondary"
																						disabled={!localOptions.length}
																					>
																						Guardar mapeo
																					</Button>
																				</form>
																				<div class="grid gap-2">
																					{instanceMappings.length ? (
																						instanceMappings.map((mapping) => (
																							<div class="fastt-notice flex flex-col gap-2 rounded-md border border-slate-200 bg-white p-3 md:flex-row md:items-center md:justify-between">
																								<div class="min-w-0">
																									<div class="flex flex-wrap gap-2">
																										<Badge variant="neutral">
																											{mappingTypeLabel(
																												String(mapping.mappingType)
																											)}
																										</Badge>
																										<Badge
																											variant={
																												mapping.status === "active"
																													? "success"
																													: "neutral"
																											}
																										>
																											{mapping.status === "active"
																												? "Activo"
																												: "Inactivo"}
																										</Badge>
																									</div>
																									<p class="mt-2 truncate text-sm font-semibold text-slate-950">
																										{mapping.localEntityType}:
																										{mapping.localEntityId}
																									</p>
																									<p class="mt-1 truncate text-xs text-slate-500">
																										{mapping.externalEntityName ||
																											mapping.externalEntityId}{" "}
																										· {directionLabel(String(mapping.direction))}
																									</p>
																								</div>
																								<form
																									method="post"
																									action="/api/provider/integrations/operations/mappings"
																								>
																									<input
																										type="hidden"
																										name="action"
																										value="remove"
																									/>
																									<input
																										type="hidden"
																										name="connectionId"
																										value={instance.id}
																									/>
																									<input
																										type="hidden"
																										name="mappingId"
																										value={mapping.id}
																									/>
																									<Button type="submit" size="sm" variant="ghost">
																										Quitar
																									</Button>
																								</form>
																							</div>
																						))
																					) : (
																						<p class="text-xs leading-5 text-slate-500">
																							Sin mapeos todavía. Crea el primero después de guardar
																							y probar la conexión.
																						</p>
																					)}
																				</div>
																			</div>
																		</details>
																	)
																})()
															: null}
													</div>
												))
											) : (
												<p class="text-sm text-slate-500">Sin conexiones guardadas.</p>
											)}
										</div>
										<details class="mt-4 border-t border-slate-200 pt-4" data-add-connection>
											<summary class="cursor-pointer text-sm font-semibold text-slate-900">
												Agregar otra conexión
											</summary>
											<form
												method="post"
												action={`/api/provider/integrations/${connector.key}/connect`}
												class="mt-3 grid gap-3"
											>
												<input type="hidden" name="uiMode" value={modeQuery} />
												<input type="hidden" name="createNew" value="true" />
												<input type="hidden" name="mode" value={connector.mode} />
												{connector.scopes.map((scope) => (
													<input type="hidden" name="scopes" value={scope} />
												))}
												{connector.key === "channel_manager" ? (
													<label class="grid gap-2 text-sm font-semibold text-slate-900">
														Proveedor
														<Select name="vendorKey">
															{channelManagerVendors.map((vendor) => (
																<option value={vendor.key}>{vendor.name}</option>
															))}
														</Select>
													</label>
												) : null}
												{connector.key === "channel_manager" ? (
													<label class="grid gap-2 text-sm font-semibold text-slate-900">
														Autenticación
														<Select name="authType">
															<option value="api_key">API key</option>
															<option value="oauth2">OAuth 2.0</option>
															<option value="reference">Referencia / manual</option>
														</Select>
													</label>
												) : null}
												{connector.key === "channel_manager" ? (
													<label class="grid gap-2 text-sm font-semibold text-slate-900">
														ID de propiedad externo
														<Input
															name="externalPropertyId"
															placeholder="Cloudbeds property ID o Channex property UUID"
														/>
													</label>
												) : null}
												<label class="grid gap-2 text-sm font-semibold text-slate-900">
													Nombre
													<Input name="displayName" placeholder="Ej. Segunda propiedad" required />
												</label>
												<label class="grid gap-2 text-sm font-semibold text-slate-900">
													Referencia de acceso
													<Input
														name="credentialsRef"
														placeholder={
															connector.key === "channel_manager"
																? "API key, OAuth o referencia segura"
																: "https://… o referencia segura"
														}
														required
													/>
												</label>
												<Button type="submit" size="sm" variant="secondary">
													Agregar conexión
												</Button>
											</form>
										</details>
									</div>
									<div class="mt-5 border-t border-slate-200 pt-4">
										<p class="text-sm font-semibold text-slate-950">Requisitos</p>
										<ul class="mt-3 grid gap-2 text-sm text-slate-600">
											{connector.requirements.map((requirement) => (
												<li>{requirement}</li>
											))}
										</ul>
										<div class="mt-4 border-t border-slate-200 pt-4">
											<p class="text-sm font-semibold text-slate-950">Actividad reciente</p>
											<div class="mt-3 grid gap-2">
												{connector.logs.length ? (
													connector.logs.map((log) => (
														<Card variant="soft" class="p-3">
															<div class="flex items-center justify-between gap-3">
																<p class="text-xs font-semibold tracking-[0.1em] text-slate-500 uppercase">
																	{log.eventType}
																</p>
																<Badge variant={log.status === "error" ? "error" : "neutral"}>
																	{log.status === "error"
																		? "Error"
																		: log.status === "success"
																			? "Ok"
																			: log.status}
																</Badge>
															</div>
															<p class="mt-2 text-sm text-slate-700">
																{mapProviderIntegrationLogMessage(log.message)}
															</p>
															<p class="mt-1 text-xs text-slate-500">{formatDate(log.createdAt)}</p>
														</Card>
													))
												) : (
													<p class="text-sm text-slate-500">Sin eventos registrados.</p>
												)}
											</div>
										</div>
									</div>
								</Card>
							) : (
								<ul class="grid gap-1 text-sm text-slate-600">
									{connector.requirements.slice(0, 2).map((requirement) => (
										<li>· {requirement}</li>
									))}
								</ul>
							)}
						</div>

						{isSimple && (canTest(connector) || canRevoke(connector)) ? (
							<div class="flex flex-wrap justify-end gap-2 border-t border-slate-200 pt-4">
								{canTest(connector) ? (
									<form method="post" action={`/api/provider/integrations/${connector.key}/sync`}>
										<input type="hidden" name="uiMode" value={modeQuery} />
										{connector.connectionId ? (
											<input type="hidden" name="connectionId" value={connector.connectionId} />
										) : null}
										<Button type="submit" size="sm">
											Probar conexión
										</Button>
									</form>
								) : null}
								{canRevoke(connector) ? (
									<details
										class="fastt-notice rounded-md border border-rose-200 bg-rose-50 p-2"
										data-disconnect-confirmation
									>
										<summary class="cursor-pointer text-sm font-semibold text-rose-950">
											Desconectar
										</summary>
										<form
											method="post"
											action={`/api/provider/integrations/${connector.key}/revoke`}
											class="mt-3 grid gap-2"
										>
											<input type="hidden" name="uiMode" value={modeQuery} />
											{connector.connectionId ? (
												<input type="hidden" name="connectionId" value={connector.connectionId} />
											) : null}
											<label class="grid gap-1 text-xs font-semibold text-rose-950">
												Escribe DESCONECTAR
												<Input name="confirmDisconnect" autocomplete="off" required />
											</label>
											<Button type="submit" variant="danger" size="sm">
												Confirmar desconexión
											</Button>
										</form>
									</details>
								) : null}
							</div>
						) : null}
					</div>
				</Card>
			))
		}
	</div>

	{
		isSimple ? (
			<p class="text-sm text-slate-600">
				¿Necesitas calendarios, webhooks o exportación contable?{" "}
				<a
					class="font-semibold text-slate-900 underline"
					href={`${routes.providerSettingsIntegrations()}?mode=pro`}
				>
					Abrir modo Pro
				</a>
			</p>
		) : null
	}
</ProviderSettingsLayout>
