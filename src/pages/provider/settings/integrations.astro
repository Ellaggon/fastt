---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Input from "@/components/ui/Input.astro"
import Notice from "@/components/ui/Notice.astro"
import Select from "@/components/ui/Select.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { requireProvider } from "@/lib/auth/requireProvider"
import { listChannelManagerVendors } from "@/lib/provider-channel-manager-vendors"
import { getConnectorOAuthStatus } from "@/lib/provider-connector-oauth"
import {
	listProviderExternalCalendars,
	mapExternalCalendarError,
} from "@/lib/provider-external-calendars"
import {
	mapProviderIntegrationError,
	mapProviderIntegrationLogMessage,
} from "@/lib/provider-integration-errors"
import {
	listProviderIntegrationMappingCatalog,
	listProviderIntegrationOperations,
} from "@/lib/provider-integration-operations"
import {
	isRecommendedProviderConnector,
	listProviderIntegrations,
	type ProviderIntegrationCard,
} from "@/lib/provider-integrations"
import { routes } from "@/lib/routes"
import { CalendarDays, Plus, RefreshCw, Trash2, TriangleAlert } from "@lucide/astro"

const auth = await requireProvider(Astro.request).catch((e: any) => {
	if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
	if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
	throw e
})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const url = new URL(Astro.request.url)
const success = url.searchParams.get("success")
const error = url.searchParams.get("error")
const oauth = url.searchParams.get("oauth")
const oauthReason = url.searchParams.get("reason")
const icalResult = url.searchParams.get("ical")
const icalReason = url.searchParams.get("reason")
const icalExportUrl = url.searchParams.get("exportUrl")
const operationResult = url.searchParams.get("operation")
const uiMode = url.searchParams.get("mode") === "pro" ? "pro" : "simple"
const isSimple = uiMode === "simple"
const modeQuery = isSimple ? "simple" : "pro"
const oauthStatus = getConnectorOAuthStatus()
const oauthConnectAvailable =
	oauthStatus.mode === "oauth_scaffold" || oauthStatus.mode === "oauth_live"
const channelManagerVendors = listChannelManagerVendors()

const connectors = await listProviderIntegrations({
	providerId: auth.providerId,
	currentUserId: auth.user.id,
})

const recommended = connectors.filter((connector) => isRecommendedProviderConnector(connector.key))
const others = connectors.filter((connector) => !isRecommendedProviderConnector(connector.key))
const visibleConnectors = isSimple ? recommended : connectors
const displayConnectors = visibleConnectors.filter(
	(connector) => connector.key !== "external_calendars"
)
const externalCalendarData = isSimple
	? { calendars: [], variants: [], exports: [] }
	: await listProviderExternalCalendars(auth.providerId)
const integrationOperations = isSimple
	? { connections: [], mappings: [], runs: [], jobs: [], incidents: [] }
	: await listProviderIntegrationOperations(auth.providerId)
const mappingCatalog = isSimple
	? { products: [], variants: [], ratePlans: [], taxes: [] }
	: await listProviderIntegrationMappingCatalog(auth.providerId)
const openIntegrationIncidents = integrationOperations.incidents.filter(
	(incident) => incident.status === "open"
)
const recentIntegrationRuns = integrationOperations.runs.slice(0, 6)
const recentIntegrationJobs = integrationOperations.jobs.slice(0, 6)

const configuredConnectors = connectors.filter((connector) =>
	Boolean(connector.credentialsRef && connector.status !== "revoked")
)
const validatedConnectors = connectors.filter((connector) => connector.status === "connected")
const attentionConnectors = connectors.filter((connector) =>
	["pending", "requires_attention", "error"].includes(connector.status)
)
const lastValidatedAt = validatedConnectors
	.map((connector) => connector.lastSyncAt)
	.filter(Boolean)
	.sort((a, b) => Number(b) - Number(a))[0]
const featuredConnector = recommended[0]
const integrationSummaryText = isSimple
	? featuredConnector
		? `${featuredConnector.name}: ${featuredConnector.statusLabel.toLowerCase()}.`
		: "No hay conectores recomendados para configurar."
	: configuredConnectors.length
		? `${configuredConnectors.length} conector${configuredConnectors.length === 1 ? "" : "es"} con referencia guardada.`
		: "Aún no hay conectores con referencia guardada."
const integrationSummaryDetail = validatedConnectors.length
	? `${validatedConnectors.length} validado${validatedConnectors.length === 1 ? "" : "s"} por prueba real. Última validación: ${formatDate(lastValidatedAt ?? null)}.`
	: "Ningún conector está validado por una prueba real todavía."

const successMessages: Record<string, string> = {
	integration_saved:
		"Referencia guardada. Ejecuta “Probar conexión” para validarla antes de usarla.",
	integration_revoked: "Acceso revocado. El conector ya no puede sincronizar.",
	sync_tested: "Prueba de conexión correcta. El conector quedó validado.",
	reference_checked:
		"Referencia válida. Falta una prueba real del proveedor antes de tratarla como conexión activa.",
}

const oauthMessages: Record<
	string,
	{ variant: "success" | "info" | "warning"; title: string; body: string }
> = {
	connected: {
		variant: "success",
		title: "OAuth completado",
		body: "Autorización guardada. Ejecuta “Probar conexión” para validar el conector.",
	},
	scaffold: {
		variant: "info",
		title: "OAuth en modo preparación",
		body: "El callback respondió, pero el exchange de tokens aún no está activo en este entorno (falta LIVE + TOKEN_URL).",
	},
	denied: {
		variant: "warning",
		title: "Autorización cancelada",
		body: oauthReason
			? `El proveedor rechazó o canceló el acceso (${oauthReason}).`
			: "El proveedor rechazó o canceló el acceso.",
	},
	not_configured: {
		variant: "warning",
		title: "OAuth no configurado",
		body: "Este entorno no tiene OAuth listo. Usa el enlace o referencia manual.",
	},
	missing_code: {
		variant: "warning",
		title: "Respuesta OAuth incompleta",
		body: "Faltó el código de autorización. Vuelve a intentar “Conectar con OAuth”.",
	},
	invalid_state: {
		variant: "warning",
		title: "Sesión OAuth inválida",
		body: "El state expiró o no es válido. Vuelve a iniciar “Conectar con OAuth”.",
	},
	actor_mismatch: {
		variant: "warning",
		title: "Sesión distinta",
		body: "La autorización no coincide con el usuario actual. Inicia sesión de nuevo.",
	},
	token_failed: {
		variant: "warning",
		title: "No se pudo canjear el token",
		body: oauthReason
			? `El exchange OAuth falló (${oauthReason}).`
			: "El exchange OAuth falló. Revisa la configuración del vendor.",
	},
	persist_failed: {
		variant: "warning",
		title: "No se pudo guardar la conexión",
		body: "La autorización llegó, pero no pudimos persistir el conector. Inténtalo de nuevo.",
	},
	permission_denied: {
		variant: "warning",
		title: "Sin permiso para integrar",
		body: "Tu rol no tiene permiso para administrar integraciones de este proveedor.",
	},
}

function formatDate(value: Date | null) {
	if (!value) return "Sin actividad"
	return new Intl.DateTimeFormat("es", {
		dateStyle: "medium",
		timeStyle: "short",
	}).format(value)
}

function canTest(connector: ProviderIntegrationCard) {
	return (
		Boolean(connector.credentialsRef) &&
		connector.status !== "revoked" &&
		connector.status !== "syncing"
	)
}

function canRevoke(connector: ProviderIntegrationCard) {
	return Boolean(connector.credentialsRef) && connector.status !== "revoked"
}

function externalCalendarStatusLabel(status: string) {
	if (status === "active") return "Actualizado"
	if (status === "error") return "Requiere atención"
	if (status === "revoked") return "Desconectado"
	return "Pendiente"
}

function externalCalendarStatusTone(status: string) {
	if (status === "active") return "success"
	if (status === "error") return "error"
	if (status === "revoked") return "warning"
	return "info"
}

const activeExternalCalendars = externalCalendarData.calendars.filter(
	(calendar) => calendar.status !== "revoked"
)
const externalConflictCount = activeExternalCalendars.reduce(
	(total, calendar) => total + calendar.conflicts.length,
	0
)
const activeExternalCalendarsLabel = `${activeExternalCalendars.length} ${
	activeExternalCalendars.length === 1 ? "activo" : "activos"
}`
const externalConflictLabel = `${externalConflictCount} ${
	externalConflictCount === 1 ? "posible conflicto" : "posibles conflictos"
}`

function authTypeLabel(authType: string) {
	if (authType === "api_key") return "API key"
	if (authType === "oauth2") return "OAuth 2.0"
	return "Referencia"
}

function runStatusLabel(status: string) {
	if (status === "succeeded") return "Completada"
	if (status === "partial") return "Parcial"
	if (status === "failed") return "Fallida"
	if (status === "cancelled") return "Cancelada"
	return "En curso"
}

function runStatusTone(status: string) {
	if (status === "succeeded") return "success"
	if (status === "failed") return "error"
	if (status === "partial") return "warning"
	return "info"
}

function jobStatusLabel(status: string) {
	if (status === "succeeded") return "Completado"
	if (status === "failed") return "Fallido"
	if (status === "running") return "En ejecución"
	return "En cola"
}

function incidentTone(severity: string) {
	if (severity === "critical" || severity === "error") return "error"
	if (severity === "warning") return "warning"
	return "info"
}

function incidentNotificationLabel(status: string) {
	if (status === "sent") return "Aviso enviado"
	if (status === "partial") return "Aviso parcial"
	if (status === "failed") return "Aviso falló"
	if (status === "not_configured") return "Aviso no configurado"
	if (status === "skipped") return "Aviso omitido"
	return "Aviso pendiente"
}

function incidentNotificationTone(status: string) {
	if (status === "sent") return "success"
	if (status === "partial") return "warning"
	if (status === "failed") return "error"
	if (status === "not_configured" || status === "skipped") return "neutral"
	return "info"
}

function mappingPresetForConnector(connectorKey: string) {
	if (connectorKey === "channel_manager") {
		return {
			mappingType: "room_type",
			localEntityType: "variant",
			externalEntityType: "room_type",
			direction: "bidirectional",
			title: "Mapear habitación",
			helper:
				"Relaciona una habitación/tipo de cuarto de Fastt con el ID que usa el channel manager.",
		}
	}
	if (connectorKey === "accounting_export") {
		return {
			mappingType: "tax",
			localEntityType: "tax",
			externalEntityType: "tax",
			direction: "export",
			title: "Mapear impuesto",
			helper: "Relaciona un impuesto de Fastt con su cuenta, código o concepto contable externo.",
		}
	}
	if (connectorKey === "webhooks_api") {
		return {
			mappingType: "property",
			localEntityType: "product",
			externalEntityType: "property",
			direction: "bidirectional",
			title: "Mapear propiedad",
			helper: "Relaciona un producto de Fastt con la entidad principal del sistema externo.",
		}
	}
	return {
		mappingType: "property",
		localEntityType: "product",
		externalEntityType: "property",
		direction: "bidirectional",
		title: "Mapear entidad",
		helper: "Relaciona una entidad local de Fastt con su ID externo.",
	}
}

function mappingOptionsForEntity(entityType: string) {
	if (entityType === "variant") return mappingCatalog.variants
	if (entityType === "rate_plan") return mappingCatalog.ratePlans
	if (entityType === "tax") return mappingCatalog.taxes
	return mappingCatalog.products
}

function mappingTypeLabel(mappingType: string) {
	if (mappingType === "room_type") return "Habitación"
	if (mappingType === "rate_plan") return "Plan tarifario"
	if (mappingType === "tax") return "Impuesto"
	if (mappingType === "account") return "Cuenta"
	if (mappingType === "calendar") return "Calendario"
	return "Propiedad"
}

function directionLabel(direction: string) {
	if (direction === "import") return "Importa"
	if (direction === "export") return "Exporta"
	return "Bidireccional"
}

function conflictStatusLabel(status: string) {
	if (status === "accepted") return "Aceptado"
	if (status === "ignored") return "Ignorado"
	if (status === "resolved") return "Resuelto"
	return "Abierto"
}

function conflictStatusTone(status: string) {
	if (status === "accepted") return "success"
	if (status === "ignored") return "neutral"
	if (status === "resolved") return "success"
	return "warning"
}
---

<ProviderSettingsLayout
	title="Integraciones"
	eyebrow="Configuración del proveedor · Conectividad"
	heading="Integraciones"
	description={isSimple
		? "Empieza por el conector recomendado. Guarda la referencia y prueba la conexión antes de usarla."
		: "Catálogo completo: modos, permisos y actividad. Guarda la conexión y pruébala antes de producción."}
>
	<div slot="actions" class="flex flex-wrap gap-2">
		<Button
			href={`${routes.providerSettingsIntegrations()}?mode=simple`}
			variant={isSimple ? "primary" : "secondary"}
			size="sm"
		>
			Simple
		</Button>
		<Button
			href={`${routes.providerSettingsIntegrations()}?mode=pro`}
			variant={!isSimple ? "primary" : "secondary"}
			size="sm"
		>
			Pro
		</Button>
		<Button href={routes.providerSettingsVerification()} variant="secondary" size="sm">
			Verificación
		</Button>
	</div>

	{
		success && successMessages[success] ? (
			<Notice variant="success" title="Cambio aplicado">
				{successMessages[success]}
			</Notice>
		) : null
	}
	{
		oauth && oauthMessages[oauth] ? (
			<Notice
				variant={oauthMessages[oauth].variant}
				title={oauthMessages[oauth].title}
				data-oauth-flash={oauth}
			>
				{oauthMessages[oauth].body}
			</Notice>
		) : null
	}
	{
		error ? (
			<Notice variant="warning" title="No se pudo completar la acción">
				{mapProviderIntegrationError(error)}
			</Notice>
		) : null
	}
	{
		icalResult === "added" ? (
			<Notice variant="success" title="Calendario agregado">
				El feed se importó y sus bloqueos ya forman parte de la disponibilidad.
			</Notice>
		) : icalResult === "queued" ? (
			<Notice variant="info" title="Actualización encolada">
				El trabajo quedó en cola. Fastt lo procesará con reintentos si el origen tarda o falla.
			</Notice>
		) : icalResult === "synced" ? (
			<Notice variant="success" title="Calendarios actualizados">
				Se actualizaron {url.searchParams.get("updated") ?? "1"} calendario(s).
			</Notice>
		) : icalResult === "partial" ? (
			<Notice variant="warning" title="Actualización parcial">
				Se actualizaron {url.searchParams.get("updated") ?? "0"} y fallaron{" "}
				{url.searchParams.get("failed") ?? "0"}. Revisa cada calendario.
			</Notice>
		) : icalResult === "revoked" ? (
			<Notice variant="success" title="Calendario desconectado">
				Sus bloqueos dejaron de afectar la disponibilidad.
			</Notice>
		) : icalResult === "conflict_updated" ? (
			<Notice variant="success" title="Conflicto actualizado">
				La decisión quedó guardada. Si el choque sigue presente, volverá a abrirse.
			</Notice>
		) : icalResult === "export_created" ? (
			<Notice variant="success" title="Enlace de exportación creado">
				Guarda este enlace en el canal externo. Por seguridad, Fastt solo lo muestra completo al
				crearlo.
				{icalExportUrl ? (
					<div class="fastt-notice mt-3 rounded-md border border-emerald-200 bg-white p-3 font-mono text-xs break-all text-slate-800">
						{icalExportUrl}
					</div>
				) : null}
			</Notice>
		) : icalResult === "export_revoked" ? (
			<Notice variant="success" title="Exportación revocada">
				El enlace dejó de entregar calendarios.
			</Notice>
		) : icalResult === "error" ? (
			<Notice variant="warning" title="No se pudo actualizar el calendario">
				{mapExternalCalendarError(icalReason)}
			</Notice>
		) : null
	}
	{
		operationResult === "mapping_saved" ? (
			<Notice variant="success" title="Mapeo guardado">
				La relación quedó disponible para las próximas sincronizaciones.
			</Notice>
		) : operationResult === "mapping_removed" ? (
			<Notice variant="success" title="Mapeo eliminado">
				La entidad externa dejó de estar vinculada.
			</Notice>
		) : operationResult === "incident_resolved" ? (
			<Notice variant="success" title="Incidencia resuelta">
				La incidencia quedó cerrada. Volverá a abrirse si el problema reaparece.
			</Notice>
		) : operationResult === "primary_changed" ? (
			<Notice variant="success" title="Conexión principal actualizada">
				Las acciones generales usarán esta conexión por defecto.
			</Notice>
		) : operationResult === "error" ? (
			<Notice variant="warning" title="No se pudo completar la acción">
				{mapProviderIntegrationError(url.searchParams.get("reason"))}
			</Notice>
		) : null
	}

	{
		oauthConnectAvailable ? (
			<p class="text-xs text-slate-500" data-connector-oauth-status={oauthStatus.mode}>
				{oauthStatus.hostLabel}
			</p>
		) : null
	}
	<Notice variant="info" title="Seguridad de acceso" data-integration-security-vault>
		Las credenciales OAuth se guardan cifradas, con expiración y renovación controlada. Al
		desconectar una integración, Fastt exige confirmación y deja auditoría del cambio.
	</Notice>

	<Card variant="soft" class="bg-white" data-integrations-honest-summary>
		<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
			<div>
				<p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
					Estado de conexión
				</p>
				<p class="mt-2 text-lg font-semibold text-slate-950">{integrationSummaryText}</p>
				<p class="mt-1 text-sm leading-6 text-slate-600">{integrationSummaryDetail}</p>
			</div>
			{
				attentionConnectors.length ? (
					<Badge variant="warning">{attentionConnectors.length} por revisar</Badge>
				) : (
					<Badge variant={validatedConnectors.length ? "success" : "neutral"}>
						{validatedConnectors.length ? "Con prueba válida" : "Sin prueba"}
					</Badge>
				)
			}
		</div>
	</Card>

	{
		!isSimple ? (
			<Card data-integration-operations>
				<div class="flex flex-col gap-5">
					<div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
						<div>
							<p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
								Operación
							</p>
							<h2 class="mt-2 text-xl font-semibold text-slate-950">
								Sincronizaciones e incidencias
							</h2>
							<p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
								Cada ejecución conserva su resultado. Los problemas repetidos se agrupan en una sola
								incidencia hasta que se resuelven.
							</p>
						</div>
						<div class="flex flex-wrap gap-2">
							<Badge variant={openIntegrationIncidents.length ? "warning" : "success"}>
								{openIntegrationIncidents.length} abiertas
							</Badge>
							<Badge variant="neutral">{integrationOperations.mappings.length} mapeos</Badge>
							<Badge variant="neutral">{integrationOperations.connections.length} conexiones</Badge>
						</div>
					</div>

					{openIntegrationIncidents.length ? (
						<div class="divide-y divide-slate-200 border-y border-slate-200">
							{openIntegrationIncidents.slice(0, 5).map((incident) => (
								<div class="flex flex-col gap-3 py-4 md:flex-row md:items-center md:justify-between">
									<div class="min-w-0">
										<div class="flex flex-wrap items-center gap-2">
											<Badge variant={incidentTone(String(incident.severity))}>
												{incident.severity === "critical"
													? "Crítica"
													: incident.severity === "error"
														? "Error"
														: incident.severity === "warning"
															? "Atención"
															: "Información"}
											</Badge>
											<Badge
												variant={incidentNotificationTone(String(incident.notificationStatus))}
											>
												{incidentNotificationLabel(String(incident.notificationStatus))}
											</Badge>
											<p class="font-semibold text-slate-950">{incident.title}</p>
										</div>
										<p class="mt-1 text-sm leading-6 text-slate-600">{incident.description}</p>
										<p class="mt-1 text-xs text-slate-500">
											Detectada {incident.occurrenceCount}{" "}
											{Number(incident.occurrenceCount) === 1 ? "vez" : "veces"} · última{" "}
											{formatDate(incident.lastSeenAt)}
											{incident.notifiedAt ? ` · aviso ${formatDate(incident.notifiedAt)}` : ""}
										</p>
										{incident.notificationError ? (
											<p class="mt-1 text-xs text-rose-700">{incident.notificationError}</p>
										) : null}
									</div>
									<div class="flex shrink-0 flex-wrap gap-2">
										{incident.actionHref && incident.actionLabel ? (
											<Button href={incident.actionHref} size="sm" variant="secondary">
												{incident.actionLabel}
											</Button>
										) : null}
										<form
											method="post"
											action={`/api/provider/integrations/operations/incidents/${incident.id}/resolve`}
										>
											<Button type="submit" size="sm" variant="ghost">
												Marcar resuelta
											</Button>
										</form>
									</div>
								</div>
							))}
						</div>
					) : (
						<p class="border-y border-slate-200 py-4 text-sm text-slate-600">
							No hay incidencias abiertas.
						</p>
					)}

					<details>
						<summary class="cursor-pointer text-sm font-semibold text-slate-950">
							Ver ejecuciones recientes ({recentIntegrationRuns.length})
						</summary>
						<div class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
							{recentIntegrationRuns.length ? (
								recentIntegrationRuns.map((run) => (
									<div class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
										<div>
											<p class="text-sm font-semibold text-slate-900">{run.operation}</p>
											<p class="mt-1 text-xs text-slate-500">
												{formatDate(run.startedAt)} · {run.trigger}
											</p>
										</div>
										<div class="flex flex-wrap items-center gap-2">
											<span class="text-xs text-slate-600">
												{run.readCount} leídos · {run.changedCount} cambios · {run.failedCount}{" "}
												fallos
											</span>
											<Badge variant={runStatusTone(String(run.status))}>
												{runStatusLabel(String(run.status))}
											</Badge>
										</div>
									</div>
								))
							) : (
								<p class="py-4 text-sm text-slate-600">Todavía no hay ejecuciones.</p>
							)}
						</div>
					</details>

