---
import ProviderProfileForm from "@/components/provider/ProviderProfileForm.astro"
import ProviderRegisterForm from "@/components/provider/ProviderRegisterForm.astro"
import ProviderSettingsHubCard from "@/components/provider/ProviderSettingsHubCard.astro"
import ProviderSettingsIdentityReadonly from "@/components/provider/ProviderSettingsIdentityReadonly.astro"
import ProviderSettingsOpsReadonly from "@/components/provider/ProviderSettingsOpsReadonly.astro"
import Button from "@/components/ui/Button.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { PROVIDER_FORM_FLASH_COOKIE, readProviderFormFlash } from "@/lib/provider-form-flash"
import { isHolderStorageAvailable, readProviderHolderProfile } from "@/lib/provider-holder-profile"
import { routes } from "@/lib/routes"
import { getProviderFullAggregate } from "@/modules/catalog/public"
import { PencilLine } from "@lucide/astro"

const user = await getUserFromRequest(Astro.request)
if (!user?.id) return Astro.redirect("/SignInPage")
if (Astro.url.searchParams.get("error") === "invalid_method")
	return Astro.redirect(routes.providerOnboardingStart())

const providerId = await getProviderIdFromRequest(Astro.request, user)
if (!providerId) return Astro.redirect(routes.providerOnboardingStart())
const aggregate = providerId ? await getProviderFullAggregate(providerId, user.id) : null
const provider = aggregate?.provider ?? null
const holderProfile = providerId ? await readProviderHolderProfile(providerId) : null
const holderStorageReady = await isHolderStorageAvailable()
const profile = aggregate?.profile ?? null
const hasProvider = Boolean(provider?.id)

const success = String(Astro.url.searchParams.get("success") ?? "").trim()
const error = String(Astro.url.searchParams.get("error") ?? "").trim()
const identityFlash =
	readProviderFormFlash(Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value, "settings") ??
	readProviderFormFlash(Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value, "identity")
const profileFlash =
	readProviderFormFlash(Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value, "settings") ??
	readProviderFormFlash(Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value, "profile")
if (identityFlash || profileFlash)
	Astro.cookies.delete(PROVIDER_FORM_FLASH_COOKIE, { path: "/provider" })

const successNotice =
	success === "identity_saved" || success === "ops_saved" || success === "saved"
		? {
				title: "Perfil guardado",
				body: "Identidad comercial y datos operativos quedaron actualizados con este guardado.",
			}
		: null

const errorNotice =
	error === "validation_error"
		? {
				title: "Revisa los datos del formulario",
				body: "Hay campos incompletos o inválidos. Corrige e intenta de nuevo.",
			}
		: error === "session_expired"
			? {
					title: "Sesión expirada",
					body: "Vuelve a iniciar sesión para guardar cambios.",
				}
			: error === "provider_not_found"
				? {
						title: "Proveedor no encontrado",
						body: "Crea primero la identidad comercial para habilitar el perfil operativo.",
					}
				: error === "save_failed"
					? {
							title: "No se pudo guardar",
							body: "Hubo un problema al guardar. Intenta de nuevo en unos momentos.",
						}
					: error
						? {
								title: "No se pudo completar la acción",
								body: "Revisa los datos e intenta de nuevo.",
							}
						: null

const editMode = Astro.url.searchParams.get("edit") === "1"
const hasValidationContext = Boolean(
	identityFlash || profileFlash || error === "validation_error" || errorNotice
)
const identityBasicsSaved = Boolean(
	String(provider?.displayName ?? "").trim() && String(provider?.legalName ?? "").trim()
)
const holderBasicsSaved =
	!holderStorageReady ||
	Boolean(holderProfile?.holderType && String(holderProfile?.holderCountry ?? "").trim())
const opsBasicsSaved = Boolean(
	String(profile?.timezone ?? "").trim() &&
	String(profile?.defaultCurrency ?? "").trim() &&
	String(profile?.supportEmail ?? "").trim()
)
const profileBasicsComplete =
	hasProvider && identityBasicsSaved && holderBasicsSaved && opsBasicsSaved
const showProfileForm = !profileBasicsComplete || editMode || hasValidationContext
const profileEditHref = `${routes.providerSettingsProfile()}?edit=1`
const profileLayoutDescription =
	showProfileForm && profileBasicsComplete
		? "Estás editando la identidad comercial y los datos operativos. Guarda cuando termines o cancela para volver al resumen."
		: showProfileForm
			? "Un solo guardado actualiza la identidad comercial y los datos operativos. La publicación, verificación, pagos e integraciones se gestionan desde sus propios espacios."
			: "Datos guardados del negocio. Edítalos solo cuando necesites cambiar identidad comercial u operación diaria."
---

<ProviderSettingsLayout
	title="Perfil del proveedor"
	heading="Perfil del proveedor"
	description={profileLayoutDescription}
>
	{
		successNotice ? (
			<Notice variant="success" title={successNotice.title}>
				<p>{successNotice.body}</p>
				<div class="mt-3 flex flex-wrap gap-3" data-post-save-cta>
					<a
						class="font-semibold underline"
						href={routes.providerSettingsVerification()}
						data-funnel-cta="post_save"
					>
						Continuar a verificación
					</a>
				</div>
			</Notice>
		) : null
	}
	{
		errorNotice ? (
			<Notice variant="error" title={errorNotice.title}>
				{errorNotice.body}
			</Notice>
		) : null
	}
	{
		!hasProvider && !errorNotice ? (
			<Notice
				variant="warning"
				title="Primero crea la identidad comercial"
				data-profile-identity-gate
			>
				El perfil operativo se habilita cuando exista un proveedor asociado a tu cuenta.
			</Notice>
		) : null
	}

	<div class="w-full space-y-8 md:space-y-10" data-profile-identity-first>
		{
			hasProvider ? (
				showProfileForm ? (
					<form
						method="POST"
						action="/api/providers/profile"
						class="grid w-full gap-6 xl:grid-cols-2 xl:items-start"
						data-provider-settings-unified
						data-profile-edit-mode
						data-funnel-domain="identity"
						data-astro-reload
					>
						<div class="min-w-0 xl:col-span-1" data-profile-identity>
							<ProviderRegisterForm
								provider={provider}
								holderProfile={holderProfile}
								holderStorageReady={holderStorageReady}
								hasProvider={hasProvider}
								draft={identityFlash}
								fieldErrors={identityFlash?.errors}
								showBackAction={false}
								embedded={true}
							/>
						</div>
						<ProviderSettingsHubCard
							class="min-w-0 xl:col-span-1"
							data-profile-ops
							eyebrow="Operación"
							title="Operación diaria"
							description="Zona horaria, moneda y contacto de soporte para reservas y calendario."
						>
							<ProviderProfileForm
								isProviderAvailable={true}
								profile={profile}
								draft={profileFlash}
								fieldErrors={profileFlash?.errors}
								showRelatedDomains={false}
								showBackAction={false}
								embedded={true}
							/>
						</ProviderSettingsHubCard>
						<div class="fastt-soft-box sticky bottom-4 z-10 flex flex-wrap justify-end gap-3 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white/95 p-4 shadow-sm backdrop-blur xl:col-span-2">
							{profileBasicsComplete ? (
								<Button href={routes.providerSettingsProfile()} variant="secondary">
									Cancelar
								</Button>
							) : null}
							<Button type="submit" variant="selection">
								Guardar cambios
							</Button>
						</div>
					</form>
				) : (
					<div class="grid w-full gap-6 xl:grid-cols-2 xl:items-start" data-profile-summary>
						<ProviderSettingsHubCard
							class="min-w-0 xl:col-span-1"
							data-profile-identity
							eyebrow="Cuenta"
							title="Identidad comercial"
							description="Define cómo se reconoce el negocio dentro de Fastt y en los controles internos."
						>
							<ProviderSettingsIdentityReadonly
								provider={provider}
								holderProfile={holderProfile}
								holderStorageReady={holderStorageReady}
							/>
						</ProviderSettingsHubCard>
						<ProviderSettingsHubCard
							class="min-w-0 xl:col-span-1"
							data-profile-ops
							eyebrow="Operación"
							title="Operación diaria"
							description="Zona horaria, moneda y contacto de soporte para reservas y calendario."
						>
							<ProviderSettingsOpsReadonly profile={profile} />
						</ProviderSettingsHubCard>
						<div class="fastt-soft-box sticky bottom-4 z-10 flex flex-col gap-2 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white/95 p-4 shadow-sm backdrop-blur sm:flex-row sm:items-center sm:justify-between xl:col-span-2">
							<p class="text-sm text-slate-600">
								Los cambios de identidad y operación se guardan juntos cuando edites.
							</p>
							<Button href={profileEditHref} variant="selection" class="w-full shrink-0 sm:w-auto">
								<PencilLine class="size-4" aria-hidden="true" />
								Editar perfil
							</Button>
						</div>
					</div>
				)
			) : (
				<div class="w-full max-w-4xl">
					<div data-profile-identity>
						<ProviderRegisterForm
							provider={provider}
							holderProfile={holderProfile}
							holderStorageReady={holderStorageReady}
							hasProvider={hasProvider}
							draft={identityFlash}
							fieldErrors={identityFlash?.errors}
							showBackAction={false}
						/>
					</div>
					<div
						class="fastt-notice rounded-[var(--fastt-radius-card)] border border-dashed border-slate-200 bg-slate-50 p-5 text-sm leading-6 text-slate-600"
						data-profile-ops-gated
					>
						<p class="font-semibold text-slate-950">Operación diaria</p>
						<p class="mt-1">
							Queda bloqueado hasta guardar la identidad comercial. Luego podrás configurar zona
							horaria, moneda y contacto de soporte en el mismo formulario.
						</p>
					</div>
				</div>
			)
		}
	</div>
</ProviderSettingsLayout>
