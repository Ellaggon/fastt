---
import ProviderProfileForm from "@/components/provider/ProviderProfileForm.astro"
import ProviderRegisterForm from "@/components/provider/ProviderRegisterForm.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import {
	PROVIDER_ONBOARDING_SELECTION_COOKIE,
	resolveProviderOnboardingVertical,
} from "@/lib/onboarding/providerOnboarding"
import { resolveProviderOnboardingEntryFromStorage } from "@/lib/onboarding/providerOnboardingEntry"
import { PROVIDER_FORM_FLASH_COOKIE, readProviderFormFlash } from "@/lib/provider-form-flash"
import { isHolderStorageAvailable, readProviderHolderProfile } from "@/lib/provider-holder-profile"
import { routes } from "@/lib/routes"
import { getProviderFullAggregate } from "@/modules/catalog/public"

const user = await getUserFromRequest(Astro.request)
if (!user?.id) return Astro.redirect("/SignInPage")
if (Astro.url.searchParams.get("error") === "invalid_method")
	return Astro.redirect(routes.providerOnboardingStart())

const providerId = await getProviderIdFromRequest(Astro.request, user)
if (!providerId) return Astro.redirect(routes.providerOnboardingStart())
const aggregate = providerId ? await getProviderFullAggregate(providerId, user.id) : null
const provider = aggregate?.provider ?? null
const holderProfile = providerId ? await readProviderHolderProfile(providerId) : null
const holderStorageReady = await isHolderStorageAvailable()
const profile = aggregate?.profile ?? null
const hasProvider = Boolean(provider?.id)
const selectedVertical = resolveProviderOnboardingVertical(
	Astro.cookies.get(PROVIDER_ONBOARDING_SELECTION_COOKIE)?.value
)
const onboardingEntry = await resolveProviderOnboardingEntryFromStorage({
	providerId,
	userId: user.id,
	explicitProviderIntent: true,
	selectedVertical,
})
const onboardingResume =
	onboardingEntry.kind === "redirect" &&
	onboardingEntry.reason !== "first_offer_published" &&
	onboardingEntry.reason !== "unsupported_first_offer"
		? {
				href: onboardingEntry.href,
				vertical: onboardingEntry.vertical,
			}
		: onboardingEntry.kind === "render-service-choice"
			? {
					href: "/provider/onboarding?intent=provider&change=1",
					vertical: null,
				}
			: null
const onboardingResumeLabel =
	onboardingResume?.vertical === "tour"
		? "Continuar creando tu tour"
		: onboardingResume?.vertical === "hotel"
			? "Continuar creando tu alojamiento"
			: "Elegir servicio y continuar"
const onboardingResumeTitle = onboardingResume?.vertical
	? "Tu primera oferta sigue en preparación"
	: "Completa tu primera oferta"

const success = String(Astro.url.searchParams.get("success") ?? "").trim()
const error = String(Astro.url.searchParams.get("error") ?? "").trim()
const identityFlash = readProviderFormFlash(
	Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value,
	"identity"
)
const profileFlash = readProviderFormFlash(
	Astro.cookies.get(PROVIDER_FORM_FLASH_COOKIE)?.value,
	"profile"
)
if (identityFlash || profileFlash)
	Astro.cookies.delete(PROVIDER_FORM_FLASH_COOKIE, { path: "/provider" })
const opsParam = String(Astro.url.searchParams.get("ops") ?? "").trim()

/** Expand ops after save / ?ops=1; otherwise keep collapsed (identity-first). */
const opsDefaultOpen =
	success === "ops_saved" || success === "identity_saved" || opsParam === "1" || opsParam === "open"

const successNotice =
	success === "identity_saved"
		? {
				title: "Identidad comercial guardada",
				body: "Nombre comercial y razón social actualizados. Puedes seguir editando los datos operativos desde esta página.",
			}
		: success === "ops_saved" || success === "saved"
			? {
					title: "Perfil operativo guardado",
					body: "Zona horaria, moneda y contacto de soporte actualizados.",
				}
			: null

const errorNotice =
	error === "validation_error"
		? {
				title: "Revisa los datos del formulario",
				body: "Hay campos incompletos o inválidos. Corrige e intenta de nuevo.",
			}
		: error === "session_expired"
			? {
					title: "Sesión expirada",
					body: "Vuelve a iniciar sesión para guardar cambios.",
				}
			: error === "provider_not_found"
				? {
						title: "Proveedor no encontrado",
						body: "Crea primero la identidad comercial para habilitar el perfil operativo.",
					}
				: error === "save_failed"
					? {
							title: "No se pudo guardar",
							body: "Hubo un problema al guardar. Intenta de nuevo en unos momentos.",
						}
					: error
						? {
								title: "No se pudo completar la acción",
								body: "Revisa los datos e intenta de nuevo.",
							}
						: null
---

<ProviderSettingsLayout
	title="Perfil del proveedor"
	heading="Perfil del proveedor"
	description="Edita la identidad y los datos operativos del negocio. La publicación, verificación, pagos e integraciones se gestionan desde sus propios espacios."
>
	{
		successNotice ? (
			<Notice variant="success" title={successNotice.title}>
				{successNotice.body}
			</Notice>
		) : null
	}
	{
		onboardingResume ? (
			<Notice variant="info" title={onboardingResumeTitle} data-settings-onboarding-resume>
				<p>
					El negocio y sus datos se conservan. Retoma el alta sin crear ni duplicar otra oferta.
				</p>
				<a
					href={onboardingResume.href}
					class="mt-3 inline-flex rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
					data-settings-onboarding-resume-cta
				>
					{onboardingResumeLabel}
				</a>
			</Notice>
		) : null
	}
	{
		errorNotice ? (
			<Notice variant="error" title={errorNotice.title}>
				{errorNotice.body}
			</Notice>
		) : null
	}
	{
		!hasProvider && !errorNotice ? (
			<Notice
				variant="warning"
				title="Primero crea la identidad comercial"
				data-profile-identity-gate
			>
				El perfil operativo se habilita cuando exista un proveedor asociado a tu cuenta.
			</Notice>
		) : null
	}

	<div class="mx-auto flex w-full max-w-3xl flex-col gap-6" data-profile-identity-first>
		<div data-profile-identity>
			<ProviderRegisterForm
				provider={provider}
				holderProfile={holderProfile}
				holderStorageReady={holderStorageReady}
				hasProvider={hasProvider}
				draft={identityFlash}
				fieldErrors={identityFlash?.errors}
				showBackAction={false}
			/>
		</div>

		{
			hasProvider ? (
				<details
					id="ops"
					class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
					open={opsDefaultOpen}
					data-profile-ops
				>
					<summary class="cursor-pointer list-none text-lg font-semibold text-slate-950 [&::-webkit-details-marker]:hidden">
						<span class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
							<span>Perfil operativo</span>
							<span class="text-sm font-normal text-slate-500">Zona horaria, moneda y soporte</span>
						</span>
					</summary>
					<div class="mt-4 border-t border-slate-100 pt-4">
						<ProviderProfileForm
							isProviderAvailable={true}
							profile={profile}
							draft={profileFlash}
							fieldErrors={profileFlash?.errors}
							showRelatedDomains={false}
							showBackAction={false}
						/>
					</div>
				</details>
			) : (
				<div
					class="fastt-notice rounded-[var(--fastt-radius-card)] border border-dashed border-slate-200 bg-slate-50 p-5 text-sm leading-6 text-slate-600"
					data-profile-ops-gated
				>
					<p class="font-semibold text-slate-950">Perfil operativo</p>
					<p class="mt-1">
						Queda bloqueado hasta guardar la identidad comercial. Luego podrás configurar zona
						horaria, moneda y contacto de soporte.
					</p>
				</div>
			)
		}
	</div>
</ProviderSettingsLayout>
