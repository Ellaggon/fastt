---
import ProviderProfileForm from "@/components/provider/ProviderProfileForm.astro"
import ProviderRegisterForm from "@/components/provider/ProviderRegisterForm.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import ProviderSettingsLayout from "@/layouts/ProviderSettingsLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { TRUST_GLOSSARY } from "@/lib/provider-trust-map"
import { getProviderProfessionalToolsPreferenceRead } from "@/lib/providerProfessionalToolsPreference"
import { routes } from "@/lib/routes"
import { getProviderFullAggregate } from "@/modules/catalog/public"

const user = await getUserFromRequest(Astro.request)
if (!user?.id) return Astro.redirect("/SignInPage")

const providerId = await getProviderIdFromRequest(Astro.request, user)
const aggregate = providerId ? await getProviderFullAggregate(providerId, user.id) : null
const provider = aggregate?.provider ?? null
const profile = aggregate?.profile ?? null
const hasProvider = Boolean(provider?.id)

const success = String(Astro.url.searchParams.get("success") ?? "").trim()
const error = String(Astro.url.searchParams.get("error") ?? "").trim()
const opsParam = String(Astro.url.searchParams.get("ops") ?? "").trim()
const professionalToolsStatus = String(Astro.url.searchParams.get("professionalTools") ?? "").trim()

/** Expand ops after save / ?ops=1; otherwise keep collapsed (identity-first). */
const opsDefaultOpen =
	success === "ops_saved" || success === "identity_saved" || opsParam === "1" || opsParam === "open"

const professionalToolsPreference = hasProvider
	? await getProviderProfessionalToolsPreferenceRead(String(providerId))
	: null
const professionalToolsEnabled = Boolean(professionalToolsPreference?.professionalToolsEnabled)
const professionalToolsSchemaAvailable = professionalToolsPreference?.schemaAvailable !== false

const successNotice =
	success === "identity_saved"
		? {
				title: "Identidad comercial guardada",
				body: "Nombre comercial y razón social actualizados. Abre el perfil operativo si quieres zona horaria, moneda y soporte, o continúa a verificación.",
			}
		: success === "ops_saved" || success === "saved"
			? {
					title: "Perfil operativo guardado",
					body: "Zona horaria, moneda y contacto de soporte quedan listos para la operación del proveedor.",
				}
			: null

const errorNotice =
	error === "validation_error"
		? {
				title: "Revisa los datos del formulario",
				body: "Hay campos incompletos o inválidos. Corrige e intenta de nuevo.",
			}
		: error === "session_expired"
			? {
					title: "Sesión expirada",
					body: "Vuelve a iniciar sesión para guardar cambios.",
				}
			: error === "provider_not_found"
				? {
						title: "Proveedor no encontrado",
						body: "Crea primero la identidad comercial para habilitar el perfil operativo.",
					}
				: error === "save_failed" || error === "invalid_method"
					? {
							title: "No se pudo guardar",
							body: "Hubo un problema al guardar. Intenta de nuevo en unos momentos.",
						}
					: error
						? {
								title: "No se pudo completar la acción",
								body: "Revisa los datos e intenta de nuevo.",
							}
						: null
---

<ProviderSettingsLayout
	title="Perfil del proveedor"
	heading="Perfil del proveedor"
	description="Empieza por la identidad comercial. Zona horaria, moneda y soporte quedan en operación (colapsado). Fiscalidad, pagos e integraciones van en sus propias secciones."
>
	<div slot="actions" class="flex flex-wrap gap-3">
		{
			hasProvider ? (
				<Button href={routes.providerSettingsVerification()} variant="secondary">
					{TRUST_GLOSSARY.returnToVerification.label}
				</Button>
			) : null
		}
		<Button href={routes.providerSettings()} variant="secondary">Resumen</Button>
	</div>

	{
		successNotice ? (
			<Notice variant="success" title={successNotice.title}>
				<p>{successNotice.body}</p>
				{hasProvider ? (
					<p
						class="mt-3"
						data-post-save-cta
						data-funnel-domain="identity"
						data-funnel-surface="profile"
					>
						<a
							class="font-semibold underline"
							href={routes.providerSettingsVerification()}
							data-funnel-cta="post_save"
						>
							{TRUST_GLOSSARY.returnToVerification.label}
						</a>
					</p>
				) : null}
			</Notice>
		) : null
	}
	{
		errorNotice ? (
			<Notice variant="error" title={errorNotice.title}>
				{errorNotice.body}
			</Notice>
		) : null
	}
	{
		professionalToolsStatus === "saved" ? (
			<Notice variant="success" title="Herramientas profesionales actualizadas">
				El sidebar se ajustará según la preferencia del proveedor, escala y rol.
			</Notice>
		) : null
	}
	{
		professionalToolsStatus === "error" ? (
			<Notice variant="error" title="No se pudo actualizar la preferencia">
				Revisa que la migración de preferencias del proveedor esté aplicada.
			</Notice>
		) : null
	}
	{
		!hasProvider && !errorNotice ? (
			<Notice
				variant="warning"
				title="Primero crea la identidad comercial"
				data-profile-identity-gate
			>
				El perfil operativo se habilita cuando exista un proveedor asociado a tu cuenta.
			</Notice>
		) : null
	}

	<div class="mx-auto flex w-full max-w-3xl flex-col gap-6" data-profile-identity-first>
		<div data-profile-identity>
			<ProviderRegisterForm provider={provider} hasProvider={hasProvider} />
		</div>

		{
			hasProvider ? (
				<details
					id="ops"
					class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
					open={opsDefaultOpen}
					data-profile-ops
				>
					<summary class="cursor-pointer list-none text-lg font-semibold text-slate-950 [&::-webkit-details-marker]:hidden">
						<span class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
							<span>Perfil operativo</span>
							<span class="text-sm font-normal text-slate-500">Zona horaria, moneda y soporte</span>
						</span>
					</summary>
					<div class="mt-4 border-t border-slate-100 pt-4">
						<ProviderProfileForm isProviderAvailable={true} profile={profile} />
					</div>
				</details>
			) : (
				<div
					class="fastt-notice rounded-[var(--fastt-radius-card)] border border-dashed border-slate-200 bg-slate-50 p-5 text-sm leading-6 text-slate-600"
					data-profile-ops-gated
				>
					<p class="font-semibold text-slate-950">Perfil operativo</p>
					<p class="mt-1">
						Queda bloqueado hasta guardar la identidad comercial. Luego podrás configurar zona
						horaria, moneda y contacto de soporte.
					</p>
				</div>
			)
		}

		{
			hasProvider ? (
				<details
					class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
					open={professionalToolsStatus === "saved" || professionalToolsStatus === "error"}
					data-profile-professional-tools
				>
					<summary class="cursor-pointer list-none text-lg font-semibold text-slate-950 [&::-webkit-details-marker]:hidden">
						<span class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
							<span>Preferencias del espacio de trabajo</span>
							<span class="text-sm font-normal text-slate-500">Simple o Pro</span>
						</span>
					</summary>
					<p class="mt-2 text-sm leading-6 text-slate-600">
						Preferencias que cambian cómo se organiza el sidebar y las herramientas visibles.
					</p>
					{!professionalToolsSchemaAvailable ? (
						<Notice variant="warning" title="Preferencia aún no disponible" class="mt-4">
							La migración de herramientas profesionales no está aplicada en este entorno.
						</Notice>
					) : null}
					<Card class="mt-4">
						<form
							method="post"
							action="/api/provider/preferences/professional-tools"
							class="space-y-5"
						>
							<input type="hidden" name="returnTo" value={routes.providerSettingsProfile()} />
							<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
								<div class="max-w-2xl space-y-2">
									<div class="flex flex-wrap items-center gap-3">
										<h2 class="text-xl font-semibold text-slate-900">Herramientas profesionales</h2>
										<Badge variant={professionalToolsEnabled ? "success" : "neutral"}>
											{professionalToolsEnabled ? "Activadas" : "Desactivadas"}
										</Badge>
									</div>
									<p class="text-sm leading-6 text-slate-600">
										Activa herramientas para manejar muchas tarifas, reglas, inventario físico y
										operaciones masivas.
									</p>
									<p class="text-sm leading-6 text-slate-600">
										Recomendado si administras varios hoteles, muchas habitaciones o reglas
										recurrentes.
									</p>
								</div>
								<div
									class="fastt-tabs min-w-[220px] border border-slate-200 bg-white p-1 text-sm font-semibold text-slate-700 shadow-sm"
									role="radiogroup"
									aria-label="Modo de experiencia"
								>
									<label class="block">
										<input
											type="radio"
											name="mode"
											value="simple"
											checked={!professionalToolsEnabled}
											class="peer fastt-check-input sr-only"
										/>
										<span class="fastt-tab block cursor-pointer px-4 py-2 text-center text-slate-600 transition peer-checked:bg-slate-950 peer-checked:text-white">
											Simple
										</span>
									</label>
									<label class="mt-1 block">
										<input
											type="radio"
											name="mode"
											value="professional"
											checked={professionalToolsEnabled}
											class="peer fastt-check-input sr-only"
										/>
										<span class="fastt-tab block cursor-pointer px-4 py-2 text-center text-slate-600 transition peer-checked:bg-slate-950 peer-checked:text-white">
											Pro
										</span>
									</label>
								</div>
							</div>
							<Card variant="soft">
								<p class="text-sm font-semibold text-slate-900">Modo Simple</p>
								<p class="mt-1 text-sm leading-6 text-slate-600">
									Muestra la operación diaria: Tarifas y Calendario. El contrato se completa dentro
									de cada tarifa.
								</p>
								<p class="mt-3 text-sm font-semibold text-slate-900">Modo Pro</p>
								<p class="mt-1 text-sm leading-6 text-slate-600">
									El sidebar puede mostrar Reglas de venta y herramientas profesionales. Las
									operaciones de cupo y disponibilidad siguen dentro de Calendario.
								</p>
							</Card>
							<div class="flex justify-end">
								<Button type="submit">Guardar preferencia</Button>
							</div>
						</form>
					</Card>
				</details>
			) : null
		}
	</div>
</ProviderSettingsLayout>
