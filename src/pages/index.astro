---
import { ArrowRight, Building2, Compass } from "@lucide/astro"

import PublicListingImage from "@/components/marketplace/PublicListingImage.astro"
import UILayout from "@/layouts/UILayout.astro"
---

<UILayout
	title="Fastt | Viajes en Bolivia"
	description="Encuentra alojamientos y experiencias para viajar por Bolivia."
	canonicalPath="/"
	structuredData={{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "Fastt",
		"url": Astro.url.origin,
		"inLanguage": "es-BO",
	}}
>
	<main class="bg-slate-50 text-slate-950">
		<section class="relative min-h-[calc(100vh-3rem)] overflow-hidden bg-slate-950">
			<PublicListingImage
				src="https://pub-de0b5a27b1424d99afa6c7b2fe2f02dc.r2.dev/la-paz.webp"
				alt="Paisaje de La Paz, Bolivia"
				priority
				class="absolute inset-0 h-full w-full"
			/>
			<div class="absolute inset-0 bg-slate-950/65"></div>
			<div
				class="relative mx-auto flex min-h-[calc(100vh-3rem)] max-w-7xl flex-col justify-center px-4 pb-28 pt-20 sm:px-6 lg:px-8"
			>
				<p class="text-sm font-semibold text-slate-200">FASTT · BOLIVIA</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-white sm:text-5xl">
					Encuentra dónde quedarte y qué vivir en Bolivia.
				</h1>
				<p class="mt-5 max-w-xl text-base leading-7 text-slate-200">
					Explora opciones para tu viaje con información clara antes de reservar.
				</p>
				<div class="mt-9 flex flex-col gap-3 sm:flex-row">
					<a
						href="/hotels"
						class="fastt-button inline-flex h-11 items-center justify-center gap-2 rounded-full bg-white px-5 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
					>
						<Building2 class="h-4 w-4" aria-hidden="true" />
						Buscar alojamientos
						<ArrowRight class="h-4 w-4" aria-hidden="true" />
					</a>
					<a
						href="/tours"
						class="fastt-soft-box inline-flex h-11 items-center justify-center gap-2 rounded-full border border-white/60 bg-slate-950/20 px-5 text-sm font-semibold text-white transition hover:bg-white/15"
					>
						<Compass class="h-4 w-4" aria-hidden="true" />
						Explorar experiencias
					</a>
				</div>
			</div>
		</section>

		<section class="border-b border-slate-200 bg-white">
			<div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-2 lg:px-8">
				<a
					href="/hotels"
					class="group border-b border-slate-200 pb-6 md:border-b-0 md:border-r md:pb-0 md:pr-8"
				>
					<p class="text-sm font-semibold text-slate-500">ALOJAMIENTOS</p>
					<p class="mt-2 text-xl font-semibold text-slate-950 group-hover:underline">
						Encuentra una estadía que encaje con tu viaje.
					</p>
				</a>
				<a href="/tours" class="group">
					<p class="text-sm font-semibold text-slate-500">EXPERIENCIAS</p>
					<p class="mt-2 text-xl font-semibold text-slate-950 group-hover:underline">
						Elige tours con detalles de salida e inclusiones.
					</p>
				</a>
			</div>
		</section>
	</main>
</UILayout>
