---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import ProgressBar from "@/components/ui/ProgressBar.astro"
import WorkspaceMetricStat from "@/components/ui/WorkspaceMetricStat.astro"
import WorkspaceMetricStats from "@/components/ui/WorkspaceMetricStats.astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { buildAddRoomHref, resolveAddRoomPlaybookFromUrl } from "@/lib/playbook/add-room"
import {
	type ProductPreparationSummary,
	listProductOperationalPreparation,
} from "@/lib/product/productOperationalSurface"
import {
	filterProductsForWorkspaceScope,
	isDashboardSetupHome,
	resolveDashboardHomeCopy,
	shiftIsoDate,
	summarizeDashboardToday,
} from "@/lib/dashboard/dashboardHomePresentation"
import { resolveOperationalSidebarVertical } from "@/lib/dashboard/providerOperationalNavigation"
import {
	listActivePreparationSessions,
	savedCompleteToPublishHrefForProduct,
} from "@/lib/onboarding/preparationSession"
import { bookingOperationsQueryRepository } from "@/modules/booking/public"
import { resolveVerticalVocabulary } from "@/lib/verticalVocabulary"
import {
	evaluateProviderGovernance,
	readProviderGovernanceFromConfigurationState,
} from "@/lib/provider-governance"
import { routes } from "@/lib/routes"
import {
	providerOnboardingLegacyHref,
	resolveProviderOnboardingRollout,
} from "@/lib/onboarding/providerOnboardingRollout"
import { ArrowRight, BedDouble, Hotel, Map as MapIcon, Plus, ShieldCheck } from "@lucide/astro"
import { and, db, eq, Product, sql, Variant } from "@/shared/infrastructure/db/compat"
import { normalizeProductVertical } from "@/lib/catalog/productVerticalRegistry"
import {
	resolveWorkspaceNavigationScope,
	type ActiveWorkspaceVertical,
} from "@/lib/workspace/verticalContext"

const dashboardStartedAt = performance.now()
const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) {
	const rollout = resolveProviderOnboardingRollout({ userId: user.id, host: Astro.url.host })
	return Astro.redirect(
		rollout.enabled ? routes.providerOnboarding() : providerOnboardingLegacyHref()
	)
}

const rows = await db
	.select({
		productId: Product.id,
		productName: Product.name,
		productType: Product.productType,
		variantId: Variant.id,
		variantName: Variant.name,
		variantKind: Variant.kind,
		variantActive: Variant.salesEnabled,
	})
	.from(Product)
	.leftJoin(Variant, eq(Variant.productId, Product.id))
	.where(eq(Product.providerId, providerId))

const byProduct = new Map<
	string,
	{
		id: string
		name: string
		type: string
		rooms: Array<{ id: string; name: string; kind: string; active: boolean }>
	}
>()

for (const row of rows) {
	const productId = String(row.productId)
	const entry = byProduct.get(productId) ?? {
		id: productId,
		name: String(row.productName ?? "Servicio"),
		type: String(row.productType ?? "Hotel"),
		rooms: [],
	}
	if (row.variantId) {
		entry.rooms.push({
			id: String(row.variantId),
			name: String(row.variantName ?? "Modalidad"),
			kind: String(row.variantKind ?? "hotel_room"),
			active: Boolean(row.variantActive ?? true),
		})
	}
	byProduct.set(productId, entry)
}

const catalogProducts = Array.from(byProduct.values())
const availableVerticals = [
	...new Set(
		catalogProducts
			.map((product) => normalizeProductVertical(product.type))
			.filter((vertical): vertical is ActiveWorkspaceVertical => vertical !== "generic")
	),
]
const workspaceScope = resolveWorkspaceNavigationScope({
	productTypes: availableVerticals,
	searchParams: Astro.url.searchParams,
})
const operationalVertical = resolveOperationalSidebarVertical({
	workspaceScope,
	availableVerticals,
})
const products = filterProductsForWorkspaceScope(catalogProducts, operationalVertical)
const preparationSessions = await listActivePreparationSessions(providerId, String(user.id ?? ""))
const lastPathByProductId = new Map(
	preparationSessions.map((session) => [session.productId, session.href] as const)
)
const preparationByProduct = await listProductOperationalPreparation(
	providerId,
	products.map((product) => product.id),
	{ lastPathByProductId }
)
const addRoomPlaybook = resolveAddRoomPlaybookFromUrl(Astro.url)
const flow = Astro.url.searchParams.get("flow")
if (!addRoomPlaybook.active && flow === "add-room") {
	return Astro.redirect(buildAddRoomHref(routes.catalogAccommodations(), "choose-accommodation"))
}
if (catalogProducts.length === 1) {
	if (addRoomPlaybook.active) {
		return Astro.redirect(
			buildAddRoomHref(routes.productRoomNew(catalogProducts[0].id), "create-room")
		)
	}
}

const hotelProducts = products.filter((product) => product.type.toLowerCase() === "hotel")
const tourProducts = products.filter((product) => product.type.toLowerCase() === "tour")
const otherProductCount = Math.max(0, products.length - hotelProducts.length - tourProducts.length)
const hasHotel = hotelProducts.length > 0
const hasTour = tourProducts.length > 0
const tourDepartures = tourProducts.reduce((sum, product) => sum + product.rooms.length, 0)
const operatedFamilies = [hasHotel, hasTour, otherProductCount > 0].filter(Boolean).length
const isChoosingForAddRoom = addRoomPlaybook.active
const isSetupHome = !isChoosingForAddRoom && isDashboardSetupHome(products, preparationByProduct)
const showAddAnotherService = products.length > 0 && !isChoosingForAddRoom && !isSetupHome
const showCrossVerticalKpis = !isSetupHome && operatedFamilies > 1
const opsVocabulary = resolveVerticalVocabulary(
	operationalVertical ? [operationalVertical] : availableVerticals
).ops
const todayIso = new Date().toISOString().slice(0, 10)
const todayBookings =
	!isSetupHome && !isChoosingForAddRoom
		? await bookingOperationsQueryRepository
				.listByProvider({
					providerId,
					from: shiftIsoDate(todayIso, -21),
					to: shiftIsoDate(todayIso, 14),
					limit: 80,
				})
				.then((result) =>
					result.items.filter(
						(item) => !operationalVertical || item.vertical === operationalVertical
					)
				)
				.catch(() => [])
		: []
const todaySummary = summarizeDashboardToday(todayBookings, todayIso)
const showTodayBoard = !isSetupHome && !isChoosingForAddRoom && todaySummary.hasAnyBookings
const homeCopy = resolveDashboardHomeCopy({
	isChoosingForAddRoom,
	isSetupHome,
	hasHotel,
	hasTour,
	hotelCount: hotelProducts.length,
	tourCount: tourProducts.length,
	productCount: products.length,
	hasTodayOperations: showTodayBoard,
})
const providerGovernance =
	(await readProviderGovernanceFromConfigurationState(providerId, {
		currentUserId: user.id,
		allowStale: true,
	}).catch(() => null)) ??
	(await evaluateProviderGovernance(providerId, {
		currentUserId: user.id,
		persist: true,
	}).catch(() => null))
const providerNotice = providerGovernance?.blockers[0]
	? {
			label: providerGovernance.blockers[0].label,
			href: providerGovernance.blockers[0].href || routes.providerSettings(),
		}
	: null
const Layout = addRoomPlaybook.active ? PlaybookLayout : WorkspaceLayout
const layoutProps = addRoomPlaybook.active
	? {
			title: homeCopy.title,
			playbookId: "add-room" as const,
			active: true,
			stepId: addRoomPlaybook.stepId ?? "choose-accommodation",
			productId: "",
			isHotel: true,
		}
	: { title: homeCopy.title }

Astro.response.headers.set(
	"Server-Timing",
	`dashboard;dur=${Number((performance.now() - dashboardStartedAt).toFixed(1))}`
)

function preparationMessage(
	preparation: ProductPreparationSummary | null | undefined,
	isTour: boolean
) {
	if (!preparation)
		return `Revisa la preparación del ${isTour ? "tour" : "alojamiento"} antes de publicarlo.`
	if (preparation.isPublished) {
		return isTour ? "Publicado y visible para viajeros." : "Publicado y visible para huéspedes."
	}
	if (preparation.readyToPublish) return "Preparación completa. Revisa la vista previa y publica."
	if (preparation.blockerCount > 0) {
		const preview = preparation.blockerPreview.join(", ").toLowerCase()
		return `Faltan ${preparation.blockerCount} paso${preparation.blockerCount === 1 ? "" : "s"}${preview ? `: ${preview}` : ""}.`
	}
	return `${preparation.readinessPercent}% de preparación completada.`
}

function preparationSupport(
	roomCount: number,
	preparation: ProductPreparationSummary | null | undefined,
	isTour: boolean
) {
	if (roomCount === 0) {
		return isTour
			? "Crea la primera salida para definir fecha, cupo, precio y disponibilidad desde el flujo guiado."
			: "Crea la primera habitación para definir capacidad, fotos, tarifa y disponibilidad desde el flujo guiado."
	}
	if (preparation?.readyToPublish) {
		return "La ficha ya tiene lo esencial. Revisa la experiencia final antes de publicarla."
	}
	if ((preparation?.blockerCount ?? 0) > 0) {
		return `Continúa por el primer pendiente y vuelve aquí para revisar ${isTour ? "salidas" : "habitaciones"}.`
	}
	return `Mantén ${isTour ? "salidas, cupos" : "habitaciones"}, tarifas y disponibilidad actualizadas desde sus herramientas operativas.`
}

function spanishCount(count: number, singular: string, plural: string) {
	return `${count} ${count === 1 ? singular : plural}`
}

function variantInventorySummary(isTour: boolean, total: number, active: number) {
	if (total === 0) return isTour ? "Sin salidas todavía" : "Sin habitaciones todavía"
	return `${spanishCount(total, isTour ? "salida" : "habitación", isTour ? "salidas" : "habitaciones")} · ${spanishCount(active, "activa", "activas")}`
}

function addAnotherServiceCopy() {
	if (hasTour && !hasHotel) {
		return "Agrega otro tour u otra línea, como alojamientos, paquetes o traslados."
	}
	if (hasHotel && !hasTour) {
		return "Agrega otro servicio solo si operas una línea distinta, como tours, paquetes o traslados. Si quieres sumar espacios dentro del mismo hotel, crea habitaciones."
	}
	return "Agrega otro servicio solo si operas una línea distinta. Cada línea tiene su propia ficha y operación."
}
---

<Layout {...layoutProps}>
	<section class="space-y-6 md:space-y-8">
		<header class="flex flex-col gap-2">
			<h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl md:text-3xl">
				{homeCopy.title}
			</h1>
			<p class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6">
				{homeCopy.intro}
			</p>
		</header>

		{
			providerNotice && !isChoosingForAddRoom ? (
				<a
					href={providerNotice.href}
					data-dashboard-provider-notice
					class="flex flex-wrap items-center justify-between gap-3 rounded-[var(--fastt-radius-card)] border border-white/10 bg-white/[0.04] px-4 py-3 text-sm transition hover:border-white/20 hover:bg-white/[0.07]"
				>
					<span class="flex min-w-0 items-start gap-3">
						<ShieldCheck class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" aria-hidden="true" />
						<span class="min-w-0">
							<span class="block font-semibold text-white">Cuenta de proveedor</span>
							<span class="mt-0.5 block text-slate-400">{providerNotice.label}</span>
						</span>
					</span>
					<span class="shrink-0 font-semibold text-white">Completar</span>
				</a>
			) : null
		}

		<div class="space-y-5">
			{
				products.length === 0 ? (
					<Card class="overflow-hidden p-0">
						<div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_320px]">
							<div class="space-y-5 p-6">
								<div class="inline-flex h-11 w-11 items-center justify-center rounded-[var(--fastt-radius-card)] bg-slate-950 text-white">
									<Plus class="h-5 w-5" />
								</div>
								<div class="space-y-2">
									<h2 class="text-2xl font-semibold text-slate-950">Añade tu primer servicio</h2>
									<p class="max-w-2xl text-sm leading-6 text-slate-600">
										Elige si quieres ofrecer alojamientos, tours, paquetes o traslados antes de
										configurar su operación.
									</p>
								</div>
							</div>
							<aside class="border-t border-slate-200 bg-slate-50 p-6 lg:border-t-0 lg:border-l">
								<div class="flex h-full flex-col justify-between gap-6">
									<p class="text-sm leading-6 text-slate-600">
										Cada servicio tiene un recorrido de preparación propio.
									</p>
									<div class="flex flex-col gap-2">
										<Button href="/product/create" data-astro-prefetch>
											Añadir servicio
										</Button>
									</div>
								</div>
							</aside>
						</div>
					</Card>
				) : (
					<>
						{showTodayBoard ? (
							<section class="space-y-3" data-dashboard-today>
								<div class="flex flex-wrap items-end justify-between gap-3">
									<div>
										<p class="text-xs font-semibold tracking-[0.14em] text-slate-500 uppercase">
											Operación de hoy
										</p>
										<p class="mt-1 text-sm text-slate-400">
											Lo que hay que atender ahora, sin mezclar inventario de otra línea.
										</p>
									</div>
									<div class="flex flex-wrap gap-2">
										<Button
											href={`${routes.bookingList()}?vista=today`}
											variant="secondary"
											size="sm"
										>
											Ver reservas
										</Button>
										{hasTour ? (
											<Button href={routes.bookingDayOf()} variant="secondary" size="sm">
												Cola de hoy
											</Button>
										) : null}
									</div>
								</div>
								<WorkspaceMetricStats ariaLabel="Actividad de hoy">
									<WorkspaceMetricStat label={opsVocabulary.metricArrivalsToday}>
										{todaySummary.arrivalsToday}
									</WorkspaceMetricStat>
									<WorkspaceMetricStat label={opsVocabulary.metricDeparturesToday}>
										{todaySummary.departuresToday}
									</WorkspaceMetricStat>
									<WorkspaceMetricStat label={opsVocabulary.metricInProgress}>
										{todaySummary.inProgress}
									</WorkspaceMetricStat>
									<WorkspaceMetricStat
										label="Pago pendiente"
										tone={todaySummary.pendingPayment > 0 ? "warning" : "default"}
									>
										{todaySummary.pendingPayment}
									</WorkspaceMetricStat>
								</WorkspaceMetricStats>
								{todaySummary.agenda.length > 0 ? (
									<div class="overflow-hidden rounded-[var(--fastt-radius-card)] border border-white/10 bg-white/[0.04]">
										{todaySummary.agenda.map((item) => (
											<a
												href={`/booking/${encodeURIComponent(item.bookingId)}`}
												class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 px-4 py-3 text-sm last:border-b-0 hover:bg-white/[0.04]"
											>
												<span class="min-w-0">
													<span class="block truncate font-semibold text-white">
														{item.guestName}
													</span>
													<span class="block truncate text-slate-400">{item.productName}</span>
												</span>
												<span class="shrink-0 text-xs font-medium text-slate-400">
													{item.checkIn}
													{item.checkOut ? ` → ${item.checkOut}` : ""}
												</span>
											</a>
										))}
									</div>
								) : (
									<p class="text-sm text-slate-400">No hay movimientos puntuales para hoy.</p>
								)}
							</section>
						) : !isSetupHome && !isChoosingForAddRoom ? (
							<p class="text-sm leading-6 text-slate-400" data-dashboard-today-empty>
								Todavía no hay reservas. Cuando alguien reserve, aquí verás el día: salidas,
								llegadas y pagos pendientes.
							</p>
						) : null}

						{showCrossVerticalKpis ? (
							<WorkspaceMetricStats ariaLabel="Resumen de la operación">
								<WorkspaceMetricStat label="Servicios">{products.length}</WorkspaceMetricStat>
								{hasHotel ? (
									<WorkspaceMetricStat label="Alojamientos">
										{hotelProducts.length}
									</WorkspaceMetricStat>
								) : null}
								{hasTour ? (
									<WorkspaceMetricStat label="Tours">
										{tourProducts.length}
										<span class="text-sm font-medium text-slate-500">
											{" "}
											· {spanishCount(tourDepartures, "salida", "salidas")}
										</span>
									</WorkspaceMetricStat>
								) : null}
							</WorkspaceMetricStats>
						) : null}

						<div class="grid gap-4">
							{products.map((product) => {
								const isTour = product.type.toLowerCase() === "tour"
								const activeCount = product.rooms.filter((room) => room.active).length
								const inactiveCount = Math.max(0, product.rooms.length - activeCount)
								const hasVariants = product.rooms.length > 0
								const primaryHref = isTour
									? routes.productDeparturesForProduct(product.id)
									: isChoosingForAddRoom
										? buildAddRoomHref(routes.productRoomNew(product.id), "create-room")
										: routes.productRoomsForProduct(product.id)
								const primaryLabel = isChoosingForAddRoom
									? "Crear habitación"
									: isTour
										? hasVariants
											? "Abrir salidas"
											: "Crear primera salida"
										: hasVariants
											? "Abrir habitaciones"
											: "Crear primera habitación"
								const accommodationHref = routes.productDetail(product.id)
								const preparation = preparationByProduct.get(product.id)
								const savedPreparationHref = savedCompleteToPublishHrefForProduct(
									product.id,
									preparationSessions
								)
								const continuePreparationHref =
									savedPreparationHref ?? preparation?.continuePreparationHref ?? accommodationHref
								const isPublished = Boolean(preparation?.isPublished)
								const isReadyToPublish =
									!isChoosingForAddRoom && !isPublished && Boolean(preparation?.readyToPublish)
								const isSetup = !isChoosingForAddRoom && !isPublished && !isReadyToPublish
								const showInventoryStats = hasVariants
								const showOpsActions = isChoosingForAddRoom || isPublished
								const showAside = isChoosingForAddRoom || showInventoryStats || showOpsActions
								const accommodationPrimaryHref = isSetup
									? continuePreparationHref
									: isReadyToPublish
										? (preparation?.previewHref ?? routes.productPreview(product.id))
										: accommodationHref
								const accommodationLabel = isSetup
									? "Continuar preparación"
									: isReadyToPublish
										? "Revisar y publicar"
										: isTour
											? "Abrir tour"
											: "Abrir alojamiento"
								const previewRooms = product.rooms.slice(0, 3)
								const remainingRooms = Math.max(0, product.rooms.length - previewRooms.length)
								const preparationPercent = Math.max(
									0,
									Math.min(100, Number(preparation?.readinessPercent ?? 0))
								)
								const VerticalIcon = isTour ? MapIcon : Hotel

								return (
									<Card
										class="overflow-hidden p-0"
										data-dashboard-product-card
										data-product-id={product.id}
										data-product-vertical={isTour ? "tour" : "hotel"}
										data-saved-preparation-href={savedPreparationHref ?? ""}
										data-choosing-add-room={isChoosingForAddRoom ? "true" : "false"}
									>
										<div
											class:list={[
												"grid gap-0",
												showAside ? "lg:grid-cols-[minmax(0,1fr)_280px]" : "",
											]}
											data-dashboard-card-grid
										>
											<div class="space-y-5 p-5 md:p-6">
												<div class="flex flex-wrap items-start justify-between gap-4">
													<div class="space-y-1">
														<p class="flex items-center gap-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">
															<VerticalIcon class="h-4 w-4" />
															{isTour ? "Tour" : "Alojamiento"}
														</p>
														<h2 class="text-xl font-semibold text-slate-950">{product.name}</h2>
														<p class="text-sm text-slate-600">
															{variantInventorySummary(isTour, product.rooms.length, activeCount)}
														</p>
													</div>
													<Button
														href={accommodationPrimaryHref}
														data-astro-prefetch
														data-preparation-action
													>
														{accommodationLabel}
														<ArrowRight class="h-4 w-4" />
													</Button>
												</div>

												<div class="space-y-3 rounded-[var(--fastt-radius-card)] bg-slate-50 p-4 ring-1 ring-slate-900/[0.06]">
													<div class="flex flex-wrap items-start justify-between gap-3">
														<div class="min-w-0 space-y-1">
															<p
																class="text-sm font-semibold text-slate-950"
																data-preparation-message
																data-room-count={product.rooms.length}
															>
																{preparationMessage(preparation, isTour)}
															</p>
															<p class="text-sm leading-6 text-slate-600" data-preparation-support>
																{preparationSupport(product.rooms.length, preparation, isTour)}
															</p>
														</div>
														<span
															class:list={[
																"rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200",
																preparation?.nextStepLabel ? "" : "hidden",
															]}
															data-preparation-next-step
														>
															{preparation?.nextStepLabel ?? ""}
														</span>
													</div>
													<div
														class:list={[preparation?.isPublished ? "hidden" : ""]}
														data-preparation-progress
													>
														<ProgressBar
															value={preparationPercent}
															className="h-1.5 rounded-full bg-slate-200"
														/>
													</div>
												</div>

												{product.rooms.length > 0 && !isTour ? (
													<div class="space-y-2">
														<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
															Habitaciones recientes
														</p>
														<div class="divide-y divide-slate-100 rounded-[var(--fastt-radius-card)] bg-slate-50 ring-1 ring-slate-900/[0.06]">
															{previewRooms.map((room) => (
																<a
																	href={routes.productRoomDetail(product.id, room.id)}
																	data-astro-prefetch
																	class="flex items-center justify-between gap-3 px-4 py-3 text-sm transition hover:bg-white"
																>
																	<span class="flex min-w-0 items-center gap-3">
																		<span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[12px] bg-white text-slate-700 ring-1 ring-slate-200">
																			<BedDouble class="h-4 w-4" />
																		</span>
																		<span class="min-w-0">
																			<span class="block truncate font-semibold text-slate-950">
																				{room.name}
																			</span>
																			<span class="block text-xs text-slate-500">
																				{room.kind === "hotel_room" ? "Habitación" : room.kind}
																			</span>
																		</span>
																	</span>
																	<span
																		class:list={[
																			"shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold ring-1",
																			room.active
																				? "bg-emerald-50 text-emerald-800 ring-emerald-200"
																				: "bg-slate-100 text-slate-600 ring-slate-200",
																		]}
																	>
																		{room.active ? "Activa" : "Inactiva"}
																	</span>
																</a>
															))}
															{remainingRooms > 0 ? (
																<p class="px-4 py-3 text-xs font-medium text-slate-500">
																	+ {remainingRooms} habitación{remainingRooms === 1 ? "" : "es"}{" "}
																	más
																</p>
															) : null}
														</div>
													</div>
												) : null}
											</div>

											<aside
												class:list={[
													"border-t border-slate-200 bg-slate-50 p-5 md:p-6 lg:border-t-0 lg:border-l",
													showAside ? "" : "hidden",
												]}
												data-dashboard-ops-aside
											>
												<div class="flex h-full flex-col justify-between gap-6">
													<div
														class:list={[
															"grid grid-cols-2 gap-3",
															showInventoryStats ? "" : "hidden",
														]}
														data-inventory-stats
													>
														<div>
															<p class="text-xs font-medium text-slate-500">Activas</p>
															<p class="mt-1 text-xl font-semibold text-slate-950">{activeCount}</p>
														</div>
														<div>
															<p class="text-xs font-medium text-slate-500">Inactivas</p>
															<p class="mt-1 text-xl font-semibold text-slate-950">
																{inactiveCount}
															</p>
														</div>
													</div>
													<div
														class:list={["flex flex-col gap-2", showOpsActions ? "" : "hidden"]}
														data-ops-actions
													>
														<Button
															href={primaryHref}
															data-astro-prefetch
															variant="secondary"
															className="w-full"
														>
															{primaryLabel}
														</Button>
														{isChoosingForAddRoom ? (
															<Button
																href={routes.productRoomsForProduct(product.id)}
																data-astro-prefetch
																variant="secondary"
																className="w-full"
															>
																Ver habitaciones
															</Button>
														) : (
															<Button
																href={accommodationHref}
																data-astro-prefetch
																variant="secondary"
																className="w-full"
															>
																{isTour ? "Abrir tour" : "Abrir alojamiento"}
															</Button>
														)}
													</div>
												</div>
											</aside>
										</div>
									</Card>
								)
							})}
						</div>
					</>
				)
			}
		</div>

		{
			showAddAnotherService ? (
				<section>
					<div class="flex min-h-28 flex-col justify-between gap-4 rounded-[var(--fastt-radius-panel)] bg-white px-5 py-4 shadow-sm ring-1 ring-slate-900/[0.06] sm:flex-row sm:items-center">
						<div class="flex min-w-0 gap-3">
							<span class="fastt-section-icon">
								<Plus class="size-4" aria-hidden="true" />
							</span>
							<div>
								<h2 class="text-base font-semibold text-slate-950">¿Administras otro servicio?</h2>
								<p class="mt-1 text-sm leading-6 text-slate-500">{addAnotherServiceCopy()}</p>
							</div>
						</div>
						<Button
							href="/product/create?playbook=launch&step=create&flow=create"
							variant="secondary"
						>
							Agregar otro servicio
						</Button>
					</div>
				</section>
			) : null
		}
	</section>
</Layout>

<script>
	const productCards = Array.from(
		document.querySelectorAll<HTMLElement>("[data-dashboard-product-card][data-product-id]")
	)
	const productIds = productCards.map((card) => card.dataset.productId).filter(Boolean)

	function preparationMessage(preparation: any, isTour: boolean) {
		if (!preparation)
			return `Revisa la preparación del ${isTour ? "tour" : "alojamiento"} antes de publicarlo.`
		if (preparation.isPublished) {
			return isTour ? "Publicado y visible para viajeros." : "Publicado y visible para huéspedes."
		}
		if (preparation.readyToPublish) return "Preparación completa. Revisa la vista previa y publica."
		if (Number(preparation.blockerCount ?? 0) > 0) {
			const preview = Array.isArray(preparation.blockerPreview)
				? preparation.blockerPreview.map((label: unknown) => String(label).toLowerCase()).join(", ")
				: ""
			return `Faltan ${preparation.blockerCount} paso${preparation.blockerCount === 1 ? "" : "s"}${preview ? `: ${preview}` : ""}.`
		}
		return `${Math.round(Number(preparation.readinessPercent ?? 0))}% de preparación completada.`
	}

	function preparationSupport(roomCount: number, preparation: any, isTour: boolean) {
		if (roomCount === 0) {
			return isTour
				? "Crea la primera salida para definir fecha, cupo, precio y disponibilidad desde el flujo guiado."
				: "Crea la primera habitación para definir capacidad, fotos, tarifa y disponibilidad desde el flujo guiado."
		}
		if (preparation?.readyToPublish) {
			return "La ficha ya tiene lo esencial. Revisa la experiencia final antes de publicarla."
		}
		if (Number(preparation?.blockerCount ?? 0) > 0) {
			return `Continúa por el primer pendiente y vuelve aquí para revisar ${isTour ? "salidas" : "habitaciones"}.`
		}
		return `Mantén ${isTour ? "salidas, cupos" : "habitaciones"}, tarifas y disponibilidad actualizadas desde sus herramientas operativas.`
	}

	function setActionLabel(action: HTMLElement, label: string) {
		const textNodes = Array.from(action.childNodes).filter(
			(node) => node.nodeType === Node.TEXT_NODE
		)
		const textNode =
			textNodes.find((node) => String(node.textContent ?? "").trim().length > 0) ?? textNodes[0]
		if (textNode) {
			textNode.textContent = label
		} else {
			action.prepend(document.createTextNode(label))
		}
	}

	const cardSplitClass = "lg:grid-cols-[minmax(0,1fr)_280px]"

	function syncCardChrome(card: HTMLElement, preparation: any) {
		const isChoosing = card.dataset.choosingAddRoom === "true"
		const roomCount = Number(
			card.querySelector<HTMLElement>("[data-room-count]")?.dataset.roomCount ?? 0
		)
		const isPublished = Boolean(preparation?.isPublished)
		const showInventory = roomCount > 0
		const showOps = isChoosing || isPublished
		const showAside = isChoosing || showInventory || showOps
		card
			.querySelector<HTMLElement>("[data-dashboard-card-grid]")
			?.classList.toggle(cardSplitClass, showAside)
		card
			.querySelector<HTMLElement>("[data-dashboard-ops-aside]")
			?.classList.toggle("hidden", !showAside)
		card
			.querySelector<HTMLElement>("[data-inventory-stats]")
			?.classList.toggle("hidden", !showInventory)
		card.querySelector<HTMLElement>("[data-ops-actions]")?.classList.toggle("hidden", !showOps)
	}

	function updatePreparationCard(card: HTMLElement, preparation: any) {
		const roomCount = Number(
			card.querySelector<HTMLElement>("[data-room-count]")?.dataset.roomCount ?? 0
		)
		const isTour = card.dataset.productVertical === "tour"
		const message = card.querySelector<HTMLElement>("[data-preparation-message]")
		const support = card.querySelector<HTMLElement>("[data-preparation-support]")
		const nextStep = card.querySelector<HTMLElement>("[data-preparation-next-step]")
		const action = card.querySelector<HTMLAnchorElement>("[data-preparation-action]")
		const progressContainer = card.querySelector<HTMLElement>("[data-preparation-progress]")
		const progressBar = progressContainer?.querySelector<HTMLElement>('[role="progressbar"]')
		const progressValue = progressBar?.querySelector<HTMLElement>(".fastt-progress-value")
		const readinessPercent = Math.max(0, Math.min(100, Number(preparation?.readinessPercent ?? 0)))

		if (message) message.textContent = preparationMessage(preparation, isTour)
		if (support) support.textContent = preparationSupport(roomCount, preparation, isTour)
		if (nextStep) {
			nextStep.textContent = preparation?.nextStepLabel ?? ""
			nextStep.classList.toggle("hidden", !preparation?.nextStepLabel)
		}
		if (action) {
			const isPublished = Boolean(preparation?.isPublished)
			const isReadyToPublish = !isPublished && Boolean(preparation?.readyToPublish)
			const isSetup = !isPublished && !isReadyToPublish
			if (isSetup) {
				const savedHref = card.dataset.savedPreparationHref
				action.href = savedHref || preparation.continuePreparationHref || action.href
				setActionLabel(action, "Continuar preparación")
			} else if (isReadyToPublish) {
				action.href = preparation.previewHref
				setActionLabel(action, "Revisar y publicar")
			}
		}
		if (progressContainer)
			progressContainer.classList.toggle("hidden", Boolean(preparation?.isPublished))
		if (progressBar) progressBar.setAttribute("aria-valuenow", String(readinessPercent))
		if (progressValue) progressValue.style.width = `${readinessPercent}%`
		syncCardChrome(card, preparation)
	}

	if (productIds.length > 0) {
		window
			.fetch("/api/internal/product-preparation-refresh", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ productIds }),
			})
			.then((response) => (response.ok ? response.json() : null))
			.then((payload) => {
				if (!payload || !Array.isArray(payload.products)) return
				const byProductId = new Map(
					payload.products.map((preparation: any) => [String(preparation.productId), preparation])
				)
				for (const card of productCards) {
					const productId = card.dataset.productId
					const preparation = productId ? byProductId.get(productId) : null
					if (preparation) updatePreparationCard(card, preparation)
				}
			})
			.catch(() => {})
	}
</script>
