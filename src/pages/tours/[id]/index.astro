---
import Badge from "@/components/ui/Badge.astro"
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import TourDepartureSection from "@/components/tours/TourDepartureSection.astro"
import { SERVICE_CATALOG } from "@/data/service/service-catalog"
import { searchOffers } from "@/container"
import Layout from "@/layouts/Layout.astro"
import { tourDifficultyLabel } from "@/lib/tours/tourDifficulty"
import { tourDepartureToStay } from "@/lib/tours/tourSemantics"
import { publicCatalogProductEligibility } from "@/lib/marketplace/public-catalog-eligibility"
import {
	buildAgeBandPriceBreakdown,
	parseTourTicketQuantitiesFromSearchParams,
	tourCupoUnits,
	tourTicketsToOccupancyDetail,
} from "@/lib/tours/tourTicketOccupancy"
import {
	buildPolicySnapshot,
	derivePolicySummaryFromResolvedPolicies,
	resolveEffectivePolicies,
} from "@/modules/policies/public"
import type { ImageRow, ServiceRow } from "@/types/products"
import {
	and,
	asc,
	avg,
	count,
	db,
	desc,
	eq,
	GeoPlace,
	first,
	Image,
	inArray,
	lte,
	or,
	isNull,
	Product,
	Provider,
	ProductGeoPlace,
	ProductCategory,
	ProductCategoryLink,
	ProductContent,
	ProductLocation,
	ProductReview,
	ProductImage,
	ProductService,
	RatePlanOccupancyPolicy,
	gt,
	Tour,
	TourSlotProfile,
	TourTicketType,
	Variant,
} from "@/shared/infrastructure/db/compat"

const url = Astro.url
const productId = Astro.params.id
let product: any = null
let images: ImageRow[] = []
let subtype: any = null
let description: string | null = null
let services: Array<ServiceRow & { iconId?: string | null }> = []
let errorMessage: string | null = null
let productType = ""

function toISODateOnly(d: Date) {
	return d.toISOString().slice(0, 10)
}

function asStringList(value: unknown): string[] {
	if (!Array.isArray(value)) return []
	return value
		.map((item) => {
			if (typeof item === "string") return item.trim()
			if (item && typeof item === "object") {
				return String((item as any).description ?? (item as any).name ?? "").trim()
			}
			return ""
		})
		.filter(Boolean)
}

function fieldFromObject(value: unknown, key: string) {
	if (!value || typeof value !== "object") return ""
	return String((value as any)[key] ?? "").trim()
}

if (!productId) return Astro.redirect("/tours")

const departureStr = url.searchParams.get("departure")
const quantities = parseTourTicketQuantitiesFromSearchParams(url.searchParams)
// Legacy participants → adults
if (
	!url.searchParams.has("adults") &&
	!url.searchParams.has("adult") &&
	url.searchParams.has("participants")
) {
	quantities.adult = Math.max(1, Number(url.searchParams.get("participants") ?? 1) || 1)
}

if (!departureStr) {
	const today = new Date()
	const qs = new URLSearchParams({
		departure: toISODateOnly(today),
		adults: String(quantities.adult || 1),
		children: String(quantities.child || 0),
		infants: String(quantities.infant || 0),
	})
	if (quantities.custom) qs.set("custom", String(quantities.custom))
	return Astro.redirect(`/tours/${productId}?${qs.toString()}`)
}

let stay
try {
	stay = tourDepartureToStay(departureStr)
} catch {
	const today = new Date()
	return Astro.redirect(
		`/tours/${productId}?departure=${toISODateOnly(today)}&adults=${quantities.adult || 1}`
	)
}

const ticketTypes = await db
	.select()
	.from(TourTicketType)
	.where(and(eq(TourTicketType.productId, productId), eq(TourTicketType.isActive, true)))
	.orderBy(asc(TourTicketType.sortOrder), asc(TourTicketType.code))

const ticketBands = ticketTypes.map((t) => ({
	code: String(t.code),
	label: String(t.label),
	minAge: t.minAge == null ? null : Number(t.minAge),
	maxAge: t.maxAge == null ? null : Number(t.maxAge),
	isActive: Boolean(t.isActive),
}))

const occupancyDetail = tourTicketsToOccupancyDetail({
	tickets: ticketBands.length ? ticketBands : [{ code: "adult", label: "Adulto", isActive: true }],
	quantities,
})
const cupoUnits = tourCupoUnits({
	tickets: ticketBands.length ? ticketBands : [{ code: "adult", label: "Adulto", isActive: true }],
	quantities,
})

const offers = await searchOffers({
	productId,
	checkIn: stay.checkIn,
	checkOut: stay.checkOut,
	adults: occupancyDetail.adults,
	children: occupancyDetail.children,
	rooms: cupoUnits,
	featureContext: {
		request: Astro.request,
		query: url.searchParams,
	},
})

try {
	const productResult = await db
		.select()
		.from(Product)
		.innerJoin(Provider, eq(Provider.id, Product.providerId))
		.leftJoin(
			ProductGeoPlace,
			and(
				eq(ProductGeoPlace.productId, Product.id),
				eq(ProductGeoPlace.role, "primary_discovery"),
				eq(ProductGeoPlace.isPrimary, true)
			)
		)
		.leftJoin(GeoPlace, eq(GeoPlace.id, ProductGeoPlace.placeId))
		.leftJoin(ProductLocation, eq(ProductLocation.productId, Product.id))
		.leftJoin(
			ProductContent,
			and(eq(ProductContent.productId, Product.id), eq(ProductContent.dataClass, "production"))
		)
		.where(
			and(
				eq(Product.id, productId),
				publicCatalogProductEligibility(),
				eq(Product.publicationState, "published")
			)
		)
		.then(first)

	if (!productResult) return Astro.redirect("/tours")

	productType = String(productResult.Product.productType ?? "")
		.trim()
		.toLowerCase()
	if (productType !== "tour") return Astro.redirect("/tours")

	product = {
		...productResult.Product,
		destination: productResult.GeoPlace
			? { ...productResult.GeoPlace, name: productResult.GeoPlace.canonicalName }
			: null,
		location: productResult.ProductLocation,
	}
	description = productResult.ProductContent?.description ?? null

	const servicesResult = await db
		.select({ id: ProductService.serviceId })
		.from(ProductService)
		.where(eq(ProductService.productId, productId))

	const catalogById = new Map(SERVICE_CATALOG.map((s) => [s.id, s]))

	services = (servicesResult ?? [])
		.filter((s) => s.id)
		.map((s) => {
			const def = catalogById.get(String(s.id))
			return {
				id: String(s.id),
				name: def?.name ?? String(s.id),
				iconId: def?.id ?? null,
			}
		})

	images = await db
		.select({
			id: Image.id,
			url: Image.url,
			objectKey: Image.objectKey,
			isPrimary: ProductImage.isPrimary,
			order: ProductImage.sortOrder,
		})
		.from(ProductImage)
		.innerJoin(Image, eq(Image.id, ProductImage.imageId))
		.where(eq(ProductImage.productId, productId))
		.orderBy(asc(ProductImage.sortOrder))

	subtype = await db.select().from(Tour).where(eq(Tour.productId, productId)).then(first)
} catch (e) {
	console.error("Error al obtener detalles del tour:", e)
	errorMessage = e instanceof Error ? e.message : "Error desconocido"
}

const productData = product ? { ...product, images, subtype, services, description } : null

const itinerarySteps = asStringList(productData?.subtype?.itineraryJson)
const includes = asStringList(productData?.subtype?.includesJson)
const excludes = asStringList(productData?.subtype?.excludesJson)
const categoryRows = productId
	? await db
			.select({ name: ProductCategory.name, slug: ProductCategory.slug })
			.from(ProductCategoryLink)
			.innerJoin(ProductCategory, eq(ProductCategory.id, ProductCategoryLink.categoryId))
			.where(
				and(
					eq(ProductCategoryLink.productId, productId),
					eq(ProductCategory.vertical, "tour"),
					eq(ProductCategory.isActive, true)
				)
			)
			.orderBy(asc(ProductCategory.sortOrder), asc(ProductCategory.name))
	: []
const categories = categoryRows.map((row) => String(row.name)).filter(Boolean)
const meetingAddress = fieldFromObject(productData?.subtype?.meetingPointJson, "address")
const meetingInstructions = fieldFromObject(productData?.subtype?.meetingPointJson, "instructions")
const meetingLat = fieldFromObject(productData?.subtype?.meetingPointJson, "lat")
const meetingLng = fieldFromObject(productData?.subtype?.meetingPointJson, "lng")
const pickupArea = fieldFromObject(productData?.subtype?.pickupJson, "defaultArea")
const pickupInstructions = fieldFromObject(productData?.subtype?.pickupJson, "instructions")
const guideLanguages = fieldFromObject(productData?.subtype?.guideJson, "languages")
const guideType = fieldFromObject(productData?.subtype?.guideJson, "guideType")
const safetyRequirements = fieldFromObject(productData?.subtype?.safetyJson, "requirements")
const safetyWarnings = fieldFromObject(productData?.subtype?.safetyJson, "warnings")
const beforeYouBook = [
	safetyRequirements ? `Requisitos: ${safetyRequirements}` : "",
	safetyWarnings ? `Advertencias: ${safetyWarnings}` : "",
	pickupInstructions ? `Pickup: ${pickupInstructions}` : "",
	meetingInstructions ? `Encuentro: ${meetingInstructions}` : "",
].filter(Boolean)

const offerVariantIds = Array.from(
	new Set(offers.map((offer: any) => String(offer?.variantId ?? "")).filter(Boolean))
)
const slotRows =
	offerVariantIds.length > 0
		? await db
				.select({
					variantId: Variant.id,
					name: Variant.name,
					departureTime: TourSlotProfile.departureTime,
					maxPax: TourSlotProfile.maxPax,
					languageCode: TourSlotProfile.languageCode,
					bookingMode: TourSlotProfile.bookingMode,
				})
				.from(Variant)
				.leftJoin(TourSlotProfile, eq(TourSlotProfile.variantId, Variant.id))
				.where(inArray(Variant.id, offerVariantIds))
		: []

const slotsByVariantId = Object.fromEntries(
	slotRows.map((row) => [
		String(row.variantId),
		{
			name: row.name,
			departureTime: row.departureTime,
			maxPax: row.maxPax,
			languageCode: row.languageCode,
			bookingMode: row.bookingMode,
		},
	])
)

const firstOffer = offers[0] as any
const firstRatePlanId = String(
	firstOffer?.ratePlans?.[0]?.ratePlanId ?? firstOffer?.ratePlans?.[0]?.id ?? ""
).trim()
const firstVariantId = String(firstOffer?.variantId ?? "").trim()
const firstDepartureTime = String(slotsByVariantId[firstVariantId]?.departureTime ?? "09:00").trim()

let policySummary = ""
let freeCancelDeadline: string | null = null
/** Badges only when backed by persisted rows (policy / productType / TourSlotProfile). */
let badges: Array<{
	label: string
	variant: "success" | "info" | "neutral" | "warning"
	source: string
}> = []

if (firstRatePlanId && productId) {
	try {
		const resolved = await resolveEffectivePolicies({
			productId,
			variantId: firstVariantId || undefined,
			ratePlanId: firstRatePlanId,
			checkIn: stay.checkIn.toISOString().slice(0, 10),
			checkOut: stay.checkOut.toISOString().slice(0, 10),
			channel: "web",
		})
		policySummary = derivePolicySummaryFromResolvedPolicies(resolved)
		const snapshot = buildPolicySnapshot({
			resolvedPolicies: resolved,
			checkIn: stay.checkIn.toISOString().slice(0, 10),
			checkOut: stay.checkOut.toISOString().slice(0, 10),
			channel: "web",
			departureTime: firstDepartureTime,
		})
		freeCancelDeadline =
			snapshot.cancellation?.calculation?.cancellation?.freeCancellationDeadlineLocal ?? null
		if (snapshot.cancellation) {
			const cancelText = policySummary.toLowerCase()
			if (cancelText.includes("gratis") || cancelText.includes("flexible")) {
				badges.push({
					label: "Cancelación flexible",
					variant: "success",
					source: "BookingPolicySnapshot/cancellation",
				})
			} else if (cancelText.includes("no reembolsable")) {
				badges.push({
					label: "No reembolsable",
					variant: "warning",
					source: "BookingPolicySnapshot/cancellation",
				})
			} else {
				badges.push({
					label: "Política de cancelación",
					variant: "info",
					source: "PolicyAssignment→cancellation",
				})
			}
		}
	} catch {
		/* no cancellation badge without a resolved policy */
	}
}
// Tours issue BookingVoucher on confirm — persisted Product.productType.
if (productType === "tour") {
	badges.push({ label: "Voucher móvil", variant: "info", source: "Product.productType=tour" })
}
// Instant confirm path for published salidas with TourSlotProfile.
const hasSlotProfile = offerVariantIds.some((id) => Boolean(slotsByVariantId[id]?.departureTime))
if (hasSlotProfile) {
	badges.push({
		label: "Confirmación inmediata",
		variant: "success",
		source: "TourSlotProfile.departureTime",
	})
}

const todayIso = new Date().toISOString().slice(0, 10)
const occupancyPolicy = firstRatePlanId
	? await db
			.select({
				baseAmount: RatePlanOccupancyPolicy.baseAmount,
				baseAdults: RatePlanOccupancyPolicy.baseAdults,
				baseChildren: RatePlanOccupancyPolicy.baseChildren,
				extraAdultValue: RatePlanOccupancyPolicy.extraAdultValue,
				childMode: RatePlanOccupancyPolicy.childMode,
				childValue: RatePlanOccupancyPolicy.childValue,
			})
			.from(RatePlanOccupancyPolicy)
			.where(
				and(
					eq(RatePlanOccupancyPolicy.ratePlanId, firstRatePlanId),
					lte(RatePlanOccupancyPolicy.effectiveFrom, new Date(`${todayIso}T00:00:00.000Z`)),
					or(
						isNull(RatePlanOccupancyPolicy.effectiveTo),
						gt(RatePlanOccupancyPolicy.effectiveTo, new Date(`${todayIso}T00:00:00.000Z`))
					)
				)
			)
			.orderBy(desc(RatePlanOccupancyPolicy.effectiveFrom))
			.then(first)
	: null

const priceBreakdown = buildAgeBandPriceBreakdown({
	tickets: ticketBands.length ? ticketBands : [{ code: "adult", label: "Adulto", isActive: true }],
	quantities,
	policy: occupancyPolicy
		? {
				baseAmount: Number(occupancyPolicy.baseAmount ?? 0),
				baseAdults: Number(occupancyPolicy.baseAdults ?? 1),
				baseChildren: Number(occupancyPolicy.baseChildren ?? 0),
				extraAdultValue:
					occupancyPolicy.extraAdultValue == null ? null : Number(occupancyPolicy.extraAdultValue),
				childMode: occupancyPolicy.childMode == null ? null : String(occupancyPolicy.childMode),
				childValue: occupancyPolicy.childValue == null ? null : Number(occupancyPolicy.childValue),
			}
		: null,
})

const reviewAgg = await db
	.select({
		avgRating: avg(ProductReview.rating),
		reviewCount: count(),
	})
	.from(ProductReview)
	.where(and(eq(ProductReview.productId, productId), eq(ProductReview.status, "published")))
	.then(first)

const recentReviews = await db
	.select({
		id: ProductReview.id,
		rating: ProductReview.rating,
		body: ProductReview.body,
		createdAt: ProductReview.createdAt,
	})
	.from(ProductReview)
	.where(and(eq(ProductReview.productId, productId), eq(ProductReview.status, "published")))
	.orderBy(desc(ProductReview.createdAt))
	.limit(3)

const avgRating =
	reviewAgg?.avgRating == null ? null : Number(Number(reviewAgg.avgRating).toFixed(1))
const reviewCount = Number(reviewAgg?.reviewCount ?? 0)

const searchState = {
	departureDate: departureStr,
	quantities,
	occupancyDetail,
	cupoUnits,
}

const breadcrumbItems = [
	{ name: "Home", href: "/" },
	{ name: "Tours", href: "/tours" },
	{
		name: productData?.name || "/",
		href: `/tours/${productId}`,
		current: true,
	},
]

const mapsQuery = encodeURIComponent(
	[meetingAddress, productData?.destination?.name].filter(Boolean).join(", ")
)
const mapEmbed =
	meetingLat && meetingLng
		? `https://www.openstreetmap.org/export/embed.html?bbox=${Number(meetingLng) - 0.01}%2C${Number(meetingLat) - 0.01}%2C${Number(meetingLng) + 0.01}%2C${Number(meetingLat) + 0.01}&layer=mapnik&marker=${meetingLat}%2C${meetingLng}`
		: meetingAddress
			? `https://www.openstreetmap.org/export/embed.html?bbox=-180%2C-85%2C180%2C85&layer=mapnik`
			: null
---

<Layout
	title={productData?.name || "Tour"}
	description={description ||
		`Información de la experiencia ${productData?.name || "seleccionada"}.`}
	canonicalPath={productData ? `/tours/${encodeURIComponent(productId)}` : undefined}
	structuredData={productData
		? {
				"@context": "https://schema.org",
				"@type": "TouristTrip",
				"name": productData.name,
				"url": new URL(`/tours/${encodeURIComponent(productId)}`, Astro.url.origin).href,
				"description": description || undefined,
			}
		: undefined}
>
	<main class="mx-auto min-h-screen max-w-7xl space-y-10 p-4 lg:p-12">
		<Breadcrumbs items={breadcrumbItems} />

		{
			errorMessage ? (
				<div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
					<h1 class="mb-4 text-4xl font-bold text-red-500">{errorMessage}</h1>
					<a
						href="/tours"
						class="rounded-[var(--fastt-radius-card)] border border-gray-500 px-6 py-3 transition hover:bg-gray-800 hover:text-white"
					>
						Volver a tours
					</a>
				</div>
			) : productData ? (
				<>
					<div class="relative overflow-hidden rounded-[var(--fastt-radius-panel)] shadow-lg">
						<img
							id="gallery-main-img"
							src={productData.images[0]?.url || "https://placehold.co/1200x675?text=Sin+imagen"}
							alt={productData.name}
							class="h-96 w-full cursor-pointer object-cover transition-transform duration-700 hover:scale-105"
						/>
					</div>

					{productData.images.length > 1 && (
						<div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-6">
							{productData.images.map((img: ImageRow, i: number) => (
								<img
									src={img.url}
									alt={`Imagen ${i + 1}`}
									class="thumb-img h-24 w-full cursor-pointer rounded-[var(--fastt-radius-card)] object-cover hover:opacity-80"
									data-index={i}
								/>
							))}
						</div>
					)}

					<section class="fastt-card space-y-4 rounded-[var(--fastt-radius-panel)] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
						<div class="flex flex-wrap items-start justify-between gap-4">
							<div class="space-y-2">
								<h1 class="text-4xl font-bold tracking-tight text-slate-950">{productData.name}</h1>
								<p class="text-slate-600">
									{productData.location?.address ?? (meetingAddress || "Ubicación por confirmar")}
									{productData.destination?.name ? `, ${productData.destination.name}` : ""}
								</p>
								{avgRating != null && reviewCount > 0 ? (
									<p class="text-sm font-medium text-slate-800">
										★ {avgRating}
										<span class="font-normal text-slate-500">
											{" "}
											· {reviewCount} reseñas publicadas
										</span>
									</p>
								) : (
									<p class="text-sm text-slate-500">Aún sin reseñas publicadas</p>
								)}
							</div>
							<div class="flex flex-wrap gap-2">
								{badges.map((badge) => (
									<Badge variant={badge.variant} title={`Fuente: ${badge.source}`}>
										{badge.label}
									</Badge>
								))}
							</div>
						</div>

						<div class="flex flex-wrap gap-3 text-sm text-slate-700">
							{productData.subtype?.duration ? (
								<span class="rounded-md bg-slate-50 px-3 py-1 ring-1 ring-slate-200">
									Duración: {productData.subtype.duration}
									{productData.subtype.durationMinutes != null
										? ` (${productData.subtype.durationMinutes} min)`
										: ""}
								</span>
							) : null}
							{productData.subtype?.difficultyLevel ? (
								<span class="rounded-md bg-slate-50 px-3 py-1 ring-1 ring-slate-200">
									Nivel: {tourDifficultyLabel(productData.subtype.difficultyLevel)}
								</span>
							) : null}
							{guideLanguages ? (
								<span class="rounded-md bg-slate-50 px-3 py-1 ring-1 ring-slate-200">
									Idiomas: {guideLanguages}
								</span>
							) : null}
							{guideType ? (
								<span class="rounded-md bg-slate-50 px-3 py-1 ring-1 ring-slate-200">
									Guía: {guideType}
								</span>
							) : null}
						</div>

						{policySummary ? (
							<div class="fastt-soft-box rounded-[var(--fastt-radius-card)] border border-slate-200 bg-slate-50 p-4">
								<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
									Cancelación
								</p>
								<p class="mt-1 text-sm font-medium text-slate-900">{policySummary}</p>
								{freeCancelDeadline ? (
									<p class="mt-1 text-xs text-slate-600">Cutoff local: {freeCancelDeadline}</p>
								) : null}
							</div>
						) : null}

						{categories.length > 0 && (
							<ul class="flex flex-wrap gap-2">
								{categories.map((c) => (
									<li class="rounded-full bg-slate-900 px-3 py-1 text-xs text-white">{c}</li>
								))}
							</ul>
						)}

						{description ? <p class="leading-relaxed text-slate-700">{description}</p> : null}
					</section>

					<section id="booking">
						<TourDepartureSection
							productId={productId}
							offers={offers}
							slotsByVariantId={slotsByVariantId}
							searchState={searchState}
							ticketTypes={ticketBands}
							priceBreakdown={priceBreakdown}
							policySummary={policySummary}
						/>
					</section>

					{(meetingAddress || meetingInstructions || pickupArea) && (
						<section class="fastt-card space-y-4 rounded-[var(--fastt-radius-panel)] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
							<h2 class="text-2xl font-semibold text-slate-950">Punto de encuentro y pickup</h2>
							<div class="grid gap-6 lg:grid-cols-2">
								<div class="space-y-2 text-sm text-slate-700">
									{meetingAddress ? (
										<p>
											<strong>Encuentro:</strong> {meetingAddress}
										</p>
									) : null}
									{meetingInstructions ? <p>{meetingInstructions}</p> : null}
									{pickupArea ? (
										<p>
											<strong>Pickup:</strong> {pickupArea}
										</p>
									) : null}
									{pickupInstructions ? <p>{pickupInstructions}</p> : null}
									{meetingAddress ? (
										<a
											class="inline-flex text-sm font-semibold text-sky-800 hover:underline"
											href={`https://www.openstreetmap.org/search?query=${mapsQuery}`}
											target="_blank"
											rel="noreferrer"
										>
											Abrir en mapa
										</a>
									) : null}
								</div>
								{mapEmbed && meetingLat && meetingLng ? (
									<iframe
										title="Mapa del punto de encuentro"
										class="h-56 w-full rounded-[var(--fastt-radius-card)] border border-slate-200"
										src={mapEmbed}
										loading="lazy"
									/>
								) : meetingAddress ? (
									<div class="flex h-56 items-center justify-center rounded-[var(--fastt-radius-card)] border border-dashed border-slate-300 bg-slate-50 p-4 text-center text-sm text-slate-600">
										Dirección disponible: {meetingAddress}. Coordenadas no publicadas todavía.
									</div>
								) : null}
							</div>
						</section>
					)}

					{itinerarySteps.length > 0 && (
						<section class="fastt-card space-y-3 rounded-[var(--fastt-radius-panel)] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
							<h2 class="text-2xl font-semibold text-slate-950">Itinerario</h2>
							<ol class="list-decimal space-y-2 pl-5 text-slate-700">
								{itinerarySteps.map((step) => (
									<li>{step}</li>
								))}
							</ol>
						</section>
					)}

					{(includes.length > 0 || excludes.length > 0) && (
						<section class="grid gap-6 md:grid-cols-2">
							{includes.length > 0 ? (
								<div class="fastt-card rounded-[var(--fastt-radius-panel)] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
									<h2 class="mb-3 text-xl font-semibold text-slate-950">Incluye</h2>
									<ul class="list-disc space-y-1 pl-5 text-slate-700">
										{includes.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</div>
							) : null}
							{excludes.length > 0 ? (
								<div class="fastt-card rounded-[var(--fastt-radius-panel)] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
									<h2 class="mb-3 text-xl font-semibold text-slate-950">No incluye</h2>
									<ul class="list-disc space-y-1 pl-5 text-slate-700">
										{excludes.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</div>
							) : null}
						</section>
					)}

					{beforeYouBook.length > 0 && (
						<section class="fastt-card space-y-3 rounded-[var(--fastt-radius-panel)] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
							<h2 class="text-2xl font-semibold text-slate-950">Antes de reservar</h2>
							<ul class="list-disc space-y-2 pl-5 text-slate-700">
								{beforeYouBook.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</section>
					)}

					{recentReviews.length > 0 && (
						<section class="fastt-card space-y-4 rounded-[var(--fastt-radius-panel)] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
							<div class="flex items-end justify-between gap-3">
								<h2 class="text-2xl font-semibold text-slate-950">Reseñas</h2>
								{avgRating != null ? (
									<p class="text-sm text-slate-600">
										Promedio {avgRating} · {reviewCount} publicadas
									</p>
								) : null}
							</div>
							<ul class="space-y-3">
								{recentReviews.map((review) => (
									<li class="rounded-[var(--fastt-radius-card)] border border-slate-100 bg-slate-50 p-4">
										<p class="text-sm font-semibold text-slate-900">★ {Number(review.rating)}</p>
										{review.body ? (
											<p class="mt-1 text-sm leading-6 text-slate-700">{review.body}</p>
										) : null}
									</li>
								))}
							</ul>
						</section>
					)}

					<div
						id="gallery-modal"
						class="bg-opacity-90 fixed inset-0 z-50 hidden items-center justify-center bg-black"
					>
						<button
							id="modal-close"
							class="absolute top-5 right-6 text-3xl font-bold text-white hover:text-gray-400"
						>
							&times;
						</button>
						<button
							id="modal-prev"
							class="absolute left-6 text-4xl font-bold text-white hover:text-gray-400"
						>
							❮
						</button>
						<img
							id="modal-img"
							class="max-h-[80vh] max-w-[90vw] rounded-[var(--fastt-radius-card)] shadow-lg"
							alt="Vista ampliada"
						/>
						<button
							id="modal-next"
							class="absolute right-6 text-4xl font-bold text-white hover:text-gray-400"
						>
							❯
						</button>
					</div>
				</>
			) : (
				<p class="text-center text-gray-500">Cargando...</p>
			)
		}
	</main>

	<script>
		document.addEventListener("DOMContentLoaded", () => {
			const mainImg = document.getElementById("gallery-main-img") as HTMLImageElement | null
			const thumbImgs = Array.from(document.querySelectorAll<HTMLImageElement>(".thumb-img"))
			const modal = document.getElementById("gallery-modal") as HTMLElement | null
			const modalImg = document.getElementById("modal-img") as HTMLImageElement | null
			const modalClose = document.getElementById("modal-close") as HTMLElement | null
			const btnPrev = document.getElementById("modal-prev") as HTMLElement | null
			const btnNext = document.getElementById("modal-next") as HTMLElement | null

			let currentIndex = 0

			const openModal = (index: number) => {
				if (!modal || !modalImg || thumbImgs.length === 0) return
				currentIndex = index
				modalImg.src = thumbImgs[index]?.src || mainImg?.src || ""
				modal.classList.remove("hidden")
			}

			const closeModal = () => modal?.classList.add("hidden")

			const showPrev = () => {
				if (!modalImg || thumbImgs.length === 0) return
				currentIndex = (currentIndex - 1 + thumbImgs.length) % thumbImgs.length
				modalImg.src = thumbImgs[currentIndex].src
			}

			const showNext = () => {
				if (!modalImg || thumbImgs.length === 0) return
				currentIndex = (currentIndex + 1) % thumbImgs.length
				modalImg.src = thumbImgs[currentIndex].src
			}

			mainImg?.addEventListener("click", () => openModal(0))
			thumbImgs.forEach((thumb, i) => thumb.addEventListener("click", () => openModal(i)))
			modalClose?.addEventListener("click", closeModal)
			modal?.addEventListener("click", (e) => e.target === modal && closeModal())
			btnPrev?.addEventListener("click", (e) => {
				e.stopPropagation()
				showPrev()
			})
			btnNext?.addEventListener("click", (e) => {
				e.stopPropagation()
				showNext()
			})

			document.addEventListener("keydown", (e) => {
				if (modal?.classList.contains("hidden")) return
				if (e.key === "ArrowLeft") showPrev()
				if (e.key === "ArrowRight") showNext()
				if (e.key === "Escape") closeModal()
			})
		})
	</script>
</Layout>
