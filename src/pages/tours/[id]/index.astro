---
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import TourDepartureSection from "@/components/tours/TourDepartureSection.astro"
import TourGallery from "@/components/tours/TourGallery.astro"
import Badge from "@/components/ui/Badge.astro"
import { searchOffers } from "@/container"
import { SERVICE_CATALOG } from "@/data/service/service-catalog"
import Layout from "@/layouts/Layout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { publicCatalogProductEligibility } from "@/lib/marketplace/public-catalog-eligibility"
import { tourDifficultyLabel } from "@/lib/tours/tourDifficulty"
import { formatTourDuration, tourDepartureToStay } from "@/lib/tours/tourSemantics"
import {
	isValidTourParty,
	parseTourTicketQuantitiesFromSearchParams,
	tourCupoUnits,
	tourTicketsToOccupancyDetail,
} from "@/lib/tours/tourTicketOccupancy"
import {
	buildPolicySnapshot,
	derivePolicySummaryFromResolvedPolicies,
	resolveEffectivePolicies,
} from "@/modules/policies/public"
import { buildOccupancyKey } from "@/modules/search/public"
import {
	and,
	asc,
	avg,
	count,
	db,
	desc,
	eq,
	first,
	GeoPlace,
	gt,
	gte,
	Image,
	inArray,
	isNull,
	lt,
	or,
	Product,
	ProductCategory,
	ProductCategoryLink,
	ProductContent,
	ProductGeoPlace,
	ProductImage,
	ProductLocation,
	ProductReview,
	ProductService,
	Provider,
	SearchUnitView,
	Tour,
	TourSlotProfile,
	TourTicketType,
	Variant,
} from "@/shared/infrastructure/db/compat"
import type { ImageRow, ServiceRow } from "@/types/products"
import {
	Car,
	Check,
	Clock,
	ExternalLink,
	Gauge,
	Languages,
	MapPin,
	Route,
	ShieldCheck,
	UserRound,
	X,
} from "@lucide/astro"

const url = Astro.url
const productId = Astro.params.id
let product: any = null
let images: ImageRow[] = []
let subtype: any = null
let description: string | null = null
let services: Array<ServiceRow & { iconId?: string | null }> = []
let errorMessage: string | null = null
let productType = ""

function toISODateOnly(d: Date) {
	return d.toISOString().slice(0, 10)
}

function asStringList(value: unknown): string[] {
	if (!Array.isArray(value)) return []
	return value
		.map((item) => {
			if (typeof item === "string") return item.trim()
			if (item && typeof item === "object") {
				return String((item as any).description ?? (item as any).name ?? "").trim()
			}
			return ""
		})
		.filter(Boolean)
}

function fieldFromObject(value: unknown, key: string) {
	if (!value || typeof value !== "object") return ""
	return String((value as any)[key] ?? "").trim()
}

if (!productId) return Astro.redirect("/tours")

const requestedProviderPreview = url.searchParams.get("preview") === "provider"
const previewUser = requestedProviderPreview ? await getUserFromRequest(Astro.request) : null
const previewProviderId = previewUser
	? await getProviderIdFromRequest(Astro.request, previewUser)
	: null
const previewOwnership =
	requestedProviderPreview && previewProviderId
		? await db
				.select({ providerId: Product.providerId, productType: Product.productType })
				.from(Product)
				.where(and(eq(Product.id, productId), eq(Product.providerId, previewProviderId)))
				.then(first)
		: null
const isProviderPreview =
	Boolean(previewOwnership) &&
	String(previewOwnership?.productType ?? "")
		.trim()
		.toLowerCase() === "tour"
if (requestedProviderPreview && !isProviderPreview) return Astro.redirect("/tours")

const departureStr = url.searchParams.get("departure")
const quantities = parseTourTicketQuantitiesFromSearchParams(url.searchParams)
// Legacy participants → adults
if (
	!url.searchParams.has("adults") &&
	!url.searchParams.has("adult") &&
	url.searchParams.has("participants")
) {
	quantities.adult = Math.max(1, Number(url.searchParams.get("participants") ?? 1) || 1)
}

let stay
try {
	stay = tourDepartureToStay(departureStr || toISODateOnly(new Date()))
} catch {
	stay = tourDepartureToStay(toISODateOnly(new Date()))
}

const ticketTypes = await db
	.select()
	.from(TourTicketType)
	.where(and(eq(TourTicketType.productId, productId), eq(TourTicketType.isActive, true)))
	.orderBy(asc(TourTicketType.sortOrder), asc(TourTicketType.code))

const ticketBands = ticketTypes.map((t) => ({
	code: String(t.code),
	label: String(t.label),
	minAge: t.minAge == null ? null : Number(t.minAge),
	maxAge: t.maxAge == null ? null : Number(t.maxAge),
	isActive: Boolean(t.isActive),
}))

const occupancyDetail = tourTicketsToOccupancyDetail({
	tickets: ticketBands.length ? ticketBands : [{ code: "adult", label: "Adulto", isActive: true }],
	quantities,
})
const cupoUnits = tourCupoUnits({
	tickets: ticketBands.length ? ticketBands : [{ code: "adult", label: "Adulto", isActive: true }],
	quantities,
})
const validInitialParty = isValidTourParty({ occupancy: occupancyDetail, cupoUnits })

const offers =
	departureStr && validInitialParty
		? await searchOffers({
				productId,
				checkIn: stay.checkIn,
				checkOut: stay.checkOut,
				adults: occupancyDetail.adults,
				children: occupancyDetail.children,
				infants: occupancyDetail.infants,
				rooms: cupoUnits,
				featureContext: { request: Astro.request, query: url.searchParams },
			})
		: []

const alternativeDates: Array<{ date: string; label: string; href: string }> = []
if (departureStr && validInitialParty && offers.length === 0) {
	const windowEnd = new Date(`${departureStr}T00:00:00.000Z`)
	windowEnd.setUTCDate(windowEnd.getUTCDate() + 31)
	const rows = await db
		.select({ date: SearchUnitView.date })
		.from(SearchUnitView)
		.where(
			and(
				eq(SearchUnitView.productId, productId),
				eq(SearchUnitView.occupancyKey, buildOccupancyKey(occupancyDetail)),
				gt(SearchUnitView.date, departureStr),
				lt(SearchUnitView.date, windowEnd.toISOString().slice(0, 10)),
				eq(SearchUnitView.isAvailable, true),
				eq(SearchUnitView.hasAvailability, true),
				eq(SearchUnitView.hasPrice, true),
				gte(SearchUnitView.availableUnits, cupoUnits),
				or(isNull(SearchUnitView.primaryBlocker), eq(SearchUnitView.primaryBlocker, ""))
			)
		)
		.orderBy(asc(SearchUnitView.date))
		.limit(40)
	const uniqueDates = [...new Set(rows.map((row) => String(row.date)).filter(Boolean))].slice(0, 3)
	for (const date of uniqueDates) {
		const params = new URLSearchParams({
			departure: date,
			adults: String(quantities.adult ?? quantities.adulto ?? 0),
			children: String(quantities.child ?? 0),
			infants: String(quantities.infant ?? 0),
		})
		if (quantities.custom) params.set("custom", String(quantities.custom))
		alternativeDates.push({
			date,
			label: new Intl.DateTimeFormat("es-CL", {
				weekday: "short",
				day: "numeric",
				month: "short",
				timeZone: "UTC",
			}).format(new Date(`${date}T00:00:00.000Z`)),
			href: `/tours/${encodeURIComponent(productId)}?${params.toString()}`,
		})
	}
}

try {
	const productResult = await db
		.select()
		.from(Product)
		.innerJoin(Provider, eq(Provider.id, Product.providerId))
		.leftJoin(
			ProductGeoPlace,
			and(
				eq(ProductGeoPlace.productId, Product.id),
				eq(ProductGeoPlace.role, "primary_discovery"),
				eq(ProductGeoPlace.isPrimary, true)
			)
		)
		.leftJoin(GeoPlace, eq(GeoPlace.id, ProductGeoPlace.placeId))
		.leftJoin(ProductLocation, eq(ProductLocation.productId, Product.id))
		.leftJoin(
			ProductContent,
			and(eq(ProductContent.productId, Product.id), eq(ProductContent.dataClass, "production"))
		)
		.where(
			isProviderPreview
				? and(eq(Product.id, productId), eq(Product.providerId, String(previewProviderId)))
				: and(
						eq(Product.id, productId),
						publicCatalogProductEligibility(),
						eq(Product.publicationState, "published")
					)
		)
		.then(first)

	if (!productResult) return Astro.redirect("/tours")

	productType = String(productResult.Product.productType ?? "")
		.trim()
		.toLowerCase()
	if (productType !== "tour") return Astro.redirect("/tours")

	product = {
		...productResult.Product,
		operator: productResult.Provider
			? {
					name:
						productResult.Provider.displayName ||
						productResult.Provider.legalName ||
						"Operador local",
				}
			: null,
		destination: productResult.GeoPlace
			? { ...productResult.GeoPlace, name: productResult.GeoPlace.canonicalName }
			: null,
		location: productResult.ProductLocation,
	}
	description = productResult.ProductContent?.description ?? null

	const servicesResult = await db
		.select({ id: ProductService.serviceId })
		.from(ProductService)
		.where(eq(ProductService.productId, productId))

	const catalogById = new Map<string, (typeof SERVICE_CATALOG)[number]>(
		SERVICE_CATALOG.map((service) => [service.id, service])
	)

	services = (servicesResult ?? [])
		.filter((s) => s.id)
		.map((s) => {
			const def = catalogById.get(String(s.id))
			return {
				id: String(s.id),
				name: def?.name ?? String(s.id),
				iconId: def?.id ?? null,
			}
		})

	images = await db
		.select({
			id: Image.id,
			url: Image.url,
			objectKey: Image.objectKey,
			isPrimary: ProductImage.isPrimary,
			order: ProductImage.sortOrder,
		})
		.from(ProductImage)
		.innerJoin(Image, eq(Image.id, ProductImage.imageId))
		.where(eq(ProductImage.productId, productId))
		.orderBy(asc(ProductImage.sortOrder))

	subtype = await db.select().from(Tour).where(eq(Tour.productId, productId)).then(first)
} catch (e) {
	console.error("Error al obtener detalles del tour:", e)
	errorMessage = e instanceof Error ? e.message : "Error desconocido"
}

const productData = product ? { ...product, images, subtype, services, description } : null

const descriptionWords =
	String(description ?? "")
		.toLocaleLowerCase("es")
		.match(/[\p{L}\p{N}]+/gu) ?? []
const descriptionNeedsEditorialReview =
	descriptionWords.length < 12 ||
	new Set(descriptionWords).size < Math.max(4, Math.ceil(descriptionWords.length * 0.55))

const itinerarySteps = asStringList(productData?.subtype?.itineraryJson)
const includes = asStringList(productData?.subtype?.includesJson)
const excludes = asStringList(productData?.subtype?.excludesJson)
const categoryRows = productId
	? await db
			.select({ name: ProductCategory.name, slug: ProductCategory.slug })
			.from(ProductCategoryLink)
			.innerJoin(ProductCategory, eq(ProductCategory.id, ProductCategoryLink.categoryId))
			.where(
				and(
					eq(ProductCategoryLink.productId, productId),
					eq(ProductCategory.vertical, "tour"),
					eq(ProductCategory.isActive, true)
				)
			)
			.orderBy(asc(ProductCategory.sortOrder), asc(ProductCategory.name))
	: []
const categories = categoryRows.map((row) => String(row.name)).filter(Boolean)
const meetingAddress = fieldFromObject(productData?.subtype?.meetingPointJson, "address")
const meetingInstructions = fieldFromObject(productData?.subtype?.meetingPointJson, "instructions")
const meetingLat = fieldFromObject(productData?.subtype?.meetingPointJson, "lat")
const meetingLng = fieldFromObject(productData?.subtype?.meetingPointJson, "lng")
const pickupArea = fieldFromObject(productData?.subtype?.pickupJson, "defaultArea")
const pickupInstructions = fieldFromObject(productData?.subtype?.pickupJson, "instructions")
const guideLanguages = fieldFromObject(productData?.subtype?.guideJson, "languages")
const guideType = fieldFromObject(productData?.subtype?.guideJson, "guideType")
const safetyRequirements = fieldFromObject(productData?.subtype?.safetyJson, "requirements")
const safetyWarnings = fieldFromObject(productData?.subtype?.safetyJson, "warnings")
const beforeYouBook = [
	safetyRequirements ? `Requisitos: ${safetyRequirements}` : "",
	safetyWarnings ? `Advertencias: ${safetyWarnings}` : "",
].filter(Boolean)

const durationLabel = formatTourDuration({
	duration: productData?.subtype?.duration,
	durationMinutes: productData?.subtype?.durationMinutes,
})

const offerVariantIds = Array.from(
	new Set(offers.map((offer: any) => String(offer?.variantId ?? "")).filter(Boolean))
)
const slotRows =
	offerVariantIds.length > 0
		? await db
				.select({
					variantId: Variant.id,
					name: Variant.name,
					departureTime: TourSlotProfile.departureTime,
					maxPax: TourSlotProfile.maxPax,
					languageCode: TourSlotProfile.languageCode,
					bookingMode: TourSlotProfile.bookingMode,
				})
				.from(Variant)
				.leftJoin(TourSlotProfile, eq(TourSlotProfile.variantId, Variant.id))
				.where(inArray(Variant.id, offerVariantIds))
		: []

const slotsByVariantId = Object.fromEntries(
	slotRows.map((row) => [
		String(row.variantId),
		{
			name: row.name,
			departureTime: row.departureTime,
			maxPax: row.maxPax,
			languageCode: row.languageCode,
			bookingMode: row.bookingMode,
		},
	])
)

const firstOffer = offers[0] as any
const firstRatePlanId = String(
	firstOffer?.ratePlans?.[0]?.ratePlanId ?? firstOffer?.ratePlans?.[0]?.id ?? ""
).trim()
const firstVariantId = String(firstOffer?.variantId ?? "").trim()
const firstDepartureTime = String(slotsByVariantId[firstVariantId]?.departureTime ?? "09:00").trim()

let policySummary = ""
let freeCancelDeadline: string | null = null
/** Badges only when backed by persisted rows (policy / productType / TourSlotProfile). */
let badges: Array<{
	label: string
	variant: "success" | "info" | "neutral" | "warning"
	source: string
}> = []

if (firstRatePlanId && productId) {
	try {
		const resolved = await resolveEffectivePolicies({
			productId,
			variantId: firstVariantId || undefined,
			ratePlanId: firstRatePlanId,
			checkIn: stay.checkIn.toISOString().slice(0, 10),
			checkOut: stay.checkOut.toISOString().slice(0, 10),
			channel: "web",
		})
		policySummary = derivePolicySummaryFromResolvedPolicies(resolved)
		const snapshot = buildPolicySnapshot({
			resolvedPolicies: resolved,
			checkIn: stay.checkIn.toISOString().slice(0, 10),
			checkOut: stay.checkOut.toISOString().slice(0, 10),
			channel: "web",
			departureTime: firstDepartureTime,
		})
		freeCancelDeadline =
			snapshot.cancellation?.calculation?.cancellation?.freeCancellationDeadlineLocal ?? null
		if (snapshot.cancellation) {
			const cancelText = policySummary.toLowerCase()
			if (cancelText.includes("gratis") || cancelText.includes("flexible")) {
				badges.push({
					label: "Cancelación flexible",
					variant: "success",
					source: "BookingPolicySnapshot/cancellation",
				})
			} else if (cancelText.includes("no reembolsable")) {
				badges.push({
					label: "No reembolsable",
					variant: "warning",
					source: "BookingPolicySnapshot/cancellation",
				})
			} else {
				badges.push({
					label: "Política de cancelación",
					variant: "info",
					source: "PolicyAssignment→cancellation",
				})
			}
		}
	} catch {
		/* no cancellation badge without a resolved policy */
	}
}
// Tours issue BookingVoucher on confirm — persisted Product.productType.
if (productType === "tour") {
	badges.push({ label: "Voucher móvil", variant: "info", source: "Product.productType=tour" })
}

const reviewAgg = await db
	.select({
		avgRating: avg(ProductReview.rating),
		reviewCount: count(),
	})
	.from(ProductReview)
	.where(and(eq(ProductReview.productId, productId), eq(ProductReview.status, "published")))
	.then(first)

const recentReviews = await db
	.select({
		id: ProductReview.id,
		rating: ProductReview.rating,
		body: ProductReview.body,
		createdAt: ProductReview.createdAt,
	})
	.from(ProductReview)
	.where(and(eq(ProductReview.productId, productId), eq(ProductReview.status, "published")))
	.orderBy(desc(ProductReview.createdAt))
	.limit(3)

const avgRating =
	reviewAgg?.avgRating == null ? null : Number(Number(reviewAgg.avgRating).toFixed(1))
const reviewCount = Number(reviewAgg?.reviewCount ?? 0)

const searchState = {
	departureDate: departureStr ?? "",
	quantities,
	occupancyDetail,
	cupoUnits,
	selectedVariantId: String(url.searchParams.get("variantId") ?? ""),
	selectedRatePlanId: String(url.searchParams.get("ratePlanId") ?? ""),
}

const breadcrumbItems = [
	{ name: "Home", href: "/" },
	{ name: "Tours", href: "/tours" },
	{
		name: productData?.name || "/",
		href: `/tours/${productId}`,
		current: true,
	},
]

const mapsQuery = encodeURIComponent(
	[meetingAddress, productData?.destination?.name].filter(Boolean).join(", ")
)
const mapEmbed =
	meetingLat && meetingLng
		? `https://www.openstreetmap.org/export/embed.html?bbox=${Number(meetingLng) - 0.01}%2C${Number(meetingLat) - 0.01}%2C${Number(meetingLng) + 0.01}%2C${Number(meetingLat) + 0.01}&layer=mapnik&marker=${meetingLat}%2C${meetingLng}`
		: null
---

<Layout
	title={productData?.name || "Tour"}
	bodyClass="bg-white text-slate-950"
	description={description ||
		`Información de la experiencia ${productData?.name || "seleccionada"}.`}
	canonicalPath={productData && !isProviderPreview
		? `/tours/${encodeURIComponent(productId)}`
		: undefined}
	structuredData={productData && !isProviderPreview
		? {
				"@context": "https://schema.org",
				"@type": "TouristTrip",
				"name": productData.name,
				"url": new URL(`/tours/${encodeURIComponent(productId)}`, Astro.url.origin).href,
				"description": description || undefined,
			}
		: undefined}
>
	<main id="content" class="min-h-screen bg-white pb-24 text-slate-950 md:pb-16">
		<div class="mx-auto max-w-7xl space-y-7 px-4 py-5 sm:px-6 sm:py-8 lg:px-8">
			{
				isProviderPreview ? (
					<div
						class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-950"
						data-provider-preview-banner
					>
						<div>
							<p class="font-semibold">Vista previa privada del proveedor</p>
							<p>Esta es la misma plantilla pública. Las acciones de reserva están desactivadas.</p>
						</div>
						<a
							class="font-semibold underline"
							href={`/product/${encodeURIComponent(productId)}/preview`}
						>
							Volver a preparación
						</a>
					</div>
				) : null
			}
			{
				isProviderPreview && descriptionNeedsEditorialReview ? (
					<div
						class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950"
						data-preview-content-warning
					>
						<div>
							<p class="font-semibold">Revisión editorial pendiente</p>
							<p>La descripción aún es demasiado breve o repetitiva para una ficha pública.</p>
						</div>
						<a
							class="font-semibold underline"
							href={`/product/${encodeURIComponent(productId)}/content`}
						>
							Editar descripción
						</a>
					</div>
				) : null
			}
			<Breadcrumbs items={breadcrumbItems} tone="light" />

			{
				errorMessage ? (
					<div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
						<h1 class="mb-4 text-4xl font-bold text-red-500">{errorMessage}</h1>
						<a
							href="/tours"
							class="rounded-[var(--fastt-radius-card)] border border-gray-500 px-6 py-3 transition hover:bg-gray-800 hover:text-white"
						>
							Volver a tours
						</a>
					</div>
				) : productData ? (
					<>
						<header class="flex flex-wrap items-end justify-between gap-5">
							<div class="max-w-4xl min-w-0">
								<h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl lg:text-[2.75rem] lg:leading-tight">
									{productData.name}
								</h1>
								<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-600">
									{avgRating != null && reviewCount > 0 ? (
										<span class="font-semibold text-slate-900">
											★ {avgRating} · {reviewCount}{" "}
											{reviewCount === 1 ? "reseña publicada" : "reseñas publicadas"}
										</span>
									) : null}
									<span>
										{productData.destination?.name ??
											productData.location?.address ??
											meetingAddress ??
											"Ubicación por confirmar"}
									</span>
								</div>
							</div>
						</header>

						<TourGallery images={productData.images} title={productData.name} />

						<section class="border-b border-slate-200 pb-8 md:pb-10">
							<div class="flex flex-wrap items-start justify-between gap-4">
								<div>
									<p class="text-sm font-semibold text-orange-700">La experiencia</p>
									<h2 class="mt-1 text-2xl font-semibold tracking-tight text-slate-950">
										Lo esencial, antes de elegir una salida
									</h2>
								</div>
								<div class="flex flex-wrap gap-2">
									{badges.map((badge) => (
										<Badge variant={badge.variant} title={`Fuente: ${badge.source}`}>
											{badge.label}
										</Badge>
									))}
								</div>
							</div>

							{categories.length > 0 ? (
								<ul class="mt-5 flex flex-wrap gap-2" aria-label="Tipos de actividad">
									{categories.map((category) => (
										<li class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700">
											{category}
										</li>
									))}
								</ul>
							) : null}

							{description ? (
								<p class="mt-5 max-w-4xl text-base leading-7 text-slate-700 md:text-lg md:leading-8">
									{description}
								</p>
							) : null}

							{(durationLabel ||
								productData.subtype?.difficultyLevel ||
								guideLanguages ||
								guideType) && (
								<dl class="mt-7 grid gap-x-8 gap-y-5 border-y border-slate-200 py-6 sm:grid-cols-2 lg:grid-cols-4">
									{durationLabel ? (
										<div class="flex gap-3">
											<Clock class="mt-0.5 size-5 shrink-0 text-slate-500" aria-hidden="true" />
											<div>
												<dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
													Duración
												</dt>
												<dd class="mt-1 text-sm font-semibold text-slate-950">{durationLabel}</dd>
											</div>
										</div>
									) : null}
									{productData.subtype?.difficultyLevel ? (
										<div class="flex gap-3">
											<Gauge class="mt-0.5 size-5 shrink-0 text-slate-500" aria-hidden="true" />
											<div>
												<dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
													Nivel
												</dt>
												<dd class="mt-1 text-sm font-semibold text-slate-950">
													{tourDifficultyLabel(productData.subtype.difficultyLevel)}
												</dd>
											</div>
										</div>
									) : null}
									{guideLanguages ? (
										<div class="flex gap-3">
											<Languages class="mt-0.5 size-5 shrink-0 text-slate-500" aria-hidden="true" />
											<div>
												<dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
													Idiomas
												</dt>
												<dd class="mt-1 text-sm font-semibold text-slate-950">{guideLanguages}</dd>
											</div>
										</div>
									) : null}
									{guideType ? (
										<div class="flex gap-3">
											<UserRound class="mt-0.5 size-5 shrink-0 text-slate-500" aria-hidden="true" />
											<div>
												<dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
													Modalidad de guía
												</dt>
												<dd class="mt-1 text-sm font-semibold text-slate-950">
													{guideType.replace(/[_-]+/g, " ")}
												</dd>
											</div>
										</div>
									) : null}
								</dl>
							)}

							{productData.operator ? (
								<div class="mt-6 flex max-w-3xl items-start gap-4">
									<div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-orange-50 text-orange-800">
										<UserRound class="size-5" aria-hidden="true" />
									</div>
									<div>
										<p class="text-sm text-slate-500">Experiencia operada por</p>
										<p class="font-semibold text-slate-950">{productData.operator.name}</p>
										<p class="mt-1 text-sm leading-6 text-slate-600">
											Gestiona la salida, el encuentro y las indicaciones operativas del recorrido.
										</p>
									</div>
								</div>
							) : null}
						</section>

						<div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_24rem]">
							<aside id="booking" class="lg:sticky lg:top-6 lg:col-start-2 lg:row-start-1">
								<TourDepartureSection
									productId={productId}
									offers={offers}
									slotsByVariantId={slotsByVariantId}
									searchState={searchState}
									ticketTypes={ticketBands}
									alternativeDates={alternativeDates}
									previewMode={isProviderPreview}
									layout="rail"
								/>
							</aside>

							<div class="min-w-0 divide-y divide-slate-200 lg:col-start-1 lg:row-start-1">
								{meetingAddress || meetingInstructions || pickupArea || pickupInstructions ? (
									<section class="pb-9">
										<div class="flex items-center gap-3">
											<MapPin class="size-5 text-orange-700" aria-hidden="true" />
											<h2 class="text-2xl font-semibold tracking-tight text-slate-950">
												Encuentro y recogida
											</h2>
										</div>
										<div
											class:list={[
												"mt-5 grid gap-6",
												mapEmbed && "md:grid-cols-[minmax(0,1fr)_18rem]",
											]}
										>
											<div class="space-y-5 text-sm leading-6 text-slate-700">
												{meetingAddress || meetingInstructions ? (
													<div class="flex gap-3">
														<MapPin
															class="mt-0.5 size-4 shrink-0 text-slate-400"
															aria-hidden="true"
														/>
														<div>
															<p class="font-semibold text-slate-950">Punto de encuentro</p>
															{meetingAddress ? <p class="mt-1">{meetingAddress}</p> : null}
															{meetingInstructions ? (
																<p class="mt-1 text-slate-600">{meetingInstructions}</p>
															) : null}
														</div>
													</div>
												) : null}
												{pickupArea || pickupInstructions ? (
													<div class="flex gap-3">
														<Car class="mt-0.5 size-4 shrink-0 text-slate-400" aria-hidden="true" />
														<div>
															<p class="font-semibold text-slate-950">Recogida</p>
															{pickupArea ? <p class="mt-1">{pickupArea}</p> : null}
															{pickupInstructions ? (
																<p class="mt-1 text-slate-600">{pickupInstructions}</p>
															) : null}
														</div>
													</div>
												) : null}
												{meetingAddress ? (
													<a
														class="inline-flex items-center gap-2 font-semibold text-orange-800 underline-offset-4 hover:underline"
														href={`https://www.openstreetmap.org/search?query=${mapsQuery}`}
														target="_blank"
														rel="noreferrer"
													>
														Abrir ubicación en el mapa
														<ExternalLink class="size-4" aria-hidden="true" />
													</a>
												) : null}
											</div>
											{mapEmbed ? (
												<iframe
													title="Mapa del punto de encuentro"
													class="h-52 w-full rounded-xl border border-slate-200"
													src={mapEmbed}
													loading="lazy"
												/>
											) : null}
										</div>
									</section>
								) : null}

								{itinerarySteps.length > 0 ? (
									<section class="py-9">
										<div class="flex items-center gap-3">
											<Route class="size-5 text-orange-700" aria-hidden="true" />
											<h2 class="text-2xl font-semibold tracking-tight text-slate-950">
												Itinerario
											</h2>
										</div>
										<ol class="mt-6 space-y-0">
											{itinerarySteps.map((step, index) => (
												<li class="relative grid grid-cols-[2.25rem_minmax(0,1fr)] gap-3 pb-6 last:pb-0">
													{index < itinerarySteps.length - 1 ? (
														<span
															class="absolute top-8 bottom-0 left-[1.1rem] w-px bg-slate-200"
															aria-hidden="true"
														/>
													) : null}
													<span class="relative z-10 flex size-9 items-center justify-center rounded-full border border-slate-300 bg-white text-sm font-semibold text-slate-700">
														{index + 1}
													</span>
													<p class="pt-1.5 leading-6 text-slate-700">{step}</p>
												</li>
											))}
										</ol>
									</section>
								) : null}

								{includes.length > 0 || excludes.length > 0 ? (
									<section class="py-9">
										<h2 class="text-2xl font-semibold tracking-tight text-slate-950">
											Qué incluye
										</h2>
										<div
											class:list={[
												"mt-6 grid gap-7",
												includes.length > 0 && excludes.length > 0 && "sm:grid-cols-2",
											]}
										>
											{includes.length > 0 ? (
												<div>
													<h3 class="text-sm font-semibold text-slate-950">
														Incluido en la experiencia
													</h3>
													<ul class="mt-3 space-y-3">
														{includes.map((item) => (
															<li class="flex gap-3 text-sm leading-6 text-slate-700">
																<Check
																	class="mt-1 size-4 shrink-0 text-emerald-700"
																	aria-hidden="true"
																/>
																<span>{item}</span>
															</li>
														))}
													</ul>
												</div>
											) : null}
											{excludes.length > 0 ? (
												<div>
													<h3 class="text-sm font-semibold text-slate-950">No incluido</h3>
													<ul class="mt-3 space-y-3">
														{excludes.map((item) => (
															<li class="flex gap-3 text-sm leading-6 text-slate-700">
																<X class="mt-1 size-4 shrink-0 text-slate-400" aria-hidden="true" />
																<span>{item}</span>
															</li>
														))}
													</ul>
												</div>
											) : null}
										</div>
									</section>
								) : null}

								{beforeYouBook.length > 0 ? (
									<section class="py-9">
										<div class="flex items-center gap-3">
											<ShieldCheck class="size-5 text-orange-700" aria-hidden="true" />
											<h2 class="text-2xl font-semibold tracking-tight text-slate-950">
												Antes de reservar
											</h2>
										</div>
										<ul class="mt-5 space-y-3">
											{beforeYouBook.map((item) => (
												<li class="flex gap-3 text-sm leading-6 text-slate-700">
													<Check class="mt-1 size-4 shrink-0 text-slate-400" aria-hidden="true" />
													<span>{item}</span>
												</li>
											))}
										</ul>
									</section>
								) : null}

								{recentReviews.length > 0 ? (
									<section class="pt-9">
										<div class="flex flex-wrap items-end justify-between gap-3">
											<h2 class="text-2xl font-semibold tracking-tight text-slate-950">Reseñas</h2>
											{avgRating != null ? (
												<p class="text-sm text-slate-600">
													Promedio {avgRating} · {reviewCount} publicadas
												</p>
											) : null}
										</div>
										<ul class="mt-5 space-y-4">
											{recentReviews.map((review) => (
												<li class="rounded-xl bg-slate-50 p-5">
													<p class="text-sm font-semibold text-slate-900">
														★ {Number(review.rating)}
													</p>
													{review.body ? (
														<p class="mt-2 text-sm leading-6 text-slate-700">{review.body}</p>
													) : null}
												</li>
											))}
										</ul>
									</section>
								) : null}
							</div>
						</div>
					</>
				) : (
					<p class="text-center text-gray-500">Cargando...</p>
				)
			}
		</div>
	</main>
</Layout>
