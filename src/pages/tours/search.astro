---
import ProductCard from "@/components/productUI/ProductCard.astro"
import Notice from "@/components/ui/Notice.astro"
import SearchLayout from "@/layouts/SearchLayout.astro"
import { tourDifficultyLabel } from "@/lib/tours/tourDifficulty"
import { getTourSearchSurface } from "@/lib/tours/tourSearchSurface"
import { db, Destination, eq, or } from "@/shared/infrastructure/db/compat"

const url = new URL(Astro.request.url)
const params = url.searchParams
const destinationId = params.get("destinationId") || params.get("destinationQuery") || null
const startDate = params.get("startDate") || params.get("checkin") || null
const durationBucket = params.get("duration") || null
const level = params.get("level") || null
const categorySlugs = params
	.getAll("category")
	.map((v) => v.trim().toLowerCase())
	.filter(Boolean)
const sort = String(params.get("sort") ?? "relevance").trim()
const priceMinRaw = params.get("priceMin")
const priceMaxRaw = params.get("priceMax")
const priceMin =
	priceMinRaw == null || String(priceMinRaw).trim() === "" ? null : Number(priceMinRaw)
const priceMax =
	priceMaxRaw == null || String(priceMaxRaw).trim() === "" ? null : Number(priceMaxRaw)

let destination: { id: string; name: string; department: string | null } | null = null
if (destinationId) {
	const possible = await db
		.select({
			id: Destination.id,
			name: Destination.name,
			department: Destination.department,
		})
		.from(Destination)
		.where(or(eq(Destination.id, destinationId), eq(Destination.slug, destinationId)))
		.limit(1)
	if (possible.length > 0) destination = possible[0]
}

const todayIso = new Date().toISOString().slice(0, 10)
const effectiveStartDate = startDate && /^\d{4}-\d{2}-\d{2}$/.test(startDate) ? startDate : null

const COOKIE_NAME = "fastt_tour_canary"
let sessionSubjectId = Astro.cookies.get(COOKIE_NAME)?.value?.trim() || ""
if (!sessionSubjectId) {
	sessionSubjectId = crypto.randomUUID()
	Astro.cookies.set(COOKIE_NAME, sessionSubjectId, {
		path: "/",
		httpOnly: true,
		sameSite: "lax",
		maxAge: 60 * 60 * 24 * 180,
	})
}

let tours: Awaited<ReturnType<typeof getTourSearchSurface>>["cards"] = []
let searchMeta: Awaited<ReturnType<typeof getTourSearchSurface>>["meta"] | null = null
let loadError: string | null = null

if (effectiveStartDate) {
	try {
		const surface = await getTourSearchSurface({
			startDate: effectiveStartDate,
			destinationRowId: destination?.id ?? null,
			destinationDepartment: destination?.department ?? null,
			categorySlugs,
			durationBucket,
			level,
			priceMin: Number.isFinite(priceMin as number) ? priceMin : null,
			priceMax: Number.isFinite(priceMax as number) ? priceMax : null,
			sort,
			limit: 50,
			sessionSubjectId,
			host: url.host,
		})
		tours = surface.cards
		searchMeta = surface.meta
	} catch (err) {
		console.error("error querying tour discovery", err)
		loadError = "No se pudo cargar la disponibilidad de tours."
	}
}

const availability = searchMeta?.availability ?? null
const levelLabel = level ? tourDifficultyLabel(level) || level : null
---

<SearchLayout title="Resultados de búsqueda" producType="tours">
	<main class="mx-auto max-w-7xl space-y-6 p-6">
		<header class="space-y-2">
			<h1 class="text-2xl font-bold tracking-tight text-slate-950">Resultados de tours</h1>
			<p class="text-sm text-slate-600">
				Destino: {destination?.name ?? "Cualquier lugar"}
				{
					effectiveStartDate
						? ` — Fecha: ${effectiveStartDate}`
						: " — Selecciona una fecha para ver salidas disponibles"
				}
				{durationBucket ? ` — Duración: ${durationBucket}` : ""}
				{levelLabel ? ` — Nivel: ${levelLabel}` : ""}
				{categorySlugs.length ? ` — Categorías: ${categorySlugs.join(", ")}` : ""}
				{priceMin != null && Number.isFinite(priceMin) ? ` — Desde ${priceMin}` : ""}
				{priceMax != null && Number.isFinite(priceMax) ? ` — Hasta ${priceMax}` : ""}
			</p>
		</header>

		{
			!effectiveStartDate ? (
				<Notice variant="warning" title="Fecha requerida">
					Elige una fecha de inicio en el panel. Solo mostramos tours con salidas disponibles ese
					día (precio “desde” real).
					<a
						class="ml-1 font-semibold text-sky-800 underline"
						href={`/tours/search?startDate=${todayIso}${destination ? `&destinationId=${destination.id}` : ""}`}
					>
						Buscar para hoy
					</a>
				</Notice>
			) : null
		}

		{
			loadError || availability === "error" ? (
				<Notice variant="error" title="No se pudo cargar">
					{loadError ||
						"Hubo un error al consultar disponibilidad. Intenta de nuevo en unos minutos."}
				</Notice>
			) : null
		}

		{
			!loadError && availability === "disabled" ? (
				<Notice variant="info" title="Búsqueda de tours temporalmente no disponible">
					La reserva pública de tours no está abierta en este momento (rollout o mantenimiento).
					Esto no significa que no haya experiencias: vuelve más tarde o prueba otra fecha cuando el
					servicio esté activo.
				</Notice>
			) : null
		}

		{
			!loadError && availability !== "disabled" && availability !== "error" ? (
				<div class="grid grid-cols-1 gap-4">
					{effectiveStartDate && tours.length === 0 ? (
						<Notice variant="warning" title="Sin salidas para estos filtros">
							No hay salidas disponibles para esa fecha con los filtros elegidos. Prueba otra fecha
							o amplía el rango de precio.
						</Notice>
					) : (
						tours.map((t) => (
							<ProductCard
								vertical="tour"
								name={t.name}
								href={`/tours/${t.productId}?departure=${encodeURIComponent(t.departureDate)}&adults=1`}
								image={t.imageUrl || "https://picsum.photos/400/250"}
								alt={t.name}
								duration={t.duration || ""}
								difficultyLevel={t.difficultyLevel || ""}
								description={t.description || ""}
								priceUSD={t.currency === "USD" ? t.fromPrice : 0}
								priceBOB={t.currency === "BOB" ? t.fromPrice : 0}
								stars={t.avgRating ?? 0}
								reviewCount={t.reviewCount}
								metaLine={
									[
										t.departureTime ? `Salida ${t.departureTime}` : null,
										t.availableSlots > 1 ? `${t.availableSlots} salidas` : null,
									]
										.filter(Boolean)
										.join(" · ") || undefined
								}
								services={[]}
							/>
						))
					)}
				</div>
			) : null
		}
	</main>
</SearchLayout>
