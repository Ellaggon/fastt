---
import ToursLandingPage from "@/components/tours/ToursLandingPage.astro"
import {
	publicDestinationHref,
	publicGeoPlacePath,
} from "@/lib/marketplace/publicDestinationRoutes"
import { getPublicTourCatalog } from "@/lib/tours/publicTourCatalog"

const destinationHref = (place: string) => publicDestinationHref(publicGeoPlacePath(place), "tours")

const destinations = [
	{
		name: "La Paz",
		description: "Ciudad, altiplano y montañas",
		href: destinationHref("geo:bo:la-paz-city"),
		imageUrl: "https://pub-de0b5a27b1424d99afa6c7b2fe2f02dc.r2.dev/la-paz.webp",
	},
	{
		name: "Sucre",
		description: "Historia, arquitectura y patrimonio",
		href: destinationHref("geo:bo:sucre"),
		imageUrl: "https://pub-de0b5a27b1424d99afa6c7b2fe2f02dc.r2.dev/sucre.webp",
	},
	{
		name: "Santa Cruz",
		description: "Naturaleza y cultura tropical",
		href: destinationHref("geo:bo:santa-cruz-de-la-sierra"),
		imageUrl: "https://pub-de0b5a27b1424d99afa6c7b2fe2f02dc.r2.dev/santa-cruz.webp",
	},
	{
		name: "Cochabamba",
		description: "Valles, historia y sabores",
		href: destinationHref("geo:bo:cochabamba-city"),
		imageUrl: "https://pub-de0b5a27b1424d99afa6c7b2fe2f02dc.r2.dev/cochabamba.webp",
	},
]
const catalog = await getPublicTourCatalog({ limit: 8 })
---

<ToursLandingPage catalog={catalog} destinations={destinations} />
