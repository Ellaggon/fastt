const popularDestinations = [
	{ label: "La Paz", href: "/destinos/la-paz/tours" },
	{ label: "Uyuni", href: "/destinos/uyuni/tours" },
	{ label: "Santa Cruz", href: "/destinos/santa-cruz/tours" },
	{ label: "Copacabana", href: "/destinos/copacabana/tours" },
	{ label: "Cochabamba", href: "/destinos/cochabamba/tours" },
]

const exploreGroups = [
	{
		title: "Naturaleza",
		links: [
			{ label: "Salares y desiertos", href: "/destinos/uyuni/tours" },
			{ label: "Selva y biodiversidad", href: "/destinos/beni/tours" },
			{ label: "Montaña y altiplano", href: "/destinos/la-paz/tours" },
		],
	},
	{
		title: "Cultura",
		links: [
			{ label: "Historia y patrimonio", href: "/destinos/sucre/tours" },
			{ label: "Gastronomía local", href: "/destinos/cochabamba/tours" },
			{ label: "Experiencias urbanas", href: "/destinos/la-paz/tours" },
		],
	},
	{
		title: "Por duración",
		links: [
			{ label: "Medio día", href: "/buscar/tours?duration=lt1" },
			{ label: "Día completo", href: "/buscar/tours?duration=1" },
			{ label: "Varios días", href: "/buscar/tours?duration=2-3" },
		],
	},
	{
		title: "Antes de reservar",
