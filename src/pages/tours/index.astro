---
import MarketplaceListingSurface from "@/components/marketplace/MarketplaceListingSurface.astro"
import {
	publicDestinationHref,
	publicGeoPlacePath,
} from "@/lib/marketplace/publicDestinationRoutes"

const destinationHref = (place: string) => publicDestinationHref(publicGeoPlacePath(place), "tours")

const popularDestinations = [
	{ label: "La Paz", href: destinationHref("geo:bo:la-paz-city") },
	{ label: "Uyuni", href: destinationHref("geo:bo:uyuni") },
	{ label: "Santa Cruz", href: destinationHref("geo:bo:santa-cruz-de-la-sierra") },
	{ label: "Copacabana", href: destinationHref("geo:bo:copacabana") },
	{ label: "Cochabamba", href: destinationHref("geo:bo:cochabamba-city") },
]

const exploreGroups = [
	{
		title: "Naturaleza",
		links: [
			{ label: "Salares y desiertos", href: destinationHref("geo:bo:uyuni") },
			{ label: "Selva y biodiversidad", href: destinationHref("geo:bo:beni") },
			{ label: "Montaña y altiplano", href: destinationHref("geo:bo:la-paz-city") },
		],
	},
	{
		title: "Cultura",
		links: [
			{ label: "Historia y patrimonio", href: destinationHref("geo:bo:sucre") },
			{ label: "Gastronomía local", href: destinationHref("geo:bo:cochabamba-city") },
			{ label: "Experiencias urbanas", href: destinationHref("geo:bo:la-paz-city") },
		],
	},
	{
		title: "Por duración",
		links: [
			{ label: "Medio día", href: "/buscar/tours?duration=lt1" },
			{ label: "Día completo", href: "/buscar/tours?duration=1" },
			{ label: "Varios días", href: "/buscar/tours?duration=2-3" },
		],
	},
	{
		title: "Antes de reservar",
		links: [
			{ label: "Cómo elegir un tour", href: "/help" },
			{ label: "Tus viajes", href: "/trips" },
		],
	},
]
---

<MarketplaceListingSurface
	vertical="tours"
	title="Tours y experiencias en Bolivia"
	description="Descubre experiencias con información clara sobre duración, punto de encuentro e inclusiones."
	canonicalPath="/tours"
	popularDestinations={popularDestinations}
	exploreGroups={exploreGroups}
/>
