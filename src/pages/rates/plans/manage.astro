---
import { Plus, X } from "@lucide/astro"
import Button from "@/components/ui/Button.astro"
import Dialog from "@/components/ui/Dialog.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import TabsOutsidePanel from "@/components/ui/TabsOutsidePanel.astro"
import RatePlanRecentChanges from "@/components/rates/RatePlanRecentChanges.astro"
import RatePlanResponsiveTable from "@/components/rates/RatePlanResponsiveTable.astro"
import TourAcceptedCurrencies from "@/components/rates/TourAcceptedCurrencies.astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import {
	getNextAddRoomStep,
	getPreviousAddRoomStep,
	resolveAddRoomPlaybookFromUrl,
} from "@/lib/playbook/add-room"
import {
	getNextLaunchStep,
	getPreviousLaunchStep,
	resolveLaunchPlaybookFromUrl,
} from "@/lib/playbook/launch-accommodation"
import {
	buildTourPlaybookHref,
	LAUNCH_TOUR_PLAYBOOK_ID,
	resolveTourLaunchPlaybookFromUrl,
} from "@/lib/playbook/launch-tour"
import {
	COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
	completeToPublishPreviousHref,
	resolveCompleteToPublishPlaybookFromUrl,
} from "@/lib/playbook/complete-to-publish"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import type { WorkspaceRequestContext } from "@/lib/dashboard/workspaceRequestContext"
import { logRoutePerformance } from "@/lib/observability/performanceLog"
import { createServerTimingRecorder } from "@/lib/observability/serverTiming"
import { loadProviderRatePlanVariants } from "@/lib/rates/loadProviderRatePlanVariants"
import { buildProviderRatePlansSurface } from "@/lib/rates/providerRatePlansSurface"
import { ratePlanIntentPresets } from "@/lib/rates/ratePlanIntentPresets"
import { routes } from "@/lib/routes"

const startedAt = performance.now()
const timing = createServerTimingRecorder()
const workspaceContext = await timing.time<WorkspaceRequestContext>("authProvider", () =>
	Astro.locals.getWorkspaceContext()
)
if (!workspaceContext.user) return Astro.redirect("/SignInPage")
if (!workspaceContext.provider) return Astro.redirect(routes.providerOnboardingStart())
const auth = {
	user: workspaceContext.user,
	providerId: workspaceContext.provider.providerId,
}

function isoDate(date: Date) {
	return date.toISOString().slice(0, 10)
}

const today = new Date()
const horizonEnd = new Date(today)
horizonEnd.setUTCDate(horizonEnd.getUTCDate() + 30)
const checkIn = Astro.url.searchParams.get("checkIn") || isoDate(today)
const checkOut = Astro.url.searchParams.get("checkOut") || isoDate(horizonEnd)
const requestedView = String(Astro.url.searchParams.get("vista") ?? "attention")
const activeView = requestedView === "drafts" ? "inactive" : requestedView

const [ratePlansSurface, variantChoices] = await Promise.all([
	buildProviderRatePlansSurface({ providerId: auth.providerId, checkIn, checkOut, timing }),
	timing.time("variants", () => loadProviderRatePlanVariants(auth.providerId)),
	timing.time("sidebar", () => workspaceContext.sidebarDataPromise),
])
const rows = ratePlansSurface.ratePlans

function money(value: number | null | undefined, currency: string | null | undefined) {
	if (value == null || !Number.isFinite(Number(value))) return "Sin precio"
	return new Intl.NumberFormat("es-BO", {
		style: "currency",
		currency: String(currency ?? "BOB"),
		maximumFractionDigits: 0,
	}).format(Number(value))
}

function shortPolicySummary(value: string | null | undefined) {
	const normalized = String(value ?? "")
		.replaceAll("No-show", "No presentación")
		.trim()
	if (!normalized) return "Sin resumen contractual"
	return normalized.split(" · ")[0] || normalized
}

function calendarResolveHref(ratePlanId: string, focus: "price" | "availability" | "restrictions") {
	const params = new URLSearchParams({ ratePlanId, focus, checkIn, checkOut })
	return `${routes.calendar()}?${params.toString()}`
}

function commercialState(row: (typeof rows)[number]) {
	const ratePlanId = String(row.ratePlanId)
	if (!row.isActive) {
		return {
			key: "inactive",
			label: "Fuera de venta",
			reason: "No acepta reservas nuevas.",
			href: `${routes.ratePlanDetail(ratePlanId)}?vista=details`,
			badge: "neutral" as const,
		}
	}
	if (!row.pricingReadiness?.hasBasePrice) {
		return {
			key: "price",
			label: "No vendible",
			reason: "Sin precio base.",
			href: calendarResolveHref(ratePlanId, "price"),
			badge: "warning" as const,
		}
	}
	if (!row.inventoryReadiness?.isReady) {
		return {
			key: "inventory",
			label: "No vendible",
			reason: "Sin disponibilidad suficiente.",
			href: calendarResolveHref(ratePlanId, "availability"),
			badge: "warning" as const,
		}
	}
	if (!row.policyCoverage?.isComplete) {
		return {
			key: "policies",
			label: "No vendible",
			reason: "Faltan condiciones para reservar.",
			href: routes.ratePlanPolicies(ratePlanId),
			badge: "warning" as const,
		}
	}
	return {
		key: "ready",
		label: "Vendible",
		reason: "Disponible en el periodo evaluado.",
		href: routes.ratePlanDetail(ratePlanId),
		badge: "success" as const,
	}
}

const rowStates = new Map(rows.map((row) => [String(row.ratePlanId), commercialState(row)]))
const readyRatePlans = rows.filter(
	(row) => rowStates.get(String(row.ratePlanId))?.key === "ready"
).length
const draftRatePlans = rows.filter(
	(row) => rowStates.get(String(row.ratePlanId))?.key === "inactive"
).length
const needsAttention = rows.length - readyRatePlans - draftRatePlans

const ratePlanDisplayRows = rows.map((row) => {
	const state = rowStates.get(String(row.ratePlanId))!
	const covered = Number(row.policyCoverage?.coveredCategories ?? 0)
	const total = Number(row.policyCoverage?.totalCategories ?? 4)
	const restrictions = Number(row.summary?.activeRestrictionsCount ?? 0)
	return {
		id: String(row.ratePlanId),
		name: row.ratePlanName,
		description: row.description,
		contextLabel: `${row.productName} · ${row.variantName}`,
		isDefault: Boolean(row.isDefault),
		isActive: Boolean(row.isActive),
		stateKey: state.key,
		stateLabel: state.label,
		stateReason: state.reason,
		stateBadge: state.badge,
		resolveHref: routes.ratePlanPolicies(String(row.ratePlanId)),
		resolveLabel: state.key === "ready" ? "Ver" : "Resolver",
		priceLabel: money(row.pricingReadiness?.basePrice, row.pricingReadiness?.currency),
		policyLabel: shortPolicySummary(row.policySummary),
		policyCoverageLabel: `${covered}/${total} completas`,
		inventoryLabel:
			String(row.productType ?? "").toLowerCase() === "tour"
				? `${row.inventoryReadiness?.availableDays ?? 0}/${row.inventoryReadiness?.expectedDays ?? 30} fechas`
				: `${row.inventoryReadiness?.availableDays ?? 0}/${row.inventoryReadiness?.expectedDays ?? 30} noches`,
		inventoryModeLabel: restrictions ? "Venta ajustada" : "Venta estándar",
		priceUnitLabel:
			String(row.productType ?? "").toLowerCase() === "tour" ? "por participante" : "por noche",
	}
})

const tabs = [
	{ id: "attention", label: "Requieren atención", count: needsAttention },
	{ id: "ready", label: "Listas", count: readyRatePlans },
	{ id: "inactive", label: "Inactivas", count: draftRatePlans },
	{ id: "all", label: "Todas", count: rows.length },
]

function tabHref(vista: string) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("vista", vista)
	return `?${params.toString()}`
}

const addRoomPlaybook = resolveAddRoomPlaybookFromUrl(Astro.url)
const launchPlaybook = resolveLaunchPlaybookFromUrl(Astro.url)
const tourLaunchPlaybook = resolveTourLaunchPlaybookFromUrl(Astro.url)
const completePlaybook = resolveCompleteToPublishPlaybookFromUrl(Astro.url)
const flow = Astro.url.searchParams.get("flow")
if (!addRoomPlaybook.active && flow === "add-room") {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("playbook", "add-room")
	params.set("step", "create-rate")
	return Astro.redirect(`${routes.rates()}?${params.toString()}`)
}
if (!launchPlaybook.active && flow === "create") {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("playbook", "launch")
	params.set("step", "rate")
	return Astro.redirect(`${routes.rates()}?${params.toString()}`)
}

const requestedVariantId = String(Astro.url.searchParams.get("variantId") ?? "").trim()
const shouldOpenDialog = Astro.url.searchParams.get("openDialog") === "1"
const matchedVariant = variantChoices.find((choice) => choice.variantId === requestedVariantId)
const requestedProductId = String(Astro.url.searchParams.get("productId") ?? "").trim()
const productVariant = variantChoices.find((choice) => choice.productId === requestedProductId)
const playbookProductId =
	matchedVariant?.productId ??
	addRoomPlaybook.productId ??
	completePlaybook.productId ??
	requestedProductId
const productType = String(matchedVariant?.productType ?? productVariant?.productType ?? "")
const isTourRateContext = productType.toLowerCase() === "tour"
const scopedVariantChoices = requestedProductId
	? variantChoices.filter((choice) => choice.productId === requestedProductId)
	: variantChoices
const addRoomCtx = {
	productId: playbookProductId,
	variantId: requestedVariantId || undefined,
}
const launchCtx = {
	productId: playbookProductId,
	isHotel: true,
	variantId: requestedVariantId || undefined,
}
const addRoomContinueHref = addRoomPlaybook.active
	? (getNextAddRoomStep("create-rate", addRoomCtx)?.buildHref(addRoomCtx) ?? null)
	: null
const addRoomPreviousHref = addRoomPlaybook.active
	? (getPreviousAddRoomStep("create-rate", addRoomCtx)?.buildHref(addRoomCtx) ?? null)
	: null
const launchContinueHref = launchPlaybook.active
	? (getNextLaunchStep("rate", launchCtx)?.buildHref(launchCtx) ?? null)
	: null
const launchPreviousHref = launchPlaybook.active
	? (getPreviousLaunchStep("rate", launchCtx)?.buildHref(launchCtx) ?? null)
	: null
const activePlaybook = addRoomPlaybook.active
	? "add-room"
	: completePlaybook.active
		? "complete-to-publish"
		: launchPlaybook.active
			? "launch"
			: tourLaunchPlaybook.active
				? "launch-tour"
				: null
const isPlaybookRateStep = Boolean(activePlaybook)
const isTourPlaybookRateStep = Boolean(activePlaybook && isTourRateContext)
const playbookVariantLabel =
	matchedVariant?.variantName ?? (isTourPlaybookRateStep ? "esta salida" : "esta habitación")
const guidedIntentPresets = ratePlanIntentPresets
const availableIntentPresets = isTourRateContext
	? ratePlanIntentPresets.filter((preset) => ["flexible", "early_booking"].includes(preset.id))
	: ratePlanIntentPresets
const tourVariantHasMainRate = Object.fromEntries(
	scopedVariantChoices.map((choice) => [
		choice.variantId,
		rows.some((row) => String(row.variantId) === choice.variantId && Boolean(row.isDefault)),
	])
)
const playbookPreviousHref =
	activePlaybook === "add-room"
		? addRoomPreviousHref
		: activePlaybook === "launch"
			? launchPreviousHref
			: activePlaybook === "launch-tour" && playbookProductId
				? buildTourPlaybookHref(
						`/product/${encodeURIComponent(playbookProductId)}/departures/new`,
						"departure"
					)
				: activePlaybook === "complete-to-publish" && playbookProductId
					? completeToPublishPreviousHref(
							playbookProductId,
							"rate",
							isTourRateContext ? "tour" : "hotel",
							{ variantId: requestedVariantId }
						)
					: null
const playbookExitHref =
	activePlaybook === "add-room" && playbookProductId
		? routes.productRoomsForProduct(playbookProductId)
		: activePlaybook === "launch" && playbookProductId
			? routes.productDetail(playbookProductId)
			: activePlaybook === "launch-tour" && playbookProductId
				? routes.productDetail(playbookProductId)
				: activePlaybook === "complete-to-publish" && playbookProductId
					? routes.productDetail(playbookProductId)
					: routes.rates()
const Layout = activePlaybook ? PlaybookLayout : WorkspaceLayout
const layoutProps =
	activePlaybook === "add-room"
		? {
				title: "Tarifas · Nueva tarifa",
				playbookId: "add-room" as const,
				active: true,
				stepId: addRoomPlaybook.stepId ?? "create-rate",
				productId: playbookProductId,
				variantId: requestedVariantId,
				isHotel: true,
				continueHref: addRoomContinueHref,
				hideFooter: true,
			}
		: activePlaybook === "launch"
			? {
					title: "Tarifas · Primera tarifa",
					playbookId: "launch" as const,
					active: true,
					stepId: launchPlaybook.stepId ?? "rate",
					productId: playbookProductId,
					variantId: requestedVariantId,
					isHotel: true,
					continueHref: launchContinueHref,
					hideFooter: true,
				}
			: activePlaybook === "launch-tour"
				? {
						title: "Tarifas · Precio de la salida",
						playbookId: LAUNCH_TOUR_PLAYBOOK_ID,
						active: true,
						stepId: tourLaunchPlaybook.stepId ?? "rate",
						productId: playbookProductId,
						variantId: requestedVariantId,
						isHotel: false,
						hideFooter: true,
					}
				: activePlaybook === "complete-to-publish"
					? {
							title: isTourRateContext
								? "Tarifas · Precio de la salida"
								: "Tarifas · Primera tarifa",
							playbookId: COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
							active: true,
							stepId: completePlaybook.stepId ?? "rate",
							productId: playbookProductId,
							variantId: requestedVariantId,
							isHotel: !isTourRateContext,
							playbookVertical: isTourRateContext ? "tour" : "hotel",
							hideFooter: true,
						}
					: { title: "Tarifas" }

timing.add("history", 0, "deferred_endpoint")
timing.addTotal("total")
timing.setHeader(Astro.response.headers)
logRoutePerformance({
	name: "provider-rate-plans-page",
	request: Astro.request,
	url: Astro.url,
	status: 200,
	startedAt,
	timing,
	userId: auth.user.id,
	providerId: auth.providerId,
})
---

<script>
	import { installRatePlanTabsController } from "@/lib/rates/ratePlanTabsClient"

	installRatePlanTabsController()
</script>

<Layout {...layoutProps}>
	<div class="rate-plans-manage space-y-5" data-rate-plan-view-controller>
		<header class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-800 pb-5">
			<div class="space-y-1.5">
				<h1 class="text-3xl font-semibold text-slate-100">
					{
						isPlaybookRateStep
							? `${isTourPlaybookRateStep ? "Precio" : "Tarifa"} de ${playbookVariantLabel}`
							: "Tarifas"
					}
				</h1>
				<p class="max-w-2xl text-sm leading-6 text-slate-300">
					{
						isPlaybookRateStep
							? isTourPlaybookRateStep
								? "Define el precio en las monedas que aceptas y las condiciones iniciales de esta salida. Después revisarás la reserva."
								: "Define el precio base y la propuesta comercial inicial para que esta habitación pueda venderse."
							: isTourRateContext
								? "Define cómo se venden las salidas del tour: precio por participante, condiciones y fechas disponibles."
								: "Define cómo se venden tus habitaciones: precio base, condiciones y acceso al calendario."
					}
				</p>
			</div>
			{
				isPlaybookRateStep ? null : (
					<Button type="button" variant="secondary" data-open-rate-plan-dialog>
						<Plus class="mr-2 size-4" /> Nueva tarifa
					</Button>
				)
			}
		</header>

		{
			isPlaybookRateStep ? (
				<>
					<form
						id="guidedRatePlanForm"
						data-rate-plan-create-form
						data-playbook-rate-form
						class="fastt-card overflow-hidden border bg-white text-slate-900"
					>
						<div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_320px]">
							<div class="space-y-6 p-5 md:p-6">
								<section class="space-y-4">
									<div>
										<h2 class="text-lg font-semibold text-slate-950">
											{isTourPlaybookRateStep
												? "Precio para esta salida"
												: "Tarifa para esta habitación"}
										</h2>
										<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-500">
											{isTourPlaybookRateStep
												? "La salida ya tiene horario, idioma y cupo máximo. Ahora define su tarifa estándar y el precio por participante en cada moneda que aceptas."
												: "La habitación ya está creada y tiene fotos. Ahora define cómo se venderá: propuesta, nombre visible y precio base."}
										</p>
									</div>

									<div class="grid gap-4 md:grid-cols-2">
										<label class="block space-y-1.5 text-sm md:col-span-2">
											<span class="font-medium text-slate-800">
												{isTourPlaybookRateStep ? "Salida" : "Habitación"}
											</span>
											<input type="hidden" name="variantId" value={requestedVariantId} />
											<div class="fastt-soft-box border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900">
												{matchedVariant?.label ??
													(isTourPlaybookRateStep
														? "Salida seleccionada"
														: "Habitación seleccionada")}
											</div>
										</label>

										{isTourPlaybookRateStep ? (
											<div class="fastt-soft-box border border-emerald-200 bg-emerald-50/60 p-4 text-sm md:col-span-2">
												<input type="hidden" name="intent" value="flexible" />
												<div class="flex flex-wrap items-center gap-2">
													<strong class="text-slate-950">Tarifa estándar</strong>
													<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800">
														Recomendada para empezar
													</span>
												</div>
												<p class="mt-2 leading-6 text-slate-600">
													Define el precio normal de esta salida. Cuando esté publicada podrás
													añadir una promoción por reserva anticipada sin reemplazar esta
													referencia.
												</p>
											</div>
										) : (
											<label class="block space-y-1.5 text-sm">
												<span class="font-medium text-slate-800">Propuesta comercial</span>
												<Select name="intent" required>
													{guidedIntentPresets.map((preset) => (
														<option value={preset.id}>
															{preset.name} · {preset.summary}
														</option>
													))}
												</Select>
											</label>
										)}

										<label class="block space-y-1.5 text-sm">
											<span class="font-medium text-slate-800">Nombre visible</span>
											<Input
												name="name"
												value={isTourPlaybookRateStep ? "Tarifa estándar" : "Tarifa flexible"}
												required
											/>
										</label>

										{isTourPlaybookRateStep ? (
											<TourAcceptedCurrencies />
										) : (
											<>
												<label class="block space-y-1.5 text-sm">
													<span class="font-medium text-slate-800">Moneda</span>
													<Select name="currency" required>
														<option value="BOB">BOB</option>
														<option value="USD">USD</option>
													</Select>
												</label>
												<label class="block space-y-1.5 text-sm">
													<span class="font-medium text-slate-800">Precio base por noche</span>
													<Input
														name="basePrice"
														type="number"
														min="1"
														step="0.01"
														placeholder="Ej. 450"
														required
													/>
												</label>
											</>
										)}
									</div>

									<label class="fastt-soft-box flex items-start gap-3 border border-slate-200 bg-slate-50 p-3 text-sm">
										<input
											type={isTourPlaybookRateStep ? "hidden" : "checkbox"}
											name="isDefault"
											class="fastt-field mt-0.5 size-4"
											checked
											value="on"
										/>
										<span>
											<strong class="text-slate-900">Usar como tarifa principal</strong>
											<span class="mt-1 block text-slate-500">
												{isTourPlaybookRateStep
													? "Esta será la referencia de precio de la salida. Las promociones futuras se calcularán desde una tarifa principal verificable."
													: "Será la tarifa de referencia para esta habitación mientras completas condiciones y disponibilidad."}
											</span>
										</span>
									</label>
								</section>
							</div>

							<aside class="border-t border-slate-200 bg-slate-50 p-5 md:p-6 lg:border-t-0 lg:border-l">
								<h2 class="text-sm font-semibold text-slate-950">Condiciones iniciales</h2>
								<p class="mt-2 text-sm leading-6 text-slate-600" data-contract-summary>
									{isTourPlaybookRateStep
										? "El precio y la cancelación se configuran por separado. En el siguiente paso revisarás la condición que verá el viajero antes de reservar."
										: "Incluye cancelación flexible, pago en el hotel, ingreso estándar y cargo de primera noche por no presentación."}
								</p>
								<div class="fastt-soft-box mt-5 p-4">
									<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
										Siguiente paso
									</p>
									<p class="mt-2 text-sm font-medium text-slate-950">Condiciones de reserva</p>
									<p class="mt-1 text-sm leading-6 text-slate-500">
										{isTourPlaybookRateStep
											? "Después de guardar revisarás cancelación, confirmación y preguntas para los participantes antes de abrir fechas."
											: "Después de guardar ajustarás cancelación, pagos y reglas antes de abrir disponibilidad."}
									</p>
								</div>
							</aside>
						</div>
					</form>
					<footer class="fastt-playbook-footer flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
						<div class="min-h-10">
							{playbookPreviousHref ? (
								<Button
									href={playbookPreviousHref}
									variant="ghost"
									className="text-slate-300 hover:bg-slate-800 hover:text-white"
								>
									← Anterior
								</Button>
							) : null}
						</div>
						<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end">
							<p class="text-sm text-slate-400" data-rate-plan-feedback />
							<Button
								href={playbookExitHref}
								variant="ghost"
								className="text-slate-500 hover:bg-slate-800 hover:text-slate-100"
							>
								Salir del flujo
							</Button>
							<Button
								type="submit"
								form="guidedRatePlanForm"
								name="publicationMode"
								value="draft"
								className="fastt-playbook-cta"
								data-guided-rate-submit
							>
								Guardar y continuar →
							</Button>
						</div>
					</footer>
				</>
			) : null
		}

		{
			!isPlaybookRateStep ? (
				<section class="fastt-card border bg-white text-slate-900">
					<div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 pt-4">
						<TabsOutsidePanel class="mb-3" aria-label="Estado de tarifas" data-rate-plan-tabs>
							{tabs.map((tab) => (
								<a
									href={tabHref(tab.id)}
									data-rate-plan-tab={tab.id}
									aria-current={activeView === tab.id ? "page" : undefined}
									data-active={activeView === tab.id ? "true" : "false"}
									class={`fastt-tabs-outside-panel__item px-3 py-2 text-sm font-semibold whitespace-nowrap ${
										activeView === tab.id
											? ""
											: "text-slate-600 hover:bg-sky-100/80 hover:text-sky-950"
									}`}
								>
									{tab.label} <span class="ml-1 text-xs opacity-70">{tab.count}</span>
								</a>
							))}
						</TabsOutsidePanel>
						<p class="pb-3 text-xs text-slate-500">Evaluación: próximos 30 días</p>
					</div>

					<p
						class="hidden border-b border-slate-200 px-4 py-2 text-sm"
						data-rate-plan-action-feedback
					/>
					<RatePlanResponsiveTable rows={ratePlanDisplayRows} activeView={activeView} />
				</section>
			) : null
		}

		{!isPlaybookRateStep ? <RatePlanRecentChanges checkIn={checkIn} checkOut={checkOut} /> : null}
	</div>

	{
		!isPlaybookRateStep ? (
			<Dialog class="w-[min(720px,calc(100%-2rem))]" data-rate-plan-dialog>
				<form data-rate-plan-create-form class="max-h-[90vh] overflow-y-auto">
					<header class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-200 bg-white px-5 py-4">
						<div>
							<p class="text-lg font-semibold">Nueva tarifa</p>
							<p class="mt-1 text-sm text-slate-500" data-wizard-heading>
								1 de 3 · Oferta
							</p>
						</div>
						<Button
							type="button"
							variant="ghost"
							size="sm"
							class="fastt-modal-close px-2"
							data-close-rate-plan-dialog
							aria-label="Cerrar"
						>
							<X class="size-5" />
						</Button>
					</header>

					<div class="p-5">
						<section class="space-y-4" data-wizard-step="1">
							<div>
								<h2 class="font-semibold">¿Qué quieres vender?</h2>
								<p class="mt-1 text-sm text-slate-500">
									{isTourRateContext
										? "Elige la salida y la propuesta comercial."
										: "Elige la habitación y la propuesta comercial."}
								</p>
							</div>
							<label class="block space-y-1.5 text-sm">
								<span class="font-medium">{isTourRateContext ? "Salida" : "Habitación"}</span>
								<Select name="variantId" required>
									<option value="">
										{isTourRateContext ? "Selecciona una salida" : "Selecciona una habitación"}
									</option>
									{scopedVariantChoices.map((choice) => (
										<option
											value={choice.variantId}
											selected={choice.variantId === requestedVariantId}
										>
											{choice.label}
										</option>
									))}
								</Select>
							</label>
							{isTourRateContext ? (
								<fieldset class="space-y-2" data-tour-offer-selector>
									<legend class="text-sm font-medium">Tipo de tarifa</legend>
									<p class="text-sm leading-6 text-slate-500">
										El precio estándar es la referencia de la salida. Una promoción se crea como
										alternativa y nunca reemplaza esa referencia.
									</p>
									<div class="grid gap-3 sm:grid-cols-2">
										<label class="tour-offer-choice">
											<input type="radio" name="intent" value="flexible" checked required />
											<span>
												<strong>Precio estándar</strong>
												<small>
													Precio normal por participante. Puedes ajustar sus condiciones por
													separado.
												</small>
											</span>
										</label>
										<label class="tour-offer-choice" data-advance-offer-choice>
											<input type="radio" name="intent" value="early_booking" required />
											<span>
												<strong>Reserva anticipada</strong>
												<small>
													Descuento configurable para quien reserve con suficiente anticipación.
												</small>
											</span>
										</label>
									</div>
									<p class="hidden text-sm text-amber-700" data-main-rate-required>
										Primero crea o marca una tarifa estándar como principal para la salida
										seleccionada.
									</p>
									<div
										class="fastt-soft-box grid hidden gap-3 border border-slate-200 bg-slate-50 p-4 sm:grid-cols-2"
										data-advance-settings
									>
										<label class="block space-y-1.5 text-sm">
											<span class="font-medium">Descuento</span>
											<div class="relative">
												<Input
													name="discountPercent"
													type="number"
													min="1"
													max="50"
													step="1"
													value="10"
												/>
												<span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-slate-500">
													%
												</span>
											</div>
										</label>
										<label class="block space-y-1.5 text-sm">
											<span class="font-medium">Anticipación mínima</span>
											<div class="relative">
												<Input
													name="minAdvanceDays"
													type="number"
													min="1"
													max="365"
													step="1"
													value="14"
												/>
												<span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-slate-500">
													días
												</span>
											</div>
										</label>
										<p class="text-xs leading-5 text-slate-500 sm:col-span-2">
											El precio que ingresarás en el siguiente paso es el precio de referencia antes
											del descuento.
										</p>
									</div>
								</fieldset>
							) : (
								<label class="block space-y-1.5 text-sm">
									<span class="font-medium">Propuesta</span>
									<Select name="intent" required>
										{availableIntentPresets.map((preset) => (
											<option value={preset.id}>
												{preset.name} · {preset.summary}
											</option>
										))}
									</Select>
								</label>
							)}
							<label class="block space-y-1.5 text-sm">
								<span class="font-medium">Nombre de la tarifa</span>
								<Input
									name="name"
									value={isTourRateContext ? "Tarifa estándar" : "Tarifa flexible"}
									required
								/>
							</label>
						</section>

						<section class="hidden space-y-4" data-wizard-step="2">
							<div>
								<h2 class="font-semibold">Precio y condiciones</h2>
								<p class="mt-1 text-sm text-slate-500">
									{isTourRateContext
										? "Indica el precio por participante en cada moneda que aceptas. Las fechas sin ajustes usan esa base."
										: "Este precio será la base para las noches sin ajustes."}
								</p>
							</div>
							{isTourRateContext ? (
								<TourAcceptedCurrencies />
							) : (
								<div class="grid gap-3 sm:grid-cols-[140px_1fr]">
									<label class="block space-y-1.5 text-sm">
										<span class="font-medium">Moneda</span>
										<Select name="currency" required>
											<option value="BOB">BOB</option>
											<option value="USD">USD</option>
										</Select>
									</label>
									<label class="block space-y-1.5 text-sm">
										<span class="font-medium">Precio base por noche</span>
										<Input
											name="basePrice"
											type="number"
											min="1"
											step="0.01"
											placeholder="Ej. 450"
											required
										/>
									</label>
								</div>
							)}
							<div
								class="fastt-soft-box bg-slate-50 p-4 text-sm text-slate-600"
								data-contract-summary
							>
								{isTourRateContext
									? "Incluye cancelación flexible, pago al proveedor durante la experiencia y reglas claras de no presentación."
									: "Incluye cancelación flexible, pago en el hotel, ingreso estándar y cargo de primera noche por no presentación."}
							</div>
						</section>

						<section class="hidden space-y-4" data-wizard-step="3">
							<div>
								<h2 class="font-semibold">Revisa y guarda</h2>
								<p class="mt-1 text-sm text-slate-500">
									{isTourRateContext
										? "La tarifa quedará en borrador hasta que revises sus condiciones de reserva."
										: "Puedes dejarla en borrador o publicarla ahora."}
								</p>
							</div>
							<div
								class="fastt-soft-box border border-slate-200 p-4 text-sm"
								data-rate-plan-review
							/>
							<label class="fastt-soft-box flex items-start gap-3 border border-slate-200 p-3 text-sm">
								<input type="checkbox" name="isDefault" class="fastt-field mt-0.5 size-4" />
								<span>
									<>
										<strong>Tarifa principal</strong>
										<span class="mt-1 block text-slate-500">
											Será la referencia comercial cuando publiques la tarifa.
										</span>
									</>
								</span>
							</label>
						</section>
					</div>

					<footer class="sticky bottom-0 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 bg-white px-5 py-4">
						<p class="text-sm text-slate-500" data-rate-plan-feedback />
						<div class="ml-auto flex gap-2">
							<Button type="button" variant="secondary" class="hidden" data-wizard-back>
								Volver
							</Button>
							<Button type="button" data-wizard-next>
								{" "}
								Continuar{" "}
							</Button>
							{isTourRateContext ? (
								<Button
									type="submit"
									name="publicationMode"
									value="draft"
									class="hidden"
									data-publish
								>
									Guardar y revisar condiciones
								</Button>
							) : (
								<>
									<Button
										type="submit"
										name="publicationMode"
										value="draft"
										variant="secondary"
										class="hidden"
										data-save-draft
									>
										Guardar borrador
									</Button>
									<Button
										type="submit"
										name="publicationMode"
										value="publish"
										class="hidden"
										data-publish
									>
										Publicar
									</Button>
								</>
							)}
						</div>
					</footer>
				</form>
			</Dialog>
		) : null
	}
</Layout>

<style>
	.rate-plans-manage {
		--calendar-radius: var(--fastt-radius-pill);
	}
	.tour-offer-choice {
		display: flex;
		min-height: 7.25rem;
		cursor: pointer;
		gap: 0.75rem;
		border: 1px solid rgb(203 213 225);
		border-radius: 0.875rem;
		padding: 1rem;
		transition:
			border-color 150ms ease,
			box-shadow 150ms ease,
			background-color 150ms ease;
	}
	.tour-offer-choice:has(input:checked) {
		border-color: rgb(15 118 110);
		background: rgb(240 253 250);
		box-shadow: 0 0 0 1px rgb(15 118 110);
	}
	.tour-offer-choice input {
		margin-top: 0.2rem;
		accent-color: rgb(15 118 110);
	}
	.tour-offer-choice strong,
	.tour-offer-choice small {
		display: block;
	}
	.tour-offer-choice small {
		margin-top: 0.4rem;
		color: rgb(71 85 105);
		font-size: 0.8125rem;
		line-height: 1.25rem;
	}
</style>

<script
	define:vars={{
		requestedVariantId,
		shouldOpenDialog,
		addRoomPlaybookActive: addRoomPlaybook.active,
		launchPlaybookActive: launchPlaybook.active,
		tourLaunchPlaybookActive: tourLaunchPlaybook.active,
		completePlaybookActive: completePlaybook.active,
		isPlaybookRateStep,
		isTourPlaybookRateStep,
		isTourRateContext,
		playbookProductId,
		tourVariantHasMainRate,
		activePlaybook,
	}}
>
	const actionFeedback = document.querySelector("[data-rate-plan-action-feedback]")

	document.addEventListener("click", (event) => {
		const target = event.target
		if (!(target instanceof Element)) return
		for (const menu of document.querySelectorAll("[data-rate-plan-action-menu]")) {
			if (!menu.contains(target)) menu.removeAttribute("open")
		}
	})

	for (const button of document.querySelectorAll("[data-rate-plan-toggle-inline]")) {
		button.addEventListener("click", async () => {
			const nextActive = button.dataset.nextActive === "true"
			button.disabled = true
			if (actionFeedback) {
				actionFeedback.classList.remove("hidden", "text-rose-700", "text-emerald-700")
				actionFeedback.classList.add("text-slate-600")
				actionFeedback.textContent = nextActive ? "Activando tarifa..." : "Desactivando tarifa..."
			}
			try {
				const response = await fetch("/api/rateplans/update", {
					method: "PUT",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						id: button.dataset.ratePlanId,
						name: button.dataset.ratePlanName,
						description: button.dataset.ratePlanDescription || "",
						isActive: nextActive,
						isDefault: button.dataset.ratePlanIsDefault === "true",
					}),
				})
				const result = await response.json().catch(() => null)
				if (!response.ok) throw new Error(result?.error || "No se pudo cambiar el estado")
				window.location.reload()
			} catch (error) {
				if (actionFeedback) {
					actionFeedback.classList.remove("text-slate-600")
					actionFeedback.classList.add("text-rose-700")
					actionFeedback.textContent =
						error instanceof Error ? error.message : "No se pudo cambiar el estado"
				}
				button.disabled = false
			}
		})
	}

	const dialog = document.querySelector("[data-rate-plan-dialog]")
	const form = document.querySelector("[data-rate-plan-create-form]")
	function bindLocalRateDraft(targetForm, key) {
		if (!(targetForm instanceof HTMLFormElement)) return { clear: () => {} }
		const storageKey = `fastt:playbook-form-draft:${key}`
		const controls = () =>
			Array.from(targetForm.elements).filter(
				(element) =>
					element instanceof HTMLInputElement ||
					element instanceof HTMLSelectElement ||
					element instanceof HTMLTextAreaElement
			)
		const save = () => {
			const entries = controls()
				.filter((element) => {
					if (!element.name && !element.id) return false
					return !["button", "file", "hidden", "image", "password", "reset", "submit"].includes(
						element.type || ""
					)
				})
				.map((element) => ({
					key: element.name || element.id,
					value: element.value,
					checked: element instanceof HTMLInputElement ? element.checked : undefined,
				}))
			window.sessionStorage.setItem(storageKey, JSON.stringify(entries))
		}
		try {
			const raw = window.sessionStorage.getItem(storageKey)
			const entries = raw ? JSON.parse(raw) : []
			if (Array.isArray(entries)) {
				for (const element of controls()) {
					const match = entries.find((entry) => entry.key === (element.name || element.id))
					if (!match) continue
					if (element instanceof HTMLInputElement && ["checkbox", "radio"].includes(element.type)) {
						element.checked = Boolean(match.checked)
					} else {
						element.value = String(match.value ?? "")
					}
				}
			}
		} catch {
			window.sessionStorage.removeItem(storageKey)
		}
		targetForm
			.querySelector("[data-accepted-currencies]")
			?.dispatchEvent(new Event("change", { bubbles: true }))
		targetForm.addEventListener("input", save)
		targetForm.addEventListener("change", save)
		window.addEventListener("pagehide", save)
		return { clear: () => window.sessionStorage.removeItem(storageKey) }
	}
	const formDraft = bindLocalRateDraft(
		form,
		`rates:${window.location.pathname}:${activePlaybook || "standalone"}:${requestedVariantId || "new-rate"}`
	)
	if (isTourPlaybookRateStep && form instanceof HTMLFormElement) {
		const nameInput = form.querySelector('[name="name"]')
		if (nameInput instanceof HTMLInputElement && nameInput.value === "Tarifa flexible") {
			nameInput.value = "Tarifa estándar"
		}
	}
	const feedback = document.querySelector("[data-rate-plan-feedback]")
	const heading = document.querySelector("[data-wizard-heading]")
	const contractSummary = document.querySelector("[data-contract-summary]")
	const review = document.querySelector("[data-rate-plan-review]")
	let currentStep = 1

	const intentCopy = isTourRateContext
		? {
				flexible: "Precio estándar por participante · Las condiciones se gestionan por separado",
				early_booking:
					"Descuento por reserva anticipada · Las condiciones se gestionan por separado",
			}
		: {
				flexible:
					"Cancelación flexible · Pago en el hotel · Ingreso estándar · Primera noche por no presentación",
				non_refundable:
					"10% de descuento · No reembolsable · Prepago total · No presentación de estadía completa",
				long_stay: "12% de descuento desde 7 noches · Condición de larga estadía",
				early_booking: "10% de descuento con 21 días de anticipación · Condición flexible",
			}

	function selectedIntent(targetForm) {
		return String(new FormData(targetForm).get("intent") || "flexible")
	}

	function tourIntentSummary(targetForm) {
		const intent = selectedIntent(targetForm)
		if (!isTourRateContext || intent !== "early_booking")
			return intentCopy[intent] || intentCopy.flexible
		const data = new FormData(targetForm)
		const discount = Number(data.get("discountPercent") || 10)
		const advance = Number(data.get("minAdvanceDays") || 14)
		return `${discount}% de descuento al reservar con ${advance} días o más de anticipación · Las condiciones se gestionan por separado`
	}

	function syncTourOfferUi(targetForm) {
		if (!isTourRateContext || !(targetForm instanceof HTMLFormElement)) return
		const isAdvance = selectedIntent(targetForm) === "early_booking"
		const settings = targetForm.querySelector("[data-advance-settings]")
		settings?.classList.toggle("hidden", !isAdvance)
		settings?.querySelectorAll("input").forEach((input) => {
			input.disabled = !isAdvance
			input.required = isAdvance
		})
		const variantId = String(new FormData(targetForm).get("variantId") || "")
		const hasMainRate = Boolean(tourVariantHasMainRate?.[variantId])
		const requirement = targetForm.querySelector("[data-main-rate-required]")
		requirement?.classList.toggle("hidden", !isAdvance || hasMainRate)
		const advanceInput = targetForm.querySelector('[name="intent"][value="early_booking"]')
		if (advanceInput instanceof HTMLInputElement) {
			advanceInput.setCustomValidity(
				isAdvance && !hasMainRate
					? "Primero crea o marca una tarifa estándar como principal para esta salida."
					: ""
			)
		}
		if (contractSummary) contractSummary.textContent = tourIntentSummary(targetForm)
	}

	function renderStep() {
		document.querySelectorAll("[data-wizard-step]").forEach((step) => {
			step.classList.toggle("hidden", Number(step.dataset.wizardStep) !== currentStep)
		})
		document.querySelector("[data-wizard-back]")?.classList.toggle("hidden", currentStep === 1)
		document.querySelector("[data-wizard-next]")?.classList.toggle("hidden", currentStep === 3)
		document.querySelector("[data-save-draft]")?.classList.toggle("hidden", currentStep !== 3)
		document.querySelector("[data-publish]")?.classList.toggle("hidden", currentStep !== 3)
		if (heading)
			heading.textContent = `${currentStep} de 3 · ${["Oferta", "Precio y condiciones", "Revisión"][currentStep - 1]}`
		if (currentStep === 3 && form && review) {
			const data = new FormData(form)
			const variant =
				form.querySelector('[name="variantId"]')?.selectedOptions[0]?.textContent ??
				(isTourRateContext ? "Salida" : "Habitación")
			const intent = String(data.get("intent") || "flexible")
			const priceUnit = isTourRateContext ? "por participante" : "por noche"
			const offers = readCurrencyOffers(form)
			const discount = intent === "early_booking" ? Number(data.get("discountPercent") || 10) : 0
			const priceLine = offers.length
				? offers
						.map((offer) => {
							const finalPrice = offer.basePrice * (1 - discount / 100)
							return discount
								? `${offer.currency} ${offer.basePrice} de referencia → ${offer.currency} ${finalPrice.toFixed(2)} con descuento`
								: `${offer.currency} ${offer.basePrice}`
						})
						.join(" · ")
				: "-"
			review.innerHTML = `<p class="font-semibold text-slate-950">${String(data.get("name") || "Nueva tarifa")}</p><p class="mt-2 text-slate-600">${variant}</p><p class="mt-1 text-slate-600">${priceLine} ${priceUnit}</p><p class="mt-3 text-xs text-slate-500">${tourIntentSummary(form)}</p>`
		}
	}

	document
		.querySelector("[data-open-rate-plan-dialog]")
		?.addEventListener("click", () => dialog?.showModal())
	document
		.querySelector("[data-close-rate-plan-dialog]")
		?.addEventListener("click", () => dialog?.close())
	dialog?.addEventListener("click", (event) => {
		if (event.target === dialog) dialog.close()
	})
	form?.querySelectorAll('[name="intent"]').forEach((control) =>
		control.addEventListener("change", (event) => {
			const input = event.currentTarget
			const intent = input.value
			const nameInput = form.querySelector('[name="name"]')
			if (nameInput)
				nameInput.value =
					intent === "early_booking"
						? "Reserva anticipada"
						: isTourRateContext
							? "Tarifa estándar"
							: input.selectedOptions?.[0]?.textContent?.split(" · ")[0] || "Nueva tarifa"
			syncTourOfferUi(form)
		})
	)
	form?.querySelector('[name="variantId"]')?.addEventListener("change", () => syncTourOfferUi(form))
	form
		?.querySelector('[name="discountPercent"]')
		?.addEventListener("input", () => syncTourOfferUi(form))
	form
		?.querySelector('[name="minAdvanceDays"]')
		?.addEventListener("input", () => syncTourOfferUi(form))
	function readCurrencyOffers(targetForm) {
		const root = targetForm.querySelector("[data-accepted-currencies]")
		if (!(root instanceof HTMLElement)) {
			const data = new FormData(targetForm)
			return [
				{
					currency: String(data.get("currency") || "BOB"),
					basePrice: Number(data.get("basePrice")),
				},
			]
		}
		return Array.from(root.querySelectorAll("[data-currency-toggle]"))
			.filter((node) => node instanceof HTMLInputElement && node.checked)
			.map((node) => {
				const price = root.querySelector(`[data-currency-price="${node.value}"]`)
				return {
					currency: node.value,
					basePrice: price instanceof HTMLInputElement ? Number(price.value) : Number.NaN,
				}
			})
			.filter((offer) => offer.currency && Number.isFinite(offer.basePrice) && offer.basePrice > 0)
	}

	document.querySelector("[data-wizard-next]")?.addEventListener("click", () => {
		if (form) syncTourOfferUi(form)
		const activeStep = document.querySelector(`[data-wizard-step="${currentStep}"]`)
		const fields = activeStep?.querySelectorAll("input, select") ?? []
		for (const field of fields) {
			if (field.disabled) continue
			if (!field.reportValidity()) return
		}
		if (form && activeStep?.querySelector("[data-accepted-currencies]")) {
			const offers = readCurrencyOffers(form)
			if (!offers.length) {
				const toggle = activeStep.querySelector("[data-currency-toggle]")
				if (toggle instanceof HTMLInputElement) {
					toggle.setCustomValidity("Elige al menos una moneda e indica su precio.")
					toggle.reportValidity()
					toggle.setCustomValidity("")
				}
				return
			}
		}
		currentStep = Math.min(3, currentStep + 1)
		renderStep()
	})
	document.querySelector("[data-wizard-back]")?.addEventListener("click", () => {
		currentStep = Math.max(1, currentStep - 1)
		renderStep()
	})

	form?.querySelector("[data-accepted-currencies]")?.addEventListener("change", () => {
		if (feedback?.textContent === "Elige al menos una moneda e indica su precio.") {
			feedback.textContent = ""
		}
	})

	form?.addEventListener("submit", async (event) => {
		event.preventDefault()
		const submitter = event.submitter
		if (!form.reportValidity()) return
		const data = new FormData(form)
		const offers = readCurrencyOffers(form)
		if (!offers.length) {
			if (feedback) feedback.textContent = "Elige al menos una moneda e indica su precio."
			return
		}
		const publicationMode =
			addRoomPlaybookActive ||
			launchPlaybookActive ||
			tourLaunchPlaybookActive ||
			completePlaybookActive
				? "draft"
				: submitter?.value === "publish"
					? "publish"
					: "draft"
		const baseName = String(data.get("name") || "")
		const wantsDefault = data.get("isDefault") === "on"
		const linkedButtons = Array.from(document.querySelectorAll("button")).filter(
			(button) => button instanceof HTMLButtonElement && button.form === form
		)
		linkedButtons.forEach((button) => {
			button.disabled = true
		})
		if (feedback)
			feedback.textContent =
				offers.length > 1
					? "Creando una tarifa por cada moneda..."
					: "Creando tarifa, precio y condiciones..."
		try {
			let result = null
			for (const [index, offer] of offers.entries()) {
				const payload = {
					variantId: String(data.get("variantId") || ""),
					name: offers.length > 1 ? `${baseName} · ${offer.currency}` : baseName,
					intent: String(data.get("intent") || "flexible"),
					discountPercent:
						String(data.get("intent") || "flexible") === "early_booking"
							? Number(data.get("discountPercent"))
							: undefined,
					minAdvanceDays:
						String(data.get("intent") || "flexible") === "early_booking"
							? Number(data.get("minAdvanceDays"))
							: undefined,
					currency: offer.currency,
					basePrice: offer.basePrice,
					publicationMode,
					isDefault: index === 0 && wantsDefault,
				}
				const response = await fetch("/api/rateplans/create", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				})
				const created = await response.json().catch(() => null)
				if (!response.ok || !created?.ratePlanId) {
					const reason = created?.error || "No se pudo crear la tarifa"
					throw new Error(
						result
							? `${reason} La tarifa en ${result.currency || offers[0].currency} ya quedó creada.`
							: reason
					)
				}
				const toggle = form.querySelector(`[data-currency-toggle][value="${offer.currency}"]`)
				if (toggle instanceof HTMLInputElement) {
					toggle.checked = false
					toggle.dispatchEvent(new Event("change", { bubbles: true }))
				}
				if (!result) result = { ...created, currency: offer.currency }
			}
			const payload = {
				variantId: String(data.get("variantId") || ""),
			}
			formDraft.clear()
			if (addRoomPlaybookActive) {
				const params = new URLSearchParams({
					playbook: "add-room",
					step: "conditions",
					flow: "add-room",
					variantId: payload.variantId,
					ratePlanId: String(result.ratePlanId),
					vista: "conditions",
				})
				window.location.href = `/rates/plans/${encodeURIComponent(String(result.ratePlanId))}?${params.toString()}`
				return
			}
			if (launchPlaybookActive) {
				const params = new URLSearchParams({
					playbook: "launch",
					step: "conditions",
					flow: "create",
					variantId: payload.variantId,
				})
				window.location.href = `/rates/plans/${encodeURIComponent(String(result.ratePlanId))}?${params.toString()}`
				return
			}
			if (tourLaunchPlaybookActive) {
				const params = new URLSearchParams({
					playbook: "launch-tour",
					step: "conditions",
					flow: "create",
					variantId: payload.variantId,
					ratePlanId: String(result.ratePlanId),
					vista: "conditions",
				})
				window.location.href = `/rates/plans/${encodeURIComponent(String(result.ratePlanId))}?${params.toString()}`
				return
			}
			if (completePlaybookActive) {
				if (!isTourRateContext) {
					const params = new URLSearchParams({
						focus: "availability",
						productId: String(playbookProductId || ""),
						variantId: payload.variantId,
						ratePlanId: String(result.ratePlanId),
						playbook: "complete-to-publish",
						step: "calendar",
						flow: "complete",
					})
					window.location.href = `/rates/calendar?${params.toString()}`
					return
				}
				const params = new URLSearchParams({
					productId: String(playbookProductId || ""),
					playbook: "complete-to-publish",
					step: "bookingPolicies",
					flow: "complete",
					variantId: payload.variantId,
					ratePlanId: String(result.ratePlanId),
					vista: "conditions",
				})
				window.location.href = `/rates/plans/${encodeURIComponent(String(result.ratePlanId))}?${params.toString()}`
				return
			}
			window.location.href = isTourRateContext
				? `/rates/plans/${encodeURIComponent(result.ratePlanId)}?${new URLSearchParams({
						productId: String(playbookProductId || ""),
						variantId: payload.variantId,
						ratePlanId: String(result.ratePlanId),
						vista: "conditions",
					}).toString()}`
				: `/rates/plans/${encodeURIComponent(result.ratePlanId)}`
		} catch (error) {
			if (feedback)
				feedback.textContent = error instanceof Error ? error.message : "No se pudo crear la tarifa"
			linkedButtons.forEach((button) => {
				button.disabled = false
			})
		}
	})

	syncTourOfferUi(form)
	renderStep()

	if (shouldOpenDialog && dialog) {
		const variantSelect = form?.querySelector('[name="variantId"]')
		if (variantSelect instanceof HTMLSelectElement && requestedVariantId) {
			variantSelect.value = requestedVariantId
		}
		dialog.showModal()
	}
</script>
