---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import RatePlanPoliciesSurface from "@/components/policy/RatePlanPoliciesSurface.astro"
import RatePlanPricingSurface from "@/components/pricing/RatePlanPricingSurface.astro"
import TabsOutsidePanel from "@/components/ui/TabsOutsidePanel.astro"
import Textarea from "@/components/ui/Textarea.astro"
import { Hotel, ShieldCheck, Ticket } from "@lucide/astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import {
	buildAddRoomHref,
	getNextAddRoomStep,
	resolveAddRoomPlaybookFromUrl,
} from "@/lib/playbook/add-room"
import {
	getNextLaunchStep,
	resolveLaunchPlaybookFromUrl,
} from "@/lib/playbook/launch-accommodation"
import { getNextTourLaunchStep, resolveTourLaunchPlaybookFromUrl } from "@/lib/playbook/launch-tour"
import {
	buildCompleteToPublishHref,
	COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
	completeToPublishNextHref,
	resolveCompleteToPublishPlaybookFromUrl,
} from "@/lib/playbook/complete-to-publish"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { requireProvider } from "@/lib/auth/requireProvider"
import { logRoutePerformance } from "@/lib/observability/performanceLog"
import { createServerTimingRecorder } from "@/lib/observability/serverTiming"
import { getProviderSidebarData } from "@/lib/dashboard/providerSidebarReadiness"
import { getProviderUserWorkspacePreferenceRead } from "@/lib/providerUserWorkspacePreference"
import { loadRatePlanPoliciesData } from "@/lib/policies/loadRatePlanPoliciesData"
import { loadRatePlanPricingData } from "@/lib/pricing/loadRatePlanPricingData"
import { getRatePlanRemovalReadiness } from "@/lib/rates/getRatePlanRemovalReadiness"
import {
	loadRatePlanPlaybookReadModel,
	loadRatePlanReadModelById,
	type RatePlanListItem,
} from "@/lib/rates/loadRatePlansReadModel"
import { routes } from "@/lib/routes"
import {
	REQUIRED_POLICY_CATEGORIES,
	buildRatePlanPoliciesSurface,
	resolvePolicyDateRange,
} from "@/modules/policies/public"

const startedAt = performance.now()
const timing = createServerTimingRecorder()
const auth = await timing
	.time("authProvider", () => requireProvider(Astro.request))
	.catch((e: any) => {
		if (e instanceof Response && e.status === 401) return "__REDIRECT_LOGIN__"
		if (e instanceof Response && e.status === 403) return "__REDIRECT_PROVIDER__"
		throw e
	})
if (auth === "__REDIRECT_LOGIN__") return Astro.redirect("/SignInPage")
if (auth === "__REDIRECT_PROVIDER__") return Astro.redirect(routes.providerSettingsProfile())

const ratePlanId = String(Astro.params.ratePlanId ?? "").trim()
if (!ratePlanId) return Astro.redirect(routes.rates())

const addRoomPlaybook = resolveAddRoomPlaybookFromUrl(Astro.url)
const launchPlaybook = resolveLaunchPlaybookFromUrl(Astro.url)
const tourLaunchPlaybook = resolveTourLaunchPlaybookFromUrl(Astro.url)
const completePlaybook = resolveCompleteToPublishPlaybookFromUrl(Astro.url)
const activePlaybook = addRoomPlaybook.active
	? "add-room"
	: completePlaybook.active
		? "complete-to-publish"
		: launchPlaybook.active
			? "launch"
			: tourLaunchPlaybook.active
				? "launch-tour"
				: null
const isPlaybookMode = Boolean(activePlaybook)

// PlaybookLayout has no provider-wide sidebar. Avoid its readiness aggregation on
// this focused step; it can be substantially more expensive than the editor itself.
let isProfessionalMode = false
if (!isPlaybookMode) {
	const workspacePreference = await timing.time("workspacePreference", () =>
		getProviderUserWorkspacePreferenceRead({
			providerId: auth.providerId,
			userId: auth.user.id,
		})
	)
	const sidebarData = await timing.time("sidebar", () =>
		getProviderSidebarData(auth.providerId, {
			userId: auth.user.id,
			workspaceExperience: workspacePreference.schemaAvailable
				? workspacePreference.experience
				: undefined,
		})
	)
	isProfessionalMode = sidebarData.disclosureMode !== "small-provider"
}

const { checkIn, checkOut } = resolvePolicyDateRange(Astro.url)
const ratePlanDetailViews = ["conditions", "price", "details"] as const
type RatePlanDetailView = (typeof ratePlanDetailViews)[number]
const requestedView = String(Astro.url.searchParams.get("vista") ?? "conditions")
const activeView: RatePlanDetailView = ratePlanDetailViews.includes(
	requestedView as RatePlanDetailView
)
	? (requestedView as RatePlanDetailView)
	: "conditions"

let row: RatePlanListItem
let policyPlans: Awaited<ReturnType<typeof buildRatePlanPoliciesSurface>>["policyPlans"]
let context: {
	productId: string
	variantId: string
	productName: string
	variantName: string
	ratePlanName: string
}
let loaded: { initialCurrency: string; initialBasePrice: string }

if (isPlaybookMode) {
	const playbookRow = await timing.time("ratePlanModel", () =>
		loadRatePlanPlaybookReadModel({ providerId: auth.providerId, ratePlanId })
	)
	if (!playbookRow) return new Response("Tarifa no encontrada", { status: 404 })
	row = playbookRow
	const surface = await timing.time("policySurface", () =>
		buildRatePlanPoliciesSurface({
			ratePlans: [
				{
					id: ratePlanId,
					name: String(row.ratePlanName),
					isDefault: Boolean(row.isDefault),
					productId: String(row.productId),
					variantId: String(row.variantId),
				},
			],
			checkIn,
			checkOut,
			featureContext: {
				request: Astro.request,
				query: Astro.url.searchParams,
			},
			timing,
		})
	)
	policyPlans = surface.policyPlans
	context = {
		productId: String(row.productId),
		variantId: String(row.variantId),
		productName: String(row.productName ?? ""),
		variantName: String(row.variantName ?? ""),
		ratePlanName: String(row.ratePlanName),
	}
	loaded = { initialCurrency: "USD", initialBasePrice: "" }
} else {
	const loadedRatePlanPromise = timing.time("ratePlanContext", () =>
		loadRatePlanPricingData({
			request: Astro.request,
			ratePlanId,
			includePricingEditorData: true,
		})
	)
	const [readModel, loadedRatePlan, loadedPolicies] = await Promise.all([
		timing.time("ratePlanModel", () =>
			loadRatePlanReadModelById({
				providerId: auth.providerId,
				url: Astro.url,
				ratePlanId,
				checkIn,
				checkOut,
				channel: "web",
			})
		),
		loadedRatePlanPromise,
		timing.time("policySurface", () =>
			loadRatePlanPoliciesData({
				request: Astro.request,
				ratePlanId,
				checkIn,
				checkOut,
				loadedRatePlan: loadedRatePlanPromise,
				includePricingEditorData: true,
				timing,
			})
		),
	])
	if (!readModel) return new Response("Tarifa no encontrada", { status: 404 })
	if ("redirectTo" in loadedRatePlan) return Astro.redirect(loadedRatePlan.redirectTo)
	if ("redirectTo" in loadedPolicies) return Astro.redirect(loadedPolicies.redirectTo)
	row = readModel
	policyPlans = loadedPolicies.policyPlans
	context = loadedPolicies.context
	loaded = loadedRatePlan.loaded
}

const offeringType =
	String(row.productType ?? "").toLowerCase() === "tour" ? "tour" : "accommodation"
const isTourContext = offeringType === "tour"
const policyCoverageDone = Number(row.policyCoverage?.coveredCategories ?? 0)
const removalReadiness = isPlaybookMode
	? null
	: await timing.time("removalReadiness", () =>
			getRatePlanRemovalReadiness({
				ratePlanId,
				variantId: String(row.variantId),
				isActive: Boolean(row.isActive),
				isDefault: Boolean(row.isDefault),
			})
		)
const viewTitles = {
	conditions: `Condiciones tarifarias de ${row.ratePlanName}`,
	price: `Precio base de ${row.ratePlanName}`,
	details: `Datos de ${row.ratePlanName}`,
} as const
const viewDescriptions = {
	conditions: isTourContext
		? "Cancelación, pago, presentación y datos necesarios para esta salida. Los cambios se aplican a reservas futuras."
		: "Cancelación, pago y no presentación de esta tarifa. La llegada y salida se heredan del alojamiento. Los cambios se aplican a reservas futuras.",
	price: isTourContext
		? "Ajusta el precio de referencia por participante. Los cambios por fecha se hacen desde el calendario."
		: "Ajusta el precio base de referencia. Los cambios por fecha se hacen desde el calendario.",
	details: "Gestiona el nombre visible, estado comercial y configuración principal de esta tarifa.",
} as const
const tabs = [
	{ id: "conditions", label: "Condiciones", meta: `${policyCoverageDone}/4` },
	{
		id: "price",
		label: "Precio base",
		meta: Number(String(loaded.initialBasePrice ?? 0)) > 0 ? "Listo" : "Falta",
	},
	{ id: "details", label: "Datos de tarifa", meta: row.isActive ? "Activa" : "Inactiva" },
]
const flow = Astro.url.searchParams.get("flow")
if (!addRoomPlaybook.active && flow === "add-room") {
	return Astro.redirect(
		buildAddRoomHref(
			`${routes.ratePlanDetail(ratePlanId)}?vista=conditions&variantId=${encodeURIComponent(String(row.variantId))}`,
			"conditions"
		)
	)
}
if (!launchPlaybook.active && !tourLaunchPlaybook.active && flow === "create") {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("playbook", "launch")
	params.set("step", "conditions")
	if (!params.get("variantId")) params.set("variantId", String(row.variantId))
	return Astro.redirect(`${routes.ratePlanDetail(ratePlanId)}?${params.toString()}`)
}
const addRoomCtx = {
	productId: String(row.productId),
	variantId: String(row.variantId),
	ratePlanId,
}
const launchCtx = {
	productId: String(row.productId),
	isHotel: true,
	variantId: String(row.variantId),
	ratePlanId,
}
const addRoomContinueHref = addRoomPlaybook.active
	? (getNextAddRoomStep(addRoomPlaybook.stepId ?? "conditions", addRoomCtx)?.buildHref(
			addRoomCtx
		) ?? null)
	: null
const launchContinueHref = launchPlaybook.active
	? (getNextLaunchStep(launchPlaybook.stepId ?? "conditions", launchCtx)?.buildHref(launchCtx) ??
		null)
	: null
const tourCtx = {
	productId: String(row.productId),
	variantId: String(row.variantId),
	ratePlanId,
}
const tourContinueHref = tourLaunchPlaybook.active
	? (getNextTourLaunchStep("conditions")?.buildHref(tourCtx) ?? null)
	: null
const completeContinueHref = completePlaybook.active
	? isTourContext
		? buildCompleteToPublishHref(
				`${routes.calendar()}?focus=availability&productId=${encodeURIComponent(tourCtx.productId)}&variantId=${encodeURIComponent(tourCtx.variantId)}&ratePlanId=${encodeURIComponent(ratePlanId)}`,
				"calendar"
			)
		: completeToPublishNextHref(tourCtx.productId, "bookingPolicies", "hotel", {
				variantId: tourCtx.variantId,
				ratePlanId,
			})
	: null
const complianceReviewHref = (() => {
	const base = routes.providerSettingsVerificationDocuments()
	if (!(isPlaybookMode && isTourContext)) return base
	const current = new URL(`${Astro.url.pathname}${Astro.url.search}`, "http://fastt.local")
	if (!current.searchParams.get("productId"))
		current.searchParams.set("productId", tourCtx.productId)
	if (!current.searchParams.get("variantId") && tourCtx.variantId) {
		current.searchParams.set("variantId", tourCtx.variantId)
	}
	if (!current.searchParams.get("ratePlanId")) current.searchParams.set("ratePlanId", ratePlanId)
	if (!current.searchParams.get("playbook") && activePlaybook) {
		current.searchParams.set("playbook", activePlaybook)
	}
	if (!current.searchParams.get("step")) {
		current.searchParams.set(
			"step",
			activePlaybook === "complete-to-publish" ? "bookingPolicies" : "conditions"
		)
	}
	if (!current.searchParams.get("flow")) {
		current.searchParams.set(
			"flow",
			activePlaybook === "complete-to-publish" ? "complete" : "create"
		)
	}
	const returnTo = `${current.pathname}${current.search}`
	const target = new URL(base, "http://fastt.local")
	for (const key of ["playbook", "step", "flow", "productId", "variantId", "ratePlanId"]) {
		const value = current.searchParams.get(key)
		if (value) target.searchParams.set(key, value)
	}
	target.searchParams.set("playbookVertical", "tour")
	target.searchParams.set("returnTo", returnTo)
	return `${target.pathname}?${target.searchParams.toString()}`
})()
const effectiveActiveView = isPlaybookMode ? "conditions" : activeView
const Layout = activePlaybook ? PlaybookLayout : WorkspaceLayout
const layoutProps =
	activePlaybook === "add-room"
		? {
				title: `Tarifa · ${row.ratePlanName}`,
				playbookId: "add-room" as const,
				active: true,
				stepId: addRoomPlaybook.stepId ?? "conditions",
				productId: addRoomCtx.productId,
				variantId: addRoomCtx.variantId,
				ratePlanId,
				isHotel: true,
				continueHref: addRoomContinueHref,
				continueLabel: "Confirmar condiciones y continuar →",
				continueReload: true,
			}
		: activePlaybook === "launch"
			? {
					title: `Tarifa · ${row.ratePlanName}`,
					playbookId: "launch" as const,
					active: true,
					stepId: launchPlaybook.stepId ?? "conditions",
					productId: launchCtx.productId,
					variantId: launchCtx.variantId,
					ratePlanId,
					isHotel: true,
					continueHref: launchContinueHref,
					continueLabel: "Confirmar condiciones y continuar →",
					continueReload: true,
				}
			: activePlaybook === "launch-tour"
				? {
						title: `Tarifa · ${row.ratePlanName}`,
						playbookId: "launch-tour" as const,
						active: true,
						stepId: tourLaunchPlaybook.stepId ?? "conditions",
						productId: tourCtx.productId,
						variantId: tourCtx.variantId,
						ratePlanId,
						isHotel: false,
						continueHref: tourContinueHref,
						continueLabel: "Confirmar condiciones y continuar →",
						continueReload: true,
					}
				: activePlaybook === "complete-to-publish"
					? {
							title: `Tarifa · ${row.ratePlanName}`,
							playbookId: COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
							active: true,
							stepId: completePlaybook.stepId ?? "bookingPolicies",
							productId: tourCtx.productId,
							variantId: tourCtx.variantId,
							ratePlanId,
							isHotel: !isTourContext,
							playbookVertical: isTourContext ? "tour" : "hotel",
							continueHref: completeContinueHref,
							continueLabel: "Confirmar condiciones y continuar →",
							continueReload: true,
							lightweight: true,
						}
					: { title: `Tarifa · ${row.ratePlanName}` }

timing.addTotal("total")
timing.setHeader(Astro.response.headers)
logRoutePerformance({
	name: "rates.plan.detail",
	request: Astro.request,
	url: Astro.url,
	status: 200,
	startedAt,
	timing,
	userId: auth.user.id,
	providerId: auth.providerId,
	productId: row.productId,
	extra: { playbook: activePlaybook ?? "none", ratePlanId },
})
---

<Layout {...layoutProps}>
	<div class="space-y-5">
		<header class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-800 pb-5">
			<div class="space-y-1.5">
				{
					isPlaybookMode && activePlaybook !== "add-room" ? (
						<p class="flex items-center gap-2 text-xs font-semibold tracking-wide text-slate-400 uppercase">
							{isTourContext ? <Ticket class="h-4 w-4" /> : <Hotel class="h-4 w-4" />}
							{row.productName} · {isTourContext ? "Salida" : "Nueva habitación"}
						</p>
					) : null
				}
				<h1 class="text-3xl font-semibold text-slate-100">
					{isPlaybookMode ? "Condiciones de la tarifa" : viewTitles[effectiveActiveView]}
				</h1>
				<p class="max-w-2xl text-sm leading-6 text-slate-300">
					{
						isPlaybookMode
							? isTourContext
								? "Revisa cancelación, pago al proveedor, presentación y preguntas necesarias antes de abrir fechas."
								: "Creamos condiciones iniciales para esta tarifa. Revísalas o ajústalas antes de abrir disponibilidad."
							: viewDescriptions[effectiveActiveView]
					}
				</p>
			</div>
			{
				isPlaybookMode ? null : (
					<div class="flex flex-wrap gap-2">
						<Button href={routes.rates()} variant="secondary">
							Volver a tarifas
						</Button>
					</div>
				)
			}
		</header>

		<section
			class:list={[
				isPlaybookMode && isTourContext
					? "space-y-6 text-slate-100"
					: "fastt-workspace-panel overflow-hidden text-slate-900",
				!isTourContext && isPlaybookMode ? "bg-white" : "",
			]}
		>
			{
				isPlaybookMode ? null : (
					<div
						class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 pt-4"
						aria-label="Configurar tarifa"
						data-rate-plan-tabs
					>
						<TabsOutsidePanel class="mb-3" aria-label="Configurar tarifa" data-rate-plan-tabs>
							{tabs.map((tab) => (
								<a
									href={`?vista=${tab.id}`}
									data-rate-plan-tab={tab.id}
									aria-current={effectiveActiveView === tab.id ? "page" : undefined}
									data-active={effectiveActiveView === tab.id ? "true" : "false"}
									class={`fastt-tabs-outside-panel__item px-3 py-2 text-sm font-semibold whitespace-nowrap ${
										effectiveActiveView === tab.id
											? ""
											: "text-slate-600 hover:bg-sky-100/80 hover:text-sky-950"
									}`}
								>
									{tab.label} <span class="ml-1 text-xs opacity-70">{tab.meta}</span>
								</a>
							))}
						</TabsOutsidePanel>
					</div>
				)
			}

			<div
				class={effectiveActiveView === "conditions"
					? isPlaybookMode && isTourContext
						? ""
						: isPlaybookMode
							? "px-5"
							: "p-5"
					: "hidden p-5"}
				data-rate-plan-panel="conditions"
			>
				{
					isPlaybookMode && isTourContext ? (
						<div class="grid gap-6">
							<section class="fastt-card overflow-hidden rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white text-slate-950">
								<header class="flex gap-4 border-b border-slate-100 bg-slate-50/80 px-5 py-4">
									<span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-sm font-bold text-slate-800 ring-1 ring-slate-200">
										1
									</span>
									<div class="min-w-0">
										<h2 class="text-lg font-semibold text-slate-950">Contrato comercial</h2>
										<p class="mt-1 max-w-3xl text-sm leading-6 text-slate-600">
											Cancelación, pago al proveedor y presentación de la salida. El viajero ve
											estas reglas antes de confirmar.
										</p>
									</div>
								</header>
								<div class="px-2 sm:px-3">
									<RatePlanPoliciesSurface
										title={viewTitles.conditions}
										description=""
										policyPlans={policyPlans}
										checkIn={checkIn}
										checkOut={checkOut}
										requiredCategories={[...REQUIRED_POLICY_CATEGORIES]}
										productId={context.productId}
										variantId={String(row.variantId)}
										isProfessionalMode={isProfessionalMode}
										showPlanSummary={false}
										showHeader={false}
										inlineHotelArrival={false}
										offeringType={offeringType}
										playbookMode={isPlaybookMode}
										embeddedGuidedSection
									/>
								</div>
							</section>

							<section
								id="tourBookingQuestions"
								data-product-id={tourCtx.productId}
								class="fastt-card overflow-hidden rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white text-slate-950"
							>
								<header class="flex gap-4 border-b border-slate-100 bg-slate-50/80 px-5 py-4">
									<span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-sm font-bold text-slate-800 ring-1 ring-slate-200">
										2
									</span>
									<div class="min-w-0">
										<h2 class="text-lg font-semibold text-slate-950">Preguntas al reservar</h2>
										<p class="mt-1 max-w-3xl text-sm leading-6 text-slate-600">
											Solicita solo datos imprescindibles. Se preguntan una vez por reserva, aplican
											a todas las salidas y tarifas del tour, y solo afectan reservas nuevas.
										</p>
									</div>
								</header>
								<div class="space-y-5 px-5 py-5">
									<div class="grid gap-3 sm:grid-cols-2">
										{[
											["pickup_location", "Hotel o dirección de recogida"],
											["language", "Idioma preferido"],
											["dietary", "Preferencias alimentarias"],
											["mobility", "Necesidades de movilidad"],
											["weight", "Peso para seguridad/equipamiento"],
											["height", "Altura para seguridad/equipamiento"],
										].map(([code, label]) => (
											<label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-800 transition hover:border-slate-300 hover:bg-slate-50/80 has-[:checked]:border-sky-300 has-[:checked]:bg-sky-50/40">
												<input type="checkbox" value={code} data-tour-question class="mt-0.5" />
												<span>
													<span class="font-medium text-slate-950">{label}</span>
													<span class="mt-0.5 block text-xs text-slate-500">
														Obligatoria al reservar
													</span>
												</span>
											</label>
										))}
									</div>
									<div class="rounded-lg border border-slate-200 bg-slate-50/60 p-4">
										<label class="block text-sm font-medium text-slate-950">
											Pregunta adicional (opcional)
											<Input
												id="tourCustomQuestion"
												placeholder="Ej: ¿Qué talla de traje de neopreno necesitas?"
												className="mt-2 bg-white"
											/>
										</label>
										<label class="mt-3 flex items-center gap-2 text-sm text-slate-700">
											<input id="tourCustomQuestionRequired" type="checkbox" />
											Hacer obligatoria la pregunta adicional
										</label>
									</div>
									<p id="tourQuestionsStatus" class="text-sm text-slate-600" aria-live="polite" />
								</div>
							</section>

							<section class="fastt-card flex flex-col gap-4 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white px-5 py-4 text-slate-950 sm:flex-row sm:items-center sm:justify-between">
								<div class="flex min-w-0 items-start gap-3">
									<span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 ring-1 ring-slate-200">
										<ShieldCheck class="h-5 w-5" />
									</span>
									<div>
										<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
											Bloque 3 · Cumplimiento
										</p>
										<h2 class="mt-0.5 text-base font-semibold text-slate-950">
											Licencias y seguro
										</h2>
										<p class="mt-1 text-sm leading-6 text-slate-600">
											Verifica la documentación del proveedor antes de publicar. Sigues en este paso
											y vuelves aquí al terminar.
										</p>
									</div>
								</div>
								<Button
									href={complianceReviewHref}
									variant="secondary"
									size="sm"
									className="shrink-0"
								>
									Revisar licencias y seguro
								</Button>
							</section>
						</div>
					) : (
						<>
							<RatePlanPoliciesSurface
								title={viewTitles.conditions}
								description={
									isTourContext
										? "Revisa cancelación, pago al proveedor y presentación para esta salida."
										: isPlaybookMode
											? "Revisa cancelación, pago y no presentación de esta tarifa. La llegada se hereda del alojamiento."
											: "Cancelación, pago y no presentación de esta tarifa. La llegada y salida se heredan del alojamiento."
								}
								policyPlans={policyPlans}
								checkIn={checkIn}
								checkOut={checkOut}
								requiredCategories={[...REQUIRED_POLICY_CATEGORIES]}
								productId={context.productId}
								variantId={String(row.variantId)}
								isProfessionalMode={isProfessionalMode}
								showPlanSummary={false}
								showHeader={false}
								inlineHotelArrival={isPlaybookMode && !isTourContext}
								offeringType={offeringType}
								playbookMode={isPlaybookMode}
							/>
						</>
					)
				}
			</div>

			{
				isPlaybookMode ? null : (
					<div
						class={effectiveActiveView === "price" ? "p-5" : "hidden p-5"}
						data-rate-plan-panel="price"
					>
						<div class="mx-auto max-w-3xl">
							<RatePlanPricingSurface
								ratePlanId={String(row.ratePlanId)}
								initialCurrency={loaded.initialCurrency}
								initialBasePrice={loaded.initialBasePrice}
								backHref={routes.rates()}
								offeringType={offeringType}
							/>
						</div>
					</div>
				)
			}

			{
				isPlaybookMode ? null : (
					<div
						class={effectiveActiveView === "details" ? "p-5" : "hidden p-5"}
						data-rate-plan-panel="details"
					>
						<div class="mx-auto max-w-3xl">
							<form
								class="space-y-0"
								data-rate-plan-edit-form
								data-rate-plan-id={String(row.ratePlanId)}
							>
								<input type="hidden" name="isActive" value={row.isActive ? "true" : ""} />
								<section class="border-b border-slate-200 pb-8 sm:pb-12">
									<div class="mb-5 sm:mb-6">
										<h2 class="text-lg font-semibold text-slate-950">Datos de tarifa</h2>
										<p class="mt-1 text-sm leading-6 text-slate-500">
											{isTourContext
												? "Define cómo identificas esta opción y cuál será el precio de referencia de la salida."
												: "Define cómo identificas esta opción y cuál será la tarifa de referencia de la habitación."}
										</p>
									</div>
									<div class="grid gap-5 md:grid-cols-2">
										<FormField
											label="Nombre visible"
											htmlFor="rate-plan-name"
											description={
												isTourContext
													? "Es el nombre que verá el viajero al reservar."
													: "Es el nombre que verá el huésped al reservar."
											}
											required
										>
											<Input id="rate-plan-name" name="name" value={row.ratePlanName} required />
										</FormField>
										<FormField
											label="Descripción interna"
											htmlFor="rate-plan-description"
											description={
												isTourContext
													? "Solo para tu equipo; no se muestra al viajero."
													: "Solo para tu equipo; no se muestra al huésped."
											}
											class="md:col-span-2"
										>
											<Textarea
												id="rate-plan-description"
												name="description"
												rows="3"
												value={row.description ?? ""}
											/>
										</FormField>
									</div>
									<label class="mt-6 flex items-start justify-between gap-4 text-sm text-slate-700 sm:mt-8">
										<span>
											<strong class="block text-slate-950">Tarifa principal</strong>
											<span class="mt-1 block leading-5 text-slate-500">
												{isTourContext
													? "Úsala como referencia principal de precio para esta salida."
													: "Úsala como referencia principal de precio para esta habitación."}
											</span>
										</span>
										<input
											name="isDefault"
											type="checkbox"
											class="fastt-field mt-0.5 size-4"
											checked={row.isDefault}
										/>
									</label>
								</section>
								<div class="flex flex-wrap items-center justify-between gap-3 py-8 sm:py-12">
									<p class="text-sm text-slate-500" data-rate-plan-edit-feedback />
									<Button type="submit">Guardar cambios</Button>
								</div>
							</form>

							<section class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 py-8 sm:py-12">
								<div>
									<div class="flex items-center gap-2">
										<h3 class="font-semibold text-slate-950">Estado de venta</h3>
										<Badge variant={row.isActive ? "success" : "neutral"}>
											{row.isActive ? "Activa" : "Inactiva"}
										</Badge>
									</div>
									<p class="mt-1 max-w-xl text-sm text-slate-500">
										{row.isActive
											? "Desactivar detiene reservas nuevas sin borrar precio, condiciones ni historial."
											: "La tarifa está fuera de venta y puede reactivarse conservando su configuración."}
									</p>
									{row.isActive &&
										row.isDefault &&
										(removalReadiness?.activeAlternatives ?? 0) > 0 && (
											<p class="mt-2 text-sm text-amber-700">
												Designa otra tarifa principal antes de desactivar esta.
											</p>
										)}
								</div>
								<Button
									type="button"
									variant="secondary"
									data-rate-plan-toggle-status
									data-next-active={row.isActive ? "false" : "true"}
									disabled={
										row.isActive && row.isDefault && (removalReadiness?.activeAlternatives ?? 0) > 0
									}
								>
									{row.isActive ? "Desactivar tarifa" : "Activar tarifa"}
								</Button>
							</section>

							<section id="eliminar-tarifa" class="py-8 sm:py-12">
								<div class="flex flex-wrap items-start justify-between gap-4">
									<div>
										<h3 class="font-semibold text-slate-950">Eliminar tarifa</h3>
										<p class="mt-1 max-w-xl text-sm text-slate-500">
											Solo puede eliminarse si está inactiva y nunca tuvo reservas ni retenciones.
										</p>
										{(removalReadiness?.blockers.length ?? 0) > 0 && (
											<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-500">
												{(removalReadiness?.blockers ?? []).map((blocker) => (
													<li>{blocker}</li>
												))}
											</ul>
										)}
									</div>
									<Button
										type="button"
										variant="danger"
										data-open-rate-plan-delete
										disabled={!removalReadiness?.canDelete}
									>
										Eliminar definitivamente
									</Button>
								</div>
							</section>
						</div>
					</div>
				)
			}
		</section>
	</div>

	{
		isPlaybookMode ? null : (
			<dialog
				class="calendar-dialog fastt-dialog m-auto w-[min(520px,calc(100%-2rem))] border bg-white p-0 text-slate-900"
				data-rate-plan-delete-dialog
			>
				<form
					class="space-y-5 p-5"
					data-rate-plan-delete-form
					data-rate-plan-id={ratePlanId}
					data-rate-plan-name={row.ratePlanName}
				>
					<div>
						<h2 class="text-lg font-semibold text-slate-950">Eliminar {row.ratePlanName}</h2>
						<p class="mt-2 text-sm leading-6 text-slate-600">
							Se eliminarán su precio, reglas y asignaciones. Esta acción no puede deshacerse.
						</p>
					</div>
					<label class="block space-y-1.5 text-sm">
						<span class="font-medium">
							Escribe <strong>{row.ratePlanName}</strong> para confirmar
						</span>
						<Input data-rate-plan-delete-confirmation autocomplete="off" />
					</label>
					<p class="text-sm text-rose-700" data-rate-plan-delete-feedback />
					<div class="flex justify-end gap-2 border-t border-slate-200 pt-4">
						<Button type="button" variant="secondary" data-close-rate-plan-delete>
							Cancelar
						</Button>
						<Button type="submit" variant="danger" data-confirm-rate-plan-delete disabled>
							Eliminar tarifa
						</Button>
					</div>
				</form>
			</dialog>
		)
	}
</Layout>

<script>
	const ratePlanTabs = Array.from(
		document.querySelectorAll<HTMLAnchorElement>("[data-rate-plan-tab]")
	)
	const ratePlanPanels = Array.from(
		document.querySelectorAll<HTMLElement>("[data-rate-plan-panel]")
	)

	function renderRatePlanTab(view: string, updateUrl = false) {
		for (const panel of ratePlanPanels) {
			panel.classList.toggle("hidden", panel.dataset.ratePlanPanel !== view)
		}
		for (const tab of ratePlanTabs) {
			const active = tab.dataset.ratePlanTab === view
			tab.dataset.active = active ? "true" : "false"
			tab.classList.toggle("text-slate-600", !active)
			tab.classList.toggle("hover:bg-sky-100/80", !active)
			tab.classList.toggle("hover:text-sky-950", !active)
			if (active) tab.setAttribute("aria-current", "page")
			else tab.removeAttribute("aria-current")
		}
		if (updateUrl) {
			const url = new URL(window.location.href)
			url.searchParams.set("vista", view)
			window.history.pushState({ ratePlanView: view }, "", url)
		}
	}

	for (const tab of ratePlanTabs) {
		tab.addEventListener("click", (event) => {
			event.preventDefault()
			renderRatePlanTab(String(tab.dataset.ratePlanTab ?? "conditions"), true)
		})
	}
	window.addEventListener("popstate", () => {
		renderRatePlanTab(new URL(window.location.href).searchParams.get("vista") ?? "conditions")
	})

	const editForm = document.querySelector<HTMLFormElement>("[data-rate-plan-edit-form]")
	const statusButton = document.querySelector<HTMLButtonElement>("[data-rate-plan-toggle-status]")
	statusButton?.addEventListener("click", async () => {
		if (!editForm) return
		const feedback = editForm.querySelector<HTMLElement>("[data-rate-plan-edit-feedback]")
		const formData = new FormData(editForm)
		const nextActive = statusButton.dataset.nextActive === "true"
		statusButton.disabled = true
		if (feedback)
			feedback.textContent = nextActive ? "Activando tarifa..." : "Desactivando tarifa..."
		try {
			const response = await fetch("/api/rateplans/update", {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					id: editForm.dataset.ratePlanId,
					name: String(formData.get("name") || ""),
					description: String(formData.get("description") || ""),
					isActive: nextActive,
					isDefault: Boolean(formData.get("isDefault")),
				}),
			})
			const result = await response.json().catch(() => null)
			if (!response.ok) throw new Error(result?.error || "No se pudo cambiar el estado")
			window.location.reload()
		} catch (error) {
			if (feedback)
				feedback.textContent =
					error instanceof Error ? error.message : "No se pudo cambiar el estado"
			statusButton.disabled = false
		}
	})

	const deleteDialog = document.querySelector<HTMLDialogElement>("[data-rate-plan-delete-dialog]")
	const deleteForm = document.querySelector<HTMLFormElement>("[data-rate-plan-delete-form]")
	const deleteInput = deleteForm?.querySelector<HTMLInputElement>(
		"[data-rate-plan-delete-confirmation]"
	)
	const deleteSubmit = deleteForm?.querySelector<HTMLButtonElement>(
		"[data-confirm-rate-plan-delete]"
	)
	document
		.querySelector("[data-open-rate-plan-delete]")
		?.addEventListener("click", () => deleteDialog?.showModal())
	if (
		new URL(window.location.href).searchParams.get("accion") === "eliminar" &&
		!document.querySelector<HTMLButtonElement>("[data-open-rate-plan-delete]")?.disabled
	) {
		deleteDialog?.showModal()
	}
	document
		.querySelector("[data-close-rate-plan-delete]")
		?.addEventListener("click", () => deleteDialog?.close())
	deleteDialog?.addEventListener("click", (event) => {
		if (event.target === deleteDialog) deleteDialog.close()
	})
	deleteInput?.addEventListener("input", () => {
		if (deleteSubmit)
			deleteSubmit.disabled =
				deleteInput.value.trim() !== String(deleteForm?.dataset.ratePlanName ?? "")
	})
	deleteForm?.addEventListener("submit", async (event) => {
		event.preventDefault()
		if (!deleteSubmit || deleteSubmit.disabled) return
		const feedback = deleteForm.querySelector<HTMLElement>("[data-rate-plan-delete-feedback]")
		deleteSubmit.disabled = true
		if (feedback) feedback.textContent = "Eliminando tarifa..."
		try {
			const response = await fetch("/api/rateplans/delete", {
				method: "DELETE",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ id: deleteForm.dataset.ratePlanId }),
			})
			const result = await response.json().catch(() => null)
			if (!response.ok) throw new Error(result?.error || "No se pudo eliminar la tarifa")
			window.location.href = "/rates/plans/manage?vista=all"
		} catch (error) {
			if (feedback)
				feedback.textContent =
					error instanceof Error ? error.message : "No se pudo eliminar la tarifa"
			deleteSubmit.disabled = false
		}
	})

	document.querySelectorAll<HTMLFormElement>("[data-rate-plan-edit-form]").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			const feedback = form.querySelector("[data-rate-plan-edit-feedback]")
			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')
			const formData = new FormData(form)
			const payload = {
				id: form.dataset.ratePlanId,
				name: String(formData.get("name") || ""),
				description: String(formData.get("description") || ""),
				isActive: Boolean(formData.get("isActive")),
				isDefault: Boolean(formData.get("isDefault")),
			}
			if (feedback) feedback.textContent = "Guardando..."
			submit?.setAttribute("disabled", "true")
			try {
				const response = await fetch("/api/rateplans/update", {
					method: "PUT",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				})
				const result = await response.json().catch(() => null)
				if (!response.ok) throw new Error(result?.error || "No se pudo guardar la tarifa")
				window.location.reload()
			} catch (error) {
				if (feedback) {
					feedback.textContent =
						error instanceof Error ? error.message : "No se pudo guardar la tarifa"
				}
				submit?.removeAttribute("disabled")
			}
		})
	})
</script>

<script>
	const QUESTION_LABELS: Record<string, string> = {
		pickup_location: "Hotel o dirección de recogida",
		language: "Idioma preferido",
		dietary: "Preferencias alimentarias",
		mobility: "Necesidades de movilidad",
		weight: "Peso para seguridad/equipamiento",
		height: "Altura para seguridad/equipamiento",
	}

	async function initTourQuestions() {
		const root = document.getElementById("tourBookingQuestions")
		if (!(root instanceof HTMLElement) || root.dataset.bound === "true") return
		root.dataset.bound = "true"
		const productId = String(root.dataset.productId || "")
		const status = document.getElementById("tourQuestionsStatus")
		const custom = document.getElementById("tourCustomQuestion") as HTMLInputElement | null
		const customRequired = document.getElementById(
			"tourCustomQuestionRequired"
		) as HTMLInputElement | null
		const inputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-tour-question]"))
		const current = await fetch(
			`/api/tours/booking-questions?productId=${encodeURIComponent(productId)}`
		)
			.then((response) => response.json())
			.catch(() => ({ questions: [] }))
		const questions = Array.isArray(current?.questions) ? current.questions : []
		for (const input of inputs) {
			input.checked = questions.some((question: any) => question.code === input.value)
		}
		const customQuestion = questions.find((question: any) => question.code === "custom")
		if (custom && customQuestion) custom.value = String(customQuestion.label || "")
		if (customRequired && customQuestion) customRequired.checked = customQuestion.required === true

		const questionKey = (items: Array<{ code: string; label: string; required: boolean }>) =>
			JSON.stringify(items.map((item) => [item.code, item.label, item.required]))

		const readQuestions = () => {
			const selected = inputs
				.filter((input) => input.checked)
				.map((input) => ({
					code: input.value,
					label: QUESTION_LABELS[input.value] || input.value,
					required: true,
				}))
			const customLabel = custom?.value.trim() || ""
			if (customLabel) {
				selected.push({
					code: "custom",
					label: customLabel,
					required: Boolean(customRequired?.checked),
				})
			}
			return selected
		}

		let savedKey = questionKey(
			questions.map((question: any) => ({
				code: String(question.code || ""),
				label: String(question.label || ""),
				required: question.required === true,
			}))
		)
		let persistInFlight: Promise<boolean> | null = null

		const persistTourQuestions = async () => {
			const selected = readQuestions()
			const customLabel = selected.find((item) => item.code === "custom")?.label || ""
			if (customLabel && customLabel.length < 3) {
				if (status) {
					status.textContent = "La pregunta adicional necesita al menos 3 caracteres."
				}
				return false
			}
			const nextKey = questionKey(selected)
			if (nextKey === savedKey) return true
			if (persistInFlight) return persistInFlight
			persistInFlight = (async () => {
				if (status) status.textContent = "Guardando preguntas..."
				const response = await fetch("/api/tours/booking-questions", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						productId,
						questions: selected.map((item) => ({
							...item,
							id: crypto.randomUUID(),
						})),
					}),
				}).catch(() => null)
				if (!response?.ok) {
					if (status) status.textContent = "No se pudieron guardar las preguntas."
					return false
				}
				savedKey = nextKey
				if (status) status.textContent = ""
				return true
			})()
			try {
				return await persistInFlight
			} finally {
				persistInFlight = null
			}
		}

		document.addEventListener(
			"click",
			async (event) => {
				if (!root.isConnected || root.dataset.bound !== "true") return
				if (!(event.target instanceof Element)) return
				const link = event.target.closest("a[href]")
				if (!(link instanceof HTMLAnchorElement)) return
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)
					return
				const leavesStep = Boolean(
					link.closest(".fastt-playbook-footer") ||
					link.closest('[data-rate-plan-panel="conditions"]')
				)
				if (!leavesStep) return
				if (questionKey(readQuestions()) === savedKey) return
				event.preventDefault()
				event.stopPropagation()
				const href = link.href
				const saved = await persistTourQuestions()
				if (saved) window.location.assign(href)
			},
			true
		)
	}

	initTourQuestions()
	document.addEventListener("astro:page-load", initTourQuestions)
</script>
