---
import CalendarSubnav from "@/components/rates/CalendarSubnav.astro"
import CalendarWorkspaceHeader from "@/components/rates/CalendarWorkspaceHeader"
import CalendarWorkspaceSkeleton from "@/components/rates/CalendarWorkspaceSkeleton.astro"
import SingleCalendarWorkspace from "@/components/rates/SingleCalendarWorkspace"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import type { WorkspaceRequestContext } from "@/lib/dashboard/workspaceRequestContext"
import { createServerTimingRecorder } from "@/lib/observability/serverTiming"
import { resolveAddRoomPlaybookFromUrl } from "@/lib/playbook/add-room"
import {
	getNextLaunchStep,
	resolveLaunchPlaybookFromUrl,
} from "@/lib/playbook/launch-accommodation"
import {
	LAUNCH_TOUR_PLAYBOOK_ID,
	resolveTourLaunchPlaybookFromUrl,
} from "@/lib/playbook/launch-tour"
import {
	loadProviderRatePlansReadModel,
	type RatePlanListItem,
} from "@/lib/rates/loadRatePlansReadModel"
import { routes } from "@/lib/routes"
import { and, count, DailyInventory, db, eq, first, gt } from "@/shared/infrastructure/db/compat"

const timing = createServerTimingRecorder()
const workspaceContext = await timing.time<WorkspaceRequestContext>("authProvider", () =>
	Astro.locals.getWorkspaceContext()
)
if (!workspaceContext.user) return Astro.redirect("/SignInPage")
if (!workspaceContext.provider) return Astro.redirect(routes.providerSettingsProfile())
const sidebarData = await timing.time("sidebar", () => workspaceContext.sidebarDataPromise)
const auth = {
	user: workspaceContext.user,
	providerId: workspaceContext.provider.providerId,
}
const isProfessionalCalendar = sidebarData?.experience?.effective === "professional"
const requestedFocus = String(Astro.url.searchParams.get("focus") ?? "price")
const initialMode =
	requestedFocus === "availability"
		? "availability"
		: ["restrictions", "sellability"].includes(requestedFocus)
			? "sellability"
			: isProfessionalCalendar && ["policies", "conditions"].includes(requestedFocus)
				? "conditions"
				: "price"

const addRoomPlaybook = resolveAddRoomPlaybookFromUrl(Astro.url)
const launchPlaybook = resolveLaunchPlaybookFromUrl(Astro.url)
const tourLaunchPlaybook = resolveTourLaunchPlaybookFromUrl(Astro.url)
const flow = Astro.url.searchParams.get("flow")
const needsGuidedContext = Boolean(
	addRoomPlaybook.active || launchPlaybook.active || tourLaunchPlaybook.active || flow
)
const rows = needsGuidedContext
	? await timing.time("ratePlans", () =>
			loadProviderRatePlansReadModel({ providerId: auth.providerId, url: Astro.url })
		)
	: (timing.add("ratePlans", 0, "deferred_calendar_api"), [])
const variantIdParam = String(Astro.url.searchParams.get("variantId") ?? "").trim()
const ratePlanIdParam = String(Astro.url.searchParams.get("ratePlanId") ?? "").trim()
const matchedRow = rows.find(
	(row: RatePlanListItem) =>
		(variantIdParam && String(row.variantId) === variantIdParam) ||
		(ratePlanIdParam && String(row.ratePlanId) === ratePlanIdParam)
)
const playbookProductId =
	matchedRow?.productId ??
	addRoomPlaybook.productId ??
	String(Astro.url.searchParams.get("productId") ?? "")

if (!addRoomPlaybook.active && flow === "add-room" && playbookProductId) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("playbook", "add-room")
	params.set("step", "availability")
	return Astro.redirect(`${routes.calendar()}?${params.toString()}`)
}
if (!launchPlaybook.active && flow === "create" && playbookProductId) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("playbook", "launch")
	params.set("step", "calendar")
	return Astro.redirect(`${routes.calendar()}?${params.toString()}`)
}

const addRoomCtx = {
	productId: playbookProductId,
	variantId: variantIdParam || addRoomPlaybook.variantId || undefined,
	ratePlanId: ratePlanIdParam || addRoomPlaybook.ratePlanId || undefined,
}
const launchCtx = {
	productId: playbookProductId,
	isHotel: true,
	variantId: variantIdParam || undefined,
	ratePlanId: ratePlanIdParam || undefined,
}
const launchContinueHref = launchPlaybook.active
	? (getNextLaunchStep(launchPlaybook.stepId ?? "calendar", launchCtx)?.buildHref(launchCtx) ??
		null)
	: null
const activePlaybook = addRoomPlaybook.active
	? "add-room"
	: launchPlaybook.active
		? "launch"
		: tourLaunchPlaybook.active
			? "launch-tour"
			: null
const isGuidedAvailabilityStep = Boolean(
	activePlaybook &&
	(addRoomPlaybook.stepId === "availability" ||
		launchPlaybook.stepId === "calendar" ||
		tourLaunchPlaybook.stepId === "calendar")
)
const guidedVariantId = String(
	addRoomCtx.variantId || launchCtx.variantId || variantIdParam || ""
).trim()
const guidedFinalizationError =
	activePlaybook === "add-room" &&
	Astro.url.searchParams.get("finalizeError") === "activation-pending"
		? "La habitación está configurada, pero la tarifa todavía no se activó. Revisa y vuelve a finalizar la configuración."
		: undefined
const todayIso = new Date().toISOString().slice(0, 10)
const guidedInventoryDays =
	isGuidedAvailabilityStep && guidedVariantId
		? await timing.time("inventory", async () =>
				Number(
					(
						await db
							.select({ value: count() })
							.from(DailyInventory)
							.where(
								and(
									eq(DailyInventory.variantId, guidedVariantId),
									gt(DailyInventory.date, todayIso),
									gt(DailyInventory.totalInventory, 0)
								)
							)
							.then(first)
					)?.value ?? 0
				)
			)
		: 0
const Layout = activePlaybook ? PlaybookLayout : WorkspaceLayout
const layoutProps =
	activePlaybook === "add-room"
		? {
				title: "Calendario",
				playbookId: "add-room" as const,
				active: true,
				stepId: addRoomPlaybook.stepId ?? "availability",
				productId: playbookProductId,
				variantId: addRoomCtx.variantId ?? "",
				ratePlanId: addRoomCtx.ratePlanId ?? "",
				isHotel: true,
				hideFooter: true,
			}
		: activePlaybook === "launch"
			? {
					title: "Calendario",
					playbookId: "launch" as const,
					active: true,
					stepId: launchPlaybook.stepId ?? "calendar",
					productId: launchCtx.productId,
					variantId: launchCtx.variantId ?? "",
					ratePlanId: launchCtx.ratePlanId ?? "",
					isHotel: true,
					continueHref: launchContinueHref,
				}
			: activePlaybook === "launch-tour"
				? {
						title: "Calendario · Disponibilidad de la salida",
						playbookId: LAUNCH_TOUR_PLAYBOOK_ID,
						active: true,
						stepId: tourLaunchPlaybook.stepId ?? "calendar",
						productId: playbookProductId,
						variantId: variantIdParam,
						ratePlanId: ratePlanIdParam,
						isHotel: false,
						continueHref: `/product/${encodeURIComponent(playbookProductId)}/preview?playbook=launch-tour&step=preview&flow=create`,
					}
				: { title: "Calendario" }

for (const name of ["pricing", "inventory", "restrictions", "searchFreshness", "ical"]) {
	if (!timing.metrics.some((metric) => metric.name === name)) {
		timing.add(name, 0, "deferred_calendar_api")
	}
}
timing.addTotal("total")
timing.setHeader(Astro.response.headers)
---

<Layout {...layoutProps}>
	<div class="space-y-6 md:space-y-8">
		{
			isGuidedAvailabilityStep ? (
				<header class="flex flex-wrap items-start justify-between gap-4">
					<div class="space-y-2">
						{activePlaybook === "launch-tour" ? (
							<p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
								{matchedRow?.productName ?? ""} · Primera salida
							</p>
						) : null}
						<h1 class="text-3xl font-semibold text-slate-100">Disponibilidad inicial</h1>
						<p class="max-w-3xl text-sm leading-6 text-slate-300">
							{activePlaybook === "launch-tour"
								? "Abre al menos una fecha futura con cupo para participantes. Esa será la primera salida que podrán reservar los viajeros."
								: "Elige las primeras fechas en las que esta habitación podrá recibir reservas. Después podrás operar el calendario completo."}
						</p>
					</div>
				</header>
			) : null
		}
		{
			!isGuidedAvailabilityStep && !activePlaybook ? (
				<>
					<CalendarWorkspaceHeader client:load initialMode={initialMode} />
					<CalendarSubnav isProfessional={isProfessionalCalendar} />
				</>
			) : null
		}

		<SingleCalendarWorkspace
			client:only="react"
			initialRatePlanId={ratePlanIdParam || undefined}
			initialVariantId={variantIdParam || undefined}
			initialMonth={Astro.url.searchParams.get("month") ?? undefined}
			isProfessional={isProfessionalCalendar}
			initialMode={initialMode}
			guidedAvailability={isGuidedAvailabilityStep
				? {
						playbook: activePlaybook,
						productId: playbookProductId,
						productName: matchedRow?.productName ?? "",
						variantName: matchedRow?.variantName ?? "",
						ratePlanName: matchedRow?.ratePlanName ?? "",
						requiredDays: activePlaybook === "launch-tour" ? 1 : 30,
						initialInventoryDays: guidedInventoryDays,
						finalizationError: guidedFinalizationError,
					}
				: undefined}
		>
			<CalendarWorkspaceSkeleton slot="fallback" />
		</SingleCalendarWorkspace>
	</div>
</Layout>
