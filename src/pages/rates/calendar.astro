---
import PlaybookStepHeader from "@/components/playbook/PlaybookStepHeader.astro"
import CalendarRuntimeRecovery from "@/components/rates/CalendarRuntimeRecovery.astro"
import CalendarSubnav from "@/components/rates/CalendarSubnav.astro"
import CalendarWorkspaceHeader from "@/components/rates/CalendarWorkspaceHeader"
import CalendarWorkspaceSkeleton from "@/components/rates/CalendarWorkspaceSkeleton.astro"
import SingleCalendarWorkspace from "@/components/rates/SingleCalendarWorkspace"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import type { WorkspaceRequestContext } from "@/lib/dashboard/workspaceRequestContext"
import { createServerTimingRecorder } from "@/lib/observability/serverTiming"
import { resolveAddRoomPlaybookFromUrl } from "@/lib/playbook/add-room"
import { optionWizardContext, optionWizardHref } from "@/lib/playbook/add-tour-option"
import {
	buildCompleteToPublishHref,
	COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
	completeToPublishNextHref,
	resolveCompleteToPublishPlaybookFromUrl,
} from "@/lib/playbook/complete-to-publish"
import {
	getNextLaunchStep,
	resolveLaunchPlaybookFromUrl,
} from "@/lib/playbook/launch-accommodation"
import {
	buildTourPlaybookHref,
	getTourSharedRateCanonicalHref,
	LAUNCH_TOUR_PLAYBOOK_ID,
	resolveTourLaunchPlaybookFromUrl,
	tourPreparationNextHref,
} from "@/lib/playbook/launch-tour"
import {
	loadProviderRatePlansReadModel,
	type RatePlanListItem,
} from "@/lib/rates/loadRatePlansReadModel"
import { providerLocalToday } from "@/lib/rates/providerLocalToday"
import { sellableDailyInventoryCondition } from "@/lib/rates/sellableDailyInventoryCondition"
import { routes } from "@/lib/routes"
import {
	loadTourCommercialEntryContext,
	tourContextEntryResponse,
} from "@/lib/tours/loadTourCommercialContext"
import { tourCalendarPlaybookLead } from "@/lib/tours/tourCalendarPlaybookLead"
import {
	and,
	count,
	DailyInventory,
	db,
	eq,
	first,
	gt,
	Product,
	ProviderProfile,
	sql,
	TourSlotProfile,
	Variant,
} from "@/shared/infrastructure/db/compat"

const timing = createServerTimingRecorder()
const workspaceContext = await timing.time<WorkspaceRequestContext>("authProvider", () =>
	Astro.locals.getWorkspaceContext()
)
if (!workspaceContext.user) return Astro.redirect("/SignInPage")
if (!workspaceContext.provider) return Astro.redirect(routes.providerOnboardingStart())
const sidebarData = await timing.time("sidebar", () => workspaceContext.sidebarDataPromise)
const auth = {
	user: workspaceContext.user,
	providerId: workspaceContext.provider.providerId,
}
const isProfessionalCalendar = sidebarData?.experience?.effective === "professional"
const requestedFocus = String(Astro.url.searchParams.get("focus") ?? "price")
const initialMode =
	requestedFocus === "availability"
		? "availability"
		: ["restrictions", "sellability"].includes(requestedFocus)
			? "sellability"
			: isProfessionalCalendar && ["policies", "conditions"].includes(requestedFocus)
				? "conditions"
				: "price"

const addRoomPlaybook = resolveAddRoomPlaybookFromUrl(Astro.url)
const launchPlaybook = resolveLaunchPlaybookFromUrl(Astro.url)
const tourLaunchPlaybook = resolveTourLaunchPlaybookFromUrl(Astro.url)
const completePlaybook = resolveCompleteToPublishPlaybookFromUrl(Astro.url)
const flow = Astro.url.searchParams.get("flow")
const needsGuidedContext = Boolean(
	Astro.url.searchParams.get("playbook") === "add-tour-option" ||
	addRoomPlaybook.active ||
	launchPlaybook.active ||
	tourLaunchPlaybook.active ||
	completePlaybook.active ||
	flow
)
const rows = needsGuidedContext
	? await timing.time("ratePlans", () =>
			loadProviderRatePlansReadModel({ providerId: auth.providerId, url: Astro.url })
		)
	: (timing.add("ratePlans", 0, "deferred_calendar_api"), [])
const variantIdParam = String(Astro.url.searchParams.get("variantId") ?? "").trim()
const ratePlanIdParam = String(Astro.url.searchParams.get("ratePlanId") ?? "").trim()
const matchedRow = rows.find(
	(row: RatePlanListItem) =>
		Boolean(variantIdParam || ratePlanIdParam) &&
		(!variantIdParam || String(row.variantId) === variantIdParam) &&
		(!ratePlanIdParam || String(row.ratePlanId) === ratePlanIdParam)
)
const requestedProductId = String(Astro.url.searchParams.get("productId") ?? "").trim()
const requestedVariantId = String(Astro.url.searchParams.get("variantId") ?? "").trim()
const entryContext = await loadTourCommercialEntryContext({
	providerId: auth.providerId,
	productId: requestedProductId,
	request: Astro.request,
	url: Astro.url,
})
if (entryContext) {
	const entryResponse = tourContextEntryResponse(entryContext, Astro.url)
	if (entryResponse) return entryResponse
}

const calendarDependency =
	entryContext?.status === "unresolved" &&
	["missing_option", "missing_rate"].includes(entryContext.reason)
		? entryContext.reason
		: null
const calendarDependencyTarget = new URL(
	buildTourPlaybookHref(
		calendarDependency === "missing_rate"
			? `/rates/plans/manage?productId=${encodeURIComponent(requestedProductId)}&openDialog=1`
			: `/product/${encodeURIComponent(requestedProductId)}/tickets`,
		calendarDependency === "missing_rate" ? "rate" : "tickets"
	),
	Astro.url
)
for (const key of ["variantId", "ratePlanId", "returnTo"]) {
	const value = Astro.url.searchParams.get(key)
	if (value) calendarDependencyTarget.searchParams.set(key, value)
}
const calendarDependencyHref = calendarDependencyTarget.pathname + calendarDependencyTarget.search

const contextualRow =
	matchedRow ?? rows.find((row: RatePlanListItem) => String(row.productId) === requestedProductId)
const requestedProduct =
	!contextualRow && requestedProductId
		? await db
				.select({ productId: Product.id, productType: Product.productType })
				.from(Product)
				.where(and(eq(Product.id, requestedProductId), eq(Product.providerId, auth.providerId)))
				.then(first)
		: !contextualRow && requestedVariantId
			? await db
					.select({ productId: Product.id, productType: Product.productType })
					.from(Variant)
					.innerJoin(Product, eq(Product.id, Variant.productId))
					.where(and(eq(Variant.id, requestedVariantId), eq(Product.providerId, auth.providerId)))
					.then(first)
			: null
const playbookProductId =
	contextualRow?.productId ??
	addRoomPlaybook.productId ??
	completePlaybook.productId ??
	requestedProduct?.productId ??
	requestedProductId
const isTourContext =
	String(contextualRow?.productType ?? requestedProduct?.productType ?? "").toLowerCase() === "tour"

const tourCanonicalHref = getTourSharedRateCanonicalHref(Astro.url, {
	isTour: isTourContext,
	step: "calendar",
	productId: String(contextualRow?.productId ?? requestedProduct?.productId ?? requestedProductId),
	variantId: String(contextualRow?.variantId ?? variantIdParam),
	ratePlanId: String(contextualRow?.ratePlanId ?? ratePlanIdParam),
})
if (tourCanonicalHref) return Astro.redirect(tourCanonicalHref)

if (!addRoomPlaybook.active && flow === "add-room" && playbookProductId) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("playbook", "add-room")
	params.set("step", "availability")
	return Astro.redirect(`${routes.calendar()}?${params.toString()}`)
}
if (
	!launchPlaybook.active &&
	!tourLaunchPlaybook.active &&
	!completePlaybook.active &&
	flow === "create" &&
	playbookProductId &&
	!isTourContext
) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("playbook", "launch")
	params.set("step", "calendar")
	return Astro.redirect(`${routes.calendar()}?${params.toString()}`)
}

const addRoomCtx = {
	productId: playbookProductId,
	variantId: variantIdParam || addRoomPlaybook.variantId || undefined,
	ratePlanId: ratePlanIdParam || addRoomPlaybook.ratePlanId || undefined,
}
const launchCtx = {
	productId: playbookProductId,
	isHotel: true,
	variantId: variantIdParam || undefined,
	ratePlanId: ratePlanIdParam || undefined,
}
const launchContinueHref = launchPlaybook.active
	? (getNextLaunchStep(launchPlaybook.stepId ?? "calendar", launchCtx)?.buildHref(launchCtx) ??
		null)
	: null
const optionWizard = optionWizardContext(Astro.url)
const activePlaybook = optionWizard
	? "add-tour-option"
	: addRoomPlaybook.active
		? "add-room"
		: completePlaybook.active
			? "complete-to-publish"
			: launchPlaybook.active
				? "launch"
				: tourLaunchPlaybook.active
					? "launch-tour"
					: null
const isGuidedAvailabilityStep = Boolean(
	activePlaybook &&
	(optionWizard ||
		addRoomPlaybook.stepId === "availability" ||
		launchPlaybook.stepId === "calendar" ||
		tourLaunchPlaybook.stepId === "calendar" ||
		completePlaybook.stepId === "calendar")
)
const guidedVariantId = String(
	addRoomCtx.variantId || launchCtx.variantId || variantIdParam || ""
).trim()
const guidedFinalizationError =
	activePlaybook === "add-room" &&
	Astro.url.searchParams.get("finalizeError") === "activation-pending"
		? "La habitación está configurada, pero la tarifa todavía no se activó. Revisa y vuelve a finalizar la configuración."
		: undefined
const calendarTimezone = isGuidedAvailabilityStep
	? (
			await db
				.select({ timezone: ProviderProfile.timezone })
				.from(ProviderProfile)
				.where(eq(ProviderProfile.providerId, auth.providerId))
				.then(first)
		)?.timezone || "UTC"
	: "UTC"
const guidedAvailabilityStats =
	isGuidedAvailabilityStep && guidedVariantId && isTourContext
		? await timing.time("inventory", async () => {
				const [availability, configuredDates, profile] = await Promise.all([
					db
						.select({ value: count() })
						.from(DailyInventory)
						.where(
							and(
								eq(DailyInventory.variantId, guidedVariantId),
								gt(DailyInventory.date, providerLocalToday(playbookProductId)),
								sellableDailyInventoryCondition()
							)
						)
						.then(first),
					db
						.select({
							futureDateCount: sql<number>`count(*) filter (where ${DailyInventory.date} > ${providerLocalToday(playbookProductId)})`,
							futureCapacityDateCount: sql<number>`count(*) filter (where ${DailyInventory.date} > ${providerLocalToday(playbookProductId)} and ${DailyInventory.totalInventory} > 0)`,
						})
						.from(DailyInventory)
						.where(eq(DailyInventory.variantId, guidedVariantId))
						.then(first),
					db
						.select({ bookingMode: TourSlotProfile.bookingMode })
						.from(TourSlotProfile)
						.where(eq(TourSlotProfile.variantId, guidedVariantId))
						.then(first),
				])
				return {
					availableDateCount: Number(availability?.value ?? 0),
					futureDateCount: Number(configuredDates?.futureDateCount ?? 0),
					futureCapacityDateCount: Number(configuredDates?.futureCapacityDateCount ?? 0),
					bookingMode: profile?.bookingMode ?? null,
				}
			})
		: null
const guidedInventoryDays =
	guidedAvailabilityStats?.availableDateCount ??
	(isGuidedAvailabilityStep && guidedVariantId && !isTourContext
		? await timing.time("inventory", async () =>
				Number(
					(
						await db
							.select({ value: count() })
							.from(DailyInventory)
							.where(
								and(
									eq(DailyInventory.variantId, guidedVariantId),
									gt(DailyInventory.date, providerLocalToday(playbookProductId)),
									sellableDailyInventoryCondition()
								)
							)
							.then(first)
					)?.value ?? 0
				)
			)
		: 0)
const tourCalendarLead = isTourContext
	? tourCalendarPlaybookLead(guidedAvailabilityStats ?? {})
	: "Configura las primeras fechas con inventario para esta habitación. Después podrás operar el calendario completo."
const tourGuidedLaunchContext = {
	productId: playbookProductId,
	variantId: variantIdParam || undefined,
	ratePlanId: ratePlanIdParam || undefined,
}
const tourGuidedPlaybookContinue =
	isGuidedAvailabilityStep && isTourContext
		? {
				hideFooter: false,
				playbookVertical: "tour" as const,
				continueLabel: calendarDependency ? "Completar después" : "Cargando calendario…",
				continueHref:
					activePlaybook === "launch-tour"
						? tourPreparationNextHref(
								new URLSearchParams(Astro.url.searchParams),
								tourGuidedLaunchContext,
								"calendar"
							)
						: activePlaybook === "complete-to-publish"
							? completeToPublishNextHref(
									playbookProductId,
									"calendar",
									"tour",
									tourGuidedLaunchContext
								)
							: null,
				continueDisabled: !calendarDependency,
				continueDisabledTitle: "Espera a que cargue el calendario.",
			}
		: null
const Layout = activePlaybook ? PlaybookLayout : WorkspaceLayout
const layoutProps = optionWizard
	? {
			title: "Fechas y cupos",
			playbookId: "add-tour-option" as const,
			active: true,
			stepId: "calendar",
			productId: playbookProductId,
			variantId: variantIdParam,
			ratePlanId: ratePlanIdParam,
			playbookVertical: "tour" as const,
			continueHref: optionWizardHref(optionWizard, "review"),
			continueLabel: "Continuar a revisión",
			lightweight: true,
		}
	: activePlaybook === "add-room"
		? {
				title: "Calendario",
				playbookId: "add-room" as const,
				active: true,
				stepId: addRoomPlaybook.stepId ?? "availability",
				productId: playbookProductId,
				variantId: addRoomCtx.variantId ?? "",
				ratePlanId: addRoomCtx.ratePlanId ?? "",
				isHotel: true,
				hideFooter: true,
			}
		: activePlaybook === "launch"
			? {
					title: "Calendario",
					playbookId: "launch" as const,
					active: true,
					stepId: launchPlaybook.stepId ?? "calendar",
					productId: launchCtx.productId,
					variantId: launchCtx.variantId ?? "",
					ratePlanId: launchCtx.ratePlanId ?? "",
					isHotel: true,
					continueHref: launchContinueHref,
				}
			: activePlaybook === "launch-tour"
				? {
						title: "Calendario · Disponibilidad de la salida",
						playbookId: LAUNCH_TOUR_PLAYBOOK_ID,
						active: true,
						stepId: tourLaunchPlaybook.stepId ?? "calendar",
						productId: playbookProductId,
						variantId: variantIdParam,
						ratePlanId: ratePlanIdParam,
						isHotel: false,
						...tourGuidedPlaybookContinue,
					}
				: activePlaybook === "complete-to-publish"
					? {
							title: isTourContext
								? "Calendario · Disponibilidad de la salida"
								: "Calendario · Disponibilidad inicial",
							playbookId: COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
							active: true,
							stepId: completePlaybook.stepId ?? "calendar",
							productId: playbookProductId,
							variantId: variantIdParam,
							ratePlanId: ratePlanIdParam,
							isHotel: !isTourContext,
							playbookVertical: isTourContext ? "tour" : "hotel",
							continueHref: isTourContext
								? (tourGuidedPlaybookContinue?.continueHref ?? null)
								: buildCompleteToPublishHref(routes.productPreview(playbookProductId), "preview"),
							hideFooter: isTourContext ? false : undefined,
							...(isTourContext ? tourGuidedPlaybookContinue : {}),
						}
					: { title: "Calendario" }

for (const name of ["pricing", "inventory", "restrictions", "searchFreshness", "ical"]) {
	if (!timing.metrics.some((metric) => metric.name === name)) {
		timing.add(name, 0, "deferred_calendar_api")
	}
}
timing.addTotal("total")
timing.setHeader(Astro.response.headers)
---

<Layout
	{...layoutProps}
	productType={contextualRow?.productType ?? requestedProduct?.productType ?? null}
	productDisplayName={contextualRow?.productName ?? ""}
	hidePublicationCorrections={Boolean(isGuidedAvailabilityStep && isTourContext)}
>
	<div class="space-y-6 md:space-y-8">
		{
			isGuidedAvailabilityStep ? (
				<header
					id={isTourContext ? "tour-publication-cause" : undefined}
					class="flex flex-wrap items-start justify-between gap-4"
				>
					{isTourContext ? (
						<PlaybookStepHeader
							size="lg"
							icon="calendar"
							title="Fechas y cupos"
							lead={tourCalendarLead}
							leadClass="max-w-3xl"
						/>
					) : (
						<PlaybookStepHeader
							size="lg"
							icon="calendar"
							title="Disponibilidad inicial"
							lead={tourCalendarLead}
							leadClass="max-w-3xl"
						/>
					)}
				</header>
			) : null
		}
		{
			!isGuidedAvailabilityStep && !activePlaybook ? (
				<>
					<CalendarWorkspaceHeader client:load initialMode={initialMode} />
					<CalendarSubnav isProfessional={isProfessionalCalendar} />
				</>
			) : null
		}

		{
			calendarDependency ? (
				<Card class="bg-white text-slate-900">
					<h2 class="text-lg font-semibold">
						{calendarDependency === "missing_option"
							? "Primero crea una opción para configurar sus fechas"
							: "Primero configura la tarifa de esta opción"}
					</h2>
					<p class="mt-2 mb-4 text-sm text-slate-600">
						Las fechas y los cupos pertenecen a una opción del tour.
					</p>
					<Button href={calendarDependencyHref}>Configurar opción y precio</Button>
				</Card>
			) : (
				<div data-calendar-runtime>
					<SingleCalendarWorkspace
						client:only="react"
						initialRatePlanId={ratePlanIdParam || undefined}
						initialVariantId={variantIdParam || undefined}
						initialMonth={Astro.url.searchParams.get("month") ?? undefined}
						isProfessional={isProfessionalCalendar}
						tourScheduling={isTourContext}
						initialMode={initialMode}
						guidedAvailability={
							isGuidedAvailabilityStep
								? {
										playbook: activePlaybook,
										vertical: isTourContext ? "tour" : "hotel",
										productId: playbookProductId,
										productName: matchedRow?.productName ?? "",
										variantName: matchedRow?.variantName ?? "",
										ratePlanName: matchedRow?.ratePlanName ?? "",
										requiredDays: isTourContext ? 1 : 30,
										initialInventoryDays: guidedInventoryDays,
										timezone: calendarTimezone,
										finalizationError: guidedFinalizationError,
									}
								: undefined
						}
					>
						<CalendarWorkspaceSkeleton slot="fallback" />
					</SingleCalendarWorkspace>
					<CalendarRuntimeRecovery />
				</div>
			)
		}
	</div>
</Layout>
