---
import FinancialUnifiedWorkspace from "@/components/financial/FinancialUnifiedWorkspace.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { prepareFinancialWorkspaceScope } from "@/lib/workspace/financialWorkspaceScope"

const prepared = await prepareFinancialWorkspaceScope(Astro.request, Astro.url)
if (prepared instanceof Response) return prepared
---

<WorkspaceLayout title="Finanzas">
	<FinancialUnifiedWorkspace
		scope={prepared.scope}
		isSimpleFinancialView={prepared.isSimpleFinancialView}
	/>
</WorkspaceLayout>
