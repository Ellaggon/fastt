---
import { productRepository, variantManagementRepository } from "@/container"
import { isTourProductType } from "@/lib/catalog/productVerticalRegistry"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Section from "@/components/ui/Section.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { routes } from "@/lib/routes"
import { loadProviderOperationalDay } from "@/lib/booking/providerOperationalDay"

const workspaceContext = await Astro.locals.getWorkspaceContext()
if (!workspaceContext.user) return Astro.redirect("/SignInPage")
if (!workspaceContext.provider) return Astro.redirect(routes.providerOnboardingStart())
const requestedVariantId = Astro.url.searchParams.get("variantId") || ""
const variant = requestedVariantId
	? await variantManagementRepository.getVariantById(requestedVariantId)
	: null
const productId = Astro.url.searchParams.get("productId") || variant?.productId || ""
const product = productId
	? await productRepository.ensureProductOwnedByProvider(
			productId,
			workspaceContext.provider.providerId
		)
	: null
if (
	(productId && (!product || !isTourProductType(product.productType))) ||
	(requestedVariantId && (!variant || variant.productId !== productId))
)
	return new Response("Salida no encontrada", { status: 404 })
const dayParams = new URLSearchParams({ scope: "tour" })
if (productId) dayParams.set("productId", productId)
if (requestedVariantId) dayParams.set("variantId", requestedVariantId)
const dayReturn = `/booking/day-of?${dayParams}`
const calendarHref = `/rates/calendar?${dayParams}`
const bookingsParams = new URLSearchParams(dayParams)
bookingsParams.set("vista", "all")
const bookingsHref = `${routes.bookingList()}?${bookingsParams}`
const { date: operationalDate, timezone } = await loadProviderOperationalDay(
	workspaceContext.provider.providerId
)
const dateLabel = new Intl.DateTimeFormat("es-BO", { dateStyle: "long", timeZone: "UTC" }).format(
	new Date(`${operationalDate}T12:00:00Z`)
)
const dayOfMetricCardClass = "fastt-card border border-white/10 bg-white/5 p-5 text-white"
const dayOfMetricLabels = [
	"Reservas por gestionar",
	"Reservas presentadas",
	"Vouchers emitidos",
	"Salidas con reservas",
] as const
---

<WorkspaceLayout title="Cola day-of" productType="tour">
	<section class="space-y-8" data-day-of-queue>
		<header
			class="flex flex-col gap-4 border-b border-slate-800 pb-5 lg:flex-row lg:items-end lg:justify-between"
		>
			<div class="space-y-2">
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">
					Operación del día
				</p>
				<h1 class="text-3xl font-semibold tracking-tight text-white">Cola day-of</h1>
				<p class="max-w-3xl text-sm leading-6 text-slate-400">
					Salidas de hoy · {dateLabel} · {timezone}. {product?.name ? `${product.name} · ` : ""}
					Gestiona las reservas confirmadas de la jornada.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				<Button href={bookingsHref} variant="secondary">Todas las reservas</Button>
				<Button href={calendarHref} variant="primary">Salidas y cupos</Button>
			</div>
		</header>

		<div id="dayOfMetrics" class="grid grid-cols-2 gap-3 sm:grid-cols-4">
			{
				dayOfMetricLabels.map((label) => (
					<div class={dayOfMetricCardClass}>
						<p class="text-sm text-slate-400">{label}</p>
						<p class="mt-2 h-8 w-12 animate-pulse rounded bg-white/10" aria-hidden="true" />
					</div>
				))
			}
		</div>

		<Section
			titleClass="text-slate-100"
			title="Reservas por salida"
			description="Ordenadas por hora de salida."
		>
			<Card class="fastt-workspace-panel min-h-[280px] border bg-white p-0 text-slate-900">
				<div
					class="flex flex-col gap-2 border-b border-slate-200 px-4 py-4 sm:flex-row sm:items-center sm:justify-between"
				>
					<p id="dayOfSummary" class="text-sm text-slate-600">Cargando salidas...</p>
					<Button id="dayOfRetry" type="button" variant="ghost" size="sm" hidden>Reintentar</Button>
				</div>
				<div id="dayOfRows" class="divide-y divide-slate-100">
					{
						Array.from({ length: 4 }).map(() => (
							<div class="px-4 py-4">
								<div class="h-4 w-40 animate-pulse rounded bg-slate-200" />
								<div class="mt-2 h-3 w-56 animate-pulse rounded bg-slate-100" />
							</div>
						))
					}
				</div>
			</Card>
		</Section>
	</section>

	<script
		is:inline
		data-astro-rerun
		define:vars={{ operationalDate, productId, requestedVariantId, dayReturn, calendarHref }}
	>
		;(function () {
			const root = document.querySelector("[data-day-of-queue]")
			if (!(root instanceof HTMLElement)) return
			if (root.dataset.dayOfBootReady === "true") return
			root.dataset.dayOfBootReady = "true"

			const summary = document.getElementById("dayOfSummary")
			const retry = document.getElementById("dayOfRetry")
			const rows = document.getElementById("dayOfRows")
			const metrics = document.getElementById("dayOfMetrics")

			const todayIso = () => operationalDate
			const escapeHtml = (value) =>
				String(value ?? "")
					.replace(/&/g, "&amp;")
					.replace(/</g, "&lt;")
					.replace(/>/g, "&gt;")
					.replace(/"/g, "&quot;")

			const guestName = (item) => {
				const guestLabel = String(item?.opsCopy?.guest || "participante")
				return String(
					item?.guestName ||
						item?.guestEmail ||
						`${guestLabel[0].toUpperCase()}${guestLabel.slice(1)} por registrar`
				)
			}

			const voucherLabel = (item) => {
				const status = String(item?.voucher?.status || "").toLowerCase()
				if (!status) return "Sin voucher"
				if (status === "issued") return "Voucher emitido"
				if (status === "redeemed") return "Voucher canjeado"
				if (status === "void") return "Voucher anulado"
				return `Voucher ${status}`
			}

			const actionLabel = (item) => {
				const voucherStatus = String(item?.voucher?.status || "").toLowerCase()
				const presented =
					Boolean(item?.checkedInAt) ||
					String(item?.operationalStatus || "").toLowerCase() === "checked_in"
				if (presented && voucherStatus === "issued") return "Reparar voucher"
				if (item?.canCheckIn)
					return String(item?.opsCopy?.confirmArrivalAction || "Registrar presentación")
				if (voucherStatus === "redeemed") return "Listo"
				return "Ver reserva"
			}

			const checkInBooking = async (bookingId, button) => {
				if (!bookingId || !button) return
				button.setAttribute("disabled", "true")
				const previous = button.textContent
				button.textContent = "Registrando..."
				try {
					const response = await fetch("/api/booking/check-in", {
						method: "POST",
						headers: { "Content-Type": "application/json", "accept": "application/json" },
						body: JSON.stringify({ bookingId }),
					})
					const payload = await response.json().catch(() => ({}))
					if (!response.ok) {
						button.textContent = previous
						button.removeAttribute("disabled")
						window.alert(
							payload?.error === "booking_not_confirmed"
								? "La reserva debe estar confirmada."
								: "No se pudo registrar la presentación."
						)
						return
					}
					await loadQueue()
				} catch {
					button.textContent = previous
					button.removeAttribute("disabled")
					window.alert("Error de red al registrar presentación.")
				}
			}

			const markNoShow = async (bookingId, button) => {
				if (!bookingId || !button) return
				if (!window.confirm("¿Marcar esta reserva como no presentada?")) return
				button.setAttribute("disabled", "true")
				try {
					const response = await fetch("/api/booking/tour-operations", {
						method: "POST",
						headers: { "Content-Type": "application/json", "accept": "application/json" },
						body: JSON.stringify({ bookingId, action: "no_show" }),
					})
					if (!response.ok) throw new Error("no_show_failed")
					await loadQueue()
				} catch {
					button.removeAttribute("disabled")
					window.alert("No se pudo marcar la reserva como no presentada.")
				}
			}

			const renderMetrics = (items) => {
				if (!metrics) return
				const pending = items.filter((item) => item?.canCheckIn).length
				const presented = items.filter(
					(item) =>
						Boolean(item?.checkedInAt) ||
						String(item?.operationalStatus || "").toLowerCase() === "checked_in"
				).length
				const issued = items.filter(
					(item) => String(item?.voucher?.status || "").toLowerCase() === "issued"
				).length
				const cards = [
					["Reservas por gestionar", pending],
					["Reservas presentadas", presented],
					["Vouchers emitidos", issued],
					[
						"Salidas con reservas",
						new Set(
							items.map(
								(item) => `${item?.productId || ""}:${item?.variantId || item?.bookingId || ""}`
							)
						).size,
					],
				]
				metrics.innerHTML = cards
					.map(
						([
							label,
							value,
						]) => `<div class="fastt-card border border-white/10 bg-white/5 p-5 text-white">
						<p class="text-sm text-slate-400">${label}</p>
						<p class="mt-2 text-2xl font-semibold text-white tabular-nums">${value}</p>
					</div>`
					)
					.join("")
			}

			const renderRows = (items) => {
				if (!rows) return
				if (!items.length) {
					rows.innerHTML = `<div class="px-4 py-10 text-center text-sm text-slate-500">No hay reservas confirmadas para hoy.<a class="mt-3 block font-semibold text-slate-700" href="${escapeHtml(calendarHref)}">Revisar Salidas y cupos</a></div>`
					return
				}
				const byDeparture = new Map()
				items.forEach((item) => {
					const key = `${item?.productId || ""}:${item?.variantId || item?.bookingId || ""}`
					const group = byDeparture.get(key) || []
					group.push(item)
					byDeparture.set(key, group)
				})
				rows.innerHTML = [...byDeparture.values()]
					.map((group) => {
						const [departure] = group
						const pax = group.reduce(
							(total, item) =>
								total +
								Number(item?.occupancyDetail?.adults || 0) +
								Number(item?.occupancyDetail?.children || 0) +
								Number(item?.occupancyDetail?.infants || 0),
							0
						)

						const presented = group.filter((item) => Boolean(item?.checkedInAt)).length
						const noShows = group.filter(
							(item) => String(item?.operationalStatus || "").toLowerCase() === "no_show"
						).length
						const heading = `<div class="flex flex-wrap items-center justify-between gap-2 bg-slate-50 px-4 py-3">
							<div><p class="font-semibold text-slate-950">${escapeHtml(departure?.departureTime || "Sin hora")} · ${escapeHtml(departure?.productName || "Tour")}</p><p class="text-xs text-slate-500">${escapeHtml(departure?.variantName || "Salida")} · ${pax} participantes · ${presented} reservas presentadas${noShows ? ` · ${noShows} reservas no presentadas` : ""}</p></div>
							<a class="text-xs font-semibold text-slate-600 hover:text-slate-950" href="/product/${encodeURIComponent(String(departure?.productId || ""))}/departures/${encodeURIComponent(String(departure?.variantId || ""))}?departureDate=${encodeURIComponent(operationalDate)}&returnTo=${encodeURIComponent(dayReturn)}#departureManifest">Ver manifiesto</a>
						</div>`
						const participants = group
							.map((item) => {
								const time = String(item?.departureTime || "—")
								const product = escapeHtml(item?.productName || "Tour")
								const variant = escapeHtml(item?.variantName || "Salida")
								const guest = escapeHtml(guestName(item))
								const voucher = escapeHtml(voucherLabel(item))
								const lifecycle = escapeHtml(item?.lifecycleLabel || item?.operationalStatus || "—")
								const action = actionLabel(item)
								const canAct = Boolean(item?.canCheckIn)
								const primary = canAct
									? `<button type="button" class="fastt-button inline-flex h-9 items-center justify-center rounded-md border border-slate-950 bg-slate-950 px-3 text-sm font-semibold text-white hover:bg-slate-800" data-check-in="${escapeHtml(item.bookingId)}">${escapeHtml(action)}</button>`
									: `<a class="fastt-button inline-flex h-9 items-center justify-center rounded-md border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-800" href="/booking/${encodeURIComponent(String(item.bookingId || ""))}">${escapeHtml(action)}</a>`
								const noShow = canAct
									? `<button type="button" class="fastt-button inline-flex h-9 items-center justify-center rounded-md px-2 text-xs font-semibold text-slate-600 hover:bg-slate-100" data-no-show="${escapeHtml(item.bookingId)}">No presentada</button>`
									: ""
								return `<article class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
							<div class="min-w-0 space-y-1">
								<p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">${escapeHtml(time)}</p>
								<p class="font-semibold text-slate-950">${guest}</p>
								<p class="text-sm text-slate-700">${product} · ${variant}</p>
								<p class="text-xs text-slate-500">${voucher} · ${lifecycle}</p>
							</div>
							<div class="flex flex-wrap items-center gap-2">${primary}${noShow}
								<a class="text-xs font-medium text-slate-500 hover:text-slate-800" href="/booking/${encodeURIComponent(String(item.bookingId || ""))}">Detalle</a>
							</div>
						</article>`
							})
							.join("")
						return `<section>${heading}<div>${participants}</div></section>`
					})
					.join("")
				rows.querySelectorAll("[data-check-in]").forEach((button) => {
					button.addEventListener("click", () => {
						void checkInBooking(String(button.getAttribute("data-check-in") || ""), button)
					})
				})
				rows.querySelectorAll("[data-no-show]").forEach((button) => {
					button.addEventListener("click", () => {
						void markNoShow(String(button.getAttribute("data-no-show") || ""), button)
					})
				})
			}

			const loadQueue = async () => {
				if (retry) retry.hidden = true
				if (summary) summary.textContent = "Cargando salidas..."
				try {
					const today = todayIso()
					const qs = new URLSearchParams({
						departureDate: today,
						scope: "tour",
						status: "confirmed",
						limit: "100",
					})
					if (productId) qs.set("productId", productId)
					if (requestedVariantId) qs.set("variantId", requestedVariantId)
					const collected = []
					let offset = 0
					let hasMore = true
					while (hasMore) {
						qs.set("offset", String(offset))
						const response = await fetch(`/api/internal/provider-bookings-summary?${qs}`, {
							headers: { accept: "application/json" },
						})
						if (!response.ok) throw new Error("queue_failed")
						const payload = await response.json()
						const page = Array.isArray(payload.items) ? payload.items : []
						collected.push(...page)
						hasMore = Boolean(payload.pagination?.hasMore)
						if (hasMore && !page.length) throw new Error("empty_page")
						offset += 100
					}
					const items = collected
						.filter((item) => String(item?.vertical || "").toLowerCase() === "tour")
						.filter((item) => String(item?.checkIn || "") === today)
						.sort((a, b) =>
							String(a?.departureTime || "99:99").localeCompare(String(b?.departureTime || "99:99"))
						)
					renderMetrics(items)
					renderRows(items)
					if (summary) {
						summary.textContent =
							items.length === 0
								? "0 reservas confirmadas"
								: `${new Set(items.map((item) => item.variantId)).size} salidas · ${items.length} reservas confirmadas.`
					}
				} catch {
					if (summary) summary.textContent = "No se pudieron cargar las reservas de hoy."
					if (rows)
						rows.innerHTML =
							'<p class="p-6 text-sm text-slate-600" role="alert">Vuelve a intentar para consultar la jornada actual.</p>'
					if (metrics) metrics.innerHTML = ""
					if (retry) retry.hidden = false
				}
			}

			retry?.addEventListener("click", () => void loadQueue())
			void loadQueue()
		})()
	</script>
</WorkspaceLayout>
