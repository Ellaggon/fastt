---
import { experienceJourneyPresentation } from "@/lib/tours/experienceFormatPresentation"
import { experienceProgramMinimum } from "@/shared/domain/experience-format"
import PlaybookStepHeader from "@/components/playbook/PlaybookStepHeader.astro"
import TourSubtypePlaybookFields from "@/components/tours/TourSubtypePlaybookFields.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Textarea from "@/components/ui/Textarea.astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import {
	buildCompleteToPublishHref,
	getCompleteToPublishPlaybookRepairHref,
} from "@/lib/playbook/complete-to-publish"
import { buildPlaybookHref } from "@/lib/playbook/launch-accommodation"
import { resolvePlaybookFromUrl } from "@/lib/playbook/resolve-playbook"
import { playbookRedirectHrefFor } from "@/lib/playbook/playbook-nav"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { getProductVerticalDefinition } from "@/lib/catalog/productVerticalRegistry"
import { routes } from "@/lib/routes"
import { getProductById } from "@/modules/catalog/public"
import { first, db, eq, Hotel, Limousine, Package, Tour } from "@/shared/infrastructure/db/compat"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
if (!productId) return Astro.redirect("/product/create")
const flow = Astro.url.searchParams.get("flow")
if (!resolvePlaybookFromUrl(Astro.url).active && flow === "create") {
	return Astro.redirect(buildPlaybookHref(`/product/${productId}/subtype`, "subtype"))
}
if (!resolvePlaybookFromUrl(Astro.url).active && flow === "complete") {
	return Astro.redirect(buildCompleteToPublishHref(`/product/${productId}/subtype`, "subtype"))
}

const product = await getProductById(productId)
if (!product) return Astro.redirect("/product/create")

const pt = String(product.productType || "")
	.trim()
	.toLowerCase()
const isHotel = pt === "hotel"
const isTour = pt === "tour"
const playbookRepair = getCompleteToPublishPlaybookRepairHref(Astro.url, { isTour, productId })
if (playbookRepair) return Astro.redirect(playbookRepair)
const playbook = resolvePlaybookFromUrl(Astro.url, { isHotel })
const vertical = getProductVerticalDefinition(product.productType)
const verticalLabel = vertical?.labels.singular.toLowerCase() ?? "oferta"
const detailTitle = vertical?.labels.detailTitle ?? "Detalles de la oferta"
let subtypeHeading = pt === "hotel" ? "Detalles del alojamiento" : `Detalles del ${verticalLabel}`
const tourPlaybookGuided = pt === "tour" && playbook.active
const workspacePlural = vertical?.labels.workspacePlural ?? "Ofertas"

function listToText(value: unknown, key = "description") {
	if (!Array.isArray(value)) return ""
	return value
		.map((item) => {
			if (typeof item === "string") return item
			if (item && typeof item === "object") return String((item as any)[key] ?? "").trim()
			return ""
		})
		.filter(Boolean)
		.join("\n")
}

function fieldFromObject(value: unknown, key: string) {
	if (!value || typeof value !== "object") return ""
	return String((value as any)[key] ?? "")
}

const hotelSubtype =
	pt === "hotel"
		? await db
				.select({
					stars: Hotel.stars,
					phone: Hotel.phone,
					email: Hotel.email,
					website: Hotel.website,
				})
				.from(Hotel)
				.where(eq(Hotel.productId, productId))
				.then(first)
		: null

const tourSubtype =
	pt === "tour"
		? await db
				.select({
					experienceFormat: Tour.experienceFormat,
					duration: Tour.duration,
					durationMinutes: Tour.durationMinutes,
					difficultyLevel: Tour.difficultyLevel,
					meetingPointJson: Tour.meetingPointJson,
					itineraryJson: Tour.itineraryJson,
					safetyJson: Tour.safetyJson,
					guideJson: Tour.guideJson,
					includesJson: Tour.includesJson,
					excludesJson: Tour.excludesJson,
					pickupJson: Tour.pickupJson,
				})
				.from(Tour)
				.where(eq(Tour.productId, productId))
				.then(first)
		: null

const packageSubtype =
	pt === "package"
		? await db
				.select({
					days: Package.days,
					nights: Package.nights,
					itineraryJson: Package.itineraryJson,
					includesJson: Package.includesJson,
					excludesJson: Package.excludesJson,
				})
				.from(Package)
				.where(eq(Package.productId, productId))
				.then(first)
		: null

const limousineSubtype =
	pt === "limousine"
		? await db
				.select({
					vehicleProfileJson: Limousine.vehicleProfileJson,
					pickupJson: Limousine.pickupJson,
					dropoffJson: Limousine.dropoffJson,
					passengerCapacity: Limousine.passengerCapacity,
					luggageCapacity: Limousine.luggageCapacity,
				})
				.from(Limousine)
				.where(eq(Limousine.productId, productId))
				.then(first)
		: null
const journey = experienceJourneyPresentation(tourSubtype?.experienceFormat)
const programMinimum = experienceProgramMinimum(tourSubtype?.experienceFormat)
if (isTour) subtypeHeading = journey.logisticsLabel
---

<PlaybookLayout
	title={`${workspacePlural} · ${detailTitle}`}
	playbookId={playbook.playbookId}
	active={playbook.active}
	stepId={playbook.stepId ?? "subtype"}
	productId={productId}
	isHotel={isHotel}
	playbookVertical={pt}
	continueFormId={playbook.active ? "subtypeForm" : null}
>
	<section class:list={[tourPlaybookGuided ? "space-y-6" : "space-y-8"]}>
		<section
			id="tour-meeting-point"
			class:list={[
				"scroll-mt-24",
				tourPlaybookGuided ? "space-y-6" : "space-y-4",
				playbook.active && !tourPlaybookGuided && "space-y-6",
			]}
		>
			{
				tourPlaybookGuided ? (
					<PlaybookStepHeader
						icon="itinerary"
						title={journey.logisticsLabel}
						lead="Indica duración, lugar de inicio, programa e inclusiones visibles para el viajero."
					/>
				) : playbook.active ? (
					<PlaybookStepHeader
						icon="building"
						title={subtypeHeading}
						lead="Completa los campos propios de este tipo de oferta."
					/>
				) : null
			}
			{
				tourPlaybookGuided ? (
					<form
						id="subtypeForm"
						method="POST"
						action="/api/product/subtype"
						class="w-full max-w-5xl space-y-5"
						data-is-hotel="false"
						data-is-tour="true"
						data-program-minimum={programMinimum}
						data-playbook-guided="true"
						novalidate
					>
						<Input type="hidden" name="productId" value={productId} />
						{["variantId", "ratePlanId", "returnTo", "tourFlowVersion"].map((name) =>
							Astro.url.searchParams.has(name) ? (
								<Input type="hidden" name={name} value={Astro.url.searchParams.get(name) ?? ""} />
							) : null
						)}
						<Input
							type="hidden"
							name="flow"
							value={flow === "create" ? "create" : flow === "complete" ? "complete" : "edit"}
						/>
						{playbook.playbookId ? (
							<Input type="hidden" name="playbook" value={playbook.playbookId} />
						) : null}
						{playbook.playbookId === "complete-to-publish" ? (
							<>
								<Input type="hidden" name="playbookCurrentStep" value="subtype" />
								<Input type="hidden" name="playbookVertical" value={pt} />
							</>
						) : null}
						<TourSubtypePlaybookFields productId={productId} tourSubtype={tourSubtype} />
						<p id="stateLabel" class="text-sm text-slate-400" role="status" aria-live="polite" />
						<p id="stateDetail" class="hidden text-sm whitespace-pre-wrap text-slate-400" />
						<a
							id="stateRecovery"
							class="hidden text-sm font-semibold text-sky-700 underline underline-offset-2"
							href="#"
						>
							Volver al formulario
						</a>
					</form>
				) : (
					<Card
						class:list={[
							playbook.active ? "bg-white" : "rounded-lg border-slate-200 bg-slate-100 shadow-none",
						]}
					>
						<form
							id="subtypeForm"
							method="POST"
							action="/api/product/subtype"
							class="max-w-3xl space-y-6"
							data-is-hotel={isHotel ? "true" : "false"}
							data-is-tour={pt === "tour" ? "true" : "false"}
							data-program-minimum={programMinimum}
							data-playbook-guided="false"
							novalidate={pt === "tour"}
						>
							<Input type="hidden" name="productId" value={productId} />
							{["variantId", "ratePlanId", "returnTo", "tourFlowVersion"].map((name) =>
								Astro.url.searchParams.has(name) ? (
									<Input type="hidden" name={name} value={Astro.url.searchParams.get(name) ?? ""} />
								) : null
							)}
							<Input
								type="hidden"
								name="flow"
								value={flow === "create" ? "create" : flow === "complete" ? "complete" : "edit"}
							/>
							{playbook.active && playbook.playbookId ? (
								<Input type="hidden" name="playbook" value={playbook.playbookId} />
							) : null}
							{playbook.active && playbook.playbookId === "complete-to-publish" ? (
								<>
									<Input type="hidden" name="playbookCurrentStep" value="subtype" />
									<Input type="hidden" name="playbookVertical" value={pt} />
								</>
							) : null}
							{!playbook.active ? (
								<header class="space-y-1.5">
									<h2 class="text-xl font-semibold text-slate-900">{subtypeHeading}</h2>
									<p class="text-sm leading-6 text-slate-600">
										Completa los campos propios de este tipo de oferta.
									</p>
								</header>
							) : null}

							<div class="space-y-4">
								{pt === "hotel" ? (
									<div class="space-y-4">
										<FormField label="Estrellas" htmlFor="stars">
											<Input
												id="stars"
												name="stars"
												value={hotelSubtype?.stars != null ? String(hotelSubtype.stars) : ""}
												placeholder="1-5"
											/>
										</FormField>
										<FormField label="Teléfono" htmlFor="phone">
											<Input
												id="phone"
												name="phone"
												value={hotelSubtype?.phone ?? ""}
												placeholder="Opcional"
											/>
										</FormField>
										<FormField label="Correo" htmlFor="email">
											<Input
												id="email"
												name="email"
												value={hotelSubtype?.email ?? ""}
												placeholder="Opcional"
											/>
										</FormField>
										<FormField label="Sitio web" htmlFor="website">
											<Input
												id="website"
												name="website"
												value={hotelSubtype?.website ?? ""}
												placeholder="Opcional"
											/>
										</FormField>
									</div>
								) : null}

								{pt === "tour" ? (
									<TourSubtypePlaybookFields productId={productId} tourSubtype={tourSubtype} />
								) : null}

								{pt === "package" ? (
									<div class="space-y-4">
										<FormField label="Itinerario" htmlFor="itinerary">
											<Textarea
												id="itinerary"
												name="itinerary"
												value={listToText(packageSubtype?.itineraryJson)}
												rows="5"
												placeholder="Un día o etapa por línea"
											/>
										</FormField>
										<FormField label="Días" htmlFor="days">
											<Input
												id="days"
												name="days"
												value={packageSubtype?.days != null ? String(packageSubtype.days) : ""}
												placeholder="0 o más"
											/>
										</FormField>
										<FormField label="Noches" htmlFor="nights">
											<Input
												id="nights"
												name="nights"
												value={packageSubtype?.nights != null ? String(packageSubtype.nights) : ""}
												placeholder="0 o más"
											/>
										</FormField>
										<FormField label="Incluye" htmlFor="includes">
											<Textarea
												id="includes"
												name="includes"
												value={listToText(packageSubtype?.includesJson, "")}
												rows="4"
												placeholder="Una inclusión por línea"
											/>
										</FormField>
										<FormField label="No incluye" htmlFor="excludes">
											<Textarea
												id="excludes"
												name="excludes"
												value={listToText(packageSubtype?.excludesJson, "")}
												rows="4"
												placeholder="Una exclusión por línea"
											/>
										</FormField>
									</div>
								) : null}

								{pt === "limousine" ? (
									<div class="space-y-4">
										<FormField label="Marca" htmlFor="vehicleMake">
											<Input
												id="vehicleMake"
												name="vehicleMake"
												value={fieldFromObject(limousineSubtype?.vehicleProfileJson, "make")}
												placeholder="Mercedes-Benz"
											/>
										</FormField>
										<FormField label="Modelo" htmlFor="vehicleModel">
											<Input
												id="vehicleModel"
												name="vehicleModel"
												value={fieldFromObject(limousineSubtype?.vehicleProfileJson, "model")}
												placeholder="Clase S"
											/>
										</FormField>
										<FormField label="Clase de vehículo" htmlFor="vehicleClass">
											<Input
												id="vehicleClass"
												name="vehicleClass"
												value={fieldFromObject(limousineSubtype?.vehicleProfileJson, "class")}
												placeholder="Ejecutivo, lujo, van premium"
											/>
										</FormField>
										<FormField label="Color" htmlFor="vehicleColor">
											<Input
												id="vehicleColor"
												name="vehicleColor"
												value={fieldFromObject(limousineSubtype?.vehicleProfileJson, "color")}
												placeholder="Negro"
											/>
										</FormField>
										<div class="grid gap-4 md:grid-cols-2">
											<FormField label="Capacidad de pasajeros" htmlFor="passengerCapacity">
												<Input
													id="passengerCapacity"
													name="passengerCapacity"
													value={
														limousineSubtype?.passengerCapacity != null
															? String(limousineSubtype.passengerCapacity)
															: ""
													}
													placeholder="3"
												/>
											</FormField>
											<FormField label="Capacidad de equipaje" htmlFor="luggageCapacity">
												<Input
													id="luggageCapacity"
													name="luggageCapacity"
													value={
														limousineSubtype?.luggageCapacity != null
															? String(limousineSubtype.luggageCapacity)
															: ""
													}
													placeholder="2"
												/>
											</FormField>
										</div>
										<FormField label="Área base de recogida" htmlFor="pickupDefaultArea">
											<Input
												id="pickupDefaultArea"
												name="pickupDefaultArea"
												value={fieldFromObject(limousineSubtype?.pickupJson, "defaultArea")}
												placeholder="Aeropuerto, zona hotelera..."
											/>
										</FormField>
										<FormField label="Instrucciones de recogida" htmlFor="pickupInstructions">
											<Textarea
												id="pickupInstructions"
												name="pickupInstructions"
												value={fieldFromObject(limousineSubtype?.pickupJson, "instructions")}
												rows="3"
											/>
										</FormField>
										<FormField label="Área base de destino" htmlFor="dropoffDefaultArea">
											<Input
												id="dropoffDefaultArea"
												name="dropoffDefaultArea"
												value={fieldFromObject(limousineSubtype?.dropoffJson, "defaultArea")}
												placeholder="Centro, terminal, hotel..."
											/>
										</FormField>
										<FormField label="Instrucciones de dropoff" htmlFor="dropoffInstructions">
											<Textarea
												id="dropoffInstructions"
												name="dropoffInstructions"
												value={fieldFromObject(limousineSubtype?.dropoffJson, "instructions")}
												rows="3"
											/>
										</FormField>
									</div>
								) : null}
							</div>

							<div class="space-y-1">
								<p id="stateLabel" class="text-sm text-slate-600" aria-live="polite">
									Vacío: sin cambios guardados.
								</p>
								<p id="stateDetail" class="hidden text-sm whitespace-pre-wrap text-slate-600" />
								<a
									id="stateRecovery"
									class="hidden text-sm font-medium text-sky-600 underline underline-offset-4"
								/>
							</div>

							<div
								class:list={[
									"flex items-center justify-end gap-3",
									playbook.active ? "hidden" : "",
								]}
							>
								<Button
									href={
										playbook.active && playbook.playbookId
											? playbookRedirectHrefFor(
													playbook.playbookId,
													playbook.playbookId === "complete-to-publish"
														? `/product/${productId}/location`
														: `/product/${productId}/images`,
													playbook.playbookId === "complete-to-publish" ? "location" : "images"
												)
											: `/product/${encodeURIComponent(productId)}/images`
									}
									variant="secondary"
								>
									Volver
								</Button>
								<Button
									id="submitBtn"
									type="submit"
									variant="selection"
									className="fastt-playbook-cta"
								>
									{isTour && playbook.playbookId === "complete-to-publish"
										? "Guardar y volver"
										: playbook.active
											? "Guardar y continuar"
											: "Guardar subtipo"}
								</Button>
							</div>
						</form>
					</Card>
				)
			}
		</section>
	</section>

	<script>
		// @ts-nocheck
		import {
			isCompleteToPublishPlaybookMode,
			isPlaybookMode,
			playbookRedirectHref,
			readPlaybookNavIntent,
			resolvePlaybookRedirectAfterSave,
		} from "@/lib/playbook/playbook-nav.ts"
		import { experienceProgramLines } from "@/shared/domain/experience-format"
		import { bindPlaybookFormDraft } from "@/lib/forms/playbookFormDraft.ts"
		import { setPlaybookSubmitBusy } from "@/lib/forms/playbookFormBusy.ts"

		function initSubtypeForm() {
			const form = document.getElementById("subtypeForm")
			if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") return
			form.dataset.bound = "true"
			const stateLabel = document.getElementById("stateLabel")
			const stateDetail = document.getElementById("stateDetail")
			const recovery = document.getElementById("stateRecovery")
			const isHotel = form instanceof HTMLElement && form.dataset.isHotel === "true"
			const isTour = form instanceof HTMLElement && form.dataset.isTour === "true"
			const playbookGuided = form.dataset.playbookGuided === "true"
			const programMinimum = Number(form.dataset.programMinimum) || 3
			const draft = bindPlaybookFormDraft(form instanceof HTMLFormElement ? form : null, {
				key: `product:${window.location.pathname}:subtype`,
			})

			function setState(state, detail = "") {
				const labels = {
					empty: playbookGuided ? "" : "Vacío: sin cambios guardados.",
					loading: "Guardando cambios…",
					success: "Cambios guardados.",
					error: "No pudimos guardar. Conservamos tus datos.",
				}
				stateLabel.textContent = labels[state] || labels.empty
				stateDetail.textContent = detail
				stateDetail.classList.toggle("hidden", !detail)
				recovery?.classList.add("hidden")
			}

			const tourFieldErrors = {
				duration: "durationError",
				durationMinutes: "durationMinutesError",
				meetingPointJson: "meetingPointAddressError",
				itineraryJson: "tourItineraryError",
				includesJson: "tourIncludesError",
			}

			function setFieldError(fieldId, errorId, message) {
				const field = document.getElementById(fieldId)
				const error = document.getElementById(errorId)
				if (field) field.setAttribute("aria-invalid", message ? "true" : "false")
				if (!error) return
				error.textContent = message
				error.classList.toggle("hidden", !message)
			}

			function validateTourForm() {
				if (!isTour) return true
				const values = {
					duration: String(document.getElementById("duration")?.value || "").trim(),
					durationMinutes: Number(document.getElementById("durationMinutes")?.value || 0),
					meetingPointAddress: String(
						document.getElementById("meetingPointAddress")?.value || ""
					).trim(),
					itinerary: experienceProgramLines(document.getElementById("tourItinerary")?.value),
					includes: String(document.getElementById("tourIncludes")?.value || "")
						.split(/\r?\n|,/)
						.map((value) => value.trim())
						.filter(Boolean),
				}
				const errors = {
					duration: values.duration ? "" : "Indica la duración de la experiencia.",
					durationMinutes:
						Number.isInteger(values.durationMinutes) && values.durationMinutes > 0
							? ""
							: "Indica una duración en minutos mayor que cero.",
					meetingPointAddress: values.meetingPointAddress ? "" : "Indica el punto de encuentro.",
					itinerary:
						values.itinerary.length >= programMinimum
							? ""
							: `Agrega al menos ${programMinimum} ${programMinimum === 1 ? "momento" : "momentos"}, uno por línea.`,
					includes: values.includes.length ? "" : "Agrega al menos una inclusión.",
				}
				setFieldError("duration", "durationError", errors.duration)
				setFieldError("durationMinutes", "durationMinutesError", errors.durationMinutes)
				setFieldError("meetingPointAddress", "meetingPointAddressError", errors.meetingPointAddress)
				setFieldError("tourItinerary", "tourItineraryError", errors.itinerary)
				setFieldError("tourIncludes", "tourIncludesError", errors.includes)
				const firstInvalid = Object.entries(errors).find(([, message]) => Boolean(message))?.[0]
				const fieldIds = {
					duration: "duration",
					durationMinutes: "durationMinutes",
					meetingPointAddress: "meetingPointAddress",
					itinerary: "tourItinerary",
					includes: "tourIncludes",
				}
				if (firstInvalid) {
					document.getElementById(fieldIds[firstInvalid])?.focus()
					setState("error", "Revisa los campos marcados.")
					return false
				}
				return true
			}

			function showServerFieldErrors(text) {
				if (!isTour) return
				try {
					const payload = JSON.parse(text)
					const errors = payload?.error?.fieldErrors
					if (!errors || typeof errors !== "object") return
					let firstInvalid = null
					for (const [field, errorId] of Object.entries(tourFieldErrors)) {
						const messages = errors[field]
						if (!Array.isArray(messages) || !messages.length) continue
						const fieldId =
							field === "meetingPointJson"
								? "meetingPointAddress"
								: field === "itineraryJson"
									? "tourItinerary"
									: field === "includesJson"
										? "tourIncludes"
										: field
						setFieldError(fieldId, errorId, String(messages[0]))
						firstInvalid ??= fieldId
					}
					document.getElementById(firstInvalid)?.focus()
				} catch {
					// The status message still exposes non-validation server errors.
				}
			}

			form?.addEventListener("submit", async (e) => {
				e.preventDefault()
				const fd = new FormData(form)
				const intent = readPlaybookNavIntent(fd, e.submitter)
				const id = String(fd.get("productId") || "")
				if (!validateTourForm()) return
				setState("loading")
				setPlaybookSubmitBusy(form, true)

				try {
					const res = await fetch("/api/product/subtype", { method: "POST", body: fd })
					const txt = await res.text()
					if (!res.ok) {
						setPlaybookSubmitBusy(form, false)
						showServerFieldErrors(txt)
						let message = "Revisa los campos señalados o vuelve a intentarlo."
						try {
							const body = JSON.parse(txt)
							if (typeof body.error === "string") message = body.error
						} catch {}
						if (res.status === 401)
							message = "Tu sesión venció. Inicia sesión para guardar; conservamos tus datos."
						if (res.status === 403) message = "No tienes permiso para guardar esta experiencia."
						setState("error", message)
						if (recovery && [401, 409].includes(res.status)) {
							const returnTo = window.location.pathname + window.location.search
							recovery.href =
								res.status === 401 ? `/SignInPage?${new URLSearchParams({ returnTo })}` : returnTo
							recovery.textContent = res.status === 401 ? "Iniciar sesión" : "Recargar formulario"
							recovery.classList.remove("hidden")
						}
						return
					}
					setState("success", "Guardado correctamente")
					draft.clear()
					if (
						isTour ||
						intent === "exit" ||
						!isPlaybookMode(fd) ||
						isCompleteToPublishPlaybookMode(fd)
					) {
						window.location.href = resolvePlaybookRedirectAfterSave(fd, {
							productId: id,
							currentStep: "subtype",
							launchPath: `/product/${encodeURIComponent(id)}/location`,
							launchStep: "location",
							intent: !isPlaybookMode(fd) ? "exit" : intent,
							submitter: e.submitter,
						})
						return
					}
					if (isHotel) {
						window.location.href = playbookRedirectHref(
							`/product/${encodeURIComponent(id)}/rooms/new`,
							"room-profile"
						)
						return
					}
					window.location.href = playbookRedirectHref(
						`/product/${encodeURIComponent(id)}/preview`,
						"preview"
					)
				} catch (err) {
					setPlaybookSubmitBusy(form, false)
					setState("error", "No pudimos conectar. Vuelve a intentarlo; conservamos tus datos.")
				}
			})
		}
		initSubtypeForm()
		document.addEventListener("astro:page-load", initSubtypeForm)
	</script>
</PlaybookLayout>
