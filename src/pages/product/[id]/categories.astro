---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Checkbox from "@/components/ui/Checkbox.astro"
import Notice from "@/components/ui/Notice.astro"
import { productRepository } from "@/container"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { isTourProductType } from "@/lib/catalog/productVerticalRegistry"
import {
	buildCompleteToPublishHref,
	COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
} from "@/lib/playbook/complete-to-publish"
import { buildTourPlaybookHref } from "@/lib/playbook/launch-tour"
import { resolvePlaybookFromUrl } from "@/lib/playbook/resolve-playbook"
import { routes } from "@/lib/routes"
import { tourActivityQualityCriteria } from "@/lib/tours/tourActivityQuality"
import { publicTourCategories } from "@/lib/tours/tourDiscoveryFilters"
import {
	and,
	asc,
	db,
	eq,
	ProductCategory,
	ProductCategoryLink,
} from "@/shared/infrastructure/db/compat"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")
const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
const owned = productId
	? await productRepository.ensureProductOwnedByProvider(productId, providerId)
	: null
if (!owned || !isTourProductType(owned.productType)) return Astro.redirect(routes.catalogTours())

const playbook = resolvePlaybookFromUrl(Astro.url)
const isCompletePlaybook = playbook.playbookId === COMPLETE_TO_PUBLISH_PLAYBOOK_ID
const departurePath = `/product/${encodeURIComponent(productId)}/departures/new`
const continueHref = isCompletePlaybook
	? buildCompleteToPublishHref(departurePath, "departure")
	: buildTourPlaybookHref(departurePath, "departure")

const [categoryRows, linkRows] = await Promise.all([
	db
		.select({ id: ProductCategory.id, slug: ProductCategory.slug, name: ProductCategory.name })
		.from(ProductCategory)
		.where(
			and(
				eq(ProductCategory.vertical, "tour"),
				eq(ProductCategory.isActive, true),
				eq(ProductCategory.dataClass, "production")
			)
		)
		.orderBy(asc(ProductCategory.sortOrder), asc(ProductCategory.name)),
	db
		.select({ categoryId: ProductCategoryLink.categoryId })
		.from(ProductCategoryLink)
		.where(eq(ProductCategoryLink.productId, productId)),
])
const categories = publicTourCategories(
	categoryRows.map((category) => ({
		id: String(category.id),
		slug: String(category.slug ?? ""),
		name: String(category.name ?? category.slug ?? ""),
	}))
)
const linked = new Set(linkRows.map((row) => String(row.categoryId)))
const selectedCategories = categories.filter((category) => linked.has(String(category.id)))
const qualityCriteria = tourActivityQualityCriteria(selectedCategories)
---

<PlaybookLayout
	title={`${owned.name} · Categorías de búsqueda`}
	playbookId={playbook.playbookId}
	active={playbook.active}
	stepId={playbook.stepId ?? "categories"}
	productId={productId}
	isHotel={false}
	continueFormId={playbook.active ? "categoriesPlaybookForm" : null}
>
	<section class="space-y-6">
		<header class="space-y-1.5">
			<p class="text-sm font-medium text-slate-400">Descubrimiento</p>
			<h1 class="text-2xl font-semibold text-white sm:text-3xl">Categorías de búsqueda</h1>
			<p class="max-w-2xl text-sm leading-6 text-slate-300">
				Estas categorías describen la actividad y ayudan a encontrarla. No representan tipos de
				participante, precios ni cupos.
			</p>
		</header>

		<Card class="space-y-5 bg-white">
			<form id="categoriesPlaybookForm" class="space-y-5">
				<fieldset class="space-y-4">
					<legend class="text-sm font-semibold text-slate-950">¿Qué tipo de experiencia es?</legend>
					<p class="text-sm leading-6 text-slate-600">
						Elige solo categorías que un viajero usaría para buscar este tour.
					</p>
					<div class="flex flex-wrap gap-2">
						{
							categories.map((category) => (
								<Checkbox
									name="categoryId"
									value={category.id}
									checked={linked.has(String(category.id))}
									className="fastt-soft-box rounded border border-slate-200 px-3 py-2 text-sm"
								>
									{category.name}
								</Checkbox>
							))
						}
					</div>
				</fieldset>
				<Notice
					id="categoriesRequirement"
					variant="warning"
					title="Selecciona una categoría"
					class="hidden"
				>
					El tour necesita al menos una categoría pública para aparecer en búsquedas relevantes.
				</Notice>
				{
					!playbook.active ? (
						<div class="flex flex-wrap items-center gap-3">
							<Button type="submit">Guardar categorías</Button>
							<Button href={routes.productDetail(productId)} variant="secondary">
								Volver a la ficha
							</Button>
						</div>
					) : null
				}
				<p id="categoriesStatus" class="text-sm text-slate-600" aria-live="polite"></p>
			</form>
		</Card>

		<Card class="space-y-3 bg-white">
			<h2 class="text-sm font-semibold text-slate-950">Criterios de calidad para esta actividad</h2>
			<p class="text-sm leading-6 text-slate-600">
				Las recomendaciones cambian según las categorías elegidas; no se aplican criterios de
				alojamiento a una experiencia.
			</p>
			<ul class="grid gap-3 md:grid-cols-2">
				{
					qualityCriteria.map((criterion) => (
						<li>
							<Card class="space-y-1 bg-slate-50 p-3">
								<p class="text-sm font-semibold text-slate-900">{criterion.label}</p>
								<p class="text-xs leading-5 text-slate-600">{criterion.detail}</p>
							</Card>
						</li>
					))
				}
			</ul>
		</Card>
	</section>

	<script is:inline define:vars={{ productId, continueHref, playbookActive: playbook.active }}>
		;(function () {
			const form = document.getElementById("categoriesPlaybookForm")
			if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") return
			form.dataset.bound = "true"
			const status = document.getElementById("categoriesStatus")
			const requirement = document.getElementById("categoriesRequirement")
			form.addEventListener("submit", async (event) => {
				event.preventDefault()
				const submitter = event.submitter
				if (
					submitter instanceof HTMLButtonElement &&
					submitter.name === "playbookNav" &&
					submitter.value === "exit"
				) {
					window.location.href = `/product/${encodeURIComponent(productId)}`
					return
				}
				const ids = Array.from(form.querySelectorAll('input[name="categoryId"]:checked')).map(
					(input) => input.value
				)
				if (!ids.length) {
					requirement?.classList.remove("hidden")
					requirement?.scrollIntoView({ behavior: "smooth", block: "nearest" })
					return
				}
				requirement?.classList.add("hidden")
				if (status) status.textContent = "Guardando categorías..."
				const response = await fetch("/api/catalog/product-categories", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ productId, categoryIds: ids }),
				})
				if (!response.ok) {
					if (status) status.textContent = "No se pudieron guardar las categorías."
					return
				}
				if (status) status.textContent = "Categorías guardadas."
				if (playbookActive) window.location.href = continueHref
			})
		})()
	</script>
</PlaybookLayout>
