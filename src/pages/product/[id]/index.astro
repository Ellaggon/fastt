---
import ProductDeleteControls from "@/components/product/ProductDeleteControls.astro"
import ProductLocationPreview from "@/components/product/ProductLocationPreview.astro"
import ProductStayPreparationRow from "@/components/product/ProductStayPreparationRow.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import { productRepository } from "@/container"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderSessionSurfaceFromRequest } from "@/lib/auth/providerSessionSurface"
import { getProductVerticalEntry } from "@/lib/catalog/productVerticalRegistry"
import { logRoutePerformance } from "@/lib/observability/performanceLog"
import { createServerTimingRecorder } from "@/lib/observability/serverTiming"
import { buildCompleteToPublishEntryHref } from "@/lib/playbook/complete-to-publish"
import {
	resolveProductPreparationCoach,
	resolveProductPreparationHeaderSummary,
	resolveProductPreparationHeaderTitle,
} from "@/lib/playbook/product-preparation-coach"
import { summarizeProductPreparation } from "@/lib/playbook/summarize-product-preparation"
import { getProductOperationalSurface } from "@/lib/product/productOperationalSurface"
import { routes } from "@/lib/routes"
import {
	ArrowRight,
	BedDouble,
	CalendarDays,
	CircleCheck,
	ClipboardList,
	Eye,
	FileText,
	Images,
	Map,
	Package,
	Tags,
} from "@lucide/astro"

const startedAt = performance.now()
const timing = createServerTimingRecorder()

const providerSession = await timing.time("authProvider", () =>
	getProviderSessionSurfaceFromRequest(Astro.request)
)
if (!providerSession) return Astro.redirect("/SignInPage")
const user = { id: providerSession.userId }
const providerId = providerSession.providerId

const productId = String(Astro.params.id ?? "")
if (!productId) return Astro.redirect("/product/create")

const owned = await timing.time("productAggregate", () =>
	productRepository.ensureProductOwnedByProvider(productId, providerId)
)
if (!owned) return Astro.redirect("/product/create")

const vertical = getProductVerticalEntry(owned.productType)
const isHotel = vertical.vertical === "hotel"
const isTour = vertical.vertical === "tour"
const isPackage = vertical.vertical === "package"
const publicDetailHref = vertical.routes.publicDetailHref(productId)
const publicationSuccess = Astro.url.searchParams.get("published") === "1"
const detailTitle =
	vertical.vertical === "hotel"
		? "Ficha del alojamiento"
		: vertical.vertical === "tour"
			? "Ficha del tour"
			: vertical.vertical === "package"
				? "Ficha del paquete"
				: `Ficha de ${vertical.labels.singular}`
const productHeaderSummary =
	vertical.vertical === "hotel"
		? "Administra la información pública, habitaciones y reglas de este alojamiento. Las tarifas y el calendario se gestionan desde Venta."
		: vertical.contextLine

const operationalSurface = await timing.time("productOperationalSurface", () =>
	getProductOperationalSurface({
		productId,
		providerId,
		request: Astro.request,
		url: Astro.url,
	})
)
const status = String(operationalSurface?.status || "draft")
	.trim()
	.toLowerCase()

const readiness = operationalSurface?.readiness ?? null
const canonicalPreparation =
	status !== "published"
		? await timing.time("canonicalPreparation", () =>
				summarizeProductPreparation({
					productId,
					providerId,
					status,
					request: Astro.request,
					url: Astro.url,
				})
			)
		: null
const preparation = canonicalPreparation ?? readiness
const publishState =
	status !== "published" && preparation
		? {
				readyToPublish: preparation.readyToPublish,
				readinessPercent: preparation.readinessPercent,
				completedChecks: preparation.completedChecks ?? 0,
				totalChecks: preparation.totalChecks ?? 0,
			}
		: null
const completePreparationHref =
	preparation?.continuePreparationHref ?? buildCompleteToPublishEntryHref(productId)
const previewHref = preparation?.previewHref ?? routes.productPreview(productId)
const preparationCoach = publishState
	? resolveProductPreparationCoach({
			readyToPublish: publishState.readyToPublish,
			readinessPercent: publishState.readinessPercent,
			nextStepLabel: preparation?.nextStepLabel,
			nextStepBody: preparation?.nextStepBody,
			nextStepCta: preparation?.nextStepCta,
			continuePreparationHref: completePreparationHref,
			previewHref,
		})
	: null
const PreparationEyebrowIcon = isHotel
	? BedDouble
	: isTour
		? Map
		: isPackage
			? Package
			: ClipboardList
const preparationBlockerCount = preparation?.blockerCount ?? 0
const hasIncompletePreparation = status !== "published" && preparationBlockerCount > 0
const isPublished = status === "published"
const productHeaderTitle = resolveProductPreparationHeaderTitle({
	isPublished,
	readyToPublish: Boolean(publishState?.readyToPublish),
	workspaceSingularLabel: vertical.labels.workspaceSingular,
})
const productHeaderSummaryText = publishState
	? resolveProductPreparationHeaderSummary({
			isPublished,
			readyToPublish: publishState.readyToPublish,
			completedChecks: publishState.completedChecks,
			totalChecks: publishState.totalChecks,
			blockerLabels: preparation?.blockerPreview ?? [],
		})
	: productHeaderSummary
const conditionsHref = isHotel
	? (operationalSurface?.conditionsHref ?? routes.rates())
	: routes.rates()
const productContentHref = `/product/${encodeURIComponent(productId)}/content`
const productImagesHref = `/product/${encodeURIComponent(productId)}/images`
const productLocationHref = `/product/${encodeURIComponent(productId)}/location`
const productSubtypeHref = `/product/${encodeURIComponent(productId)}/subtype`

timing.addTotal("productPage")
timing.setHeader(Astro.response.headers)
logRoutePerformance({
	name: "product-page",
	request: Astro.request,
	url: Astro.url,
	status: 200,
	startedAt,
	timing,
	userId: user.id,
	providerId,
	productId,
})
---

<WorkspaceLayout title={`${detailTitle} · ${owned.name}`}>
	<section class="space-y-6 md:space-y-8">
		<header class="flex items-start justify-between gap-4">
			<div class="min-w-0 space-y-2">
				<h1 class="sr-only">{owned.name}</h1>
				{
					preparationCoach ? null : (
						<>
							<p
								id="productHeaderMeta"
								class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6"
							>
								{productHeaderTitle}
							</p>
							<p
								id="productHeaderSummary"
								class="max-w-3xl text-sm leading-5 text-slate-400 sm:leading-6"
							>
								{productHeaderSummaryText}
							</p>
						</>
					)
				}
			</div>
			<ProductDeleteControls
				productId={productId}
				productName={owned.name}
				workspaceSingularLabel={vertical.labels.workspaceSingular}
				variantsLabel={isTour ? "salidas" : isHotel ? "habitaciones" : "modalidades"}
			/>
		</header>

		{
			publicationSuccess && status === "published" ? (
				<Card class="bg-white">
					<div class="flex flex-wrap items-start justify-between gap-5">
						<div class="flex min-w-0 flex-1 gap-3">
							<div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100">
								<CircleCheck class="h-5 w-5" aria-hidden="true" />
							</div>
							<div class="space-y-1">
								<p class="text-sm font-semibold text-slate-950">
									{vertical.labels.workspaceSingular} publicado
								</p>
								<p class="max-w-2xl text-sm leading-6 text-slate-600">
									Ya está activo para viajeros. Desde aquí puedes seguir gestionando su ficha,
									tarifas y disponibilidad.
								</p>
							</div>
						</div>
						<div class="flex flex-wrap justify-end gap-2">
							<Button href={routes.calendar()} variant="secondary">
								<CalendarDays class="h-4 w-4" aria-hidden="true" />
								Abrir calendario
							</Button>
							{publicDetailHref ? (
								<Button href={publicDetailHref} variant="secondary">
									Ver página pública
								</Button>
							) : null}
						</div>
					</div>
				</Card>
			) : null
		}

		{
			status !== "published" && publishState && preparationCoach ? (
				<section class="space-y-4" data-product-preparation>
					<Card variant="dark" class="!border-neutral-800 !bg-black">
						<div class="space-y-6">
							<div class="flex items-start justify-between gap-4">
								<div class="flex min-w-0 items-start gap-3">
									<span class="fastt-section-icon">
										<PreparationEyebrowIcon class="size-4" aria-hidden="true" />
									</span>
									<div class="min-w-0">
										<p id="productHeaderMeta" class="text-xl font-semibold text-white">
											{productHeaderTitle}
										</p>
										<p
											id="productHeaderSummary"
											class="mt-1 max-w-3xl text-sm leading-6 text-neutral-400"
										>
											{productHeaderSummaryText}
										</p>
									</div>
								</div>
								<Badge
									variant={preparationCoach.ready ? "darkSuccess" : "darkWarning"}
									data-product-prep-badge
									data-product-dark-badge
								>
									{preparationCoach.badge}
								</Badge>
							</div>

							<div class="flex items-center gap-3">
								<div class="h-1 flex-1 overflow-hidden rounded-full bg-white/10">
									<div
										id="productProgressBar"
										class="h-full rounded-full"
										style={`width: ${Math.max(0, Math.min(100, publishState.readinessPercent))}%; background-color: var(--fastt-color-selection);`}
										data-product-progress-bar
									/>
								</div>
								<p
									id="productProgressText"
									class="shrink-0 text-xs font-medium text-neutral-400 tabular-nums"
									data-product-progress-label
								>
									{publishState.completedChecks} de {publishState.totalChecks}
								</p>
							</div>

							<div class="flex flex-col gap-4 border-t border-white/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
								<div class="flex min-w-0 items-start gap-3">
									<span class="fastt-section-icon">
										{preparationCoach.ready ? (
											<CircleCheck class="size-4" aria-hidden="true" />
										) : (
											<ClipboardList class="size-4" aria-hidden="true" />
										)}
									</span>
									<div class="min-w-0">
										<p class="text-xs font-semibold tracking-[0.14em] text-neutral-500 uppercase">
											Siguiente requisito
										</p>
										<p
											id="productMissingStepsText"
											class="mt-1 text-base font-semibold text-white"
											data-product-next-step-label
										>
											{preparationCoach.label}
										</p>
										<p
											class="mt-1 max-w-xl text-sm leading-6 text-neutral-400"
											data-product-next-step-body
										>
											{preparationCoach.body}
										</p>
									</div>
								</div>
								<Button
									href={preparationCoach.href}
									variant="onDark"
									className="shrink-0"
									data-product-primary-cta
								>
									<span data-product-primary-cta-label>{preparationCoach.cta}</span>
									<ArrowRight class="size-4" aria-hidden="true" />
								</Button>
							</div>
						</div>
					</Card>
				</section>
			) : null
		}

		<div
			data-product-summary-config
			data-product-id={productId}
			data-is-hotel={String(isHotel)}
			data-is-tour={String(isTour)}
			data-is-package={String(isPackage)}
			data-singular-label={vertical.labels.singular}
			data-workspace-singular-label={vertical.labels.workspaceSingular}
			data-preview-href={routes.productPreview(productId)}
			hidden
		>
		</div>

		<div data-product-deferred-root class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_20rem]">
			<div class="space-y-5">
				<Card variant="flush" className="fastt-workspace-panel overflow-hidden">
					<div class="grid md:grid-cols-[minmax(0,1.15fr)_minmax(17rem,0.85fr)]">
						<div
							id="productHeroMedia"
							class="flex min-h-[250px] items-center justify-center bg-slate-100 px-6 text-center text-sm font-medium text-slate-500 md:min-h-[310px]"
						>
							<p data-product-hero-empty>Fotos de {vertical.labels.singular}</p>
						</div>
						<div class="flex flex-col justify-between gap-5 p-5 md:p-6">
							<div class="space-y-4">
								<div class="flex items-start justify-between gap-4">
									<div>
										<div class="flex items-center gap-2">
											<Images class="size-4 text-slate-400" aria-hidden="true" />
											<p class="text-sm font-semibold text-slate-950">Fotos principales</p>
										</div>
										<p id="summaryImagesCount" class="mt-1 text-sm text-slate-500">
											Cargando fotos...
										</p>
									</div>
									<Badge id="blockBadge-images" variant="neutral">Cargando...</Badge>
								</div>
								<div
									id="summaryImageGrid"
									class="grid min-h-16 grid-cols-3 gap-2"
									aria-live="polite"
								>
									<div class="animate-pulse rounded-[var(--fastt-radius-control)] bg-slate-100">
									</div>
									<div class="animate-pulse rounded-[var(--fastt-radius-control)] bg-slate-100">
									</div>
									<div class="animate-pulse rounded-[var(--fastt-radius-control)] bg-slate-100">
									</div>
								</div>
							</div>
							<Button href={productImagesHref} variant="ghost" size="sm" className="self-end">
								Gestionar fotos
							</Button>
						</div>
					</div>

					<div class="grid border-t border-slate-200 md:grid-cols-2">
						<section
							class="flex min-h-56 flex-col justify-between gap-5 p-5 md:border-r md:border-slate-200 md:p-6"
						>
							<div>
								<div class="flex items-start justify-between gap-4">
									<div class="flex items-center gap-2">
										<FileText class="size-4 text-slate-400" aria-hidden="true" />
										<p class="text-sm font-semibold text-slate-950">Descripción</p>
									</div>
									<Badge id="blockBadge-content" variant="neutral">Cargando...</Badge>
								</div>
								<p id="summaryDescription" class="mt-3 text-sm leading-6 text-slate-600">
									Cargando descripción...
								</p>
								<p id="summaryHighlights" class="mt-3 text-sm text-slate-500">Destacados: -</p>
							</div>
							<Button href={productContentHref} variant="ghost" size="sm" className="self-end">
								Editar descripción
							</Button>
						</section>

						<section
							class="flex min-h-56 flex-col justify-between gap-5 border-t border-slate-200 p-5 md:border-t-0 md:p-6"
						>
							<div>
								<div class="flex items-start justify-between gap-4">
									<div class="flex items-center gap-2">
										<BedDouble class="size-4 text-slate-400" aria-hidden="true" />
										<p class="text-sm font-semibold text-slate-950">
											{isHotel ? "Tipo y características" : "Detalles de la oferta"}
										</p>
									</div>
									<Badge id="blockBadge-subtype" variant="neutral">Cargando...</Badge>
								</div>
								<p id="summaryProductType" class="mt-3 text-sm leading-6 text-slate-600">
									Cargando detalles...
								</p>
								{
									isTour ? (
										<p id="summaryTourDetails" class="mt-3 text-sm leading-6 text-slate-500">
											Cargando duración y guía...
										</p>
									) : null
								}
								{
									isPackage ? (
										<p id="summaryPackageDuration" class="mt-3 text-sm leading-6 text-slate-500">
											Cargando duración...
										</p>
									) : null
								}
							</div>
							<Button href={productSubtypeHref} variant="ghost" size="sm" className="self-end">
								Editar {isHotel ? "tipo y características" : "detalles"}
							</Button>
						</section>
					</div>

					<section class="border-t border-slate-200">
						<ProductLocationPreview label={`Ubicación de ${owned.name}`} />
						<div
							class="flex flex-col gap-4 bg-white p-5 sm:flex-row sm:items-end sm:justify-between md:p-6"
						>
							<div>
								<div class="flex items-center gap-2">
									<p class="text-sm font-semibold text-slate-950">Ubicación</p>
									<Badge id="blockBadge-location" variant="neutral">Cargando...</Badge>
								</div>
								<p id="summaryAddress" class="mt-2 text-sm leading-6 text-slate-600">
									Cargando dirección...
								</p>
							</div>
							<Button href={productLocationHref} variant="ghost" size="sm">
								Editar ubicación
							</Button>
						</div>
					</section>
				</Card>

				{
					isHotel ? (
						<Card variant="flush" className="overflow-hidden bg-white text-slate-900">
							<header class="border-b border-sky-100 bg-sky-50/80 px-5 py-4 md:px-6">
								<h2 class="text-lg font-semibold text-slate-950">Preparación de la estancia</h2>
								<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
									Revisa lo que verá y aceptará el huésped antes de reservar.
								</p>
							</header>
							<div class="space-y-3 bg-slate-50/90 p-4 sm:p-5 md:p-6">
								<ProductStayPreparationRow
									rowKey="variants"
									badgeId="blockBadge-variants"
									summaryId="summaryRooms"
									label="Habitaciones"
									loadingSummary="Cargando habitaciones..."
									href={routes.productRoomsForProduct(productId)}
									actionLabel="Gestionar habitaciones"
									Icon={BedDouble}
								/>
								<ProductStayPreparationRow
									rowKey="conditions"
									badgeId="blockBadge-conditions"
									summaryId="summaryConditions"
									label="Condiciones de reserva"
									loadingSummary="Cargando condiciones..."
									href={conditionsHref}
									actionLabel="Gestionar condiciones"
									Icon={FileText}
								/>
								<ProductStayPreparationRow
									rowKey="houseRules"
									badgeId="blockBadge-houseRules"
									summaryId="summaryHouseRules"
									label="Reglas para huéspedes"
									loadingSummary="Cargando reglas..."
									href={`${routes.providerHouseRules()}?productId=${encodeURIComponent(productId)}`}
									actionLabel="Editar reglas"
									Icon={ClipboardList}
								/>
							</div>
						</Card>
					) : null
				}
			</div>

			<aside class="space-y-5 xl:sticky xl:top-5 xl:self-start" aria-label="Operación">
				<Card variant="flush" className="fastt-workspace-panel overflow-hidden">
					<div class="p-5 md:p-6">
						<p class="text-sm font-semibold text-slate-950">Operación</p>
						<p class="mt-1 text-sm leading-6 text-slate-500">
							Abre las herramientas diarias sin repetir la información de la ficha.
						</p>
						<div class="mt-5 grid gap-2">
							<Button href={routes.productPreview(productId)} className="w-full justify-start">
								<Eye class="size-4" aria-hidden="true" />
								Vista previa
							</Button>
							{
								isTour ? (
									<Button
										href={routes.productDeparturesForProduct(productId)}
										variant="secondary"
										className="w-full justify-start"
									>
										<CalendarDays class="size-4" aria-hidden="true" />
										Abrir salidas
									</Button>
								) : null
							}
							<Button href={routes.rates()} variant="secondary" className="w-full justify-start">
								<Tags class="size-4" aria-hidden="true" />
								Abrir tarifas
							</Button>
							<Button href={routes.calendar()} variant="secondary" className="w-full justify-start">
								<CalendarDays class="size-4" aria-hidden="true" />
								Abrir calendario
							</Button>
						</div>
					</div>
				</Card>
			</aside>
		</div>
	</section>

	<script>
		import "@/pages/product/_client/product-summary-hydration"
	</script>
</WorkspaceLayout>
