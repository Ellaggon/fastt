---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import { productRepository } from "@/container"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { isTourProductType } from "@/lib/catalog/productVerticalRegistry"
import { routes } from "@/lib/routes"
import {
	buildCompleteToPublishHref,
	COMPLETE_TO_PUBLISH_PLAYBOOK_ID,
} from "@/lib/playbook/complete-to-publish"
import { buildTourPlaybookHref } from "@/lib/playbook/launch-tour"
import { resolvePlaybookFromUrl } from "@/lib/playbook/resolve-playbook"
import { getProductAggregate } from "@/modules/catalog/public"
import { asc, db, eq, TourTicketType } from "@/shared/infrastructure/db/compat"
import { Plus } from "@lucide/astro"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
if (!productId) return Astro.redirect("/product/create")

const owned = await productRepository.ensureProductOwnedByProvider(productId, providerId)
if (!owned) return Astro.redirect("/product/create")
if (!isTourProductType(owned.productType)) return Astro.redirect(routes.productDetail(productId))

const product = await getProductAggregate(productId)
if (!product) return Astro.redirect("/product/create")
const playbook = resolvePlaybookFromUrl(Astro.url)
const isCompletePlaybook = playbook.playbookId === COMPLETE_TO_PUBLISH_PLAYBOOK_ID
const continueHref = isCompletePlaybook
	? buildCompleteToPublishHref(`/product/${encodeURIComponent(productId)}/categories`, "categories")
	: buildTourPlaybookHref(`/product/${encodeURIComponent(productId)}/categories`, "categories")

const tickets = await db
	.select()
	.from(TourTicketType)
	.where(eq(TourTicketType.productId, productId))
	.orderBy(asc(TourTicketType.sortOrder), asc(TourTicketType.code))
const initialTickets = tickets.map((t) => ({
	id: String(t.id),
	code: String(t.code),
	label: String(t.label),
	minAge: t.minAge == null ? null : Number(t.minAge),
	maxAge: t.maxAge == null ? null : Number(t.maxAge),
	sortOrder: Number(t.sortOrder ?? 0),
	isActive: Boolean(t.isActive),
}))
---

<PlaybookLayout
	title={`${product.displayName} · Participantes`}
	playbookId={playbook.playbookId}
	active={playbook.active}
	stepId={playbook.stepId ?? "tickets"}
	productId={productId}
	isHotel={false}
	playbookVertical="tour"
	continueFormId={playbook.active ? "ticketsPlaybookForm" : null}
>
	<section class="space-y-6" data-product-id={productId}>
		<header class="space-y-1.5">
			<h1 class="text-2xl font-semibold text-white sm:text-3xl">Tipos de participante</h1>
			<p class="max-w-2xl text-sm leading-6 text-slate-300">
				Define quién puede reservar y qué edades admite cada tipo. Las categorías que describen la
				actividad se eligen por separado en el siguiente paso.
			</p>
		</header>

		<Card class="space-y-4 bg-white">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h2 class="text-sm font-semibold text-slate-950">Tipos de entrada</h2>
					<p class="mt-1 text-xs text-slate-500">
						Nombre visible, rango de edad, orden y si está activo para reservar.
					</p>
				</div>
				<div class="flex flex-wrap gap-2">
					<Button type="button" id="seed-tickets-btn" variant="secondary" size="sm">
						Plantilla Adulto / Niño / Infante
					</Button>
					<Button type="button" id="add-ticket-btn" variant="secondary" size="sm">
						<span class="inline-flex items-center gap-1">
							<Plus class="h-3.5 w-3.5" />
							Agregar
						</span>
					</Button>
					{
						!playbook.active ? (
							<Button type="button" id="save-tickets-btn" size="sm">
								Guardar entradas
							</Button>
						) : null
					}
				</div>
			</div>

			<div id="ticket-editor-list" class="space-y-3"></div>
			<p id="tickets-status" class="text-sm text-slate-600" aria-live="polite"></p>
		</Card>
		<Card class="space-y-4 bg-white">
			<Notice
				id="tickets-requirements-notice"
				variant="warning"
				title="Completa este paso"
				class="hidden"
			>
				<span id="tickets-requirements-message">
					Agrega y activa al menos un tipo de participante para continuar.
				</span>
			</Notice>
			<p class="text-sm leading-6 text-slate-600">
				Cada participante activo puede seleccionarse en la ficha pública. La clasificación del tour
				en el catálogo no modifica precios, edades ni cupos.
			</p>
		</Card>

		{
			playbook.active ? null : (
				<a href={routes.productDetail(productId)} class="text-sm font-semibold text-slate-300">
					← Volver a la ficha
				</a>
			)
		}
	</section>

	{playbook.active ? <form id="ticketsPlaybookForm" class="hidden" aria-hidden="true" /> : null}

	<script
		is:inline
		define:vars={{
			productId,
			initialTickets,
			categoriesHref: continueHref,
			playbookActive: playbook.active,
		}}
	>
		;(function () {
			const list = document.getElementById("ticket-editor-list")
			const status = document.getElementById("tickets-status")
			const requirementsNotice = document.getElementById("tickets-requirements-notice")
			const requirementsMessage = document.getElementById("tickets-requirements-message")
			let rows = Array.isArray(initialTickets) ? initialTickets.map((row) => ({ ...row })) : []

			const ticketCodeOptions = [
				{ value: "adult", label: "Adulto" },
				{ value: "child", label: "Niño" },
				{ value: "infant", label: "Infante" },
				{ value: "custom", label: "Personalizado" },
			]

			function renderTicketCodeOptions(selectedCode) {
				return ticketCodeOptions
					.map(
						(option) =>
							`<option value="${option.value}" ${selectedCode === option.value ? "selected" : ""}>${option.label}</option>`
					)
					.join("")
			}

			function hideRequirementsNotice() {
				requirementsNotice?.classList.add("hidden")
			}

			function showEmptyStepRequirementsNotice() {
				if (!requirementsNotice || !requirementsMessage) return
				requirementsMessage.textContent = playbookActive
					? "Agrega y activa al menos un tipo de participante para continuar."
					: "Agrega al menos un tipo de participante antes de guardar."
				requirementsNotice.classList.remove("hidden")
				requirementsNotice.scrollIntoView({ behavior: "smooth", block: "nearest" })
			}

			function escapeHtml(value) {
				return String(value ?? "")
					.replaceAll("&", "&amp;")
					.replaceAll("<", "&lt;")
					.replaceAll(">", "&gt;")
					.replaceAll('"', "&quot;")
			}

			function render() {
				if (!list) return
				if (!rows.length) {
					list.innerHTML =
						'<p class="fastt-empty-state rounded-[var(--fastt-radius-control)] border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm text-slate-600">Aún no hay tipos de entrada. Usa la plantilla estándar o agrega uno manualmente.</p>'
					return
				}
				list.innerHTML = rows
					.map((row, index) => {
						const activeBadge = row.isActive
							? '<span class="inline-flex px-2 py-0.5 text-[10px] font-semibold text-emerald-800">Activo</span>'
							: '<span class="inline-flex px-2 py-0.5 text-[10px] font-semibold text-slate-600">Inactivo</span>'
						return `<article class="fastt-soft-box rounded-[var(--fastt-radius-card)] border border-slate-200 bg-slate-50/80 p-4" data-ticket-index="${index}">
							<div class="mb-3 flex items-center justify-between gap-2">
								<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Entrada ${index + 1}</p>
								${activeBadge}
							</div>
							<div class="grid gap-3 md:grid-cols-6">
								<label class="md:col-span-2 block text-xs font-medium text-slate-700">
									Nombre visible
									<input data-field="label" aria-label="Nombre visible de la entrada ${index + 1}" class="fastt-field mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" value="${escapeHtml(row.label)}" />
								</label>
								<label class="block text-xs font-medium text-slate-700">
									Tipo de participante
									<select data-field="code" aria-label="Tipo de participante de la entrada ${index + 1}" class="fastt-field mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
										${renderTicketCodeOptions(row.code)}
									</select>
								</label>
								<label class="block text-xs font-medium text-slate-700">
									Edad mínima
									<input data-field="minAge" aria-label="Edad mínima de la entrada ${index + 1}" type="number" min="0" class="fastt-field mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" value="${row.minAge == null ? "" : row.minAge}" />
								</label>
								<label class="block text-xs font-medium text-slate-700">
									Edad máxima
									<input data-field="maxAge" aria-label="Edad máxima de la entrada ${index + 1}" type="number" min="0" class="fastt-field mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" value="${row.maxAge == null ? "" : row.maxAge}" />
								</label>
								<label class="block text-xs font-medium text-slate-700">
									Orden de visualización
									<input data-field="sortOrder" aria-label="Orden de la entrada ${index + 1}" type="number" min="0" class="fastt-field mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" value="${Number(row.sortOrder || 0)}" />
								</label>
							</div>
							<div class="mt-3 flex flex-wrap items-center justify-between gap-2">
								<label class="inline-flex items-center gap-2 text-sm text-slate-700">
									<input data-field="isActive" aria-label="Entrada ${index + 1} disponible para reservar" type="checkbox" ${row.isActive ? "checked" : ""} />
									Disponible para reservar
								</label>
								<button type="button" data-remove-ticket class="fastt-button inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-50">
									Eliminar
								</button>
							</div>
						</article>`
					})
					.join("")

				list.querySelectorAll("[data-ticket-index]").forEach((article) => {
					const index = Number(article.getAttribute("data-ticket-index"))
					article.querySelectorAll("[data-field]").forEach((input) => {
						const field = input.getAttribute("data-field")
						const sync = () => {
							if (!rows[index] || !field) return
							if (field === "isActive") {
								rows[index].isActive = Boolean(input.checked)
							} else if (field === "minAge" || field === "maxAge") {
								const raw = String(input.value ?? "").trim()
								rows[index][field] = raw === "" ? null : Math.max(0, Math.round(Number(raw) || 0))
							} else if (field === "sortOrder") {
								rows[index].sortOrder = Math.max(0, Math.round(Number(input.value) || 0))
							} else {
								rows[index][field] = String(input.value ?? "")
							}
							hideRequirementsNotice()
						}
						input.addEventListener("change", sync)
						input.addEventListener("input", sync)
					})
					article.querySelector("[data-remove-ticket]")?.addEventListener("click", () => {
						rows.splice(index, 1)
						render()
					})
				})
			}

			document.getElementById("add-ticket-btn")?.addEventListener("click", () => {
				rows.push({
					id: crypto.randomUUID(),
					code: "custom",
					label: "Personalizado",
					minAge: null,
					maxAge: null,
					sortOrder: (rows.length + 1) * 10,
					isActive: true,
				})
				render()
				hideRequirementsNotice()
			})

			document.getElementById("seed-tickets-btn")?.addEventListener("click", async () => {
				if (status) status.textContent = "Cargando plantilla estándar..."
				const res = await fetch(
					`/api/variant/tour-ticket-types?productId=${encodeURIComponent(productId)}`
				)
				const payload = await res.json().catch(() => ({}))
				if (!res.ok) {
					if (status) status.textContent = "No se pudieron cargar las entradas."
					return
				}
				rows = (payload.tickets || []).map((t) => ({
					id: String(t.id),
					code: String(t.code),
					label: String(t.label),
					minAge: t.minAge == null ? null : Number(t.minAge),
					maxAge: t.maxAge == null ? null : Number(t.maxAge),
					sortOrder: Number(t.sortOrder ?? 0),
					isActive: Boolean(t.isActive),
				}))
				render()
				hideRequirementsNotice()
				if (status) status.textContent = `${rows.length} tipos de entrada listos.`
			})

			async function saveTickets() {
				const res = await fetch("/api/variant/tour-ticket-types", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						productId,
						tickets: rows.map((row) => ({
							id: row.id,
							code: row.code,
							label: String(row.label || "").trim() || row.code,
							minAge: row.minAge,
							maxAge: row.maxAge,
							sortOrder: Number(row.sortOrder || 0),
							isActive: Boolean(row.isActive),
						})),
					}),
				})
				const payload = await res.json().catch(() => ({}))
				if (!res.ok) {
					throw new Error("No se pudieron guardar las entradas.")
				}
				rows = (payload.tickets || []).map((t) => ({
					id: String(t.id),
					code: String(t.code),
					label: String(t.label),
					minAge: t.minAge == null ? null : Number(t.minAge),
					maxAge: t.maxAge == null ? null : Number(t.maxAge),
					sortOrder: Number(t.sortOrder ?? 0),
					isActive: Boolean(t.isActive),
				}))
				render()
				return rows
			}

			document.getElementById("save-tickets-btn")?.addEventListener("click", async () => {
				if (!rows.length) {
					if (status) status.textContent = "Agrega al menos un tipo de entrada."
					return
				}
				if (status) status.textContent = "Guardando..."
				try {
					await saveTickets()
					if (status) status.textContent = "Entradas guardadas."
				} catch (error) {
					if (status)
						status.textContent =
							error instanceof Error ? error.message : "No se pudieron guardar las entradas."
				}
			})

			async function saveAndContinuePlaybook(submitter) {
				const hasActiveTicket = rows.some((row) => row.isActive)

				if (hasActiveTicket) {
					hideRequirementsNotice()
				} else if (rows.length === 0) {
					showEmptyStepRequirementsNotice()
					if (status) status.textContent = ""
					return
				} else {
					hideRequirementsNotice()
					if (status)
						status.textContent =
							"Marca al menos un tipo de participante como disponible para reservar."
					return
				}

				if (submitter instanceof HTMLButtonElement) submitter.disabled = true
				if (status) status.textContent = "Guardando participantes..."
				try {
					await saveTickets()
					window.location.href = categoriesHref
				} catch (error) {
					if (status)
						status.textContent =
							error instanceof Error
								? `${error.message} Revisa los datos e inténtalo de nuevo.`
								: "No se pudo guardar. Inténtalo de nuevo."
					if (submitter instanceof HTMLButtonElement) submitter.disabled = false
				}
			}

			document.getElementById("ticketsPlaybookForm")?.addEventListener("submit", async (event) => {
				event.preventDefault()
				const submitter = event.submitter
				if (
					submitter instanceof HTMLButtonElement &&
					submitter.name === "playbookNav" &&
					submitter.value === "exit"
				) {
					window.location.href = `/product/${encodeURIComponent(productId)}`
					return
				}
				await saveAndContinuePlaybook(submitter)
			})

			render()
		})()
	</script>
</PlaybookLayout>
