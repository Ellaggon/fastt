---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import Textarea from "@/components/ui/Textarea.astro"
import { productRepository } from "@/container"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { isTourProductType } from "@/lib/productVerticalRegistry"
import { routes } from "@/lib/routes"
import {
	and,
	asc,
	db,
	desc,
	eq,
	TourPrivateRequest,
	Variant,
} from "@/shared/infrastructure/db/compat"

type PartyJson = {
	adults?: number
	children?: number
	infants?: number
}

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")
const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
if (!productId) return Astro.redirect("/product/create")
const owned = await productRepository.ensureProductOwnedByProvider(productId, providerId)
if (!owned) return Astro.redirect("/product/create")
if (!isTourProductType(owned.productType)) return Astro.redirect(routes.productDetail(productId))

const rows = await db
	.select({
		id: TourPrivateRequest.id,
		status: TourPrivateRequest.status,
		departureDate: TourPrivateRequest.departureDate,
		partyJson: TourPrivateRequest.partyJson,
		contactName: TourPrivateRequest.contactName,
		contactEmail: TourPrivateRequest.contactEmail,
		contactPhone: TourPrivateRequest.contactPhone,
		message: TourPrivateRequest.message,
		providerNote: TourPrivateRequest.providerNote,
		slaDueAt: TourPrivateRequest.slaDueAt,
		createdAt: TourPrivateRequest.createdAt,
		variantName: Variant.name,
	})
	.from(TourPrivateRequest)
	.leftJoin(Variant, eq(Variant.id, TourPrivateRequest.variantId))
	.where(
		and(eq(TourPrivateRequest.productId, productId), eq(TourPrivateRequest.providerId, providerId))
	)
	.orderBy(desc(TourPrivateRequest.createdAt), asc(TourPrivateRequest.id))
	.limit(50)

const pending = rows.filter((r) => String(r.status) === "pending").length
const now = Date.now()

const requestCards = rows.map((row) => {
	const party = (row.partyJson ?? {}) as PartyJson
	const status = String(row.status ?? "pending")
	const slaDueAt = row.slaDueAt ? new Date(row.slaDueAt) : null
	const slaOverdue = status === "pending" && slaDueAt != null && slaDueAt.getTime() < now
	return {
		id: row.id,
		status,
		badgeVariant:
			status === "pending"
				? ("warning" as const)
				: status === "accepted"
					? ("success" as const)
					: ("neutral" as const),
		statusLabel:
			status === "pending"
				? "Pendiente"
				: status === "accepted"
					? "Aceptada"
					: status === "declined"
						? "Rechazada"
						: status,
		title: `${row.variantName ?? "Salida"} · ${String(row.departureDate ?? "").slice(0, 10)}`,
		contactLine: `${row.contactName} · ${row.contactEmail}${
			row.contactPhone ? ` · ${row.contactPhone}` : ""
		}`,
		partyLine: `Grupo: ${Number(party.adults ?? 0)} adultos · ${Number(party.children ?? 0)} niños · ${Number(party.infants ?? 0)} infantes`,
		message: row.message ? String(row.message) : null,
		providerNote: row.providerNote ? String(row.providerNote) : null,
		sla: slaDueAt ? slaDueAt.toLocaleString("es-CL") : "—",
		slaOverdue,
		isPending: status === "pending",
	}
})
---

<WorkspaceLayout title="Solicitudes de salida privada">
	<section class="space-y-6" data-private-requests-root>
		<header class="space-y-2">
			<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
				{owned.name ?? "Tour"}
			</p>
			<h1 class="text-3xl font-semibold text-slate-950">Salidas privadas · solicitudes</h1>
			<p class="max-w-2xl text-sm leading-6 text-slate-600">
				Cotizaciones on-request. No se reserva inventario hasta que aceptes y armes la tarifa. SLA
				por defecto: 24h. Puedes aceptar o rechazar con una nota al viajero.
			</p>
			<div class="flex flex-wrap gap-2">
				<Button href={routes.productDetail(productId)} variant="secondary" size="sm">
					Volver al producto
				</Button>
				<Button href={`/product/${productId}/departures`} variant="secondary" size="sm">
					Salidas
				</Button>
			</div>
		</header>

		{
			pending > 0 ? (
				<Notice variant="warning" title={`${pending} pendiente${pending === 1 ? "" : "s"}`}>
					Responde con precio y condiciones antes del SLA para no perder la conversión.
				</Notice>
			) : (
				<Notice variant="info" title="Bandeja al día">
					No hay solicitudes pendientes. Las nuevas llegan aquí cuando un viajero pide cotizar una
					salida privada.
				</Notice>
			)
		}

		<p id="privateRequestsStatus" class="text-sm text-slate-600" aria-live="polite"></p>

		<div class="space-y-3">
			{
				requestCards.length === 0 ? (
					<Card class="border-dashed p-6 text-sm text-slate-500">
						Aún no hay solicitudes de salida privada para este tour.
					</Card>
				) : (
					requestCards.map((card) => (
						<Card
							class="space-y-3 border-slate-200 bg-white p-5"
							data-request-card
							data-request-id={card.id}
							data-status={card.status}
						>
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<p class="font-semibold text-slate-950">{card.title}</p>
									<p class="mt-1 text-sm text-slate-600">{card.contactLine}</p>
								</div>
								<Badge variant={card.badgeVariant} data-request-badge>
									{card.statusLabel}
								</Badge>
							</div>
							<p class="text-sm text-slate-700">{card.partyLine}</p>
							{card.message ? <p class="text-sm leading-6 text-slate-600">{card.message}</p> : null}
							<p
								class:list={[
									"text-xs",
									card.slaOverdue ? "font-semibold text-amber-700" : "text-slate-500",
								]}
							>
								SLA: {card.sla}
								{card.slaOverdue ? " · vencido" : ""} · id {card.id}
							</p>
							{card.providerNote ? (
								<p class="text-sm text-slate-600" data-provider-note>
									Nota del proveedor: {card.providerNote}
								</p>
							) : (
								<p class="hidden text-sm text-slate-600" data-provider-note />
							)}
							{card.isPending ? (
								<div class="space-y-2 border-t border-slate-100 pt-3" data-request-actions>
									<label class="block text-xs font-medium text-slate-700" for={`note-${card.id}`}>
										Nota para el viajero (opcional)
									</label>
									<Textarea
										id={`note-${card.id}`}
										name="providerNote"
										rows={2}
										placeholder="Precio propuesto, condiciones o motivo del rechazo…"
										data-provider-note-input
									/>
									<div class="flex flex-wrap gap-2">
										<Button
											type="button"
											size="sm"
											data-transition="accepted"
											data-request-id={card.id}
										>
											Aceptar
										</Button>
										<Button
											type="button"
											size="sm"
											variant="secondary"
											data-transition="declined"
											data-request-id={card.id}
										>
											Rechazar
										</Button>
									</div>
								</div>
							) : null}
						</Card>
					))
				)
			}
		</div>
	</section>

	<script is:inline>
		;(function () {
			const root = document.querySelector("[data-private-requests-root]")
			if (!(root instanceof HTMLElement)) return
			if (root.dataset.privateRequestsReady === "true") return
			root.dataset.privateRequestsReady = "true"

			const statusEl = document.getElementById("privateRequestsStatus")

			const setStatus = (message, isError) => {
				if (!statusEl) return
				statusEl.textContent = message
				statusEl.className = isError ? "text-sm text-red-700" : "text-sm text-emerald-700"
			}

			root.addEventListener("click", async (event) => {
				const target = event.target
				if (!(target instanceof HTMLElement)) return
				const button = target.closest("[data-transition]")
				if (!(button instanceof HTMLButtonElement)) return
				const requestId = String(button.dataset.requestId || "").trim()
				const nextStatus = String(button.dataset.transition || "").trim()
				if (!requestId || (nextStatus !== "accepted" && nextStatus !== "declined")) return

				const card = button.closest("[data-request-card]")
				if (!(card instanceof HTMLElement)) return
				const noteInput = card.querySelector("[data-provider-note-input]")
				const providerNote = noteInput instanceof HTMLTextAreaElement ? noteInput.value.trim() : ""

				const actionButtons = card.querySelectorAll("[data-transition]")
				actionButtons.forEach((el) => {
					if (el instanceof HTMLButtonElement) el.disabled = true
				})
				setStatus(
					nextStatus === "accepted" ? "Aceptando solicitud..." : "Rechazando solicitud...",
					false
				)

				try {
					const response = await fetch("/api/tours/private-request/transition", {
						method: "POST",
						headers: { "Content-Type": "application/json", "accept": "application/json" },
						body: JSON.stringify({
							requestId,
							status: nextStatus,
							providerNote: providerNote || null,
						}),
					})
					const payload = await response.json().catch(() => ({}))
					if (!response.ok) {
						const error = String(payload?.error || "")
						setStatus(
							error === "invalid_transition"
								? "Esta solicitud ya no admite esa transición."
								: error === "not_found"
									? "No encontramos la solicitud."
									: "No se pudo actualizar la solicitud.",
							true
						)
						actionButtons.forEach((el) => {
							if (el instanceof HTMLButtonElement) el.disabled = false
						})
						return
					}
					window.location.reload()
				} catch {
					setStatus("Error de red al actualizar la solicitud.", true)
					actionButtons.forEach((el) => {
						if (el instanceof HTMLButtonElement) el.disabled = false
					})
				}
			})
		})()
	</script>
</WorkspaceLayout>
