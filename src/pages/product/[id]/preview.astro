		{
			isHotel ? (
				<section id="guest-house-rules" class="space-y-4">
					<header class="flex flex-wrap items-end justify-between gap-3">
						<div class="space-y-1">
							<h2 class="text-lg font-semibold text-slate-100">Reglas para huéspedes</h2>
							<p class="text-sm leading-6 text-slate-400">
								Comportamiento, llegada y operación de estadía
								{previewVariantId ? " para el espacio seleccionado" : " del alojamiento"}.
							</p>
						</div>
						<Button href={routes.providerHouseRules()} variant="secondary" size="sm">
							Editar reglas
						</Button>
					</header>
					{guestRoomPreviews.length ? (
						<div class="flex flex-wrap gap-2">
							<a href={previewHouseRulesHref()}>
								<Badge variant={previewVariantId ? "neutral" : "info"}>Todo el alojamiento</Badge>
							</a>
							{guestRoomPreviews.map((preview) => (
								<a href={previewHouseRulesHref(preview.variantId)}>
									<Badge variant={previewVariantId === preview.variantId ? "info" : "neutral"}>
										{preview.roomName}
									</Badge>
								</a>
							))}
						</div>
					) : null}
					<Card className="bg-white text-slate-800">
						<GuestHouseRulesPanel
							hotelSnapshot={hotelGuestExpectationsSnapshot}
							roomSnapshot={roomGuestExpectationsSnapshot}
							roomLabel={previewVariantId ? previewRoomLabel : null}
							surface="preview"
						/>
					</Card>
				</section>
			) : null
		}
	</section>

	<script
		is:inline
		data-astro-rerun
		define:vars={{
			productId,
			productPublishedHref: `${routes.productDetail(productId)}?published=1`,
		}}
	>
		;(function () {
			const publishButtons = Array.from(document.querySelectorAll(".publish-product-button"))
			const feedback = document.getElementById("publishFeedback")
			const providerBlockerAction = document.getElementById("providerBlockerAction")
			if (!publishButtons.length || !productId) return

			const setDisabled = (disabled) => {
				for (const button of publishButtons) {
					button.disabled = disabled
				}
			}
			const showFailure = (payload, fallback) => {
				const errors = Array.isArray(payload.validationErrors) ? payload.validationErrors : []
				const blockers = Array.isArray(payload.blockers) ? payload.blockers : []
				if (feedback)
					feedback.textContent =
						errors
							.map((item) => item.message)
							.filter(Boolean)
							.join("\n") ||
						blockers
							.map((item) => item.label || item.action)
							.filter(Boolean)
							.join("\n") ||
						payload.message ||
						fallback
				const action = errors.find((item) => item.action)?.action || payload.action
				const href =
					action?.href || payload.selectionHref || blockers.find((item) => item.href)?.href
				if (providerBlockerAction) {
					const safe =
						typeof href === "string" &&
						href.startsWith("/") &&
						!href.startsWith("//") &&
						!href.includes("\\") &&
						!/%(?:2f|5c)/i.test(href)
					providerBlockerAction.classList.toggle("hidden", !safe)
					if (safe) {
						providerBlockerAction.href = href
						providerBlockerAction.textContent = action?.label || "Revisar pendiente"
					}
				}
			}

			const publish = async () => {
				setDisabled(true)
				if (feedback) {
					feedback.classList.remove("hidden")
					feedback.textContent = "Verificando requisitos..."
				}

				try {
					const formData = new FormData()
					formData.set("productId", productId)
					for (const key of ["variantId", "ratePlanId"]) {
						const value = new URL(window.location.href).searchParams.get(key)
						if (value) formData.set(key, value)
					}

					const evaluateResponse = await fetch("/api/product/evaluate", {
						method: "POST",
						body: formData,
					})
					const evaluatePayload = await evaluateResponse.json().catch(() => ({}))
					if (!evaluateResponse.ok || evaluatePayload.state !== "ready") {
						showFailure(evaluatePayload, "No se pudo validar la oferta. Vuelve a intentar.")
						setDisabled(false)
						return
					}

					const publishResponse = await fetch("/api/product/publish", {
						method: "POST",
						body: formData,
					})
					const publishPayload = await publishResponse.json().catch(() => ({}))
					if (!publishResponse.ok || !publishPayload.ok) {
						showFailure(publishPayload, "No se pudo publicar la oferta. Vuelve a intentar.")
						setDisabled(false)
						return
					}

					if (feedback)
						feedback.textContent = `${vertical.labels.workspaceSingular} publicado. Volviendo a la ficha...`
					window.location.href = productPublishedHref
				} catch (error) {
					if (feedback) feedback.textContent = `Error de red: ${String(error)}`
					setDisabled(false)
				}
			}

			for (const button of publishButtons) {
				button.addEventListener("click", publish)
			}
		})()
	</script>
</PlaybookLayout>
