---
import TourPublishedReviewAction from "@/components/tours/TourPublishedReviewAction.astro"
import TourPreparationProgress from "@/components/tours/TourPreparationProgress.astro"
import { presentTourDiagnostic } from "@/lib/tours/tourDiagnosticPresentation"
import {
	loadTourCommercialContext,
	tourContextEntryResponse,
} from "@/lib/tours/loadTourCommercialContext"
import GuestHouseRulesPanel from "@/components/house-rules/GuestHouseRulesPanel.astro"
import GuestRoomPreviewCards from "@/components/productUI/GuestRoomPreviewCards.astro"
import { buildGuestRoomPreviews } from "@/components/productUI/room-section.viewmodel"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import { productRepository } from "@/container"
import { POLICY_CATEGORY_ORDER } from "@/data/policy/policy-categories"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import {
	buildCompleteToPublishHref,
	buildCompleteToPublishResumeHref,
	resolveCompleteToPublishPlaybookFromUrl,
} from "@/lib/playbook/complete-to-publish"
import { loadCompleteToPublishState } from "@/lib/playbook/evaluate-complete-to-publish-progress"
import { resolveLaunchPlaybookFromUrl } from "@/lib/playbook/launch-accommodation"
import {
	buildTourPlaybookHref,
	buildTourProviderPreviewHref,
	getTourPreviewCanonicalHref,
	resolveTourLaunchPlaybookFromUrl,
	type TourLaunchStepId,
} from "@/lib/playbook/launch-tour"
import { resolvePlaybookFromUrl } from "@/lib/playbook/resolve-playbook"
import { resolveReservationConditionsHref } from "@/lib/product-preview/resolveReservationConditionsHref"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { getProductVerticalEntry } from "@/lib/catalog/productVerticalRegistry"
import { routes } from "@/lib/routes"
import { evaluateProviderGovernance } from "@/lib/provider-governance"
import { loadProductLineGate } from "@/lib/verification/line-gate"
import {
	getProductFullAggregate,
	getProductVariantsAggregate,
	resolveHotelAmenities,
	resolveHotelType,
} from "@/modules/catalog/public"
import { ArrowRight, BedDouble, CircleCheck, ClipboardList, ShieldCheck } from "@lucide/astro"
import { buildGuestStayExpectationsSnapshot } from "@/modules/house-rules/public"
import { mapResolvedPoliciesToUI, resolveEffectivePolicies } from "@/modules/policies/public"
import {
	and,
	first,
	asc,
	db,
	eq,
	Image,
	inArray,
	Product,
	RatePlan,
	VariantImage,
	Variant,
} from "@/shared/infrastructure/db/compat"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
if (!productId) return Astro.redirect(routes.productList())

const owned = await productRepository.ensureProductOwnedByProvider(productId, providerId)
if (!owned) return Astro.redirect(routes.productList())

const aggregate = await getProductFullAggregate(productId, providerId)
if (!aggregate) return Astro.redirect(routes.productList())

const vertical = getProductVerticalEntry(aggregate.productType)
const isHotel = vertical.vertical === "hotel"
const isTour = vertical.vertical === "tour"
const verificationHref = isTour
	? `${routes.providerSettingsVerification()}?line=tour&tab=activity&experience=${encodeURIComponent(productId)}`
	: `${routes.providerSettingsVerification()}?line=lodging&tab=identity`
const verificationDocumentsHref = isTour
	? `${routes.providerSettingsVerificationDocuments()}?line=tour&tab=activity&experience=${encodeURIComponent(productId)}`
	: routes.providerSettingsVerificationDocuments()
const publicDetailHref = vertical.routes.publicDetailHref(productId)
if (isTour) {
	const selection = await loadTourCommercialContext({
		providerId,
		productId,
		request: Astro.request,
		url: Astro.url,
	})
	const entryResponse = tourContextEntryResponse(selection, Astro.url)
	if (entryResponse) return entryResponse
	const canonicalHref = getTourPreviewCanonicalHref(Astro.url, {
		isTour,
		productId,
		variantId: "variantId" in selection ? (selection.variantId ?? undefined) : undefined,
		ratePlanId: "ratePlanId" in selection ? (selection.ratePlanId ?? undefined) : undefined,
	})
	if (canonicalHref) return Astro.redirect(canonicalHref)
}
const previewVariantId = String(Astro.url.searchParams.get("variantId") ?? "").trim()
const previewRatePlanId = String(Astro.url.searchParams.get("ratePlanId") ?? "").trim()
const realTourPreviewHref = isTour
	? buildTourProviderPreviewHref(productId, {
			variantId: previewVariantId,
			ratePlanId: previewRatePlanId,
		})
	: null
const publicPreviewReturnTo = Astro.url.pathname + Astro.url.search
const realTourPreviewWithReturn = realTourPreviewHref
	? `${realTourPreviewHref}&${new URLSearchParams({ returnTo: publicPreviewReturnTo })}`
	: null

const selectedTourReviewOffer =
	isTour && previewVariantId && previewRatePlanId
		? await db
				.select({
					variantName: Variant.name,
					ratePlanName: RatePlan.name,
					ratePlanIsActive: RatePlan.isActive,
					ratePlanIsDefault: RatePlan.isDefault,
					salesEnabled: Variant.salesEnabled,
				})
				.from(Variant)
				.innerJoin(RatePlan, eq(RatePlan.variantId, Variant.id))
				.where(
					and(
						eq(Variant.id, previewVariantId),
						eq(Variant.productId, productId),
						eq(Variant.kind, "tour_slot"),
						eq(RatePlan.id, previewRatePlanId)
					)
				)
				.then(first)
		: null

const statusRow = await db
	.select({ state: Product.publicationState })
	.from(Product)
	.where(eq(Product.id, productId))
	.then(first)
const productStatus = String(statusRow?.state ?? "draft")
	.trim()
	.toLowerCase()
const isPublished = productStatus === "published"
const publishState = await loadCompleteToPublishState({
	productId,
	providerId,
	request: Astro.request,
	url: Astro.url,
})
if (!publishState) return Astro.redirect(routes.productList())

const checks = publishState.checks
const readyToPublish = publishState.readyToPublish && !isPublished
const providerGovernance = isTour
	? null
	: await evaluateProviderGovernance(providerId, {
			currentUserId: user.id,
			persist: false,
		})
const providerPublishBlockers = (providerGovernance?.blockers ?? []).filter((blocker) =>
	blocker.capabilities.includes("publish")
)
const providerReadyToPublish = isTour
	? publishState.tourDiagnostic?.requirements.provider_authorization.result.state === "ready"
	: Boolean(providerGovernance?.capabilities.publish)
const providerPublishBlocker = providerPublishBlockers[0] ?? null
const publicationEligibility = isTour
	? { eligible: true, reason: null }
	: await productRepository.getProductPublicationEligibility(productId)
const lineGate = isTour
	? null
	: await loadProductLineGate({
			providerId,
			productId,
			capability: "publish",
		})
const lineGateBlocker = lineGate?.enforced ? (lineGate.blockers[0] ?? null) : null
const lineGateReady = isTour
	? publishState.tourDiagnostic?.requirements.experience_authorization.result.state === "ready"
	: !lineGate?.enforced || lineGate.allowed
const publicationEligible =
	providerReadyToPublish && publicationEligibility.eligible && lineGateReady
const eligibilityBlocker = publicationEligibility.eligible
	? null
	: {
			label:
				publicationEligibility.reason === "provider_not_commercial"
					? "El negocio no está habilitado para uso comercial"
					: "Esta ficha pertenece a datos no aptos para publicación pública",
			href: routes.providerSettings(),
		}
const publicationBlocker =
	providerPublishBlocker ??
	(lineGateBlocker
		? {
				label: lineGateBlocker.label,
				href: verificationHref,
			}
		: null) ??
	eligibilityBlocker
const tourPresentation = publishState.tourDiagnostic
	? presentTourDiagnostic(publishState.tourDiagnostic, {
			published: isPublished,
			previewHref: Astro.url.pathname + Astro.url.search,
		})
	: null
const readinessPercent = publishState.readinessPercent
const blockerLabels = publishState.blockers
	.filter((check) => check.sectionKey !== "preview")
	.map((check) => check.label)
const actionableChecks = checks.filter((check) => check.sectionKey !== "preview")
const actionableCompletedChecks = publishState.tourDiagnostic
	? publishState.completedChecks
	: actionableChecks.filter((check) => check.complete).length
const actionableBlockers = publishState.blockers.filter((check) => check.sectionKey !== "preview")
const nextBlocker = actionableBlockers[0] ?? null

const playbook = resolvePlaybookFromUrl(Astro.url, { isHotel })
const launchPlaybook = resolveLaunchPlaybookFromUrl(Astro.url)
const tourLaunchPlaybook = resolveTourLaunchPlaybookFromUrl(Astro.url)
const completePlaybook = resolveCompleteToPublishPlaybookFromUrl(Astro.url)
const playbookId = playbook.active ? playbook.playbookId : null
const stepId =
	playbookId === "complete-to-publish"
		? (completePlaybook.stepId ?? "preview")
		: playbookId === "launch"
			? (launchPlaybook.stepId ?? "preview")
			: playbookId === "launch-tour"
				? (tourLaunchPlaybook.stepId ?? "preview")
				: "preview"

function checkHref(check: (typeof checks)[number]) {
	if (isTour && check.href.startsWith("/provider/")) {
		const target = new URL(check.href, Astro.url)
		target.searchParams.set("returnTo", Astro.url.pathname + Astro.url.search)
		return target.pathname + target.search + target.hash
	}
	const navigationStep = check.navigationStep ?? check.sectionKey
	if (playbookId === "complete-to-publish") {
		return buildCompleteToPublishHref(check.href, navigationStep)
	}
	if (playbookId === "launch-tour") {
		const stepBySection: Record<string, TourLaunchStepId> = {
			identity: "create",
			content: "content",
			photos: "images",
			location: "location",
			subtype: "subtype",
			itinerary: "subtype",
			tickets: "tickets",
			categories: "categories",
			departure: "departure",
			rate: "rate",
			calendar: "calendar",
			bookingPolicies: "conditions",
			preview: "preview",
		}
		return buildTourPlaybookHref(check.href, stepBySection[navigationStep] ?? "preview")
	}
	return check.href
}

// Inside launch playbooks, preview still jumps to the first blocker. In
// complete-to-publish the calendar step already hands off to preview; stay there
// and let the page surface pending requirements without rewinding the flow.
if (
	playbook.active &&
	stepId === "preview" &&
	nextBlocker &&
	playbookId !== "complete-to-publish"
) {
	if (!publishState.tourDiagnostic) return Astro.redirect(checkHref(nextBlocker))
}

const completePreparationHref = buildCompleteToPublishResumeHref(productId, checks)
const description = String(aggregate.content.description ?? "").trim()
const highlights = Array.isArray(aggregate.content.highlights) ? aggregate.content.highlights : []
const primaryImage = aggregate.images[0]?.url ?? ""
const imagePreviews = aggregate.images.slice(0, 6)
const productFallbackGallery = aggregate.images
	.map((image) => String(image.url ?? "").trim())
	.filter(Boolean)
const packageIncludes =
	aggregate.subtype?.kind === "package" ? String(aggregate.subtype.includes ?? "").trim() : ""
const packageExcludes =
	aggregate.subtype?.kind === "package" ? String(aggregate.subtype.excludes ?? "").trim() : ""
const packageInclusionItems = packageIncludes
	.split(/\r?\n|,/)
	.map((item) => item.trim())
	.filter(Boolean)
const packageExclusionItems = packageExcludes
	.split(/\r?\n|,/)
	.map((item) => item.trim())
	.filter(Boolean)
const hotelGuestExpectationsSnapshot = isHotel
	? await buildGuestStayExpectationsSnapshot(productId)
	: null

let guestRoomPreviews: ReturnType<typeof buildGuestRoomPreviews> = []
let conditionsHref = routes.rates()
if (isHotel) {
	const variantsAggregate = await getProductVariantsAggregate(productId, providerId)
	const roomVariants = variantsAggregate?.variants ?? []
	const roomVariantIds = roomVariants
		.map((variant: any) => String(variant.id ?? "").trim())
		.filter(Boolean)
	const [roomProfiles, roomAmenities, variantImageRows] = roomVariantIds.length
		? await Promise.all([
				resolveHotelType(roomVariantIds),
				resolveHotelAmenities(roomVariantIds),
				db
					.select({
						id: Image.id,
						variantId: VariantImage.variantId,
						url: Image.url,
						order: VariantImage.sortOrder,
						isPrimary: VariantImage.isPrimary,
					})
					.from(VariantImage)
					.innerJoin(Image, eq(Image.id, VariantImage.imageId))
					.where(inArray(VariantImage.variantId, roomVariantIds))
					.orderBy(asc(VariantImage.sortOrder), asc(Image.id)),
			])
		: [[], [], []]
	const imagesByVariant = new Map<string, any[]>()
	for (const image of variantImageRows) {
		const variantId = String(image.variantId ?? "")
		if (!imagesByVariant.has(variantId)) imagesByVariant.set(variantId, [])
		imagesByVariant.get(variantId)?.push({
			id: String(image.id),
			url: String(image.url),
			order: Number(image.order ?? 0),
			isPrimary: Boolean(image.isPrimary),
		})
	}

	guestRoomPreviews = buildGuestRoomPreviews({
		offers: roomVariants.map((variant: any) => ({
			variantId: variant.id,
			variant: {
				id: variant.id,
				name: variant.name,
				maxOccupancy: variant.capacity?.maxOccupancy ?? null,
			},
			variantImages: imagesByVariant.get(String(variant.id)) ?? [],
		})),
		hotelRoom: roomProfiles,
		amenities: roomAmenities,
		productFallbackImage: primaryImage || "https://placehold.co/1200x800?text=Habitacion",
		productFallbackGallery,
	})

	conditionsHref = await resolveReservationConditionsHref({ productId, variantIds: roomVariantIds })
}

const roomGuestExpectationsSnapshot =
	isHotel && previewVariantId
		? await buildGuestStayExpectationsSnapshot(productId, { variantId: previewVariantId })
		: null
const previewRoomLabel =
	guestRoomPreviews.find((preview) => preview.variantId === previewVariantId)?.roomName ?? null

function previewHouseRulesHref(variantId?: string | null) {
	const params = new URLSearchParams(Astro.url.searchParams)
	if (variantId) params.set("variantId", variantId)
	else params.delete("variantId")
	const query = params.toString()
	return `${routes.productPreview(productId)}${query ? `?${query}` : ""}#guest-house-rules`
}

const requiredPolicyCategories = ["Cancellation", "Payment", "CheckIn", "NoShow"]
let policyCategorySet = new Set<string>()
let mappedPolicies: any[] = []
let policyResolutionError: string | null = null
if (!isTour) {
	try {
		const resolvedPolicies = await resolveEffectivePolicies({
			productId,
			channel: "web",
			requiredCategories: requiredPolicyCategories,
			onMissingCategory: "return_null",
			featureContext: {
				request: Astro.request,
				query: Astro.url.searchParams,
			},
		})
		policyCategorySet = new Set(
			resolvedPolicies.policies.map((policy) => String(policy.category ?? ""))
		)
		mappedPolicies = mapResolvedPoliciesToUI(resolvedPolicies) as any[]
	} catch (error) {
		policyResolutionError =
			error instanceof Error ? error.message : "No se pudieron resolver las condiciones"
		mappedPolicies = []
	}
}
---

<PlaybookLayout
	title={`${vertical.labels.workspacePlural} · Vista previa`}
	playbookId={playbookId}
	active={playbook.active}
	stepId={stepId}
	productId={productId}
	isHotel={isHotel}
	playbookVertical={vertical.vertical}
	variantId={previewVariantId}
	ratePlanId={previewRatePlanId}
	hideFooter={playbook.active && stepId === "preview"}
>
	<section class="space-y-7">
		{
			isPublished && publicDetailHref ? (
				<div class="flex justify-end">
					<Button href={publicDetailHref} variant="secondary">
						Abrir página pública
					</Button>
				</div>
			) : null
		}

		{
			!isTour && !isPublished && !publicationEligible ? (
				<Card
					variant="soft"
					class="border-amber-200 bg-amber-50 text-slate-900"
					data-provider-publish-blocked
				>
					<div class="flex flex-wrap items-center justify-between gap-4">
						<div>
							<p class="font-semibold">Hay un requisito del negocio pendiente</p>
							<p class="mt-1 text-sm leading-6 text-slate-700">
								{publicationBlocker
									? `Pendiente: ${publicationBlocker.label}. Al resolverlo, volveremos a comprobar los demás requisitos de publicación.`
									: "Completa la configuración requerida del negocio antes de publicar esta ficha."}
							</p>
						</div>
						{publicationBlocker ? (
							<Button href={publicationBlocker.href} variant="secondary">
								Resolver configuración
							</Button>
						) : null}
					</div>
				</Card>
			) : null
		}

		<Card variant="dark" class="!border-neutral-800 !bg-black">
			<div class="space-y-6">
				<div class="flex flex-wrap items-start justify-between gap-4">
					<div class="flex min-w-0 items-start gap-3">
						<span class="fastt-section-icon">
							{
								isPublished || readyToPublish ? (
									<CircleCheck class="size-4" aria-hidden="true" />
								) : (
									<ClipboardList class="size-4" aria-hidden="true" />
								)
							}
						</span>
						<div class="min-w-0">
							<p class="text-xl font-semibold text-white">
								{
									isPublished
										? `${vertical.labels.workspaceSingular} publicado`
										: readyToPublish && publicationEligible
											? "Listo para publicar"
											: "Pendientes para publicar"
								}
							</p>
							<p class="mt-1 max-w-3xl text-sm leading-6 text-neutral-400">
								{
									tourPresentation
										? tourPresentation.message
										: isPublished
											? "La ficha ya está activa. Usa esta revisión para comprobar cómo la verá el viajero."
											: readyToPublish && publicationEligible
												? "Todo lo obligatorio está listo. Publica cuando estés preparado para recibir reservas."
												: readyToPublish
													? "La ficha está lista. Completa la configuración del negocio para poder publicarla."
													: `${actionableCompletedChecks} requisitos listos. ${blockerLabels.length ? `Faltan ${blockerLabels.length}: ${blockerLabels.join(", ")}.` : ""}`
								}
							</p>
						</div>
					</div>
					<Badge
						variant={isPublished || (readyToPublish && publicationEligible)
							? "darkSuccess"
							: "darkWarning"}
					>
						{
							isPublished
								? "Publicado"
								: readyToPublish && publicationEligible
									? "Listo"
									: readyToPublish
										? "Negocio pendiente"
										: `${readinessPercent}% ${publishState.tourDiagnostic ? "preparado" : "listo"}`
						}
					</Badge>
				</div>

				{
					tourPresentation ? (
						<TourPreparationProgress preparation={tourPresentation.preparation} />
					) : (
						<div class="flex items-center gap-3">
							<div
								role="progressbar"
								aria-label="Preparación de la ficha"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow={readinessPercent}
								class="h-1 flex-1 overflow-hidden rounded-full bg-white/10"
							>
								<div
									class="h-full rounded-full"
									style={`width: ${Math.max(0, Math.min(100, readinessPercent))}%; background-color: var(--fastt-color-selection);`}
								/>
							</div>
							<p class="shrink-0 text-xs font-medium text-neutral-400 tabular-nums">
								{actionableCompletedChecks} de{" "}
								{publishState.tourDiagnostic ? publishState.totalChecks : actionableChecks.length}
							</p>
						</div>
					)
				}

				{
					isPublished && tourPresentation ? (
						<TourPublishedReviewAction
							presentation={tourPresentation}
							backHref={`${routes.productDetail(productId)}?${new URLSearchParams({ ...(previewVariantId ? { variantId: previewVariantId } : {}), ...(previewRatePlanId ? { ratePlanId: previewRatePlanId } : {}) })}`}
							backLabel={playbook.active ? "Salir y volver a la ficha" : "Volver a la ficha"}
						/>
					) : (
						<div class="flex flex-col gap-4 border-t border-white/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
							<div class="flex min-w-0 items-start gap-3">
								<span class="fastt-section-icon">
									{isPublished || readyToPublish ? (
										<CircleCheck class="size-4" aria-hidden="true" />
									) : (
										<ClipboardList class="size-4" aria-hidden="true" />
									)}
								</span>
								<div class="min-w-0">
									<p class="text-xs font-semibold tracking-[0.14em] text-neutral-500 uppercase">
										{isPublished
											? "Revisión"
											: readyToPublish && publicationEligible
												? "Siguiente acción"
												: "Siguiente requisito"}
									</p>
									<p class="mt-1 text-base font-semibold text-white">
										{isPublished
											? "La página pública ya está disponible"
											: readyToPublish && publicationEligible
												? `Publicar ${vertical.labels.singular.toLowerCase()}`
												: readyToPublish
													? (publicationBlocker?.label ?? "Configura el negocio para publicar")
													: (nextBlocker?.label ?? "Revisa los requisitos pendientes")}
									</p>
									<p class="mt-1 max-w-xl text-sm leading-6 text-neutral-400">
										{tourPresentation
											? tourPresentation.support
											: isPublished
												? "Puedes volver a la ficha para operar el alojamiento o revisar el resultado público."
												: readyToPublish && publicationEligible
													? `Revisa la ficha pública debajo y confirma que representa correctamente tu ${vertical.labels.singular.toLowerCase()}.`
													: readyToPublish
														? "La ficha ya está preparada. Resuelve este requisito del negocio para publicarla."
														: (nextBlocker?.detail ??
															"Completa el siguiente requisito para continuar.")}
									</p>
								</div>
							</div>
							<div class="flex shrink-0 flex-wrap items-center gap-2">
								<Button
									href={
										isTour
											? `${routes.productDetail(productId)}?${new URLSearchParams({ ...(previewVariantId ? { variantId: previewVariantId } : {}), ...(previewRatePlanId ? { ratePlanId: previewRatePlanId } : {}) })}`
											: routes.productDetail(productId)
									}
									variant="secondary"
								>
									{playbook.active ? "Salir y volver a la ficha" : "Volver a la ficha"}
								</Button>
								{isPublished ? null : readyToPublish && publicationEligible ? (
									<Button class="publish-product-button" type="button" variant="onDark">
										Publicar {vertical.labels.singular}
									</Button>
								) : readyToPublish && publicationBlocker ? (
									<Button href={publicationBlocker.href} variant="onDark">
										Resolver configuración
									</Button>
								) : (
									<Button
										href={
											nextBlocker
												? checkHref(nextBlocker)
												: (tourPresentation?.primaryAction.href ?? completePreparationHref)
										}
										variant="onDark"
									>
										{nextBlocker?.cta ??
											tourPresentation?.primaryAction.label ??
											"Completar preparación"}
										<ArrowRight class="h-4 w-4" aria-hidden="true" />
									</Button>
								)}
							</div>
						</div>
					)
				}

				<div
					id="publishFeedback"
					class="hidden rounded-[var(--fastt-radius-control)] bg-white/10 px-4 py-3 text-sm leading-6 text-slate-200"
					role="status"
				>
				</div>
				<a
					id="providerBlockerAction"
					class="mt-3 hidden text-sm font-semibold text-white underline"
					href="#"
				>
					Resolver configuración del negocio
				</a>
			</div>
		</Card>

		{
			realTourPreviewHref ? (
				<section class="space-y-3" data-real-public-preview>
					{previewVariantId || previewRatePlanId ? (
						<aside
							class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sky-950"
							aria-label="Selección comercial en revisión"
							data-selected-tour-review
						>
							{selectedTourReviewOffer ? (
								<div class="flex w-full flex-wrap items-center justify-between gap-3">
									<div class="min-w-0">
										<p class="text-xs font-semibold tracking-wide text-sky-800 uppercase">
											Oferta seleccionada para revisar
										</p>
										<p class="mt-1 font-semibold">
											{String(selectedTourReviewOffer.variantName ?? "Salida")}
										</p>
										<p class="mt-0.5 text-sm text-sky-900">
											Tarifa: {String(selectedTourReviewOffer.ratePlanName ?? "Sin nombre")}
										</p>
									</div>
									<Badge
										variant={
											selectedTourReviewOffer.ratePlanIsActive &&
											selectedTourReviewOffer.ratePlanIsDefault &&
											selectedTourReviewOffer.salesEnabled
												? "success"
												: "warning"
										}
									>
										{selectedTourReviewOffer.ratePlanIsActive &&
										selectedTourReviewOffer.ratePlanIsDefault &&
										selectedTourReviewOffer.salesEnabled
											? "Tarifa activada"
											: "Revisar activación"}
									</Badge>
								</div>
							) : (
								<p class="text-sm font-medium" role="status">
									No pudimos vincular esta selección con una opción y tarifa de este tour. Vuelve a
									revisar disponibilidad y precio.
								</p>
							)}
						</aside>
					) : null}
					<header class="flex flex-wrap items-end justify-between gap-3">
						<div>
							<p class="text-sm font-semibold text-white">Vista final del viajero</p>
							<p class="mt-1 max-w-3xl text-sm leading-6 text-slate-400">
