---
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import { TOUR_REQUIREMENT_PRESENTATION } from "@/lib/tours/tourDiagnosticPresentation"
import type { TourRequirementId } from "@/lib/tours/tourDiagnosticContract"
import { AlertTriangle, Building2, CircleCheck, ClipboardList, ShieldCheck } from "@lucide/astro"
import { requireProvider } from "@/lib/auth/requireProvider"
import { getOptionSession, sessionHref } from "@/lib/onboarding/tourOptionSession"
import { loadCompleteToPublishState } from "@/lib/playbook/evaluate-complete-to-publish-progress"
import { tourActivationDecision } from "@/lib/tours/buildTourDiagnostic"
import { optionWizardHref, type OptionStep } from "@/lib/playbook/add-tour-option"
import {
	db,
	eq,
	TourSlotProfile,
	Variant,
	RatePlan,
	Product,
} from "@/shared/infrastructure/db/compat"
import { TOUR_SLOT_LANGUAGE_OPTIONS } from "@/lib/tours/tourSlotLanguageOptions"
import { loadRatePlanPricingData } from "@/lib/pricing/loadRatePlanPricingData"
const { providerId, user } = await requireProvider(Astro.request)
const productId = Astro.params.id!,
	variantId = Astro.params.slotId!
const session = await getOptionSession(
	providerId,
	user.id,
	Astro.url.searchParams.get("sessionId") || "",
	productId
).catch(() => null)
if (!session || session.variantId !== variantId)
	return new Response("Recorrido no encontrado", { status: 404 })
if (!session.ratePlanId) return Astro.redirect(sessionHref(session, "price"))
const ratePlanId = session.ratePlanId
const [state, profiles, rates, products, pricing] = await Promise.all([
	loadCompleteToPublishState({
		providerId,
		productId,
		request: Astro.request,
		selection: { variantId, ratePlanId },
	}),
	db
		.select({
			name: Variant.name,
			time: TourSlotProfile.departureTime,
			language: TourSlotProfile.languageCode,
			mode: TourSlotProfile.bookingMode,
			capacity: TourSlotProfile.maxPax,
		})
		.from(Variant)
		.innerJoin(TourSlotProfile, eq(TourSlotProfile.variantId, Variant.id))
		.where(eq(Variant.id, variantId)),
	db.select().from(RatePlan).where(eq(RatePlan.id, ratePlanId)),
	db
		.select({ name: Product.name, status: Product.publicationState })
		.from(Product)
		.where(eq(Product.id, productId)),
	loadRatePlanPricingData({ request: Astro.request, ratePlanId }),
])
const decision = state?.tourDiagnostic ? tourActivationDecision(state.tourDiagnostic) : null
const profile = profiles[0],
	rate = rates[0],
	product = products[0]
if (!profile || !rate || !product)
	return new Response("La oferta ya no está disponible", { status: 404 })
const firstPublication = session.entryIntent === "first_publication"
const context = { productId, variantId, ratePlanId, sessionId: session.id }
const summary = [
	["Opción", profile.name],
	["Horario habitual", profile.time],
	[
		"Idioma",
		TOUR_SLOT_LANGUAGE_OPTIONS.find((language) => language.code === profile.language)?.label ||
			profile.language,
	],
	["Modalidad", profile.mode === "private" ? "Privada · solicitudes" : "Compartida"],
	["Máximo del grupo", String(profile.capacity)],
	["Tarifa", rate.name],
	[
		"Precio base",
		"loaded" in pricing
			? `${pricing.loaded.initialBasePrice} ${pricing.loaded.initialCurrency}`
			: "No se pudo comprobar",
	],
]
function activationBlockerTitle(id: string) {
	return TOUR_REQUIREMENT_PRESENTATION[id as TourRequirementId]?.label ?? "Requisito pendiente"
}
function activationBlockerDetails(message: string) {
	const normalized = message.trim()
	const prefix = "Requisitos pendientes: "
	if (normalized.startsWith(prefix)) {
		return normalized
			.slice(prefix.length)
			.split(" · ")
			.map((part) => part.trim())
			.filter(Boolean)
	}
	if (normalized.includes(" · ")) {
		return normalized
			.split(" · ")
			.map((part) => part.trim())
			.filter(Boolean)
	}
	return [normalized]
}
function optionEditHref(step: OptionStep) {
	const href = new URL(optionWizardHref(context, step), "http://fastt.local")
	href.searchParams.set("optionReturn", "review")
	return href.pathname + href.search
}
const correction = (blocker: NonNullable<typeof decision>["blockers"][number]) => {
	const target = new URL(blocker.action.href, "http://fastt.local")
	if (target.pathname.startsWith("/provider/")) {
		target.searchParams.set("returnTo", sessionHref(session, "review"))
		return target.pathname + target.search + target.hash
	}
	const id = String(blocker.id)
	const step: OptionStep = id.includes("price")
		? "price"
		: id.includes("condition") || id.includes("polic")
			? "conditions"
			: id.includes("calendar") || id.includes("avail")
				? "calendar"
				: "profile"
	const href = new URL(optionWizardHref(context, step), "http://fastt.local")
	href.searchParams.set("optionReturn", "review")
	return href.pathname + href.search
}
---

<PlaybookLayout
	title={firstPublication ? "Revisar primera opción" : "Revisar y activar opción"}
	playbookId="add-tour-option"
	active
	stepId="review"
	productId={productId}
	variantId={variantId}
	ratePlanId={ratePlanId}
	playbookVertical="tour"
	hideFooter
	lightweight
	productDisplayName={product.name}
>
	<section class="space-y-6">
		<header class="space-y-2">
			<h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
				{firstPublication ? "Revisar primera opción" : "Revisar y activar"}
			</h1>
			<p class="max-w-2xl text-sm leading-6 text-slate-300">
				Comprueba qué verá el viajero y activa la opción cuando todo esté listo.
			</p>
		</header>

		<Card variant="panel" class="fastt-workspace-panel" data-option-review-summary>
			<div class="flex min-w-0 items-start gap-3">
				<span class="fastt-section-icon" aria-hidden="true">
					<ClipboardList class="size-4" />
				</span>
				<div class="min-w-0 flex-1">
					<h2 class="text-lg font-semibold text-slate-950">Resumen de la opción</h2>
					<p class="mt-1 text-sm leading-6 text-slate-600">
						{profile.name} · {rate.name}
					</p>
				</div>
			</div>
			<dl class="mt-5 grid gap-4 border-t border-slate-200 pt-5 sm:grid-cols-2">
				{
					summary.map(([label, value]) => (
						<div class="min-w-0">
							<dt class="text-sm text-slate-500">{label}</dt>
							<dd class="mt-0.5 font-semibold text-slate-950">{value || "Pendiente"}</dd>
						</div>
					))
				}
			</dl>
			<div class="mt-5 flex flex-wrap justify-end gap-2">
				<Button href={optionEditHref("conditions")} variant="secondary" size="sm">
					Revisar condiciones
				</Button>
				<Button href={optionEditHref("calendar")} variant="secondary" size="sm">
					Revisar fechas y cupos
				</Button>
			</div>
		</Card>

		{
			!decision ? (
				<Card variant="soft" class="border border-amber-200/80 bg-amber-50/80">
					<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
						<div class="flex min-w-0 items-start gap-3">
							<span class="fastt-section-icon" aria-hidden="true">
								<AlertTriangle class="size-4" />
							</span>
							<div>
								<p class="font-semibold text-slate-950">No pudimos comprobar la activación</p>
								<p class="mt-1 text-sm leading-6 text-slate-600">
									Reintenta en un momento. Tus datos de la opción siguen guardados.
								</p>
							</div>
						</div>
						<Button href={Astro.url.pathname + Astro.url.search} variant="secondary" size="sm">
							Volver a intentar
						</Button>
					</div>
				</Card>
			) : decision.blockers.length > 0 ? (
				<Card
					variant="soft"
					class="border border-amber-200/80 bg-amber-50/80"
					data-option-activation-blockers
				>
					<div class="flex flex-wrap items-start justify-between gap-4">
						<div class="flex min-w-0 items-start gap-3">
							<span
								class="fastt-section-icon bg-amber-100/90 text-amber-900 shadow-[inset_0_0_0_1px_rgb(251_191_36/0.35)]"
								aria-hidden="true"
							>
								<AlertTriangle class="size-4" />
							</span>
							<div class="min-w-0">
								<h2 class="text-lg font-semibold text-slate-950">Pendientes para activar</h2>
								<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
									Resuelve estos requisitos para habilitar la opción. Tus datos de la opción se
									conservan.
								</p>
							</div>
						</div>
						<Badge variant="warning">
							{decision.blockers.length}{" "}
							{decision.blockers.length === 1 ? "pendiente" : "pendientes"}
						</Badge>
					</div>
					<ul class="mt-5 space-y-3">
						{decision.blockers.map((blocker) => {
							const details = activationBlockerDetails(blocker.reason.message)
							const title = activationBlockerTitle(blocker.id)
							const Icon =
								blocker.id === "provider_authorization"
									? ShieldCheck
									: blocker.id === "experience_authorization"
										? Building2
										: AlertTriangle
							return (
								<li class="fastt-card rounded-xl border border-amber-200/70 bg-white p-4 shadow-sm">
									<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
										<div class="min-w-0 space-y-2.5">
											<div class="flex flex-wrap items-center gap-2">
												<span
													class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-700"
													aria-hidden="true"
												>
													<Icon class="size-4" />
												</span>
												<p class="text-sm font-semibold text-slate-950">{title}</p>
												{blocker.responsible === "fastt" ? (
													<span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold tracking-wide text-slate-600 uppercase">
														Revisión Fastt
													</span>
												) : null}
											</div>
											{details.length > 1 ? (
												<ul class="space-y-1.5 pl-10 text-sm leading-6 text-slate-600">
													{details.map((detail) => (
														<li class="flex gap-2">
															<span class="text-slate-400" aria-hidden="true">
																•
															</span>
															<span>{detail}</span>
														</li>
													))}
												</ul>
											) : (
												<p class="pl-10 text-sm leading-6 text-slate-600">{details[0]}</p>
											)}
										</div>
										<Button
											href={correction(blocker)}
											variant="secondary"
											size="sm"
											class="w-full shrink-0 sm:w-auto"
										>
											{blocker.action.label}
										</Button>
									</div>
								</li>
							)
						})}
					</ul>
				</Card>
			) : (
				<Card
					variant="soft"
					class="border border-emerald-200/80 bg-emerald-50/70"
					data-option-activation-ready
				>
					<div class="flex min-w-0 items-start gap-3">
						<span
							class="fastt-section-icon bg-emerald-100/90 text-emerald-800 shadow-[inset_0_0_0_1px_rgb(16_185_129/0.25)]"
							aria-hidden="true"
						>
							<CircleCheck class="size-4" />
						</span>
						<div class="min-w-0">
							<h2 class="text-lg font-semibold text-slate-950">Listo para activar</h2>
							<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
								{product.status === "published"
									? "El tour ya está publicado. Al activar se habilita esta oferta según su modalidad."
									: "La opción puede activarse. El tour seguirá en borrador hasta que completes su publicación."}
							</p>
						</div>
					</div>
				</Card>
			)
		}

		<footer
			class="fastt-playbook-footer flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
		>
			<p
				id="option-activation-feedback"
				role="status"
				class="min-h-5 text-sm leading-6 text-slate-400 empty:hidden sm:max-w-md"
				data-option-activation-feedback
			>
				{
					Astro.url.searchParams.has("sessionError")
						? "No pudimos guardar la continuación. Tus datos siguen guardados; vuelve a intentar."
						: ""
				}
			</p>
			<div
				class="flex flex-col-reverse gap-3 sm:ml-auto sm:flex-row sm:items-center sm:justify-end"
			>
				<Button
					href={firstPublication
						? `/product/${productId}/preparation-complete`
						: `/product/${productId}/departures`}
					variant="ghost"
					class="w-full text-slate-400 hover:bg-slate-800 hover:text-white sm:w-auto"
				>
					Guardar para después
				</Button>
				{
					firstPublication ? (
						<form
							method="post"
							action="/api/onboarding/tour-option-session"
							class="w-full sm:w-auto"
						>
							<input type="hidden" name="action" value="handoff_to_publication" />
							<input type="hidden" name="sessionId" value={session.id} />
							<Button type="submit" variant="selection" class="fastt-playbook-cta w-full sm:w-auto">
								Continuar a publicación
							</Button>
						</form>
					) : (
						<Button
							id="activate-option"
							disabled={!decision?.allowed}
							variant="selection"
							class="fastt-playbook-cta w-full sm:w-auto"
						>
							Activar opción
						</Button>
					)
				}
			</div>
		</footer>
	</section>
	<script define:vars={{ productId, variantId, ratePlanId, sessionId: session.id }}>
		const button = document.getElementById("activate-option"),
			feedback = document.getElementById("option-activation-feedback")
		button?.addEventListener("click", async () => {
			if (!(button instanceof HTMLButtonElement) || button.disabled) return
			button.disabled = true
			if (feedback) {
				feedback.textContent = "Activando opción…"
				feedback.classList.remove("text-red-300")
				feedback.classList.add("text-slate-400")
			}
			try {
				const response = await fetch("/api/rateplans/activate-guided", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						productId,
						variantId,
						ratePlanId,
						sessionId,
						playbook: "add-tour-option",
					}),
				})
				const body = await response.json()
				if (!response.ok)
					throw new Error(body.error || "No se pudo activar. Revisa los pendientes.")
				if (body.cacheRefreshPending || body.sessionClosePending) {
					if (feedback)
						feedback.textContent =
							"La opción está activada; falta actualizar las vistas. Reintenta para recuperar el resultado."
					button.disabled = false
					button.textContent = "Reintentar actualización"
					return
				}
				location.href = body.terminalHref
			} catch (error) {
				if (feedback) {
					feedback.setAttribute("role", "alert")
					feedback.classList.remove("text-slate-400")
					feedback.classList.add("text-red-300")
					feedback.textContent =
						error instanceof Error
							? error.message
							: "Se perdió la respuesta. Reintenta para recuperar el estado."
				}
				button.disabled = false
			}
		})
	</script>
</PlaybookLayout>
