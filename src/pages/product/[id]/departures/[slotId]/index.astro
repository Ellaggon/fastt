---
import TourSlotProfileEditor from "@/components/tours/TourSlotProfileEditor.astro"
import Card from "@/components/ui/Card.astro"
import { productRepository, variantManagementRepository } from "@/container"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { isTourProductType } from "@/lib/catalog/productVerticalRegistry"
import { resolvePlaybookFromUrl } from "@/lib/playbook/resolve-playbook"
import { routes } from "@/lib/routes"
import { db, eq, first, TourSlotProfile } from "@/shared/infrastructure/db/compat"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
const slotId = String(Astro.params.slotId ?? "")
if (!productId) return Astro.redirect("/product/create")
if (!slotId) return Astro.redirect(routes.productDeparturesForProduct(productId))

const [owned, variant, profile] = await Promise.all([
	productRepository.ensureProductOwnedByProvider(productId, providerId),
	variantManagementRepository.getVariantById(slotId),
	db.select().from(TourSlotProfile).where(eq(TourSlotProfile.variantId, slotId)).then(first),
])
if (!owned) return Astro.redirect("/product/create")
if (!isTourProductType(owned.productType)) return Astro.redirect(routes.productDetail(productId))
if (!variant || variant.productId !== productId) {
	return Astro.redirect(routes.productDeparturesForProduct(productId))
}
if (
	String(variant.kind ?? "")
		.trim()
		.toLowerCase() !== "tour_slot"
) {
	return Astro.redirect(routes.productDeparturesForProduct(productId))
}

const override =
	profile?.meetingPointOverrideJson && typeof profile.meetingPointOverrideJson === "object"
		? String((profile.meetingPointOverrideJson as any).instructions ?? "").trim()
		: ""

const playbook = resolvePlaybookFromUrl(Astro.url, { isHotel: false })
const rawReturnTo = String(Astro.url.searchParams.get("returnTo") ?? "").trim()

function safeConditionsReturn(value: string): string | null {
	if (!value.startsWith("/") || value.startsWith("//") || value.includes("://")) return null
	const target = new URL(value, "http://fastt.local")
	if (!/^\/rates\/plans\/[^/]+$/.test(target.pathname)) return null
	if (target.searchParams.get("productId") !== productId) return null
	if (target.searchParams.get("variantId") !== slotId) return null
	return `${target.pathname}${target.search}`
}

const conditionsReturnHref = playbook.active ? safeConditionsReturn(rawReturnTo) : null
const Layout = playbook.active ? PlaybookLayout : WorkspaceLayout
const layoutProps = playbook.active
	? {
			title: `${owned.name} · Editar salida`,
			playbookId: playbook.playbookId,
			active: true,
			stepId: playbook.stepId ?? "departure",
			productId,
			variantId: slotId,
			ratePlanId: String(Astro.url.searchParams.get("ratePlanId") ?? ""),
			isHotel: false,
			playbookVertical: "tour",
			hideFooter: true,
			lightweight: true,
		}
	: { title: `${owned.name} · Editar salida` }
---

<Layout {...layoutProps}>
	<section class="space-y-6 md:space-y-8">
		<header class="flex flex-col gap-2">
			<h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl md:text-3xl">
				{playbook.active ? "Editar horario y detalles de la salida" : variant.name}
			</h1>
			{
				conditionsReturnHref ? (
					<p class="max-w-2xl text-sm leading-6 text-slate-300">
						Este ajuste conserva tu lugar en la guía. Al guardar volverás a las condiciones de la
						tarifa.
					</p>
				) : null
			}
		</header>

		<TourSlotProfileEditor
			productId={productId}
			variantId={slotId}
			mode="edit"
			name={variant.name}
			description={variant.description}
			departureTime={profile?.departureTime ?? "09:00"}
			durationMinutes={profile?.durationMinutes ?? null}
			maxPax={profile?.maxPax ?? 12}
			languageCode={profile?.languageCode ?? "es"}
			bookingMode={(profile?.bookingMode as "shared" | "private") ?? "shared"}
			meetingPointOverride={override}
			isActive={profile?.isActive ?? variant.salesEnabled}
			redirectOnSuccess={conditionsReturnHref ?? routes.productDeparturesForProduct(productId)}
			submitLabel={conditionsReturnHref ? "Guardar y volver a condiciones" : null}
			cancelHref={conditionsReturnHref}
		/>

		{
			playbook.active ? null : (
				<Card class="space-y-3 bg-white">
					<div>
						<h2 class="text-lg font-semibold text-slate-950">Manifiesto de participantes</h2>
						<p class="text-sm text-slate-600">
							Reservas confirmadas para esta salida. La presentación y el voucher se gestionan desde
							el detalle de cada reserva.
						</p>
					</div>
					<div id="departureManifest" class="divide-y divide-slate-100 text-sm text-slate-700">
						Cargando manifiesto…
					</div>
				</Card>
			)
		}
	</section>
	<script is:inline define:vars={{ slotId }}>
		;(async () => {
			const target = document.getElementById("departureManifest")
			if (!target) return
			try {
				const params = new URLSearchParams({ variantId: slotId, status: "confirmed", limit: "100" })
				const response = await fetch(`/api/internal/provider-bookings-summary?${params}`, {
					headers: { accept: "application/json" },
				})
				const payload = await response.json()
				const items = Array.isArray(payload?.items) ? payload.items : []
				const escapeHtml = (value) =>
					String(value ?? "")
						.replaceAll("&", "&amp;")
						.replaceAll("<", "&lt;")
						.replaceAll(">", "&gt;")
						.replaceAll('"', "&quot;")
				target.innerHTML = items.length
					? items
							.map((item) => {
								const guest = escapeHtml(item.guestName || item.guestEmail || "Participante")
								const state = escapeHtml(
									item.lifecycleLabel || item.operationalStatus || "Pendiente"
								)
								return `<a class="flex items-center justify-between gap-3 px-1 py-3 hover:bg-slate-50" href="/booking/${encodeURIComponent(String(item.bookingId))}"><span>${guest}</span><span class="text-xs text-slate-500">${state}</span></a>`
							})
							.join("")
					: '<p class="py-4 text-slate-500">No hay participantes confirmados para esta salida.</p>'
			} catch {
				target.textContent = "No se pudo cargar el manifiesto."
			}
		})()
	</script>
</Layout>
