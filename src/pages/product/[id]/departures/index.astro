---
import { listOptionSessions, sessionHref } from "@/lib/onboarding/tourOptionSession"
import TourPrerequisiteCard from "@/components/tours/TourPrerequisiteCard.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { routes } from "@/lib/routes"
import { loadTourOptionsWorkspace } from "@/lib/tours/tourOptionsWorkspace"
import { TOUR_SLOT_LANGUAGE_OPTIONS } from "@/lib/tours/tourSlotLanguageOptions"
import { CirclePlay, Ticket } from "@lucide/astro"

function optionBadge(state: string): { label: string; variant: "success" | "warning" | "neutral" } {
	if (state === "available") return { label: "Disponible", variant: "success" }
	if (state === "requests") return { label: "Solicitudes", variant: "success" }
	if (state === "draft") return { label: "Lista", variant: "success" }
	if (state === "disabled") return { label: "Deshabilitada", variant: "neutral" }
	if (state === "unknown") return { label: "Sin comprobar", variant: "warning" }
	return { label: "Pendiente", variant: "warning" }
}

function firstOptionId(
	items: Array<{ id: string; state: string }>,
	match: (state: string) => boolean
) {
	return items.find((row) => match(row.state))?.id ?? null
}
const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")
const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())
const productId = String(Astro.params.id ?? "")
let workspace: Awaited<ReturnType<typeof loadTourOptionsWorkspace>> = null
let failed = false
try {
	workspace = await loadTourOptionsWorkspace({ providerId, productId, request: Astro.request })
} catch {
	failed = true
}
if (!failed && !workspace) return new Response("Tour no encontrado", { status: 404 })
const rows = workspace?.rows ?? []
const created = rows.find((row) => row.id === Astro.url.searchParams.get("created"))
const optionSessions = failed ? [] : await listOptionSessions(providerId, user.id, productId)
const startId = crypto.randomUUID()
const summary = workspace?.summary
const tourImageUrl = workspace?.product.imageUrl ?? null
const optionMetricCardClass =
	"fastt-card block border border-white/10 bg-white/5 p-5 text-white transition-colors hover:bg-white/10"
const optionSummaryMetrics = summary
	? [
			{
				count: summary.attention,
				label: "Por completar o revisar",
				optionId: firstOptionId(
					rows,
					(state) => !["available", "requests", "disabled", "unknown"].includes(state)
				),
			},
			{
				count: summary.available,
				label: summary.available === 1 ? "Disponible para reservar" : "Disponibles para reservar",
				optionId: firstOptionId(rows, (state) => state === "available"),
			},
			{
				count: summary.requests,
				label: "Con solicitudes habilitadas",
				optionId: firstOptionId(rows, (state) => state === "requests"),
			},
			{
				count: summary.disabled,
				label: summary.disabled === 1 ? "Deshabilitada" : "Deshabilitadas",
				optionId: firstOptionId(rows, (state) => state === "disabled"),
			},
			{
				count: summary.unknown,
				label: "Sin comprobar",
				optionId: firstOptionId(rows, (state) => state === "unknown"),
			},
		].filter((metric) => metric.count > 0)
	: []
const optionSummaryStatus =
	!summary || summary.total === 0
		? null
		: summary.attention > 0
			? "Hay opciones por completar o revisar en la lista."
			: summary.unknown > 0
				? "Algunas opciones no se pudieron comprobar. Revisa la lista."
				: summary.disabled === summary.total
					? "Todas las opciones están deshabilitadas."
					: summary.available + summary.requests === summary.total
						? "Todas las opciones están listas para operar."
						: "Revisa el detalle de cada opción en la lista."
---

<WorkspaceLayout title="Opciones y horarios" productType="Tour">
	<section class="space-y-6" data-tour-options>
		<header class="flex flex-col gap-2">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h1 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
					Opciones y horarios
				</h1>
				{
					!failed && rows.length > 0 && (
						<form method="POST" action="/api/onboarding/tour-option-session">
							<>
								<input type="hidden" name="action" value="start" />
								<input type="hidden" name="productId" value={productId} />
								<input type="hidden" name="sessionId" value={startId} />
								<Button type="submit" variant="onDark">
									Añadir opción
								</Button>
							</>
						</form>
					)
				}
			</div>
			<p class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6">
				Una opción define modalidad, idioma, horario y capacidad. Programa sus fechas desde el
				calendario; añade otra opción cuando ofrezcas una alternativa distinta.
			</p>
		</header>
		{
			optionSessions.length > 0 && (
				<section class="space-y-3" aria-label="Configuraciones en curso">
					<ul class="space-y-3">
						{optionSessions.map((session) => {
							const optionName =
								rows.find((row) => row.id === session.variantId)?.name || "Nueva opción"
							return (
								<li class="fastt-card flex flex-wrap items-center justify-between gap-3 border border-white/10 bg-white/5 px-4 py-3 text-sm transition-colors hover:bg-white/10">
									<span class="flex min-w-0 items-start gap-3">
										<CirclePlay class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" aria-hidden="true" />
										<span class="min-w-0">
											<span class="block font-semibold text-white">{optionName}</span>
											<span class="mt-0.5 block text-slate-400">Retoma donde la dejaste</span>
										</span>
									</span>
									<span class="flex shrink-0 items-center gap-4 self-center">
										<a
											href={sessionHref(session)}
											class="inline-flex items-center text-sm font-semibold text-white hover:underline"
										>
											Continuar configuración
										</a>
										<Button
											type="button"
											variant="ghost"
											data-abandon-option-session={session.id}
											className="inline-flex min-h-11 items-center px-0 text-sm font-semibold text-slate-400 transition-colors hover:bg-transparent hover:text-white"
										>
											Descartar recorrido
										</Button>
									</span>
								</li>
							)
						})}
					</ul>
					<p data-option-session-feedback role="status" class="text-sm text-slate-400" />
				</section>
			)
		}

		{
			created && (
				<Card class="bg-emerald-50 text-emerald-900">
					<p>
						Opción creada.{" "}
						<a class="font-semibold underline" href={`#option-${created.id}`}>
							Revisar {created.name}
						</a>
					</p>
				</Card>
			)
		}
		{
			failed ? (
				<Card class="bg-white">
					<>
						<h2 class="font-semibold">No se pudieron comprobar las opciones</h2>
						<p class="mt-2 text-sm text-slate-600">No se han modificado tus datos.</p>
						<Button class="mt-4" href={Astro.url.pathname + Astro.url.search}>
							Reintentar
						</Button>
					</>
				</Card>
			) : rows.length === 0 ? (
				<TourPrerequisiteCard
					title="Primero crea una opción"
					lead="Necesitas una opción para configurar su precio y sus fechas."
				>
					<form method="POST" action="/api/onboarding/tour-option-session">
						<input type="hidden" name="action" value="start" />
						<input type="hidden" name="productId" value={productId} />
						<input type="hidden" name="sessionId" value={startId} />
						<Button type="submit" variant="selection" className="fastt-playbook-cta">
							Crear opción
						</Button>
					</form>
				</TourPrerequisiteCard>
			) : (
				<>
					<section class="space-y-3" aria-labelledby="option-summary-title" aria-live="polite">
						<div>
							<h2 id="option-summary-title" class="text-lg font-semibold text-white">
								Resumen
							</h2>
							<p class="mt-1 text-sm text-slate-400">
								{summary?.total ?? 0} {(summary?.total ?? 0) === 1 ? "opción" : "opciones"} en este
								tour
							</p>
						</div>
						{optionSummaryMetrics.length > 0 && (
							<div
								class:list={[
									"grid gap-3",
									optionSummaryMetrics.length === 1 ? "sm:grid-cols-1" : "sm:grid-cols-2",
								]}
							>
								{optionSummaryMetrics.map((metric) => {
									const content = (
										<>
											<p class="text-sm text-slate-400">{metric.label}</p>
											<p class="mt-2 text-2xl font-semibold text-white tabular-nums">
												{metric.count}
											</p>
										</>
									)
									return metric.optionId ? (
										<a href={`#option-${metric.optionId}`} class={optionMetricCardClass}>
											{content}
										</a>
									) : (
										<div class={optionMetricCardClass}>{content}</div>
									)
								})}
							</div>
						)}
						{optionSummaryStatus && <p class="text-sm text-slate-400">{optionSummaryStatus}</p>}
					</section>
					<ul id="opciones-del-tour" class="space-y-3" aria-label="Opciones del tour">
						{rows.map((row) => {
							const badge = optionBadge(row.state)
							const editHref = `${routes.productDepartureDetail(productId, row.id)}?returnTo=${encodeURIComponent(`${routes.productDeparturesForProduct(productId)}#option-${row.id}`)}`
							const meta = [
								row.departureTime ?? "Horario pendiente",
								TOUR_SLOT_LANGUAGE_OPTIONS.find((lang) => lang.code === row.languageCode)?.label ??
									"Idioma pendiente",
								row.bookingMode === "private"
									? "Privada"
									: row.bookingMode === "shared"
										? "Compartida"
										: "Modalidad pendiente",
								row.maxPax ? `Hasta ${row.maxPax} participantes` : "Capacidad pendiente",
							].join(" · ")
							const support = [
								row.detail,
								row.nextAvailableDate
									? `Próxima fecha con cupo: ${new Intl.DateTimeFormat("es", {
											dateStyle: "medium",
											timeZone: "UTC",
										}).format(new Date(`${row.nextAvailableDate}T12:00:00Z`))}`
									: "",
							]
								.filter(Boolean)
								.join(" ")
							const moreActions = [
								...(!["Editar opción", "Completar opción"].includes(row.primary.label)
									? [{ href: editHref, label: "Editar opción" }]
									: []),
								{ href: row.links.conditionsHref, label: "Precios y condiciones" },
								...(row.bookingMode === "shared"
									? [{ href: `${row.links.calendarHref}&schedule=1`, label: "Programar salidas" }]
									: []),
								...(row.primary.label !== "Gestionar fechas y cupos"
									? [{ href: row.links.calendarHref, label: "Fechas y cupos" }]
									: []),
								...row.rates.map((rate) => ({
									href: rate.action.href,
									label: `${rate.action.label} · ${rate.name}`,
								})),
							]
							return (
								<li id={`option-${row.id}`} class="scroll-mt-24" data-option-id={row.id}>
									<Card variant="row" class="bg-white p-4 sm:p-5">
										<div class="flex flex-wrap items-start gap-4">
											<div
												class="flex h-20 w-24 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-slate-100 sm:h-24 sm:w-32"
												aria-hidden="true"
											>
												{tourImageUrl ? (
													<img
														src={tourImageUrl}
														alt=""
														loading="lazy"
														decoding="async"
														class="h-full w-full object-cover"
													/>
												) : (
													<Ticket class="size-7 text-slate-300" />
												)}
											</div>
											<div class="min-w-0 flex-1 basis-40 space-y-2">
												<div class="flex flex-wrap items-center gap-2">
													<h2 class="min-w-0 text-base font-semibold break-words text-slate-950">
														{row.name}
													</h2>
													<Badge variant={badge.variant}>{badge.label}</Badge>
												</div>
												<p class="flex min-h-11 items-center text-xs text-slate-500">{meta}</p>
												<p class="text-sm font-medium text-slate-800">{row.label}</p>
												{support && (
													<p class="max-w-2xl text-sm leading-6 text-slate-600">{support}</p>
												)}
											</div>
											<div class="flex shrink-0 basis-full flex-wrap items-center gap-2 sm:basis-auto sm:flex-col sm:items-end">
												<Button href={row.primary.href} variant="selection" size="sm">
													{row.primary.label}
												</Button>
												<details class="group relative">
													<summary class="cursor-pointer rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2">
														Más acciones
														<span class="sr-only"> de {row.name}</span>
													</summary>
													<nav
														aria-label={`Acciones de ${row.name}`}
														class="fastt-soft-box absolute right-0 z-10 mt-1 w-56 bg-white p-1.5 shadow-lg"
													>
														<form method="POST" action="/api/onboarding/tour-option-session">
															<input type="hidden" name="action" value="start" />
															<input type="hidden" name="productId" value={productId} />
															<input type="hidden" name="sessionId" value={crypto.randomUUID()} />
															<input type="hidden" name="sourceVariantId" value={row.id} />
															<Button
																type="submit"
																variant="ghost"
																className="h-auto w-full justify-start rounded-lg px-3 py-2.5 text-left text-sm font-normal text-slate-700 hover:bg-slate-100"
															>
																Añadir horario<span class="sr-only"> de {row.name}</span>
															</Button>
														</form>
														{moreActions.map(({ href, label }) => (
															<a
																href={href}
																class="block rounded-lg px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-100 focus-visible:bg-slate-100 focus-visible:outline-none"
															>
																{label}
															</a>
														))}
													</nav>
												</details>
											</div>
										</div>
									</Card>
								</li>
							)
						})}
					</ul>
				</>
			)
		}
		<a
			href={routes.productDetail(productId)}
			class="inline-flex min-h-11 items-center text-sm font-semibold text-slate-300"
			>← Volver al tour</a
		>
	</section>
</WorkspaceLayout>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>(
		"[data-abandon-option-session]"
	))
		button.addEventListener("click", async () => {
			if (!confirm("¿Descartar este recorrido? La opción guardada se conserva.")) return
			button.disabled = true
			try {
				const response = await fetch("/api/onboarding/tour-option-session", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						action: "abandon",
						sessionId: button.dataset.abandonOptionSession,
					}),
				})
				if (!response.ok) throw new Error("No se pudo descartar el recorrido.")
				location.reload()
			} catch (error) {
				button.disabled = false
				const target = document.querySelector("[data-option-session-feedback]")
				if (target) target.textContent = error instanceof Error ? error.message : "Reintenta."
			}
		})

	function bindOptionMenus() {
		const root = document.querySelector<HTMLElement>("[data-tour-options]")
		if (!root || root.dataset.menusBound) return
		root.dataset.menusBound = "true"
		root.addEventListener(
			"toggle",
			(event) => {
				const menu = event.target
				if (!(menu instanceof HTMLDetailsElement) || !menu.open) return
				root.querySelectorAll<HTMLDetailsElement>("details[open]").forEach((other) => {
					if (other !== menu) other.open = false
				})
			},
			true
		)
		root.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return
			const menu = (event.target as HTMLElement).closest("details")
			if (menu) {
				menu.open = false
				menu.querySelector("summary")?.focus()
			}
		})
		document.addEventListener(
			"click",
			(event) => {
				root.querySelectorAll<HTMLDetailsElement>("details[open]").forEach((menu) => {
					if (!menu.contains(event.target as Node)) menu.open = false
				})
			},
			{
				signal: (() => {
					const controller = new AbortController()
					document.addEventListener("astro:before-swap", () => controller.abort(), { once: true })
					return controller.signal
				})(),
			}
		)
	}
	bindOptionMenus()
	document.addEventListener("astro:page-load", bindOptionMenus)
</script>
