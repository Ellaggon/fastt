---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import { productRepository } from "@/container"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { isTourProductType } from "@/lib/productVerticalRegistry"
import { routes } from "@/lib/routes"
import { getProductAggregate } from "@/modules/catalog/public"
import {
	and,
	asc,
	db,
	eq,
	TourSlotProfile,
	Variant,
	VariantCapacity,
} from "@/shared/infrastructure/db/compat"
import { Plus } from "@lucide/astro"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request, user)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
if (!productId) return Astro.redirect("/product/create")

const owned = await productRepository.ensureProductOwnedByProvider(productId, providerId)
if (!owned) return Astro.redirect("/product/create")
if (!isTourProductType(owned.productType)) return Astro.redirect(routes.productDetail(productId))

const product = await getProductAggregate(productId)
if (!product) return Astro.redirect("/product/create")

const rows = await db
	.select({
		id: Variant.id,
		name: Variant.name,
		status: Variant.status,
		isActive: Variant.isActive,
		departureTime: TourSlotProfile.departureTime,
		durationMinutes: TourSlotProfile.durationMinutes,
		maxPax: TourSlotProfile.maxPax,
		languageCode: TourSlotProfile.languageCode,
		bookingMode: TourSlotProfile.bookingMode,
		profileActive: TourSlotProfile.isActive,
		capacityMax: VariantCapacity.maxOccupancy,
	})
	.from(Variant)
	.leftJoin(TourSlotProfile, eq(TourSlotProfile.variantId, Variant.id))
	.leftJoin(VariantCapacity, eq(VariantCapacity.variantId, Variant.id))
	.where(and(eq(Variant.productId, productId), eq(Variant.kind, "tour_slot")))
	.orderBy(asc(TourSlotProfile.departureTime), asc(Variant.name))

const createdId = String(Astro.url.searchParams.get("created") ?? "").trim()
---

<WorkspaceLayout title={`${product.displayName} · Salidas`}>
	<section class="space-y-6 md:space-y-8">
		<header class="flex flex-col gap-2">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl md:text-3xl">
					Salidas del tour
				</h1>
				<div class="flex flex-wrap gap-2">
					<Button href={`/product/${productId}/private-requests`} variant="secondary" class="shrink-0">
						Solicitudes privadas
					</Button>
					<Button href={routes.productDepartureNew(productId)} class="shrink-0">
						<span class="inline-flex items-center gap-2">
							<Plus class="h-4 w-4" />
							Nueva salida
						</span>
					</Button>
				</div>
			</div>
			<p class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6">
				Cada salida es un horario con cupo propio. Crea al menos dos salidas con horas distintas
				para vender opciones.
			</p>
		</header>

		{
			createdId ? (
				<Card class="border-emerald-200 bg-emerald-50 text-emerald-900">
					<p class="text-sm font-semibold">Salida creada</p>
					<p class="mt-1 text-sm">Ya puedes asignar tarifas y abrir el calendario.</p>
				</Card>
			) : null
		}

		{
			rows.length === 0 ? (
				<Card class="bg-white">
					<p class="text-sm font-semibold text-slate-950">Sin salidas todavía</p>
					<p class="mt-2 text-sm text-slate-600">
						Crea la primera salida con hora, idioma y máximo de participantes.
					</p>
					<div class="mt-4">
						<Button href={routes.productDepartureNew(productId)}>Crear primera salida</Button>
					</div>
				</Card>
			) : (
				<ul class="grid gap-3">
					{rows.map((row) => {
						const time = String(row.departureTime ?? "—")
						const pax = Number(row.maxPax ?? row.capacityMax ?? 0) || null
						const mode = row.bookingMode === "private" ? "Privado" : "Compartido"
						const lang = String(row.languageCode ?? "—").toUpperCase()
						return (
							<li>
								<Card class="bg-white">
									<div class="flex flex-wrap items-start justify-between gap-3">
										<div>
											<p class="text-base font-semibold text-slate-950">{row.name}</p>
											<p class="mt-1 text-sm text-slate-600">
												{time} · {pax ? `${pax} participantes` : "Cupo pendiente"} · {lang} · {mode}
											</p>
											{!row.departureTime ? (
												<p class="mt-1 text-xs font-semibold text-amber-700">
													Falta completar el perfil de salida
												</p>
											) : null}
										</div>
										<div class="flex flex-wrap gap-2">
											<Button
												href={routes.productDepartureDetail(productId, row.id)}
												variant="secondary"
											>
												Editar
											</Button>
											<Button href={routes.rates()} variant="secondary">
												Tarifas
											</Button>
											<Button href={routes.calendar()} variant="secondary">
												Calendario
											</Button>
										</div>
									</div>
								</Card>
							</li>
						)
					})}
				</ul>
			)
		}

		<div class="pt-2">
			<a
				href={routes.productDetail(productId)}
				class="text-sm font-semibold text-slate-700 hover:text-slate-950"
			>
				← Volver a la ficha
			</a>
		</div>
	</section>
</WorkspaceLayout>
