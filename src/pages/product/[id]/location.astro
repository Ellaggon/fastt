---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import PlaybookStepHeader from "@/components/playbook/PlaybookStepHeader.astro"
import PlaybookLayout from "@/layouts/PlaybookLayout.astro"
import {
	buildCompleteToPublishHref,
	getCompleteToPublishPlaybookRepairHref,
} from "@/lib/playbook/complete-to-publish"
import { buildPlaybookHref } from "@/lib/playbook/launch-accommodation"
import { resolvePlaybookFromUrl } from "@/lib/playbook/resolve-playbook"
import { playbookRedirectHrefFor } from "@/lib/playbook/playbook-nav"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getProductVerticalEntry } from "@/lib/catalog/productVerticalRegistry"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import { routes } from "@/lib/routes"
import { getProductFullAggregate, isGeoPlaceCompatible } from "@/modules/catalog/public"
import { asc, db, eq, GeoPlace } from "@/shared/infrastructure/db/compat"
import "leaflet/dist/leaflet.css"

const user = await getUserFromRequest(Astro.request)
if (!user) return Astro.redirect("/SignInPage")

const providerId = (await getProviderIdFromRequest(Astro.request)) ?? ""
if (!providerId) return Astro.redirect(routes.providerSettingsProfile())

const productId = String(Astro.params.id ?? "")
if (!productId) return Astro.redirect("/product/create")
const flow = Astro.url.searchParams.get("flow")
if (!resolvePlaybookFromUrl(Astro.url).active && flow === "create") {
	return Astro.redirect(buildPlaybookHref(`/product/${productId}/location`, "location"))
}
if (!resolvePlaybookFromUrl(Astro.url).active && flow === "complete") {
	return Astro.redirect(buildCompleteToPublishHref(`/product/${productId}/location`, "location"))
}

const product = await getProductFullAggregate(productId, providerId)
if (!product) return Astro.redirect("/product/create")

const vertical = getProductVerticalEntry(product.productType)
const isHotel = vertical.vertical === "hotel"
const isTour = vertical.vertical === "tour"
const playbookRepair = getCompleteToPublishPlaybookRepairHref(Astro.url, { isTour, productId })
if (playbookRepair) return Astro.redirect(playbookRepair)
const playbook = resolvePlaybookFromUrl(Astro.url, { isHotel })
const existingLocation = product.location
const geoPlaces = await db
	.select({
		id: GeoPlace.id,
		name: GeoPlace.canonicalName,
		country: GeoPlace.countryCode,
		placeType: GeoPlace.placeType,
	})
	.from(GeoPlace)
	.where(eq(GeoPlace.status, "active"))
	.orderBy(asc(GeoPlace.canonicalName))
const compatibleGeoPlaces = geoPlaces.filter((place) =>
	isGeoPlaceCompatible({ productType: product.productType, placeType: place.placeType })
)

const initialLat = typeof existingLocation?.lat === "number" ? existingLocation.lat : -16.495905
const initialLng = typeof existingLocation?.lng === "number" ? existingLocation.lng : -68.133623
const tourMeetingPoint =
	isTour && product.subtype?.kind === "tour" ? product.subtype.meetingPoint : null
const meetingAddress =
	tourMeetingPoint && typeof tourMeetingPoint === "object"
		? String((tourMeetingPoint as Record<string, unknown>).address ?? "").trim()
		: ""
const meetingInstructions =
	tourMeetingPoint && typeof tourMeetingPoint === "object"
		? String((tourMeetingPoint as Record<string, unknown>).instructions ?? "").trim()
		: ""
const meetingPath = `/product/${encodeURIComponent(productId)}/subtype#tour-meeting-point`
const meetingHref =
	playbook.playbookId === "complete-to-publish"
		? buildCompleteToPublishHref(meetingPath, "subtype")
		: playbook.playbookId === "launch-tour"
			? `${meetingPath.split("#")[0]}?playbook=launch-tour&step=subtype&flow=create#tour-meeting-point`
			: meetingPath
const tourPlaybookGuided = isTour && playbook.active
const tourLocationPanelClass = "space-y-5 bg-white"
---

<PlaybookLayout
	title={`${vertical.labels.workspacePlural} · Ubicación`}
	playbookId={playbook.playbookId}
	active={playbook.active}
	stepId={playbook.stepId ?? "location"}
	productId={productId}
	isHotel={isHotel}
	playbookVertical={vertical.vertical}
	continueFormId={playbook.active ? "locationForm" : null}
>
	<section class:list={[tourPlaybookGuided ? "space-y-6" : "space-y-8"]}>
		<section
			class:list={[
				tourPlaybookGuided ? "space-y-6" : "space-y-4",
				playbook.active && !tourPlaybookGuided && "space-y-6",
			]}
		>
			{
				playbook.active ? (
					<PlaybookStepHeader
						icon={isTour ? "location" : "geo"}
						title={isTour ? "Destino y encuentro" : "Metadata geográfica"}
						lead={
							isTour
								? "Selecciona el destino que organiza las búsquedas y ubica el área general en el mapa. Esto no cambia el punto exacto donde el viajero se reúne con el guía."
								: `Define ubicación, coordenadas y contexto geográfico de ${vertical.labels.singular}.`
						}
					/>
				) : null
			}
			{
				tourPlaybookGuided ? (
					<form
						id="locationForm"
						method="POST"
						action="/api/product/location"
						class="w-full max-w-5xl space-y-5"
					>
						<Input type="hidden" name="productId" value={productId} />
						<Input
							type="hidden"
							name="flow"
							value={flow === "create" ? "create" : flow === "complete" ? "complete" : "edit"}
						/>
						{playbook.playbookId ? (
							<Input type="hidden" name="playbook" value={playbook.playbookId} />
						) : null}
						<Input id="lat" type="hidden" name="lat" value={String(initialLat)} />
						<Input id="lng" type="hidden" name="lng" value={String(initialLng)} />

						<Card class={tourLocationPanelClass}>
							<fieldset class="space-y-4 border-0 p-0">
								<legend class="sr-only">Destino en búsquedas</legend>
								<div class="space-y-1">
									<h2 class="text-base font-semibold text-slate-950">Destino en búsquedas</h2>
									<p class="text-sm leading-6 text-slate-500">
										Elige la ciudad o zona del catálogo y, si quieres, una referencia visible. El
										punto exacto donde empieza el tour se define en el paso de itinerario.
									</p>
								</div>
								<FormField label="Referencia de zona (opcional)" htmlFor="address">
									<Input
										id="address"
										name="address"
										value={existingLocation?.address ?? ""}
										placeholder="Ej: Centro histórico, La Paz"
									/>
									<p class="mt-2 text-sm leading-6 text-slate-500">
										Texto libre para orientar al viajero; no reemplaza la ciudad del catálogo.
									</p>
								</FormField>
								<FormField label="Ciudad o zona del catálogo" htmlFor="geoPlaceId" required>
									<Select id="geoPlaceId" name="geoPlaceId" required>
										<option value="" disabled selected={!product.geoPlace}>
											Selecciona una ciudad, localidad o zona compatible
										</option>
										{compatibleGeoPlaces.map((place) => (
											<option value={place.id} selected={place.id === product.geoPlace?.id}>
												{place.name} · {place.country} · {place.placeType}
											</option>
										))}
									</Select>
									<p class="mt-2 text-sm leading-6 text-slate-500">
										Ubicación para discovery: organiza publicación y resultados de búsqueda.
									</p>
								</FormField>
							</fieldset>
						</Card>

						<Card class={tourLocationPanelClass}>
							<fieldset class="space-y-4 border-0 p-0">
								<legend class="sr-only">Ubicación en el mapa</legend>
								<div class="space-y-1">
									<h2 class="text-base font-semibold text-slate-950">Ubicación en el mapa</h2>
									<p class="text-sm leading-6 text-slate-500">
										Marca el área general del tour. Ajusta el pin con clic o con las flechas del
										teclado cuando el mapa esté enfocado.
									</p>
								</div>
								<FormField label="Coordenadas del área" htmlFor="map" required>
									<div
										id="map"
										class="h-64 w-full overflow-hidden rounded-[var(--fastt-radius-card)] border border-slate-200 sm:h-72"
										data-lat={initialLat}
										data-lng={initialLng}
										tabindex="0"
										aria-label="Mapa para elegir la ubicación de discovery del tour"
										aria-describedby="coordsText"
									/>
									<p
										id="coordsText"
										class="mt-2 text-sm leading-6 text-slate-500 tabular-nums"
										aria-live="polite"
									/>
								</FormField>
							</fieldset>
						</Card>

						<Card class={tourLocationPanelClass}>
							<fieldset class="space-y-4 border-0 p-0" aria-labelledby="meetingPointHeading">
								<legend class="sr-only">Punto de encuentro</legend>
								<div class="flex flex-wrap items-start justify-between gap-3">
									<div class="min-w-0 space-y-1">
										<h2 id="meetingPointHeading" class="text-base font-semibold text-slate-950">
											Punto de encuentro
										</h2>
										<p class="max-w-xl text-sm leading-6 text-slate-500">
											Lugar exacto donde el viajero se reúne con el guía. No es la ubicación de
											discovery del catálogo.
										</p>
									</div>
									<Button href={meetingHref} variant="secondary" size="sm" class="shrink-0">
										{meetingAddress ? "Editar punto de encuentro" : "Definir punto de encuentro"}
									</Button>
								</div>
								<div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm">
									<p class="font-medium text-slate-900">
										{meetingAddress || "Todavía no se definió el punto exacto."}
									</p>
									{meetingInstructions ? (
										<p class="mt-1.5 leading-6 text-slate-600">{meetingInstructions}</p>
									) : null}
								</div>
							</fieldset>
						</Card>

						<p id="stateLabel" class="sr-only" role="status" aria-live="polite" />
						<p id="stateDetail" class="hidden text-sm whitespace-pre-wrap text-slate-400" />
					</form>
				) : (
					<Card
						class:list={[
							playbook.active
								? "border border-slate-200 bg-white p-5 md:p-6"
								: "rounded-lg border-slate-200 bg-slate-100 shadow-none",
						]}
					>
						<form
							id="locationForm"
							method="POST"
							action="/api/product/location"
							class="max-w-3xl space-y-6"
						>
							<Input type="hidden" name="productId" value={productId} />
							<Input
								type="hidden"
								name="flow"
								value={flow === "create" ? "create" : flow === "complete" ? "complete" : "edit"}
							/>
							{playbook.active && playbook.playbookId ? (
								<Input type="hidden" name="playbook" value={playbook.playbookId} />
							) : null}
							{playbook.active && playbook.playbookId === "complete-to-publish" ? (
								<>
									<Input type="hidden" name="playbookCurrentStep" value="location" />
									<Input type="hidden" name="playbookVertical" value={vertical.vertical} />
								</>
							) : null}
							<Input id="lat" type="hidden" name="lat" value={String(initialLat)} />
							<Input id="lng" type="hidden" name="lng" value={String(initialLng)} />

							{!playbook.active ? (
								<header class="space-y-1.5">
									<h2 class="text-xl font-semibold text-slate-900">
										{isTour ? "Destino y zona pública" : "Metadata geográfica"}
									</h2>
									<p class="text-sm leading-6 text-slate-600">
										{isTour
											? "Selecciona el destino que organiza las búsquedas y ubica el área general en el mapa. Esto no cambia el punto exacto donde el viajero se reúne con el guía."
											: `Define ubicación, coordenadas y contexto geográfico de ${vertical.labels.singular}.`}
									</p>
								</header>
							) : null}

							<div class="grid gap-4 sm:gap-5">
								<FormField
									label={isTour ? "Zona o dirección (opcional)" : "Dirección (opcional)"}
									htmlFor="address"
								>
									<Input
										id="address"
										name="address"
										value={existingLocation?.address ?? ""}
										placeholder={isTour ? "Ej: Centro histórico, La Paz" : "Av. Ejemplo 123"}
									/>
								</FormField>

								<FormField
									label={isTour ? "Ubicación para discovery" : "Ubicación de discovery"}
									htmlFor="geoPlaceId"
									required
									description={
										isTour
											? "Esta ubicación organiza la publicación y las búsquedas. Ajusta el área general en el mapa."
											: "Selecciona la ciudad o zona compatible con este alojamiento."
									}
								>
									<Select id="geoPlaceId" name="geoPlaceId" required>
										<option value="" disabled selected={!product.geoPlace}>
											Selecciona una ciudad, localidad o zona compatible
										</option>
										{compatibleGeoPlaces.map((place) => (
											<option value={place.id} selected={place.id === product.geoPlace?.id}>
												{place.name} · {place.country} · {place.placeType}
											</option>
										))}
									</Select>
								</FormField>
							</div>

							<section class="space-y-3 border-t border-slate-100 pt-6">
								<FormField
									label={isTour ? "Área en el mapa" : "Ubicación de la oferta"}
									htmlFor="map"
									required
									description="Haz clic en el mapa o, con el mapa enfocado, usa las flechas del teclado para ajustar el punto."
								>
									<div
										id="map"
										class="h-64 w-full overflow-hidden rounded-[var(--fastt-radius-card)] border border-slate-200 sm:h-72"
										data-lat={initialLat}
										data-lng={initialLng}
										tabindex="0"
										aria-label={
											isTour
												? "Mapa para elegir la ubicación de discovery del tour"
												: "Mapa para elegir la ubicación de la oferta"
										}
										aria-describedby="coordsText"
									/>
									<p
										id="coordsText"
										class="fastt-soft-box mt-3 border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 tabular-nums"
										aria-live="polite"
									/>
								</FormField>
							</section>

							{isTour ? (
								<section
									class="space-y-3 border-t border-slate-100 pt-6"
									aria-labelledby="meetingPointHeading"
								>
									<div class="flex flex-wrap items-start justify-between gap-3">
										<div class="max-w-xl min-w-0 space-y-1">
											<h3 id="meetingPointHeading" class="text-base font-semibold text-slate-950">
												Punto de encuentro operativo
											</h3>
											<p class="text-sm leading-6 text-slate-600">
												Se muestra al viajero para encontrar al guía. Es independiente del destino y
												de la zona pública elegidos arriba.
											</p>
										</div>
										<Button href={meetingHref} variant="secondary" size="sm" class="shrink-0">
											{meetingAddress ? "Editar punto de encuentro" : "Definir punto de encuentro"}
										</Button>
									</div>
									<div class="fastt-soft-box border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
										<p class="font-medium text-slate-900">
											{meetingAddress || "Todavía no se definió el punto exacto."}
										</p>
										{meetingInstructions ? (
											<p class="mt-1.5 leading-6 text-slate-600">{meetingInstructions}</p>
										) : null}
									</div>
								</section>
							) : null}

							<div
								class:list={[
									"space-y-4",
									playbook.active ? "hidden" : "border-t border-slate-200 pt-8",
								]}
							>
								<p id="stateLabel" class="text-sm text-slate-600" aria-live="polite">
									Vacío: sin cambios guardados.
								</p>
								<p id="stateDetail" class="text-sm whitespace-pre-wrap text-slate-600" />

								<div
									class:list={[
										"flex items-center justify-end gap-3 pt-2",
										playbook.active ? "hidden" : "",
									]}
								>
									<Button
										href={
											playbook.active && playbook.playbookId
												? playbook.playbookId === "complete-to-publish"
													? buildCompleteToPublishHref(
															`/product/${encodeURIComponent(productId)}/images`,
															"photos"
														)
													: playbookRedirectHrefFor(
															playbook.playbookId,
															`/product/${encodeURIComponent(productId)}/content`,
															"content"
														)
												: `/product/${encodeURIComponent(productId)}/content`
										}
										variant="secondary"
									>
										Volver
									</Button>
									<Button
										id="submitBtn"
										type="submit"
										variant="selection"
										className="fastt-playbook-cta"
									>
										{isTour && playbook.playbookId === "complete-to-publish"
											? "Guardar y volver"
											: playbook.active
												? "Guardar y continuar"
												: "Guardar ubicación"}
									</Button>
								</div>
							</div>
						</form>
					</Card>
				)
			}
		</section>
	</section>

	<script>
		import L from "leaflet"
		import { bindPlaybookFormDraft } from "@/lib/forms/playbookFormDraft.ts"
		import { setPlaybookSubmitBusy } from "@/lib/forms/playbookFormBusy.ts"
		import {
			readPlaybookNavIntent,
			resolvePlaybookRedirectAfterSave,
		} from "@/lib/playbook/playbook-nav.ts"

		type LocationState = "empty" | "loading" | "success" | "error" | "disabled"

		function setState(state: LocationState, detail = "") {
			const stateLabel = document.getElementById("stateLabel")
			const stateDetail = document.getElementById("stateDetail")
			if (!stateLabel || !stateDetail) return
			const labels: Record<LocationState, string> = {
				empty: "Vacío: sin cambios guardados.",
				loading: "Cargando: guardando ubicación...",
				success: "Éxito: ubicación guardada correctamente.",
				error: "Error: no se pudo guardar la ubicación.",
				disabled: "Deshabilitado: esperando respuesta del servidor.",
			}
			stateLabel.textContent = labels[state] || labels.empty
			stateDetail.textContent = detail
		}

		function updateCoords(lat: number, lng: number) {
			const latInput = document.getElementById("lat")
			const lngInput = document.getElementById("lng")
			const coordsText = document.getElementById("coordsText")
			if (!(latInput instanceof HTMLInputElement) || !(lngInput instanceof HTMLInputElement)) return
			latInput.value = String(lat)
			lngInput.value = String(lng)
			if (coordsText) {
				coordsText.textContent = `Coordenadas seleccionadas: ${Number(lat).toFixed(6)}, ${Number(lng).toFixed(6)}`
			}
		}

		function initLocationMap() {
			const mapElement = document.getElementById("map")
			const form = document.getElementById("locationForm")
			if (!mapElement || !(form instanceof HTMLFormElement)) {
				return
			}

			if (mapElement.dataset.ready === "true") return
			mapElement.dataset.ready = "true"
			const draft = bindPlaybookFormDraft(form, {
				key: `product:${window.location.pathname}:location`,
			})

			const initialLat = Number(mapElement.dataset.lat || "-16.495905")
			const initialLng = Number(mapElement.dataset.lng || "-68.133623")
			const map = L.map(mapElement).setView([initialLat, initialLng], 12)

			L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
				maxZoom: 19,
				attribution: "&copy; OpenStreetMap",
			}).addTo(map)

			const marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map)
			updateCoords(initialLat, initialLng)

			window.setTimeout(() => map.invalidateSize(), 80)

			map.on("click", (event) => {
				const { lat, lng } = event.latlng
				marker.setLatLng([lat, lng])
				updateCoords(lat, lng)
			})

			marker.on("dragend", () => {
				const { lat, lng } = marker.getLatLng()
				updateCoords(lat, lng)
			})

			mapElement.addEventListener("keydown", (event) => {
				const offsets: Record<string, [number, number]> = {
					ArrowUp: [0.001, 0],
					ArrowDown: [-0.001, 0],
					ArrowLeft: [0, -0.001],
					ArrowRight: [0, 0.001],
				}
				const offset = offsets[event.key]
				if (!offset) return
				event.preventDefault()
				const current = marker.getLatLng()
				const next: [number, number] = [current.lat + offset[0], current.lng + offset[1]]
				marker.setLatLng(next)
				map.panTo(next)
				updateCoords(next[0], next[1])
			})

			form.addEventListener("submit", async (e) => {
				e.preventDefault()
				const fd = new FormData(form)
				const intent = readPlaybookNavIntent(fd, e.submitter)
				const targetProductId = String(fd.get("productId") || "")
				if (intent === "exit" && !String(fd.get("geoPlaceId") || "").trim()) {
					window.location.href = resolvePlaybookRedirectAfterSave(fd, {
						productId: targetProductId,
						currentStep: "location",
						launchPath: `/product/${encodeURIComponent(targetProductId)}/images`,
						launchStep: "images",
						intent: "exit",
					})
					return
				}
				setState("loading")
				setPlaybookSubmitBusy(form, true)
				setState("disabled")

				try {
					const res = await fetch("/api/product/location", { method: "POST", body: fd })
					const txt = await res.text()

					if (!res.ok) {
						setPlaybookSubmitBusy(form, false)
						setState("error", `status=${res.status}\n${txt}`)
						return
					}

					setState("success", "Guardado correctamente")
					draft.clear()
					window.location.href = resolvePlaybookRedirectAfterSave(fd, {
						productId: targetProductId,
						currentStep: "location",
						launchPath: `/product/${encodeURIComponent(targetProductId)}/images`,
						launchStep: "images",
						submitter: e.submitter,
					})
				} catch (err) {
					setPlaybookSubmitBusy(form, false)
					setState("error", `Error de red: ${String(err)}`)
				}
			})
		}

		initLocationMap()
		document.addEventListener("astro:page-load", initLocationMap)
	</script>
</PlaybookLayout>
