---
import DegradedServiceLayout from "@/layouts/DegradedServiceLayout.astro"
import { sanitizeReturnTo } from "@/lib/auth/returnTo"
import { DATABASE_CONNECTIVITY_PUBLIC_MESSAGE } from "@/shared/infrastructure/db/connectivity-error"

Astro.response.status = 503
Astro.response.headers.set("Retry-After", "5")
Astro.response.headers.set("Cache-Control", "no-store")

const retryHref = sanitizeReturnTo(Astro.url.searchParams.get("next"), "/")
---

<DegradedServiceLayout>
	<main class="flex min-h-screen items-center justify-center px-4 py-16">
		<div class="w-full max-w-lg space-y-6 text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Fastt</p>
			<h1 class="text-3xl font-semibold tracking-tight text-white">
				No pudimos completar la página
			</h1>
			<p class="text-base leading-7 text-slate-300">{DATABASE_CONNECTIVITY_PUBLIC_MESSAGE}</p>
			<div class="flex justify-center">
				<a
					href={retryHref}
					class="inline-flex h-11 items-center justify-center rounded-lg bg-white px-5 text-sm font-semibold text-slate-950 shadow-sm transition hover:bg-slate-100"
					data-astro-reload
				>
					Reintentar
				</a>
			</div>
		</div>
	</main>
</DegradedServiceLayout>

<style>
	main {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4rem 1rem;
	}
	.space-y-6 > :not([hidden]) ~ :not([hidden]) {
		margin-top: 1.5rem;
	}
	.text-slate-400 {
		color: #94a3b8;
	}
	.text-white {
		color: #fff;
	}
	.text-slate-300 {
		color: #cbd5e1;
	}
	.text-3xl {
		font-size: 1.875rem;
		line-height: 2.25rem;
	}
	.text-base {
		font-size: 1rem;
		line-height: 1.75rem;
	}
	.text-sm {
		font-size: 0.875rem;
		line-height: 1.25rem;
	}
	.font-semibold {
		font-weight: 600;
	}
	.tracking-tight {
		letter-spacing: -0.025em;
	}
	.tracking-\[0\.18em\] {
		letter-spacing: 0.18em;
	}
	.uppercase {
		text-transform: uppercase;
	}
	.max-w-lg {
		max-width: 32rem;
	}
	.w-full {
		width: 100%;
	}
	.text-center {
		text-align: center;
	}
	.flex {
		display: flex;
	}
	.justify-center {
		justify-content: center;
	}
	.inline-flex {
		display: inline-flex;
	}
	.h-11 {
		height: 2.75rem;
	}
	.items-center {
		align-items: center;
	}
	.rounded-lg {
		border-radius: 0.5rem;
	}
	.bg-white {
		background: #fff;
	}
	.text-slate-950 {
		color: #020617;
	}
	.px-5 {
		padding-left: 1.25rem;
		padding-right: 1.25rem;
	}
	.shadow-sm {
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
	}
	.transition {
		transition-property: color, background-color;
		transition-duration: 150ms;
	}
	a:hover {
		background: #f1f5f9;
	}
</style>
