---
import { Menu, X } from "@lucide/astro"

import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"

const user = await getUserFromRequest(Astro.request)
---

<div class="md:hidden" data-public-mobile-nav>
	<button
		type="button"
		class="fixed right-4 top-2.5 z-50 flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-950 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950"
		aria-label="Abrir menú"
		aria-controls="publicMobileMenu"
		aria-expanded="false"
		data-public-mobile-trigger
	>
		<Menu class="h-5 w-5" data-menu-open-icon aria-hidden="true" />
		<X class="hidden h-5 w-5" data-menu-close-icon aria-hidden="true" />
	</button>
	<div
		id="publicMobileMenu"
		class="fixed inset-x-3 top-[4.5rem] z-50 hidden rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl"
		data-public-mobile-menu
	>
		<nav aria-label="Navegación móvil">
			<ul class="space-y-1 text-base font-medium text-slate-900">
				<li>
					<a href="/" class="flex min-h-12 items-center rounded-xl px-4 hover:bg-slate-100"
						>Inicio</a
					>
				</li>
				<li>
					<a href="/hotels" class="flex min-h-12 items-center rounded-xl px-4 hover:bg-slate-100"
						>Alojamientos</a
					>
				</li>
				<li>
					<a href="/tours" class="flex min-h-12 items-center rounded-xl px-4 hover:bg-slate-100"
						>Tours</a
					>
				</li>
				<li>
					<a href="/packages" class="flex min-h-12 items-center rounded-xl px-4 hover:bg-slate-100"
						>Paquetes</a
					>
				</li>
				<li>
					<a href="/trips" class="flex min-h-12 items-center rounded-xl px-4 hover:bg-slate-100"
						>Mis viajes</a
					>
				</li>
				{
					user ? (
						<>
							<li class="my-2 border-t border-slate-200" />
							<li>
								<a
									href="/dashboard"
									class="flex min-h-12 items-center rounded-xl px-4 hover:bg-slate-100"
								>
									Panel de proveedor
								</a>
							</li>
							<li>
								<a
									href="/api/auth/logout"
									class="flex min-h-12 items-center rounded-xl px-4 hover:bg-slate-100"
								>
									Cerrar sesión
								</a>
							</li>
						</>
					) : (
						<li>
							<a
								href="/SignInPage"
								class="mt-2 flex min-h-12 items-center justify-center rounded-xl bg-slate-950 px-4 text-white"
							>
								Ingresar
							</a>
						</li>
					)
				}
			</ul>
		</nav>
	</div>
</div>

<script>
	function bindPublicMobileNavigation() {
		document.querySelectorAll("[data-public-mobile-nav]").forEach((root) => {
			if (!(root instanceof HTMLElement) || root.dataset.bound === "true") return
			root.dataset.bound = "true"
			const trigger = root.querySelector("[data-public-mobile-trigger]")
			const menu = root.querySelector("[data-public-mobile-menu]")
			const openIcon = root.querySelector("[data-menu-open-icon]")
			const closeIcon = root.querySelector("[data-menu-close-icon]")
			if (!(trigger instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return
			const setOpen = (open: boolean) => {
				menu.classList.toggle("hidden", !open)
				openIcon?.classList.toggle("hidden", open)
				closeIcon?.classList.toggle("hidden", !open)
				trigger.setAttribute("aria-expanded", String(open))
				trigger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú")
			}
			trigger.addEventListener("click", () =>
				setOpen(trigger.getAttribute("aria-expanded") !== "true")
			)
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") {
					setOpen(false)
					trigger.focus()
				}
			})
		})
	}
	bindPublicMobileNavigation()
	document.addEventListener("astro:page-load", bindPublicMobileNavigation)
</script>
