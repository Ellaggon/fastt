---
import Button from "@/components/ui/Button.astro"
import type { CaseEvidenceReadModel } from "@/modules/casework/public"

const { evidence, caseId }: { evidence: CaseEvidenceReadModel; caseId: string } = Astro.props
const signalLabel = {
	pass: "Verificado",
	review: "Revisar",
	missing: "Faltante",
	info: "Informativo",
}
const signalClass = {
	pass: "border-emerald-200 bg-emerald-50 text-emerald-900",
	review: "border-amber-200 bg-amber-50 text-amber-950",
	missing: "border-red-200 bg-red-50 text-red-900",
	info: "border-sky-200 bg-sky-50 text-sky-900",
}
const artifactStatus = {
	ready: {
		label: "Listo para corroborar",
		class: "border-emerald-200 bg-emerald-50 text-emerald-900",
	},
	missing: { label: "Archivo no adjuntado", class: "border-amber-200 bg-amber-50 text-amber-950" },
	unavailable: { label: "Archivo no disponible", class: "border-red-200 bg-red-50 text-red-900" },
}
const holderMatchStatus = {
	exact: {
		label: "Coincidencia exacta",
		class: "border-emerald-200 bg-emerald-50 text-emerald-900",
	},
	probable: {
		label: "Coincidencia probable",
		class: "border-amber-200 bg-amber-50 text-amber-950",
	},
	mismatch: { label: "Discrepancia detectada", class: "border-red-200 bg-red-50 text-red-900" },
	insufficient: {
		label: "Datos insuficientes",
		class: "border-slate-200 bg-slate-50 text-slate-800",
	},
}
const processingLabels: Record<string, string> = {
	queued: "En cola",
	processing: "Procesando",
	completed: "Completado",
	blocked: "Bloqueado",
	failed: "Fallido",
	awaiting_configuration: "Requiere configuración",
	pending: "Pendiente",
	clean: "Limpio",
	infected: "Amenaza detectada",
	unavailable: "No disponible",
	error: "Error",
	valid: "Válido",
	suspicious: "Sospechoso",
	invalid: "Inválido",
	not_supported: "No compatible",
	clear: "Sin señales",
	suspected: "Posible manipulación",
	inconclusive: "No concluyente",
}
const processingTone = (status: string) =>
	["completed", "clean", "valid", "clear"].includes(status)
		? "border-emerald-200 bg-emerald-50 text-emerald-900"
		: ["blocked", "infected", "suspicious", "invalid", "suspected", "failed", "error"].includes(
					status
			  )
			? "border-red-200 bg-red-50 text-red-900"
			: "border-amber-200 bg-amber-50 text-amber-950"
const processingErrorMessages: Record<string, string> = {
	document_analysis_gateway_not_configured:
		"El análisis especializado aún no está configurado. Mantén la revisión manual y no interpretes este estado como archivo limpio.",
	document_processing_source_unavailable:
		"El archivo original no está disponible para inspección. Solicita una nueva carga antes de aprobar.",
	document_processing_source_missing:
		"El registro no contiene un archivo original. Solicita una nueva carga antes de aprobar.",
	document_format_not_recognized:
		"El formato real no pudo reconocerse y el documento permanece bloqueado.",
	document_processing_source_too_large:
		"El archivo excede el límite técnico permitido y debe volver a cargarse.",
}
---

<section
	class="space-y-5"
	aria-labelledby="case-evidence-title"
	data-case-evidence
	data-evidence-revision={evidence.revision}
>
	<header class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
		<div>
			<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
				Investigación de evidencia
			</p>
			<h2 id="case-evidence-title" class="mt-1 text-lg font-semibold">{evidence.title}</h2>
			<p class="mt-2 max-w-3xl text-sm text-slate-600">{evidence.description}</p>
		</div>
		<span
			class="shrink-0 rounded-full bg-slate-100 px-3 py-1 font-mono text-[11px] text-slate-600"
			title="Revisión determinista de la evidencia">rev. {evidence.revision.slice(0, 8)}</span
		>
	</header>
	<p class="-mt-2 text-xs text-slate-500">
		Consultada el {
			new Intl.DateTimeFormat("es-BO", {
				dateStyle: "medium",
				timeStyle: "short",
				timeZone: "America/La_Paz",
			}).format(new Date(evidence.observedAt))
		} (hora de Bolivia). Compara cada criterio antes de elegir un resultado.
	</p>

	<dl class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
		{
			evidence.facts.map((fact) => (
				<div
					class:list={[
						"rounded-xl border p-3",
						fact.tone === "critical" ? "border-red-200 bg-red-50" : "border-slate-200 bg-slate-50",
					]}
				>
					<>
						<dt class="text-xs font-medium text-slate-500">
							{fact.label}
							{fact.sensitive ? <span class="ml-1 text-amber-700">· protegido</span> : null}
						</dt>
						<dd class="mt-1 text-sm font-medium break-words text-slate-900">{fact.value}</dd>
					</>
				</div>
			))
		}
	</dl>

	<div>
		<h3 class="text-sm font-semibold text-slate-900">Criterios de decisión</h3>
		<ul class="mt-3 grid gap-3 lg:grid-cols-2">
			{
				evidence.signals.map((signal) => (
					<li class:list={["rounded-xl border p-3", signalClass[signal.status]]}>
						<>
							<div class="flex items-center justify-between gap-3">
								<>
									<span class="text-sm font-semibold">{signal.label}</span>
									<span class="text-[11px] font-semibold tracking-wide uppercase">
										{signalLabel[signal.status]}
									</span>
								</>
							</div>
							<p class="mt-1 text-xs leading-5 opacity-80">{signal.detail}</p>
						</>
					</li>
				))
			}
		</ul>
	</div>

	{
		evidence.holderMatch && (
			<section class="rounded-xl border border-slate-200 p-4" aria-labelledby="holder-match-title">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<h3 id="holder-match-title" class="text-sm font-semibold">
							Evaluación de titularidad
						</h3>
						<p class="mt-1 text-sm text-slate-700">{evidence.holderMatch.method}</p>
					</div>
					<span
						class:list={[
							"w-fit rounded-full border px-2.5 py-1 text-xs font-semibold",
							holderMatchStatus[evidence.holderMatch.level].class,
						]}
					>
						{holderMatchStatus[evidence.holderMatch.level].label}
					</span>
				</div>
				<p class="mt-3 text-sm text-slate-600">{evidence.holderMatch.detail}</p>
				<p class="mt-3 text-xs text-slate-500">
					Esta evaluación es una señal de apoyo, no sustituye la revisión humana, los documentos de
					titularidad ni la política aplicable.
				</p>
			</section>
		)
	}

	{
		evidence.artifact?.kind === "document" && (
			<div
				class="rounded-xl border border-slate-200 p-4"
				data-document-artifact
				data-preview-state={evidence.artifact.previewState}
			>
				<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
					<>
						<div>
							<>
								<h3 class="text-sm font-semibold">Archivo asociado</h3>
								<p class="mt-1 text-sm text-slate-700">{evidence.artifact.fileName}</p>
								<p class="mt-1 text-xs text-slate-500">
									{evidence.artifact.mimeType ?? "Formato no informado"}
									{evidence.artifact.sizeBytes
										? ` · ${Math.ceil(evidence.artifact.sizeBytes / 1024)} KB`
										: ""}
								</p>
							</>
						</div>
						<span
							class:list={[
								"w-fit rounded-full border px-2.5 py-1 text-xs font-semibold",
								artifactStatus[evidence.artifact.previewState].class,
							]}
						>
							{artifactStatus[evidence.artifact.previewState].label}
						</span>
					</>
				</div>
				<p class="mt-3 text-sm text-slate-700" role="status">
					{evidence.artifact.previewMessage}
				</p>
				{evidence.artifact.previewState !== "ready" && (
					<div class="mt-4 flex flex-wrap items-center gap-3">
						<Button type="button" size="sm" variant="secondary" data-prepare-evidence-request>
							Preparar solicitud de evidencia
						</Button>
						<span class="text-xs text-slate-500">
							No se permite aprobar hasta que exista un archivo corroborable.
						</span>
					</div>
				)}
			</div>
		)
	}

	{
		evidence.artifact?.kind === "document" && (
			<section
				class="rounded-xl border border-slate-200 p-4"
				aria-labelledby="document-analysis-title"
			>
				<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<h3 id="document-analysis-title" class="text-sm font-semibold">
							Seguridad y extracción automática
						</h3>
						<p class="mt-1 text-xs text-slate-600">
							El archivo permanece en cuarentena lógica hasta completar los controles obligatorios.
						</p>
					</div>
					<span
						class:list={[
							"w-fit rounded-full border px-2.5 py-1 text-xs font-semibold",
							processingTone(evidence.artifact.inspection?.processingState ?? "pending"),
						]}
					>
						{processingLabels[evidence.artifact.inspection?.processingState ?? "pending"] ??
							evidence.artifact.inspection?.processingState ??
							"Pendiente"}
					</span>
				</div>
				{evidence.artifact.inspection ? (
					<>
						<dl class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
							{[
								["Antivirus", evidence.artifact.inspection.malwareStatus],
								["OCR", evidence.artifact.inspection.ocrStatus],
								["Extracción", evidence.artifact.inspection.extractionStatus],
								["Manipulación", evidence.artifact.inspection.tamperStatus],
							].map(([label, status]) => (
								<div class:list={["rounded-lg border p-3", processingTone(status)]}>
									<dt class="text-xs font-medium opacity-75">{label}</dt>
									<dd class="mt-1 text-sm font-semibold">{processingLabels[status] ?? status}</dd>
								</div>
							))}
						</dl>
						<div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-slate-500">
							<span>
								Formato detectado: {evidence.artifact.inspection.detectedMimeType ?? "pendiente"}
							</span>
							<span>
								Huella:{" "}
								{evidence.artifact.inspection.sha256
									? `${evidence.artifact.inspection.sha256.slice(0, 12)}…`
									: "pendiente"}
							</span>
							<span>
								Campos extraídos: {evidence.artifact.inspection.extractedFieldKeys.length}
							</span>
						</div>
						{evidence.artifact.inspection.extractedFieldKeys.length > 0 && (
							<p class="mt-2 text-xs text-slate-500">
								Campos detectados: {evidence.artifact.inspection.extractedFieldKeys.join(", ")}. Los
								valores sensibles no se muestran en este resumen.
							</p>
						)}
						{evidence.artifact.inspection.errorCode && (
							<p class="mt-3 text-xs text-amber-800">
								Atención operativa:{" "}
								{processingErrorMessages[evidence.artifact.inspection.errorCode] ??
									"La inspección técnica necesita atención. Consulta el evento operativo antes de decidir."}
							</p>
						)}
					</>
				) : (
					<p class="mt-3 text-sm text-amber-800">
						Este documento todavía no ingresó a la cola técnica de inspección.
					</p>
				)}
			</section>
		)
	}

	{
		evidence.approvalBlockers.length > 0 && (
			<div class="fastt-notice rounded-xl border border-amber-300 bg-amber-50 p-4" role="alert">
				<>
					<h3 class="text-sm font-semibold text-amber-950">Aprobación bloqueada</h3>
					<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-amber-900">
						{evidence.approvalBlockers.map((blocker) => (
							<li>{blocker}</li>
						))}
					</ul>
				</>
			</div>
		)
	}

	{
		evidence.approvalWarnings.length > 0 && (
			<div class="fastt-notice rounded-xl border border-amber-300 bg-amber-50 p-4" role="alert">
				<h3 class="text-sm font-semibold text-amber-950">Revisión reforzada requerida</h3>
				<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-amber-900">
					{evidence.approvalWarnings.map((warning) => (
						<li>{warning}</li>
					))}
				</ul>
			</div>
		)
	}

	{
		evidence.reveal && (
			<form
				class="fastt-notice rounded-xl border border-amber-200 bg-amber-50 p-4"
				data-evidence-reveal
				data-endpoint={`/api/admin/v1/cases/${caseId}/evidence/reveal`}
			>
				<h3 class="text-sm font-semibold text-amber-950">Acceso puntual a información sensible</h3>
				<p class="mt-1 text-xs leading-5 text-amber-900">
					Requiere permiso de revelado, MFA reciente y una justificación. Cada intento queda en
					auditoría.
				</p>
				<input type="hidden" name="kind" value={evidence.reveal.kind} />
				<label class="mt-3 block text-xs font-medium text-amber-950">
					Motivo de acceso
					<input
						name="reason"
						required
						minlength="8"
						maxlength="240"
						class="fastt-notice fastt-field mt-1 h-10 w-full rounded-lg border border-amber-300 bg-white px-3 text-sm"
						placeholder="Ej. validar titularidad para resolver el caso"
					/>
				</label>
				<div class="mt-3 flex flex-wrap items-center gap-3">
					<>
						<Button type="submit" size="sm" variant="secondary">
							{evidence.reveal.label}
						</Button>
						<span class="text-xs text-amber-800">
							El acceso caduca o se oculta automáticamente.
						</span>
					</>
				</div>
				<div
					class="fastt-notice mt-3 hidden rounded-lg border border-amber-200 bg-white p-3 text-sm"
					data-reveal-output
					role="status"
					aria-live="polite"
				/>
			</form>
		)
	}

	<details class="text-xs text-slate-600 break-words">
		<summary class="cursor-pointer py-2">Referencias técnicas de la evidencia</summary>
		<footer class="text-xs text-slate-500 break-all">
			Fuente canónica: <span class="font-mono">{evidence.sourceType} · {evidence.sourceRef}</span>.
			Observada {
				new Intl.DateTimeFormat("es-BO", { dateStyle: "medium", timeStyle: "short" }).format(
					new Date(evidence.observedAt)
				)
			}.
		</footer>
	</details>
</section>
