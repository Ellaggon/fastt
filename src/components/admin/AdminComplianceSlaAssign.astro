---
import Button from "@/components/ui/Button.astro"
import { formatAdminComplianceSlaSummary } from "@/lib/provider-compliance-ops"

type Props = {
	providerId: string
	domain: "verification" | "fiscal" | "documents" | "payments"
	entityId: string
	assignment?: {
		assigneeEmail: string | null
		slaHours: number
		slaDueAt: Date | string | null
		slaState: "ok" | "due_soon" | "overdue" | "done"
	} | null
	/** Current admin email for "Yo" shortcut. */
	currentAdminEmail?: string | null
	/** Recent / open-queue assignee emails for quick fill. */
	assigneeShortcuts?: string[]
}

const {
	providerId,
	domain,
	entityId,
	assignment = null,
	currentAdminEmail = null,
	assigneeShortcuts = [],
} = Astro.props as Props
const summary = formatAdminComplianceSlaSummary(assignment)
const slaTone =
	assignment?.slaState === "overdue"
		? "text-red-700"
		: assignment?.slaState === "due_soon"
			? "text-amber-700"
			: "text-slate-500"

const me = String(currentAdminEmail ?? "")
	.trim()
	.toLowerCase()
const shortcutEmails = Array.from(
	new Set(
		[
			me,
			...assigneeShortcuts.map((email) =>
				String(email ?? "")
					.trim()
					.toLowerCase()
			),
		].filter(Boolean)
	)
).slice(0, 5)
---

<div class="space-y-2" data-assignee-shortcuts-root>
	{
		summary ? (
			<p class:list={["text-xs", slaTone]} data-sla-summary>
				{summary}
			</p>
		) : (
			<p class="text-xs text-slate-500">Sin SLA asignado</p>
		)
	}
	{
		shortcutEmails.length ? (
			<div class="flex flex-wrap gap-1.5" data-assignee-shortcuts>
				{shortcutEmails.map((email) => (
					<button
						type="button"
						class="fastt-button rounded border border-slate-300 bg-white px-2 py-0.5 text-xs font-medium text-slate-700 hover:bg-slate-50"
						data-assignee-shortcut={email}
						data-assignee-me={me && email === me ? "true" : undefined}
					>
						{me && email === me ? "Yo" : email}
					</button>
				))}
			</div>
		) : null
	}
	<form
		class="flex flex-col gap-2"
		data-assign-ops
		data-domain={domain}
		data-entity-id={entityId}
		data-provider-id={providerId}
	>
		<input
			name="assigneeEmail"
			type="email"
			placeholder="responsable@fastt.test"
			value={assignment?.assigneeEmail ?? ""}
			class="fastt-field w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm"
			data-assignee-email-input
		/>
		<input
			name="slaHours"
			type="number"
			min="1"
			max="168"
			value={String(assignment?.slaHours ?? 48)}
			class="fastt-field w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm"
		/>
		<Button type="submit" variant="secondary" className="w-fit">Asignar SLA</Button>
	</form>
</div>
