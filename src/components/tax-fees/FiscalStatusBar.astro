---
import Badge from "@/components/ui/Badge.astro"
import {
	providerTaxIdentityPresentation,
	type ProviderTaxConfigurationStatus,
} from "@/lib/provider-tax-configuration"

interface Props {
	identityLabel: string
	isIdentityConfigured: boolean
	identityStatus?: ProviderTaxConfigurationStatus | null
	conflictCount?: number
	pendingSyncCount?: number
	showIdentity?: boolean
}

const {
	identityLabel,
	isIdentityConfigured,
	identityStatus = null,
	conflictCount = 0,
	pendingSyncCount = 0,
	showIdentity = true,
} = Astro.props
const hasStatus = showIdentity || conflictCount > 0 || pendingSyncCount > 0
const identity = providerTaxIdentityPresentation(
	identityStatus ?? (isIdentityConfigured ? "pending" : "not_configured")
)
---

{
	hasStatus ? (
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-slate-200 bg-slate-50 px-4 py-2.5 text-xs sm:px-6">
			{showIdentity ? (
				<a
					href="/provider/settings/verification/fiscal"
					class="inline-flex items-center gap-2 font-medium text-slate-700 hover:text-slate-950"
				>
					Identidad fiscal
					<Badge variant={identity.badge}>{identity.label}</Badge>
				</a>
			) : null}
			{conflictCount > 0 ? (
				<span class="fastt-notice inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 font-semibold text-amber-800">
					{conflictCount} {conflictCount === 1 ? "conflicto" : "conflictos"}
				</span>
			) : null}
			{pendingSyncCount > 0 ? (
				<span class="fastt-notice inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 font-semibold text-sky-800">
					{pendingSyncCount} sincronizaciones pendientes
				</span>
			) : null}
		</div>
	) : null
}
