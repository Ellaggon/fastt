---
import TabsInsidePanel from "@/components/ui/TabsInsidePanel.astro"
import { routes } from "@/lib/routes"
import { Calculator, History, Link2, ReceiptText } from "@lucide/astro"

type FiscalTab = "definitions" | "assignments" | "simulator" | "activity"

interface Props {
	active: FiscalTab
	search?: URLSearchParams
	counts?: Partial<Record<FiscalTab, number>>
}

const { active, search = new URLSearchParams(), counts = {} } = Astro.props
const suffix = search.toString() ? `?${search.toString()}` : ""
const tabs: Array<{
	id: FiscalTab
	label: string
	href: string
	icon: typeof ReceiptText
}> = [
	{
		id: "definitions",
		label: "Definiciones",
		href: routes.providerSettingsTaxFees(),
		icon: ReceiptText,
	},
	{
		id: "simulator",
		label: "Simulador",
		href: routes.providerSettingsTaxSimulator(),
		icon: Calculator,
	},
	{
		id: "assignments",
		label: "Asignaciones",
		href: routes.providerSettingsTaxAssignments(),
		icon: Link2,
	},
	{ id: "activity", label: "Actividad", href: routes.providerSettingsTaxActivity(), icon: History },
]
---

<TabsInsidePanel class="max-w-full flex-nowrap bg-black" aria-label="Secciones de fiscalidad">
	{
		tabs.map((tab) => {
			const selected = tab.id === active
			const Icon = tab.icon
			return (
				<a
					href={`${tab.href}${suffix}`}
					data-astro-prefetch="viewport"
					aria-current={selected ? "page" : undefined}
					data-active={selected ? "true" : "false"}
					class="fastt-tabs-inside-panel__item px-4 py-2 text-sm font-semibold whitespace-nowrap text-slate-300 hover:bg-slate-800 hover:text-white"
				>
					<Icon class="mr-2 h-4 w-4 shrink-0" aria-hidden="true" />
					{tab.label}
					{counts[tab.id] !== undefined ? (
						<span class="ml-1 text-xs opacity-70">{counts[tab.id]}</span>
					) : null}
				</a>
			)
		})
	}
</TabsInsidePanel>
