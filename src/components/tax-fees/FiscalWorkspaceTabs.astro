---
import TabsInsidePanel from "@/components/ui/TabsInsidePanel.astro"
import { routes } from "@/lib/routes"

type FiscalTab = "definitions" | "assignments" | "simulator" | "activity"

interface Props {
	active: FiscalTab
	search?: URLSearchParams
	counts?: Partial<Record<FiscalTab, number>>
}

const { active, search = new URLSearchParams(), counts = {} } = Astro.props
const suffix = search.toString() ? `?${search.toString()}` : ""
const tabs: Array<{ id: FiscalTab; label: string; href: string }> = [
	{ id: "definitions", label: "Definiciones", href: routes.providerSettingsTaxFees() },
	{ id: "assignments", label: "Asignaciones", href: routes.providerSettingsTaxAssignments() },
	{ id: "simulator", label: "Simulador", href: routes.providerSettingsTaxSimulator() },
	{ id: "activity", label: "Actividad", href: routes.providerSettingsTaxActivity() },
]
---

<TabsInsidePanel aria-label="Secciones de fiscalidad">
	{
		tabs.map((tab) => {
			const selected = tab.id === active
			return (
				<a
					href={`${tab.href}${suffix}`}
					data-astro-prefetch="viewport"
					aria-current={selected ? "page" : undefined}
					data-active={selected ? "true" : "false"}
					class="fastt-tabs-inside-panel__item"
				>
					{tab.label}
					{counts[tab.id] !== undefined ? (
						<span class="ml-1 text-xs opacity-70">{counts[tab.id]}</span>
					) : null}
				</a>
			)
		})
	}
</TabsInsidePanel>
