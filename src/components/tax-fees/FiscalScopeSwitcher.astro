---
import ContextSwitcher from "@/components/ui/ContextSwitcher.astro"
import { fiscalWorkspaceScopeHref } from "@/lib/taxes-fees/fiscal-workspace-navigation"
import { db, eq, Product } from "@/shared/infrastructure/db/compat"

interface Props {
	providerId: string
	variant?: "surface" | "topbar"
}

const { providerId, variant = "topbar" } = Astro.props
const products = providerId
	? (
			await db
				.select({ id: Product.id, name: Product.name })
				.from(Product)
				.where(eq(Product.providerId, providerId))
				.catch(() => [])
		)
			.map((product) => ({
				id: String(product.id),
				label: String(product.name || "Producto"),
			}))
			.sort((left, right) => left.label.localeCompare(right.label, "es"))
	: []
const requestedScopeId = String(Astro.url.searchParams.get("scope") ?? "").trim()
const selectedProductId = products.some((product) => product.id === requestedScopeId)
	? requestedScopeId
	: ""
const hrefFor = (scopeId: string | null) =>
	fiscalWorkspaceScopeHref({
		pathname: Astro.url.pathname,
		search: Astro.url.searchParams,
		scopeId,
	})
const options = [
	{ id: "all", label: "Toda la cuenta", href: hrefFor(null) },
	...products.map((product) => ({
		id: product.id,
		label: product.label,
		href: hrefFor(product.id),
	})),
]
const selected = options.find((option) => option.id === (selectedProductId || "all")) ?? options[0]
---

<ContextSwitcher
	label="Configuración comercial"
	value={selected.label}
	options={options}
	selectedId={selected.id}
	icon="service"
	menuLabel="Contexto comercial"
	emptyMessage="No hay otros productos disponibles."
	ariaLabel="Cambiar contexto comercial"
	variant={variant}
/>
