---
import { MapPin, Search, SlidersHorizontal } from "@lucide/astro"

import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import DatesModal from "@/components/ui/DatesModal.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import TourSearchDisclosure from "@/components/searchPanel/TourSearchDisclosure.astro"
import { publicTourCategories } from "@/lib/tours/tourDiscoveryFilters"
import { TOUR_DIFFICULTY_OPTIONS } from "@/lib/tours/tourDifficulty"
import { normalizeTourDurationBucket, TOUR_DURATION_OPTIONS } from "@/lib/tours/tourSemantics"
import { and, asc, db, eq, ProductCategory } from "@/shared/infrastructure/db/compat"

interface Props {
	destinationPath?: string | null
	destinationName?: string | null
	startDate?: string
	compact?: boolean
}

const {
	destinationPath: routeDestinationPath,
	destinationName: routeDestinationName,
	startDate: startDateProp,
	compact = false,
} = Astro.props as Props
const params = Astro.url.searchParams
const selectedDestinationPath = routeDestinationPath ?? params.get("destino") ?? ""
const selectedDestinationName = routeDestinationName ?? ""
const startDate =
	startDateProp !== undefined
		? startDateProp
		: (params.get("startDate") ?? params.get("checkin") ?? "")
const duration = normalizeTourDurationBucket(params.get("duration")) ?? ""
const level = String(params.get("level") ?? "")
const selectedCategories = new Set(
	params.getAll("category").map((value) => value.trim().toLowerCase())
)
const priceMin = params.get("priceMin") ?? ""
const priceMax = params.get("priceMax") ?? ""
const currency = /^[A-Z]{3}$/.test(String(params.get("currency") ?? "").toUpperCase())
	? String(params.get("currency")).toUpperCase()
	: ""
const sort = String(params.get("sort") ?? "relevance")
const sortOptions = [
	{ value: "relevance", label: "Más relevantes" },
	...(startDate
		? [
				{ value: "price_asc", label: "Precio: menor primero" },
				{ value: "price_desc", label: "Precio: mayor primero" },
			]
		: []),
	{ value: "duration_asc", label: "Duración: corta primero" },
	{ value: "rating_desc", label: "Mejor calificados" },
]
const currencyOptions = ["BOB", "USD", "CLP", "EUR"]
const todayInBolivia = new Intl.DateTimeFormat("en-CA", {
	timeZone: "America/La_Paz",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
}).format(new Date())

let categories: Array<{ id: string; slug: string; name: string }> = []
try {
	categories = publicTourCategories(
		await db
			.select({ id: ProductCategory.id, slug: ProductCategory.slug, name: ProductCategory.name })
			.from(ProductCategory)
			.where(
				and(
					eq(ProductCategory.vertical, "tour"),
					eq(ProductCategory.isActive, true),
					eq(ProductCategory.dataClass, "production")
				)
			)
			.orderBy(asc(ProductCategory.sortOrder), asc(ProductCategory.name))
	)
} catch {
	categories = []
}
const selectedDurationLabel = duration
	? TOUR_DURATION_OPTIONS.find((option) => option.value === duration)?.label
	: null
const selectedLevelLabel = level
	? TOUR_DIFFICULTY_OPTIONS.find((option) => option.value === level)?.label
	: null
const activeFilterLabels = [
	...(selectedDurationLabel ? [selectedDurationLabel] : []),
	...(selectedLevelLabel ? [selectedLevelLabel] : []),
	...categories
		.filter((category) => selectedCategories.has(category.slug.toLowerCase()))
		.map((category) => category.name),
	...(priceMin || priceMax
		? [
				priceMin && priceMax
					? `${priceMin}–${priceMax}${currency ? ` ${currency}` : ""}`
					: priceMin
						? `Desde ${priceMin}${currency ? ` ${currency}` : ""}`
						: `Hasta ${priceMax}${currency ? ` ${currency}` : ""}`,
			]
		: []),
]
---

<TourSearchDisclosure
	compact={compact}
	destinationName={selectedDestinationName}
	startDate={startDate}
	activeFilterCount={activeFilterLabels.length}
>
	<div
		class={compact
			? "w-full"
			: "fastt-card rounded-2xl border border-slate-200 bg-white p-3 shadow-[0_18px_50px_-28px_rgba(15,23,42,0.45)] sm:p-4"}
	>
		<form id="tourSearchForm" action="/buscar/tours" method="get" novalidate>
			<div
				class="grid gap-3 max-md:grid-cols-2 md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)_auto_auto] md:items-end md:gap-2"
			>
				<div class="max-md:col-span-2" data-search-field="destination">
					<label for="destinationInput" class="mb-1.5 block text-sm font-semibold text-slate-800"
						>Destino</label
					>
					<div class="relative text-slate-900">
						<MapPin
							class="pointer-events-none absolute left-4 top-4 z-10 h-6 w-5 text-slate-500"
							aria-hidden="true"
						/>
						<Input
							id="destinationInput"
							autocomplete="off"
							type="search"
							role="combobox"
							value={selectedDestinationName}
							placeholder="Ciudad, región o parque..."
							aria-controls="destinationsList"
							aria-autocomplete="list"
							aria-expanded="false"
							aria-describedby="tourSearchFormError"
							className="h-14 rounded-xl pl-12 pr-4 text-base"
						/>
						<input
							type="hidden"
							id="destinationPath"
							name="destino"
							value={selectedDestinationPath}
						/>
						<ul
							id="destinationsList"
							role="listbox"
							class="fastt-soft-box absolute left-0 right-0 z-50 mt-1 hidden max-h-56 overflow-auto border border-slate-200 bg-white text-sm"
						>
						</ul>
					</div>
				</div>

				<div class="max-md:col-span-2" data-search-field="date">
					<label class="mb-1.5 block text-sm font-semibold text-slate-800" for="startDate"
						>Fecha de salida</label
					>
					<DatesModal
						id="startDate"
						name="startDate"
						value={startDate}
						min={todayInBolivia}
						placeholder="Aún no sé la fecha"
						className="h-14 w-full justify-start gap-3 rounded-xl px-4 text-base [&>svg]:order-first [&>svg]:h-5 [&>svg]:w-5 [&>svg]:shrink-0"
					/>
				</div>

				<div class="max-md:col-span-1" data-search-field="filters">
					<Button
						type="button"
						variant="secondary"
						class="tour-search-filters-control h-14 w-full rounded-xl px-4 md:w-auto"
						aria-label="Filtros"
						aria-expanded="false"
						aria-controls="tourSearchFilters"
						data-tour-filters-toggle
					>
						<SlidersHorizontal class="h-5 w-5" aria-hidden="true" />
						{
							activeFilterLabels.length ? (
								<span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-slate-950 px-1.5 text-xs text-white">
									{activeFilterLabels.length}
								</span>
							) : null
						}
					</Button>
				</div>

				<div class="max-md:col-span-1" data-search-field="submit">
					<Button
						type="submit"
						variant="primary"
						size="lg"
						class="tour-search-submit h-14 w-full rounded-xl px-5 shadow-[0_12px_28px_-14px_rgba(15,23,42,0.55)] md:min-w-[7.75rem] md:w-auto"
						aria-label="Buscar tours"
					>
						<Search class="h-5 w-5 shrink-0" aria-hidden="true" />
						<span class="hidden sm:inline">Buscar</span>
					</Button>
				</div>
			</div>

			{
				activeFilterLabels.length ? (
					<p class="mt-3 text-sm text-slate-600">{activeFilterLabels.join(" · ")}</p>
				) : null
			}

			<Card
				id="tourSearchFilters"
				variant="soft"
				hidden
				data-tour-filters-panel
				class="tour-search-filters-panel mt-4 p-4 sm:p-5"
			>
				{
					categories.length ? (
						<div data-tour-filters-section>
							<p class="text-sm font-semibold text-slate-800">Actividades</p>
							<div id="activitiesWrap" class="mt-3 flex flex-wrap gap-2">
								{categories.map((category) => (
									<label class="cursor-pointer" data-tour-filters-chip>
										<input
											type="checkbox"
											name="category"
											value={category.slug}
											checked={selectedCategories.has(category.slug.toLowerCase())}
											class="peer sr-only"
										/>
										<span class="fastt-soft-box inline-flex min-h-11 items-center rounded-full border border-slate-300 px-4 text-sm text-slate-800 transition peer-checked:border-slate-950 peer-checked:bg-slate-950 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-slate-950 peer-focus-visible:ring-offset-2">
											{category.name}
										</span>
									</label>
								))}
							</div>
						</div>
					) : null
				}

				<div
					class:list={["grid gap-4 md:grid-cols-2", categories.length ? "mt-5" : ""]}
					data-tour-filters-section
				>
					<div>
						<label for="duration" class="mb-1.5 block text-sm font-semibold text-slate-800"
							>Duración</label
						>
						<Select name="duration" id="duration">
							<option value="" selected={!duration}>Cualquiera</option>
							{
								TOUR_DURATION_OPTIONS.map((option) => (
									<option value={option.value} selected={duration === option.value}>
										{option.label}
									</option>
								))
							}
						</Select>
					</div>
					<div>
						<label for="level" class="mb-1.5 block text-sm font-semibold text-slate-800"
							>Dificultad</label
						>
						<Select name="level" id="level">
							<option value="" selected={!level}>Cualquiera</option>
							{
								TOUR_DIFFICULTY_OPTIONS.map((option) => (
									<option value={option.value} selected={level === option.value}>
										{option.label}
									</option>
								))
							}
						</Select>
					</div>
				</div>

				<div class="mt-5" data-tour-filters-section>
					<p class="text-sm font-semibold text-slate-800">Precio por participante</p>
					<p class="mt-1 text-sm text-slate-600">
						Se aplica al buscar con fecha. Sin un monto, la moneda no filtra.
					</p>
					<div class="mt-3 grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_8.5rem]">
						<Input
							name="priceMin"
							aria-label="Precio mínimo por participante"
							type="number"
							min="0"
							step="0.01"
							value={priceMin}
							placeholder="Mín."
						/>
						<Input
							name="priceMax"
							aria-label="Precio máximo por participante"
							type="number"
							min="0"
							step="0.01"
							value={priceMax}
							placeholder="Máx."
						/>
						<div>
							<label for="currency" class="sr-only">Moneda</label>
							<Select name="currency" id="currency" aria-label="Moneda">
								<option value="" selected={!currency}>Moneda</option>
								{
									currencyOptions.map((option) => (
										<option value={option} selected={currency === option}>
											{option}
										</option>
									))
								}
							</Select>
						</div>
					</div>
				</div>

				<div class="mt-5 border-t border-slate-200 pt-5" data-tour-filters-section>
					<label for="sort" class="mb-1.5 block text-sm font-semibold text-slate-800">Ordenar</label
					>
					<div class="max-w-xs">
						<Select name="sort" id="sort">
							{
								sortOptions.map((option) => (
									<option value={option.value} selected={sort === option.value}>
										{option.label}
									</option>
								))
							}
						</Select>
					</div>
				</div>

				<div
					class="mt-5 flex flex-wrap items-center justify-between gap-3"
					data-tour-filters-section
				>
					<button
						type="button"
						class="min-h-11 rounded-full px-3 text-sm font-semibold text-slate-700 underline-offset-4 hover:underline"
						data-tour-filters-clear
					>
						Limpiar filtros
					</button>
					<button
						type="button"
						class="inline-flex h-11 items-center rounded-full bg-slate-950 px-5 text-sm font-semibold text-white hover:bg-slate-800"
						data-tour-filters-close
					>
						Listo
					</button>
				</div>
			</Card>

			<p id="tourSearchFormError" class="mt-3 hidden text-sm font-medium text-red-700" role="alert">
			</p>
		</form>
	</div>
</TourSearchDisclosure>

<style>
	.tour-search-filters-panel.is-open {
		box-shadow:
			0 0 0 1px rgb(203 213 225),
			0 16px 40px -28px rgb(15 23 42 / 0.28);
	}

	:global(.tour-search-filters-control.is-filter-panel-open) {
		border-color: rgb(148 163 184);
		box-shadow: 0 0 0 3px rgb(148 163 184 / 0.18);
	}

	@media (prefers-reduced-motion: reduce) {
		.tour-search-filters-panel.is-open {
			box-shadow: none;
		}
	}
</style>

<script type="module">
	const qs = (selector, element = document) => element.querySelector(selector)
	function debounce(fn, wait = 200) {
		let timer
		return (...args) => {
			clearTimeout(timer)
			timer = setTimeout(() => fn(...args), wait)
		}
	}
	async function fetchDestinations(query) {
		if (!query) return []
		const response = await fetch(`/api/destinations?q=${encodeURIComponent(query)}&limit=8`)
		if (!response.ok) throw new Error("destination_lookup_failed")
		return response.json()
	}
	function selectDestination(option, input, hiddenInput, list) {
		input.value = option.dataset.label || option.textContent || ""
		hiddenInput.value = option.dataset.canonicalPath || ""
		list.classList.add("hidden")
		input.setAttribute("aria-expanded", "false")
		input.focus()
	}
	function renderDestinations(list, items, input, hiddenInput) {
		list.innerHTML = ""
		if (!items?.length) {
			const empty = document.createElement("li")
			empty.className = "px-3 py-3 text-slate-600"
			empty.textContent = "No encontramos ese destino. Prueba con una ciudad o región de Bolivia."
			list.appendChild(empty)
			list.classList.remove("hidden")
			input.setAttribute("aria-expanded", "true")
			return
		}
		for (const [index, destination] of items.entries()) {
			const typeLabel =
				{
					country: "País",
					admin_area_1: "Departamento",
					admin_area_2: "Provincia",
					city: "Ciudad",
					locality: "Localidad",
					neighborhood: "Barrio",
					natural_area: "Área natural",
					poi: "Lugar",
				}[destination.placeType] || "Destino"
			const departmentLabel =
				destination.department && destination.department !== destination.name
					? `, ${destination.department}`
					: ""
			const label = `${destination.name}${departmentLabel} · ${typeLabel}`
			const item = document.createElement("li")
			const button = document.createElement("button")
			button.type = "button"
			button.role = "option"
			button.id = `tour-search-destination-${index}`
			button.className =
				"block w-full px-3 py-2 text-left text-slate-800 hover:bg-slate-100 focus:bg-slate-100"
			button.dataset.canonicalPath = destination.canonicalPath || ""
			button.dataset.label = label
			button.textContent = label
			button.addEventListener("click", () => selectDestination(button, input, hiddenInput, list))
			item.appendChild(button)
			list.appendChild(item)
		}
		list.classList.remove("hidden")
		input.setAttribute("aria-expanded", "true")
	}
	function bindTourSearchForm() {
		const form = qs("#tourSearchForm"),
			input = qs("#destinationInput"),
			list = qs("#destinationsList"),
			hiddenInput = qs("#destinationPath")
		const minInput = qs('input[name="priceMin"]'),
			maxInput = qs('input[name="priceMax"]'),
			currencyInput = qs('select[name="currency"]'),
			error = qs("#tourSearchFormError")
		if (
			!(form instanceof HTMLFormElement) ||
			form.dataset.bound === "true" ||
			!(input instanceof HTMLInputElement) ||
			!(list instanceof HTMLElement) ||
			!(hiddenInput instanceof HTMLInputElement)
		)
			return
		form.dataset.bound = "true"
		const filtersToggle = form.querySelector("[data-tour-filters-toggle]")
		const filtersPanel = form.querySelector("[data-tour-filters-panel]")
		const FILTER_EASING = "cubic-bezier(0.16, 1, 0.3, 1)"
		let filtersPanelAnimation = null
		let filtersSectionAnimations = []

		const clearFiltersPanelMotion = () => {
			filtersPanelAnimation?.cancel()
			filtersPanelAnimation = null
			filtersSectionAnimations.forEach((motion) => motion.cancel())
			filtersSectionAnimations = []
		}

		const resetFiltersPanelStyles = (panel) => {
			panel.style.height = ""
			panel.style.overflow = ""
			panel.classList.remove("is-opening")
			panel
				.querySelectorAll("[data-tour-filters-section], [data-tour-filters-chip]")
				.forEach((node) => {
					if (node instanceof HTMLElement) {
						node.style.opacity = ""
						node.style.transform = ""
					}
				})
		}

		const settleFiltersPanel = (panel, toggle, open) => {
			clearFiltersPanelMotion()
			resetFiltersPanelStyles(panel)
			panel.hidden = !open
			panel.classList.toggle("is-open", open)
			toggle.setAttribute("aria-expanded", open ? "true" : "false")
			toggle.classList.toggle("is-filter-panel-open", open)
		}

		const runFiltersPanelMotion = (open) => {
			if (!(filtersPanel instanceof HTMLElement) || !(filtersToggle instanceof HTMLButtonElement))
				return
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				settleFiltersPanel(filtersPanel, filtersToggle, open)
				return
			}

			clearFiltersPanelMotion()

			if (open) {
				filtersPanel.hidden = false
				filtersPanel.classList.add("is-opening")
				filtersToggle.setAttribute("aria-expanded", "true")
				const targetHeight = filtersPanel.scrollHeight
				const sections = [...filtersPanel.querySelectorAll("[data-tour-filters-section]")]
				const chips = [...filtersPanel.querySelectorAll("[data-tour-filters-chip]")]

				filtersPanel.style.overflow = "hidden"
				filtersPanel.style.height = "0px"

				filtersPanelAnimation = filtersPanel.animate(
					[
						{ height: "0px", opacity: 0 },
						{ height: `${targetHeight}px`, opacity: 1 },
					],
					{ duration: 440, easing: FILTER_EASING, fill: "both" }
				)

				sections.forEach((section, index) => {
					filtersSectionAnimations.push(
						section.animate(
							[
								{ opacity: 0, transform: "translateY(14px)" },
								{ opacity: 1, transform: "translateY(0)" },
							],
							{
								duration: 400,
								delay: 120 + index * 65,
								easing: FILTER_EASING,
								fill: "both",
							}
						)
					)
				})

				chips.forEach((chip, index) => {
					filtersSectionAnimations.push(
						chip.animate(
							[
								{ opacity: 0, transform: "translateY(8px) scale(0.94)" },
								{ opacity: 1, transform: "translateY(0) scale(1)" },
							],
							{
								duration: 340,
								delay: 180 + Math.min(index * 22, 360),
								easing: FILTER_EASING,
								fill: "both",
							}
						)
					)
				})

				const current = filtersPanelAnimation
				filtersPanelAnimation.onfinish = () => {
					if (filtersPanelAnimation !== current) return
					settleFiltersPanel(filtersPanel, filtersToggle, true)
				}
				return
			}

			const startHeight = filtersPanel.getBoundingClientRect().height
			filtersPanel.style.overflow = "hidden"
			filtersPanel.style.height = `${startHeight}px`
			filtersToggle.classList.remove("is-filter-panel-open")

			filtersPanelAnimation = filtersPanel.animate(
				[
					{ height: `${startHeight}px`, opacity: 1 },
					{ height: "0px", opacity: 0 },
				],
				{ duration: 280, easing: "cubic-bezier(0.4, 0, 1, 1)", fill: "both" }
			)

			const current = filtersPanelAnimation
			filtersPanelAnimation.onfinish = () => {
				if (filtersPanelAnimation !== current) return
				settleFiltersPanel(filtersPanel, filtersToggle, false)
			}
		}

		const setFiltersOpen = (open) => {
			if (!(filtersPanel instanceof HTMLElement) || !(filtersToggle instanceof HTMLButtonElement))
				return
			const isOpen = !filtersPanel.hidden
			if (open === isOpen && !filtersPanel.classList.contains("is-opening")) return
			runFiltersPanelMotion(open)
		}
		filtersToggle?.addEventListener("click", () => {
			if (!(filtersPanel instanceof HTMLElement)) return
			setFiltersOpen(filtersPanel.hidden)
		})
		form.querySelector("[data-tour-filters-close]")?.addEventListener("click", () => {
			setFiltersOpen(false)
			if (filtersToggle instanceof HTMLButtonElement) filtersToggle.focus()
		})
		form.querySelector("[data-tour-filters-clear]")?.addEventListener("click", () => {
			filtersPanel?.querySelectorAll('input[type="checkbox"]').forEach((node) => {
				if (node instanceof HTMLInputElement) node.checked = false
			})
			filtersPanel?.querySelectorAll('input[type="number"]').forEach((node) => {
				if (node instanceof HTMLInputElement) node.value = ""
			})
			filtersPanel?.querySelectorAll("select").forEach((node) => {
				if (!(node instanceof HTMLSelectElement)) return
				node.value = node.name === "sort" ? "relevance" : ""
				node.dispatchEvent(new Event("change", { bubbles: true }))
			})
		})
		let requestNumber = 0
		const search = debounce(async (value) => {
			if (!value?.trim()) {
				list.classList.add("hidden")
				input.setAttribute("aria-expanded", "false")
				return
			}
			const currentRequest = ++requestNumber
			try {
				const items = await fetchDestinations(value.trim())
				if (currentRequest !== requestNumber) return
				renderDestinations(list, items, input, hiddenInput)
			} catch {
				if (currentRequest !== requestNumber) return
				list.innerHTML =
					'<li class="px-3 py-3 text-red-700">No pudimos buscar destinos. Intenta nuevamente.</li>'
				list.classList.remove("hidden")
				input.setAttribute("aria-expanded", "true")
			}
		}, 180)
		input.addEventListener("input", (event) => {
			hiddenInput.value = ""
			search(event.target.value)
		})
		input.addEventListener("keydown", (event) => {
			if (event.key === "ArrowDown") {
				list.querySelector("button")?.focus()
				event.preventDefault()
			}
			if (event.key === "Escape") {
				list.classList.add("hidden")
				input.setAttribute("aria-expanded", "false")
			}
		})
		form?.addEventListener("submit", (event) => {
			const min = Number(minInput?.value),
				max = Number(maxInput?.value)
			const hasMin = minInput?.value.trim() !== "",
				hasMax = maxInput?.value.trim() !== ""
			const unresolvedDestination = input.value.trim() !== "" && hiddenInput.value === ""
			const invalid =
				(hasMin && (!Number.isFinite(min) || min < 0)) ||
				(hasMax && (!Number.isFinite(max) || max < 0)) ||
				(hasMin && hasMax && min > max) ||
				unresolvedDestination
			if (!invalid) {
				if (!hiddenInput.value) hiddenInput.disabled = true
				const dateInput = form.querySelector('[name="startDate"]')
				if (dateInput instanceof HTMLInputElement && !dateInput.value) dateInput.disabled = true
				if (currencyInput instanceof HTMLSelectElement) {
					if ((hasMin || hasMax) && !currencyInput.value) {
						currencyInput.value = "BOB"
						currencyInput.dispatchEvent(new Event("change", { bubbles: true }))
					}
					if (!(hasMin || hasMax)) currencyInput.disabled = true
				}
				return
			}
			event.preventDefault()
			if (filtersPanel instanceof HTMLElement) setFiltersOpen(true)
			if (error instanceof HTMLElement) {
				error.textContent = unresolvedDestination
					? "Elige un destino de la lista o borra el texto para explorar toda Bolivia."
					: "Revisa que el precio mínimo no sea mayor que el máximo."
				error.classList.remove("hidden")
				if (unresolvedDestination) input.focus()
			}
		})
	}

	bindTourSearchForm()
	document.addEventListener("DOMContentLoaded", bindTourSearchForm)
	document.addEventListener("astro:page-load", bindTourSearchForm)
</script>
