---
import Button from "@/components/ui/Button.astro"
import DatesModal from "@/components/ui/DatesModal.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import { TOUR_DIFFICULTY_OPTIONS } from "@/lib/tours/tourDifficulty"
import { and, asc, db, eq, ProductCategory } from "@/shared/infrastructure/db/compat"

const durationOptions = [
	{ value: "lt1", label: "Medio día / <1 día" },
	{ value: "1", label: "1 día" },
	{ value: "2-3", label: "2-3 días" },
	{ value: "4-7", label: "4-7 días" },
	{ value: "8+", label: "8+ días" },
]

const sortOptions = [
	{ value: "relevance", label: "Más relevantes" },
	{ value: "price_asc", label: "Precio: menor primero" },
	{ value: "price_desc", label: "Precio: mayor primero" },
	{ value: "duration_asc", label: "Duración: corta primero" },
	{ value: "rating_desc", label: "Mejor calificados" },
]

let categories: Array<{ id: string; slug: string; name: string }> = []
try {
	categories = await db
		.select({
			id: ProductCategory.id,
			slug: ProductCategory.slug,
			name: ProductCategory.name,
		})
		.from(ProductCategory)
		.where(
			and(
				eq(ProductCategory.vertical, "tour"),
				eq(ProductCategory.isActive, true),
				eq(ProductCategory.dataClass, "production")
			)
		)
		.orderBy(asc(ProductCategory.sortOrder), asc(ProductCategory.name))
} catch {
	categories = []
}
---

<div class="sticky top-0 z-40 mx-auto w-full max-w-4xl">
	<form
		id="tourSearchForm"
		action="/buscar/tours"
		method="get"
		class="fastt-card grid grid-cols-1 gap-3 border bg-white p-4 md:grid-cols-3"
	>
		<div class="col-span-1 md:col-span-1">
			<label for="destinationInput" class="mb-1 block text-sm font-semibold text-slate-800"
				>Destino</label
			>
			<div class="relative text-slate-900">
				<Input
					id="destinationInput"
					autocomplete="off"
					type="search"
					placeholder="Ciudad, región o parque..."
				/>
				<input type="hidden" id="destinationPath" name="destino" />
				<ul
					id="destinationsList"
					class="fastt-soft-box absolute left-0 right-0 z-50 mt-1 hidden max-h-56 overflow-auto border border-slate-200 bg-white text-sm"
				>
				</ul>
			</div>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label class="mb-1 block text-sm font-semibold text-slate-800">
				Fecha de inicio <span class="font-normal text-slate-500">(requerida)</span>
			</label>
			<DatesModal id="startDate" name="startDate" className="w-full" required />
		</div>

		<div class="col-span-1 md:col-span-1">
			<label for="duration" class="mb-1 block text-sm font-semibold text-slate-800">Duración</label>
			<Select name="duration" id="duration">
				<option value="">Cualquiera</option>
				{durationOptions.map((d) => <option value={d.value}>{d.label}</option>)}
			</Select>
		</div>

		<div class="col-span-1 md:col-span-3">
			<label class="mb-1 block text-sm font-semibold text-slate-800">Actividades</label>
			<div id="activitiesWrap" class="flex flex-wrap gap-2">
				{
					categories.length === 0 ? (
						<p class="text-sm text-slate-500">Categorías aún no sembradas en discovery.</p>
					) : (
						categories.map((cat) => (
							<label class="fastt-soft-box inline-flex items-center gap-2 bg-slate-50 px-2 py-1 text-sm">
								<input type="checkbox" name="category" value={cat.slug} class="h-4 w-4" />
								<span class="text-slate-700">{cat.name}</span>
							</label>
						))
					)
				}
			</div>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label for="level" class="mb-1 block text-sm font-semibold text-slate-800">Nivel</label>
			<Select name="level" id="level">
				<option value="">Cualquiera</option>
				{TOUR_DIFFICULTY_OPTIONS.map((level) => <option value={level.value}>{level.label}</option>)}
			</Select>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label class="mb-1 block text-sm font-semibold text-slate-800">Precio (mín - máx)</label>
			<div class="flex gap-2">
				<Input name="priceMin" type="number" min="0" placeholder="Min" class="w-1/2" />
				<Input name="priceMax" type="number" min="0" placeholder="Max" class="w-1/2" />
			</div>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label for="sort" class="mb-1 block text-sm font-semibold text-slate-800">Orden</label>
			<Select name="sort" id="sort">
				{sortOptions.map((s) => <option value={s.value}>{s.label}</option>)}
			</Select>
		</div>

		<div class="col-span-1 flex justify-end md:col-span-3">
			<Button type="submit">Buscar tours</Button>
		</div>
	</form>
</div>

<script type="module">
	const qs = (s, el = document) => el.querySelector(s)

	function debounce(fn, wait = 200) {
		let t
		return (...args) => {
			clearTimeout(t)
			t = setTimeout(() => fn(...args), wait)
		}
	}

	async function fetchDestinations(q) {
		if (!q) return []
		const res = await fetch(`/api/destinations?q=${encodeURIComponent(q)}&limit=8`)
		if (!res.ok) return []
		return res.json()
	}

	function renderDestinations(listEl, items) {
		listEl.innerHTML = ""
		if (!items || items.length === 0) {
			listEl.classList.add("hidden")
			return
		}
		for (const d of items) {
			const li = document.createElement("li")
			li.tabIndex = 0
			li.className = "cursor-pointer px-3 py-2 text-slate-800 hover:bg-slate-100"
			li.dataset.canonicalPath = d.canonicalPath || ""
			li.textContent = `${d.name}${d.department ? ", " + d.department : ""}${d.country ? " — " + d.country : ""}`
			listEl.appendChild(li)
		}
		listEl.classList.remove("hidden")
	}

	document.addEventListener("DOMContentLoaded", () => {
		const destInput = qs("#destinationInput")
		const destList = qs("#destinationsList")
		const destinationPath = qs("#destinationPath")

		const debouncedSearch = debounce(async (val) => {
			if (!val || val.trim().length < 1) {
				destList.classList.add("hidden")
				return
			}
			const items = await fetchDestinations(val.trim())
			renderDestinations(destList, items)
		}, 180)

		destInput?.addEventListener("input", (e) => {
			destinationPath.value = ""
			debouncedSearch(e.target.value)
		})

		destList?.addEventListener("click", (e) => {
			const li = e.target.closest("li")
			if (!li) return
			destInput.value = li.textContent
			destinationPath.value = li.dataset.canonicalPath || ""
			destList.classList.add("hidden")
		})
	})
</script>
