---
import Button from "@/components/ui/Button.astro"
import DatesModal from "@/components/ui/DatesModal.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import { publicTourCategories, isTourDurationBucket } from "@/lib/tours/tourDiscoveryFilters"
import { TOUR_DIFFICULTY_OPTIONS } from "@/lib/tours/tourDifficulty"
import { TOUR_DURATION_OPTIONS } from "@/lib/tours/tourSemantics"
import { and, asc, db, eq, ProductCategory } from "@/shared/infrastructure/db/compat"

interface Props {
	destinationPath?: string | null
	destinationName?: string | null
}

const { destinationPath: routeDestinationPath, destinationName: routeDestinationName } =
	Astro.props as Props
const params = Astro.url.searchParams
const selectedDestinationPath = routeDestinationPath ?? params.get("destino") ?? ""
const selectedDestinationName = routeDestinationName ?? ""
const startDate = params.get("startDate") ?? params.get("checkin") ?? ""
const duration = isTourDurationBucket(params.get("duration")) ? params.get("duration") : ""
const level = String(params.get("level") ?? "")
const selectedCategories = new Set(
	params.getAll("category").map((value) => value.trim().toLowerCase())
)
const priceMin = params.get("priceMin") ?? ""
const priceMax = params.get("priceMax") ?? ""
const currency = /^[A-Z]{3}$/.test(String(params.get("currency") ?? "").toUpperCase())
	? String(params.get("currency")).toUpperCase()
	: ""
const sort = String(params.get("sort") ?? "relevance")
const sortOptions = [
	{ value: "relevance", label: "Más relevantes" },
	{ value: "price_asc", label: "Precio: menor primero" },
	{ value: "price_desc", label: "Precio: mayor primero" },
	{ value: "duration_asc", label: "Duración: corta primero" },
	{ value: "rating_desc", label: "Mejor calificados" },
]
const currencyOptions = ["BOB", "USD", "CLP", "EUR"]

let categories: Array<{ id: string; slug: string; name: string }> = []
try {
	categories = publicTourCategories(
		await db
			.select({ id: ProductCategory.id, slug: ProductCategory.slug, name: ProductCategory.name })
			.from(ProductCategory)
			.where(
				and(
					eq(ProductCategory.vertical, "tour"),
					eq(ProductCategory.isActive, true),
					eq(ProductCategory.dataClass, "production")
				)
			)
			.orderBy(asc(ProductCategory.sortOrder), asc(ProductCategory.name))
	)
} catch {
	categories = []
}
---

<div class="sticky top-0 z-40 mx-auto w-full max-w-4xl">
	<form
		id="tourSearchForm"
		action="/buscar/tours"
		method="get"
		novalidate
		class="fastt-card grid grid-cols-1 gap-3 border bg-white p-4 md:grid-cols-3"
	>
		<div class="col-span-1 md:col-span-1">
			<label for="destinationInput" class="mb-1 block text-sm font-semibold text-slate-800"
				>Destino</label
			>
			<div class="relative text-slate-900">
				<Input
					id="destinationInput"
					autocomplete="off"
					type="search"
					value={selectedDestinationName}
					placeholder="Ciudad, región o parque..."
					aria-controls="destinationsList"
					aria-autocomplete="list"
				/>
				<input type="hidden" id="destinationPath" name="destino" value={selectedDestinationPath} />
				<ul
					id="destinationsList"
					role="listbox"
					class="fastt-soft-box absolute left-0 right-0 z-50 mt-1 hidden max-h-56 overflow-auto border border-slate-200 bg-white text-sm"
				>
				</ul>
			</div>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label class="mb-1 block text-sm font-semibold text-slate-800"
				>Fecha de salida <span class="font-normal text-slate-500">(requerida)</span></label
			>
			<DatesModal id="startDate" name="startDate" value={startDate} className="w-full" required />
		</div>

		<div class="col-span-1 md:col-span-1">
			<label for="duration" class="mb-1 block text-sm font-semibold text-slate-800">Duración</label>
			<Select name="duration" id="duration">
				<option value="" selected={!duration}>Cualquiera</option>
				{
					TOUR_DURATION_OPTIONS.map((option) => (
						<option value={option.value} selected={duration === option.value}>
							{option.label}
						</option>
					))
				}
			</Select>
		</div>

		{
			categories.length ? (
				<div class="col-span-1 md:col-span-3">
					<label class="mb-1 block text-sm font-semibold text-slate-800">Actividades</label>
					<div id="activitiesWrap" class="flex flex-wrap gap-2">
						{categories.map((category) => (
							<label class="fastt-soft-box inline-flex items-center gap-2 bg-slate-50 px-2 py-1 text-sm">
								<input
									type="checkbox"
									name="category"
									value={category.slug}
									checked={selectedCategories.has(category.slug.toLowerCase())}
									class="h-4 w-4"
								/>
								<span class="text-slate-700">{category.name}</span>
							</label>
						))}
					</div>
				</div>
			) : null
		}

		<div class="col-span-1 md:col-span-1">
			<label for="level" class="mb-1 block text-sm font-semibold text-slate-800">Nivel</label>
			<Select name="level" id="level">
				<option value="" selected={!level}>Cualquiera</option>
				{
					TOUR_DIFFICULTY_OPTIONS.map((level) => (
						<option
							value={level.value}
							selected={String(params.get("level") ?? "") === level.value}
						>
							{level.label}
						</option>
					))
				}
			</Select>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label class="mb-1 block text-sm font-semibold text-slate-800">Precio por participante</label>
			<div class="flex gap-2">
				<Input
					name="priceMin"
					type="number"
					min="0"
					step="0.01"
					value={priceMin}
					placeholder="Mín."
					class="w-1/2"
				/>
				<Input
					name="priceMax"
					type="number"
					min="0"
					step="0.01"
					value={priceMax}
					placeholder="Máx."
					class="w-1/2"
				/>
			</div>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label for="currency" class="mb-1 block text-sm font-semibold text-slate-800"
				>Moneda del presupuesto</label
			>
			<Select name="currency" id="currency">
				<option value="" selected={!currency}>Elige una moneda si filtras por precio</option>
				{
					currencyOptions.map((option) => (
						<option value={option} selected={currency === option}>
							{option}
						</option>
					))
				}
			</Select>
		</div>

		<div class="col-span-1 md:col-span-1">
			<label for="sort" class="mb-1 block text-sm font-semibold text-slate-800">Orden</label>
			<Select name="sort" id="sort">
				{
					sortOptions.map((option) => (
						<option value={option.value} selected={sort === option.value}>
							{option.label}
						</option>
					))
				}
			</Select>
		</div>

		<p
			id="tourSearchFormError"
			class="col-span-1 hidden text-sm font-medium text-red-700 md:col-span-3"
			role="alert"
		>
		</p>
		<div class="col-span-1 flex justify-end md:col-span-3">
			<Button type="submit">Buscar tours</Button>
		</div>
	</form>
</div>

<script type="module">
	const qs = (selector, element = document) => element.querySelector(selector)
	function debounce(fn, wait = 200) {
		let timer
		return (...args) => {
			clearTimeout(timer)
			timer = setTimeout(() => fn(...args), wait)
		}
	}
	async function fetchDestinations(query) {
		if (!query) return []
		const response = await fetch(`/api/destinations?q=${encodeURIComponent(query)}&limit=8`)
		return response.ok ? response.json() : []
	}
	function selectDestination(option, input, hiddenInput, list) {
		input.value = option.dataset.label || option.textContent || ""
		hiddenInput.value = option.dataset.canonicalPath || ""
		list.classList.add("hidden")
		input.focus()
	}
	function renderDestinations(list, items, input, hiddenInput) {
		list.innerHTML = ""
		if (!items?.length) return list.classList.add("hidden")
		for (const destination of items) {
			const label = `${destination.name}${destination.department ? `, ${destination.department}` : ""}${destination.country ? ` — ${destination.country}` : ""}`
			const item = document.createElement("li")
			const button = document.createElement("button")
			button.type = "button"
			button.role = "option"
			button.className =
				"block w-full px-3 py-2 text-left text-slate-800 hover:bg-slate-100 focus:bg-slate-100"
			button.dataset.canonicalPath = destination.canonicalPath || ""
			button.dataset.label = label
			button.textContent = label
			button.addEventListener("click", () => selectDestination(button, input, hiddenInput, list))
			item.appendChild(button)
			list.appendChild(item)
		}
		list.classList.remove("hidden")
	}
	document.addEventListener("DOMContentLoaded", () => {
		const form = qs("#tourSearchForm"),
			input = qs("#destinationInput"),
			list = qs("#destinationsList"),
			hiddenInput = qs("#destinationPath")
		const minInput = qs('input[name="priceMin"]'),
			maxInput = qs('input[name="priceMax"]'),
			currencyInput = qs('select[name="currency"]'),
			error = qs("#tourSearchFormError")
		if (
			!(input instanceof HTMLInputElement) ||
			!(list instanceof HTMLElement) ||
			!(hiddenInput instanceof HTMLInputElement)
		)
			return
		const search = debounce(async (value) => {
			if (!value?.trim()) return list.classList.add("hidden")
			renderDestinations(list, await fetchDestinations(value.trim()), input, hiddenInput)
		}, 180)
		input.addEventListener("input", (event) => {
			hiddenInput.value = ""
			search(event.target.value)
		})
		input.addEventListener("keydown", (event) => {
			if (event.key === "ArrowDown") {
				list.querySelector("button")?.focus()
				event.preventDefault()
			}
			if (event.key === "Escape") list.classList.add("hidden")
		})
		form?.addEventListener("submit", (event) => {
			const min = Number(minInput?.value),
				max = Number(maxInput?.value)
			const hasMin = minInput?.value.trim() !== "",
				hasMax = maxInput?.value.trim() !== ""
			const invalid =
				(hasMin && (!Number.isFinite(min) || min < 0)) ||
				(hasMax && (!Number.isFinite(max) || max < 0)) ||
				(hasMin && hasMax && min > max) ||
				((hasMin || hasMax) && !currencyInput?.value)
			if (!invalid) return
			event.preventDefault()
			if (error instanceof HTMLElement) {
				error.textContent =
					"Elige la moneda del presupuesto y revisa que el mínimo no sea mayor que el máximo."
				error.classList.remove("hidden")
			}
		})
	})
</script>
