---
import Button from "@/components/ui/Button.astro"
import {
	withWorkspaceNavigationScope,
	workspaceNavigationScopeFromSearchParams,
} from "@/lib/workspace/verticalContext"
const href = new URL(
	withWorkspaceNavigationScope(
		"/provider/settings/payments",
		workspaceNavigationScopeFromSearchParams(Astro.url.searchParams)
	),
	Astro.url
)
href.searchParams.set("returnTo", Astro.url.pathname + Astro.url.search)
---

<div
	data-financial-contract-summary
	class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-white/10 px-4 py-3"
	aria-live="polite"
>
	<div class="min-w-0">
		<p class="text-sm font-semibold text-white">Condiciones comerciales</p>
		<p data-contract-summary-message class="mt-1 text-sm text-slate-400">
			Comprobando condiciones…
		</p>
	</div>
	<a
		data-contract-summary-link
		href={href.pathname + href.search}
		class="shrink-0 text-sm font-semibold text-slate-200 underline underline-offset-4"
		>Revisar condiciones</a
	>
	<Button
		data-contract-summary-retry
		type="button"
		variant="ghost"
		size="sm"
		hidden
		class="shrink-0 text-slate-200 underline underline-offset-4 hover:bg-transparent hover:text-white"
		>Reintentar</Button
	>
</div>
