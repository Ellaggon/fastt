---
const calendarCells = Array.from({ length: 28 })
const calendarWeekdays = Array.from({ length: 7 })
const rateRows = Array.from({ length: 4 })
const rateColumns = Array.from({ length: 6 })
---

<div
	class="workspace-navigation-pending"
	data-workspace-navigation-pending
	data-kind="generic"
	hidden
	aria-hidden="true"
>
	<div class="workspace-navigation-pending__inner" role="status" aria-label="Cargando página">
		<div class="workspace-navigation-pending__progress" aria-hidden="true"></div>

		<div
			class="workspace-navigation-skeleton workspace-navigation-skeleton--calendar"
			data-pending-calendar
		>
			<div class="workspace-skeleton-line h-3 w-40"></div>
			<div class="workspace-skeleton-line h-8 w-56"></div>
			<div class="workspace-skeleton-line h-4 w-full max-w-2xl"></div>
			<div class="mt-6 flex gap-2">
				<div class="workspace-skeleton-line h-9 w-28"></div>
				<div class="workspace-skeleton-line h-9 w-36"></div>
			</div>
			<div class="workspace-skeleton-calendar-panel mt-5">
				<div class="flex items-center justify-between gap-4">
					<div class="workspace-skeleton-line workspace-skeleton-line--light h-8 w-36"></div>
					<div class="flex gap-2">
						<div class="workspace-skeleton-line workspace-skeleton-line--light size-8"></div>
						<div class="workspace-skeleton-line workspace-skeleton-line--light size-8"></div>
					</div>
				</div>
				<div class="mt-3 grid grid-cols-7 gap-1.5 md:gap-2">
					{calendarWeekdays.map(() => <div class="workspace-skeleton-weekday" />)}
					{
						calendarCells.map((_, index) => (
							<div class="workspace-skeleton-cell">
								<div class="workspace-skeleton-date" />
								{index % 3 !== 0 && <div class="workspace-skeleton-value" />}
							</div>
						))
					}
				</div>
			</div>
		</div>

		<div
			class="workspace-navigation-skeleton workspace-navigation-skeleton--rates"
			data-pending-rates
		>
			<div class="workspace-skeleton-line h-3 w-44"></div>
			<div class="workspace-skeleton-line h-8 w-40"></div>
			<div class="workspace-skeleton-line h-4 w-full max-w-xl"></div>
			<div class="workspace-skeleton-rates-panel mt-6">
				<div class="workspace-skeleton-rates-tabs">
					<div class="flex min-w-0 gap-2 overflow-hidden">
						<div class="workspace-skeleton-rate-tab w-36"></div>
						<div class="workspace-skeleton-rate-tab w-20"></div>
						<div class="workspace-skeleton-rate-tab w-24"></div>
						<div class="workspace-skeleton-rate-tab w-20"></div>
					</div>
					<div class="workspace-skeleton-rate-bar hidden h-3 w-36 sm:block"></div>
				</div>
				<div class="workspace-skeleton-rates-header">
					{
						rateColumns.map((_, index) => (
							<div class={`workspace-skeleton-rate-bar h-2.5 ${index === 0 ? "w-14" : "w-16"}`} />
						))
					}
				</div>
				<div class="divide-y divide-neutral-200">
					{
						rateRows.map((_, index) => (
							<div class="workspace-skeleton-rate-row">
								<div class="workspace-skeleton-rate-identity space-y-2">
									<div class={`workspace-skeleton-rate-bar h-4 ${index % 2 ? "w-36" : "w-44"}`} />
									<div class="workspace-skeleton-rate-bar h-3 w-52 max-w-full" />
								</div>
								<div class="workspace-skeleton-rate-metric space-y-2">
									<div class="workspace-skeleton-rate-bar h-4 w-20" />
									<div class="workspace-skeleton-rate-bar h-3 w-14" />
								</div>
								<div class="workspace-skeleton-rate-metric space-y-2">
									<div class="workspace-skeleton-rate-bar h-4 w-28 max-w-full" />
									<div class="workspace-skeleton-rate-bar h-3 w-20" />
								</div>
								<div class="workspace-skeleton-rate-metric space-y-2">
									<div class="workspace-skeleton-rate-bar h-4 w-20" />
									<div class="workspace-skeleton-rate-bar h-3 w-24" />
								</div>
								<div class="workspace-skeleton-rate-state space-y-2">
									<div class="workspace-skeleton-rate-badge" />
									<div class="workspace-skeleton-rate-bar h-3 w-24 max-w-full" />
								</div>
								<div class="workspace-skeleton-rate-actions">
									<div class="workspace-skeleton-rate-button" />
									<div class="workspace-skeleton-rate-icon" />
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<div
			class="workspace-navigation-skeleton workspace-navigation-skeleton--rate-plan-detail"
			data-pending-rate-plan-detail
		>
			<div class="workspace-skeleton-line h-3 w-44"></div>
			<div class="workspace-skeleton-line h-8 w-72 max-w-full"></div>
			<div class="workspace-skeleton-line h-4 w-full max-w-2xl"></div>
			<div class="workspace-skeleton-rate-plan-panel mt-6">
				<div class="workspace-skeleton-rate-plan-tabs">
					<div class="workspace-skeleton-rate-tab w-28"></div>
					<div class="workspace-skeleton-rate-tab w-24"></div>
					<div class="workspace-skeleton-rate-tab w-28"></div>
				</div>
				<div class="space-y-4 p-5">
					<div class="workspace-skeleton-rate-plan-block h-28"></div>
					<div class="workspace-skeleton-rate-plan-block h-24"></div>
					<div class="workspace-skeleton-rate-plan-block h-24"></div>
				</div>
			</div>
		</div>

		<div
			class="workspace-navigation-skeleton workspace-navigation-skeleton--generic"
			data-pending-generic
		>
			<div class="workspace-skeleton-line h-3 w-36"></div>
			<div class="workspace-skeleton-line h-8 w-64 max-w-full"></div>
			<div class="workspace-skeleton-line h-4 w-full max-w-2xl"></div>
			<div class="mt-6 grid gap-4 md:grid-cols-2">
				<div class="workspace-skeleton-block"></div>
				<div class="workspace-skeleton-block"></div>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	;(function () {
		if (window.__fasttWorkspacePendingInstalled) return
		window.__fasttWorkspacePendingInstalled = true
		let pendingTimer = 0

		function pendingElement() {
			return document.querySelector("[data-workspace-navigation-pending]")
		}

		function destinationPath(event) {
			try {
				if (event && event.to) return new URL(String(event.to), location.href).pathname
			} catch {}
			return location.pathname
		}

		function kindFor(pathname) {
			if (pathname === "/rates/calendar" || pathname === "/rates/multi-calendar") {
				return "calendar"
			}
			if (/^\/rates\/plans\/[^/]+$/.test(pathname)) return "rate-plan-detail"
			if (pathname.startsWith("/rates/plans")) return "rates"
			return "generic"
		}

		function showPending(kind) {
			const pending = pendingElement()
			if (!pending) return
			pending.dataset.kind = kind
			pending.hidden = false
			pending.setAttribute("aria-hidden", "false")
		}

		function hidePending() {
			window.clearTimeout(pendingTimer)
			pendingTimer = 0
			const pending = pendingElement()
			if (!pending) return
			pending.hidden = true
			pending.setAttribute("aria-hidden", "true")
		}

		document.addEventListener("astro:before-preparation", function (event) {
			window.clearTimeout(pendingTimer)
			const kind = kindFor(destinationPath(event))
			pendingTimer = window.setTimeout(function () {
				showPending(kind)
			}, 120)
		})
		document.addEventListener(
			"click",
			function (event) {
				const target = event.target
				const link =
					target instanceof Element
						? target.closest("[data-context-switcher] [data-workspace-nav]")
						: null
				if (!(link instanceof HTMLAnchorElement)) return
				if (link.getAttribute("aria-current") === "page") return
				window.clearTimeout(pendingTimer)
				try {
					showPending(kindFor(new URL(link.href, location.href).pathname))
				} catch {}
			},
			true
		)
		document.addEventListener("astro:after-swap", hidePending)
		document.addEventListener("astro:page-load", hidePending)
	})()
</script>

<style is:global>
	.workspace-navigation-pending {
		position: absolute;
		inset: 0;
		z-index: 35;
		min-height: min(760px, calc(100vh - 3.5rem));
		background: #000;
	}

	.workspace-navigation-pending[hidden] {
		display: none;
	}

	.workspace-navigation-pending__inner {
		position: relative;
		width: 100%;
		max-width: 80rem;
		margin-inline: auto;
		padding: 1rem 0.75rem;
	}

	.workspace-navigation-pending__progress {
		position: absolute;
		inset: 0 0 auto;
		height: 2px;
		overflow: hidden;
		background: rgb(64 64 64 / 70%);
	}

	.workspace-navigation-pending__progress::after {
		display: block;
		width: 32%;
		height: 100%;
		content: "";
		background: #e5e5e5;
		animation: workspace-navigation-progress 900ms ease-in-out infinite;
	}

	.workspace-navigation-skeleton {
		display: none;
		padding-top: 1rem;
	}

	.workspace-navigation-pending[data-kind="calendar"] [data-pending-calendar],
	.workspace-navigation-pending[data-kind="rates"] [data-pending-rates],
	.workspace-navigation-pending[data-kind="rate-plan-detail"] [data-pending-rate-plan-detail],
	.workspace-navigation-pending[data-kind="generic"] [data-pending-generic] {
		display: block;
	}

	.workspace-skeleton-line,
	.workspace-skeleton-cell,
	.workspace-skeleton-block {
		background: #262626;
		animation: workspace-skeleton-pulse 1.2s ease-in-out infinite;
	}

	.workspace-skeleton-line {
		margin-bottom: 0.65rem;
		border-radius: 6px;
	}

	.workspace-skeleton-calendar-panel {
		padding: 1rem;
		border: 1px solid #e5e5e5;
		border-radius: 8px;
		background: #fafafa;
	}

	.workspace-skeleton-line--light {
		background: #e5e5e5;
	}

	.workspace-skeleton-rate-plan-panel {
		overflow: hidden;
		border: 1px solid #e5e5e5;
		border-radius: 8px;
		background: #fff;
	}

	.workspace-skeleton-rate-plan-tabs {
		display: flex;
		gap: 0.5rem;
		padding: 1rem 1rem 0.75rem;
		border-bottom: 1px solid #e5e5e5;
	}

	.workspace-skeleton-rate-plan-block {
		border-radius: 8px;
		background: #f5f5f5;
		animation: workspace-skeleton-pulse 1.2s ease-in-out infinite;
	}

	.workspace-skeleton-rates-panel {
		overflow: hidden;
		border: 1px solid #e5e5e5;
		border-radius: 8px;
		background: #fff;
	}

	.workspace-skeleton-rates-tabs {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.875rem 1rem;
		border-bottom: 1px solid #e5e5e5;
	}

	.workspace-skeleton-rate-tab,
	.workspace-skeleton-rate-bar,
	.workspace-skeleton-rate-badge,
	.workspace-skeleton-rate-button,
	.workspace-skeleton-rate-icon {
		border-radius: 6px;
		background: #e5e5e5;
		animation: workspace-skeleton-pulse 1.2s ease-in-out infinite;
	}

	.workspace-skeleton-rate-tab {
		flex: 0 0 auto;
		height: 2rem;
	}

	.workspace-skeleton-rates-header {
		display: none;
		grid-template-columns:
			minmax(180px, 1.35fr) minmax(105px, 0.8fr) minmax(150px, 1.1fr) minmax(120px, 0.9fr)
			minmax(130px, 0.9fr) minmax(120px, 0.8fr);
		gap: 0;
		padding: 0.75rem 1rem;
		background: #fafafa;
	}

	.workspace-skeleton-rate-row {
		display: grid;
		min-height: 5rem;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem;
	}

	.workspace-skeleton-rate-metric {
		display: none;
	}

	.workspace-skeleton-rate-badge {
		width: 4.5rem;
		height: 1.5rem;
		background: #d4d4d4;
	}

	.workspace-skeleton-rate-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
	}

	.workspace-skeleton-rate-button {
		width: 4.5rem;
		height: 2rem;
	}

	.workspace-skeleton-rate-icon {
		width: 2rem;
		height: 2rem;
	}

	.workspace-skeleton-weekday {
		width: min(2.5rem, 70%);
		height: 0.65rem;
		margin: 0 auto 0.25rem;
		border-radius: 6px;
		background: #e5e5e5;
		animation: workspace-skeleton-pulse 1.2s ease-in-out infinite;
	}

	.workspace-skeleton-cell {
		min-height: clamp(5rem, 7vw, 6rem);
		padding: 0.5rem;
		border: 1px solid #e5e5e5;
		border-radius: 6px;
		background: #f5f5f5;
	}

	.workspace-skeleton-date {
		width: 1rem;
		height: 1rem;
		border-radius: 5px;
		background: #d4d4d4;
	}

	.workspace-skeleton-value {
		width: 60%;
		height: 0.6rem;
		margin-top: 1.25rem;
		border-radius: 6px;
		background: #e5e5e5;
	}

	.workspace-skeleton-block {
		min-height: 12rem;
		border: 1px solid #262626;
		background: #171717;
	}

	@media (min-width: 640px) {
		.workspace-navigation-pending__inner {
			padding: 2rem 1.5rem;
		}
	}

	@media (min-width: 768px) {
		.workspace-skeleton-rates-panel {
			overflow-x: auto;
		}

		.workspace-skeleton-rates-header,
		.workspace-skeleton-rate-row {
			display: grid;
			min-width: 920px;
			grid-template-columns:
				minmax(180px, 1.35fr) minmax(105px, 0.8fr) minmax(150px, 1.1fr) minmax(120px, 0.9fr)
				minmax(130px, 0.9fr) minmax(120px, 0.8fr);
		}

		.workspace-skeleton-rate-row {
			min-height: 5.75rem;
			gap: 0;
			padding: 0;
		}

		.workspace-skeleton-rate-identity,
		.workspace-skeleton-rate-metric,
		.workspace-skeleton-rate-state,
		.workspace-skeleton-rate-actions {
			display: block;
			min-width: 0;
			padding: 1rem;
		}

		.workspace-skeleton-rate-actions {
			display: flex;
		}
	}

	@keyframes workspace-navigation-progress {
		from {
			transform: translateX(-110%);
		}
		to {
			transform: translateX(330%);
		}
	}

	@keyframes workspace-skeleton-pulse {
		0%,
		100% {
			opacity: 0.55;
		}
		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.workspace-navigation-pending__progress::after,
		.workspace-skeleton-line,
		.workspace-skeleton-weekday,
		.workspace-skeleton-cell,
		.workspace-skeleton-block,
		.workspace-skeleton-rate-tab,
		.workspace-skeleton-rate-bar,
		.workspace-skeleton-rate-badge,
		.workspace-skeleton-rate-button,
		.workspace-skeleton-rate-icon,
		.workspace-skeleton-rate-plan-block {
			animation: none;
		}
	}
</style>
