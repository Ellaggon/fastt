---
import DashboardSidebarItem from "@/components/dashboard/DashboardSidebarItem.astro"
import DashboardSidebarSection from "@/components/dashboard/DashboardSidebarSection.astro"
import WorkspaceScopeSwitcher from "@/components/dashboard/WorkspaceScopeSwitcher.astro"
import {
	enterpriseNavigation,
	filterEnterpriseNavigationForDisclosure,
	type SidebarDisclosureMode,
} from "@/lib/backoffice-governance"
import {
	providerNavigationItemId,
	resolveProviderNavigationSelection,
} from "@/lib/dashboard/providerNavigationSelection"
import {
	providerOperationalNavigation,
	resolveOperationalSidebarVertical,
	type ProviderNavigationItemId,
	type ProviderOperationalNavigationItem,
} from "@/lib/dashboard/providerOperationalNavigation"
import type { ProviderSidebarReadiness } from "@/lib/dashboard/providerSidebarReadiness"
import type { WorkspaceShellContext } from "@/lib/dashboard/workspaceRequestContext"
import {
	resolveProviderWorkspaceContext,
	withWorkspaceNavigationScope,
	type WorkspaceNavigationScope,
} from "@/lib/workspace/verticalContext"

interface Props {
	pathname?: string
	currentPath?: string
	workspaceContext: WorkspaceShellContext
	workspaceScope: WorkspaceNavigationScope
}

const { pathname = "", currentPath = pathname, workspaceContext, workspaceScope } = Astro.props
const sidebarData = workspaceContext.sidebarData
const sidebarReadiness: ProviderSidebarReadiness = sidebarData?.summaries ?? {}
const disclosureMode: SidebarDisclosureMode = workspaceContext.disclosureMode
const serviceProductTypes = sidebarData?.productTypes ?? []
const primaryAccommodationHref = sidebarData?.primaryAccommodationHref ?? null
const primaryAccommodationRoomsHref = sidebarData?.primaryAccommodationRoomsHref ?? null
const primaryAccommodationHouseRulesHref = sidebarData?.primaryAccommodationHouseRulesHref ?? null
const visibleNavigationBase = filterEnterpriseNavigationForDisclosure(enterpriseNavigation, {
	mode: disclosureMode,
	productTypes: serviceProductTypes,
})
const contextualHrefs: Partial<Record<ProviderNavigationItemId, string | null>> = {
	"accommodations": primaryAccommodationHref,
	"rooms": primaryAccommodationRoomsHref,
	"house-rules": primaryAccommodationHouseRulesHref,
}
function contextualDestination<T extends ProviderOperationalNavigationItem>(item: T): T {
	const href = contextualHrefs[item.id]
	return href ? { ...item, href } : item
}
const visibleNavigation = visibleNavigationBase.map((section) => ({
	...section,
	items: section.items.map((source) => ({
		...source,
		id: source.id ?? providerNavigationItemId(source.href),
	})),
}))
type SidebarNavigationItem = ProviderOperationalNavigationItem & { navGroup?: string }

function itemSummary(item: SidebarNavigationItem) {
	return sidebarReadiness[item.href] ?? ""
}

function summaryTone(summary: string): "neutral" | "success" | "warning" | "danger" {
	const value = summary.toLocaleLowerCase("es")
	if (
		value.includes("sin precio") ||
		value.includes("incompleto") ||
		value.includes("no disponible")
	) {
		return "danger"
	}
	if (value.includes("requiere atención") || value.includes("pendiente")) return "warning"
	if (value.includes("lista") && !value.includes("incomplet")) return "success"
	return "neutral"
}

const sectionByTitle = new Map(visibleNavigation.map((section) => [section.title, section]))
const serviceTypes = resolveProviderWorkspaceContext({
	productTypes: serviceProductTypes,
}).availableVerticals
const hasHotelService = serviceTypes.includes("hotel")
const onlyHotelService = hasHotelService && new Set(serviceTypes).size === 1
const defaultNavigationGroups = [
	{
		id: "start",
		title: "Inicio",
		sections: ["Inicio"],
		collapsible: false,
	},
	{
		id: "services",
		title: onlyHotelService ? "Servicio" : "Servicios",
		sections: onlyHotelService ? ["Servicios", "Alojamiento"] : ["Servicios"],
		collapsible: false,
	},
	...(onlyHotelService || !hasHotelService
		? []
		: [
				{
					id: "accommodation",
					title: "Alojamiento",
					sections: ["Alojamiento"],
					collapsible: false,
				},
			]),
	{ id: "sales", title: "Venta", sections: ["Venta"], collapsible: false },
	{ id: "bookings", title: "Reservas", sections: ["Reservas"], collapsible: false },
	{ id: "finance", title: "Finanzas", sections: ["Finanzas"], collapsible: false },
	{ id: "analytics", title: "Análisis", sections: ["Analítica"], collapsible: false },
	{ id: "distribution", title: "Distribución", sections: ["Distribución"], collapsible: false },
	{ id: "utilities", title: "Configuración", sections: ["Configuración"], collapsible: false },
]
	.map((group) => ({
		id: group.id,
		heading: group.id === "start" ? undefined : group.title,
		collapsible: group.collapsible,
		items: group.sections.flatMap((title) => sectionByTitle.get(title)?.items ?? []),
	}))
	.filter((group) => group.items.length > 0)

const operationalVertical = resolveOperationalSidebarVertical({
	workspaceScope,
	availableVerticals: serviceTypes,
})
const operationalNavigation = providerOperationalNavigation(operationalVertical)
const navigationGroups = (operationalNavigation ?? defaultNavigationGroups).map((group) => ({
	...group,
	items: group.items.map(contextualDestination),
}))
const activeItemId = resolveProviderNavigationSelection({
	path: currentPath,
	vertical: operationalVertical,
	items: navigationGroups.flatMap((group) => group.items),
})
const isItemActive = (item: SidebarNavigationItem) => item.id === activeItemId
const isSectionActive = (items: readonly SidebarNavigationItem[]) => items.some(isItemActive)

function shouldShowNavGroupHeading(
	item: SidebarNavigationItem,
	index: number,
	items: readonly SidebarNavigationItem[]
) {
	const navGroup = "navGroup" in item ? item.navGroup : undefined
	if (!navGroup) return false
	const previous = items[index - 1]
	return index === 0 || !(previous && "navGroup" in previous && previous.navGroup === navGroup)
}
---

<nav class="space-y-4 pb-5" aria-label="Navegación principal del proveedor">
	<WorkspaceScopeSwitcher workspaceContext={workspaceContext} workspaceScope={workspaceScope} />
	{
		navigationGroups.map((group) => (
			<DashboardSidebarSection
				id={group.id}
				heading={group.heading}
				first={group.id === "start"}
				active={isSectionActive(group.items)}
				collapsible={group.collapsible}
				defaultOpen={!group.collapsible}
			>
				{group.items.map((item, index) => {
					const summary = itemSummary(item)
					return (
						<>
							{shouldShowNavGroupHeading(item, index, group.items) ? (
								<p class="px-2.5 pt-2 text-[10px] font-semibold tracking-[0.12em] text-slate-600 uppercase first:pt-0">
									{"navGroup" in item ? item.navGroup : ""}
								</p>
							) : null}
							<DashboardSidebarItem
								id={item.id}
								href={withWorkspaceNavigationScope(item.href, workspaceScope)}
								label={item.label}
								status={item.status}
								summary={summary}
								summaryTone={summaryTone(summary)}
								active={isItemActive(item)}
								prefetch={true}
							/>
						</>
					)
				})}
			</DashboardSidebarSection>
		))
	}
</nav>
