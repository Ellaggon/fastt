---
import { LogOut, Settings, ShieldCheck } from "@lucide/astro"

import ProfessionalModeToggle from "@/components/dashboard/ProfessionalModeToggle.astro"
import type { SidebarDisclosureMode } from "@/lib/backoffice-governance"
import type { WorkspaceShellContext } from "@/lib/dashboard/workspaceRequestContext"
import { routes } from "@/lib/routes"
import {
	type WorkspaceNavigationScope,
	withWorkspaceNavigationScope,
} from "@/lib/workspace/verticalContext"

interface Props {
	workspaceContext: WorkspaceShellContext
	workspaceScope: WorkspaceNavigationScope
}

const { workspaceContext, workspaceScope } = Astro.props
const user = workspaceContext.user
const email = user?.email?.trim() || "Sin sesión"
const accountInitial = email.slice(0, 1).toUpperCase()
const returnTo = `${Astro.url.pathname}${Astro.url.search}`
const showProfessionalToggle = workspaceContext.showProfessionalToggle
const professionalToolsEnabled = workspaceContext.professionalToolsEnabled
const disclosureMode: SidebarDisclosureMode = workspaceContext.disclosureMode
let lockedReason = ""
if (disclosureMode === "scaled-provider") {
	lockedReason = "Vista profesional activada por escala operativa."
} else if (disclosureMode === "revenue-ops") {
	lockedReason = "Vista profesional activada por rol de revenue."
} else if (disclosureMode === "internal-admin") {
	lockedReason = "Vista profesional activada por rol interno."
} else if (disclosureMode === "professional-tools" && !professionalToolsEnabled) {
	lockedReason = "Vista profesional activada por rol operativo."
}

const accountLinks = [
	{
		href: routes.settings(),
		label: "Configuración",
		Icon: Settings,
	},
	{
		href: routes.verification(),
		label: "Verificación",
		Icon: ShieldCheck,
	},
]
const availableVerticals = workspaceContext.sidebarData?.productTypes ?? []
const hasHotel = availableVerticals.some((type) => String(type).toLowerCase() === "hotel")
const hasTours = availableVerticals.some((type) => String(type).toLowerCase() === "tour")
const scopeHref = (vertical: "hotel" | "tour" | null) =>
	withWorkspaceNavigationScope(returnTo, { vertical, productId: null })
---

<header class="bg-black">
	<div
		class="mx-auto flex min-h-14 max-w-7xl items-center gap-3 px-4 py-2.5 sm:px-6 lg:justify-end"
	>
		<a
			href={routes.providerSettings()}
			class="min-w-0 shrink-0 text-base font-semibold tracking-tight text-slate-100 lg:hidden"
			data-astro-prefetch
		>
			Fastt
		</a>
		<div
			class="hidden min-w-0 items-center gap-1 rounded-lg border border-white/[0.08] p-1 sm:flex"
		>
			<a
				data-workspace-scope="all"
				class:list={[
					"rounded px-2 py-1 text-xs font-semibold",
					!workspaceScope.vertical
						? "bg-white text-slate-950"
						: "text-slate-300 hover:bg-white/[0.08]",
				]}
				href={scopeHref(null)}>Todo</a
			>
			{
				hasHotel ? (
					<a
						data-workspace-scope="hotel"
						class:list={[
							"rounded px-2 py-1 text-xs font-semibold",
							workspaceScope.vertical === "hotel"
								? "bg-white text-slate-950"
								: "text-slate-300 hover:bg-white/[0.08]",
						]}
						href={scopeHref("hotel")}
					>
						Hotel
					</a>
				) : null
			}
			{
				hasTours ? (
					<a
						data-workspace-scope="tour"
						class:list={[
							"rounded px-2 py-1 text-xs font-semibold",
							workspaceScope.vertical === "tour"
								? "bg-white text-slate-950"
								: "text-slate-300 hover:bg-white/[0.08]",
						]}
						href={scopeHref("tour")}
					>
						Tours
					</a>
				) : null
			}
		</div>
		{
			showProfessionalToggle ? (
				<div class="hidden min-w-0 flex-1 items-center justify-center gap-2 sm:flex lg:mr-auto lg:flex-none">
					<ProfessionalModeToggle
						enabled={professionalToolsEnabled}
						disclosureMode={disclosureMode}
						lockedReason={lockedReason}
						returnTo={returnTo}
					/>
				</div>
			) : null
		}
		<details class="relative ml-auto">
			<summary
				class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border border-white/[0.08] bg-black text-sm font-semibold text-white transition hover:bg-white/[0.08] [&::-webkit-details-marker]:hidden"
				aria-label="Cuenta"
			>
				{accountInitial}
			</summary>
			<div
				class="absolute right-0 z-50 mt-2 w-72 rounded-xl border border-white/[0.08] bg-black p-3 shadow-2xl"
			>
				<div class="flex items-center gap-3 border-b border-white/[0.08] pb-3">
					<span
						class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-sm font-semibold text-slate-950"
						aria-hidden="true"
					>
						{accountInitial}
					</span>
					<div class="min-w-0">
						<p class="truncate text-sm font-semibold text-white">{email}</p>
						<p class="mt-0.5 text-xs text-slate-400">Cuenta del proveedor</p>
					</div>
				</div>
				{
					showProfessionalToggle ? (
						<div class="border-b border-white/[0.08] py-3 sm:hidden">
							<ProfessionalModeToggle
								enabled={professionalToolsEnabled}
								disclosureMode={disclosureMode}
								lockedReason={lockedReason}
								returnTo={returnTo}
							/>
						</div>
					) : null
				}
				<div class="py-2">
					{
						accountLinks.map(({ href, label, Icon }) => (
							<a
								href={href}
								class="flex min-h-9 items-center gap-3 rounded-md px-2.5 text-sm font-medium text-slate-200 transition hover:bg-white/[0.08] hover:text-white"
								data-astro-prefetch
							>
								<Icon size={17} stroke-width={1.9} class="text-slate-400" aria-hidden="true" />
								<span>{label}</span>
							</a>
						))
					}
				</div>
				<a
					href="/api/auth/logout"
					class="flex min-h-9 items-center gap-3 rounded-md border-t border-white/[0.08] px-2.5 pt-3 text-sm font-semibold text-slate-100 transition hover:text-white"
				>
					<LogOut size={17} stroke-width={1.9} class="text-slate-400" aria-hidden="true" />
					<span>Salir</span>
				</a>
			</div>
		</details>
	</div>
</header>
<script is:inline>
	document.querySelectorAll("[data-workspace-scope]").forEach((link) => {
		link.addEventListener("click", () => {
			try {
				localStorage.setItem(
					"fastt.workspace.scope",
					link.getAttribute("data-workspace-scope") || "all"
				)
			} catch {}
		})
	})
</script>
