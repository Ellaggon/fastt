---
import {
	ChevronRight,
	LogOut,
	Menu,
	Settings,
	ShieldCheck,
	SlidersHorizontal,
	X,
} from "@lucide/astro"

import DashboardSidebar from "@/components/dashboard/DashboardSidebar.astro"
import WorkspacePreferencesDrawer from "@/components/dashboard/WorkspacePreferencesDrawer.astro"
import AccommodationContextSwitcher from "@/components/product/AccommodationContextSwitcher.astro"
import ProductContextSwitcher from "@/components/product/ProductContextSwitcher.astro"
import ProviderAccountSwitcher from "@/components/provider/ProviderAccountSwitcher.astro"
import FiscalScopeSwitcher from "@/components/tax-fees/FiscalScopeSwitcher.astro"
import Button from "@/components/ui/Button.astro"
import Drawer from "@/components/ui/Drawer.astro"
import IconButton from "@/components/ui/IconButton.astro"
import type { WorkspaceShellContext } from "@/lib/dashboard/workspaceRequestContext"
import { routes } from "@/lib/routes"
import type { WorkspaceNavigationScope } from "@/lib/workspace/verticalContext"

interface Props {
	workspaceContext: WorkspaceShellContext
	workspaceScope: WorkspaceNavigationScope
	pathname: string
	currentPath: string
}

const { workspaceContext, workspaceScope, pathname, currentPath } = Astro.props
const user = workspaceContext.user
const email = user?.email?.trim() || "Sin sesión"
const accountInitial = email.slice(0, 1).toUpperCase()
const returnTo = `${Astro.url.pathname}${Astro.url.search}`
const showProfessionalToggle = workspaceContext.showProfessionalToggle
const lockedReason = workspaceContext.workspaceExperienceLockedReason ?? ""

const accountLinks = [
	{
		href: routes.settings(),
		label: "Configuración",
		Icon: Settings,
	},
	{
		href: routes.verification(),
		label: "Verificación",
		Icon: ShieldCheck,
	},
]
const currentExperienceLabel =
	workspaceContext.effectiveWorkspaceExperience === "professional" ? "Profesional" : "Esencial"
const isFinancialWorkspace =
	Astro.url.pathname === "/financial" || Astro.url.pathname.startsWith("/financial/")
const isFiscalWorkspace =
	Astro.url.pathname === "/provider/settings/tax-fees" ||
	Astro.url.pathname.startsWith("/provider/settings/tax-fees/")
const providerId = workspaceContext.provider?.providerId ?? ""
const productIdFromPath = (() => {
	const raw = pathname.match(/^\/product\/([^/]+)/)?.[1] ?? ""
	return raw && raw !== "create" ? decodeURIComponent(raw) : ""
})()
const isPlaybookSurface = Boolean(Astro.url.searchParams.get("playbook"))
const isProductWorkspace = Boolean(productIdFromPath) && !isPlaybookSurface
const isHouseRulesWorkspace =
	pathname === "/provider/house-rules" || pathname.startsWith("/provider/house-rules/")
const houseRulesProductId = String(Astro.url.searchParams.get("productId") ?? "").trim()
const productSwitcherTarget = /\/rooms(?:\/|$)/.test(pathname)
	? "rooms"
	: /\/departures(?:\/|$)|\/private-requests(?:\/|$)/.test(pathname)
		? "departures"
		: "detail"
const workspacePath = pathname.replace(/\/$/, "") || "/"
const isVerificationWorkspace =
	workspacePath === "/provider/settings/verification" ||
	workspacePath.startsWith("/provider/settings/verification/")
const isAccountSettingsWorkspace =
	workspacePath === "/provider/settings" ||
	workspacePath.startsWith("/provider/settings/profile") ||
	workspacePath.startsWith("/provider/settings/team") ||
	isVerificationWorkspace
const showContextSwitcher =
	Boolean(providerId) &&
	(isFinancialWorkspace ||
		isFiscalWorkspace ||
		isProductWorkspace ||
		isHouseRulesWorkspace ||
		isAccountSettingsWorkspace)
---

<header class="relative z-40 bg-black">
	<div
		class="relative mx-auto grid min-h-14 max-w-7xl grid-cols-[2.25rem_minmax(0,1fr)_2.25rem] items-center gap-3 px-4 py-2.5 sm:px-6 lg:flex"
	>
		<details class="relative justify-self-start lg:order-last lg:ml-auto">
			<summary
				class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border border-white/[0.08] bg-black text-sm font-semibold text-white transition hover:bg-white/[0.08] [&::-webkit-details-marker]:hidden"
				aria-label="Cuenta"
				data-workspace-account-trigger
			>
				{accountInitial}
			</summary>
			<div
				class="absolute left-0 z-50 mt-2 w-72 rounded-xl border border-white/[0.08] bg-black p-3 shadow-2xl lg:left-auto lg:right-0"
			>
				<div class="flex items-center gap-3 border-b border-white/[0.08] pb-3">
					<span
						class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-sm font-semibold text-slate-950"
						aria-hidden="true"
					>
						{accountInitial}
					</span>
					<div class="min-w-0">
						<p class="truncate text-sm font-semibold text-white">{email}</p>
						<p class="mt-0.5 text-xs text-slate-400">Cuenta del proveedor</p>
					</div>
				</div>
				{
					showProfessionalToggle ? (
						<div class="border-b border-white/[0.08] py-2">
							<Button
								type="button"
								variant="ghost"
								class="h-auto w-full justify-start gap-3 rounded-md px-2.5 py-2.5 text-left text-slate-200 hover:bg-white/[0.08] hover:text-white focus:ring-white focus:ring-offset-slate-950"
								data-workspace-preferences-open
								data-drawer-open="workspace-preferences-drawer"
								aria-controls="workspace-preferences-drawer"
								aria-expanded="false"
							>
								<SlidersHorizontal
									size={17}
									stroke-width={1.9}
									class="shrink-0 text-slate-400"
									aria-hidden="true"
								/>
								<span class="min-w-0 flex-1">
									<span class="block text-sm font-medium">Preferencias de trabajo</span>
									<span class="mt-0.5 block text-xs font-normal text-slate-400">
										{currentExperienceLabel}
									</span>
								</span>
								<ChevronRight
									size={17}
									stroke-width={1.9}
									class="shrink-0 text-slate-500"
									aria-hidden="true"
								/>
							</Button>
						</div>
					) : null
				}
				<div class="py-2">
					{
						accountLinks.map(({ href, label, Icon }) => (
							<a
								href={href}
								class="flex min-h-9 items-center gap-3 rounded-md px-2.5 text-sm font-medium text-slate-200 transition hover:bg-white/[0.08] hover:text-white"
								data-astro-prefetch
							>
								<Icon size={17} stroke-width={1.9} class="text-slate-400" aria-hidden="true" />
								<span>{label}</span>
							</a>
						))
					}
				</div>
				<a
					href="/api/auth/logout"
					class="flex min-h-9 items-center gap-3 rounded-md border-t border-white/[0.08] px-2.5 pt-3 text-sm font-semibold text-slate-100 transition hover:text-white"
				>
					<LogOut size={17} stroke-width={1.9} class="text-slate-400" aria-hidden="true" />
					<span>Salir</span>
				</a>
			</div>
		</details>

		<div class="flex min-w-0 items-center justify-center lg:order-first lg:flex-1 lg:justify-start">
			{
				showContextSwitcher && isFinancialWorkspace ? (
					<AccommodationContextSwitcher
						providerId={providerId}
						target="financial"
						variant="topbar"
					/>
				) : showContextSwitcher && isFiscalWorkspace ? (
					<FiscalScopeSwitcher providerId={providerId} variant="topbar" />
				) : showContextSwitcher && isAccountSettingsWorkspace ? (
					<ProviderAccountSwitcher variant="topbar" />
				) : showContextSwitcher && isHouseRulesWorkspace ? (
					<ProductContextSwitcher
						providerId={providerId}
						productId={houseRulesProductId}
						target="house-rules"
						variant="topbar"
					/>
				) : showContextSwitcher && isProductWorkspace ? (
					<ProductContextSwitcher
						providerId={providerId}
						productId={productIdFromPath}
						target={productSwitcherTarget}
						variant="topbar"
					/>
				) : (
					<a
						href={routes.providerSettings()}
						class="truncate text-base font-semibold tracking-tight text-slate-100 lg:hidden"
						data-astro-prefetch
					>
						Fastt
					</a>
				)
			}
		</div>

		<IconButton
			type="button"
			variant="ghost"
			size="sm"
			label="Abrir menú"
			class="size-9 justify-self-end rounded-full border border-white/[0.08] text-white hover:bg-white/[0.08] focus:ring-white focus:ring-offset-slate-950 lg:hidden"
			data-drawer-open="workspace-mobile-nav"
			aria-controls="workspace-mobile-nav"
			aria-expanded="false"
		>
			<Menu size={18} stroke-width={2} aria-hidden="true" />
		</IconButton>
	</div>

	{
		showProfessionalToggle ? (
			<WorkspacePreferencesDrawer
				preference={workspaceContext.workspaceExperience}
				effectiveExperience={workspaceContext.effectiveWorkspaceExperience}
				capabilities={workspaceContext.workspaceCapabilities}
				lockedReason={lockedReason}
				returnTo={returnTo}
			/>
		) : null
	}

	<Drawer
		id="workspace-mobile-nav"
		side="right"
		label="Menú"
		class="fastt-side-sheet--dark max-w-80 text-slate-100"
	>
		<div class="flex items-center justify-between gap-3 border-b border-white/[0.08] px-4 py-3">
			<p class="truncate text-base font-semibold text-white">Fastt</p>
			<IconButton
				type="button"
				variant="ghost"
				size="sm"
				label="Cerrar menú"
				class="fastt-modal-close size-9 rounded-full text-white hover:bg-white/[0.08] focus:ring-white focus:ring-offset-slate-950"
				data-drawer-close
			>
				<X size={16} aria-hidden="true" />
			</IconButton>
		</div>
		<div class="min-h-0 flex-1 overflow-y-auto px-3 py-4">
			<DashboardSidebar
				pathname={pathname}
				currentPath={currentPath}
				workspaceContext={workspaceContext}
				workspaceScope={workspaceScope}
			/>
		</div>
	</Drawer>
</header>
