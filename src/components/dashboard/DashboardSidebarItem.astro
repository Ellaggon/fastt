---
import {
	BadgeCheck,
	BarChart3,
	BedDouble,
	BookOpen,
	Building2,
	CalendarDays,
	CalendarRange,
	CarFront,
	ChartNoAxesColumnIncreasing,
	CircleDollarSign,
	ClipboardList,
	Gauge,
	House,
	Layers3,
	LifeBuoy,
	ListChecks,
	Map,
	Package,
	PlugZap,
	ReceiptText,
	Settings,
	WalletCards,
} from "@lucide/astro"

import type { ProviderNavigationItemId } from "@/lib/dashboard/providerOperationalNavigation"

interface Props {
	id: ProviderNavigationItemId
	href: string
	label: string
	status?: "canonical" | "transitional"
	summary?: string
	summaryTone?: "neutral" | "success" | "warning" | "danger"
	active?: boolean
	prefetch?: boolean
	compact?: boolean
}

const {
	id,
	href,
	label,
	status = "canonical",
	summary = "",
	summaryTone = "neutral",
	active = false,
	prefetch = false,
	compact = false,
} = Astro.props

const iconById = {
	"overview": House,
	"bookings": ClipboardList,
	"today": ListChecks,
	"pricing": Layers3,
	"availability": CalendarDays,
	"tour-catalog": Map,
	"accommodations": Building2,
	"rooms": BedDouble,
	"house-rules": BookOpen,
	"finance": WalletCards,
	"settings": Settings,
	"support": LifeBuoy,
	"route:/rates/multi-calendar": CalendarRange,
	"route:/catalog/packages": Package,
	"route:/catalog/limousines": CarFront,
	"route:/financial/collections": CircleDollarSign,
	"route:/financial/settlements": ReceiptText,
	"route:/financial/provider-payables": WalletCards,
	"route:/financial/refunds": ReceiptText,
	"route:/provider/settings/tax-fees": ReceiptText,
	"route:/system/integrations": PlugZap,
	"route:/analytics/revenue": CircleDollarSign,
	"route:/analytics/performance": ChartNoAxesColumnIncreasing,
	"route:/analytics/occupancy": BarChart3,
	"route:/provider/settings/verification": BadgeCheck,
} as const
const Icon = iconById[id as keyof typeof iconById] ?? Gauge
const compactClass = compact ? "py-0.5" : "py-1"
const summaryToneClass = {
	neutral: "text-slate-400",
	success: "text-emerald-300",
	warning: "text-amber-300",
	danger: "text-rose-300",
}[summaryTone]
const shouldShowSummary =
	Boolean(summary) && (active || summaryTone === "warning" || summaryTone === "danger")
---

<div
	class={`group rounded-lg ${compactClass} transition-colors ${
		active ? "bg-white text-slate-950" : "text-slate-200 hover:bg-white/[0.08] hover:text-white"
	}`}
>
	<a
		href={href}
		data-workspace-nav
		data-navigation-id={id}
		aria-current={active ? "page" : undefined}
		data-astro-prefetch={prefetch ? true : undefined}
		data-governance-status={status}
		class="flex min-h-10 items-center gap-3 rounded-lg px-3 text-sm font-semibold text-inherit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/70"
	>
		<Icon
			size={20}
			stroke-width={active ? 2.2 : 1.8}
			class={`shrink-0 ${active ? "text-slate-950" : "text-slate-400 group-hover:text-white"}`}
			aria-hidden="true"
		/>
		<span class="min-w-0 flex-1 truncate">{label}</span>
	</a>
	{
		shouldShowSummary ? (
			<p
				class={`-mt-0.5 truncate pr-3 pb-1 pl-11 text-xs leading-4 ${active ? "text-slate-600" : summaryToneClass}`}
			>
				{summary}
			</p>
		) : null
	}
</div>
