---
import { LayoutPanelTop, X } from "@lucide/astro"

import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Drawer from "@/components/ui/Drawer.astro"
import IconButton from "@/components/ui/IconButton.astro"
import Notice from "@/components/ui/Notice.astro"
import SegmentedControl from "@/components/ui/SegmentedControl.astro"
import type { WorkspaceExperience } from "@/lib/providerUserWorkspacePreference"
import type { ProviderWorkspaceCapabilities } from "@/lib/workspace/providerWorkspaceCapabilities"

interface Props {
	preference: WorkspaceExperience
	effectiveExperience: WorkspaceExperience
	capabilities: ProviderWorkspaceCapabilities
	lockedReason?: string
	returnTo: string
}

const { preference, effectiveExperience, capabilities, lockedReason = "", returnTo } = Astro.props
const effectiveProfessional = effectiveExperience === "professional"
const preferenceProfessional = preference === "professional"
const experienceLabel = effectiveProfessional ? "Profesional" : "Esencial"
const drawerId = "workspace-preferences-drawer"
---

<Drawer
	id={drawerId}
	label="Preferencias de trabajo"
	className="!max-w-[46rem]"
	data-workspace-preferences-drawer
>
	<header
		class="fastt-side-sheet-header sticky top-0 z-10 flex items-start justify-between gap-4 px-5 py-5 sm:px-6"
	>
		<div class="min-w-0">
			<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Preferencias</p>
			<h2 class="mt-1 text-xl font-semibold text-slate-950">Preferencias de trabajo</h2>
			<p class="mt-1 max-w-xl text-sm leading-6 text-slate-600">
				Esta preferencia se aplica solo a tu usuario en esta cuenta de proveedor.
			</p>
		</div>
		<IconButton
			type="button"
			variant="ghost"
			size="sm"
			label="Cerrar preferencias de trabajo"
			data-workspace-preferences-close
		>
			<X size={18} aria-hidden="true" />
		</IconButton>
	</header>

	<div class="flex-1 overflow-y-auto p-5 sm:p-6">
		<section class="fastt-drawer-section p-5" aria-labelledby="workspace-experience-title">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div class="flex min-w-0 items-start gap-3">
					<span
						class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-[var(--fastt-radius-control)] bg-slate-100 text-slate-700"
						aria-hidden="true"
					>
						<LayoutPanelTop size={18} />
					</span>
					<div>
						<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Experiencia</p>
						<h3 id="workspace-experience-title" class="mt-1 text-base font-semibold text-slate-950">
							Experiencia de trabajo
						</h3>
					</div>
				</div>
				<Badge variant={effectiveProfessional ? "success" : "neutral"}>{experienceLabel}</Badge>
			</div>

			<p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600">
				La experiencia Esencial prioriza la operación diaria. La Profesional incorpora vistas de
				escala, calendarios múltiples y acciones masivas cuando están disponibles.
			</p>
			{
				capabilities.canUseMultiCalendar || capabilities.canUseBulkOperations ? (
					<p class="mt-3 text-sm leading-6 text-slate-600">
						Esta cuenta tiene habilitadas capacidades de escala para calendarios múltiples y
						operaciones masivas.
					</p>
				) : null
			}

			{
				lockedReason ? (
					<Notice variant="neutral" class="mt-5" title="Vista profesional administrada">
						{lockedReason}
					</Notice>
				) : (
					<form method="post" action="/api/provider/preferences/professional-tools" class="mt-5">
						<input type="hidden" name="returnTo" value={returnTo} />
						<SegmentedControl
							class="w-full border border-slate-200 bg-slate-50 text-slate-700"
							aria-label="Experiencia de trabajo"
						>
							<Button
								type="submit"
								name="mode"
								value="simple"
								variant="ghost"
								class:list={[
									"min-h-10 flex-1 rounded-[var(--fastt-radius-control)] px-3 text-sm",
									!preferenceProfessional
										? "bg-white text-slate-950 shadow-sm hover:bg-white"
										: "text-slate-600 hover:bg-white/70 hover:text-slate-950",
								]}
								aria-pressed={!preferenceProfessional ? "true" : "false"}
							>
								Esencial
							</Button>
							<Button
								type="submit"
								name="mode"
								value="professional"
								variant="ghost"
								class:list={[
									"min-h-10 flex-1 rounded-[var(--fastt-radius-control)] px-3 text-sm",
									preferenceProfessional
										? "bg-white text-slate-950 shadow-sm hover:bg-white"
										: "text-slate-600 hover:bg-white/70 hover:text-slate-950",
								]}
								aria-pressed={preferenceProfessional ? "true" : "false"}
							>
								Profesional
							</Button>
						</SegmentedControl>
					</form>
				)
			}
		</section>

		<Notice variant="neutral" class="mt-4" title="Qué cambia">
			La experiencia reorganiza solo tus herramientas visibles. No cambia datos de la operación,
			incluidos reservas, precios, disponibilidad, reglas comerciales, impuestos o canales. Los
			permisos siguen siendo los asignados a tu rol.
		</Notice>
	</div>
</Drawer>

<script>
	function setWorkspacePreferencesDrawer(open: boolean, opener?: HTMLElement | null) {
		const drawer = document.querySelector<HTMLElement>("[data-workspace-preferences-drawer]")
		if (!drawer) return
		const overlay = drawer.previousElementSibling

		drawer.classList.toggle("translate-x-0", open)
		drawer.classList.toggle("translate-x-full", !open)
		drawer.setAttribute("aria-hidden", open ? "false" : "true")
		document.documentElement.classList.toggle("overflow-hidden", open)
		document
			.querySelectorAll<HTMLElement>("[data-workspace-preferences-open]")
			.forEach((button) => button.setAttribute("aria-expanded", open ? "true" : "false"))

		if (open && opener) drawer.dataset.workspacePreferencesOpener = "true"
		if (overlay instanceof HTMLElement && overlay.hasAttribute("data-drawer-overlay")) {
			overlay.classList.toggle("pointer-events-none", !open)
			overlay.classList.toggle("opacity-0", !open)
			overlay.classList.toggle("opacity-100", open)
			overlay.onclick = () => setWorkspacePreferencesDrawer(false)
		}

		if (open) {
			requestAnimationFrame(() =>
				drawer.querySelector<HTMLElement>("[data-workspace-preferences-close]")?.focus()
			)
			return
		}
		if (drawer.dataset.workspacePreferencesOpener) {
			const accountTrigger = document.querySelector<HTMLElement>("[data-workspace-account-trigger]")
			accountTrigger?.focus({ preventScroll: true })
			delete drawer.dataset.workspacePreferencesOpener
		}
	}

	document.addEventListener("click", (event) => {
		const target = event.target
		if (!(target instanceof Element)) return
		const openButton = target.closest<HTMLElement>("[data-workspace-preferences-open]")
		if (openButton) {
			openButton.closest("details")?.removeAttribute("open")
			setWorkspacePreferencesDrawer(true, openButton)
			return
		}
		if (target.closest("[data-workspace-preferences-close]")) {
			setWorkspacePreferencesDrawer(false)
		}
	})

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setWorkspacePreferencesDrawer(false)
	})
</script>
