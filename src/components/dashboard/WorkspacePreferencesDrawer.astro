---
import {
	CalendarDays,
	Database,
	Eye,
	Layers,
	LayoutPanelTop,
	ShieldCheck,
	UserRoundCog,
} from "@lucide/astro"

import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Drawer from "@/components/ui/Drawer.astro"
import DrawerFact from "@/components/ui/DrawerFact.astro"
import DrawerHeader from "@/components/ui/DrawerHeader.astro"
import SegmentedControl from "@/components/ui/SegmentedControl.astro"
import type { WorkspaceExperience } from "@/lib/providerUserWorkspacePreference"
import type { ProviderWorkspaceCapabilities } from "@/lib/workspace/providerWorkspaceCapabilities"

interface Props {
	preference: WorkspaceExperience
	effectiveExperience: WorkspaceExperience
	capabilities: ProviderWorkspaceCapabilities
	lockedReason?: string
	returnTo: string
}

const { preference, effectiveExperience, capabilities, lockedReason = "", returnTo } = Astro.props
const effectiveProfessional = effectiveExperience === "professional"
const preferenceProfessional = preference === "professional"
const experienceLabel = effectiveProfessional ? "Profesional" : "Esencial"
const isExperienceLocked = Boolean(lockedReason) || capabilities.requiresProfessionalExperience
const drawerId = "workspace-preferences-drawer"
---

<Drawer
	id={drawerId}
	label="Preferencias de trabajo"
	data-drawer-return-focus="[data-workspace-account-trigger]"
>
	<DrawerHeader
		eyebrow="Preferencias"
		title="Preferencias de trabajo"
		description="Esta preferencia se aplica solo a tu usuario en esta cuenta de proveedor."
		closeLabel="Cerrar preferencias de trabajo"
		titleId="workspace-preferences-title"
	/>

	<div class="fastt-drawer-body space-y-4">
		<section class="fastt-drawer-section p-5" aria-labelledby="workspace-experience-title">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div class="min-w-0">
					<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Experiencia</p>
					<h3 id="workspace-experience-title" class="mt-1 text-base font-semibold text-slate-950">
						Experiencia de trabajo
					</h3>
				</div>
				<Badge variant={effectiveProfessional ? "success" : "neutral"}>{experienceLabel}</Badge>
			</div>

			{
				isExperienceLocked ? (
					<div class="fastt-drawer-facts mt-5">
						<DrawerFact title="Vista profesional por escala">
							<LayoutPanelTop slot="icon" size={18} />
							Esta cuenta usa la vista Profesional por su escala operativa. Incluye calendarios
							múltiples y herramientas avanzadas cuando están disponibles para tu rol.
						</DrawerFact>
						<DrawerFact title="Calendarios múltiples">
							<CalendarDays slot="icon" size={18} />
							Puedes revisar varias tarifas en una sola vista, sin cambiar reservas ni precios.
						</DrawerFact>
						<DrawerFact title="Operaciones masivas">
							<Layers slot="icon" size={18} />
							Las acciones de escala aparecen cuando tu rol y la operación lo permiten.
						</DrawerFact>
						<DrawerFact title="Vista profesional administrada">
							<ShieldCheck slot="icon" size={18} />
							{lockedReason || "Vista profesional activada por la escala operativa de esta cuenta."}
						</DrawerFact>
					</div>
				) : (
					<>
						<p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600">
							La experiencia Esencial prioriza la operación diaria. La Profesional incorpora vistas
							de escala, calendarios múltiples y acciones masivas cuando están disponibles.
						</p>
						{capabilities.canUseMultiCalendar || capabilities.canUseBulkOperations ? (
							<p class="mt-3 text-sm leading-6 text-slate-600">
								Esta cuenta tiene habilitadas capacidades de escala para calendarios múltiples y
								operaciones masivas.
							</p>
						) : null}
						<form method="post" action="/api/provider/preferences/professional-tools" class="mt-5">
							<input type="hidden" name="returnTo" value={returnTo} />
							<SegmentedControl
								class="w-full border border-slate-200 bg-slate-50 text-slate-700"
								aria-label="Experiencia de trabajo"
							>
								<Button
									type="submit"
									name="mode"
									value="simple"
									variant="ghost"
									class:list={[
										"min-h-10 flex-1 rounded-[var(--fastt-radius-control)] px-3 text-sm",
										!preferenceProfessional
											? "bg-white text-slate-950 shadow-sm hover:bg-white"
											: "text-slate-600 hover:bg-white/70 hover:text-slate-950",
									]}
									aria-pressed={!preferenceProfessional ? "true" : "false"}
								>
									Esencial
								</Button>
								<Button
									type="submit"
									name="mode"
									value="professional"
									variant="ghost"
									class:list={[
										"min-h-10 flex-1 rounded-[var(--fastt-radius-control)] px-3 text-sm",
										preferenceProfessional
											? "bg-white text-slate-950 shadow-sm hover:bg-white"
											: "text-slate-600 hover:bg-white/70 hover:text-slate-950",
									]}
									aria-pressed={preferenceProfessional ? "true" : "false"}
								>
									Profesional
								</Button>
							</SegmentedControl>
						</form>
					</>
				)
			}
		</section>

		<section class="fastt-drawer-section p-5" aria-labelledby="workspace-experience-effects">
			<h3 id="workspace-experience-effects" class="text-base font-semibold text-slate-950">
				Qué cambia
			</h3>
			<div class="fastt-drawer-facts mt-4">
				<DrawerFact title="Solo herramientas visibles" muted>
					<Eye slot="icon" size={18} />
					La experiencia reorganiza el menú y las vistas a tu alcance. No cambia el contenido operativo
					de cada pantalla.
				</DrawerFact>
				<DrawerFact title="Los datos se mantienen" muted>
					<Database slot="icon" size={18} />
					No modifica reservas, precios, disponibilidad, reglas comerciales, impuestos o canales.
				</DrawerFact>
				<DrawerFact title="Permisos del rol" muted>
					<UserRoundCog slot="icon" size={18} />
					Los permisos siguen siendo los asignados a tu rol en esta cuenta de proveedor.
				</DrawerFact>
			</div>
		</section>
	</div>
</Drawer>
