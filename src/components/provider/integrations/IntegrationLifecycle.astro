---
import { Check, Circle, TriangleAlert } from "@lucide/astro"

import { providerIntegrationOperationalSteps } from "@/lib/provider-integration-operational-state"

interface Props {
	currentStepIndex: number
	accessComplete?: boolean
	mappingComplete?: boolean
	initialComplete?: boolean
	operationalComplete?: boolean
}

const {
	currentStepIndex,
	accessComplete = false,
	mappingComplete = false,
	initialComplete = false,
	operationalComplete = false,
} = Astro.props

const completedSteps = new Set([
	...(accessComplete ? ["access"] : []),
	...(mappingComplete ? ["mapping", "ready"] : []),
	...(initialComplete ? ["initial_sync"] : []),
	...(operationalComplete ? ["operational"] : []),
])
---

<section
	class="fastt-notice overflow-hidden rounded-lg border border-slate-200 bg-white text-slate-900"
	aria-labelledby="integration-lifecycle-title"
	data-integration-lifecycle
>
	<div class="border-b border-slate-200 px-5 py-4">
		<h2 id="integration-lifecycle-title" class="text-base font-semibold text-slate-950">
			Progreso de la conexión
		</h2>
		<p class="mt-1 text-sm leading-6 text-slate-600">
			Cada etapa se habilita con evidencia del acceso, cobertura y ejecuciones guardadas.
		</p>
	</div>
	<ol class="grid gap-px bg-slate-200 sm:grid-cols-2 xl:grid-cols-6" aria-label="Etapas operativas">
		{
			providerIntegrationOperationalSteps.map((step, index) => {
				const isAttention = step.key === "attention"
				const current = index === currentStepIndex
				const satisfied = !isAttention && completedSteps.has(step.key)
				const done = !current && satisfied
				const Icon = current && isAttention ? TriangleAlert : done ? Check : Circle
				return (
					<li
						class:list={[
							"min-h-16 bg-white p-3 sm:min-h-24 sm:p-4",
							current && isAttention && "bg-amber-50",
							current && !isAttention && "bg-sky-50",
						]}
						aria-current={current ? "step" : undefined}
						data-step={step.key}
						data-step-state={current ? "current" : done ? "complete" : "upcoming"}
					>
						<div class="flex items-start gap-2.5">
							<Icon
								class:list={[
									"mt-0.5 size-4 shrink-0",
									current && isAttention
										? "text-amber-700"
										: current
											? "text-sky-700"
											: done
												? "text-emerald-700"
												: "text-slate-300",
								]}
								aria-hidden="true"
							/>
							<div>
								<p class="text-xs font-semibold text-slate-950">{step.label}</p>
								<p class="mt-1 text-xs leading-5 text-slate-500">
									{current
										? isAttention || satisfied
											? "Estado actual"
											: step.key === "initial_sync"
												? "En curso"
												: "Por completar"
										: done
											? "Completada"
											: isAttention
												? "Solo si hay problemas"
												: "Pendiente"}
								</p>
							</div>
						</div>
					</li>
				)
			})
		}
	</ol>
</section>
