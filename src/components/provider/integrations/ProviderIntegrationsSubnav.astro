---
import TabsInsidePanel from "@/components/ui/TabsInsidePanel.astro"
import { routes } from "@/lib/routes"

interface Props {
	pathname?: string
}

const { pathname = Astro.url.pathname } = Astro.props

const items = [
	{
		label: "Resumen",
		href: routes.providerSettingsIntegrations(),
		active: pathname === routes.providerSettingsIntegrations(),
	},
	{
		label: "Conexiones",
		href: routes.providerSettingsIntegrationsConnections(),
		active:
			pathname === routes.providerSettingsIntegrationsCatalog() ||
			pathname === routes.providerSettingsIntegrationsManage() ||
			pathname.startsWith("/provider/settings/integrations/connect/") ||
			pathname.startsWith(`${routes.providerSettingsIntegrationsConnections()}/`) ||
			pathname === routes.providerSettingsIntegrationsConnections(),
	},
	{
		label: "Incidencias",
		href: routes.providerSettingsIntegrationsIncidents(),
		active: pathname === routes.providerSettingsIntegrationsIncidents(),
	},
	{
		label: "Historial",
		href: routes.providerSettingsIntegrationsActivity(),
		active: pathname === routes.providerSettingsIntegrationsActivity(),
	},
]
---

<TabsInsidePanel
	class="provider-integrations-subnav max-w-full flex-nowrap bg-black"
	aria-label="Navegación de integraciones"
>
	{
		items.map((item) => (
			<a
				href={item.href}
				data-workspace-nav
				data-astro-prefetch="viewport"
				data-active={item.active ? "true" : "false"}
				aria-current={item.active ? "page" : undefined}
				class={`fastt-tabs-inside-panel__item inline-flex min-w-max shrink-0 items-center px-4 py-2 text-sm font-semibold whitespace-nowrap ${
					item.active ? "" : "bg-black text-slate-300 hover:bg-slate-800 hover:text-white"
				}`}
			>
				{item.label}
			</a>
		))
	}
</TabsInsidePanel>

<style>
	.provider-integrations-subnav {
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.provider-integrations-subnav::-webkit-scrollbar {
		display: none;
	}
</style>
