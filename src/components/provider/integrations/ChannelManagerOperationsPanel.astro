---
import {
	Activity,
	CirclePause,
	CirclePlay,
	Link2,
	RefreshCw,
	RotateCcw,
	ShieldCheck,
	TriangleAlert,
} from "@lucide/astro"

import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Checkbox from "@/components/ui/Checkbox.astro"
import Dialog from "@/components/ui/Dialog.astro"
import type { ProviderIntegrationOperationalState } from "@/lib/provider-integration-operational-state"

interface Props {
	connectionId: string
	state: ProviderIntegrationOperationalState
	syncEnabled: boolean
	accessValidated: boolean
	coverageComplete: boolean
	initialSucceeded: boolean
	initialBusy: boolean
	mode: "sandbox" | "production"
	isRevoked: boolean
	credentialRevoked: boolean
	mappingHref: string
	incidentsHref: string
	reconnectHref: string
	testAction: string
	returnTo: string
}

const {
	connectionId,
	state,
	syncEnabled,
	accessValidated,
	coverageComplete,
	initialSucceeded,
	initialBusy,
	mode,
	isRevoked,
	credentialRevoked,
	mappingHref,
	incidentsHref,
	reconnectHref,
	testAction,
	returnTo,
} = Astro.props

const operationEndpoint = `/api/provider/integrations/channel-manager/connections/${encodeURIComponent(connectionId)}/operations`
const canActivateProduction =
	mode === "production" && accessValidated && coverageComplete && !initialSucceeded && !syncEnabled
const needsReconnect = isRevoked || credentialRevoked
---

<section
	class="fastt-notice overflow-hidden rounded-lg border border-slate-200 bg-white text-slate-900 shadow-[var(--fastt-shadow-panel)]"
	data-channel-operations
	data-endpoint={operationEndpoint}
>
	<div class="grid gap-5 p-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
		<div class="flex min-w-0 items-start gap-3">
			<div
				class:list={[
					"flex size-10 shrink-0 items-center justify-center rounded-lg border",
					state.tone === "warning" || state.tone === "error"
						? "border-amber-200 bg-amber-50 text-amber-800"
						: state.tone === "success"
							? "border-emerald-200 bg-emerald-50 text-emerald-700"
							: "border-sky-200 bg-sky-50 text-sky-700",
				]}
			>
				{
					state.stage === "attention" ? (
						<TriangleAlert class="size-5" aria-hidden="true" />
					) : (
						<Activity class="size-5" aria-hidden="true" />
					)
				}
			</div>
			<div>
				<div class="flex flex-wrap items-center gap-2">
					<h2 class="text-lg font-semibold text-slate-950">Operación</h2>
					<Badge variant={state.tone}>{state.label}</Badge>
					{initialSucceeded && !syncEnabled ? <Badge variant="neutral">Pausada</Badge> : null}
				</div>
				<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">{state.description}</p>
			</div>
		</div>

		<div class="flex flex-wrap gap-2 lg:max-w-md lg:justify-end">
			{
				needsReconnect ? (
					<Button href={reconnectHref}>
						<RotateCcw class="size-4" aria-hidden="true" />
						Reconectar
					</Button>
				) : state.stage === "attention" ? null : state.stage === "access" ? (
					<form method="post" action={testAction}>
						<input type="hidden" name="uiMode" value="simple" />
						<input type="hidden" name="connectionId" value={connectionId} />
						<input type="hidden" name="returnTo" value={returnTo} />
						<Button type="submit">
							<ShieldCheck class="size-4" aria-hidden="true" />
							Probar conexión
						</Button>
					</form>
				) : state.stage === "mapping" ? (
					<Button href={mappingHref}>
						<Link2 class="size-4" aria-hidden="true" />
						Completar mapeo
					</Button>
				) : canActivateProduction ? (
					<Button type="button" variant="success" data-open-production>
						<ShieldCheck class="size-4" aria-hidden="true" />
						Activar producción
					</Button>
				) : initialSucceeded ? (
					<>
						<Button type="button" disabled={!syncEnabled || initialBusy} data-operation="sync_now">
							<RefreshCw class="size-4" aria-hidden="true" />
							Sincronizar cambios ahora
						</Button>
						<Button
							type="button"
							variant="secondary"
							data-open-pause={syncEnabled ? "true" : undefined}
							data-operation={!syncEnabled ? "resume" : undefined}
						>
							{syncEnabled ? (
								<CirclePause class="size-4" aria-hidden="true" />
							) : (
								<CirclePlay class="size-4" aria-hidden="true" />
							)}
							{syncEnabled ? "Pausar" : "Reanudar"}
						</Button>
					</>
				) : coverageComplete ? (
					<span class="text-sm font-medium text-slate-600">
						{initialBusy ? "Sincronización en curso" : "Lista para el envío inicial"}
					</span>
				) : (
					<Button href={mappingHref} variant="secondary">
						<Link2 class="size-4" aria-hidden="true" />
						Revisar mapeo
					</Button>
				)
			}
			{
				state.stage === "attention" && !needsReconnect ? (
					<Button href={incidentsHref} variant="secondary">
						<TriangleAlert class="size-4" aria-hidden="true" />
						Ver incidencias
					</Button>
				) : null
			}
		</div>
	</div>

	{
		!isRevoked && state.stage !== "access" ? (
			<div class="flex flex-col gap-3 border-t border-slate-200 bg-slate-50 px-5 py-3 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<p class="text-xs font-semibold text-slate-700">Verificación de acceso</p>
					<p class="mt-0.5 text-xs leading-5 text-slate-500">
						Comprueba la credencial; no envía inventario, tarifas ni reservas.
					</p>
				</div>
				<div class="flex flex-wrap gap-2">
					{initialSucceeded ? (
						<Button type="button" variant="secondary" size="sm" data-open-recovery>
							<RotateCcw class="size-4" aria-hidden="true" />
							Full sync de recuperación
						</Button>
					) : null}
					<form method="post" action={testAction}>
						<input type="hidden" name="uiMode" value="simple" />
						<input type="hidden" name="connectionId" value={connectionId} />
						<input type="hidden" name="returnTo" value={returnTo} />
						<Button type="submit" variant="secondary" size="sm">
							<ShieldCheck class="size-4" aria-hidden="true" />
							Probar conexión
						</Button>
					</form>
				</div>
			</div>
		) : null
	}

	<div
		class="hidden border-t border-slate-200 px-5 py-3"
		data-operation-feedback
		aria-live="polite"
	>
	</div>
</section>

<Dialog
	class="w-[min(32rem,calc(100%-2rem))] rounded-lg shadow-2xl backdrop:bg-slate-950/60"
	data-pause-dialog
>
	<div class="p-5">
		<h2 class="text-lg font-semibold text-slate-950">Pausar sincronización</h2>
		<p class="mt-2 text-sm leading-6 text-slate-600">
			Fastt dejará de enviar cambios y consultar reservas nuevas. Un proceso que ya esté
			ejecutándose puede terminar.
		</p>
		<div class="mt-5 flex justify-end gap-2">
			<Button type="button" variant="secondary" data-close-pause>Cancelar</Button>
			<Button type="button" variant="danger" data-operation="pause">Pausar</Button>
		</div>
	</div>
</Dialog>

{
	initialSucceeded ? (
		<Dialog
			class="w-[min(34rem,calc(100%-2rem))] rounded-lg shadow-2xl backdrop:bg-slate-950/60"
			data-recovery-dialog
		>
			<div class="p-5">
				<h2 class="text-lg font-semibold text-slate-950">Full sync de recuperación</h2>
				<p class="mt-2 text-sm leading-6 text-slate-600">
					Fastt volverá a calcular y enviar 500 días de disponibilidad, tarifas y restricciones.
					Úsalo cuando una interrupción haya dejado Channex desactualizado.
				</p>
				<div class="fastt-notice mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm leading-6 text-amber-950">
					No modifica el mapeo ni recupera datos desde Channex. Los cambios posteriores se enviarán
					de forma incremental.
				</div>
				<div class="mt-5 flex justify-end gap-2">
					<Button type="button" variant="secondary" data-close-recovery>
						Cancelar
					</Button>
					<Button type="button" variant="danger" data-operation="full_recovery_sync">
						<RotateCcw class="size-4" aria-hidden="true" />
						Programar recuperación
					</Button>
				</div>
			</div>
		</Dialog>
	) : null
}

{
	canActivateProduction ? (
		<Dialog
			class="w-[min(34rem,calc(100%-2rem))] rounded-lg shadow-2xl backdrop:bg-slate-950/60"
			data-production-dialog
		>
			<form
				method="post"
				action={`/api/provider/integrations/channel-manager/connections/${encodeURIComponent(connectionId)}/production`}
				class="p-5"
			>
				<input type="hidden" name="confirmProduction" value="ACTIVAR" />
				<input type="hidden" name="returnTo" value={returnTo} />
				<h2 class="text-lg font-semibold text-slate-950">Activar producción</h2>
				<p class="mt-2 text-sm leading-6 text-slate-600">
					La siguiente sincronización enviará disponibilidad, tarifas y restricciones reales al
					channel manager.
				</p>
				<Checkbox
					name="confirmImpact"
					value="confirmed"
					required
					className="fastt-notice mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-950"
				>
					Confirmo que revisé la propiedad y la cobertura de habitaciones y tarifas.
				</Checkbox>
				<div class="mt-5 flex justify-end gap-2">
					<Button type="button" variant="secondary" data-close-production>
						Cancelar
					</Button>
					<Button type="submit" variant="success">
						Activar producción
					</Button>
				</div>
			</form>
		</Dialog>
	) : null
}

<script>
	function setupChannelOperations() {
		document.querySelectorAll<HTMLElement>("[data-channel-operations]").forEach((panel) => {
			if (panel.dataset.ready === "true") return
			panel.dataset.ready = "true"
			const endpoint = panel.dataset.endpoint
			const feedback = panel.querySelector<HTMLElement>("[data-operation-feedback]")
			const pauseDialog = document.querySelector<HTMLDialogElement>("[data-pause-dialog]")
			const productionDialog = document.querySelector<HTMLDialogElement>("[data-production-dialog]")
			const recoveryDialog = document.querySelector<HTMLDialogElement>("[data-recovery-dialog]")
			panel
				.querySelector<HTMLElement>("[data-open-pause]")
				?.addEventListener("click", () => pauseDialog?.showModal())
			panel
				.querySelector<HTMLElement>("[data-open-production]")
				?.addEventListener("click", () => productionDialog?.showModal())
			panel
				.querySelector<HTMLElement>("[data-open-recovery]")
				?.addEventListener("click", () => recoveryDialog?.showModal())
			document
				.querySelector("[data-close-pause]")
				?.addEventListener("click", () => pauseDialog?.close())
			document
				.querySelector("[data-close-production]")
				?.addEventListener("click", () => productionDialog?.close())
			document
				.querySelector("[data-close-recovery]")
				?.addEventListener("click", () => recoveryDialog?.close())

			panel.querySelectorAll<HTMLButtonElement>("[data-operation]").forEach((button) => {
				button.addEventListener("click", async () => {
					const action = button.dataset.operation
					if (!endpoint || !action) return
					const buttons = [...panel.querySelectorAll<HTMLButtonElement>("[data-operation]")]
					buttons.forEach((item) => (item.disabled = true))
					feedback?.classList.remove("hidden")
					if (feedback) {
						feedback.className = "border-t border-slate-200 px-5 py-3 text-sm text-slate-600"
						feedback.textContent =
							action === "sync_now"
								? "Buscando cambios pendientes…"
								: action === "full_recovery_sync"
									? "Programando recuperación completa…"
									: "Actualizando la conexión…"
					}
					try {
						const response = await fetch(endpoint, {
							method: "POST",
							headers: { "Content-Type": "application/json", "Accept": "application/json" },
							body: JSON.stringify({ action }),
						})
						const data = await response.json()
						if (!response.ok || !data.ok)
							throw new Error(data.error ?? "No pudimos completar la acción.")
						if (feedback) {
							feedback.className =
								"border-t border-emerald-200 bg-emerald-50 px-5 py-3 text-sm font-medium text-emerald-900"
							feedback.textContent =
								data.message ??
								(action === "pause"
									? "Sincronización pausada."
									: action === "resume"
										? "Sincronización reanudada."
										: "Los cambios pendientes se enviaron al worker.")
						}
						pauseDialog?.close()
						recoveryDialog?.close()
						window.setTimeout(() => window.location.reload(), 700)
					} catch (error) {
						if (feedback) {
							feedback.className =
								"border-t border-red-200 bg-red-50 px-5 py-3 text-sm font-medium text-red-800"
							feedback.textContent =
								error instanceof Error ? error.message : "No pudimos completar la acción."
						}
						buttons.forEach((item) => (item.disabled = false))
					}
				})
			})
		})
	}

	document.addEventListener("astro:page-load", setupChannelOperations)
	setupChannelOperations()
</script>
