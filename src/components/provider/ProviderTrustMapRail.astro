---
import { Briefcase, CircleDollarSign, ReceiptText, ShieldCheck } from "@lucide/astro"
import Badge from "@/components/ui/Badge.astro"
import TabsInsidePanel from "@/components/ui/TabsInsidePanel.astro"
import {
	isProviderTrustMapComplete,
	TRUST_GLOSSARY,
	type TrustLinkId,
	type ProviderTrustLink,
} from "@/lib/provider-trust-map"

type Props = {
	links?: ProviderTrustLink[]
	activeId?: TrustLinkId | null
}

const { links = [], activeId = null } = Astro.props as Props
const complete = isProviderTrustMapComplete(links)
const iconByLinkId = {
	identity: ShieldCheck,
	business: Briefcase,
	fiscal: ReceiptText,
	payments: CircleDollarSign,
} as const
const statusBadgeByState = {
	ready: "darkSuccess",
	in_review: "darkWarning",
	action_needed: "darkError",
	not_started: "darkNeutral",
	blocked: "darkNeutral",
} as const

function resolveInitialActiveId(): TrustLinkId {
	if (activeId) return activeId
	const pathname = Astro.url.pathname
	if (pathname.includes("/provider/settings/verification/fiscal")) return "fiscal"
	if (pathname.includes("/provider/settings/verification/payments")) return "payments"
	if (pathname.includes("/provider/settings/tax-fees/identity")) return "fiscal"
	if (pathname.includes("/provider/settings/payments")) return "payments"
	return "identity"
}

const currentActiveId = resolveInitialActiveId()
---

{
	links.length ? (
		<div
			class="scroll-mt-24"
			data-trust-map-rail
			data-trust-map-compact="true"
			data-trust-map-quiet="true"
			data-trust-map-complete={complete ? "true" : undefined}
			id="trust-map-rail"
		>
			{complete ? (
				<div class="mb-1.5 flex flex-wrap items-center justify-end gap-2">
					<Badge variant="success" data-trust-map-complete-badge>
						{TRUST_GLOSSARY.page.railComplete}
					</Badge>
				</div>
			) : null}
			<TabsInsidePanel
				aria-label={TRUST_GLOSSARY.page.railTitle}
				class="max-w-full flex-nowrap"
			>
				{links.map((link) => {
					const active = link.id === currentActiveId
					const Icon = iconByLinkId[link.id]
					return (
						<a
							href={link.href}
							data-astro-prefetch="viewport"
							data-trust-link={link.id}
							data-trust-link-state={link.uiState}
							data-trust-link-focus={link.isFocus ? "true" : undefined}
							data-trust-link-active={active ? "true" : undefined}
							data-active={active ? "true" : "false"}
							aria-current={active ? "page" : undefined}
							aria-label={`${link.label}: ${link.stateLabel}`}
							class="fastt-tabs-inside-panel__item"
						>
							<Icon class="h-4 w-4 shrink-0" aria-hidden="true" />
							<span class="fastt-tabs-inside-panel__label">{link.label}</span>
							<Badge
								variant={statusBadgeByState[link.uiState]}
								class="fastt-tabs-inside-panel__status"
								data-trust-link-status
								data-trust-link-status-state={link.uiState}
							>
								<span class="fastt-tabs-inside-panel__status-dot" aria-hidden="true"></span>
								{link.stateLabel}
							</Badge>
						</a>
					)
				})}
			</TabsInsidePanel>
		</div>
	) : null
}

<script>
	import "@/pages/provider/settings/_client/provider-trust-rail.js"
</script>
