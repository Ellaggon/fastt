---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Select from "@/components/ui/Select.astro"
import TabsInsidePanel from "@/components/ui/TabsInsidePanel.astro"
import { safeVerificationReturn } from "@/lib/auth/returnTo"
import type { ProviderTrustLink } from "@/lib/provider-trust-map"
import { TRUST_GLOSSARY } from "@/lib/provider-trust-map"
import type { VerificationNavigation, VerificationPlaybookTab } from "@/lib/verification/navigation"
import { verificationNavigationHref, verificationTabLabel } from "@/lib/verification/navigation"
import {
	ChevronRight,
	CircleDollarSign,
	Compass,
	LifeBuoy,
	ReceiptText,
	ShieldCheck,
} from "@lucide/astro"

type Props = {
	navigation: VerificationNavigation
	url: URL
	products: Array<{ id: string; name: string | null }>
	playbook?: VerificationPlaybookTab[]
	trustLinks?: ProviderTrustLink[]
}

const { navigation, url, products, playbook = [], trustLinks = [] } = Astro.props as Props
const returnTo = safeVerificationReturn(url.searchParams.get("returnTo"))
const navigationPlaybook: VerificationPlaybookTab[] =
	navigation.line === "tour"
		? playbook
		: navigation.tabs.map((tab) => {
				const link = trustLinks.find((entry) => entry.id === tab)
				return {
					id: tab,
					label: verificationTabLabel(tab),
					href: verificationNavigationHref({ url, navigation, line: "lodging", tab }),
					uiState: link?.uiState ?? "not_evaluable",
					stateLabel: link?.stateLabel ?? "No evaluable",
				}
			})
const iconByTab = {
	identity: ShieldCheck,
	activity: Compass,
	safety: LifeBuoy,
	fiscal: ReceiptText,
	payments: CircleDollarSign,
	business: ShieldCheck,
} as const
const statusBadgeByState = {
	ready: "darkSuccess",
	in_review: "darkNeutral",
	action_needed: "darkWarning",
	requires_changes: "darkError",
	not_started: "darkWarning",
	blocked: "darkNeutral",
	not_evaluable: "darkNeutral",
	not_applicable: "darkNeutral",
} as const
const playbookComplete =
	navigationPlaybook.length > 0 &&
	navigationPlaybook.every((tab) => tab.uiState === "ready" || tab.uiState === "not_applicable")
const lineLabels = { lodging: "Alojamientos", tour: "Tours" } as const
const currentLine = navigation.line
/** Licencias y seguro dependen de la experiencia; identidad y fiscal son de cuenta. */
const experienceScopedTab = navigation.tab === "activity" || navigation.tab === "safety"
const showExperienceSelector =
	currentLine === "tour" && Boolean(navigation.experienceId) && products.length > 1
---

<div class="space-y-4" data-verification-business-nav>
	{
		navigation.lines.length > 1 ? (
			<nav aria-label="Línea de negocio" class="flex flex-wrap gap-2" data-verification-line-nav>
				{navigation.lines.map((line) => {
					const active = line === currentLine
					return (
						<a
							href={verificationNavigationHref({ url, navigation, line })}
							data-astro-prefetch="hover"
							aria-current={active ? "page" : undefined}
							data-verification-line-link={line}
							class:list={[
								"rounded-full border px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900",
								active
									? "border-slate-950 bg-slate-950 text-white"
									: "border-slate-200 bg-white text-slate-700 hover:border-slate-400",
							]}
						>
							{lineLabels[line]}
						</a>
					)
				})}
			</nav>
		) : null
	}
	{
		currentLine && navigationPlaybook.length ? (
			<div data-verification-tab-nav data-verification-tour-playbook>
				{playbookComplete ? (
					<div class="mb-1.5 flex flex-wrap items-center justify-end gap-2">
						<Badge variant="success">{TRUST_GLOSSARY.page.railComplete}</Badge>
					</div>
				) : null}
				<TabsInsidePanel
					aria-label={`Verificación de ${lineLabels[currentLine].toLowerCase()}`}
					class="max-w-full flex-nowrap"
				>
					{navigationPlaybook.map((tab) => {
						const active = navigation.tab === tab.id
						const Icon = iconByTab[tab.id]
						return (
							<a
								href={tab.href}
								aria-current={active ? "page" : undefined}
								aria-label={`${tab.label}. Estado: ${tab.stateLabel}.`}
								data-verification-tab-link={tab.id}
								data-active={active ? "true" : "false"}
								class="fastt-tabs-inside-panel__item"
							>
								<Icon class="h-4 w-4 shrink-0" aria-hidden="true" />
								<span class="fastt-tabs-inside-panel__label">{tab.label}</span>
								<Badge
									variant={statusBadgeByState[tab.uiState]}
									class="fastt-tabs-inside-panel__status"
									data-trust-link-status
									data-trust-link-status-state={tab.uiState}
								>
									<span class="fastt-tabs-inside-panel__status-dot" aria-hidden="true" />
									{tab.stateLabel}
								</Badge>
							</a>
						)
					})}
				</TabsInsidePanel>
			</div>
		) : null
	}

	{
		currentLine === "tour" ? (
			<div
				class="fastt-card space-y-4 border border-slate-200 bg-white p-5 text-slate-900 sm:p-6"
				data-verification-experience-context
				hidden={!experienceScopedTab}
			>
				{currentLine === "tour" && !navigation.experienceId ? (
					<p role="status" class="text-base font-semibold text-slate-900">
						{url.searchParams.has("experience")
							? "La experiencia del enlace no está disponible en este negocio. Selecciona una experiencia para continuar."
							: products.length
								? "Selecciona una experiencia."
								: "Crea una experiencia para verificar su operación y seguridad."}
					</p>
				) : null}
				{currentLine === "tour" && !navigation.experienceId && products.length > 0 ? (
					<section
						class="space-y-4"
						aria-label="Experiencias para revisar"
						data-verification-experience-overview
					>
						<p class="text-sm text-slate-600" data-verification-experience-prompt>
							{navigation.tab === "safety"
								? "Elige el tour para revisar sus respaldos de seguridad."
								: "Elige el tour para revisar sus datos de operación y licencias."}
						</p>
						<ul class="grid gap-3 sm:grid-cols-2">
							{products.map((product) => (
								<li>
									<Card
										variant="plain"
										className="bg-slate-50/60 p-0 transition-colors hover:border-slate-400 hover:bg-white hover:shadow-sm"
									>
										<a
											class="block px-4 py-4 text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
											href={verificationNavigationHref({
												url,
												navigation,
												line: "tour",
												tab: navigation.tab,
												experienceId: product.id,
											})}
										>
											<span class="block font-semibold">
												{product.name || "Experiencia sin nombre"}
											</span>
											<span class="mt-2 flex items-center justify-between gap-3 text-sm text-slate-600">
												<span data-verification-experience-action>
													Revisar{" "}
													{navigation.tab === "safety"
														? "seguridad y permisos"
														: "actividad y licencias"}
												</span>
												<ChevronRight class="h-4 w-4 shrink-0" aria-hidden="true" />
											</span>
										</a>
									</Card>
								</li>
							))}
						</ul>
					</section>
				) : null}
				{currentLine === "tour" && navigation.experienceId && products.length === 1 ? (
					<p class="text-sm text-slate-600">
						Experiencia que estás revisando:{" "}
						<strong class="text-slate-900">{products[0]?.name || "Experiencia sin nombre"}</strong>
					</p>
				) : null}
				{showExperienceSelector && products.length > 0 ? (
					<form
						method="get"
						action="/provider/settings/verification"
						class="flex flex-col gap-3"
						data-verification-experience-selector
					>
						<input type="hidden" name="line" value="tour" />
						{returnTo && <input type="hidden" name="returnTo" value={returnTo} />}
						<input type="hidden" name="tab" value={navigation.tab} />
						<input type="hidden" name="tourTab" value={navigation.tab} />
						{url.searchParams.get("lodgingTab") ? (
							<input type="hidden" name="lodgingTab" value={url.searchParams.get("lodgingTab")} />
						) : null}
						<div class="space-y-2">
							<label
								for="verification-experience-select"
								class="block text-sm font-semibold text-slate-700"
							>
								Experiencia que estás revisando
							</label>
							<div class="flex items-center gap-3">
								<Select
									id="verification-experience-select"
									name="experience"
									required
									class="min-w-0 flex-1"
								>
									<option value="" disabled selected={!navigation.experienceId}>
										Selecciona una experiencia
									</option>
									{products.map((product) => (
										<option value={product.id} selected={product.id === navigation.experienceId}>
											{product.name || "Experiencia sin nombre"}
										</option>
									))}
								</Select>
								<Button type="submit" variant="secondary" size="lg" class="shrink-0">
									Cambiar experiencia
								</Button>
							</div>
						</div>
					</form>
				) : null}
			</div>
		) : null
	}
</div>
