---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Checkbox from "@/components/ui/Checkbox.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Notice from "@/components/ui/Notice.astro"
import Select from "@/components/ui/Select.astro"
import { Pencil, Plus, Trash2 } from "@lucide/astro"
import { storedTourActivityClasses } from "@/lib/tours/tour-compliance-context"
import { copyVerificationNavigationQuery } from "@/lib/verification/navigation"
import { tourTerritoryCodes } from "@/lib/tours/tour-operating-territories"
import { readOperatingPlaces } from "@/lib/tours/operating-geography"
import OperatingTerritoryPicker from "@/components/provider/OperatingTerritoryPicker.astro"
import {
	readTourOperation,
	executionLabels,
	executionModes,
	operationCharacteristics,
	tourComplianceActivityLabels,
} from "@/shared/domain/tour-operation"

type Props = {
	productId: string | null
	context: {
		operatingRole: string | null
		activityClassesJson: unknown
		jurisdictionCode: string | null
		jurisdictionCodes?: string[] | null
		operationJson?: unknown
		revision?: number
	} | null
	canEdit: boolean
	resources?: Array<{ id: string; name: string; type: string }>
	result?: string
	error?: string
}
const { productId, context, canEdit, resources = [], result, error } = Astro.props as Props
const operation = readTourOperation(context?.operationJson)
const activities = storedTourActivityClasses(context?.activityClassesJson)
const clarifyWaterAir = !operation && activities.includes("water_air")
const clarifyTransport = !operation && activities.includes("transport")
const foodSelection = operation?.foodHandling ?? (activities.includes("gastronomic") ? "" : "none")
const territories = tourTerritoryCodes(context)
const territoryPlaces = await readOperatingPlaces(territories)
const navigation = new URL(Astro.url)
navigation.searchParams.set("line", "tour")
navigation.searchParams.set("tab", "activity")
const submitUrl = copyVerificationNavigationQuery(
	new URL("/api/provider/settings/tour-operating-context", Astro.url),
	navigation
)
const supportParams = new URLSearchParams({
	line: "tour",
	context: "tour_territory",
	experience: productId ?? "",
	from: `${Astro.url.pathname}${Astro.url.search}`,
})
const legacyTerritory = territories.length !== territoryPlaces.length
const historicalRole = {
	guide: "Guía independiente",
	operator: "Operador",
	intermediary: "Intermediario",
}[context?.operatingRole ?? ""]
const complete = Boolean(operation && territories.length && activities.length && !legacyTerritory)
const partners = resources.filter((resource) => resource.type === "service_operator")
const equipment = resources.filter((resource) => resource.type !== "service_operator")
---

<Card class="space-y-5" data-tour-operating-context>
	<header class="flex flex-wrap items-start justify-between gap-3">
		<div>
			<h3 id="tour-operating-context" tabindex="-1" class="text-base font-semibold text-slate-950">
				Datos de operación
			</h3>
			<p class="mt-1 text-sm text-slate-600">
				Responsables y servicios incluidos en esta experiencia.
			</p>
		</div>
	</header>
	{
		complete && operation && (
			<dl class="grid gap-4 text-sm sm:grid-cols-3" data-operation-saved-summary>
				<div>
					<>
						<dt class="text-xs text-slate-500">Quién la realiza</dt>
						<dd class="mt-1 font-medium text-slate-900">
							{operation.executionMode === "external"
								? (partners.find((partner) => partner.id === operation.operatorResourceId)?.name ??
									"Prestador por revisar")
								: executionLabels[operation.executionMode]}
						</dd>
					</>
				</div>
				<div>
					<>
						<dt class="text-xs text-slate-500">Dónde se realiza</dt>
						<dd class="mt-1 font-medium text-slate-900">
							{territoryPlaces.map((place) => `${place.name} · ${place.country}`).join(", ")}
						</dd>
					</>
				</div>
				<div>
					<>
						<dt class="text-xs text-slate-500">Actividades y servicios</dt>
						<dd class="mt-1 font-medium text-slate-900">
							{[
								...operation.characteristics.map(
									(activity) => tourComplianceActivityLabels[activity]
								),
								operation.guidingService && "Servicio de guía",
								operation.waterActivity && "Actividad acuática",
								operation.airActivity && "Actividad aérea",
								operation.transportServices.length &&
									`${operation.transportServices.length} servicios de transporte`,
								operation.foodHandling !== "none" && "Gastronomía",
							]
								.filter(Boolean)
								.join(" · ") || "Sin servicios adicionales declarados"}
						</dd>
					</>
				</div>
			</dl>
		)
	}
	{
		context && !operation && (
			<Notice variant="info" title="Aclara la operación guardada">
				Conservamos tu declaración anterior. Confirma quién realiza la experiencia y los servicios
				incluidos; no se han supuesto responsables ni permisos.{" "}
				{historicalRole ? `Papel anterior: ${historicalRole}.` : ""}
			</Notice>
		)
	}
	{
		legacyTerritory && (
			<Notice variant="warning" title="Territorio declarado por revisar">
				La declaración anterior «{context?.jurisdictionCode}» se conserva. Confirma un territorio
				válido antes de guardar.
			</Notice>
		)
	}
	{
		result === "context_saved" && (
			<Notice variant="success" title="Operación guardada">
				La declaración no sustituye la revisión de sus respaldos.
			</Notice>
		)
	}
	{
		error && (
			<Notice variant="warning" title="No se guardaron los cambios">
				Revisa la declaración y tus permisos. Los datos anteriores permanecen intactos.
			</Notice>
		)
	}
	{
		productId && (
			<details open={!complete || Boolean(error)} data-operation-editor>
				<summary
					class:list={[
						"fastt-button inline-flex min-h-10 cursor-pointer items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50",
						!complete && "sr-only",
					]}
				>
					<Pencil size={15} aria-hidden="true" />
					{canEdit ? "Editar operación" : "Consultar operación"}
				</summary>
				<form
					method="post"
					action={`${submitUrl.pathname}${submitUrl.search}`}
					class="mt-5 space-y-6 border-t border-slate-100 pt-5"
					data-tour-operating-context-form
					data-operation-complete={complete ? "true" : "false"}
				>
					<input type="hidden" name="productId" value={productId} />
					<input type="hidden" name="revision" value={context?.revision ?? 0} />
					<fieldset disabled={!canEdit} class="space-y-6">
						<section class="space-y-4" aria-labelledby="operation-responsibility-title">
							<h4 id="operation-responsibility-title" class="text-sm font-semibold text-slate-900">
								Quién la realiza
							</h4>
							<FormField label="Responsable de la ejecución" htmlFor="execution-mode" required>
								<Select id="execution-mode" name="executionMode" required>
									<option value="">Selecciona una opción</option>
									{executionModes.map((mode) => (
										<option value={mode} selected={operation?.executionMode === mode}>
											{executionLabels[mode]}
										</option>
									))}
								</Select>
							</FormField>
							<Checkbox
								name="guidingService"
								checked={operation?.guidingService ?? context?.operatingRole === "guide"}
								label="La experiencia incluye un servicio de guía"
								class="fastt-check-option min-h-11 border border-slate-200 p-3"
							/>
							<div data-main-operator hidden={operation?.executionMode !== "external"}>
								<FormField label="Prestador que ejecuta la experiencia" htmlFor="main-operator">
									<Select id="main-operator" name="operatorResourceId" data-operator-select>
										<option value="">Selecciona el prestador</option>
										{partners.map((partner) => (
											<option
												value={partner.id}
												selected={operation?.operatorResourceId === partner.id}
											>
												{partner.name}
											</option>
										))}
									</Select>
								</FormField>
							</div>
							<details class="border-t border-slate-100 pt-3">
								<>
									<summary class="cursor-pointer text-sm font-medium text-slate-700">
										Registrar un prestador externo
									</summary>
									<div class="mt-3 grid gap-3 sm:grid-cols-2" data-partner-registration>
										<FormField label="Nombre legal" htmlFor="partner-name">
											<Input id="partner-name" data-partner-name maxlength="160" />
										</FormField>
										<FormField label="País de registro" htmlFor="partner-country">
											<Input
												id="partner-country"
												data-partner-country
												maxlength="2"
												placeholder="BO"
											/>
										</FormField>
										<FormField
											label="Identificador de registro (opcional)"
											htmlFor="partner-registration"
										>
											<Input id="partner-registration" data-partner-id maxlength="100" />
										</FormField>
										<div class="flex items-end">
											<Button type="button" variant="secondary" data-register-partner>
												<Plus size={15} aria-hidden="true" />
												Registrar prestador
											</Button>
										</div>
										<>
											<p class="text-xs text-slate-500 sm:col-span-2">
												Registrar identifica al prestador; no verifica sus licencias.
											</p>
											<p
												role="status"
												class="text-sm text-slate-700 sm:col-span-2"
												data-partner-status
											/>
										</>
									</div>
								</>
							</details>
						</section>
						<section
							class="space-y-4 border-t border-slate-100 pt-5"
							aria-labelledby="operation-services-title"
						>
							<h4 id="operation-services-title" class="text-sm font-semibold text-slate-900">
								Servicios y actividades incluidos
							</h4>
							<fieldset class="space-y-3">
								<>
									<legend class="mb-3 text-sm text-slate-700">Características del recorrido</legend>
									<div class="grid gap-2 sm:grid-cols-2">
										{operationCharacteristics.map((activity) => (
											<Checkbox
												name="activityClass"
												value={activity.value}
												checked={activities.includes(activity.value as (typeof activities)[number])}
												label={activity.label}
												class="fastt-check-option min-h-11 border border-slate-200 p-3"
											/>
										))}
										<div hidden={clarifyWaterAir}>
											<Checkbox
												name="waterActivity"
												checked={operation?.waterActivity ?? false}
												label="Incluye actividades acuáticas"
												class="fastt-check-option min-h-11 border border-slate-200 p-3"
											/>
										</div>
										<div hidden={clarifyWaterAir}>
											<Checkbox
												name="airActivity"
												checked={operation?.airActivity ?? false}
												label="Incluye actividades aéreas"
												class="fastt-check-option min-h-11 border border-slate-200 p-3"
											/>
										</div>
									</div>
								</>
							</fieldset>
							{clarifyWaterAir && (
								<div class="grid gap-4 sm:grid-cols-2">
									{[
										{ name: "waterDecision", label: "¿Incluye actividades acuáticas?" },
										{ name: "airDecision", label: "¿Incluye actividades aéreas?" },
									].map((question) => (
										<FormField label={question.label} htmlFor={question.name} required>
											<Select name={question.name} id={question.name} required>
												<option value="">Confirma la declaración anterior</option>
												<option value="yes">Sí</option>
												<option value="no">No</option>
											</Select>
										</FormField>
									))}
								</div>
							)}
							<FormField label="Alimentos y bebidas" htmlFor="food-handling">
								<Select name="foodHandling" id="food-handling" required>
									{foodSelection === "" && (
										<option value="" selected>
											Confirma cómo participan los alimentos
										</option>
									)}
									{[
										{ value: "none", label: "No incluye" },
										{ value: "visit", label: "Visita o degustación sin preparación propia" },
										{ value: "serve", label: "Servimos alimentos o bebidas" },
										{ value: "prepare", label: "Preparamos alimentos o bebidas" },
									].map((choice) => (
										<option value={choice.value} selected={foodSelection === choice.value}>
											{choice.label}
										</option>
									))}
								</Select>
							</FormField>
							{clarifyTransport && (
								<FormField
									label="Transporte declarado anteriormente"
									htmlFor="legacy-transport"
									required
								>
									<Select id="legacy-transport" name="legacyTransportDecision" required>
										<option value="">Confirma si está incluido u organizado</option>
										<option value="yes">Sí, identificaré sus servicios y responsables</option>
										<option value="no">No incluye transporte organizado</option>
									</Select>
								</FormField>
							)}
							<div class="space-y-3">
								<>
									<div class="flex flex-wrap items-center justify-between gap-2">
										<>
											<h5 class="text-sm font-medium text-slate-800">
												Transporte incluido u organizado
											</h5>
											<Button type="button" variant="secondary" data-add-transport>
												<Plus size={15} aria-hidden="true" />
												Añadir servicio
											</Button>
										</>
									</div>
									<p class="text-xs text-slate-500">
										No incluyas el transporte que el viajero contrata por su cuenta.
									</p>
									<div class="space-y-3" data-transport-list>
										{(operation?.transportServices ?? []).map((service) => (
											<div
												class="grid gap-3 border-l-2 border-slate-200 pl-3 sm:grid-cols-2"
												data-transport-service
												data-service-id={service.id}
											>
												<Input
													aria-label="Nombre del servicio de transporte"
													data-service-label
													value={service.label}
													placeholder="Ej. traslado al punto de inicio"
													required
													maxlength="120"
												/>
												<Select aria-label="Quién presta el transporte" data-service-provider>
													<option value="business" selected={service.providedBy === "business"}>
														Mi negocio presta el transporte
													</option>
													<option value="external" selected={service.providedBy === "external"}>
														Lo presta un tercero
													</option>
												</Select>
												<Select
													aria-label="Transportista responsable"
													data-service-operator
													data-operator-select
													hidden={service.providedBy !== "external"}
												>
													<option value="">Selecciona el transportista</option>
													{partners.map((partner) => (
														<option
															value={partner.id}
															selected={service.operatorResourceId === partner.id}
														>
															{partner.name}
														</option>
													))}
												</Select>
												<Button
													type="button"
													variant="ghost"
													data-remove-transport
													aria-label="Quitar servicio de transporte"
													title="Quitar servicio"
												>
													<Trash2 size={16} aria-hidden="true" />
												</Button>
											</div>
										))}
									</div>
								</>
							</div>
							<template data-transport-template>
								<div
									class="grid gap-3 border-l-2 border-slate-200 pl-3 sm:grid-cols-2"
									data-transport-service
								>
									<Input
										aria-label="Nombre del servicio de transporte"
										data-service-label
										placeholder="Ej. traslado al punto de inicio"
										required
										maxlength="120"
									/>
									<Select aria-label="Quién presta el transporte" data-service-provider>
										<>
											<option value="business">Mi negocio presta el transporte</option>
											<option value="external">Lo presta un tercero</option>
										</>
									</Select>
									<Select
										aria-label="Transportista responsable"
										data-service-operator
										data-operator-select
										hidden
									>
										<option value="">Selecciona el transportista</option>
										{partners.map((partner) => (
											<option value={partner.id}>{partner.name}</option>
										))}
									</Select>
									<Button
										type="button"
										variant="ghost"
										data-remove-transport
										aria-label="Quitar servicio de transporte"
										title="Quitar servicio"
									>
										<Trash2 size={16} aria-hidden="true" />
									</Button>
								</div>
							</template>
						</section>
						<section
							class="space-y-3 border-t border-slate-100 pt-5"
							aria-labelledby="operation-resources-title"
						>
							<>
								<h4 id="operation-resources-title" class="text-sm font-semibold text-slate-900">
									Personas y recursos
								</h4>
								<p class="text-xs leading-5 text-slate-500">
									Vincula los recursos conocidos de esta experiencia. La asignación concreta por
									salida se mantiene en su operación.
								</p>
							</>
							<div class="grid gap-2 sm:grid-cols-2" data-resource-list>
								{equipment.map((resource) => (
									<Checkbox
										name="resourceId"
										value={resource.id}
										checked={operation?.resourceIds.includes(resource.id) ?? false}
										label={resource.name}
										class="fastt-check-option min-h-11 border border-slate-200 p-3"
									/>
								))}
							</div>
							<template data-resource-template>
								<Checkbox
									name="resourceId"
									class="fastt-check-option min-h-11 border border-slate-200 p-3"
								>
									<span data-resource-label />
								</Checkbox>
							</template>
							<details class="border-t border-slate-100 pt-3">
								<>
									<summary class="cursor-pointer text-sm font-medium text-slate-700">
										Registrar persona o recurso
									</summary>
									<div class="mt-3 grid gap-3 sm:grid-cols-2">
										<FormField label="Nombre" htmlFor="operation-resource-name">
											<Input id="operation-resource-name" data-resource-name maxlength="160" />
										</FormField>
										<FormField label="Tipo" htmlFor="operation-resource-type">
											<Select id="operation-resource-type" data-resource-type>
												<>
													<option value="guide">Guía</option>
													<option value="driver">Conductor</option>
													<option value="vehicle">Vehículo</option>
													<option value="pickup_coordinator">Coordinador de encuentro</option>
												</>
											</Select>
										</FormField>
										<>
											<Button type="button" variant="secondary" data-register-resource>
												<Plus size={15} aria-hidden="true" />
												Registrar recurso
											</Button>
											<p role="status" class="text-sm text-slate-700" data-resource-status />
										</>
									</div>
								</>
							</details>
						</section>
						<fieldset class="space-y-3 border-t border-slate-100 pt-5">
							<>
								<legend class="text-sm font-semibold text-slate-900">
									Territorios de esta experiencia
								</legend>
								<OperatingTerritoryPicker
									name="jurisdictionCodes"
									selected={territories}
									places={territoryPlaces}
								/>
								<p class="text-xs leading-5 text-slate-500">
									Selecciona los territorios del recorrido. Si falta un territorio,{" "}
									<a class="font-medium underline" href={`/provider/support?${supportParams}`}>
										solicita revisión
									</a>
									.
								</p>
							</>
						</fieldset>
						<p class="text-xs text-slate-500">
							Guardar no aprueba la experiencia ni verifica los respaldos.
						</p>
						{canEdit && (
							<div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
								<Button type="button" variant="secondary" data-operation-cancel>
									Cancelar
								</Button>
								<Button type="submit" variant="selection">
									{complete ? "Guardar cambios" : "Guardar operación"}
								</Button>
							</div>
						)}
						<p
							class="text-sm text-slate-700"
							role="status"
							aria-live="polite"
							data-operation-status
						/>
					</fieldset>
				</form>
			</details>
		)
	}
</Card>
<style>
	:global(
		[data-tour-operating-context]:has([data-operation-editor][open]) [data-operation-saved-summary]
	) {
		display: none;
	}
	:global([data-operation-editor] > summary::-webkit-details-marker) {
		display: none;
	}
</style>
<script>
	import "@/lib/ui/tour-operation-editor"
</script>
