---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Checkbox from "@/components/ui/Checkbox.astro"
import FormField from "@/components/ui/FormField.astro"
import Notice from "@/components/ui/Notice.astro"
import Select from "@/components/ui/Select.astro"
import { routes } from "@/lib/routes"
import {
	storedTourActivityClasses,
	tourComplianceActivityClasses,
	tourComplianceActivityLabels,
	type TourOperatingRole,
} from "@/lib/tours/tour-compliance-context"
import {
	tourOperatingTerritories,
	tourOperatingTerritory,
	tourTerritoryCodes,
} from "@/lib/tours/tour-operating-territories"
import { copyVerificationNavigationQuery } from "@/lib/verification/navigation"

type Props = {
	productId: string | null
	context: {
		operatingRole: string | null
		activityClassesJson: unknown
		jurisdictionCode: string | null
		jurisdictionCodes?: string[] | null
	} | null
	canEdit: boolean
	result?: string
	error?: string
}

const { productId, context, canEdit, result, error } = Astro.props as Props
const navigationSource = new URL(Astro.url)
navigationSource.searchParams.set("line", "tour")
navigationSource.searchParams.set("tab", "activity")
const submitUrl = copyVerificationNavigationQuery(
	new URL("/api/provider/settings/tour-operating-context", Astro.url),
	navigationSource
)
const selectedActivities = storedTourActivityClasses(context?.activityClassesJson)
const storedTerritory = context?.jurisdictionCode ?? ""
const selectedTerritories = tourTerritoryCodes(context)
const legacyTerritory = Boolean(storedTerritory && !tourOperatingTerritory(storedTerritory))
const operationComplete = Boolean(
	context?.operatingRole &&
	selectedTerritories.length &&
	selectedActivities.length &&
	!legacyTerritory
)
const editorOpen = !operationComplete || Boolean(error)
const supportParams = new URLSearchParams({
	line: "tour",
	context: "tour_territory",
	experience: productId ?? "",
	from: `${navigationSource.pathname}${navigationSource.search}`,
})
const roles: Array<{ value: TourOperatingRole; label: string }> = [
	{ value: "guide", label: "Guía independiente" },
	{ value: "operator", label: "Empresa operadora" },
	{ value: "intermediary", label: "Intermediario" },
]
const roleHelp: Record<TourOperatingRole, string> = {
	guide: "Tú ejecutas la experiencia como guía independiente.",
	operator: "Tu empresa es responsable de la operación, aunque contrate guías.",
	intermediary:
		"Un tercero ejecuta la experiencia. Su identidad y los respaldos de la operación deben revisarse; esta declaración no los acredita.",
}
const activityHelp: Record<string, string> = {
	urban_cultural: "Recorridos culturales, históricos o urbanos.",
	guided_nature: "Recorridos guiados en entornos naturales.",
	adventure: "Actividades como escalada o descensos, no solo una caminata.",
	transport: "Prestas el traslado; no incluye el transporte que el viajero contrata por su cuenta.",
	water_air: "Actividades acuáticas o aéreas que forman parte de la experiencia.",
	gastronomic:
		"Indica si preparas o sirves alimentos al revisar los respaldos; visitar un restaurante no equivale a manipularlos.",
}
---

<Card class="space-y-5" data-tour-operating-context>
	<div class="max-w-2xl">
		<h2 id="tour-operating-context" class="text-lg font-semibold text-slate-950">
			Cómo operas esta experiencia
		</h2>
		<p class="mt-1 text-sm leading-6 text-slate-600">
			{
				operationComplete
					? "Operación declarada para determinar sus respaldos."
					: "Indica quién opera, dónde y qué actividades incluye. Guardar no aprueba la experiencia."
			}
		</p>
	</div>
	{
		operationComplete && (
			<dl class="grid gap-3 text-sm sm:grid-cols-3" data-operation-saved-summary>
				<div>
					<>
						<dt class="text-xs text-slate-500">Operación</dt>
						<dd class="mt-1 font-medium text-slate-900">
							{roles.find((role) => role.value === context?.operatingRole)?.label}
						</dd>
					</>
				</div>
				<div>
					<>
						<dt class="text-xs text-slate-500">Departamentos</dt>
						<dd class="mt-1 font-medium text-slate-900">
							{selectedTerritories
								.map((code) => tourOperatingTerritory(code)?.label.replace(", Bolivia", ""))
								.join(", ")}
						</dd>
					</>
				</div>
				<div>
					<>
						<dt class="text-xs text-slate-500">Actividades</dt>
						<dd class="mt-1 font-medium text-slate-900">
							{selectedActivities
								.map((activity) => tourComplianceActivityLabels[activity])
								.join(", ")}
						</dd>
					</>
				</div>
			</dl>
		)
	}
	{
		legacyTerritory ? (
			<Notice variant="warning" title="Territorio declarado por revisar">
				La declaración anterior «{storedTerritory}» se conserva. Selecciona el departamento donde
				operas antes de guardar; no lo cambiaremos automáticamente.
			</Notice>
		) : null
	}
	{
		error === "invalid_territory" ? (
			<Notice variant="warning" title="No se guardó el territorio">
				Selecciona un departamento de la lista. La declaración anterior permanece intacta.
			</Notice>
		) : null
	}
	{
		result === "context_saved" ? (
			<Notice variant="success" title="Operación guardada">
				La declaración quedó guardada. Consulta debajo el estado de sus requisitos.
			</Notice>
		) : null
	}
	{
		error === "invalid_context" ? (
			<Notice variant="warning" title="Revisa la declaración">
				Indica quién opera, selecciona un departamento y marca al menos una actividad.
			</Notice>
		) : null
	}
	{
		error === "forbidden" ? (
			<Notice variant="warning" title="Sin permiso para editar">
				Pide acceso de edición del perfil al titular de la cuenta.
			</Notice>
		) : null
	}
	{
		productId ? (
			<details open={editorOpen} data-operation-editor class="space-y-4">
				<summary
					class:list={[
						"cursor-pointer text-sm font-semibold text-slate-800",
						!operationComplete && "sr-only",
					]}
				>
					{canEdit ? "Editar operación" : "Consultar operación declarada"}
				</summary>
				<form
					method="post"
					action={`${submitUrl.pathname}${submitUrl.search}`}
					class="space-y-5"
					data-tour-operating-context-form
				>
					<input type="hidden" name="productId" value={productId} />
					{!canEdit && (
						<p class="text-sm text-slate-600">
							Puedes consultar esta declaración. Pide acceso de edición al titular para cambiarla.
						</p>
					)}
					<fieldset disabled={!canEdit} class="space-y-5">
						<div class="grid gap-4 sm:grid-cols-2">
							<FormField
								label="Tu papel en esta experiencia"
								htmlFor="tour-operating-role"
								required
							>
								<Select id="tour-operating-role" name="operatingRole" required>
									<option value="" selected={!context?.operatingRole}>
										Selecciona quién opera
									</option>
									{roles.map((role) => (
										<option value={role.value} selected={context?.operatingRole === role.value}>
											{role.label}
										</option>
									))}
								</Select>
								{roles.map((role) => (
									<p
										class="text-xs leading-5 text-slate-500"
										data-role-help={role.value}
										hidden={context?.operatingRole !== role.value}
									>
										{roleHelp[role.value]}
									</p>
								))}
							</FormField>
							<FormField
								label="Departamentos donde se realiza"
								htmlFor="tour-jurisdiction-code"
								required
							>
								<fieldset
									id="tour-jurisdiction-code"
									class="grid gap-2 sm:grid-cols-2"
									aria-describedby="tour-territory-help"
								>
									<legend class="sr-only">Selecciona al menos un departamento</legend>
									{tourOperatingTerritories.map((territory) => (
										<Checkbox
											name="jurisdictionCodes"
											value={territory.code}
											checked={selectedTerritories.includes(territory.code)}
											label={territory.label.replace(", Bolivia", "")}
										/>
									))}
								</fieldset>
								<p id="tour-territory-help" class="text-xs leading-5 text-slate-500">
									Selecciona solo los departamentos de esta experiencia. Varias ciudades del mismo
									departamento requieren una sola selección. Si falta tu territorio,{" "}
									<a
										class="font-semibold underline"
										href={`${routes.providerSupport()}?${supportParams}`}
									>
										solicita revisión
									</a>
									. No selecciones uno por aproximación.
								</p>
							</FormField>
						</div>
						<fieldset
							class="space-y-3"
							aria-describedby="tour-activities-help tour-activities-error"
						>
							<legend class="text-sm font-semibold text-slate-800">
								Actividades de esta experiencia{" "}
								<span class="text-red-600" aria-hidden="true">
									*
								</span>
							</legend>
							<p id="tour-activities-help" class="text-xs leading-5 text-slate-500">
								Selecciona al menos una. Incluye solo las que forman parte de esta experiencia.
							</p>
							<div class="grid gap-2 sm:grid-cols-2">
								{tourComplianceActivityClasses.map((activity) => (
									<Checkbox
										class="fastt-check-option min-h-11 border border-slate-200 p-3 has-[:checked]:border-[var(--fastt-color-selection)] has-[:checked]:bg-[var(--fastt-color-selection-soft)]"
										name="activityClass"
										value={activity}
										checked={selectedActivities.includes(activity)}
										label={tourComplianceActivityLabels[activity]}
										data-activity-option={activity}
									/>
								))}
							</div>
							{tourComplianceActivityClasses.map((activity) => (
								<p
									class="text-xs leading-5 text-slate-500"
									data-activity-help={activity}
									hidden={!selectedActivities.includes(activity)}
								>
									{activityHelp[activity]}
								</p>
							))}
							<p
								id="tour-activities-error"
								class="hidden text-sm text-red-600"
								role="alert"
								data-tour-activities-error
							>
								Selecciona al menos una actividad.
							</p>
						</fieldset>
						{canEdit && (
							<div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
								{operationComplete && (
									<Button type="button" variant="secondary" data-operation-cancel>
										Cancelar
									</Button>
								)}
								<Button type="submit" variant="selection">
									{operationComplete ? "Guardar cambios" : "Guardar operación"}
								</Button>
							</div>
						)}
						<p
							class="text-sm text-slate-600"
							role="status"
							aria-live="polite"
							data-operation-status
						/>
					</fieldset>
				</form>
			</details>
		) : (
			<p class="text-sm text-slate-600">
				{productId
					? "Tu rol no permite cambiar estas declaraciones."
					: "Crea una experiencia para declarar cómo se opera."}
			</p>
		)
	}
</Card>

<script>
	function bindOperatingContextValidation() {
		document
			.querySelectorAll<HTMLFormElement>("[data-tour-operating-context-form]")
			.forEach((form) => {
				if (form.dataset.activitiesReady) return
				form.dataset.activitiesReady = "true"
				const activities = Array.from(
					form.querySelectorAll<HTMLInputElement>('input[name="activityClass"]')
				)
				const first = activities[0]
				const error = form.querySelector<HTMLElement>("[data-tour-activities-error]")
				if (!first || first.matches(":disabled")) return
				const role = form.querySelector<HTMLSelectElement>('[name="operatingRole"]')!
				const territories = Array.from(
					form.querySelectorAll<HTMLInputElement>('[name="jurisdictionCodes"]')
				)
				const save = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
				const status = form.querySelector<HTMLElement>("[data-operation-status]")!
				const snapshot = () =>
					JSON.stringify([
						role.value,
						territories.filter((item) => item.checked).map((item) => item.value),
						activities.filter((item) => item.checked).map((item) => item.value),
					])
				const initial = snapshot()
				const editor = form.closest<HTMLDetailsElement>("[data-operation-editor]")
				const updateDirty = () => {
					form.dataset.dirty = snapshot() !== initial ? "true" : "false"
				}
				let pending = false
				const validate = () => {
					updateDirty()
					const valid = activities.some((activity) => activity.checked)
					first.setCustomValidity(valid ? "" : "Selecciona al menos una actividad.")
					if (valid) error?.classList.add("hidden")
					const hasTerritory = territories.some((item) => item.checked)
					territories[0]?.setCustomValidity(
						hasTerritory ? "" : "Selecciona al menos un departamento."
					)
					form.querySelectorAll<HTMLElement>("[data-role-help]").forEach((help) => {
						help.hidden = help.dataset.roleHelp !== role.value
					})
					form.querySelectorAll<HTMLElement>("[data-activity-help]").forEach((help) => {
						help.hidden = !activities.some(
							(item) => item.value === help.dataset.activityHelp && item.checked
						)
					})
					save.disabled =
						pending || snapshot() === initial || !valid || !role.value || !hasTerritory
				}
				form.addEventListener("change", validate)
				form.querySelector("[data-operation-cancel]")?.addEventListener("click", () => {
					form.reset()
					validate()
					status.textContent = ""
					if (editor) {
						editor.open = false
						editor.querySelector("summary")?.focus()
					}
				})
				form.addEventListener("submit", async (event) => {
					event.preventDefault()
					if (pending || !form.reportValidity()) return
					pending = true
					validate()
					status.textContent = "Guardando operación…"
					form.setAttribute("aria-busy", "true")
					try {
						const response = await fetch(form.action, {
							method: "POST",
							body: new FormData(form),
							credentials: "same-origin",
						})
						const target = new URL(response.url)
						if (!response.ok || target.searchParams.get("result") !== "context_saved")
							throw new Error("save_failed")
						form.dataset.dirty = "false"
						window.location.assign(target.href)
					} catch {
						status.textContent =
							"No se pudo guardar. Tus cambios siguen aquí; revisa tu conexión o permisos e inténtalo de nuevo."
						pending = false
						form.removeAttribute("aria-busy")
						validate()
					}
				})
				first.addEventListener("invalid", () => error?.classList.remove("hidden"))
				validate()
			})
	}
	bindOperatingContextValidation()
	document.addEventListener("astro:page-load", bindOperatingContextValidation)
</script>
