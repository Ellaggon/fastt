---
import ProviderReviewWaitNotice from "@/components/provider/ProviderReviewWaitNotice.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import type { ProviderTaxConfigurationRecord } from "@/lib/provider-tax-configuration"
import { fiscalIdentityErrorMessage } from "@/lib/provider-tax-identity-validation"
import { providerTaxRegimes } from "@/lib/provider-tax-configuration"
import { copyVerificationNavigationQuery } from "@/lib/verification/navigation"

type Props = {
	taxConfiguration?: ProviderTaxConfigurationRecord | null
	canManageFiscality?: boolean
	reviewAssignment?: {
		slaDueAt: Date | string | null
		slaState: "ok" | "due_soon" | "overdue" | "done"
	} | null
	formReturnTo?: "taxIdentity" | "verificationFiscal"
	saveError?: string
}

const {
	taxConfiguration = null,
	canManageFiscality = false,
	reviewAssignment = null,
	formReturnTo = "taxIdentity",
	saveError = "",
} = Astro.props as Props
const saveAction = copyVerificationNavigationQuery(
	new URL("/api/provider/settings/tax-configuration", Astro.url),
	Astro.url,
	"fiscal"
)
const status = taxConfiguration?.status ?? "not_configured"
const country = taxConfiguration?.taxResidenceCountry ?? ""
const regime = taxConfiguration?.taxRegime ?? ""
const registration = taxConfiguration?.businessRegistrationNumber ?? ""
const countryOptions = [
	{ value: "BO", label: "Bolivia (BO)" },
	{ value: "CL", label: "Chile (CL)" },
	{ value: "US", label: "Estados Unidos (US)" },
	{ value: "ES", label: "España (ES)" },
	{ value: "PE", label: "Perú (PE)" },
	{ value: "AR", label: "Argentina (AR)" },
] as const
const countryLabel =
	countryOptions.find((item) => item.value === country)?.label ?? (country || "Sin definir")
const regimeLabel =
	providerTaxRegimes.find((item) => item.value === regime)?.label ?? (regime || "Sin definir")
const hasSavedIdentity = Boolean(country || registration || regime)
const showSubmittedRecord = hasSavedIdentity && status !== "not_configured"
const saveErrorMessage = saveError ? fiscalIdentityErrorMessage(saveError) : ""
/** Pending and verified stay read-only until the provider chooses to correct. */
const formStartsOpen =
	Boolean(saveErrorMessage) || !showSubmittedRecord || status === "requires_attention"
const actionLead =
	status === "verified"
		? "La identidad fiscal del negocio está verificada."
		: status === "requires_attention"
			? "Corrige los datos fiscales indicados y vuelve a enviarlos a revisión."
			: status === "pending"
				? "Recibimos tus datos fiscales. Estamos revisando que correspondan al titular del negocio."
				: "Completa el país de residencia fiscal, el identificador tributario y el régimen del negocio."
---

<Card>
	<div class="space-y-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 class="text-xl font-semibold text-slate-950">Identidad fiscal</h2>
				<p class="mt-2 text-sm leading-6 text-slate-600" data-fiscal-action-lead>
					{actionLead}
				</p>
			</div>
			<Badge
				variant={status === "verified"
					? "success"
					: status === "requires_attention"
						? "error"
						: status === "pending"
							? "warning"
							: "neutral"}
			>
				{taxConfiguration?.statusLabel ?? "No configurado"}
			</Badge>
		</div>

		{
			status === "pending" ? (
				<ProviderReviewWaitNotice domain="fiscal" assignment={reviewAssignment} compact />
			) : null
		}

		{
			taxConfiguration?.tinBureau?.matchStatus === "mismatch" ? (
				<Card
					variant="soft"
					class="space-y-2"
					data-tin-bureau-status={taxConfiguration.tinBureau.matchStatus}
					data-tin-bureau-mode={taxConfiguration.tinBureau.mode}
				>
					<div class="flex flex-wrap items-center gap-2">
						<p class="text-sm font-semibold text-slate-900">Verificación del registro</p>
						<Badge variant={taxConfiguration.tinBureau.matchTone}>
							{taxConfiguration.tinBureau.matchLabel}
						</Badge>
					</div>
					<p class="text-sm leading-6 text-slate-600">
						{taxConfiguration.tinBureau.hostNarrative || taxConfiguration.tinBureau.message}
					</p>
				</Card>
			) : null
		}

		{
			canManageFiscality ? (
				<div class="space-y-4">
					{showSubmittedRecord && !formStartsOpen ? (
						<Card
							variant="plain"
							class="fastt-soft-box border border-slate-200 bg-slate-50 p-4"
							data-fiscal-submitted-summary
						>
							<dl class="grid gap-3 sm:grid-cols-3">
								<div>
									<dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
										País de residencia fiscal
									</dt>
									<dd class="mt-1 text-sm font-medium text-slate-950">{countryLabel}</dd>
								</div>
								<div>
									<dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
										Identificador tributario
									</dt>
									<dd class="mt-1 text-sm font-medium text-slate-950">
										{registration || "Sin definir"}
									</dd>
								</div>
								<div>
									<dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
										Régimen fiscal
									</dt>
									<dd class="mt-1 text-sm font-medium text-slate-950">{regimeLabel}</dd>
								</div>
							</dl>
						</Card>
					) : null}
					<details
						class="space-y-4"
						data-fiscal-identity-editor
						open={formStartsOpen ? true : undefined}
					>
						<summary
							class:list={[
								"cursor-pointer text-sm font-semibold text-slate-900",
								formStartsOpen && "sr-only",
							]}
						>
							{status === "verified" ? "Actualizar identidad fiscal" : "Corregir y volver a enviar"}
						</summary>
						<form
							method="post"
							action={`${saveAction.pathname}${saveAction.search}`}
							class="space-y-4"
							autocomplete="off"
							data-astro-reload
							data-fiscal-identity-form
							data-tax-country={country}
							data-tax-regime={regime}
							data-tax-registration={registration}
						>
							<input type="hidden" name="returnTo" value={formReturnTo} />
							<div class="grid gap-4 md:grid-cols-2">
								<FormField label="País de residencia fiscal" htmlFor="taxResidenceCountry">
									<Select id="taxResidenceCountry" name="taxResidenceCountry">
										<option value="">Sin definir</option>
										{countryOptions.map((item) => (
											<option value={item.value} selected={country === item.value}>
												{item.label}
											</option>
										))}
									</Select>
								</FormField>

								<FormField
									label="Identificador tributario (NIT en Bolivia)"
									htmlFor="businessRegistrationNumber"
								>
									<Input
										id="businessRegistrationNumber"
										name="businessRegistrationNumber"
										value={registration}
										placeholder="Número registrado ante la autoridad fiscal"
										class="scroll-mt-24"
										aria-describedby="businessRegistrationNumber-error"
									/>
									<p
										id="businessRegistrationNumber-error"
										class="text-sm text-red-600"
										role="alert"
										data-fiscal-registration-error
										data-fiscal-save-error
										hidden={saveErrorMessage ? undefined : true}
									>
										<span class="mb-1 block font-semibold">No se guardó la identidad fiscal</span>
										<span data-fiscal-registration-error-body>{saveErrorMessage}</span>
									</p>
								</FormField>

								<FormField label="Régimen fiscal" htmlFor="taxRegime">
									<Select id="taxRegime" name="taxRegime">
										<option value="">Sin definir</option>
										{providerTaxRegimes.map((item) => (
											<option value={item.value} selected={regime === item.value}>
												{item.label}
											</option>
										))}
									</Select>
								</FormField>
							</div>

							<p class="text-sm leading-6 text-slate-600" data-fiscal-scope-note>
								Estos datos identifican al contribuyente; no configuran cobros.
							</p>

							<div class="fastt-form-submit-footer" data-fiscal-form-actions>
								<Button type="submit" variant="selection" class="w-full sm:w-auto">
									{formStartsOpen && status !== "requires_attention"
										? "Enviar identidad fiscal"
										: "Volver a enviar"}
								</Button>
							</div>
						</form>
					</details>
				</div>
			) : (
				<div class="space-y-3 text-sm leading-6 text-slate-600">
					<p>Tu rol actual no puede editar la identidad fiscal del proveedor.</p>
					{taxConfiguration?.isConfigured ? (
						<ul class="list-disc space-y-1 pl-4">
							<li>País: {taxConfiguration.taxResidenceCountry || "Sin definir"}</li>
							<li>Registro: {taxConfiguration.businessRegistrationNumber || "Sin definir"}</li>
							<li>Régimen: {taxConfiguration.taxRegime || "Sin definir"}</li>
						</ul>
					) : (
						<p>Todavía no hay un perfil fiscal configurado.</p>
					)}
				</div>
			)
		}
	</div>
</Card>

<script>
	import {
		fiscalIdentityErrorMessage,
		previewFiscalIdentitySubmit,
	} from "@/lib/provider-tax-identity-validation"

	function fieldValue(form: HTMLFormElement, name: string) {
		const field = form.querySelector(`[name="${name}"]`)
		if (field instanceof HTMLSelectElement || field instanceof HTMLInputElement) return field.value
		return ""
	}

	function showRegistrationError(form: HTMLFormElement, code: string) {
		const alert = form.querySelector("[data-fiscal-registration-error]")
		const body = form.querySelector("[data-fiscal-registration-error-body]")
		if (!(alert instanceof HTMLElement)) return
		const input = form.querySelector('[name="businessRegistrationNumber"]')
		if (!code) {
			alert.hidden = true
			if (body instanceof HTMLElement) body.textContent = ""
			if (input instanceof HTMLInputElement) input.removeAttribute("aria-invalid")
			return
		}
		alert.hidden = false
		if (body instanceof HTMLElement) body.textContent = fiscalIdentityErrorMessage(code)
		if (input instanceof HTMLInputElement) input.setAttribute("aria-invalid", "true")
	}

	function validateFiscalIdentityForm(form: HTMLFormElement) {
		const preview = previewFiscalIdentitySubmit({
			taxResidenceCountry: fieldValue(form, "taxResidenceCountry"),
			businessRegistrationNumber: fieldValue(form, "businessRegistrationNumber"),
			taxRegime: fieldValue(form, "taxRegime"),
		})
		if (preview.ok) {
			showRegistrationError(form, "")
			return true
		}
		const details = form.closest("details")
		if (details instanceof HTMLDetailsElement) details.open = true
		showRegistrationError(form, preview.code)
		return false
	}

	function fiscalFormFromEvent(event: Event) {
		const target = event.target
		if (target instanceof HTMLFormElement && target.hasAttribute("data-fiscal-identity-form"))
			return target
		if (target instanceof Element) {
			const form = target.closest("form[data-fiscal-identity-form]")
			if (form instanceof HTMLFormElement) return form
		}
		return null
	}

	document.addEventListener(
		"submit",
		(event) => {
			const form = fiscalFormFromEvent(event)
			if (!form || validateFiscalIdentityForm(form)) return
			event.preventDefault()
			event.stopImmediatePropagation()
		},
		true
	)

	document.addEventListener(
		"click",
		(event) => {
			const target = event.target
			if (!(target instanceof Element)) return
			const button = target.closest("button, input[type='submit']")
			if (!(button instanceof HTMLButtonElement) && !(button instanceof HTMLInputElement)) return
			if (button.type !== "submit") return
			const form = button.closest("form[data-fiscal-identity-form]")
			if (!(form instanceof HTMLFormElement)) return
			if (validateFiscalIdentityForm(form)) return
			event.preventDefault()
			event.stopImmediatePropagation()
		},
		true
	)

	document.addEventListener("focusout", (event) => {
		const form = fiscalFormFromEvent(event)
		if (!form) return
		const target = event.target
		if (!(target instanceof HTMLInputElement || target instanceof HTMLSelectElement)) return
		if (
			target.name !== "businessRegistrationNumber" &&
			target.name !== "taxResidenceCountry" &&
			target.name !== "taxRegime"
		) {
			return
		}
		if (
			!fieldValue(form, "taxResidenceCountry") &&
			!fieldValue(form, "businessRegistrationNumber") &&
			!fieldValue(form, "taxRegime")
		) {
			showRegistrationError(form, "")
			return
		}
		validateFiscalIdentityForm(form)
	})

	function applyFiscalIdentityForms() {
		document.querySelectorAll("[data-fiscal-identity-form]").forEach((node) => {
			if (!(node instanceof HTMLFormElement)) return
			const setSelect = (name: string, value: string) => {
				if (!value) return
				const field = node.querySelector(`[name="${name}"]`)
				if (!(field instanceof HTMLSelectElement)) return
				field.value = value
				field.dispatchEvent(new Event("change", { bubbles: true }))
			}
			setSelect("taxResidenceCountry", node.dataset.taxCountry ?? "")
			setSelect("taxRegime", node.dataset.taxRegime ?? "")
			const registration = node.querySelector('[name="businessRegistrationNumber"]')
			const savedRegistration = node.dataset.taxRegistration ?? ""
			if (registration instanceof HTMLInputElement && savedRegistration) {
				registration.value = savedRegistration
			}
		})
	}

	applyFiscalIdentityForms()
	document.addEventListener("astro:page-load", applyFiscalIdentityForms)
</script>
