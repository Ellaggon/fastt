---
import ProviderReviewWaitNotice from "@/components/provider/ProviderReviewWaitNotice.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import { PROVIDER_REVIEW_WAIT_LABEL } from "@/lib/provider-review-wait-state"
import type { ProviderTaxConfigurationRecord } from "@/lib/provider-tax-configuration"
import { providerInvoicingModes, providerTaxRegimes } from "@/lib/provider-tax-configuration"

type Props = {
	taxConfiguration?: ProviderTaxConfigurationRecord | null
	canManageFiscality?: boolean
	reviewAssignment?: {
		slaDueAt: Date | string | null
		slaState: "ok" | "due_soon" | "overdue" | "done"
	} | null
	formReturnTo?: "taxIdentity" | "verificationFiscal"
}

const {
	taxConfiguration = null,
	canManageFiscality = false,
	reviewAssignment = null,
	formReturnTo = "taxIdentity",
} = Astro.props as Props
const status = taxConfiguration?.status ?? "not_configured"
const country = taxConfiguration?.taxResidenceCountry ?? ""
const regime = taxConfiguration?.taxRegime ?? ""
const invoicingMode = taxConfiguration?.invoicingMode ?? "platform_receipt"
const actionLead =
	status === "verified"
		? "Tu identidad fiscal está lista para liquidaciones."
		: status === "requires_attention"
			? "Corrige el país, el NIT o la facturación y vuelve a enviar a revisión."
			: status === "pending"
				? "Ya enviamos tu registro. Si un dato está mal, corrígelo y vuelve a enviar."
				: "Aquí debes completar el país de residencia, el NIT o registro comercial y quién factura al huésped."
---

<Card>
	<div class="space-y-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 class="text-xl font-semibold text-slate-950">Identidad fiscal</h2>
				<p class="mt-2 text-sm leading-6 text-slate-600" data-fiscal-action-lead>
					{actionLead}
				</p>
			</div>
			<Badge
				variant={status === "verified"
					? "success"
					: status === "requires_attention"
						? "error"
						: status === "pending"
							? "warning"
							: "neutral"}
			>
				{taxConfiguration?.statusLabel ?? "No configurado"}
			</Badge>
		</div>

		{
			status === "pending" ? (
				<ProviderReviewWaitNotice domain="fiscal" assignment={reviewAssignment} compact />
			) : null
		}

		{
			taxConfiguration?.tinBureau ? (
				<Card
					variant="soft"
					class="space-y-2"
					data-tin-bureau-status={taxConfiguration.tinBureau.matchStatus}
					data-tin-bureau-mode={taxConfiguration.tinBureau.mode}
				>
					<div class="flex flex-wrap items-center gap-2">
						<p class="text-sm font-semibold text-slate-900">Verificación del registro</p>
						<Badge variant={taxConfiguration.tinBureau.matchTone}>
							{taxConfiguration.tinBureau.matchLabel}
						</Badge>
					</div>
					<p class="text-sm leading-6 text-slate-600">
						{taxConfiguration.tinBureau.matchStatus === "format_ok"
							? "El formato es válido. El equipo Fastt confirmará que coincida con la razón social."
							: taxConfiguration.tinBureau.hostNarrative || taxConfiguration.tinBureau.message}
					</p>
				</Card>
			) : null
		}

		{
			canManageFiscality ? (
				<form method="post" action="/api/provider/settings/tax-configuration" class="space-y-4">
					<input type="hidden" name="returnTo" value={formReturnTo} />
					<div class="grid gap-4 md:grid-cols-2">
						<FormField label="País de residencia fiscal" htmlFor="taxResidenceCountry">
							<Select id="taxResidenceCountry" name="taxResidenceCountry">
								<option value="">Sin definir</option>
								<option value="BO" selected={country === "BO"}>
									Bolivia (BO)
								</option>
								<option value="CL" selected={country === "CL"}>
									Chile (CL)
								</option>
								<option value="US" selected={country === "US"}>
									Estados Unidos (US)
								</option>
								<option value="ES" selected={country === "ES"}>
									España (ES)
								</option>
								<option value="PE" selected={country === "PE"}>
									Perú (PE)
								</option>
								<option value="AR" selected={country === "AR"}>
									Argentina (AR)
								</option>
							</Select>
						</FormField>

						<FormField label="NIT / registro mercantil" htmlFor="businessRegistrationNumber">
							<Input
								id="businessRegistrationNumber"
								name="businessRegistrationNumber"
								value={taxConfiguration?.businessRegistrationNumber ?? ""}
								placeholder="NIT-123456 / EIN / CIF"
								class="scroll-mt-24"
							/>
						</FormField>

						<FormField label="Régimen fiscal" htmlFor="taxRegime">
							<Select id="taxRegime" name="taxRegime">
								<option value="">Sin definir</option>
								{providerTaxRegimes.map((item) => (
									<option value={item.value} selected={regime === item.value}>
										{item.label}
									</option>
								))}
							</Select>
						</FormField>
					</div>

					<FormField label="Modo de facturación" htmlFor="invoicingMode">
						<Select id="invoicingMode" name="invoicingMode" required>
							{providerInvoicingModes.map((item) => (
								<option value={item.value} selected={invoicingMode === item.value}>
									{item.label}
								</option>
							))}
						</Select>
					</FormField>

					<div class="flex justify-end">
						<Button type="submit">Enviar identidad fiscal</Button>
					</div>

					<details
						class="fastt-notice rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm leading-6 text-slate-600"
						data-fiscal-long-copy-collapsed="true"
					>
						<summary class="cursor-pointer font-semibold text-slate-900">
							Cómo se usa la facturación
						</summary>
						<div class="mt-3 border-t border-slate-200 pt-3">
							<p class="mb-2">
								Quién emite el comprobante al huésped. No cambia los impuestos de venta.
							</p>
							<ul class="list-disc space-y-1 pl-4">
								{providerInvoicingModes.map((item) => (
									<li>
										<span class="font-medium text-slate-800">{item.label}:</span> {item.description}
									</li>
								))}
							</ul>
							<p class="mt-3">
								Al guardar con datos de identidad, el estado pasa a{" "}
								<span class="font-medium text-slate-800">{PROVIDER_REVIEW_WAIT_LABEL}</span>. No
								puedes marcar Verificado tú mismo.
							</p>
						</div>
					</details>

					<details
						class="fastt-notice rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm leading-6 text-slate-600"
						data-fiscal-withhold-explainer
						data-long-copy-collapsed="true"
					>
						<summary class="cursor-pointer font-semibold text-slate-900">
							Retenciones y liquidaciones
							<span class="mt-0.5 block text-xs font-normal text-slate-500">
								Qué pasa con tus cobros si falta el registro
							</span>
						</summary>
						<div class="mt-3 border-t border-slate-200 pt-3">
							<p class="mb-2">
								Sin NIT/registro y residencia fiscal verificados, Fastt puede{" "}
								<strong>retener o retrasar liquidaciones</strong> hasta confirmar tu identidad
								tributaria. Esto no define los impuestos que cobras al huésped.
							</p>
							<ul class="list-disc space-y-1 pl-4">
								<li>
									<strong>Con registro verificado:</strong> las liquidaciones a tu cuenta de cobros
									pueden seguir el calendario normal tras payout verificado.
								</li>
								<li>
									<strong>Sin registro o en revisión:</strong> los cobros a huéspedes pueden
									continuar, pero el desembolso al proveedor queda sujeto a retención o espera de
									cumplimiento.
								</li>
								<li>
									La retención se aplica a <em>tu</em> liquidación, no al precio de la reserva.
								</li>
							</ul>
						</div>
					</details>
				</form>
			) : (
				<div class="space-y-3 text-sm leading-6 text-slate-600">
					<p>Tu rol actual no puede editar la identidad fiscal del proveedor.</p>
					{taxConfiguration?.isConfigured ? (
						<ul class="list-disc space-y-1 pl-4">
							<li>País: {taxConfiguration.taxResidenceCountry || "Sin definir"}</li>
							<li>Registro: {taxConfiguration.businessRegistrationNumber || "Sin definir"}</li>
							<li>Régimen: {taxConfiguration.taxRegime || "Sin definir"}</li>
							<li>Facturación: {taxConfiguration.invoicingModeLabel}</li>
						</ul>
					) : (
						<p>Todavía no hay un perfil fiscal configurado.</p>
					)}
				</div>
			)
		}
	</div>
</Card>
