---
import { getKycCaptureGuide } from "@/lib/provider-documents"

type Props = {
	documentType: string
	inputId?: string
}

const { documentType, inputId = "kyc-file" } = Astro.props as Props
const guide = getKycCaptureGuide(documentType)
const fieldId = `${inputId}-${documentType}`
const cameraId = `${fieldId}-camera`
const preferCamera = guide.preferCameraCapture
---

<div
	class="space-y-3"
	data-kyc-file-field
	data-kyc-file-type={documentType}
	data-kyc-file-prefer-camera={preferCamera ? "true" : undefined}
	data-kyc-capture-mobile="v3"
>
	<div data-kyc-file-before-pick data-kyc-file-guide={guide.frameKind}>
		<p class="sr-only" data-kyc-file-guide-label>
			{guide.frameLabel}
		</p>
		<p class="sr-only" aria-hidden="true">
			{guide.example}
		</p>
		<p class="text-sm leading-6 text-slate-600" data-kyc-file-guide-example>
			{guide.actionLead}
		</p>
		{/* Tips and mobile hint live in Consejos de captura; markers stay for contracts. */}
		<ul class="sr-only" aria-hidden="true" data-kyc-file-guide-tips>
			{
				guide.tips.slice(0, 2).map((tip) => (
					<li data-kyc-file-guide-tip={tip.id}>
						{tip.label}: {tip.detail}
					</li>
				))
			}
		</ul>
		<p class="sr-only" aria-hidden="true" data-kyc-file-guide-mobile-hint>
			{guide.mobileHint}
		</p>
	</div>

	<p class="text-sm font-medium text-slate-800">Elige el archivo</p>

	{/* Mobile-first: large tap target; OS picker offers camera / files on phones */}
	<label
		for={fieldId}
		class="fastt-notice group relative flex min-h-[8.5rem] cursor-pointer touch-manipulation flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-white px-4 py-6 text-center transition hover:border-slate-500 hover:bg-slate-50 active:bg-slate-100 sm:min-h-[7rem]"
		data-kyc-file-dropzone
	>
		<span
			class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white sm:h-9 sm:w-9"
			aria-hidden="true"
		>
			+
		</span>
		<span class="text-base font-semibold text-slate-950 sm:text-sm" data-kyc-file-cta-label>
			Toca para elegir o tomar foto
		</span>
		<span class="max-w-xs text-xs leading-5 text-slate-500" data-kyc-file-accept-copy>
			{guide.acceptHint}
		</span>
		<input
			id={fieldId}
			type="file"
			name="file"
			required
			accept=".pdf,image/*,image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf"
			class="fastt-field sr-only"
			data-kyc-file-input
		/>
	</label>

	{
		preferCamera ? (
			<div class="flex sm:hidden" data-kyc-file-camera-row>
				<button
					type="button"
					class="fastt-button fastt-notice min-h-11 w-full touch-manipulation rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-900 active:bg-slate-50"
					data-kyc-file-camera-trigger
					aria-controls={cameraId}
				>
					Tomar foto con la cámara
				</button>
				<input
					id={cameraId}
					type="file"
					accept="image/*"
					capture="environment"
					class="fastt-field sr-only"
					tabindex={-1}
					data-kyc-file-camera
				/>
			</div>
		) : null
	}

	<div
		class="fastt-notice hidden space-y-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900"
		data-kyc-file-preview
		aria-live="polite"
	>
		<div class="flex items-start gap-3">
			<img
				alt=""
				class="hidden h-16 w-16 shrink-0 rounded-md border border-emerald-200 object-cover"
				data-kyc-file-preview-thumb
			/>
			<div class="min-w-0 flex-1">
				<p>
					<span class="font-semibold">Listo:</span>
					<span data-kyc-file-preview-name></span>
					<span class="text-emerald-800/80" data-kyc-file-preview-size></span>
				</p>
				<p class="mt-0.5 text-xs text-emerald-800/80" data-kyc-file-preview-kind></p>
			</div>
		</div>
	</div>
	<p class="hidden text-sm text-red-700" data-kyc-file-error role="alert"></p>
</div>

<script>
	const MAX_BYTES = 12 * 1024 * 1024

	function formatBytes(bytes: number) {
		if (bytes < 1024) return `${bytes} B`
		if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`
		return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
	}

	function clearThumb(thumb: HTMLImageElement | null) {
		if (!thumb) return
		const prev = thumb.getAttribute("data-object-url")
		if (prev) {
			try {
				URL.revokeObjectURL(prev)
			} catch {
				/* ignore */
			}
			thumb.removeAttribute("data-object-url")
		}
		thumb.removeAttribute("src")
		thumb.classList.add("hidden")
	}

	function applyFile(root: Element, file: File | null) {
		const input = root.querySelector<HTMLInputElement>("[data-kyc-file-input]")
		const preview = root.querySelector("[data-kyc-file-preview]")
		const nameEl = root.querySelector("[data-kyc-file-preview-name]")
		const sizeEl = root.querySelector("[data-kyc-file-preview-size]")
		const kindEl = root.querySelector("[data-kyc-file-preview-kind]")
		const thumb = root.querySelector<HTMLImageElement>("[data-kyc-file-preview-thumb]")
		const errorEl = root.querySelector("[data-kyc-file-error]")
		const cta = root.querySelector("[data-kyc-file-cta-label]")
		if (!input || !preview || !nameEl || !sizeEl || !errorEl) return

		errorEl.classList.add("hidden")
		errorEl.textContent = ""
		clearThumb(thumb)
		if (kindEl) kindEl.textContent = ""

		if (!file) {
			preview.classList.add("hidden")
			if (cta) cta.textContent = "Toca para elegir o tomar foto"
			return
		}
		if (file.size > MAX_BYTES) {
			input.value = ""
			preview.classList.add("hidden")
			errorEl.textContent = "El archivo supera 12 MB. Elige uno más liviano."
			errorEl.classList.remove("hidden")
			if (cta) cta.textContent = "Toca para elegir o tomar foto"
			return
		}
		nameEl.textContent = file.name
		sizeEl.textContent = ` · ${formatBytes(file.size)}`
		const isImage = String(file.type || "").startsWith("image/")
		if (kindEl) {
			kindEl.textContent = isImage
				? "Vista previa de la imagen seleccionada."
				: "PDF listo para enviar (sin vista previa)."
		}
		if (isImage && thumb) {
			const url = URL.createObjectURL(file)
			thumb.setAttribute("data-object-url", url)
			thumb.src = url
			thumb.classList.remove("hidden")
		}
		preview.classList.remove("hidden")
		if (cta) cta.textContent = "Cambiar archivo"
	}

	function bindFileField(root: Element) {
		const input = root.querySelector<HTMLInputElement>("[data-kyc-file-input]")
		const camera = root.querySelector<HTMLInputElement>("[data-kyc-file-camera]")
		const cameraTrigger = root.querySelector("[data-kyc-file-camera-trigger]")
		if (!input) return

		input.addEventListener("change", () => {
			applyFile(root, input.files?.[0] ?? null)
		})

		if (cameraTrigger && camera) {
			cameraTrigger.addEventListener("click", () => {
				camera.click()
			})
			camera.addEventListener("change", () => {
				const file = camera.files?.[0]
				if (!file) return
				try {
					const transfer = new DataTransfer()
					transfer.items.add(file)
					input.files = transfer.files
				} catch {
					/* DataTransfer may be unavailable — fall through to preview only */
				}
				applyFile(root, file)
				input.dispatchEvent(new Event("change", { bubbles: true }))
			})
		}
	}

	document.querySelectorAll("[data-kyc-file-field]").forEach(bindFileField)
</script>
