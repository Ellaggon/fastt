---
import ProviderPayoutVerificationTimeline from "@/components/provider/ProviderPayoutVerificationTimeline.astro"
import ProviderReviewWaitNotice from "@/components/provider/ProviderReviewWaitNotice.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import {
	buildPayoutVerificationTimeline,
	providerPayoutMethods,
	type ProviderPaymentAccountRecord,
} from "@/lib/provider-payment-accounts"
import { copyVerificationNavigationQuery } from "@/lib/verification/navigation"

type Props = {
	accounts?: ProviderPaymentAccountRecord[]
	canManagePayments?: boolean
	defaultCurrency?: string
	paymentAssignments?: Record<
		string,
		{ slaDueAt: Date | string | null; slaState: "ok" | "due_soon" | "overdue" | "done" }
	>
	formReturnTo?: "payments" | "verificationPayments"
}
const {
	accounts = [],
	canManagePayments = false,
	defaultCurrency = "USD",
	paymentAssignments = {},
	formReturnTo = "payments",
} = Astro.props as Props
const saveAction = copyVerificationNavigationQuery(
	new URL("/api/provider/settings/payment-accounts", Astro.url),
	Astro.url,
	"payments"
)
const current = accounts.filter((row) => row.status !== "superseded")
const history = accounts.filter((row) => row.status === "superseded")
const hasInFlightAccount = current.some((row) => row.status === "pending")
const canShowCreateForm = canManagePayments && !hasInFlightAccount
const needsAttention = current.some((row) => row.status === "requires_attention")
const fmt = new Intl.DateTimeFormat("es", { dateStyle: "medium" })
---

<section class="space-y-5" data-payments-guided>
	<Card>
		<header>
			<h2 class="text-xl font-semibold text-slate-950">Cuenta para futuras liquidaciones</h2>
			<p class="mt-2 text-sm leading-6 text-slate-600" data-payments-action-lead>
				Registra tu cuenta y consulta el resultado de su revisión. Las liquidaciones aún no están
				habilitadas.
			</p>
		</header>
		<div class="mt-5 divide-y divide-slate-200">
			{
				current.map((account) => {
					const timeline = buildPayoutVerificationTimeline(account)
					return (
						<article
							class="space-y-3 py-4 first:pt-0 last:pb-0"
							data-payment-account={account.id}
							data-payment-account-status={account.status}
						>
							<div class="flex flex-wrap items-start justify-between gap-2">
								<div class="min-w-0">
									<p class="text-sm font-semibold break-words text-slate-950">
										{account.bankName || "Banco"} · {account.accountReference || "••••"}
									</p>
									<p class="mt-1 text-sm break-words text-slate-600">
										{account.accountHolderName} · {account.country} · {account.currency}
									</p>
									{account.isPrimary && (
										<p class="mt-1 text-xs font-medium text-slate-600">Cuenta principal</p>
									)}
								</div>
								<Badge
									variant={
										account.status === "verified"
											? "success"
											: account.status === "pending"
												? "warning"
												: "neutral"
									}
								>
									{timeline.phaseLabel}
								</Badge>
							</div>
							{account.status === "pending" ? (
								<ProviderPayoutVerificationTimeline timeline={timeline} />
							) : (
								<p class="text-sm leading-6 text-slate-600">{timeline.helperText}</p>
							)}
							{account.status === "verified" && (
								<p class="text-xs text-slate-500">
									{account.verificationMethod === "manual"
										? "Revisada por el equipo"
										: "Verificación registrada"}
									{account.reviewedAt ? ` · ${fmt.format(new Date(account.reviewedAt))}` : ""}
								</p>
							)}
							{account.status === "pending" && !timeline.showConfirmForm && (
								<ProviderReviewWaitNotice
									domain="payment"
									assignment={paymentAssignments[account.id] ?? null}
									compact
								/>
							)}
							{timeline.showConfirmForm && canManagePayments && (
								<form
									method="post"
									action={saveAction.pathname + saveAction.search}
									class="grid gap-3 sm:grid-cols-2"
									data-micro-deposit-confirm-form
									data-astro-reload
								>
									<input type="hidden" name="action" value="confirm_micro_deposit" />
									<input type="hidden" name="accountId" value={account.id} />
									<input type="hidden" name="returnTo" value={formReturnTo} />
									<FormField
										label="Primer monto (centavos)"
										htmlFor={`amount1-${account.id}`}
										description="Ejemplo: 0,32 USD se ingresa como 32."
										required
									>
										<Input
											id={`amount1-${account.id}`}
											name="amount1Cents"
											type="number"
											min="1"
											max="99"
											required
											inputmode="numeric"
										/>
									</FormField>
									<FormField
										label="Segundo monto (centavos)"
										htmlFor={`amount2-${account.id}`}
										required
									>
										<Input
											id={`amount2-${account.id}`}
											name="amount2Cents"
											type="number"
											min="1"
											max="99"
											required
											inputmode="numeric"
										/>
									</FormField>
									<div class="sm:col-span-2">
										<Button type="submit" variant="selection">
											Confirmar montos
										</Button>
									</div>
								</form>
							)}
							{account.status === "verified" && !account.isPrimary && canManagePayments && (
								<form
									method="post"
									action={saveAction.pathname + saveAction.search}
									data-astro-reload
								>
									<input type="hidden" name="action" value="select_primary" />
									<input type="hidden" name="accountId" value={account.id} />
									<input type="hidden" name="returnTo" value={formReturnTo} />
									<Button type="submit" variant="secondary" size="sm">
										Usar como principal
									</Button>
								</form>
							)}
						</article>
					)
				})
			}
			{
				!current.length && (
					<p class="text-sm text-slate-600">Aún no has registrado una cuenta bancaria.</p>
				)
			}
		</div>
		{
			hasInFlightAccount && (
				<p class="mt-4 text-xs text-slate-500" data-payments-one-account>
					Termina la revisión de la cuenta pendiente antes de agregar otra.
				</p>
			)
		}
		{
			history.length > 0 && (
				<details class="mt-4 border-t border-slate-200 pt-4 text-sm text-slate-600">
					<summary class="cursor-pointer">Cuentas anteriores · {history.length}</summary>
					<ul class="mt-3 space-y-2">
						{history.map((account) => (
							<li>
								{account.bankName} · {account.accountReference} · Reemplazada
							</li>
						))}
					</ul>
				</details>
			)
		}
	</Card>
	{
		canShowCreateForm && (
			<Card data-payments-create-card>
				<details open={current.length === 0 || needsAttention} data-payments-create-form>
					<summary class="cursor-pointer text-base font-semibold text-slate-950">
						{needsAttention
							? "Enviar cuenta corregida"
							: current.length
								? "Agregar otra cuenta"
								: "Registrar cuenta bancaria"}
					</summary>
					<p class="mt-2 text-sm text-slate-600">
						{needsAttention
							? "La nueva presentación reemplaza los datos que requieren corrección."
							: "El equipo revisará los datos. Agregar otra cuenta no cambia tu cuenta principal."}
					</p>
					<form
						method="post"
						action={saveAction.pathname + saveAction.search}
						class="mt-4 space-y-4"
						data-astro-reload
					>
						<input type="hidden" name="returnTo" value={formReturnTo} />
						<input type="hidden" name="payoutSchedule" value="manual" />
						<div class="grid gap-4 md:grid-cols-2">
							<FormField label="Titular de la cuenta" htmlFor="accountHolderName" required>
								<Input
									id="accountHolderName"
									name="accountHolderName"
									required
									minlength="2"
									maxlength="160"
									autocomplete="organization"
								/>
							</FormField>
							<FormField label="Banco" htmlFor="bankName" required>
								<Input id="bankName" name="bankName" required minlength="2" maxlength="160" />
							</FormField>
							<FormField label="País de la cuenta" htmlFor="country" required>
								<Select id="country" name="country" required>
									<>
										<option value="">Selecciona</option>
										<option value="BO">Bolivia</option>
										<option value="CL">Chile</option>
										<option value="US">Estados Unidos</option>
									</>
									<>
										<option value="ES">España</option>
										<option value="PE">Perú</option>
										<option value="AR">Argentina</option>
									</>
								</Select>
							</FormField>
							<FormField label="Moneda de la cuenta" htmlFor="currency" required>
								<Select id="currency" name="currency" required>
									{["USD", "EUR", "CLP", "BOB", "PEN", "ARS"].map((currency) => (
										<option value={currency} selected={currency === defaultCurrency}>
											{currency}
										</option>
									))}
								</Select>
							</FormField>
							<FormField label="Tipo de transferencia" htmlFor="method" required>
								<Select id="method" name="method" required>
									{providerPayoutMethods
										.filter((item) => item.value !== "other")
										.map((item) => (
											<option value={item.value}>{item.label}</option>
										))}
								</Select>
							</FormField>
							<FormField
								label="Número de cuenta o IBAN"
								htmlFor="accountIdentifier"
								description="Solo se mostrarán los últimos cuatro caracteres."
								required
							>
								<Input
									id="accountIdentifier"
									name="accountIdentifier"
									required
									minlength="4"
									maxlength="64"
									autocomplete="off"
								/>
							</FormField>
							<FormField
								label="Código bancario o SWIFT"
								htmlFor="routingOrSwift"
								description="Necesario para transferencias internacionales."
							>
								<Input id="routingOrSwift" name="routingOrSwift" maxlength="64" />
							</FormField>
							<FormField label="Información para el equipo (opcional)" htmlFor="submissionNotes">
								<Input id="submissionNotes" name="submissionNotes" maxlength="2000" />
							</FormField>
						</div>
						<div class="fastt-form-submit-footer">
							<Button type="submit" variant="selection">
								Enviar a revisión
							</Button>
						</div>
					</form>
				</details>
			</Card>
		)
	}
	{
		!canManagePayments && (
			<p class="text-sm text-slate-600">
				Tu rol permite consultar las cuentas. La gestión corresponde a un administrador del
				proveedor.
			</p>
		)
	}
</section>
