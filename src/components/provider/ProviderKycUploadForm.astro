---
import ProviderKycCaptureCoach from "@/components/provider/ProviderKycCaptureCoach.astro"
import ProviderKycFileField from "@/components/provider/ProviderKycFileField.astro"
import Button from "@/components/ui/Button.astro"
import Input from "@/components/ui/Input.astro"

type Props = {
	documentType: string
	optionalConstancia?: boolean
	/** When false, submit is expected in the page header (form=kyc-inline-upload-form). */
	showSubmitButton?: boolean
}

const { documentType, optionalConstancia = false, showSubmitButton = true } = Astro.props as Props
---

<form
	id="kyc-inline-upload-form"
	class="space-y-4"
	method="post"
	action="/api/provider/settings/documents"
	enctype="multipart/form-data"
	data-astro-reload
	data-kyc-inline-upload-form
	data-kyc-upload-type={documentType}
	data-kyc-capture-timing="v1"
	data-funnel-domain="documents"
	data-funnel-surface="verification"
>
	<input type="hidden" name="action" value="submit" />
	<input type="hidden" name="type" value={documentType} />

	{
		optionalConstancia ? (
			<p class="text-sm font-semibold text-slate-800" data-kyc-optional-constancia>
				Adjuntar constancia (solo si te la pedimos)
			</p>
		) : null
	}

	<ProviderKycFileField documentType={documentType} />

	{
		showSubmitButton ? (
			<Button type="submit" size="sm" class="w-full sm:w-auto" data-kyc-submit>
				Enviar a revisión
			</Button>
		) : (
			<button type="submit" class="fastt-button sr-only" data-kyc-submit-fallback tabindex="-1">
				Enviar a revisión
			</button>
		)
	}

	<details
		class="fastt-notice rounded-lg border border-slate-200 bg-white"
		data-kyc-submission-notes
	>
		<summary class="cursor-pointer px-3 py-2.5 text-sm font-semibold text-slate-900">
			Notas de envío (opcional)
		</summary>
		<label
			class="grid gap-2 border-t border-slate-100 px-3 py-3 text-sm font-medium text-slate-700"
		>
			<span class="sr-only">Notas de envío</span>
			<Input name="submissionNotes" placeholder="Versión vigente / dato actualizado" />
		</label>
	</details>

	<ProviderKycCaptureCoach documentType={documentType} />
</form>
