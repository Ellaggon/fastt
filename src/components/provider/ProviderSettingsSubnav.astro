---
import TabsInsidePanel from "@/components/ui/TabsInsidePanel.astro"
import { routes } from "@/lib/routes"
import { LayoutDashboard, UserRound, Users } from "@lucide/astro"

interface Props {
	pathname?: string
}

const { pathname = Astro.url.pathname } = Astro.props

const items = [
	{
		label: "Resumen",
		href: routes.providerSettings(),
		aliases: ["/provider"],
		icon: LayoutDashboard,
	},
	{
		label: "Perfil",
		href: routes.providerSettingsProfile(),
		aliases: [
			"/provider/profile",
			"/provider/register",
			"/provider?step=profile",
			"/provider?step=register",
		],
		icon: UserRound,
	},
	// Verificación y los impuestos al huésped tienen su propio espacio de trabajo.
	{
		label: "Equipo",
		href: routes.providerSettingsTeam(),
		aliases: [],
		icon: Users,
	},
]

const currentPath = `${Astro.url.pathname}${Astro.url.search}`
const isActive = (item: (typeof items)[number]) => {
	if (item.href === routes.providerSettings()) {
		return pathname === item.href || item.aliases.includes(currentPath)
	}
	return (
		pathname === item.href ||
		pathname.startsWith(`${item.href}/`) ||
		item.aliases.includes(currentPath)
	)
}
---

<TabsInsidePanel
	class="max-w-full flex-nowrap"
	aria-label="Navegación de configuración del proveedor"
>
	{
		items.map((item) => {
			const active = isActive(item)
			const Icon = item.icon
			return (
				<a
					href={item.href}
					data-provider-settings-nav
					data-active={active ? "true" : "false"}
					aria-current={active ? "page" : undefined}
					class="fastt-tabs-inside-panel__item"
				>
					<Icon class="h-4 w-4 shrink-0" aria-hidden="true" />
					<span class="fastt-tabs-inside-panel__label">{item.label}</span>
				</a>
			)
		})
	}
</TabsInsidePanel>

<script is:inline>
	;(function () {
		if (window.__fasttProviderSettingsNavInline) return
		window.__fasttProviderSettingsNavInline = true
		document.addEventListener(
			"click",
			function (event) {
				if (event.defaultPrevented) return
				if (event.button !== 0) return
				if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return
				var target = event.target
				if (!target || !target.closest) return
				var link = target.closest("a[data-provider-settings-nav]")
				if (!link) return
				if (link.getAttribute("aria-current") === "page") return
				event.preventDefault()
				event.stopImmediatePropagation()
				var href = link.href
				if (typeof window.__fasttNavigateSettingsTab === "function") {
					window.__fasttNavigateSettingsTab(href)
					return
				}
				window.__fasttSettingsNavQueue = href
			},
			true
		)
	})()
</script>

<script>
	import "@/pages/provider/settings/_client/provider-settings-nav.js"
</script>
