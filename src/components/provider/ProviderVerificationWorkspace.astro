---
import ProviderDocumentsAccessDenied from "@/components/provider/ProviderDocumentsAccessDenied.astro"
import ProviderIdentityVendorCard from "@/components/provider/ProviderIdentityVendorCard.astro"
import ProviderKycSlotsCard from "@/components/provider/ProviderKycSlotsCard.astro"
import ProviderPaymentAccountsCard from "@/components/provider/ProviderPaymentAccountsCard.astro"
import ProviderTaxProfileCard from "@/components/provider/ProviderTaxProfileCard.astro"
import ProviderTourOperatingContext from "@/components/provider/ProviderTourOperatingContext.astro"
import ProviderLodgingCollectionModel from "@/components/provider/ProviderLodgingCollectionModel.astro"
import ProviderTrustMapRail from "@/components/provider/ProviderTrustMapRail.astro"
import ProviderVerificationLineSections from "@/components/provider/ProviderVerificationLineSections.astro"
import ProviderVerificationBusinessNav from "@/components/provider/ProviderVerificationBusinessNav.astro"
import ProviderVerificationNextStep from "@/components/provider/ProviderVerificationNextStep.astro"
import ProviderVerificationOptionals from "@/components/provider/ProviderVerificationOptionals.astro"
import ProviderVerificationView from "@/components/provider/ProviderVerificationView.astro"
import Badge from "@/components/ui/Badge.astro"
import Notice from "@/components/ui/Notice.astro"
import { resolveProviderRejectCategory } from "@/lib/provider-reject-categories"
import type { ProviderVerificationWorkspaceModel } from "@/lib/provider-verification-workspace"
import { isProviderTrustMapComplete } from "@/lib/provider-trust-map"
import { routes } from "@/lib/routes"
import { verificationNavigationHref, type VerificationTab } from "@/lib/verification/navigation"

type Props = {
	model: ProviderVerificationWorkspaceModel
}

const { model } = Astro.props as Props
const {
	activeSectionId,
	navigation,
	tourDocumentPresentation,
	tourResources,
	tourProducts,
	tourPlaybook,
	nextActionId,
	listaReady,
	trustLinks,
	canManageDocuments,
	canEditTourContext,
	canManageFiscality,
	canManagePayments,
	providerRoleLabel,
	requestedType,
	documents,
	kycSlots,
	latestVerification,
	verificationAssignment,
	documentAssignments,
	fiscalAssignment,
	paymentAssignments,
	taxConfiguration,
	paymentAccounts,
	defaultCurrency,
	payoutRail,
	identityVendorStatus,
	nextStep,
	crossLinks,
	suppressStatusConsequence,
	optionalDocumentsCount,
	optionalPendingCount,
	tourVerification,
	tourContext,
	commercialLine,
	tourEvidenceOptions,
	screen,
	holderType,
	holderDeclarationInReview,
	historicalBusinessRegistrationDocuments,
	result,
	uploadErrorCode,
	error,
} = model

const trustMapComplete = isProviderTrustMapComplete(trustLinks)
const trustLinkById = new Map(trustLinks.map((link) => [link.id, link]))
const identitySlots = screen ? kycSlots.filter((slot) => slot.type === "government_id") : []
const businessSlots = screen
	? kycSlots.filter((slot) => slot.type === "business_registration")
	: kycSlots
const missingMercantileForEntity =
	holderType === "entidad" &&
	businessSlots.some((slot) => slot.state === "missing" || slot.state === "rejected")
const payoutBlocks = screen ? screen.paymentsCountsForSelling : true
const selectedLine = navigation?.line ?? null
const historicalSupportHref = new URL(routes.providerSupport(), Astro.url)
historicalSupportHref.searchParams.set("topic", "historical_tour_collection")
historicalSupportHref.searchParams.set("line", "tour")
historicalSupportHref.searchParams.set("from", `${Astro.url.pathname}${Astro.url.search}`)
function tourEvidenceDocuments(area: "activity" | "safety") {
	const types = new Set(tourEvidenceOptions[area].map((option) => option.value.split("::")[0]))
	return documents.filter((document) => {
		if (!types.has(document.type)) return false
		const productScopes = document.scopes.filter((scope) => scope.scopeType === "product")
		return (
			productScopes.length === 0 ||
			productScopes.some((scope) => scope.productId === navigation?.experienceId)
		)
	})
}
const lineHref = (tab: VerificationTab) =>
	navigation && selectedLine
		? verificationNavigationHref({ url: Astro.url, navigation, line: selectedLine, tab })
		: tab === "fiscal"
			? routes.providerSettingsVerificationFiscal()
			: tab === "payments"
				? routes.providerSettingsVerificationPayments()
				: routes.providerSettingsVerification()
function panelLabel(id: "identity" | "business" | "fiscal" | "payments") {
	const tourTab =
		selectedLine === "tour" && id === "identity"
			? tourPlaybook.find((tab) => tab.id === "identity")
			: null
	if (tourTab) {
		return `${tourTab.label}. Estado: ${tourTab.stateLabel}. Requisitos de identidad y titularidad del proveedor.`
	}
	const link = trustLinkById.get(id)
	return link
		? `${link.label}. Estado: ${link.stateLabel}. ${link.description}`
		: "Estado no disponible."
}

const hubActive = activeSectionId === "identity" || activeSectionId === "business"
const hideIdentityAccountStatus =
	activeSectionId === "identity" && Boolean(selectedLine || identitySlots.length)
const accountVerificationStatus = String(latestVerification?.status ?? "pending")
const accountRejected = accountVerificationStatus === "rejected"
const accountRejectCategory = accountRejected
	? resolveProviderRejectCategory(latestVerification?.reason, "verification")
	: null
const optionalsEntryActive = activeSectionId === "business"
const documentResult = hubActive ? result : ""
const fiscalResult = activeSectionId === "fiscal" ? result : ""
const fiscalError = activeSectionId === "fiscal" ? error : ""
const paymentResult = activeSectionId === "payments" ? result : ""
const paymentError = activeSectionId === "payments" ? error : ""

const uploadErrorMessages: Record<string, string> = {
	document_subject_not_found:
		"El titular no es un guía o recurso vigente de este negocio. Selecciónalo nuevamente antes de enviar.",
	document_subject_reference_required: "Selecciona el guía titular de la credencial.",
	document_subject_type_invalid:
		"El titular elegido no corresponde a este requisito. Revisa a quién se emitió el documento.",
	document_product_scope_required: "Selecciona la experiencia cubierta por el documento.",
	document_file_meta_required:
		"Faltó el tipo o nombre del archivo. Vuelve a elegir el PDF o la foto.",
	document_file_required: "No se recibió el archivo. Elige de nuevo el PDF o la imagen.",
	unsupported_mime_type: "Formato no permitido. Usa PDF, JPG, PNG, WEBP o HEIC.",
	file_too_large: "El archivo supera 12 MB. Sube una versión más liviana.",
	empty_file: "El archivo está vacío. Elige otro PDF o foto.",
	document_storage_upload_failed:
		"No se pudo guardar en el almacenamiento de documentos. Inténtalo de nuevo en unos minutos.",
	document_storage_not_configured: "El almacenamiento de documentos no está configurado.",
	local_document_url_not_allowed: "Este entorno requiere almacenamiento en la nube (R2).",
	validation_error: "Los datos del envío no son válidos. Revisa el tipo de documento y el archivo.",
	forbidden: "Tu rol no puede enviar documentos. Pide acceso a Documentos en Equipo.",
}

const documentResultMessages: Record<
	string,
	{ title: string; body: string; variant: "success" | "warning" }
> = {
	submitted: {
		title: "Documento enviado",
		body: "Quedó como Enviado. El resultado aparecerá en esta página cuando el equipo Fastt termine.",
		variant: "success",
	},
	verified: {
		title: "Documento verificado",
		body: "Este respaldo ya cuenta para los documentos mínimos de Negocio.",
		variant: "success",
	},
	rejected: {
		title: "Documento requiere cambios",
		body: "Revisa el motivo en el documento mínimo y envía una versión corregida.",
		variant: "warning",
	},
	error: {
		title: "No se pudo enviar el documento",
		body:
			uploadErrorMessages[uploadErrorCode] ||
			"Revisa el archivo (PDF o imagen, máx. 12 MB) e inténtalo de nuevo. Si el problema sigue, contacta a soporte.",
		variant: "warning",
	},
}

const paymentResultMessages: Record<
	string,
	{ title: string; body: string; variant: "success" | "info" }
> = {
	submitted: {
		title: "Cuenta enviada",
		body: "Paso 1 listo. Revisa el extracto en 1-2 días hábiles: verás dos depósitos pequeños. Esta pantalla te guía hasta confirmar montos.",
		variant: "success",
	},
	micro_deposit_confirmed: {
		title: "Cuenta lista",
		body: "Confirmaste los montos del extracto. La cuenta quedó verificada para liquidaciones.",
		variant: "success",
	},
}

const paymentErrorMessages: Record<
	string,
	{ title: string; body: string; variant: "warning" | "error" }
> = {
	micro_deposit_mismatch: {
		title: "Montos incorrectos",
		body: "Los montos no coinciden con el extracto. Revisa los dos créditos pequeños e inténtalo de nuevo.",
		variant: "warning",
	},
	micro_deposit_failed: {
		title: "Intentos agotados",
		body: "Se agotaron los intentos de confirmación. Envía una cuenta nueva o contacta a soporte Fastt.",
		variant: "error",
	},
	micro_deposit_expired: {
		title: "Depósitos vencidos",
		body: "El plazo para confirmar los montos venció. El equipo Fastt puede reiniciar la verificación.",
		variant: "warning",
	},
	micro_deposit_not_initiated: {
		title: "Aún no hay depósitos",
		body: "La verificación de titularidad todavía no está lista para confirmar. Espera el paso “Esperando depósitos”.",
		variant: "warning",
	},
	invalid_micro_deposit_amounts: {
		title: "Montos inválidos",
		body: "Ingresa dos montos enteros entre 1 y 99 centavos.",
		variant: "warning",
	},
	pending_account_in_progress: {
		title: "Ya hay una cuenta en curso",
		body: "Termina la verificación de la cuenta pendiente antes de enviar otra.",
		variant: "warning",
	},
}
---

<div class="space-y-6 md:space-y-8" data-verification-workspace>
	{
		hubActive && documentResult && documentResultMessages[documentResult] ? (
			<div data-verification-hub-chrome>
				<Notice
					variant={documentResultMessages[documentResult].variant}
					title={documentResultMessages[documentResult].title}
				>
					<p>{documentResultMessages[documentResult].body}</p>
					<div
						class="mt-3 flex flex-wrap gap-3"
						data-post-save-cta
						data-funnel-domain="verification"
						data-funnel-surface="verification"
					>
						<a
							class="font-semibold underline"
							href={lineHref(selectedLine === "tour" ? "activity" : "fiscal")}
							data-funnel-cta="post_save"
						>
							{selectedLine === "tour" ? "Continuar a actividad" : "Continuar a registro fiscal"}
						</a>
						{selectedLine !== "tour" || navigation?.fasttCollects ? (
							<a
								class="font-semibold underline"
								href={lineHref("payments")}
								data-funnel-cta="post_save"
							>
								Continuar a pagos
							</a>
						) : null}
					</div>
				</Notice>
			</div>
		) : null
	}

	{
		!listaReady &&
		identityVendorStatus.selfieLive &&
		identityVendorStatus.surfaceEnabled &&
		canManageDocuments ? (
			<div data-verification-hub-chrome hidden={hubActive ? undefined : true}>
				<ProviderIdentityVendorCard status={identityVendorStatus} />
			</div>
		) : null
	}

	{
		navigation?.line ? (
			<div class="space-y-4">
				<ProviderVerificationBusinessNav
					navigation={navigation}
					url={Astro.url}
					products={tourProducts}
					playbook={tourPlaybook}
					trustLinks={trustLinks}
				/>
				{commercialLine && selectedLine === "lodging" && activeSectionId === "payments" ? (
					<ProviderLodgingCollectionModel
						collectionModel={commercialLine.collectionModel}
						canEdit={canEditTourContext}
						returnTo={`${Astro.url.pathname}${Astro.url.search}`}
						result={result}
						error={error}
					/>
				) : null}
			</div>
		) : (
			<div data-verification-trust-nav>
				<ProviderTrustMapRail
					links={trustLinks}
					activeId={
						activeSectionId === "activity" || activeSectionId === "safety"
							? "identity"
							: activeSectionId
					}
					nextActionId={nextActionId}
				/>
			</div>
		)
	}

	<div class="verification-trust-panels-stage" data-verification-trust-panels-stage>
		<section
			class="space-y-6 md:space-y-8"
			data-verification-trust-panel="identity"
			data-active={activeSectionId === "identity" ? "true" : "false"}
			hidden={activeSectionId !== "identity" ? true : undefined}
			aria-labelledby="verification-panel-identity-title"
			id={hideIdentityAccountStatus ? "verification-status-panel" : undefined}
		>
			<h2 id="verification-panel-identity-title" class="sr-only">{panelLabel("identity")}</h2>
			{
				holderDeclarationInReview && activeSectionId === "identity" ? (
					<Notice
						variant="info"
						title="Fastt está revisando el cambio de titular"
						data-verification-holder-declaration-review
					>
						<p class="text-sm leading-6">
							{missingMercantileForEntity
								? "Confirmamos el nuevo titular antes de publicar. Tu documento de identidad verificado sigue vigente mientras tanto; si falta el registro de la entidad, puedes subirlo abajo."
								: "Actualizaste quién opera el negocio. No hace falta enviar documentos nuevos mientras terminamos esa revisión; te avisamos aquí al confirmarlo."}
						</p>
					</Notice>
				) : null
			}
			{
				selectedLine === "tour" &&
				latestVerification?.status === "pending" &&
				!holderDeclarationInReview &&
				activeSectionId === "identity" ? (
					<Notice
						variant="info"
						title="La revisión de la cuenta sigue en curso"
						data-verification-account-review
					>
						<p class="text-sm leading-6">
							El equipo Fastt revisa la cuenta por separado de estos documentos. Completa también
							los requisitos que aparecen abajo; estar en revisión no los marca como listos.
						</p>
					</Notice>
				) : null
			}
			{
				accountRejected && hideIdentityAccountStatus ? (
					<Notice
						variant="error"
						title="La cuenta requiere cambios"
						data-verification-account-reject
					>
						{accountRejectCategory?.matched ? (
							<Badge variant="error" class="mb-2" data-reject-category>
								{accountRejectCategory.label}
							</Badge>
						) : null}
						<p class="text-sm leading-6">
							{latestVerification?.reason ||
								"Corrige los datos indicados y vuelve a enviar los documentos necesarios."}
						</p>
					</Notice>
				) : null
			}
			{
				hideIdentityAccountStatus ? null : (
					<ProviderVerificationView
						line={selectedLine}
						latestVerification={latestVerification}
						documents={documents}
						showHeader={false}
						placement="primary"
						reviewAssignment={verificationAssignment}
						trustMapComplete={selectedLine === "tour" ? false : listaReady}
						suppressConsequence={suppressStatusConsequence}
						requiredDocumentTypes={kycSlots.length ? kycSlots.map((slot) => slot.type) : undefined}
					/>
				)
			}
			{
				identitySlots.length && (!navigation?.line || activeSectionId === "identity") ? (
					<ProviderKycSlotsCard
						slots={identitySlots}
						canManageDocuments={canManageDocuments}
						documentAssignments={documentAssignments}
						focusType={
							identitySlots.some((slot) => slot.type === requestedType)
								? requestedType
								: "government_id"
						}
						elevated
						payoutBlocks={payoutBlocks}
						holderDeclarationInReview={holderDeclarationInReview}
						holderType={holderType}
					/>
				) : null
			}
			{
				selectedLine === "tour" && businessSlots.length && activeSectionId === "identity" ? (
					<ProviderKycSlotsCard
						slots={businessSlots}
						canManageDocuments={canManageDocuments}
						documentAssignments={documentAssignments}
						focusType="business_registration"
						elevated
						payoutBlocks={payoutBlocks}
						holderDeclarationInReview={holderDeclarationInReview}
						holderType={holderType}
					/>
				) : null
			}
			{
				historicalBusinessRegistrationDocuments.length && activeSectionId === "identity" ? (
					<Notice variant="info" title="Registro mercantil en historial">
						<p class="text-sm leading-6">
							Como persona natural ya no pedimos registro mercantil. Los archivos anteriores se
							conservan solo como referencia y no afectan el estado de Identidad.
						</p>
						<ul class="mt-3 space-y-2 text-sm text-slate-700">
							{historicalBusinessRegistrationDocuments.map((document) => (
								<li class="flex flex-wrap items-center gap-2">
									<span class="font-medium text-slate-900">
										{document.fileName || "Registro mercantil"}
									</span>
									<Badge variant={document.tone}>{document.statusLabel}</Badge>
								</li>
							))}
						</ul>
					</Notice>
				) : null
			}
		</section>

		<section
			class="space-y-6 md:space-y-8"
			data-verification-trust-panel="business"
			data-active={activeSectionId === "business" ? "true" : "false"}
			hidden={activeSectionId !== "business" ? true : undefined}
			aria-labelledby="verification-panel-business-title"
		>
			<h2 id="verification-panel-business-title" class="sr-only">{panelLabel("business")}</h2>
			{
				screen && selectedLine === "lodging" ? (
					<ProviderVerificationLineSections screen={screen} line="lodging" />
				) : null
			}
			{
				selectedLine === "tour" ||
				(navigation?.line && activeSectionId !== "business") ? null : screen &&
				  businessSlots.length === 0 ? (
					<Notice variant="info" title="No se requiere registro de entidad">
						El titular de esta cuenta no tiene un documento societario pendiente en esta línea.
					</Notice>
				) : !listaReady ? (
					canManageDocuments ? (
						<div data-verification-docs-fold>
							<ProviderKycSlotsCard
								slots={businessSlots}
								canManageDocuments={canManageDocuments}
								documentAssignments={documentAssignments}
								focusType={requestedType}
								elevated
								payoutBlocks={payoutBlocks}
								holderDeclarationInReview={holderDeclarationInReview}
								holderType={holderType}
							>
								<ProviderVerificationNextStep
									slot="intro"
									nextStep={nextStep}
									crossLinks={crossLinks}
									copyOnly
								/>
							</ProviderKycSlotsCard>
						</div>
					) : (
						<div
							class="fastt-card space-y-6 border border-slate-200 bg-white p-4 text-slate-900 sm:p-5"
							data-verification-docs-fold
						>
							<div>
								<p class="text-xs font-semibold tracking-[0.14em] text-slate-500 uppercase">
									Negocio
								</p>
								<h2 class="mt-2 text-xl font-semibold text-slate-950">Documentos mínimos</h2>
							</div>
							<ProviderVerificationNextStep nextStep={nextStep} crossLinks={crossLinks} copyOnly />
							<ProviderDocumentsAccessDenied roleLabel={providerRoleLabel} slots={kycSlots} />
						</div>
					)
				) : (
					<div
						class="fastt-notice space-y-4 rounded-[var(--fastt-radius-card)] border border-emerald-200 bg-emerald-50/50 px-5 py-4"
						data-verification-lista-docs
					>
						<p class="text-sm font-semibold text-slate-950">Documentos mínimos listos</p>
						<p class="mt-1 text-sm leading-6 text-slate-600">
							Negocio está completo en el mapa. Usa Publicar o Pagos arriba; el respaldo adicional
							sigue disponible abajo.
						</p>
					</div>
				)
			}
		</section>

		{
			selectedLine === "tour" && screen ? (
				<section
					class="space-y-6 md:space-y-8"
					data-verification-trust-panel="activity"
					data-active={activeSectionId === "activity" ? "true" : "false"}
					hidden={activeSectionId !== "activity" ? true : undefined}
					aria-labelledby="verification-panel-activity-title"
				>
					<h2 id="verification-panel-activity-title" class="sr-only">
						Actividad y licencias
					</h2>
					{navigation?.experienceId && (
						<ProviderTourOperatingContext
							productId={navigation.experienceId}
							productName={
								tourProducts.find((product) => product.id === navigation.experienceId)?.name
							}
							context={tourContext ?? null}
							canEdit={canEditTourContext}
							result={result}
							error={error}
						/>
					)}
					{commercialLine?.collectionModel === "platform_collect" ? (
						<Notice variant="warning" title="Revisar cobro histórico de tours">
							Esta línea conserva una declaración de cobro por Fastt. Fastt no procesa pagos de
							tours y esa declaración no activa cobros.{" "}
							<a
								class="font-semibold underline underline-offset-2"
								href={`${historicalSupportHref.pathname}${historicalSupportHref.search}`}
							>
								Solicitar revisión al equipo Fastt
							</a>
							.
						</Notice>
					) : null}
					{navigation?.experienceId && (
						<ProviderVerificationLineSections
							screen={screen}
							line="tour"
							tourArea="activity"
							experienceId={navigation.experienceId}
						/>
					)}
					{tourVerification[0]?.state === "waiting_on_fastt" ? (
						<Notice variant="info" title="Pendiente de política Fastt">
							Esta combinación todavía requiere una regla comercial aprobada. Puedes guardar la
							operación; no subas documentos que no aparezcan como aplicables.
						</Notice>
					) : null}
					{result === "submitted" ? (
						<Notice variant="success" title="Licencia enviada">
							El respaldo quedó en revisión para esta experiencia.
						</Notice>
					) : null}
					{result === "error" ? (
						<Notice variant="warning" title="No se pudo enviar la licencia">
							{uploadErrorMessages[uploadErrorCode] ??
								"Revisa el archivo y el alcance e inténtalo de nuevo."}
						</Notice>
					) : null}
					{tourEvidenceOptions.activity.length && navigation?.experienceId ? (
						<ProviderVerificationOptionals
							surface="tour-activity"
							renewalDocumentId={Astro.url.searchParams.get("renewDocumentId")}
							documentPresentation={tourDocumentPresentation}
							resourceChoices={tourResources}
							guideResources={tourResources.filter((resource) => resource.type === "guide")}
							documents={tourEvidenceDocuments("activity")}
							documentTypes={tourEvidenceOptions.activity}
							canManageDocuments={canManageDocuments}
							scopeProductId={navigation.experienceId}
							availableProducts={tourProducts.map((product) => ({
								...product,
								kind: "tour" as const,
							}))}
							documentAssignments={documentAssignments}
							defaultUploadType={requestedType}
						/>
					) : null}
				</section>
			) : null
		}

		{
			selectedLine === "tour" && screen ? (
				<section
					class="space-y-6 md:space-y-8"
					data-verification-trust-panel="safety"
					data-active={activeSectionId === "safety" ? "true" : "false"}
					hidden={activeSectionId !== "safety" ? true : undefined}
					aria-labelledby="verification-panel-safety-title"
				>
					<h2 id="verification-panel-safety-title" class="sr-only">
						Seguridad y permisos
					</h2>
					{navigation?.experienceId && (
						<ProviderVerificationLineSections
							screen={screen}
							line="tour"
							tourArea="safety"
							experienceId={navigation?.experienceId}
							safetyState={tourPlaybook.find((tab) => tab.id === "safety")?.uiState}
						/>
					)}
					{result === "submitted" ? (
						<Notice variant="success" title="Respaldo enviado">
							La evidencia de seguridad quedó en revisión para esta experiencia.
						</Notice>
					) : null}
					{result === "error" ? (
						<Notice variant="warning" title="No se pudo enviar el respaldo">
							{uploadErrorMessages[uploadErrorCode] ??
								"Revisa el archivo y el alcance e inténtalo de nuevo."}
						</Notice>
					) : null}
					{tourEvidenceOptions.safety.length && navigation?.experienceId ? (
						<ProviderVerificationOptionals
							surface="tour-safety"
							renewalDocumentId={Astro.url.searchParams.get("renewDocumentId")}
							documentPresentation={tourDocumentPresentation}
							resourceChoices={tourResources}
							guideResources={tourResources.filter((resource) => resource.type === "guide")}
							documents={tourEvidenceDocuments("safety")}
							documentTypes={tourEvidenceOptions.safety}
							canManageDocuments={canManageDocuments}
							scopeProductId={navigation.experienceId}
							availableProducts={tourProducts.map((product) => ({
								...product,
								kind: "tour" as const,
							}))}
							documentAssignments={documentAssignments}
							defaultUploadType={requestedType}
						/>
					) : null}
				</section>
			) : null
		}

		<section
			class="space-y-6 md:space-y-8"
			data-verification-trust-panel="fiscal"
			data-active={activeSectionId === "fiscal" ? "true" : "false"}
			hidden={activeSectionId !== "fiscal" ? true : undefined}
			aria-labelledby="verification-panel-fiscal-title"
		>
			<h2 id="verification-panel-fiscal-title" class="sr-only">{panelLabel("fiscal")}</h2>
			{
				fiscalResult === "tax_profile_saved" ? (
					<Notice variant="success" title="Identidad fiscal enviada">
						<p>
							Guardamos tu registro fiscal. Quedó en revisión; el resultado aparecerá en este
							eslabón cuando el equipo Fastt termine.
						</p>
						<p
							class="mt-3 flex flex-wrap gap-3"
							data-post-save-cta
							data-funnel-domain="fiscality"
							data-funnel-surface="verification_fiscal"
						>
							<a
								class="font-semibold underline"
								href={
									selectedLine === "tour" && !navigation?.fasttCollects
										? lineHref("activity")
										: lineHref("payments")
								}
							>
								{selectedLine === "tour" && !navigation?.fasttCollects
									? "Volver a actividad"
									: "Continuar a pagos"}
							</a>
						</p>
					</Notice>
				) : null
			}
			<ProviderTaxProfileCard
				taxConfiguration={taxConfiguration}
				canManageFiscality={canManageFiscality}
				reviewAssignment={fiscalAssignment}
				formReturnTo="verificationFiscal"
				saveError={fiscalError}
			/>
		</section>

		<section
			class="space-y-6 md:space-y-8"
			data-verification-trust-panel="payments"
			data-active={activeSectionId === "payments" ? "true" : "false"}
			hidden={activeSectionId !== "payments" ? true : undefined}
			aria-labelledby="verification-panel-payments-title"
		>
			<h2 id="verification-panel-payments-title" class="sr-only">{panelLabel("payments")}</h2>
			{
				screen && !screen.paymentsCountsForSelling ? (
					<Notice variant="info" title="Pagos no cuenta para vender">
						El cobro de esta cuenta es directo. La cuenta de liquidación de Fastt queda fuera del
						avance de la experiencia y del alojamiento.
					</Notice>
				) : null
			}
			{
				paymentResult && paymentResultMessages[paymentResult] ? (
					<Notice
						variant={paymentResultMessages[paymentResult].variant}
						title={paymentResultMessages[paymentResult].title}
					>
						<p>{paymentResultMessages[paymentResult].body}</p>
						<p
							class="mt-3"
							data-post-save-cta
							data-funnel-domain="payments"
							data-funnel-surface="verification_payments"
						>
							<a
								class="font-semibold underline"
								href={lineHref("identity")}
								data-funnel-cta="post_save"
							>
								Volver al mapa de Verificación
							</a>
						</p>
					</Notice>
				) : null
			}
			{
				paymentError && paymentErrorMessages[paymentError] ? (
					<Notice
						variant={paymentErrorMessages[paymentError].variant}
						title={paymentErrorMessages[paymentError].title}
					>
						{paymentErrorMessages[paymentError].body}
					</Notice>
				) : null
			}
			<ProviderPaymentAccountsCard
				accounts={paymentAccounts}
				canManagePayments={canManagePayments}
				defaultCurrency={defaultCurrency}
				paymentAssignments={paymentAssignments}
				payoutRail={payoutRail}
				formReturnTo="verificationPayments"
			/>
		</section>
	</div>

	<details
		class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-slate-50 px-5 py-4"
		data-verification-optionals-entry
		data-verification-optionals="entry"
		data-verification-optionals-collapsed="true"
		hidden={optionalsEntryActive ? undefined : true}
	>
		<summary class="cursor-pointer list-none">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<p class="text-sm font-semibold text-slate-950">
						Documentos adicionales si te los pedimos
					</p>
					<p class="mt-1 text-sm leading-6 text-slate-600">
						{
							screen
								? "El paquete de cada línea está en las secciones de arriba."
								: "Propiedad, licencias y domicilio no desbloquean los mínimos."
						}
						{
							optionalDocumentsCount
								? ` ${optionalDocumentsCount} documento${optionalDocumentsCount === 1 ? "" : "s"} en archivo${
										optionalPendingCount ? ` · ${optionalPendingCount} en espera` : ""
									}.`
								: " Aún no hay opcionales cargados."
						}
					</p>
				</div>
				<span class="text-sm font-semibold text-slate-700">Ver detalle</span>
			</div>
		</summary>
		<div class="mt-4 border-t border-slate-200 pt-4">
			<a
				href={routes.providerSettingsVerificationDocuments()}
				class="inline-flex text-sm font-semibold text-slate-900 underline underline-offset-2"
				data-verification-optionals-open
			>
				Abrir archivo de opcionales →
			</a>
		</div>
	</details>

	{
		trustLinks.length > 0 && !trustMapComplete ? (
			<p class="text-xs leading-5 text-slate-500/90" data-trust-map-parallel-work>
				Puedes preparar estas áreas en paralelo. Cada formulario solo se limita por permisos o por
				una verificación que sigue en curso.
			</p>
		) : null
	}
</div>
<style is:global>
	.verification-trust-panels-stage {
		position: relative;
		isolation: isolate;
	}

	[data-verification-trust-panel] {
		transition:
			opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1),
			transform 0.42s cubic-bezier(0.4, 0, 0.2, 1),
			visibility 0.42s;
	}

	[data-verification-trust-panel][data-active="false"] {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.45rem);
		pointer-events: none;
	}

	[data-verification-trust-panel][data-active="true"] {
		position: relative;
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	[data-verification-page-description] {
		transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-verification-trust-panel] {
			transition: none;
		}

		[data-verification-trust-panel][data-active="false"] {
			position: absolute;
			display: none;
		}

		[data-verification-page-description] {
			transition: none;
		}
	}
</style>
<script>
	import "@/pages/provider/settings/_client/verification-form-submit-pending.js"
	import "@/pages/provider/settings/_client/verification-trust-panels.js"
</script>
