---
import ProviderReviewWaitNotice from "@/components/provider/ProviderReviewWaitNotice.astro"
import ProviderTourEvidenceFields from "@/components/provider/ProviderTourEvidenceFields.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Input from "@/components/ui/Input.astro"
import Notice from "@/components/ui/Notice.astro"
import Select from "@/components/ui/Select.astro"
import { isProviderDocumentExpired, type ProviderDocumentRecord } from "@/lib/provider-documents"
import {
	tourComplianceActivityClasses,
	tourComplianceActivityLabels,
} from "@/lib/tours/tour-compliance-context"
import type { DocumentListPresentation } from "@/lib/verification/document-list-presentation"
import { copyVerificationNavigationQuery } from "@/lib/verification/navigation"

type OptionalDocType = { value: string; label: string; description?: string }

type Props = {
	documentPresentation?: Record<string, DocumentListPresentation>
	guideResources?: Array<{ id: string; name: string }>
	resourceChoices?: Array<{ id: string; name: string; type: string }>
	surface?: "archive" | "tour-activity" | "tour-safety"
	documents?: ProviderDocumentRecord[]
	documentTypes?: OptionalDocType[]
	canManageDocuments?: boolean
	defaultUploadType?: string | null
	playbookReturnTo?: string | null
	playbookVertical?: string | null
	scopeProductId?: string | null
	/** Other tours for which this exact submitted evidence also applies. */
	availableProducts?: Array<{ id: string; name: string | null; kind?: "tour" | "lodging" }>
	renewalDocumentId?: string | null
	documentAssignments?: Record<
		string,
		{
			slaDueAt: Date | string | null
			slaState: "ok" | "due_soon" | "overdue" | "done"
		}
	>
}

const {
	documentPresentation = {},
	guideResources = [],
	resourceChoices = [],
	surface = "archive",
	documents = [],
	documentTypes = [],
	canManageDocuments = false,
	defaultUploadType = null,
	playbookReturnTo = null,
	playbookVertical = null,
	scopeProductId = null,
	availableProducts = [],
	renewalDocumentId = null,
	documentAssignments = {},
} = Astro.props as Props
const tourSurface = surface !== "archive"

const pendingCount = documents.filter((doc) => doc.status === "pending").length
const verifiedCount = documents.filter(
	(doc) => doc.status === "verified" && (!tourSurface || !isProviderDocumentExpired(doc.expiresAt))
).length
const rejectedCount = documents.filter((doc) => doc.status === "rejected").length
const expiredDocuments = documents.filter(
	(doc) => doc.status === "verified" && isProviderDocumentExpired(doc.expiresAt)
)
const renewalDocument = documents.find((document) => document.id === renewalDocumentId) ?? null
const renewalIsExpired = Boolean(
	renewalDocument?.status === "verified" && isProviderDocumentExpired(renewalDocument.expiresAt)
)
const uploadTypes = renewalIsExpired
	? documentTypes.filter(
			(item) =>
				item.value === renewalDocument?.type || item.value.startsWith(`${renewalDocument?.type}::`)
		)
	: documentTypes
const selectedType = renewalIsExpired
	? uploadTypes.some((item) => item.value === defaultUploadType)
		? defaultUploadType
		: uploadTypes.length === 1
			? uploadTypes[0].value
			: null
	: documentTypes.some((item) => item.value === defaultUploadType)
		? defaultUploadType
		: documentTypes[0]?.value
const selectedLine = selectedType?.includes("::tour.")
	? "tour"
	: selectedType?.includes("::lodging.") || selectedType === "ownership_proof"
		? "lodging"
		: null
const scopeProducts = selectedLine
	? availableProducts.filter((product) => product.kind === selectedLine)
	: availableProducts
const otherProducts = availableProducts.filter(
	(product) => product.id !== scopeProductId && (!selectedLine || product.kind === selectedLine)
)

function requirementHref(type: string) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("type", type)
	return `?${params.toString()}#tour-evidence-${surface}`
}
function renewalHref(documentId: string) {
	const params = new URLSearchParams(Astro.url.searchParams)
	params.set("renewDocumentId", documentId)
	return `?${params.toString()}`
}
const uploadAction = copyVerificationNavigationQuery(
	new URL("/api/provider/settings/documents", Astro.url),
	Astro.url
)
---

<section
	id={tourSurface ? `tour-evidence-${surface}` : undefined}
	class="space-y-5"
	data-verification-optionals
	data-verification-optionals-page={surface === "archive" ? true : undefined}
	data-tour-evidence-area={tourSurface ? surface : undefined}
>
	{
		expiredDocuments.length ? (
			<Notice variant="warning" title="Renovación necesaria">
				{expiredDocuments.length === 1
					? "Una evidencia verificada venció. No modifica reservas confirmadas; renueva su alcance antes de abrir nuevas salidas afectadas."
					: `${expiredDocuments.length} evidencias verificadas vencieron. No modifican reservas confirmadas; renueva su alcance antes de abrir nuevas salidas afectadas.`}
			</Notice>
		) : null
	}
	<div class="space-y-3" data-optional-documents-list>
		{
			documents.length ? (
				documents.map((doc) => (
					<Card variant="soft" class="space-y-3">
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<p class="text-sm font-semibold text-slate-950">{doc.typeLabel}</p>
								<p class="mt-1 text-sm text-slate-600">
									{doc.fileName || "Sin nombre de archivo"}
									{doc.mimeType ? ` · ${doc.mimeType}` : ""}
								</p>
								{doc.submissionNotes ? (
									<p class="mt-2 text-sm leading-6 text-slate-600">
										Nota de envío: {doc.submissionNotes}
									</p>
								) : null}
								{doc.expiresAt ? (
									<p class="mt-2 text-sm text-slate-600">
										Vence:{" "}
										{new Intl.DateTimeFormat("es-BO", { dateStyle: "medium" }).format(
											doc.expiresAt
										)}
									</p>
								) : null}
								{tourSurface && documentPresentation[doc.id] ? (
									<div class="mt-3 space-y-2 text-sm text-slate-600">
										<p>
											<strong>Archivo:</strong> {documentPresentation[doc.id].fileLabel}
										</p>
										<p>
											<strong>Para esta experiencia:</strong>{" "}
											{documentPresentation[doc.id].applicabilityLabel}
										</p>
										<p>{documentPresentation[doc.id].detail}</p>
										<p>
											<strong>Titular:</strong> {documentPresentation[doc.id].subjectLabel}
										</p>
										<p>
											<strong>Alcance:</strong> {documentPresentation[doc.id].scopeLabel}
										</p>
									</div>
								) : doc.scopes.length ? (
									<p class="mt-2 text-sm leading-6 text-slate-600">
										Alcance:{" "}
										{doc.scopes
											.map((scope) =>
												scope.productId
													? "oferta vinculada"
													: scope.territoryLabel ||
														scope.territoryCode ||
														scope.activityClass ||
														"recurso"
											)
											.join(" · ")}
									</p>
								) : null}
								{doc.status === "rejected" && doc.reviewNotes ? (
									<Notice variant="error" title="Motivo del rechazo" class="mt-3">
										{doc.reviewNotes}
									</Notice>
								) : doc.reviewNotes ? (
									<p class="mt-2 text-sm leading-6 text-slate-600">
										Nota de revisión: {doc.reviewNotes}
									</p>
								) : null}
							</div>
							<Badge
								variant={
									doc.tone === "success"
										? "success"
										: doc.tone === "error"
											? "error"
											: doc.tone === "warning"
												? "warning"
												: "neutral"
								}
							>
								{tourSurface
									? (documentPresentation[doc.id]?.fileLabel ?? doc.statusLabel)
									: doc.statusLabel}
							</Badge>
						</div>

						{doc.status === "pending" ? (
							<ProviderReviewWaitNotice
								domain="document"
								assignment={documentAssignments[doc.id] ?? null}
								class="mt-3"
							/>
						) : null}
						{doc.status === "verified" &&
						isProviderDocumentExpired(doc.expiresAt) &&
						(!tourSurface || doc.scopes.some((scope) => scope.productId === scopeProductId)) ? (
							<a
								href={renewalHref(doc.id)}
								class="inline-flex text-sm font-semibold text-slate-900 underline underline-offset-2"
							>
								Renovar esta evidencia →
							</a>
						) : null}
					</Card>
				))
			) : (
				<Card variant="soft" class="text-sm text-slate-600" data-optional-empty>
					{tourSurface
						? "Todavía no hay evidencia enviada para esta área de la experiencia."
						: "Todavía no hay evidencia enviada para esta línea."}
				</Card>
			)
		}
	</div>

	{
		canManageDocuments && uploadTypes.length ? (
			<form
				class="fastt-notice space-y-4 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
				method="post"
				action={`${uploadAction.pathname}${uploadAction.search}`}
				enctype="multipart/form-data"
				id={tourSurface ? `tour-evidence-upload-${surface}` : "optional-upload"}
				data-astro-reload
				data-optional-upload-form
			>
				<input type="hidden" name="action" value="submit" />
				{renewalIsExpired ? (
					<input type="hidden" name="replacesDocumentId" value={renewalDocument!.id} />
				) : null}
				{playbookReturnTo ? <input type="hidden" name="returnTo" value={playbookReturnTo} /> : null}
				{playbookVertical === "tour" || playbookVertical === "hotel" ? (
					<input type="hidden" name="playbookVertical" value={playbookVertical} />
				) : null}
				{scopeProductId ? (
					<input type="hidden" name="scopeProductId" value={scopeProductId} />
				) : null}
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div>
						<h3 class="text-base font-semibold text-slate-950">
							{renewalIsExpired
								? `Renovar ${renewalDocument?.typeLabel}`
								: tourSurface
									? "Enviar evidencia de esta experiencia"
									: "Enviar evidencia"}
						</h3>
						<p class="mt-1 text-sm leading-6 text-slate-600">
							{renewalIsExpired
								? "La evidencia anterior queda en el historial. Declara de nuevo el alcance real de la renovación; no se copiará por suposición."
								: tourSurface
									? "Adjunta el respaldo que corresponde a esta actividad. Se revisará su titular, territorio y vigencia antes de habilitarla."
									: "Adjunta PDF o imagen (máx. 12 MB). La revisión determinará si cubre el requisito y la oferta indicados."}
						</p>
					</div>
					<div class="flex flex-wrap gap-2">
						<Badge variant={pendingCount ? "warning" : "neutral"}>
							{pendingCount} enviado{pendingCount === 1 ? "" : "s"}
						</Badge>
						<Badge variant={verifiedCount ? "success" : "neutral"}>
							{verifiedCount}{" "}
							{tourSurface ? "archivos aprobados" : `verificado${verifiedCount === 1 ? "" : "s"}`}
						</Badge>
						<Badge variant={rejectedCount ? "error" : "neutral"}>
							{rejectedCount} por corregir
						</Badge>
					</div>
				</div>
				{tourSurface ? (
					<p class="text-xs leading-5 text-slate-500">
						Estos contadores describen archivos revisados. El requisito se considera listo sólo si
						el titular, alcance y vigencia coinciden con la experiencia indicada arriba.
					</p>
				) : null}
				{tourSurface ? (
					<div class="space-y-2">
						<p class="text-sm font-semibold text-slate-900">Respaldo que vas a enviar</p>
						<nav aria-label="Requisito documental" class="flex flex-wrap gap-2">
							{uploadTypes.map((item) => (
								<a
									href={requirementHref(item.value)}
									aria-current={item.value === selectedType ? "page" : undefined}
									class="rounded-lg border border-slate-200 px-3 py-2 text-sm"
								>
									{item.label}
								</a>
							))}
						</nav>
						<input type="hidden" name="type" value={selectedType ?? ""} />
						{scopeProductId && (
							<p class="text-sm text-slate-600">
								Experiencia:{" "}
								{availableProducts.find((product) => product.id === scopeProductId)?.name ||
									"Experiencia sin nombre"}
							</p>
						)}
					</div>
				) : (
					<label class="grid gap-2 text-sm font-medium text-slate-700">
						Tipo
						<Select name="type" required>
							{selectedType === null ? (
								<option value="" disabled selected>
									Selecciona la habilitación que vas a renovar
								</option>
							) : null}
							{uploadTypes.map((item) => (
								<option value={item.value} selected={item.value === selectedType}>
									{item.label}
								</option>
							))}
						</Select>
					</label>
				)}

				{tourSurface ? (
					<ProviderTourEvidenceFields
						selectedType={selectedType}
						scopeProductId={scopeProductId}
						scopeProducts={scopeProducts}
						otherProducts={otherProducts}
						guideResources={guideResources}
						resourceChoices={resourceChoices}
					/>
				) : (
					<details
						class="fastt-soft-box border border-slate-200 bg-slate-50 p-4"
						open={tourSurface ? true : undefined}
					>
						<summary class="cursor-pointer font-semibold text-slate-900">
							Alcance y vigencia de esta evidencia
						</summary>
						<p class="mt-2 text-sm leading-6 text-slate-600">
							Indica sólo lo que el documento realmente cubre. Otra licencia o póliza no reemplaza
							esta.
						</p>
						{!scopeProductId && scopeProducts.length ? (
							<label class="mt-4 grid gap-2 text-sm font-medium text-slate-700">
								Oferta principal cubierta
								<Select name="scopeProductId" required>
									<option value="" disabled selected>
										Selecciona la oferta que cubre este documento
									</option>
									{scopeProducts.map((product) => (
										<option value={product.id}>
											{product.name ||
												(product.kind === "lodging"
													? "Alojamiento sin nombre"
													: "Experiencia sin nombre")}
										</option>
									))}
								</Select>
							</label>
						) : null}
						{otherProducts.length ? (
							<fieldset class="mt-4 grid gap-2 text-sm text-slate-700">
								<legend class="font-medium">
									Ofertas cubiertas{scopeProductId ? " también" : ""}
								</legend>
								<p class="text-xs leading-5 text-slate-500">
									Marca sólo las ofertas que este archivo cubre. La evidencia de una oferta no se
									reutiliza en otra sin revisión de alcance.
								</p>
								<div class="grid gap-2 sm:grid-cols-2">
									{otherProducts.map((product) => (
										<label class="fastt-soft-box inline-flex items-center gap-2 border border-slate-200 bg-white px-3 py-2">
											<input type="checkbox" name="scopeProductId" value={product.id} />
											{product.name ||
												(product.kind === "lodging"
													? "Alojamiento sin nombre"
													: "Experiencia sin nombre")}
										</label>
									))}
								</div>
							</fieldset>
						) : null}
						<div class="mt-4 grid gap-4 sm:grid-cols-2">
							<label class="grid gap-2 text-sm font-medium text-slate-700">
								Emisor
								<Input name="issuer" placeholder="Autoridad o aseguradora" />
							</label>
							<label class="grid gap-2 text-sm font-medium text-slate-700">
								Emitido el (opcional)
								<Input name="issuedAt" type="date" />
							</label>
							<label class="grid gap-2 text-sm font-medium text-slate-700">
								Vence el
								<Input name="expiresAt" type="date" />
							</label>
							<label class="grid gap-2 text-sm font-medium text-slate-700">
								Titular cubierto
								<Select name="subjectType" required={tourSurface}>
									{tourSurface ? (
										<option value="" disabled selected>
											Selecciona a quién cubre
										</option>
									) : null}
									<option value="provider">Proveedor</option>
									<option value="legal_entity">Entidad legal</option>
									<option value="person">Persona o guía</option>
									<option value="resource">Recurso operativo</option>
									<option value="third_party">Tercero</option>
								</Select>
								{tourSurface ? (
									<span class="text-xs leading-5 font-normal text-slate-500">
										La credencial de guía debe identificar a una persona o recurso; una licencia del
										establecimiento no la sustituye.
									</span>
								) : null}
							</label>
							<label class="grid gap-2 text-sm font-medium text-slate-700">
								Referencia del titular{tourSurface ? "" : " (si corresponde)"}
								<Input
									name="subjectReference"
									required={tourSurface}
									placeholder="Identificador del guía o recurso registrado"
								/>
							</label>
							<label class="grid gap-2 text-sm font-medium text-slate-700">
								Código territorial (opcional)
								<Input name="territoryCode" placeholder="BO-LP o código de permiso" />
							</label>
							<label class="grid gap-2 text-sm font-medium text-slate-700">
								Territorio cubierto (opcional)
								<Input name="territoryLabel" placeholder="La Paz, ruta o área autorizada" />
							</label>
						</div>
						<fieldset class="mt-4 grid gap-2 text-sm text-slate-700">
							<legend class="font-medium">Actividad cubierta (si corresponde)</legend>
							<div class="flex flex-wrap gap-x-4 gap-y-2">
								{tourComplianceActivityClasses.map((value) => (
									<label class="inline-flex items-center gap-2">
										<input type="checkbox" name="activityClass" value={value} />
										{tourComplianceActivityLabels[value]}
									</label>
								))}
							</div>
						</fieldset>
					</details>
				)}
				<label class="grid gap-2 text-sm font-medium text-slate-700">
					Archivo
					<input
						type="file"
						name="file"
						required
						accept=".pdf,image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf"
						class="fastt-field block min-h-12 w-full text-sm text-slate-700 file:mr-3 file:bg-slate-900 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white"
					/>
				</label>
				<label class="grid gap-2 text-sm font-medium text-slate-700">
					Notas de envío (opcional)
					<Input name="submissionNotes" placeholder="Versión vigente / dato actualizado" />
				</label>
				<div class="fastt-form-submit-footer">
					<Button
						type="submit"
						variant="selection"
						class="w-full sm:w-auto"
						disabled={!selectedType}
					>
						Enviar a revisión
					</Button>
				</div>
			</form>
		) : renewalIsExpired && canManageDocuments ? (
			<Notice variant="warning" title="Esta evidencia requiere revisión de alcance">
				Su tipo ya no aparece entre los requisitos de esta línea. Revisa la actividad declarada
				antes de renovarla.
			</Notice>
		) : null
	}
</section>
