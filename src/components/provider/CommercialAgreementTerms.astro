---
import type { AgreementRow, OfferedTerms } from "@/modules/financial/commercial-agreements"
const { agreement } = Astro.props as { agreement: AgreementRow }
const terms = agreement.termsJson as OfferedTerms | null
const date = (value: string) =>
	new Intl.DateTimeFormat("es-BO", { dateStyle: "medium", timeZone: "UTC" }).format(new Date(value))
---

{
	terms && (
		<div class="space-y-4">
			<dl class="grid gap-4 text-sm sm:grid-cols-2">
				<div>
					<>
						<dt class="text-slate-500">Vendedor y beneficiario</dt>
						<dd class="mt-1 font-medium text-slate-950">{terms.sellerName}</dd>
					</>
				</div>
				<div>
					<>
						<dt class="text-slate-500">Comisión</dt>
						<dd class="mt-1 font-medium text-slate-950">
							{terms.commissionPercent}% · {terms.currency}
						</dd>
					</>
				</div>
				<div>
					<>
						<dt class="text-slate-500">Vigencia</dt>
						<dd class="mt-1 text-slate-800">
							{date(terms.effectiveFrom)} → {date(terms.effectiveTo)}
						</dd>
					</>
				</div>
				<div>
					<>
						<dt class="text-slate-500">Pago del viajero</dt>
						<dd class="mt-1 text-slate-800">{terms.paymentTiming}</dd>
					</>
				</div>
			</dl>
			<p class="text-sm text-slate-600">
				<span class="font-semibold">Base de comisión: </span>
				{terms.commissionBase}
			</p>
			{agreement.status === "accepted" && agreement.acceptedAt && (
				<p class="text-xs text-slate-500">
					Aceptado el{" "}
					{new Intl.DateTimeFormat("es-BO", { dateStyle: "medium" }).format(agreement.acceptedAt)}
				</p>
			)}
			<details class="border-t border-slate-200 pt-4">
				<summary class="cursor-pointer text-sm font-semibold text-slate-800">
					Ver condiciones completas · Versión {agreement.version}
				</summary>
				<dl class="mt-3 space-y-3 text-sm text-slate-700">
					<div>
						<>
							<dt class="font-semibold">Cancelaciones</dt>
							<dd>{terms.cancellationTerms}</dd>
						</>
					</div>
					<div>
						<>
							<dt class="font-semibold">Conciliación</dt>
							<dd>{terms.settlementTerms}</dd>
						</>
					</div>
					<div>
						<>
							<dt class="font-semibold">Responsabilidades fiscales</dt>
							<dd>{terms.fiscalResponsibilities}</dd>
						</>
					</div>
				</dl>
				<p class="mt-3 text-sm leading-6 whitespace-pre-wrap text-slate-700">{terms.fullTerms}</p>
				<p class="mt-3 text-xs text-slate-500">Referencia: {terms.documentReference}</p>
			</details>
		</div>
	)
}
