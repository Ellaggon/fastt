---
import ProviderReviewWaitNotice from "@/components/provider/ProviderReviewWaitNotice.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import type { ProviderDocumentRecord } from "@/lib/provider-documents"
import { evaluateRequiredKycDocumentsComplete } from "@/lib/provider-documents"
import { resolveProviderRejectCategory } from "@/lib/provider-reject-categories"
import { buildProviderReviewWaitState } from "@/lib/provider-review-wait-state"
import { labelAccountVerificationStatus, TRUST_GLOSSARY } from "@/lib/provider-trust-map"
import { routes } from "@/lib/routes"

type Props = {
	latestVerification?: {
		status?: string | null
		reason?: string | null
		createdAt?: Date | string | null
	} | null
	documents?: ProviderDocumentRecord[]
	showHeader?: boolean
	/** V1: secondary = below fold, collapsed by default */
	placement?: "primary" | "secondary"
	reviewAssignment?: {
		slaDueAt: Date | string | null
		slaState: "ok" | "due_soon" | "overdue" | "done"
	} | null
	/** V2 Lista: trust map completo — sin consequence amarilla */
	trustMapComplete?: boolean
	/**
	 * P1 wait/status: when the fold hero owns the active upload/access job (or docs
	 * are already submitted), hide yellow «Qué se bloquea» and use compact wait.
	 */
	suppressConsequence?: boolean
}

const {
	latestVerification,
	documents = [],
	showHeader = true,
	placement = "primary",
	reviewAssignment = null,
	trustMapComplete = false,
	suppressConsequence = false,
} = Astro.props as Props
const isSecondary = placement === "secondary"
const status = String(latestVerification?.status ?? "pending")
const accountLabel = labelAccountVerificationStatus(status)
const isApproved = status === "approved"
const isPending = !isApproved && status !== "rejected"
const statusLabel = accountLabel.label
const reviewedLabel = latestVerification?.createdAt
	? new Date(latestVerification.createdAt).toLocaleString("es-BO", {
			day: "2-digit",
			month: "short",
			year: "numeric",
			hour: "2-digit",
			minute: "2-digit",
		})
	: "Sin registro de revisión"

const rejectCategory =
	status === "rejected"
		? resolveProviderRejectCategory(latestVerification?.reason, "verification")
		: null

const verifiedDocuments = documents.filter((doc) => doc.status === "verified")
const pendingDocuments = documents.filter((doc) => doc.status === "pending")
const kyc = evaluateRequiredKycDocumentsComplete(documents)
const documentsComplete = kyc.complete
const showReadyConsequence = Boolean(trustMapComplete || (isApproved && documentsComplete))
const showWarningConsequence =
	!suppressConsequence && !showReadyConsequence && (!isApproved || !documentsComplete)
const accountWait = buildProviderReviewWaitState("verification", { assignment: reviewAssignment })
/** Compact one-line wait when upload/access is the active job (no yellow essay). */
const useCompactWait = Boolean(suppressConsequence)

const accountConsequence = isApproved
	? "La cuenta lista habilita publicar y operar con los controles actuales."
	: "Sin la cuenta lista no puedes publicar ni aceptar reservas con confianza."
const documentsConsequence = documentsComplete
	? "Documentos mínimos listos para cobros y conectores sensibles."
	: "Sin los documentos mínimos verificados no puedes liquidar cobros ni activar conectores sensibles."
const listaConsequence =
	"Identidad, negocio, fiscal y pagos están alineados. Puedes publicar o revisar liquidaciones."
---

<section
	class="space-y-4"
	data-verification-status
	data-verification-placement={placement}
	data-account-status-label={statusLabel}
	data-verification-suppress-warning={suppressConsequence ? "true" : undefined}
	data-verification-compact-wait={useCompactWait ? "true" : undefined}
	data-verification-matrix="removed"
	id="verification-status-panel"
>
	{
		showHeader && !isSecondary ? (
			<header class="space-y-1">
				<p class="text-xs font-semibold tracking-[0.18em] text-slate-500 uppercase">
					{TRUST_GLOSSARY.page.eyebrow}
				</p>
				<h2 class="text-lg font-semibold text-slate-100">{TRUST_GLOSSARY.page.heading}</h2>
				<p class="text-sm text-slate-300">{TRUST_GLOSSARY.page.description}</p>
			</header>
		) : null
	}

	{
		isSecondary ? (
			<details
				class="fastt-notice rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5"
				data-verification-status-panel
			>
				<summary class="cursor-pointer">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div>
							<p class="text-xs font-semibold tracking-[0.14em] text-slate-500 uppercase">
								Estado de la cuenta (Identidad)
							</p>
							<p class="mt-1 text-lg font-semibold text-slate-950">{statusLabel}</p>
						</div>
						<Badge variant={accountLabel.tone}>{statusLabel}</Badge>
					</div>
					{isPending ? (
						<p class="mt-2 text-sm text-slate-600" data-verification-wait-summary>
							{accountWait.label}
							{accountWait.sla.hasPublishedSla
								? ` · ${accountWait.footnote}`
								: " · El resultado aparecerá aquí"}
						</p>
					) : (
						<p class="mt-2 text-sm text-slate-600">
							Notas de revisión de cuenta. Negocio, Fiscal y Pagos se siguen en el progreso de
							arriba.
						</p>
					)}
				</summary>
				<div class="mt-5 space-y-6 border-t border-slate-200 pt-5">
					<p class="text-sm leading-6 text-slate-600" data-trust-progress-pointer>
						El{" "}
						<a class="font-semibold underline" href="#trust-map-rail">
							progreso de arriba
						</a>{" "}
						es la única lectura de camino. Este panel solo detalla Identidad (revisión de cuenta).
					</p>

					{suppressConsequence ? null : (
						<p class="text-sm leading-6 text-slate-600" data-trust-account-vs-docs>
							{TRUST_GLOSSARY.page.accountVsDocs}
						</p>
					)}

					{showWarningConsequence ? (
						<Notice variant="warning" title="Qué se bloquea" data-verification-consequence>
							<ul class="list-disc space-y-1 pl-5 text-sm leading-6">
								{!isApproved ? <li>{accountConsequence}</li> : null}
								{!documentsComplete ? <li>{documentsConsequence}</li> : null}
							</ul>
						</Notice>
					) : showReadyConsequence ? (
						<Notice
							variant="success"
							title={trustMapComplete ? "Lista" : "Listo para operar"}
							data-verification-consequence
							data-verification-consequence-tone="success"
						>
							{trustMapComplete
								? listaConsequence
								: `${accountConsequence} ${documentsConsequence}`}
						</Notice>
					) : null}

					<div class="grid gap-4 md:grid-cols-2">
						<Card variant="soft">
							<p class="text-sm font-medium text-slate-700">Última actualización</p>
							<p class="mt-1 text-sm text-slate-950">{reviewedLabel}</p>
						</Card>
						<Card variant="soft">
							<p class="text-sm font-medium text-slate-700">Documentos en archivo</p>
							<p class="mt-1 text-sm text-slate-950">
								{verifiedDocuments.length} verificados · {pendingDocuments.length} enviados
							</p>
						</Card>
					</div>

					<Card variant="plain">
						<p class="text-sm font-medium text-slate-700">Motivo o nota de revisión</p>
						{rejectCategory?.matched ? (
							<Badge variant="error" class="mt-2" data-reject-category>
								{rejectCategory.label}
							</Badge>
						) : null}
						<p class="mt-1 text-sm leading-6 text-slate-600">
							{latestVerification?.reason ||
								"No hay observaciones registradas por revisión de cuenta."}
						</p>
					</Card>

					{isPending && !useCompactWait ? (
						<ProviderReviewWaitNotice domain="verification" assignment={reviewAssignment} />
					) : isPending && useCompactWait ? (
						<p
							class="text-sm leading-6 text-slate-600"
							data-verification-wait-compact
							data-sla-mirror={accountWait.sla.hasPublishedSla ? "published" : "none"}
						>
							{accountWait.body} {accountWait.footnote}
						</p>
					) : null}

					<div class="flex justify-end">
						<Button href={routes.providerSettings()} variant="secondary">
							Volver al resumen
						</Button>
					</div>
				</div>
			</details>
		) : (
			<Card>
				<div class="space-y-6">
					<div class="flex flex-wrap items-start justify-between gap-4">
						<div class="space-y-2">
							<p class="text-sm font-medium text-slate-500">Estado de la cuenta (Identidad)</p>
							<h3 class="text-2xl font-semibold text-slate-950">{statusLabel}</h3>
							<p class="text-sm leading-6 text-slate-600">
								{isApproved
									? "La cuenta está lista para operar con los controles actuales."
									: status === "rejected"
										? "La cuenta requiere cambios antes de considerarse confiable."
										: "La cuenta está en revisión. Esto no sustituye el envío de documentos mínimos."}
							</p>
						</div>
						<Badge variant={accountLabel.tone}>{statusLabel}</Badge>
					</div>

					<p class="text-sm leading-6 text-slate-600" data-trust-progress-pointer>
						El progreso completo (Identidad → Negocio → Fiscal → Pagos) vive arriba en «Tu progreso»
						— no hay una segunda matriz de revisión.
					</p>

					{suppressConsequence ? null : (
						<p class="text-sm leading-6 text-slate-600" data-trust-account-vs-docs>
							{TRUST_GLOSSARY.page.accountVsDocs}
						</p>
					)}

					{showWarningConsequence ? (
						<Notice variant="warning" title="Qué se bloquea" data-verification-consequence>
							<ul class="list-disc space-y-1 pl-5 text-sm leading-6">
								{!isApproved ? <li>{accountConsequence}</li> : null}
								{!documentsComplete ? <li>{documentsConsequence}</li> : null}
							</ul>
						</Notice>
					) : showReadyConsequence ? (
						<Notice
							variant="success"
							title={trustMapComplete ? "Lista" : "Listo para operar"}
							data-verification-consequence
							data-verification-consequence-tone="success"
						>
							{trustMapComplete
								? listaConsequence
								: `${accountConsequence} ${documentsConsequence}`}
						</Notice>
					) : null}

					<div class="grid gap-4 md:grid-cols-2">
						<Card variant="soft">
							<p class="text-sm font-medium text-slate-700">Última actualización</p>
							<p class="mt-1 text-sm text-slate-950">{reviewedLabel}</p>
						</Card>
						<Card variant="soft">
							<p class="text-sm font-medium text-slate-700">Documentos en archivo</p>
							<p class="mt-1 text-sm text-slate-950">
								{verifiedDocuments.length} verificados · {pendingDocuments.length} enviados
							</p>
						</Card>
					</div>

					<Card variant="plain">
						<p class="text-sm font-medium text-slate-700">Motivo o nota de revisión</p>
						{rejectCategory?.matched ? (
							<Badge variant="error" class="mt-2" data-reject-category>
								{rejectCategory.label}
							</Badge>
						) : null}
						<p class="mt-1 text-sm leading-6 text-slate-600">
							{latestVerification?.reason ||
								"No hay observaciones registradas por revisión de cuenta."}
						</p>
					</Card>

					{isPending && !useCompactWait ? (
						<ProviderReviewWaitNotice domain="verification" assignment={reviewAssignment} />
					) : isPending && useCompactWait ? (
						<p
							class="text-sm leading-6 text-slate-600"
							data-verification-wait-compact
							data-sla-mirror={accountWait.sla.hasPublishedSla ? "published" : "none"}
						>
							{accountWait.body} {accountWait.footnote}
						</p>
					) : null}

					<div class="flex justify-end">
						<Button href={routes.providerSettings()} variant="secondary">
							Volver al resumen
						</Button>
					</div>
				</div>
			</Card>
		)
	}
</section>
