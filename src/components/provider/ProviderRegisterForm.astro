---
import Card from "@/components/ui/Card.astro"
import ProviderRegisterFormBody from "@/components/provider/ProviderRegisterFormBody.astro"
import ProviderSettingsHubCard from "@/components/provider/ProviderSettingsHubCard.astro"
import { routes } from "@/lib/routes"

const {
	provider,
	holderProfile,
	holderStorageReady = true,
	hasProvider = false,
	onboardingNext = "",
	backHref = routes.providerSettings(),
	draft = null,
	fieldErrors = {},
	submitLabel = "Guardar identidad",
	showBackAction = true,
	onboarding = false,
	embedded = false,
	serviceLabel = "servicio",
} = Astro.props
const formAction = hasProvider && provider?.id ? `/api/providers/${provider.id}` : "/api/providers"
const Wrapper = embedded ? "div" : "form"
const settingsHubCard = embedded && !onboarding
const onboardingIntro = hasProvider
	? `Completa la declaración de quién ofrece tu ${serviceLabel}. El negocio ya está guardado; actualizarlo no crea otro ni habilita publicación, reservas o cobros.`
	: `Guardar estos datos crea el negocio desde el que prepararás tu ${serviceLabel}. No publica el ${serviceLabel} ni habilita reservas o cobros.`

const bodyProps = {
	onboardingNext,
	embedded,
	settingsHubCard,
	showBackAction,
	backHref,
	submitLabel,
	provider,
	holderProfile,
	holderStorageReady,
	onboarding,
	serviceLabel,
	draft,
	fieldErrors,
	onboardingIntro,
}
---

{
	settingsHubCard ? (
		<ProviderSettingsHubCard
			eyebrow="Cuenta"
			title="Identidad comercial"
			description="Define cómo se reconoce el negocio dentro de Fastt y en los controles internos."
		>
			<Wrapper
				method={embedded ? undefined : "POST"}
				action={embedded ? undefined : formAction}
				class="space-y-5"
				data-astro-reload={embedded ? undefined : true}
				data-profile-identity-fields
			>
				<ProviderRegisterFormBody {...bodyProps} />
			</Wrapper>
		</ProviderSettingsHubCard>
	) : (
		<section class="space-y-4">
			<header class="space-y-1">
				<p class="text-xs font-semibold tracking-[0.18em] text-slate-500 uppercase">
					{onboarding ? "Paso 1 de 2" : "Configuración del proveedor"}
				</p>
				<h2 class="text-lg font-semibold text-slate-100">
					{onboarding ? `Datos de tu ${serviceLabel}` : "Identidad comercial"}
				</h2>
				<p class="text-sm text-slate-300">
					{onboarding
						? `Primero identifica quién ofrecerá el ${serviceLabel}. Después definirás cómo se preparará.`
						: "Define cómo se reconoce el negocio dentro de Fastt y en los controles internos."}
				</p>
			</header>
			<Card>
				<Wrapper
					method={embedded ? undefined : "POST"}
					action={embedded ? undefined : formAction}
					class="max-w-3xl space-y-6"
					data-astro-reload={embedded ? undefined : true}
					data-profile-identity-fields
				>
					<ProviderRegisterFormBody {...bodyProps} />
				</Wrapper>
			</Card>
		</section>
	)
}
