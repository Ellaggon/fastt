---
import ProviderReviewWaitNotice from "@/components/provider/ProviderReviewWaitNotice.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import type { ProviderKycSlot } from "@/lib/provider-documents"
import { buildProviderReviewWaitState } from "@/lib/provider-review-wait-state"
import { verificationSectionUrl } from "@/lib/verification/navigation"

type Props = {
	kycSlot: ProviderKycSlot
	documentAssignments?: Record<
		string,
		{
			slaDueAt: Date | string | null
			slaState: "ok" | "due_soon" | "overdue" | "done"
		}
	>
	/** Tour/lodging identity fold: one calm block, no stacked notices. */
	compact?: boolean
	showFiscalBridge?: boolean
}

const {
	kycSlot,
	documentAssignments = {},
	compact = false,
	showFiscalBridge = true,
} = Astro.props as Props

const fiscalTarget = verificationSectionUrl(Astro.url, "fiscal")
// Result messages belong to the current submission, not to this next action.
fiscalTarget.searchParams.delete("result")
fiscalTarget.searchParams.delete("error")
const fiscalHref = fiscalTarget.pathname + fiscalTarget.search

const assignment = kycSlot.documentId ? (documentAssignments[kycSlot.documentId] ?? null) : null
const fileLabel = kycSlot.fileName || "Archivo recibido"
const documentWait = buildProviderReviewWaitState("document", { assignment })
---

<div class="space-y-3" data-kyc-slot-review-state>
	{
		compact ? (
			<Card variant="soft" class="space-y-3" data-kyc-slot-pending-compact>
				<div class="flex flex-wrap items-center gap-2">
					<Badge variant="warning">{kycSlot.stateLabel}</Badge>
					<span class="text-sm text-slate-600">Revisión de Fastt</span>
				</div>
				<div data-kyc-slot-submitted-file>
					<p class="text-sm font-semibold text-slate-950">{fileLabel}</p>
					<p class="mt-1 text-sm leading-6 text-slate-600">
						Comprobamos que coincida con los datos de tu cuenta. Te avisamos aquí al terminar.
					</p>
				</div>
				{documentWait.sla.hasPublishedSla ? (
					<p
						class="text-sm leading-6 text-slate-500"
						data-sla-mirror="published"
						data-review-wait-compact
					>
						{documentWait.footnote}
					</p>
				) : null}
				{showFiscalBridge ? (
					<div class="flex flex-wrap items-center gap-2 pt-1" data-kyc-slot-next-action>
						<Button href={fiscalHref} variant="secondary" size="sm">
							Continuar a Fiscalidad
						</Button>
						<span class="text-sm text-slate-600">Mientras tanto, revisa el NIT/TIN.</span>
					</div>
				) : null}
			</Card>
		) : (
			<>
				<p class="text-sm font-medium text-slate-700" data-kyc-slot-review-title>
					Documento en revisión
				</p>
				<Card variant="row" class="space-y-3">
					<div class="flex flex-wrap items-center gap-2" data-kyc-slot-submitted-file>
						<Badge variant="neutral">Archivo enviado</Badge>
						<span class="text-sm font-semibold text-slate-950">{fileLabel}</span>
					</div>
					<p class="text-sm leading-6 text-slate-600">
						Fastt revisará que coincida con los datos del negocio antes de marcarlo como verificado.
					</p>
					<ProviderReviewWaitNotice domain="document" assignment={assignment} compact />
					{showFiscalBridge ? (
						<div class="flex flex-wrap items-center gap-2" data-kyc-slot-next-action>
							<Button href={fiscalHref} variant="secondary" size="sm">
								Continuar a Fiscalidad
							</Button>
						</div>
					) : null}
				</Card>
			</>
		)
	}
</div>
