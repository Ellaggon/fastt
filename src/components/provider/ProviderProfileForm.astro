---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import { providerFormErrorMessage } from "@/lib/provider-form-flash"
import { routes } from "@/lib/routes"

const {
	isProviderAvailable = true,
	profile,
	supportEmailRequired = true,
	showRelatedDomains = true,
	redirectTo = "",
	cancelHref = routes.providerSettings(),
	draft = null,
	fieldErrors = {},
	submitLabel = "Guardar perfil",
	showBackAction = true,
	onboarding = false,
	serviceLabel = "servicio",
} = Astro.props
const value = (field: string, fallback = "") => String(draft?.values?.[field] ?? fallback)
const fieldError = (field: string) =>
	fieldErrors?.[field] ? providerFormErrorMessage(field, String(fieldErrors[field])) : ""
const onboardingIntro = `Estos datos te permiten preparar el calendario y los precios de tu ${serviceLabel}. Guardarlos te lleva a crear su borrador; todavía no lo publica ni habilita reservas.`
---

{
	isProviderAvailable ? (
		<form
			method="POST"
			action="/api/providers/profile"
			class="space-y-6"
			data-profile-ops-form
			data-astro-reload
		>
			{redirectTo ? <Input type="hidden" name="onboardingNext" value={redirectTo} /> : null}
			<p class="text-sm leading-6 text-slate-600">
				{onboarding
					? onboardingIntro
					: "Estos campos alinean reservas, calendario y comunicaciones. La identidad fiscal, payouts e integraciones viven en sus propias secciones."}
			</p>
			<FormField
				label="Zona horaria"
				htmlFor="timezone"
				required
				description={
					onboarding ? "Define las horas de las salidas o la disponibilidad." : undefined
				}
				error={fieldError("timezone")}
			>
				<Select id="timezone" name="timezone" required hasError={Boolean(fieldError("timezone"))}>
					<option
						value="America/La_Paz"
						selected={value("timezone", profile?.timezone ?? "America/La_Paz") === "America/La_Paz"}
					>
						America/La_Paz
					</option>
					<option
						value="America/New_York"
						selected={value("timezone", profile?.timezone ?? "") === "America/New_York"}
					>
						America/New_York
					</option>
					<option
						value="Europe/Madrid"
						selected={value("timezone", profile?.timezone ?? "") === "Europe/Madrid"}
					>
						Europe/Madrid
					</option>
				</Select>
			</FormField>
			<FormField
				label="Moneda por defecto"
				htmlFor="defaultCurrency"
				required
				description={
					onboarding ? "Será la moneda inicial de los precios que configurarás." : undefined
				}
				error={fieldError("defaultCurrency")}
			>
				<Select
					id="defaultCurrency"
					name="defaultCurrency"
					required
					hasError={Boolean(fieldError("defaultCurrency"))}
				>
					<option
						value="BOB"
						selected={value("defaultCurrency", profile?.defaultCurrency ?? "BOB") === "BOB"}
					>
						BOB
					</option>
					<option
						value="USD"
						selected={value("defaultCurrency", profile?.defaultCurrency ?? "") === "USD"}
					>
						USD
					</option>
					<option
						value="EUR"
						selected={value("defaultCurrency", profile?.defaultCurrency ?? "") === "EUR"}
					>
						EUR
					</option>
				</Select>
			</FormField>
			<FormField
				label="Correo de soporte"
				htmlFor="supportEmail"
				required={supportEmailRequired}
				description={
					onboarding
						? "Fastt y los viajeros lo usarán para asuntos de reserva. Te lo pedimos ahora para dejarlo listo antes de publicar y aceptar reservas."
						: "Lo usaremos para comunicaciones operativas y reservas."
				}
				error={fieldError("supportEmail")}
			>
				<Input
					id="supportEmail"
					type="email"
					name="supportEmail"
					required={supportEmailRequired}
					value={value("supportEmail", profile?.supportEmail ?? "")}
					hasError={Boolean(fieldError("supportEmail"))}
				/>
			</FormField>
			<FormField
				label="Teléfono de soporte"
				htmlFor="supportPhone"
				description={onboarding ? "Opcional; puede ayudar a coordinar la operación." : undefined}
				error={fieldError("supportPhone")}
			>
				<Input
					id="supportPhone"
					name="supportPhone"
					value={value("supportPhone", profile?.supportPhone ?? "")}
					hasError={Boolean(fieldError("supportPhone"))}
				/>
			</FormField>
			{showRelatedDomains ? (
				<Card variant="soft" class="text-sm leading-6 text-slate-600">
					<p class="font-medium text-slate-800">Dominios relacionados</p>
					<ul class="mt-2 list-disc space-y-1 pl-4">
						<li>
							<a
								href={routes.providerSettingsTaxFees()}
								class="font-medium text-slate-900 underline underline-offset-2"
							>
								Fiscalidad
							</a>{" "}
							→ perfil fiscal + impuestos/cargos de venta
						</li>
						<li>
							<a
								href={routes.providerSettingsIntegrations()}
								class="font-medium text-slate-900 underline underline-offset-2"
							>
								Integraciones
							</a>{" "}
							→ conectores y prueba de conexión
						</li>
						<li>
							<a
								href={routes.providerSettingsVerification()}
								class="font-medium text-slate-900 underline underline-offset-2"
							>
								Verificación
							</a>{" "}
							→ documentos mínimos de cumplimiento
						</li>
					</ul>
				</Card>
			) : null}
			<div class="flex items-center justify-end gap-3">
				{showBackAction ? (
					<Button href={cancelHref} variant="secondary">
						Volver
					</Button>
				) : null}
				<Button type="submit">{submitLabel}</Button>
			</div>
		</form>
	) : (
		<div class="space-y-4" data-profile-ops-unavailable>
			<p class="text-sm text-slate-600">
				Completa primero la identidad comercial para habilitar el perfil operativo.
			</p>
			<Button href={routes.providerSettingsProfile()}>Ir a identidad</Button>
		</div>
	)
}
