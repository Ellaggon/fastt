---
import Card from "@/components/ui/Card.astro"

interface Props {
	eyebrow?: string
	title: string
	description?: string
	/** Defaults to the Resumen / Pendientes body shell. */
	bodyClass?: string
	class?: string
}

const {
	eyebrow,
	title,
	description,
	bodyClass = "space-y-5 p-6 sm:p-7",
	class: className = "",
	...rest
} = Astro.props
---

<Card variant="flush" class:list={["overflow-hidden", className]} {...rest}>
	<header class="border-b border-sky-100 bg-sky-50/80 px-5 py-5 md:px-6 md:py-6">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				{
					eyebrow ? (
						<p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
							{eyebrow}
						</p>
					) : null
				}
				<h2 class="mt-1 text-lg font-semibold text-slate-950">{title}</h2>
				{
					description ? (
						<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">{description}</p>
					) : null
				}
			</div>
			<slot name="actions" />
		</div>
	</header>
	<div class:list={["bg-slate-50/90", bodyClass]}>
		<slot />
	</div>
</Card>
