---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import { groupFinancialContractReasons } from "@/lib/commercial-policy/financial-contract-presentation"
import type { ProviderContractSurface } from "@/lib/commercial-policy/provider-contract-surface"
const { model } = Astro.props as { model: ProviderContractSurface }
const groups = groupFinancialContractReasons(model.offerings)
---

<div class="space-y-5" data-commercial-contract-status>
	{
		model.offerings.some((row) => row.status === "read_failed") && (
			<Button href={Astro.url.pathname + Astro.url.search} data-astro-reload variant="secondary">
				Volver a comprobar
			</Button>
		)
	}
	{
		groups.map((group) => (
			<Card class="space-y-3">
				<div class="flex flex-wrap items-start justify-between gap-3">
					<p class="max-w-3xl font-semibold text-slate-950">
						{group.code.startsWith("policy_context_unsupported_")
							? "Fastt debe definir las condiciones comerciales aplicables a estas ofertas."
							: group.message}
					</p>
					<Badge variant={group.owner === "fastt" ? "warning" : "neutral"}>
						{group.owner === "fastt"
							? "Fastt"
							: group.owner === "provider"
								? "Tu negocio"
								: "Por comprobar"}
					</Badge>
				</div>
				{group.causes.length > 1 && (
					<p class="text-sm text-slate-600">
						Aspectos por revisar:{" "}
						{group.causes
							.map((cause) =>
								cause.code.endsWith("_holder")
									? "titular"
									: cause.code.endsWith("_product")
										? "actividad"
										: cause.code.endsWith("_tax")
											? "fiscalidad"
											: cause.code.endsWith("_payout")
												? "liquidación"
												: cause.message
							)
							.join(" · ")}
					</p>
				)}
				<details class="text-sm text-slate-600">
					<summary class="cursor-pointer font-medium">
						{group.offerings.length}{" "}
						{group.offerings.length === 1 ? "oferta afectada" : "ofertas afectadas"}
					</summary>
					<ul class="mt-2 space-y-1">
						{group.offerings.map((offering) => (
							<li>{offering.name}</li>
						))}
					</ul>
				</details>
				{group.action && (
					<Button href={group.action.href} variant="secondary">
						{group.action.label}
					</Button>
				)}
			</Card>
		))
	}
	<Card class="space-y-4">
		<h2 class="text-lg font-semibold text-slate-950">Modalidad y requisitos por oferta</h2>
		{
			model.offerings.length ? (
				<ul data-commercial-contract-offerings class="divide-y divide-slate-200">
					{model.offerings.map((offering) => (
						<li
							class="py-4 first:pt-0 last:pb-0"
							data-commercial-contract-offering={offering.productId}
						>
							<div class="flex flex-wrap justify-between gap-2">
								<div>
									<p class="font-semibold text-slate-950">{offering.name}</p>
									<p class="mt-1 text-sm text-slate-600">
										{offering.verticalLabel}
										{offering.country ? ` · ${offering.country}` : ""}
									</p>
								</div>
								<Badge
									variant={
										offering.status === "requirements_satisfied"
											? "success"
											: offering.status === "in_review"
												? "warning"
												: "neutral"
									}
								>
									{offering.statusLabel}
								</Badge>
							</div>
							<p class="mt-2 text-sm text-slate-600">{offering.collectionModelLabel}</p>
							{offering.status === "requirements_satisfied" && (
								<p class="mt-1 text-sm text-slate-600">{offering.detail}</p>
							)}
							{offering.platformCollectionAvailable && (
								<p class="mt-2 text-sm text-emerald-800">
									Cobro mediante Fastt disponible para esta oferta.
								</p>
							)}
							{offering.platformPayoutAvailable && (
								<p class="mt-2 text-sm text-emerald-800">
									Liquidación mediante Fastt disponible para esta oferta.
								</p>
							)}
						</li>
					))}
				</ul>
			) : (
				<p class="text-sm text-slate-600">
					No hay ofertas en este contexto. Sus condiciones aparecerán aquí cuando las crees.
				</p>
			)
		}
	</Card>
</div>
