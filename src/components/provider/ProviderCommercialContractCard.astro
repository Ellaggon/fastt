---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import type { ProviderContractSurface } from "@/lib/commercial-policy/provider-contract-surface"

type Props = { model: ProviderContractSurface; compact?: boolean }
const { model, compact = false } = Astro.props as Props

function badgeVariant(status: string) {
	if (status === "approved") return "success" as const
	if (status === "in_review") return "warning" as const
	return "neutral" as const
}
---

<Card class="space-y-5" data-commercial-contract-status>
	<div class="flex flex-wrap items-start justify-between gap-3">
		<div>
			<p class="text-xs font-semibold tracking-[0.14em] text-slate-500 uppercase">
				Contrato comercial
			</p>
			<h2 class="mt-2 text-xl font-semibold text-slate-950">Cobros y liquidaciones</h2>
			<p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
				La declaración del proveedor y la aprobación contractual son controles distintos.
			</p>
		</div>
		<Badge variant={badgeVariant(model.holderStatus)}>
			{
				model.holderStatus === "missing"
					? "Identidad pendiente"
					: model.holderStatus === "in_review"
						? "En revisión"
						: "Declarado"
			}
		</Badge>
	</div>

	<Card variant="soft">
		<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Modelo declarado</p>
		<p class="mt-1 font-semibold text-slate-950">{model.holderModelLabel}</p>
		<p class="mt-1 text-sm leading-6 text-slate-600">{model.holderDetail}</p>
	</Card>

	{
		model.offerings.length ? (
			<div class="space-y-3" data-commercial-contract-offerings>
				{model.offerings.map((offering) => (
					<Card variant="plain" class="!p-4" data-commercial-contract-offering={offering.productId}>
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<p class="font-semibold text-slate-950">{offering.name}</p>
								<p class="mt-1 text-sm text-slate-600">
									{offering.verticalLabel}
									{offering.country ? ` · ${offering.country}` : ""}
								</p>
							</div>
							<Badge variant={badgeVariant(offering.status)}>{offering.statusLabel}</Badge>
						</div>
						<p class="mt-3 text-sm leading-6 text-slate-600">{offering.detail}</p>
						{offering.platformCollectionAvailable ? (
							<p class="mt-3 rounded-lg bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-900">
								Cobro mediante Fastt disponible para esta actividad y país.
							</p>
						) : null}
					</Card>
				))}
			</div>
		) : (
			<Card
				variant="soft"
				class="border border-dashed border-slate-300 text-sm leading-6 text-slate-600"
			>
				Cuando agregues una oferta con país principal, mostraremos aquí su estado contractual.
			</Card>
		)
	}

	{
		!compact ? (
			<div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-4">
				<p class="text-sm text-slate-600">
					Fastt no procesa cobros ni liquidaciones mientras no exista infraestructura aprobada.
				</p>
				<Button href={model.verificationHref} variant="secondary">
					Verificación de pagos
				</Button>
			</div>
		) : null
	}
</Card>
