---
import { copyVerificationNavigationQuery } from "@/lib/verification/navigation"
import Card from "@/components/ui/Card.astro"
import Button from "@/components/ui/Button.astro"
import type { VerificationScreen } from "@/lib/verification/screen-sections"
import type { VerificationPlaybookTab } from "@/lib/verification/navigation"

type Props = {
	screen: VerificationScreen
	line?: "lodging" | "tour" | null
	tourArea?: "activity" | "safety" | null
	experienceId?: string | null
	safetyState?: VerificationPlaybookTab["uiState"]
	operationComplete?: boolean
	missingOperationFields?: string[]
	evaluationPending?: boolean
}

const {
	screen,
	line = null,
	tourArea = null,
	experienceId = null,
	safetyState = "not_evaluable",
	operationComplete = true,
	missingOperationFields = [],
	evaluationPending = false,
} = Astro.props as Props
const lineSections = screen.sections.filter(
	(section) =>
		section.id !== "shared" &&
		(!line || section.id === line) &&
		(section.items.length > 0 ||
			(section.id === "tour" && (tourArea === "safety" || evaluationPending)))
)
const completeOperationUrl = new URL("/provider/settings/verification", Astro.url)
copyVerificationNavigationQuery(completeOperationUrl, Astro.url)
completeOperationUrl.searchParams.set("line", "tour")
completeOperationUrl.searchParams.set("tab", "activity")
completeOperationUrl.searchParams.set("tourTab", "activity")
if (experienceId) completeOperationUrl.searchParams.set("experience", experienceId)
completeOperationUrl.hash = "tour-operating-context"
const safetyPending = tourArea === "safety" && operationComplete && safetyState === "not_evaluable"
function contextualHref(href: string, area: "activity" | "safety" | null | undefined): string {
	if (
		line === "tour" &&
		area &&
		new URL(href, Astro.url).pathname === "/provider/settings/verification/documents"
	)
		return `#tour-evidence-tour-${area}`
	const url = new URL(href, Astro.url)
	if (url.pathname === "/provider/settings/verification") {
		const destinationTab = url.searchParams.get("tab")
		copyVerificationNavigationQuery(url, Astro.url)
		if (destinationTab) url.searchParams.set("tab", destinationTab)
	}
	if (url.pathname === "/provider/settings/verification/documents" && line) {
		url.searchParams.set("line", line)
		url.searchParams.set("tab", line === "tour" ? (tourArea ?? "activity") : "business")
		if (experienceId) {
			url.searchParams.set("experience", experienceId)
			url.searchParams.set("scopeProductId", experienceId)
		}
	}
	return `${url.pathname}${url.search}${url.hash}`
}
---

{
	lineSections.length ? (
		<section class="space-y-4" aria-label="Requisitos de la línea" data-verification-line-sections>
			{lineSections.map((section) => {
				const listed = section.items.filter(
					(entry) =>
						entry.id !== "tour.operating_role_missing" &&
						entry.id !== "tour.context_missing" &&
						(section.id !== "tour" || !tourArea || entry.presentationArea === tourArea)
				)
				if (!listed.length && section.id !== "tour") return null
				return (
					<Card class="space-y-4" data-verification-line-section={section.id}>
						<div class="max-w-3xl">
							<p class="text-sm font-semibold text-slate-950">
								{section.id === "tour"
									? tourArea === "safety"
										? !operationComplete
											? "Completa la operación de la experiencia"
											: safetyPending
												? "Evaluación pendiente de Fastt"
												: safetyState === "not_applicable"
													? "Sin respaldos adicionales requeridos"
													: "Respaldos de seguridad"
										: operationComplete
											? evaluationPending
												? "Evaluación pendiente de Fastt"
												: "Licencias aplicables"
											: "Licencias por determinar"
									: section.title}
							</p>
							<p class="mt-1 text-sm leading-6 text-slate-600">
								{section.id === "tour"
									? tourArea === "safety"
										? "Según la operación declarada para esta experiencia."
										: operationComplete
											? "Respaldos según la operación declarada para esta experiencia."
											: "Completa y guarda el formulario anterior para conocer los respaldos que corresponden."
									: section.description}
							</p>
						</div>
						{tourArea === "activity" && operationComplete && evaluationPending ? (
							<p class="text-sm leading-6 text-slate-600">
								Tu operación está guardada. Fastt está determinando las licencias aplicables a esta
								experiencia. No necesitas volver a completar estos datos ni enviar documentos
								adicionales.
							</p>
						) : safetyPending ? (
							<div class="space-y-3">
								<p class="text-sm leading-6 text-slate-600">
									Tu operación está guardada. Te indicaremos aquí los respaldos de seguridad que
									correspondan cuando Fastt complete la evaluación.
								</p>
								<p class="text-sm leading-6 text-slate-600">
									No necesitas volver a completar la operación. No envíes respaldos adicionales
									hasta que se indiquen.
								</p>
							</div>
						) : operationComplete && listed.length ? (
							<ul class="grid gap-2 sm:grid-cols-2">
								{listed.map((entry) => (
									<li
										data-verification-line-item={entry.id}
										data-counts={entry.countsTowardProgress ? "true" : "false"}
									>
										{entry.href ? (
											<a
												href={contextualHref(entry.href, entry.presentationArea)}
												class="flex items-center justify-between gap-3 text-sm text-slate-800 underline-offset-2 hover:underline"
											>
												<span>
													<span>{entry.label}</span>
													{entry.stateDetail ? (
														<span class="mt-1 block text-xs leading-5 text-slate-500">
															{entry.stateDetail}
														</span>
													) : null}
												</span>
												<span class="shrink-0 font-medium text-slate-500">{entry.stateLabel}</span>
											</a>
										) : (
											<span class="flex items-center justify-between gap-3 text-sm text-slate-800">
												<span>
													<span>{entry.label}</span>
													{entry.stateDetail ? (
														<span class="mt-1 block text-xs leading-5 text-slate-500">
															{entry.stateDetail}
														</span>
													) : null}
												</span>
												<span class="shrink-0 font-medium text-slate-500">{entry.stateLabel}</span>
											</span>
										)}
									</li>
								))}
							</ul>
						) : tourArea === "safety" ? (
							<p class="text-sm leading-6 text-slate-600">
								{safetyState === "not_applicable"
									? "No aplica un documento de seguridad adicional a la actividad y el territorio declarados. Si cambian, volveremos a evaluarlo."
									: missingOperationFields.length
										? `Falta completar: ${missingOperationFields.join(", ")}. Guarda la operación para determinar los respaldos correspondientes.`
										: "Completa y guarda el papel operativo, las actividades y el territorio para determinar los respaldos correspondientes."}
							</p>
						) : operationComplete ? (
							<p class="text-sm leading-6 text-slate-600">
								No hay licencias adicionales identificadas para la operación declarada.
							</p>
						) : null}
						{tourArea === "safety" && !operationComplete && (
							<Button
								href={`${completeOperationUrl.pathname}${completeOperationUrl.search}${completeOperationUrl.hash}`}
								variant="selection"
							>
								Completar operación
							</Button>
						)}
					</Card>
				)
			})}
		</section>
	) : null
}
