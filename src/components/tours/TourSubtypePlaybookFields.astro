---
import Card from "@/components/ui/Card.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import Textarea from "@/components/ui/Textarea.astro"
import { experienceJourneyPresentation } from "@/lib/tours/experienceFormatPresentation"
import { TOUR_DIFFICULTY_OPTIONS, normalizeTourDifficulty } from "@/lib/tours/tourDifficulty"
import { experienceDurationLabel } from "@/shared/domain/experience-duration"
import { experienceProgramMinimum } from "@/shared/domain/experience-format"
import { experienceProgramMoments } from "@/shared/domain/experience-program"

interface TourSubtypeRow {
	experienceFormat?: string | null
	duration: string | null
	durationMinutes: number | null
	difficultyLevel: string | null
	meetingPointJson: unknown
	itineraryJson: unknown
	safetyJson: unknown
	guideJson: unknown
	includesJson: unknown
	excludesJson: unknown
	pickupJson: unknown
}

interface Props {
	activityName?: string | null
	productId: string
	tourSubtype: TourSubtypeRow | null | undefined
}

const { productId, tourSubtype, activityName } = Astro.props
const journey = experienceJourneyPresentation(tourSubtype?.experienceFormat)
const programMinimum = experienceProgramMinimum(tourSubtype?.experienceFormat)
const showTourFields =
	tourSubtype?.experienceFormat == null || tourSubtype.experienceFormat === "guided_tour"
const panelClass = "space-y-5 bg-white"

function listToText(value: unknown, key = "description") {
	if (!Array.isArray(value)) return ""
	return value
		.map((item) => {
			if (typeof item === "string") return item
			if (item && typeof item === "object")
				return String((item as Record<string, unknown>)[key] ?? "").trim()
			return ""
		})
		.filter(Boolean)
		.join("\n")
}

function fieldFromObject(value: unknown, key: string) {
	if (!value || typeof value !== "object") return ""
	return String((value as Record<string, unknown>)[key] ?? "")
}

const totalMinutes = tourSubtype?.durationMinutes ?? 0
const customDuration = Boolean(
	tourSubtype?.duration && tourSubtype.duration !== experienceDurationLabel(totalMinutes)
)
const selectedDifficulty = normalizeTourDifficulty(tourSubtype?.difficultyLevel) ?? ""
---

<div class="space-y-5">
	<input
		type="hidden"
		name="expectedExperienceFormat"
		value={tourSubtype?.experienceFormat ?? "historical"}
	/>
	<Card class={panelClass}>
		<fieldset class="space-y-4 border-0 p-0" data-experience-duration>
			<legend class="text-sm font-semibold text-slate-950">Duración de la experiencia</legend>
			<div class="grid gap-4 sm:grid-cols-2">
				<FormField label="Horas" htmlFor="durationHours">
					<Input
						id="durationHours"
						name="durationHours"
						type="number"
						min="0"
						step="1"
						value={String(Math.floor(totalMinutes / 60))}
						inputmode="numeric"
						aria-describedby="durationMinutesError"
					/>
				</FormField>
				<FormField label="Minutos" htmlFor="durationPartMinutes">
					<Input
						id="durationPartMinutes"
						name="durationPartMinutes"
						type="number"
						min="0"
						max="59"
						step="1"
						value={String(totalMinutes % 60)}
						inputmode="numeric"
						aria-describedby="durationMinutesError"
					/>
				</FormField>
			</div>
			<Input
				id="durationMinutes"
				name="durationMinutes"
				type="hidden"
				value={String(totalMinutes)}
			/>
			<p id="durationMinutesError" class="hidden text-sm text-red-600"></p>
			<details open={customDuration}>
				<summary class="cursor-pointer text-sm font-medium text-slate-600"
					>Personalizar el texto de duración</summary
				>
				<label class="mt-3 flex items-center gap-2 text-sm text-slate-600"
					><input type="checkbox" name="durationCustomEnabled" checked={customDuration} /> Usar un texto
					personalizado</label
				>
				<FormField label="Duración visible" htmlFor="duration">
					<Input
						id="duration"
						name="duration"
						value={tourSubtype?.duration ?? experienceDurationLabel(totalMinutes)}
						placeholder="Ej: aproximadamente 2 horas"
						aria-describedby="durationError"
					/>
					<p id="durationError" class="hidden text-sm text-red-600"></p>
				</FormField>
			</details>
		</fieldset>
	</Card>

	<Card class={panelClass}>
		<fieldset class="space-y-4 border-0 p-0">
			<legend class="sr-only">Programa e inclusiones</legend>
			<p class="text-sm font-semibold text-slate-950">{journey.programQuestion}</p>
			{
				activityName && (
					<p class="text-sm text-slate-500">
						Describe el desarrollo de {activityName.toLocaleLowerCase("es")} y lo que recibirán los
						participantes.
					</p>
				)
			}
			<FormField
				label={`${journey.programLabel} (mínimo ${programMinimum} ${programMinimum === 1 ? "momento" : "momentos"})`}
				htmlFor="tourItinerary"
				required
			>
				<Textarea
					id="tourItinerary"
					name="tourItinerary"
					value={experienceProgramMoments(tourSubtype?.itineraryJson).join("\n")}
					rows="6"
					placeholder={journey.programPlaceholder}
					required
					aria-describedby="tourItineraryHelp tourItineraryError"
				/>
				<p id="tourItineraryHelp" class="mt-2 text-sm leading-6 text-slate-500">
					Escribe un momento de la actividad por línea.
				</p>
				<p id="tourItineraryError" class="hidden text-sm text-red-600"></p>
			</FormField>
			<FormField label="Qué incluye" htmlFor="tourIncludes" required>
				<Textarea
					id="tourIncludes"
					name="tourIncludes"
					value={listToText(tourSubtype?.includesJson)}
					rows="4"
					placeholder={journey.includesPlaceholder}
					required
					aria-describedby="tourIncludesError"
				/>
				<p id="tourIncludesError" class="hidden text-sm text-red-600"></p>
			</FormField>
		</fieldset>
	</Card>

	{
		showTourFields && (
			<Card class="overflow-hidden bg-white p-0">
				<details class="group">
					<summary class="cursor-pointer list-none px-5 py-4 text-sm font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
						Presentación y guía (opcional)
					</summary>
					<div class="space-y-4 border-t border-slate-200 px-5 pt-4 pb-5">
						<FormField label="Idiomas del guía" htmlFor="guideLanguages">
							<Input
								id="guideLanguages"
								name="guideLanguages"
								value={fieldFromObject(tourSubtype?.guideJson, "languages")}
								placeholder="Español, inglés"
							/>
						</FormField>
						<FormField label="Tipo de guía" htmlFor="guideType">
							<Input
								id="guideType"
								name="guideType"
								value={fieldFromObject(tourSubtype?.guideJson, "guideType")}
								placeholder="Guía local, conductor guía, anfitrión..."
							/>
						</FormField>
					</div>
				</details>
			</Card>
		)
	}
	<Card class="overflow-hidden bg-white p-0">
		<details
			class="group"
			open={Boolean(selectedDifficulty || tourSubtype?.pickupJson || tourSubtype?.safetyJson)}
		>
			<summary
				class="cursor-pointer list-none px-5 py-4 text-sm font-semibold text-slate-900 [&::-webkit-details-marker]:hidden"
			>
				Indicaciones, exclusiones y características (opcional)
			</summary>
			<div class="space-y-4 border-t border-slate-200 px-5 pt-4 pb-5">
				{
					(
						<div class="space-y-4">
							<FormField label="Área de recogida" htmlFor="pickupDefaultArea">
								<Input
									id="pickupDefaultArea"
									name="pickupDefaultArea"
									value={fieldFromObject(tourSubtype?.pickupJson, "defaultArea")}
									placeholder="Hoteles de la zona centro, aeropuerto..."
								/>
							</FormField>
							<FormField label="Instrucciones de recogida" htmlFor="pickupInstructions">
								<Textarea
									id="pickupInstructions"
									name="pickupInstructions"
									value={fieldFromObject(tourSubtype?.pickupJson, "instructions")}
									rows="2"
								/>
							</FormField>
						</div>
					)
				}
				<FormField label="Esfuerzo físico (si corresponde)" htmlFor="difficultyLevel">
					<Select id="difficultyLevel" name="difficultyLevel">
						<option value="" selected={selectedDifficulty === ""}>
							{" "}
							Sin definir{" "}
						</option>
						{
							TOUR_DIFFICULTY_OPTIONS.map((level) => (
								<option value={level.value} selected={selectedDifficulty === level.value}>
									{level.label}
								</option>
							))
						}
					</Select>
				</FormField>
				<FormField label="No incluye" htmlFor="tourExcludes">
					<Textarea
						id="tourExcludes"
						name="tourExcludes"
						value={listToText(tourSubtype?.excludesJson)}
						rows="3"
						placeholder="Propinas, almuerzo..."
					/>
				</FormField>
				<FormField label="Requisitos de seguridad" htmlFor="safetyRequirements">
					<Textarea
						id="safetyRequirements"
						name="safetyRequirements"
						value={fieldFromObject(tourSubtype?.safetyJson, "requirements")}
						rows="3"
					/>
				</FormField>
				<FormField label="Advertencias o condiciones físicas" htmlFor="safetyWarnings">
					<Textarea
						id="safetyWarnings"
						name="safetyWarnings"
						value={fieldFromObject(tourSubtype?.safetyJson, "warnings")}
						rows="3"
					/>
				</FormField>
			</div>
		</details>
	</Card>

	<p class="text-sm leading-6 text-slate-400">
		El papel operativo, el territorio y las actividades se editan en
		<a
			class="font-medium text-slate-300 underline underline-offset-2"
			href={`/product/${encodeURIComponent(productId)}#experience-requirements`}
			target="_blank"
			rel="noopener noreferrer"
		>
			Verificación de experiencias
		</a>
		. Puedes continuar esta guía y completarlos después.
	</p>
</div>
