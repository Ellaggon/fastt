---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"

interface Props {
	title: string
	lead: string
	actionLabel?: string
	href?: string
	class?: string
}

const { title, lead, actionLabel, href, class: className = "" } = Astro.props
---

<Card class:list={["space-y-4 bg-white text-slate-900", className]}>
	<div class="space-y-1.5">
		<h2 class="text-lg font-semibold text-slate-950">{title}</h2>
		<p class="text-sm leading-6 text-slate-600">{lead}</p>
	</div>
	<slot>
		{href && actionLabel ? <Button href={href}>{actionLabel}</Button> : null}
	</slot>
</Card>
