---
import {
	ArrowRight,
	BadgeCheck,
	Binoculars,
	CalendarCheck2,
	Compass,
	MapPin,
	SlidersHorizontal,
} from "@lucide/astro"

import PublicListingImage from "@/components/marketplace/PublicListingImage.astro"
import TourDiscoveryCard from "@/components/tours/TourDiscoveryCard.astro"
import TourDiscoverySearch from "@/components/tours/TourDiscoverySearch.astro"
import Card from "@/components/ui/Card.astro"
import Notice from "@/components/ui/Notice.astro"
import UILayout from "@/layouts/UILayout.astro"
import type { PublicTourCatalogResult } from "@/lib/tours/publicTourCatalog"

interface DestinationCard {
	name: string
	description: string
	href: string
	imageUrl: string
}

interface Props {
	catalog: PublicTourCatalogResult
	destinations: DestinationCard[]
}

const { catalog, destinations } = Astro.props as Props
const title = "Tours y experiencias en Bolivia"
const description =
	"Encuentra qué hacer en Bolivia, explora experiencias y consulta disponibilidad cuando tengas una fecha."
const interestIcons = [Compass, Binoculars, MapPin, CalendarCheck2, SlidersHorizontal, BadgeCheck]
const interests = catalog.categories.slice(0, 6)
const structuredData = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": title,
	description,
	"url": new URL("/tours", Astro.url.origin).href,
	"inLanguage": "es-BO",
	...(catalog.cards.length
		? {
				mainEntity: {
					"@type": "ItemList",
					"itemListElement": catalog.cards.slice(0, 8).map((tour, index) => ({
						"@type": "ListItem",
						"position": index + 1,
						"name": tour.name,
						"url": new URL(`/tours/${tour.productId}`, Astro.url.origin).href,
					})),
				},
			}
		: {}),
}
---

<UILayout
	title={title}
	description={description}
	canonicalPath="/tours"
	structuredData={structuredData}
>
	<div class="min-h-screen bg-white text-slate-950">
		<header class="relative isolate overflow-hidden bg-[#eef2ed]">
			<div
				class="pointer-events-none absolute inset-0 lg:inset-y-0 lg:left-auto lg:right-0 lg:w-[43%]"
				aria-hidden="true"
			>
				<PublicListingImage
					src="https://pub-de0b5a27b1424d99afa6c7b2fe2f02dc.r2.dev/la-paz.webp"
					alt=""
					fill
					priority
					class="[&_img]:object-cover [&_img]:object-[68%_42%] md:[&_img]:object-[74%_38%] lg:[&_img]:object-center"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-b from-[#eef2ed] from-[36%] via-[#eef2ed]/92 via-[54%] to-[#eef2ed]/15 md:from-[40%] md:via-[#eef2ed]/88 md:via-[58%] md:to-[#eef2ed]/10 lg:hidden"
				>
				</div>
				<div
					class="absolute inset-0 bg-gradient-to-r from-[#eef2ed] from-[34%] via-[#eef2ed]/58 via-[48%] to-transparent md:from-[40%] md:via-[#eef2ed]/32 md:via-[52%] lg:hidden"
				>
				</div>
				<div
					class="absolute inset-0 hidden bg-gradient-to-r from-[#eef2ed] via-[#eef2ed]/25 to-transparent lg:block"
				>
				</div>
			</div>
			<div
				class="relative mx-auto grid w-full max-w-[120rem] lg:grid-cols-[minmax(0,56rem)_minmax(0,1fr)]"
			>
				<div class="px-4 pb-14 pt-14 sm:px-6 sm:pb-16 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-24 xl:px-10">
					<p class="flex items-center gap-2 text-sm font-semibold text-slate-950/85">
						<Compass class="h-4 w-4" aria-hidden="true" />
						Experiencias por toda Bolivia
					</p>
					<h1
						class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.08] tracking-[-0.035em] text-slate-950 sm:text-5xl lg:text-6xl"
					>
						Descubre Bolivia, experiencia a experiencia
					</h1>
					<p class="mt-5 max-w-xl text-lg leading-8 text-slate-700">
						Encuentra qué hacer y elige cuándo ir. Puedes explorar ahora y consultar cupos cuando
						tengas una fecha.
					</p>
					<div class="mt-8 max-w-4xl">
						<TourDiscoverySearch />
					</div>
				</div>
			</div>
		</header>

		<main id="content">
			<section
				class="mx-auto w-full max-w-[120rem] px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20 xl:px-10"
				aria-labelledby="destinations-title"
			>
				<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-sm font-semibold text-slate-950">Encuentra tu próximo lugar</p>
						<h2
							id="destinations-title"
							class="mt-2 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"
						>
							Explora por destino
						</h2>
					</div>
					<p class="max-w-md text-sm leading-6 text-slate-600">
						Ciudades y regiones que puedes explorar ahora, incluso si todavía no elegiste fecha.
					</p>
				</div>
				<div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
					{
						destinations.map((destination, index) => (
							<a
								href={destination.href}
								class="group relative min-h-80 overflow-hidden rounded-2xl bg-slate-900 focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-4 focus-visible:outline-none"
							>
								<PublicListingImage
									src={destination.imageUrl}
									alt={destination.name}
									class="transition duration-500 group-hover:scale-[1.03]"
									priority={index < 2}
									fill
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/15 to-transparent" />
								<div class="absolute inset-x-0 bottom-0 p-5 text-white">
									<h3 class="text-2xl font-semibold">{destination.name}</h3>
									<p class="mt-1 text-sm leading-6 text-white/85">{destination.description}</p>
									<span class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold">
										Explorar{" "}
										<ArrowRight
											class="h-4 w-4 transition-transform group-hover:translate-x-1"
											aria-hidden="true"
										/>
									</span>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<section class="border-y border-slate-200 bg-slate-50" aria-labelledby="experiences-title">
				<div
					class="mx-auto w-full max-w-[120rem] px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20 xl:px-10"
				>
					<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
						<div>
							<p class="text-sm font-semibold text-slate-900">Experiencias publicadas</p>
							<h2
								id="experiences-title"
								class="mt-2 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"
							>
								Ideas para empezar
							</h2>
							<p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
								Conoce la experiencia primero. Las fechas, los cupos y el precio se confirman al
								elegir cuándo viajar.
							</p>
						</div>
						<a
							href="/buscar/tours"
							class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-slate-950 hover:underline hover:underline-offset-4"
							>Ver todas las experiencias <ArrowRight class="h-4 w-4" aria-hidden="true" /></a
						>
					</div>
					{
						catalog.status === "error" ? (
							<div class="mt-8">
								<Notice variant="error" title="No pudimos cargar las experiencias">
									Los destinos siguen disponibles. Intenta cargar las experiencias nuevamente en
									unos minutos.
								</Notice>
							</div>
						) : catalog.cards.length ? (
							<div class="mt-9 grid grid-cols-1 gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
								{catalog.cards.slice(0, 8).map((tour, index) => (
									<TourDiscoveryCard tour={tour} priority={index < 2} />
								))}
							</div>
						) : (
							<Card variant="plain" class="mt-8 p-6">
								<h3 class="font-semibold text-slate-950">Estamos preparando nuevas experiencias</h3>
								<p class="mt-2 text-sm leading-6 text-slate-600">
									Mientras tanto, explora un destino para conocer la oferta publicada en cada
									región.
								</p>
							</Card>
						)
					}
				</div>
			</section>

			{
				interests.length ? (
					<section
						class="mx-auto w-full max-w-[120rem] px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20 xl:px-10"
						aria-labelledby="interests-title"
					>
						<p class="text-sm font-semibold text-slate-950">Elige según tus intereses</p>
						<h2
							id="interests-title"
							class="mt-2 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"
						>
							¿Qué te gustaría hacer?
						</h2>
						<div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
							{interests.map((interest, index) => {
								const Icon = interestIcons[index % interestIcons.length]
								return (
									<Card
										variant="row"
										class="group min-h-24 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
									>
										<a
											href={`/buscar/tours?category=${encodeURIComponent(interest.slug)}`}
											class="flex min-h-24 items-center gap-4 focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 focus-visible:outline-none"
										>
											<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-900 ring-1 ring-slate-200/90 ring-inset">
												<Icon class="h-5 w-5" aria-hidden="true" />
											</span>
											<span class="min-w-0">
												<span class="block font-semibold text-slate-950">{interest.name}</span>
												<span class="mt-1 block text-sm text-slate-600">
													{interest.productCount}{" "}
													{interest.productCount === 1 ? "experiencia" : "experiencias"}
												</span>
											</span>
											<ArrowRight
												class="ml-auto h-4 w-4 shrink-0 text-slate-400 transition-transform group-hover:translate-x-1"
												aria-hidden="true"
											/>
										</a>
									</Card>
								)
							})}
						</div>
					</section>
				) : null
			}

			<section class="bg-slate-950 text-white" aria-labelledby="process-title">
				<div
					class="mx-auto w-full max-w-[120rem] px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20 xl:px-10"
				>
					<div class="max-w-2xl">
						<p class="text-sm font-semibold text-slate-400">Reserva con claridad</p>
						<h2 id="process-title" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
							De la inspiración a una salida concreta
						</h2>
					</div>
					<ol class="mt-10 grid max-w-5xl gap-8 md:grid-cols-3">
						<li>
							<span class="text-sm font-semibold text-slate-400">01</span><h3
								class="mt-3 text-xl font-semibold"
							>
								Explora
							</h3><p class="mt-2 text-sm leading-6 text-slate-300">
								Descubre destinos y actividades sin comprometerte con una fecha.
							</p>
						</li>
						<li>
							<span class="text-sm font-semibold text-slate-400">02</span><h3
								class="mt-3 text-xl font-semibold"
							>
								Comprueba
							</h3><p class="mt-2 text-sm leading-6 text-slate-300">
								Elige cuándo ir para consultar salida, cupos y precio aplicable.
							</p>
						</li>
						<li>
							<span class="text-sm font-semibold text-slate-400">03</span><h3
								class="mt-3 text-xl font-semibold"
							>
								Revisa y reserva
							</h3><p class="mt-2 text-sm leading-6 text-slate-300">
								Confirma participantes, condiciones y total antes de continuar.
							</p>
						</li>
					</ol>
				</div>
			</section>
		</main>
	</div>
</UILayout>
