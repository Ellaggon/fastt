---
import Button from "@/components/ui/Button.astro"
import Checkbox from "@/components/ui/Checkbox.astro"
import FieldHelp from "@/components/ui/FieldHelp.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import Textarea from "@/components/ui/Textarea.astro"
import { Clock, Languages, Users } from "@lucide/astro"
import { getPolicyPresetLabel } from "@/data/policy/policy-presets"
import { getPolicyCategoryLabel } from "@/data/policy/policy-categories"
import { TOUR_SLOT_LANGUAGE_OPTIONS } from "@/lib/tours/tourSlotLanguageOptions"

type ScheduleSource = Awaited<
	ReturnType<typeof import("@/lib/onboarding/tourScheduleCreation").loadScheduleSource>
>
interface Props {
	scheduleSource?: ScheduleSource | null
	scheduleSessionId?: string
	productId: string
	variantId?: string | null
	mode: "create" | "edit"
	name?: string | null
	description?: string | null
	departureTime?: string | null
	durationMinutes?: number | null
	maxPax?: number | null
	languageCode?: string | null
	bookingMode?: "shared" | "private" | null
	meetingPointOverride?: string | null
	isActive?: boolean | null
	redirectOnSuccess?: string | null
	playbookFooterControls?: boolean
	submitLabel?: string | null
	cancelHref?: string | null
}

const {
	scheduleSource = null,
	scheduleSessionId,
	productId,
	variantId = null,
	mode,
	name = "",
	description = "",
	departureTime = "09:00",
	durationMinutes = null,
	maxPax = 12,
	languageCode = "es",
	bookingMode = "shared",
	meetingPointOverride = "",
	isActive = true,
	redirectOnSuccess = null,
	playbookFooterControls = false,
	submitLabel = null,
	cancelHref = null,
} = Astro.props

function reusedConditionLabel(
	entry: NonNullable<ScheduleSource["conditions"]>["policies"][number]
) {
	const category = getPolicyCategoryLabel(entry.category)
	const label =
		entry.category === "Payment"
			? "Pago directo al proveedor"
			: getPolicyPresetLabel(
					entry.policy.policyPresetKey || "",
					entry.category as import("@/modules/policies/public").PolicyCategory,
					entry.policy.description.replace(/huésped/gi, "viajero")
				)
	return label.toLowerCase().startsWith(category.toLowerCase()) ? label : `${category}: ${label}`
}
const isEditMode = mode === "edit"
const resolvedLanguageCode = String(languageCode ?? (isEditMode ? "" : "es"))
const selectionCheckboxClass =
	"tour-slot-selection-checkbox cursor-pointer rounded-[var(--fastt-radius-card)] border border-sky-100 bg-sky-50/80 p-3 transition hover:border-sky-200 has-[:checked]:border-[var(--fastt-color-selection)] has-[:checked]:bg-[var(--fastt-color-selection-soft)]"
		.trim()
		.toLowerCase()
const languageOptions =
	!resolvedLanguageCode ||
	TOUR_SLOT_LANGUAGE_OPTIONS.some((entry) => entry.code === resolvedLanguageCode)
		? TOUR_SLOT_LANGUAGE_OPTIONS
		: [
				{ code: resolvedLanguageCode, label: resolvedLanguageCode.toUpperCase() },
				...TOUR_SLOT_LANGUAGE_OPTIONS,
			]
---

<form
	id="tour-slot-profile-form"
	class="space-y-6"
	data-product-id={productId}
	data-schedule={scheduleSource ? "true" : undefined}
	data-variant-id={variantId ?? ""}
	data-redirect={redirectOnSuccess ?? ""}
>
	{isEditMode ? <input type="hidden" name="variantId" value={variantId ?? ""} /> : null}
	<input type="hidden" name="productId" value={productId} />

	{
		scheduleSource && (
			<>
				<input type="hidden" name="sessionId" value={scheduleSessionId} />
				<input type="hidden" name="sourceFingerprint" value={scheduleSource.fingerprint} />
				<input type="hidden" name="sourceRatePlanId" value={scheduleSource.rate?.id || ""} />
				<section class="fastt-card space-y-3 border border-slate-200 bg-white p-5 text-slate-950">
					<p class="text-sm">
						{languageOptions.find((lang) => lang.code === resolvedLanguageCode)?.label} ·{" "}
						{bookingMode === "private" ? "Privada" : "Compartida"} · Hasta {maxPax} participantes
						{durationMinutes ? ` · ${durationMinutes} min` : ""}
					</p>
					<p class="text-sm text-slate-600">
						Se conserva la configuración del perfil y su punto de encuentro. Las nuevas fechas se
						programan después.
					</p>
					<Button
						type="button"
						variant="ghost"
						data-modify-schedule
						aria-expanded="false"
						className="min-h-11 px-0 text-sm font-semibold underline"
					>
						Modificar configuración
					</Button>
				</section>
			</>
		)
	}

	<section
		class="fastt-card space-y-4 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5 text-slate-950"
	>
		<header class="flex items-center gap-2">
			<Clock class="h-4 w-4 text-slate-500" />
			<h2 class="text-sm font-semibold text-slate-950">Configuración de la opción</h2>
		</header>
		<div class="grid gap-4 md:grid-cols-2">
			<FormField label="Nombre que verán los viajeros" htmlFor="name" required>
				<Input
					id="name"
					name="name"
					required
					value={name ?? ""}
					placeholder="Ej.: Visita privada con transporte"
					aria-describedby="optionNameHelp"
				/>
				<p id="optionNameHelp" class="text-xs leading-5 text-slate-500">
					Describe qué distingue esta alternativa del tour.
				</p>
			</FormField>
			<FormField
				label="Horario habitual"
				htmlFor="departureTime"
				required
				description="Las fechas disponibles se configuran en el calendario."
			>
				<Input
					id="departureTime"
					name="departureTime"
					type="time"
					required
					value={departureTime ?? (isEditMode ? "" : "09:00")}
				/>
			</FormField>
			<div data-schedule-common hidden={Boolean(scheduleSource)}>
				<FormField
					label="Duración de esta opción (minutos, opcional)"
					htmlFor="durationMinutes"
					description="Si la dejas vacía, usamos la duración configurada en los detalles del tour."
				>
					<Input
						id="durationMinutes"
						name="durationMinutes"
						type="number"
						min="1"
						value={durationMinutes != null ? String(durationMinutes) : ""}
						placeholder="Ej: 180"
					/>
				</FormField>
			</div>
		</div>
		<div data-schedule-common hidden={Boolean(scheduleSource)}>
			<FormField label="Descripción (opcional)" htmlFor="description">
				<Textarea
					id="description"
					name="description"
					rows={3}
					value={description ?? ""}
					placeholder="Notas visibles para el viajero sobre esta opción"
				/>
			</FormField>
		</div>
	</section>

	<section
		data-schedule-common
		hidden={Boolean(scheduleSource)}
		class="fastt-card space-y-4 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5 text-slate-950"
	>
		<header class="flex items-center gap-2">
			<Users class="h-4 w-4 text-slate-500" />
			<h2 class="text-sm font-semibold text-slate-950">Cupo y modalidad</h2>
		</header>
		<div class="grid gap-4 md:grid-cols-2 md:items-stretch">
			<div class="flex flex-col gap-2">
				<label
					for="maxPax"
					class="flex items-center text-sm font-semibold leading-snug text-slate-800 md:flex-1"
				>
					Máximo de participantes por grupo
					<span class="ml-1 text-red-600">*</span>
				</label>
				<Input
					id="maxPax"
					name="maxPax"
					type="number"
					min="1"
					required
					value={maxPax == null && isEditMode ? "" : String(maxPax ?? 12)}
				/>
			</div>
			<div class="flex flex-col gap-2">
				<div class="flex w-full items-center justify-between gap-1.5 md:flex-1">
					<label for="bookingMode" class="text-sm font-semibold leading-snug text-slate-800">
						Modalidad
						<span class="ml-1 text-red-600">*</span>
					</label>
					<FieldHelp
						id="tour-booking-mode-help"
						title="Cómo reserva el viajero"
						triggerLabel="Ayuda sobre modalidad"
						placement="top-end"
					>
						<p>
							Aquí eliges cómo reserva el viajero. El tope de grupo lo defines arriba con «Máximo de
							participantes»: adulto, niño y demás tipos suman al mismo cupo (no hay plazas
							separadas por tipo).
						</p>
						<p>
							<strong>Compartido.</strong> Reserva directa: el viajero elige fecha y tarifa y el sistema
							descuenta plazas del inventario.
						</p>
						<p>
							<strong>Privado.</strong> La solicitud no confirma una reserva ni retiene cupos.
						</p>
					</FieldHelp>
				</div>
				<Select id="bookingMode" name="bookingMode" required>
					{
						isEditMode && !bookingMode ? (
							<option value="" selected disabled>
								Selecciona una modalidad
							</option>
						) : null
					}
					<option value="shared" selected={bookingMode === "shared"}>
						Compartido (reserva directa con cupo común)
					</option>
					<option value="private" selected={bookingMode === "private"}>
						Privado · por solicitud
					</option>
				</Select>
			</div>
		</div>
		<p class="text-sm leading-5 text-slate-600">
			Este máximo limita el tamaño del grupo que puede reservar. Guardar no cambia los cupos ni las
			reservas de fechas ya programadas.
		</p>
		{
			isEditMode ? (
				<Checkbox
					name="updateDefaultCapacity"
					value="true"
					checked={false}
					label="Usar este máximo como cupo predeterminado para nuevas fechas"
					class={selectionCheckboxClass}
				/>
			) : (
				<p class="text-sm leading-5 text-slate-600">
					Al crear la opción, este máximo inicia su cupo predeterminado. Las fechas se abren después
					en el calendario.
				</p>
			)
		}
		{
			isEditMode ? (
				<>
					<>
						<Checkbox
							name="isActive"
							value="true"
							checked={isActive !== false}
							label="Habilitar el perfil de esta opción"
							class={selectionCheckboxClass}
						/>
						<p class="text-xs leading-5 text-slate-500">
							La activación comercial se revisa por separado.
						</p>
					</>
				</>
			) : (
				<input type="hidden" name="isActive" value="true" />
			)
		}
	</section>

	<section
		data-schedule-common
		hidden={Boolean(scheduleSource)}
		class="fastt-card space-y-4 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-5 text-slate-950"
	>
		<header class="flex items-center gap-2">
			<Languages class="h-4 w-4 text-slate-500" />
			<h2 class="text-sm font-semibold text-slate-950">Idioma y punto de encuentro</h2>
		</header>
		<div class="grid gap-4 md:grid-cols-2">
			<FormField label="Idioma" htmlFor="languageCode" required>
				<Select id="languageCode" name="languageCode" required>
					{
						!resolvedLanguageCode ? (
							<option value="" selected disabled>
								Selecciona un idioma
							</option>
						) : null
					}
					{
						languageOptions.map((lang) => (
							<option value={lang.code} selected={resolvedLanguageCode === lang.code}>
								{lang.label}
							</option>
						))
					}
				</Select>
			</FormField>
			{
				scheduleSource && (
					<Checkbox
						name="replaceMeetingPoint"
						label="Cambiar el punto de encuentro de este horario"
						checked={false}
					/>
				)
			}
			<FormField label="Punto de encuentro distinto (opcional)" htmlFor="meetingPointOverride">
				<Input
					id="meetingPointOverride"
					name="meetingPointOverride"
					value={meetingPointOverride ?? ""}
					placeholder="Ej: Entrada sur del parque, junto al kiosco"
				/>
				<p class="text-xs leading-5 text-slate-500">
					Solo si esta opción reúne al grupo en un lugar diferente al del tour.
				</p>
			</FormField>
		</div>
	</section>

	{
		scheduleSource && (
			<section class="fastt-card space-y-4 border border-slate-200 bg-white p-5 text-slate-950">
				<h2 class="font-semibold">Reutilizar precio y condiciones</h2>
				{scheduleSource.rate ? (
					<>
						<p class="text-sm text-slate-600">{scheduleSource.rate.name}</p>
						{scheduleSource.priceReusable ? (
							<Checkbox
								name="reusePrice"
								label={`Usar precio base: ${scheduleSource.baseline!.basePrice} ${scheduleSource.baseline!.currency}`}
								checked={false}
							/>
						) : (
							<p class="text-sm text-slate-600">Sin precio base válido. Lo configurarás después.</p>
						)}
						{scheduleSource.conditionsReusable ? (
							<>
								<Checkbox
									name="reuseConditions"
									label="Usar estas condiciones compatibles"
									checked={false}
								/>
								<ul class="space-y-1 text-sm text-slate-600">
									{scheduleSource.conditions!.policies.map((entry) => (
										<li>{reusedConditionLabel(entry)}</li>
									))}
								</ul>
							</>
						) : (
							<p class="text-sm text-slate-600">
								{scheduleSource.datedConditions
									? "Hay condiciones por fecha o ajustes específicos. Revisa condiciones nuevas para este horario."
									: "Las condiciones necesitan revisión. Las configurarás después."}
							</p>
						)}
					</>
				) : (
					<p class="text-sm text-slate-600">
						Selecciona arriba una tarifa si quieres reutilizarla. También puedes configurar un
						precio y condiciones nuevos.
					</p>
				)}
				<p class="text-xs text-slate-500">
					No se copian fechas, reservas, cierres, promociones ni ajustes de salidas.
				</p>
				<div data-equivalent-confirmation hidden>
					<a
						href={`/product/${productId}/departures`}
						class="text-sm font-semibold underline"
						target="_blank"
					>
						Revisar opciones existentes
					</a>
					<Checkbox
						name="confirmEquivalent"
						label="Necesito otra opción con este horario, idioma y modalidad"
						checked={false}
					/>
				</div>
			</section>
		)
	}

	<p id="tour-slot-form-status" class="text-sm text-slate-300" role="status" aria-live="polite"></p>

	{
		cancelHref ? (
			<footer class="fastt-playbook-footer flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-end">
				<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end">
					<Button
						href={cancelHref}
						variant="ghost"
						className="text-slate-400 hover:bg-slate-800 hover:text-white"
					>
						Volver sin guardar
					</Button>
					<Button
						type="submit"
						id="tour-slot-submit"
						variant="selection"
						className="fastt-playbook-cta"
					>
						{submitLabel || (isEditMode ? "Guardar opción" : "Crear opción")}
					</Button>
				</div>
			</footer>
		) : (
			<div class:list={["flex justify-end pt-5", playbookFooterControls ? "hidden" : ""]}>
				<Button
					type="submit"
					id="tour-slot-submit"
					variant="selection"
					className="fastt-playbook-cta"
				>
					{submitLabel || (isEditMode ? "Guardar opción" : "Crear opción")}
				</Button>
			</div>
		)
	}
</form>

<style is:global>
	.tour-slot-selection-checkbox .fastt-check-input {
		accent-color: var(--fastt-color-selection);
	}
</style>

<script>
	import { persistOptionDestination } from "@/lib/forms/tourOptionNavigation"
	import { tourPreparationNextHref } from "@/lib/playbook/launch-tour"
	function initTourSlotProfileForm() {
		const form = document.getElementById("tour-slot-profile-form") as HTMLFormElement | null
		if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") return
		form.dataset.bound = "true"
		const statusEl = document.getElementById("tour-slot-form-status")
		const schedule = form.dataset.schedule === "true"
		form
			.querySelector<HTMLButtonElement>("[data-modify-schedule]")
			?.addEventListener("click", (event) => {
				const button = event.currentTarget as HTMLButtonElement
				const expanded = button.getAttribute("aria-expanded") !== "true"
				button.setAttribute("aria-expanded", String(expanded))
				form
					.querySelectorAll<HTMLElement>("[data-schedule-common]")
					.forEach((element) => (element.hidden = !expanded))
			})

		const submitBtn = document.getElementById("tour-slot-submit") as HTMLButtonElement | null
		const draftKey = form
			? `fastt:tour-departure-draft:${form.dataset.productId || "unknown"}:${form.dataset.variantId || "new"}:${new URLSearchParams(location.search).get("sessionId") || "default"}`
			: ""
		let draftEnabled = true
		// Retain the creation intent until the server confirms it, including reloads.
		const creationKeyStorage = `${draftKey}:creation-key`
		if (form && !form.dataset.variantId) {
			let creationKey =
				new URLSearchParams(location.search).get("sessionId") ||
				window.sessionStorage.getItem(creationKeyStorage)
			if (!creationKey) {
				creationKey = crypto.randomUUID()
				window.sessionStorage.setItem(creationKeyStorage, creationKey)
			}
			const input = document.createElement("input")
			input.type = "hidden"
			input.name = "creationKey"
			input.value = creationKey
			form.append(input)
		}

		function draftControls() {
			if (!form) return []
			return Array.from(form.elements).filter(
				(control): control is HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement =>
					control instanceof HTMLInputElement ||
					control instanceof HTMLSelectElement ||
					control instanceof HTMLTextAreaElement
			)
		}

		function saveDraft() {
			if (!draftKey || !draftEnabled) return
			const values = draftControls()
				.filter((control) => control.name && control.type !== "hidden")
				.map((control) => ({
					name: control.name,
					value: control.value,
					checked: control instanceof HTMLInputElement ? control.checked : undefined,
				}))
			window.sessionStorage.setItem(
				draftKey,
				JSON.stringify({
					values,
					sourceFingerprint: (
						form?.elements.namedItem("sourceFingerprint") as HTMLInputElement | null
					)?.value,
				})
			)
		}

		if (form && draftKey) {
			try {
				const draft = JSON.parse(window.sessionStorage.getItem(draftKey) || "[]")
				const saved = Array.isArray(draft) ? draft : draft.values
				const sameSource =
					draft.sourceFingerprint ===
					(form?.elements.namedItem("sourceFingerprint") as HTMLInputElement | null)?.value
				if (Array.isArray(saved)) {
					for (const control of draftControls()) {
						const entry = saved.find((item) => item?.name === control.name)
						if (
							!entry ||
							(schedule &&
								["reusePrice", "reuseConditions", "confirmEquivalent"].includes(control.name) &&
								!sameSource)
						)
							continue
						if (control instanceof HTMLInputElement && control.type === "checkbox") {
							control.checked = Boolean(entry.checked)
						} else if (control.type !== "hidden") {
							control.value = String(entry.value ?? "")
						}
					}
					if (saved.length && statusEl) {
						statusEl.textContent = "Recuperamos el borrador de esta opción."
					}
				}
			} catch {
				window.sessionStorage.removeItem(draftKey)
			}
			form.addEventListener("input", saveDraft)
			form.addEventListener("change", saveDraft)
			window.addEventListener("pagehide", saveDraft)
		}

		form?.addEventListener("submit", async (event) => {
			event.preventDefault()
			if (!form) return
			const submitter = event.submitter
			const exitAfterSave =
				submitter instanceof HTMLButtonElement &&
				submitter.name === "playbookNav" &&
				submitter.value === "exit"
			if (form.dataset.saving === "true") return
			form.dataset.saving = "true"

			const activeSubmit = submitter instanceof HTMLButtonElement ? submitter : submitBtn
			statusEl?.setAttribute("role", "status")
			if (statusEl) statusEl.textContent = "Guardando opción..."
			if (activeSubmit) activeSubmit.disabled = true
			try {
				const fields = new FormData(form)
				const response = await fetch(
					schedule ? "/api/variant/tour-schedule-option" : "/api/variant/tour-slot-profile",
					{
						method: "POST",
						...(schedule
							? {
									headers: { "Content-Type": "application/json" },
									body: JSON.stringify({
										sessionId: fields.get("sessionId"),
										productId: fields.get("productId"),
										sourceFingerprint: fields.get("sourceFingerprint"),
										sourceRatePlanId: fields.get("sourceRatePlanId") || undefined,
										name: fields.get("name"),
										description: fields.get("description"),
										departureTime: fields.get("departureTime"),
										durationMinutes: fields.get("durationMinutes")
											? Number(fields.get("durationMinutes"))
											: null,
										maxPax: Number(fields.get("maxPax")),
										languageCode: fields.get("languageCode"),
										bookingMode: fields.get("bookingMode"),
										meetingPointOverride: fields.get("meetingPointOverride"),
										reusePrice: fields.has("reusePrice"),
										reuseConditions: fields.has("reuseConditions"),
										replaceMeetingPoint: fields.has("replaceMeetingPoint"),
										confirmEquivalent: fields.has("confirmEquivalent"),
									}),
								}
							: { body: fields }),
					}
				)
				const payload = await response.json().catch(() => ({}))
				if (!response.ok) {
					if (payload.error === "schedule_equivalent_exists")
						form.querySelector<HTMLElement>("[data-equivalent-confirmation]")!.hidden = false
					if (statusEl) {
						statusEl.setAttribute("role", "alert")
						statusEl.textContent =
							payload.message ||
							(payload?.error === "validation_error"
								? "No pudimos guardar. Revisa el nombre, la hora, el cupo y el idioma."
								: "No se pudo crear la opción. Tu borrador sigue guardado para que puedas reintentar.")
					}
					return
				}
				document.dispatchEvent(new CustomEvent("fastt:playbook-saved", { detail: { form } }))
				const productId = form.dataset.productId || ""
				const redirect = form.dataset.redirect || ""

				const variantId = String(payload?.variantId ?? "")
				const source = new URLSearchParams(window.location.search)
				const guided = [
					"launch-tour",
					"complete-to-publish",
					"complete",
					"add-tour-option",
				].includes(source.get("playbook") || "")
				const destination = guided
					? tourPreparationNextHref(
							source,
							{ productId, variantId, ratePlanId: source.get("ratePlanId") || undefined },
							"departure"
						)
					: redirect.replace("__VARIANT_ID__", encodeURIComponent(variantId))
				if (schedule) {
					const marker = document.querySelector<HTMLElement>("[data-option-session]")
					if (marker) marker.dataset.revision = String(payload.revision)
				}
				const persistedDestination = schedule
					? payload.href
					: await persistOptionDestination(destination)
				draftEnabled = false
				window.sessionStorage.removeItem(creationKeyStorage)
				window.sessionStorage.removeItem(draftKey)
				form.dataset.saving = "false"
				window.location.href =
					(exitAfterSave
						? `/product/${encodeURIComponent(productId)}${source.get("playbook") === "add-tour-option" ? "/departures" : ""}`
						: persistedDestination) ||
					`/product/${encodeURIComponent(productId)}/departures${variantId ? `?created=${encodeURIComponent(variantId)}` : ""}`
			} catch (error) {
				if (statusEl) {
					statusEl.setAttribute("role", "alert")
					statusEl.textContent =
						error instanceof Error
							? error.message
							: "Se perdió la conexión. Tu borrador sigue guardado; reintenta."
				}
			} finally {
				form.dataset.saving = "false"
				if (activeSubmit) activeSubmit.disabled = false
			}
		})
	}
	initTourSlotProfileForm()
	document.addEventListener("astro:page-load", initTourSlotProfileForm)
</script>
