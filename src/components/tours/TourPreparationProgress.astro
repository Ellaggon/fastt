---
import type { projectTourPublishingStages } from "@/lib/playbook/tour-publishing-stages"
interface Props {
	stages: ReturnType<typeof projectTourPublishingStages>
	activeStageId?: string
	stagePosition?: number
	stageTotal?: number
	productName?: string
}
const { stages, activeStageId, stagePosition = 0, stageTotal = 0, productName = "" } = Astro.props
const stageCoreLabel =
	stagePosition > 0 && stageTotal > 0 ? `Etapa ${stagePosition} de ${stageTotal}` : "Ver etapas"
const tourName = productName.trim()
const stageSummaryLabel = tourName ? `${tourName} - ${stageCoreLabel}` : stageCoreLabel
const labels = {
	ready: "Completa",
	pending: "Pendiente",
	blocked: "Requiere revisión",
	not_evaluable: "No se pudo comprobar",
}
---

<div class="space-y-0" data-tour-preparation-progress>
	{
		stages ? (
			<details class="group" data-tour-stages-disclosure>
				<summary class="tour-preparation-summary cursor-pointer py-0 text-sm leading-snug font-semibold text-slate-300">
					{stageSummaryLabel}
				</summary>
				<nav aria-label="Etapas de preparación" class="mt-3">
					<ol class="tour-stage-rail grid list-none gap-2 p-0 lg:grid-cols-3">
						{stages.map((stage) => {
							const isActive = stage.id === activeStageId
							const statusLabel =
								isActive && stage.state === "pending"
									? "En curso"
									: labels[stage.state as keyof typeof labels]
							const itemClass = [
								"tour-stage-rail__step",
								isActive ? "tour-stage-rail__step--active" : "",
								stage.state === "ready" ? "tour-stage-rail__step--ready" : "",
								stage.state === "blocked" ? "tour-stage-rail__step--blocked" : "",
								stage.state === "not_evaluable" ? "tour-stage-rail__step--muted" : "",
							]
								.filter(Boolean)
								.join(" ")
							const inner = (
								<>
									<p class="tour-stage-rail__heading">
										<span class="tour-stage-rail__index">{stage.position}</span>
										<span class="tour-stage-rail__label">{stage.label}</span>
									</p>
									<span class="tour-stage-rail__status">
										{statusLabel}
										{isActive && stage.state !== "pending" ? " · Etapa actual" : ""}
									</span>
								</>
							)
							return (
								<li
									class={itemClass}
									aria-current={isActive ? "step" : undefined}
									data-tour-stage-id={stage.id}
									data-tour-stage-state={stage.state}
								>
									{stage.href ? (
										<a class="tour-stage-rail__link" href={stage.href}>
											{inner}
										</a>
									) : (
										<div class="tour-stage-rail__body">{inner}</div>
									)}
								</li>
							)
						})}
					</ol>
				</nav>
			</details>
		) : null
	}
</div>

<style>
	.tour-stage-rail {
		scrollbar-width: thin;
		scrollbar-color: rgb(100 116 139 / 0.45) transparent;
	}

	.tour-stage-rail__step {
		flex: 1 1 0;
		min-width: 5.75rem;
	}

	.tour-stage-rail__link,
	.tour-stage-rail__body {
		display: flex;
		height: 100%;
		min-height: 4.25rem;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.125rem;
		border-radius: 0.5rem;
		border: 1px solid rgb(100 116 139 / 0.28);
		background: rgb(15 23 42 / 0.35);
		padding: 0.5rem 0.625rem;
		text-align: left;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.tour-stage-rail__link {
		text-decoration: none;
		color: inherit;
	}

	.tour-stage-rail__link:hover {
		border-color: rgb(148 163 184 / 0.45);
		background: rgb(30 41 59 / 0.55);
	}

	.tour-stage-rail__heading {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		margin: 0;
		min-width: 0;
	}

	.tour-stage-rail__index {
		flex-shrink: 0;
		font-size: 0.6875rem;
		font-weight: 700;
		line-height: 1.25;
		color: rgb(148 163 184);
	}

	.tour-stage-rail__label {
		min-width: 0;
		font-size: 0.6875rem;
		line-height: 1.25;
		font-weight: 600;
		color: rgb(226 232 240);
	}

	.tour-stage-rail__status {
		margin-top: auto;
		font-size: 0.625rem;
		line-height: 1.2;
		color: rgb(148 163 184);
	}

	.tour-stage-rail__step--active .tour-stage-rail__link,
	.tour-stage-rail__step--active .tour-stage-rail__body {
		border-color: var(--fastt-color-selection);
		background: linear-gradient(180deg, rgb(37 99 235 / 0.22), rgb(15 23 42 / 0.5));
		box-shadow:
			inset 0 0 0 1px rgb(37 99 235 / 0.35),
			0 8px 20px rgb(37 99 235 / 0.12);
	}

	.tour-stage-rail__step--active .tour-stage-rail__index {
		color: rgb(191 219 254);
	}

	.tour-stage-rail__step--active .tour-stage-rail__label {
		color: rgb(248 250 252);
	}

	.tour-stage-rail__step--active .tour-stage-rail__status {
		font-weight: 600;
		color: rgb(191 219 254);
	}

	.tour-stage-rail__step--ready .tour-stage-rail__link,
	.tour-stage-rail__step--ready .tour-stage-rail__body {
		border-color: rgb(16 185 129 / 0.35);
		background: rgb(6 78 59 / 0.18);
	}

	.tour-stage-rail__step--ready .tour-stage-rail__status {
		color: rgb(110 231 183);
	}

	.tour-stage-rail__step--blocked .tour-stage-rail__link,
	.tour-stage-rail__step--blocked .tour-stage-rail__body {
		border-color: rgb(245 158 11 / 0.45);
	}

	.tour-stage-rail__step--blocked .tour-stage-rail__status {
		color: rgb(252 211 77);
	}

	@media (min-width: 640px) {
		.tour-stage-rail__step {
			min-width: 0;
		}

		.tour-stage-rail__index,
		.tour-stage-rail__label {
			font-size: 0.75rem;
		}
	}

	.tour-stage-rail__link:focus-visible {
		outline: 2px solid rgb(191 219 254);
		outline-offset: 3px;
	}
	@media (prefers-reduced-motion: reduce) {
		.tour-stage-rail__link {
			transition: none;
		}
	}
</style>

<script>
	function initStageTransitions() {
		document
			.querySelectorAll<HTMLDetailsElement>("[data-tour-stages-disclosure]")
			.forEach((details) => {
				if (details.dataset.transitionBound) return
				const summary = details.querySelector("summary")
				const content = details.querySelector("nav")
				if (!summary || !content) return
				details.dataset.transitionBound = "true"
				let expanded = details.open
				let animation: Animation | null = null
				summary.addEventListener("click", (event) => {
					event.preventDefault()
					const from = details.getBoundingClientRect().height
					animation?.cancel()
					expanded = !expanded
					content.inert = !expanded
					summary.setAttribute("aria-expanded", String(expanded))
					if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						details.open = expanded
						details.style.removeProperty("overflow")
						animation = null
						return
					}
					// Keep the native disclosure open until its closing animation finishes.
					details.open = true
					const to = expanded
						? details.getBoundingClientRect().height
						: summary.getBoundingClientRect().height
					details.style.overflow = "hidden"
					animation = details.animate([{ height: `${from}px` }, { height: `${to}px` }], {
						duration: 360,
						easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
					})
					animation.onfinish = () => {
						details.open = expanded
						details.style.removeProperty("overflow")
						animation = null
					}
				})
			})
	}
	initStageTransitions()
	document.addEventListener("astro:page-load", initStageTransitions)
</script>
