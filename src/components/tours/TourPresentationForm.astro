---
import { experienceThemeCompatibility } from "@/shared/domain/experience-theme-compatibility"
import PlaybookStepHeader from "@/components/playbook/PlaybookStepHeader.astro"
import Card from "@/components/ui/Card.astro"
import Button from "@/components/ui/Button.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import Textarea from "@/components/ui/Textarea.astro"
import ExperienceActivityPicker from "@/components/tours/ExperienceActivityPicker.astro"
import TourCategoryChoices from "@/components/tours/TourCategoryChoices.astro"
import { getExperienceFormatPresentation } from "@/lib/tours/experienceFormatPresentation"
import {
	EXPERIENCE_CREATION_FORMATS,
	type ExperienceFormat,
} from "@/shared/domain/experience-format"
import type { loadTourPresentationForm } from "@/lib/tours/loadTourPresentationForm"
interface Props {
	providerId: string
	productId?: string
	experienceFormat?: ExperienceFormat | null
	formatContractVersion?: number
	name?: string
	geoPlaceId?: string | null
	description?: string | null
	highlights?: string[]
	options: Awaited<ReturnType<typeof loadTourPresentationForm>>
	guided?: boolean
}
const {
	providerId,
	productId,
	name = "",
	experienceFormat = null,
	formatContractVersion = 1,
	geoPlaceId = "",
	description = "",
	highlights = [],
	options,
	guided = true,
} = Astro.props
const formatPresentation = getExperienceFormatPresentation(experienceFormat)
const offeredFormats = [
	...new Set([...EXPERIENCE_CREATION_FORMATS, ...(experienceFormat ? [experienceFormat] : [])]),
]
const linked = new Set(options.additionalThemeIds ?? [])
const families = (options.families ?? []).filter((row) => row.isActive || linked.has(row.id))
const selectedActivity = options.activities?.find(
	(a) => a.id === options.classification?.primaryActivityCategoryId
)
const themeState = experienceThemeCompatibility(selectedActivity, families, [...linked])
const visibleThemes = new Set([...themeState.availableIds, ...themeState.invalidIds])
const editorialEdit = Boolean(productId) && !guided
const playbookVisual = guided || editorialEdit
const panelClass = playbookVisual ? "space-y-5" : "space-y-5"
---

<section class:list={[playbookVisual ? "space-y-6" : "space-y-6"]}>
	<PlaybookStepHeader
		icon="presentation"
		size="lg"
		title={editorialEdit ? "Presentación de la experiencia" : "Presenta tu experiencia"}
		lead={editorialEdit
			? "Actualiza nombre, actividad, lugar y contenido que verán los viajeros."
			: "Cuenta qué ofreces y dónde. Después completarás los detalles de la experiencia."}
		tone={playbookVisual ? "playbook" : "light"}
	/>
	<form
		id="tourPresentationForm"
		action="/api/product/tour-presentation"
		method="POST"
		class:list={["w-full", playbookVisual ? "max-w-5xl space-y-5" : "max-w-3xl space-y-6"]}
		data-draft-owner={providerId}
	>
		<Input type="hidden" name="productId" value={productId ?? crypto.randomUUID()} />
		<Input type="hidden" name="mode" value={productId ? "edit" : "create"} />
		<Input type="hidden" name="classificationPayloadVersion" value="1" />
		<Input
			type="hidden"
			name="expectedClassificationRevision"
			value={options.classification?.classificationRevision ?? 0}
		/>
		{
			["playbook", "flow", "tourFlowVersion", "variantId", "ratePlanId", "returnTo"].map((key) => (
				<Input type="hidden" name={key} value={Astro.url.searchParams.get(key) ?? ""} />
			))
		}

		<div
			data-presentation-grid
			data-has-themes={String(visibleThemes.size > 0)}
			class:list={[
				playbookVisual
					? "grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(14rem,19rem)]"
					: "contents",
			]}
		>
			{
				playbookVisual ? (
					<>
						<div
							data-presentation-main
							class="order-1 flex min-w-0 flex-col gap-5 lg:col-start-1 lg:row-start-1"
						>
							<Card class:list={[panelClass]}>
								<fieldset class="space-y-5 border-0 p-0">
									<legend class="sr-only">Identidad y lugar</legend>
									<div class="space-y-1">
										<h2 class="text-base font-semibold text-slate-950">Identidad y lugar</h2>
										<p class="text-sm leading-6 text-slate-500">
											Nombre y ciudad donde se encuentra la experiencia.
										</p>
									</div>
									<FormField label="Nombre de la experiencia" htmlFor="name" required>
										<Input
											id="name"
											name="name"
											value={name}
											maxlength={200}
											required
											placeholder={formatPresentation.namePlaceholder}
											aria-describedby="nameError"
										/>
										<p
											id="nameError"
											data-presentation-error="name"
											class="hidden text-sm text-red-600"
										/>
									</FormField>
									<FormField label="Ciudad o lugar" htmlFor="geoPlaceId" required>
										<Select
											id="geoPlaceId"
											name="geoPlaceId"
											required
											aria-describedby="destinationHelp geoPlaceIdError"
										>
											<option value="">Elige ciudad o lugar</option>
											{options.places.map((place) => (
												<option value={place.id} selected={place.id === geoPlaceId}>
													{place.name} · {place.country}
												</option>
											))}
										</Select>
										<p id="destinationHelp" class="mt-2 text-sm leading-6 text-slate-500">
											El lugar donde se podrá encontrar esta experiencia. La dirección y las
											indicaciones se completan después.
										</p>
										<p
											id="geoPlaceIdError"
											data-presentation-error="geoPlaceId"
											class="hidden text-sm text-red-600"
										/>
									</FormField>
								</fieldset>
							</Card>
							<Card class:list={[panelClass]}>
								<fieldset class="space-y-5 border-0 p-0">
									<legend class="sr-only">Descripción y destacados</legend>
									<div class="space-y-1">
										<h2 class="text-base font-semibold text-slate-950">Descripción y destacados</h2>
										<p class="text-sm leading-6 text-slate-500">
											Texto principal y puntos clave que aparecerán en la ficha de la experiencia.
										</p>
									</div>
									<FormField label="Descripción" htmlFor="description" required>
										<Textarea
											id="description"
											name="description"
											value={description ?? ""}
											rows="5"
											required
											maxlength={20000}
											placeholder={formatPresentation.descriptionPlaceholder}
											aria-describedby="descriptionError"
										/>
										<p
											id="descriptionError"
											data-presentation-error="description"
											class="hidden text-sm text-red-600"
										/>
									</FormField>
									<FormField
										label="Lo que hace especial esta experiencia"
										htmlFor="highlights"
										required
									>
										<Textarea
											id="highlights"
											name="highlights"
											value={highlights.join("\n")}
											rows="4"
											required
											placeholder="Escribe lo que hace especial esta experiencia"
											aria-describedby="highlightsHelp highlightsError"
										/>
										<p id="highlightsHelp" class="mt-2 text-sm leading-6 text-slate-500">
											Escribe un destacado por línea.
										</p>
										<p
											id="highlightsError"
											data-presentation-error="highlights"
											class="hidden text-sm text-red-600"
										/>
									</FormField>
								</fieldset>
							</Card>
							<Card
								data-additional-themes
								hidden={visibleThemes.size === 0}
								class:list={[panelClass]}
							>
								<fieldset
									class="flex h-full flex-col gap-4 border-0 p-0"
									aria-describedby="additionalThemeIdsError"
								>
									<p data-theme-review hidden class="text-sm text-amber-800" role="status" />
									<TourCategoryChoices
										categories={families}
										permittedIds={new Set(themeState.availableIds)}
										visibleIds={visibleThemes}
										name="additionalThemeId"
										optional={true}
										selectedIds={linked}
										stacked={true}
									/>
									<p
										id="additionalThemeIdsError"
										data-presentation-error="additionalThemeIds"
										class="hidden text-sm text-red-600"
									/>
								</fieldset>
							</Card>
						</div>
						<Card
							class:list={[
								panelClass,
								"order-2 min-w-0 lg:col-start-2 lg:row-start-1 lg:self-start",
							]}
						>
							<fieldset class="min-w-0 space-y-5 border-0 p-0">
								<legend class="sr-only">Actividad y formato</legend>
								<div class="space-y-1">
									<h2 class="text-base font-semibold text-slate-950">Actividad y formato</h2>
									<p class="text-sm leading-6 text-slate-500">
										Qué haces y cómo se vive la experiencia.
									</p>
								</div>
								<ExperienceActivityPicker options={options} />
								<FormField
									label="Formato de la experiencia"
									htmlFor="experienceFormat"
									required={formatContractVersion === 1}
								>
									<Select
										id="experienceFormat"
										name="experienceFormat"
										required={formatContractVersion === 1}
										aria-describedby="experienceFormatHelp experienceFormatError"
									>
										<option value="">Elige un formato</option>
										{offeredFormats.map((format) => (
											<option value={format} selected={experienceFormat === format}>
												{getExperienceFormatPresentation(format).label}
											</option>
										))}
									</Select>
									<p id="experienceFormatHelp" class="mt-2 text-sm leading-6 text-slate-500">
										{formatPresentation.explanation}
									</p>
									<p
										id="experienceFormatError"
										data-presentation-error="experienceFormat"
										class="hidden text-sm text-red-600"
									/>
								</FormField>
							</fieldset>
						</Card>
					</>
				) : (
					<>
						<Card class:list={[panelClass]}>
							<fieldset class="space-y-5 border-0 p-0">
								<legend class="sr-only">Datos básicos</legend>
								<div class="space-y-1">
									<h2 class="text-base font-semibold text-slate-950">Identidad y lugar</h2>
									<p class="text-sm leading-6 text-slate-500">
										Nombre, actividad principal, formato y ciudad donde se encuentra la experiencia.
									</p>
								</div>
								<FormField label="Nombre de la experiencia" htmlFor="name" required>
									<Input
										id="name"
										name="name"
										value={name}
										maxlength={200}
										required
										placeholder={formatPresentation.namePlaceholder}
										aria-describedby="nameError"
									/>
									<p
										id="nameError"
										data-presentation-error="name"
										class="hidden text-sm text-red-600"
									/>
								</FormField>
								<ExperienceActivityPicker options={options} />
								<FormField
									label="Formato de la experiencia"
									htmlFor="experienceFormat"
									required={formatContractVersion === 1}
								>
									<Select
										id="experienceFormat"
										name="experienceFormat"
										required={formatContractVersion === 1}
										aria-describedby="experienceFormatHelp experienceFormatError"
									>
										<option value="">Elige un formato</option>
										{offeredFormats.map((format) => (
											<option value={format} selected={experienceFormat === format}>
												{getExperienceFormatPresentation(format).label}
											</option>
										))}
									</Select>
									<p id="experienceFormatHelp" class="mt-2 text-sm leading-6 text-slate-500">
										{formatPresentation.explanation}
									</p>
									<p
										id="experienceFormatError"
										data-presentation-error="experienceFormat"
										class="hidden text-sm text-red-600"
									/>
								</FormField>
								<FormField label="Ciudad o lugar" htmlFor="geoPlaceId" required>
									<Select
										id="geoPlaceId"
										name="geoPlaceId"
										required
										aria-describedby="destinationHelp geoPlaceIdError"
									>
										<option value="">Elige ciudad o lugar</option>
										{options.places.map((place) => (
											<option value={place.id} selected={place.id === geoPlaceId}>
												{place.name} · {place.country}
											</option>
										))}
									</Select>
									<p id="destinationHelp" class="mt-2 text-sm leading-6 text-slate-500">
										El lugar donde se podrá encontrar esta experiencia. La dirección y las
										indicaciones se completan después.
									</p>
									<p
										id="geoPlaceIdError"
										data-presentation-error="geoPlaceId"
										class="hidden text-sm text-red-600"
									/>
								</FormField>
							</fieldset>
						</Card>
						<Card
							data-additional-themes
							hidden={visibleThemes.size === 0}
							class:list={[panelClass]}
						>
							<fieldset
								class="flex h-full flex-col gap-4 border-0 p-0"
								aria-describedby="additionalThemeIdsError"
							>
								<p data-theme-review hidden class="text-sm text-amber-800" role="status" />
								<TourCategoryChoices
									categories={families}
									permittedIds={new Set(themeState.availableIds)}
									visibleIds={visibleThemes}
									name="additionalThemeId"
									optional={true}
									selectedIds={linked}
									stacked={false}
								/>
								<p
									id="additionalThemeIdsError"
									data-presentation-error="additionalThemeIds"
									class="hidden text-sm text-red-600"
								/>
							</fieldset>
						</Card>
						<Card class:list={[panelClass]}>
							<fieldset class="space-y-5 border-0 p-0">
								<legend class="sr-only">Descripción y destacados</legend>
								<div class="space-y-1">
									<h2 class="text-base font-semibold text-slate-950">Descripción y destacados</h2>
									<p class="text-sm leading-6 text-slate-500">
										Texto principal y puntos clave que aparecerán en la ficha de la experiencia.
									</p>
								</div>
								<FormField label="Descripción" htmlFor="description" required>
									<Textarea
										id="description"
										name="description"
										value={description ?? ""}
										rows="5"
										required
										maxlength={20000}
										placeholder={formatPresentation.descriptionPlaceholder}
										aria-describedby="descriptionError"
									/>
									<p
										id="descriptionError"
										data-presentation-error="description"
										class="hidden text-sm text-red-600"
									/>
								</FormField>
								<FormField
									label="Lo que hace especial esta experiencia"
									htmlFor="highlights"
									required
								>
									<Textarea
										id="highlights"
										name="highlights"
										value={highlights.join("\n")}
										rows="4"
										required
										placeholder="Escribe lo que hace especial esta experiencia"
										aria-describedby="highlightsHelp highlightsError"
									/>
									<p id="highlightsHelp" class="mt-2 text-sm leading-6 text-slate-500">
										Escribe un destacado por línea.
									</p>
									<p
										id="highlightsError"
										data-presentation-error="highlights"
										class="hidden text-sm text-red-600"
									/>
								</FormField>
							</fieldset>
						</Card>
					</>
				)
			}
		</div>

		<p
			data-presentation-status
			class:list={["text-sm", playbookVisual ? "text-slate-400" : "text-slate-400"]}
			role="status"
			aria-live="polite"
		>
		</p>
		{
			!guided ? (
				<div class="flex justify-end">
					<Button type="submit" variant="selection" className="fastt-playbook-cta">
						Guardar presentación
					</Button>
				</div>
			) : null
		}
	</form>
</section>
<script>
	import { setPlaybookSubmitBusy } from "@/lib/forms/playbookFormBusy"
	import { bindPlaybookFormDraft } from "@/lib/forms/playbookFormDraft"
	import { getExperienceFormatPresentation } from "@/lib/tours/experienceFormatPresentation"
	import { isExperienceFormat } from "@/shared/domain/experience-format"
	function initPresentation() {
		const form = document.getElementById("tourPresentationForm")
		if (!(form instanceof HTMLFormElement) || form.dataset.bound) return
		form.dataset.bound = "true"
		const id = form.elements.namedItem("productId") as HTMLInputElement
		const mode = form.elements.namedItem("mode") as HTMLInputElement
		const creationKey = `fastt:tour-presentation-create:${form.dataset.draftOwner}`
		try {
			if (mode.value === "create") {
				const previous = sessionStorage.getItem(creationKey)
				if (previous && /^[0-9a-f-]{36}$/i.test(previous)) id.value = previous
				else sessionStorage.setItem(creationKey, id.value)
			}
		} catch {
			/* Form still works when browser storage is unavailable. */
		}
		const draft = bindPlaybookFormDraft(form, {
			key: `tour-presentation:${form.dataset.draftOwner}:${id.value}`,
			excludeNames: ["activityChoice"],
		})
		const status = form.querySelector<HTMLElement>("[data-presentation-status]")!
		const refreshFormat = () => {
			const formatField = form.querySelector<HTMLSelectElement>('select[name="experienceFormat"]')
			const format = isExperienceFormat(formatField?.value) ? formatField!.value : null
			const presentation = getExperienceFormatPresentation(format)
			const help = form.querySelector("#experienceFormatHelp")
			if (help) help.textContent = presentation.explanation
			const name = form.querySelector<HTMLInputElement>("#name")
			const description = form.querySelector<HTMLTextAreaElement>("#description")
			if (name) name.placeholder = presentation.namePlaceholder
			if (description) description.placeholder = presentation.descriptionPlaceholder
		}
		form.addEventListener("change", (event) => {
			if (event.target instanceof HTMLSelectElement && event.target.name === "experienceFormat")
				refreshFormat()
		})
		refreshFormat()
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			if (form.dataset.saving) return
			const fd = new FormData(form)
			if (event.submitter instanceof HTMLButtonElement)
				fd.set("playbookNav", event.submitter.value === "exit" ? "exit" : "continue")
			form.querySelectorAll<HTMLElement>("[data-presentation-error]").forEach((node) => {
				node.textContent = ""
				node.classList.add("hidden")
			})
			form
				.querySelectorAll("[aria-invalid]")
				.forEach((node) => node.removeAttribute("aria-invalid"))
			if (fd.get("playbookNav") !== "exit" && !fd.get("primaryActivityCategoryId")) {
				const error = form.querySelector<HTMLElement>(
					'[data-presentation-error="primaryActivityCategoryId"]'
				)!
				error.textContent = "Selecciona la actividad principal."
				error.classList.remove("hidden")
				const control = form.querySelector<HTMLSelectElement>('[name="primaryActivityCategoryId"]')!
				control.setAttribute("aria-invalid", "true")
				form.querySelector<HTMLButtonElement>("[data-change-activity]")?.focus()
				status.textContent = "Revisa los campos indicados."
				return
			}

			setPlaybookSubmitBusy(form, true, "Guardando…")
			form.dataset.saving = "true"
			status.textContent = "Guardando presentación…"
			try {
				const response = await fetch(form.action, { method: "POST", body: fd })
				const result = await response.json()
				if (!response.ok) {
					let first: HTMLElement | null = null
					for (const [field, messages] of Object.entries(result.fieldErrors ?? {})) {
						const error = form.querySelector<HTMLElement>(
							`[data-presentation-error="${CSS.escape(field)}"]`
						)
						if (error) {
							error.textContent = (messages as string[]).join(" ")
							error.classList.remove("hidden")
						}
						const control = form.querySelector<HTMLElement>(
							`[name="${CSS.escape(field === "additionalThemeIds" ? "additionalThemeId" : field)}"]`
						)
						control?.setAttribute("aria-invalid", "true")
						first ??= control
					}
					first?.focus()
					throw new Error(
						response.status === 401
							? "Tu sesión venció. Inicia sesión de nuevo; conservamos tus datos."
							: result.error
					)
				}
				status.textContent = "Presentación guardada."
				mode.value = "edit"
				draft.clear()
				try {
					sessionStorage.removeItem(creationKey)
				} catch {
					/* No storage required. */
				}
				window.location.assign(result.nextHref)
			} catch (error) {
				status.textContent =
					error instanceof Error ? error.message : "No pudimos guardar. Vuelve a intentarlo."
				delete form.dataset.saving
				setPlaybookSubmitBusy(form, false)
			}
		})
	}
	initPresentation()
	document.addEventListener("astro:page-load", initPresentation)
</script>

<style is:global>
	[data-presentation-grid].contents[data-has-themes="false"] {
		display: block;
		max-width: 48rem;
	}

	[data-presentation-grid].contents[data-has-themes="false"] > :not([hidden]) + :not([hidden]) {
		margin-top: 1.25rem;
	}
</style>
