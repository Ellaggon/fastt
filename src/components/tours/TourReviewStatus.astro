---
import { summarizeTourDiagnostic, type TourDiagnostic } from "@/lib/tours/tourDiagnosticContract"
import { presentTourDiagnostic } from "@/lib/tours/tourDiagnosticPresentation"
import { projectTourPublicationTasks } from "@/lib/tours/tourPublicationTasks"
import {
	tourPublicationTaskHeadline,
	tourPublicationTaskIconId,
	tourPublicationTaskImpact,
	tourPublicationTaskStatus,
} from "@/lib/tours/tourPublicationTaskPresentation"
import { readinessIconWellClass, readinessRowClass } from "@/lib/ui/readinessPresentation"
import { buildTourPlaybookHref } from "@/lib/playbook/launch-tour"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import { projectAuthorizationDecisions } from "@/lib/tours/tourPublicationDecisions"
import {
	ChevronRight,
	CircleCheck,
	ClipboardList,
	Image,
	Layers,
	ListChecks,
	MapPin,
	ShieldCheck,
	Users,
} from "@lucide/astro"

interface Props {
	diagnosis: TourDiagnostic
	reviewHref: string
	published: boolean
}
const { diagnosis, reviewHref, published } = Astro.props
const summary = summarizeTourDiagnostic(diagnosis)
const presentation = presentTourDiagnostic(diagnosis, { previewHref: reviewHref, published })
const { tasks, waiting, completed } = projectTourPublicationTasks(diagnosis)
const openTasks = [...tasks, ...waiting]
const decisions =
	diagnosis.publicationDecisions ??
	projectAuthorizationDecisions({
		productId: diagnosis.context.productId,
		policy: null,
		verification: null,
		agreement: null,
	})
const preparationTasks = openTasks.filter((task) =>
	task.ids.some((id) => id !== "provider_authorization" && id !== "experience_authorization")
)
const selection = diagnosis.context.selection
const decisionHref = (href: string) => {
	const target = new URL(href, "http://fastt.local")
	if (target.pathname.startsWith("/product/") && selection.state === "resolved") {
		target.searchParams.set("variantId", selection.variantId)
		target.searchParams.set("ratePlanId", selection.ratePlanId)
	}
	if (target.pathname === "/provider/settings/payments" || target.pathname.startsWith("/product/"))
		target.searchParams.set("returnTo", reviewHref)
	return target.pathname + target.search + target.hash
}
const edit = new URL(
	buildTourPlaybookHref(
		`/product/${encodeURIComponent(diagnosis.context.productId)}/content`,
		"content"
	),
	"http://fastt.local"
)
edit.searchParams.set("returnTo", reviewHref)
if (selection.state === "resolved") {
	edit.searchParams.set("variantId", selection.variantId)
	edit.searchParams.set("ratePlanId", selection.ratePlanId)
}

const taskDetail = (task: (typeof openTasks)[number]) => {
	const impact = tourPublicationTaskImpact(task)
	const rest = task.messages.filter((message) => message !== impact)
	return rest.length ? rest.join(" ") : null
}

const taskIcon = (task: (typeof openTasks)[number]) => {
	const id = tourPublicationTaskIconId(task)
	if (id === "location") return MapPin
	if (id === "photos") return Image
	if (id === "participants") return Users
	if (id === "logistics") return ListChecks
	if (id === "option") return Layers
	if (id === "authorization") return ShieldCheck
	return ClipboardList
}
---

<div class="space-y-5" data-tour-review-status>
	<section
		aria-label="Estado para publicar"
		class="divide-y divide-slate-200"
		data-tour-publication-decisions
	>
		<h3 class="pb-3 text-base font-semibold text-slate-950">Estado para publicar</h3>
		{
			decisions.map((decision) => (
				<div class="py-4" data-publication-decision={decision.id}>
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h4 class="text-sm font-semibold text-slate-950">{decision.label}</h4>
						<Badge variant={decision.tone}>{decision.status}</Badge>
					</div>
					<p class="mt-2 text-sm leading-6 text-slate-600">{decision.message}</p>
					{decision.status === "No se pudo comprobar" && (
						<Button href={reviewHref} variant="ghost" size="sm" data-astro-reload>
							Reintentar comprobación
						</Button>
					)}
					{decision.actions.length > 0 && (
						<div class="mt-2 flex flex-wrap gap-2">
							{decision.actions.map((action) => (
								<Button href={decisionHref(action.href)} variant="ghost" size="sm">
									{action.label}
								</Button>
							))}
						</div>
					)}
				</div>
			))
		}
	</section>
	<details
		class="group border-t border-slate-200 pt-4"
		open={preparationTasks.length > 0}
		data-publication-decision="preparation"
	>
		<summary
			class="flex cursor-pointer flex-wrap items-center justify-between gap-2 text-sm font-semibold text-slate-950"
		>
			<span class="inline-flex items-center gap-2"
				><ChevronRight
					class="size-4 transition-transform motion-reduce:transition-none group-open:rotate-90"
					aria-hidden="true"
				/>Preparación de la experiencia</span
			>
			<Badge variant={preparationTasks.length ? "warning" : "success"}
				>{
					preparationTasks.length ? `Faltan ${preparationTasks.length} aspectos` : "Completa"
				}</Badge
			>
		</summary>
		<div class="mt-4 space-y-4">
			{
				!published && preparationTasks.length ? (
					<div class="space-y-3" data-tour-publication-tasks>
						{preparationTasks.map((task) => {
							const status = tourPublicationTaskStatus(task)
							const Icon = taskIcon(task)
							const retry = "unknown" in task && task.unknown
							const href = task.href ?? (retry ? reviewHref : undefined)
							const TaskRow = href ? "a" : "div"
							const actionLabel = "unknown" in task && task.unknown ? "Reintentar" : "Completar"
							return (
								<TaskRow
									href={href}
									class={readinessRowClass(status)}
									data-tour-publication-task={task.key}
									aria-label={href ? `${actionLabel}: ${task.label}` : undefined}
									data-astro-reload={"unknown" in task && task.unknown ? true : undefined}
								>
									<span class={readinessIconWellClass(status)} data-tour-publication-task-icon>
										<Icon class="size-4" aria-hidden="true" />
									</span>
									<div class="min-w-0 flex-1">
										<p class="text-sm font-semibold text-slate-950">
											{tourPublicationTaskHeadline(task)}
										</p>
										<p class="mt-1 text-sm leading-5 text-slate-500">
											{tourPublicationTaskImpact(task)}
										</p>
										{taskDetail(task) ? (
											<p class="mt-1 text-sm leading-5 text-slate-600">{taskDetail(task)}</p>
										) : null}
										{!href && (
											<p class="mt-2 text-sm leading-5 text-slate-600">
												Este paso corresponde a Fastt. No necesitas volver a completar la ficha ni
												reenviar documentos.
											</p>
										)}
									</div>
									<div class="flex flex-wrap items-center gap-2 sm:justify-end">
										<Badge variant={status.variant}>{status.label}</Badge>
										{href && (
											<ChevronRight
												class="size-4 shrink-0 text-slate-400 transition group-hover:text-[var(--fastt-color-selection)]"
												aria-hidden="true"
											/>
										)}
									</div>
								</TaskRow>
							)
						})}
					</div>
				) : null
			}

			{
				completed.length ? (
					<details class="group border-t border-slate-200 pt-4" data-tour-publication-completed>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 [&::-webkit-details-marker]:hidden">
							<span class="inline-flex items-center gap-2">
								<CircleCheck class="size-4 text-emerald-600" aria-hidden="true" />
								Requisitos cumplidos ({completed.length})
							</span>
							<span class="text-xs font-medium text-slate-500 group-open:hidden">Mostrar</span>
							<span class="hidden text-xs font-medium text-slate-500 group-open:inline">
								Ocultar
							</span>
						</summary>
						<div class="space-y-3 border-t border-slate-100 p-3">
							{completed.map((item) => (
								<a
									href={item.href}
									class={readinessRowClass({ variant: "success" }, true)}
									data-tour-publication-completed-item={item.id}
								>
									<span class={readinessIconWellClass({ variant: "success" }, true)}>
										<CircleCheck class="size-4" aria-hidden="true" />
									</span>
									<div class="min-w-0 flex-1">
										<p class="text-sm font-semibold text-slate-950">{item.label}</p>
										<p class="mt-1 text-sm leading-5 text-slate-500">Sin bloqueos directos</p>
									</div>
									<div class="flex flex-wrap items-center gap-2 sm:justify-end">
										<Badge variant="success">Completo</Badge>
										<ChevronRight
											class="size-4 shrink-0 text-slate-400 transition group-hover:text-[var(--fastt-color-selection)]"
											aria-hidden="true"
										/>
									</div>
								</a>
							))}
						</div>
					</details>
				) : null
			}
		</div>
	</details>
	{
		!published &&
		!openTasks.length &&
		!summary.activation.complete &&
		presentation.activation.allowed &&
		selection.state === "resolved" ? (
			<div class="space-y-3 border-t border-slate-200 pt-5">
				<p class="text-sm leading-6 text-slate-600">
					Revisa la ficha y activa la oferta para continuar.
				</p>
				<Button
					type="button"
					variant="selection"
					class="fastt-playbook-cta"
					data-tour-review-activate
					data-product-id={diagnosis.context.productId}
					data-variant-id={selection.variantId}
					data-rate-plan-id={selection.ratePlanId}
				>
					Activar oferta
				</Button>
				<p data-tour-activation-feedback role="status" class="text-sm text-slate-600" />
			</div>
		) : null
	}

	{
		!published ? (
			<div class="flex justify-end border-t border-slate-200 pt-4">
				<Button href={edit.pathname + edit.search} variant="ghost" size="sm">
					Editar preparación
				</Button>
			</div>
		) : null
	}
</div>
<script>
	function initTourActivation() {
		const button = document.querySelector<HTMLButtonElement>("[data-tour-review-activate]")
		if (!button || button.dataset.bound) return
		button.dataset.bound = "true"
		button.addEventListener("click", async () => {
			if (button.disabled) return
			button.disabled = true
			const feedback = document.querySelector<HTMLElement>("[data-tour-activation-feedback]")
			if (feedback) feedback.textContent = "Verificando y activando la oferta…"
			try {
				const response = await fetch("/api/rateplans/activate-guided", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						productId: button.dataset.productId,
						variantId: button.dataset.variantId,
						ratePlanId: button.dataset.ratePlanId,
						playbook:
							new URLSearchParams(window.location.search).get("playbook") === "launch-tour"
								? "launch-tour"
								: "complete-to-publish",
					}),
				})
				const body = await response.json().catch(() => ({}))
				if (!response.ok) {
					if (feedback)
						feedback.textContent = [
							body.error ?? "No se pudo activar la oferta.",
							...(Array.isArray(body.blockers)
								? body.blockers
										.map((item: { message?: string; label?: string }) => item.message ?? item.label)
										.filter(Boolean)
								: []),
						].join(" ")
					return
				}
				window.location.reload()
			} catch {
				if (feedback)
					feedback.textContent =
						"No se pudo confirmar la activación. Comprueba la conexión y vuelve a intentar; se recuperará el estado guardado."
			} finally {
				button.disabled = false
			}
		})
	}
	initTourActivation()
	document.addEventListener("astro:page-load", initTourActivation)
</script>
