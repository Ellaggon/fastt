---
import TabsInsidePanel from "@/components/ui/TabsInsidePanel.astro"
import { routes } from "@/lib/routes"
import { CalendarDays, Link2 } from "@lucide/astro"

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/"
const tabs = [
	{
		label: "Calendario",
		href: routes.calendar(),
		active: pathname === routes.calendar(),
		icon: CalendarDays,
	},
	{
		label: "Conexiones iCal",
		href: routes.ratesCalendarConnections(),
		active: pathname === routes.ratesCalendarConnections(),
		icon: Link2,
	},
]
---

<TabsInsidePanel
	class="calendar-subnav max-w-full flex-nowrap bg-slate-900/60 border-0 backdrop-blur-sm"
	aria-label="Navegación del calendario"
	data-calendar-subnav
>
	{
		tabs.map((tab) => {
			const Icon = tab.icon
			return (
				<a
					href={tab.href}
					aria-current={tab.active ? "page" : undefined}
					data-astro-prefetch="hover"
					data-active={tab.active ? "true" : "false"}
					class={`fastt-tabs-inside-panel__item px-4 py-2 text-sm font-semibold whitespace-nowrap ${
						tab.active ? "" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100"
					}`}
				>
					<Icon class="mr-2 h-4 w-4 shrink-0" aria-hidden="true" />
					{tab.label}
				</a>
			)
		})
	}
</TabsInsidePanel>

<style>
	.calendar-subnav {
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.calendar-subnav::-webkit-scrollbar {
		display: none;
	}
</style>
