---
import { routes } from "@/lib/routes"

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/"
const tabs = [
	{ label: "Calendario", href: routes.calendar(), active: pathname === routes.calendar() },
	{
		label: "Conexiones iCal",
		href: routes.ratesCalendarConnections(),
		active: pathname === routes.ratesCalendarConnections(),
	},
]
---

<nav aria-label="Navegación del calendario" class="overflow-x-auto">
	<div
		class="fastt-notice inline-flex min-w-max rounded-lg border border-slate-700 bg-slate-950 p-1"
		data-calendar-subnav
	>
		{
			tabs.map((tab) => (
				<a
					href={tab.href}
					aria-current={tab.active ? "page" : undefined}
					data-astro-prefetch="viewport"
					class={`inline-flex h-9 items-center justify-center rounded-md px-4 text-sm font-semibold transition ${
						tab.active
							? "bg-white text-slate-950 shadow-sm"
							: "text-slate-300 hover:bg-slate-900 hover:text-white"
					}`}
				>
					{tab.label}
				</a>
			))
		}
	</div>
</nav>
