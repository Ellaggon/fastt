<section
	class="fastt-workspace-panel overflow-hidden border border-slate-200 bg-white p-4 text-slate-900"
	aria-label="Cargando calendario"
	aria-busy="true"
>
	<div class="animate-pulse">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div class="space-y-2">
				<div class="h-3 w-16 rounded-md bg-neutral-200"></div>
				<div class="h-10 w-72 max-w-[75vw] rounded-md bg-neutral-100"></div>
			</div>
			<div class="flex gap-2">
				<div class="h-9 w-24 rounded-md bg-neutral-100"></div>
				<div class="h-9 w-32 rounded-md bg-neutral-100"></div>
			</div>
		</div>
		<div class="fastt-notice mt-4 rounded-lg border border-neutral-200 bg-neutral-50 p-4">
			<div class="h-3 w-24 rounded-md bg-neutral-200"></div>
			<div class="mt-3 grid gap-3 sm:grid-cols-3">
				<div class="fastt-notice h-10 rounded-md border border-neutral-200 bg-white"></div>
				<div class="fastt-notice h-10 rounded-md border border-neutral-200 bg-white"></div>
				<div class="fastt-notice h-10 rounded-md border border-neutral-200 bg-white"></div>
			</div>
		</div>
		<div class="mt-5 flex items-center justify-between border-b border-slate-200 pb-3">
			<div class="h-7 w-36 rounded-md bg-neutral-200"></div>
			<div class="flex gap-2">
				<div class="size-8 rounded-md bg-neutral-100"></div>
				<div class="size-8 rounded-md bg-neutral-100"></div>
			</div>
		</div>
		<div class="mt-3 grid grid-cols-7 gap-1.5 md:gap-2">
			{
				Array.from({ length: 7 }).map(() => (
					<div class="mx-auto h-3 w-5 rounded-md bg-neutral-100 sm:w-10" />
				))
			}
			{
				Array.from({ length: 28 }).map((_, index) => (
					<div class="fastt-notice min-h-20 rounded-md border border-neutral-200 bg-neutral-50 p-2 md:min-h-24">
						<div class="size-4 rounded-md bg-neutral-200" />
						{index % 3 !== 0 && <div class="mt-5 h-2.5 w-3/5 rounded-md bg-neutral-100" />}
					</div>
				))
			}
		</div>
	</div>
	<span class="sr-only">Cargando calendario</span>
</section>
