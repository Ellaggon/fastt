---
import ContextSwitcher from "@/components/ui/ContextSwitcher.astro"
import { routes } from "@/lib/routes"
import type { WorkspaceNavigationScope } from "@/lib/workspace/verticalContext"

interface Props {
	variant?: "surface" | "topbar"
	includeMultiCalendar?: boolean
	workspaceScope?: WorkspaceNavigationScope
}

const { variant = "topbar", includeMultiCalendar = true, workspaceScope } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, "") || "/"

const isTour = workspaceScope?.vertical
	? workspaceScope.vertical === "tour"
	: Astro.url.searchParams.get("scope") === "tour"
const contextHref = (path: string) => {
	const params = new URLSearchParams()
	for (const key of ["scope", "productId", "variantId", "ratePlanId", "checkIn", "checkOut"]) {
		const value = Astro.url.searchParams.get(key)
		if (value) params.set(key, value)
	}
	if (workspaceScope?.vertical) params.set("scope", workspaceScope.vertical)
	if (workspaceScope?.productId) params.set("productId", workspaceScope.productId)
	return params.size ? `${path}?${params}` : path
}
const options = [
	{
		id: "calendar",
		label: isTour ? "Salidas y cupos" : "Calendario",
		href: contextHref(routes.calendar()),
	},
	{
		id: "rates",
		label: isTour ? "Precios y condiciones" : "Tarifas",
		href: contextHref(routes.rates()),
	},
	{ id: "ical", label: "Conexiones iCal", href: contextHref(routes.ratesCalendarConnections()) },
	...(includeMultiCalendar
		? [{ id: "multi", label: "Multicalendario", href: contextHref(routes.ratesMultiCalendar()) }]
		: []),
]

const selectedId = path.startsWith("/rates/calendar/connections")
	? "ical"
	: path.startsWith("/rates/multi-calendar")
		? "multi"
		: path.startsWith("/rates/plans")
			? "rates"
			: path.startsWith("/rates/calendar")
				? "calendar"
				: path.startsWith("/rates/")
					? "rates"
					: "calendar"

const selected = options.find((option) => option.id === selectedId) ?? options[0]
---

<ContextSwitcher
	label="Venta"
	value={selected.label}
	options={options}
	selectedId={selected.id}
	icon="sales"
	menuLabel="Cambiar superficie de venta"
	emptyMessage="No hay otras superficies de venta."
	ariaLabel="Cambiar superficie de venta"
	variant={variant}
/>
