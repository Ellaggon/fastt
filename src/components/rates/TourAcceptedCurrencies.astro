---
const currencies = [
	{ code: "BOB", label: "Bolivianos (BOB)", checked: true },
	{ code: "USD", label: "Dólares (USD)", checked: false },
]
---

<fieldset class="space-y-3 md:col-span-2" data-accepted-currencies>
	<legend class="text-sm font-medium text-slate-800">Monedas que aceptas</legend>
	<p class="text-sm leading-6 text-slate-500">
		Puedes cobrar en bolivianos, en dólares o en ambos. Cada moneda tiene su propio precio por
		participante.
	</p>
	<div class="grid gap-3 sm:grid-cols-2">
		{
			currencies.map((currency) => (
				<label class="fastt-soft-box block space-y-3 border border-slate-200 bg-white p-3 text-sm">
					<span class="flex items-center gap-2 font-medium text-slate-900">
						<input
							type="checkbox"
							name={`accept${currency.code}`}
							value={currency.code}
							class="fastt-field size-4"
							checked={currency.checked}
							data-currency-toggle
						/>
						{currency.label}
					</span>
					<input
						name={`price${currency.code}`}
						type="number"
						min="1"
						step="0.01"
						placeholder="Precio"
						aria-label={`Precio por participante en ${currency.code}`}
						data-currency-price={currency.code}
						disabled={!currency.checked}
						required={currency.checked}
						class="fastt-field h-11 w-full px-3 text-sm text-slate-900 disabled:bg-slate-50 disabled:text-slate-400"
					/>
				</label>
			))
		}
	</div>
</fieldset>

<script>
	const bindAcceptedCurrencies = () => {
		document.querySelectorAll("[data-accepted-currencies]").forEach((root) => {
			if (!(root instanceof HTMLElement) || root.dataset.bound === "true") return
			root.dataset.bound = "true"
			const sync = () => {
				root.querySelectorAll("[data-currency-toggle]").forEach((node) => {
					if (!(node instanceof HTMLInputElement)) return
					const price = root.querySelector(`[data-currency-price="${node.value}"]`)
					if (!(price instanceof HTMLInputElement)) return
					price.disabled = !node.checked
					price.required = node.checked
				})
			}
			root.addEventListener("change", sync)
			sync()
		})
	}

	bindAcceptedCurrencies()
	document.addEventListener("astro:page-load", bindAcceptedCurrencies)
</script>
