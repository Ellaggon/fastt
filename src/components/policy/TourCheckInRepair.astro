---
import Button from "@/components/ui/Button.astro"
import Dialog from "@/components/ui/Dialog.astro"

interface Props {
	ratePlanId: string
}
const { ratePlanId } = Astro.props
---

<div data-tour-checkin-repair data-rate-plan-id={ratePlanId}>
	<p class="mt-2">
		Retira la condición hotelera de llegada que no corresponde a este tour. El alcance se muestra
		antes de confirmar.
	</p>
	<Button
		type="button"
		variant="ghost"
		className="mt-2 h-auto px-0 underline underline-offset-4"
		data-repair-open>Revisar condición heredada</Button
	>
	<Dialog
		class="w-[min(92vw,36rem)] p-6 shadow-xl backdrop:bg-black/50"
		aria-labelledby={`repair-title-${ratePlanId}`}
		data-tour-checkin-repair-dialog
	>
		<h2 id={`repair-title-${ratePlanId}`} class="text-xl font-semibold" tabindex="-1">
			Retirar llegada de alojamiento
		</h2>
		<p class="mt-2 text-sm text-slate-600">
			Sólo se desactiva la asignación elegida. Las políticas y condiciones guardadas en reservas
			anteriores se conservan. El tour permanece bloqueado si hay otros pendientes.
		</p>
		<div class="mt-4 space-y-3" data-repair-list></div>
		<p class="mt-3 text-sm" role="status" aria-live="polite" data-repair-status></p>
		<Button type="button" variant="secondary" className="mt-5" data-repair-close>Cerrar</Button>
		<a class="ml-3 text-sm underline" href="/provider/support?line=tour"
			>Solicitar revisión a Fastt</a
		>
	</Dialog>
</div>
<script>
	function recoveryMessage(error: unknown, fallback: string) {
		return error instanceof Error &&
			!(error instanceof TypeError) &&
			!(error instanceof SyntaxError)
			? error.message
			: fallback
	}
	function initializeRepairs() {
		document.querySelectorAll<HTMLElement>("[data-tour-checkin-repair]").forEach((root) => {
			if (root.dataset.initialized) return
			root.dataset.initialized = "true"
			const dialog = root.querySelector<HTMLDialogElement>("[data-tour-checkin-repair-dialog]")!
			const open = root.querySelector<HTMLButtonElement>("[data-repair-open]")!
			const close = root.querySelector<HTMLButtonElement>("[data-repair-close]")!
			const list = root.querySelector<HTMLElement>("[data-repair-list]")!
			const status = root.querySelector<HTMLElement>("[data-repair-status]")!
			let saving = false
			let lookup: AbortController | null = null
			const endpoint = "/api/policies/repair-tour-checkin"
			const ratePlanId = root.dataset.ratePlanId!
			const labels: Record<string, string> = {
				product: "Todo este tour y sus opciones y tarifas",
				variant: "Esta opción y todas sus tarifas",
				rate_plan: "Sólo esta tarifa",
			}
			close.addEventListener("click", () => dialog.close())
			dialog.addEventListener("close", () => {
				lookup?.abort()
				lookup = null
				open.disabled = false
				open.focus()
			})
			dialog.addEventListener("cancel", (event) => {
				if (saving) event.preventDefault()
			})
			open.addEventListener("click", async () => {
				const request = new AbortController()
				lookup = request
				open.disabled = true
				dialog.showModal()
				dialog.querySelector<HTMLElement>("h2")!.focus()
				list.replaceChildren()
				status.textContent = "Consultando asignaciones…"
				try {
					const response = await fetch(`${endpoint}?${new URLSearchParams({ ratePlanId })}`, {
						credentials: "same-origin",
						cache: "no-store",
						signal: request.signal,
					})
					if (response.status === 401)
						throw new Error("Tu sesión venció. Inicia sesión y retoma esta tarifa.")
					const body = await response.json()
					if (request.signal.aborted) return
					if (!response.ok)
						throw new Error(
							body.message || "No pudimos consultar las asignaciones. Cierra y vuelve a intentar."
						)
					status.textContent = body.assignments.length
						? ""
						: "No hay asignaciones que puedas retirar en esta oferta. Si el bloqueo persiste, solicita revisión a Fastt."
					for (const assignment of body.assignments) {
						const card = document.createElement("div")
						card.className = "fastt-notice rounded-[var(--fastt-radius-card)] border p-4 text-sm"
						const scope = document.createElement("p")
						scope.className = "font-medium"
						scope.textContent = labels[assignment.scope] ?? "Alcance desconocido"
						const meta = document.createElement("p")
						meta.className = "mt-1 text-sm text-slate-600"
						meta.textContent = `Canal: ${assignment.channel ?? "Todos"}. Vigencia: ${assignment.effectiveFrom ?? "Sin inicio"} — ${assignment.effectiveTo ?? "Sin fin"}.`
						const button = document.createElement("button")
						button.type = "button"
						button.className =
							"fastt-button mt-3 inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2 text-white"
						button.textContent = "Confirmar retiro en este alcance"
						button.addEventListener("click", async () => {
							if (saving) return
							saving = true
							root
								.querySelectorAll<HTMLButtonElement>("dialog button")
								.forEach((b) => (b.disabled = true))
							status.textContent = "Guardando retiro…"
							try {
								const saved = await fetch(endpoint, {
									method: "POST",
									credentials: "same-origin",
									headers: { "Content-Type": "application/json" },
									body: JSON.stringify({ ratePlanId, assignmentId: assignment.id, confirm: true }),
								})
								if (saved.status === 401)
									throw new Error("Tu sesión venció. Inicia sesión y retoma esta tarifa.")
								const payload = await saved.json()
								if (!saved.ok)
									throw new Error(
										payload.message ||
											"No pudimos verificar el resultado. Actualiza antes de reintentar."
									)
								status.textContent = payload.message
								window.location.reload()
							} catch (error) {
								status.textContent = recoveryMessage(
									error,
									"Se perdió la respuesta. Actualiza para comprobar el estado guardado; reintentar no duplica el retiro."
								)
								saving = false
								root
									.querySelectorAll<HTMLButtonElement>("dialog button")
									.forEach((b) => (b.disabled = false))
							}
						})
						card.append(scope, meta, button)
						list.append(card)
					}
				} catch (error) {
					if (request.signal.aborted) return
					status.textContent = recoveryMessage(
						error,
						"No pudimos cargar la revisión. Cierra y vuelve a intentar."
					)
				} finally {
					if (lookup === request) {
						lookup = null
						open.disabled = false
					}
				}
			})
		})
	}
	initializeRepairs()
	document.addEventListener("astro:page-load", initializeRepairs)
</script>
