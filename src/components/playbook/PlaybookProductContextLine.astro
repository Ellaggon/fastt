---
import { Compass, Hotel, Ticket } from "@lucide/astro"

interface Props {
	productName: string
	variantName?: string | null
	isTour?: boolean
	tourIcon?: "ticket" | "compass"
	class?: string
}

const {
	productName,
	variantName = "",
	isTour = true,
	tourIcon = "compass",
	class: className = "",
} = Astro.props
const TourIcon = tourIcon === "compass" ? Compass : Ticket
const trimmedProductName = productName.trim()
const trimmedVariantName = variantName?.trim() ?? ""
const hotelLabel = trimmedVariantName
	? `${trimmedProductName} · ${trimmedVariantName}`
	: trimmedProductName
---

{
	isTour && trimmedProductName ? (
		<div class:list={["min-w-0 space-y-1", className]}>
			<p class="flex min-w-0 items-center gap-2.5 text-lg font-semibold text-white sm:text-xl">
				<TourIcon class="h-5 w-5 shrink-0 text-slate-300" aria-hidden="true" />
				<span class="truncate">{trimmedProductName}</span>
			</p>
			{trimmedVariantName ? (
				<p class="pl-[1.875rem] text-base font-semibold text-slate-200 sm:text-lg">
					{trimmedVariantName}
				</p>
			) : null}
		</div>
	) : hotelLabel ? (
		<p
			class:list={[
				"flex min-w-0 items-center gap-2.5",
				"text-xs font-semibold tracking-wide text-slate-400 uppercase",
				className,
			]}
		>
			<Hotel class="h-4 w-4 shrink-0" aria-hidden="true" />
			{hotelLabel}
		</p>
	) : null
}
