---
import { ArrowLeft, MapPin } from "@lucide/astro"

import PublicListingImage from "@/components/marketplace/PublicListingImage.astro"
import HotelSearchPanel from "@/components/searchPanel/HotelSearchPanel.astro"
import TourSearchPanel from "@/components/searchPanel/TourSearchPanel.astro"
import UILayout from "@/layouts/UILayout.astro"
import type {
	PublicDestination,
	PublicDestinationListing,
} from "@/lib/marketplace/publicDestinationListings"
import {
	publicDestinationHref,
	type PublicMarketplaceVertical,
} from "@/lib/marketplace/publicDestinationRoutes"

interface Props {
	vertical: PublicMarketplaceVertical
	destination: PublicDestination | null
	listings: PublicDestinationListing[]
	searchParams: URLSearchParams
}

const { vertical, destination, listings, searchParams } = Astro.props as Props
const isHotels = vertical === "alojamientos"
const verticalLabel = isHotels ? "Alojamientos" : "Tours"
const searchLabel = destination
	? `${verticalLabel} en ${destination.name}`
	: `Buscar ${verticalLabel.toLowerCase()}`
const canonicalPath = destination
	? publicDestinationHref(destination.slug, vertical)
	: `/buscar/${vertical}`
const description = destination
	? (destination.seoDescription ??
		`Explora ${verticalLabel.toLowerCase()} en ${destination.name} con información clara antes de reservar.`)
	: `Busca ${verticalLabel.toLowerCase()} para tu viaje por Bolivia.`
const listingHref = (listing: PublicDestinationListing) => {
	const params = new URLSearchParams(searchParams)
	params.delete("destino")
	return `${isHotels ? "/hotels" : "/tours"}/${listing.id}${params.size ? `?${params}` : ""}`
}
const structuredData = destination
	? {
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": searchLabel,
			"url": new URL(canonicalPath, Astro.url.origin).href,
			"itemListElement": listings.map((listing, index) => ({
				"@type": "ListItem",
				"position": index + 1,
				"url": new URL(listingHref(listing), Astro.url.origin).href,
				"name": listing.name,
			})),
		}
	: undefined
---

<UILayout
	title={destination?.seoTitle ?? searchLabel}
	description={description}
	canonicalPath={canonicalPath}
	structuredData={structuredData}
>
	<div class="min-h-screen bg-slate-50 text-slate-950">
		<header class="border-b border-slate-200 bg-white">
			<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
				<a
					href={isHotels ? "/hotels" : "/tours"}
					class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-950"
				>
					<ArrowLeft class="h-4 w-4" aria-hidden="true" />
					{isHotels ? "Ver alojamientos" : "Ver tours"}
				</a>
				<div
					class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(34rem,1.2fr)] lg:items-end"
				>
					<div>
						<p class="text-sm font-semibold text-slate-500">Resultados</p>
						<h1 class="mt-1 text-3xl font-semibold text-slate-950 sm:text-4xl">{searchLabel}</h1>
						{
							destination ? (
								<p class="mt-3 max-w-xl text-base leading-7 text-slate-600">
									{destination.description}
								</p>
							) : (
								<p class="mt-3 text-base text-slate-600">
									Elige un destino para afinar los resultados.
								</p>
							)
						}
					</div>
					<div>{isHotels ? <HotelSearchPanel /> : <TourSearchPanel />}</div>
				</div>
			</div>
		</header>

		<main id="content" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
			<div class="flex items-center justify-between border-b border-slate-200 pb-4">
				<p class="text-sm font-medium text-slate-700">
					{listings.length}
					{listings.length === 1 ? "opción encontrada" : "opciones encontradas"}
				</p>
				{
					destination ? (
						<a
							href={publicDestinationHref(destination.slug, vertical)}
							class="text-sm font-medium text-slate-700 hover:text-slate-950 hover:underline"
						>
							Ver destino
						</a>
					) : null
				}
			</div>

			{
				listings.length ? (
					<div class="divide-y divide-slate-200">
						{listings.map((listing) => (
							<article class="grid gap-5 py-6 sm:grid-cols-[13rem_minmax(0,1fr)]">
								<a
									href={listingHref(listing)}
									class="relative aspect-[4/3] overflow-hidden bg-slate-200"
								>
									<PublicListingImage
										src={listing.imageUrl}
										alt={listing.name}
										class="absolute inset-0"
									/>
								</a>
								<div class="flex min-w-0 flex-col justify-between gap-4 py-1">
									<div>
										<h2 class="text-xl font-semibold text-slate-950">
											<a href={listingHref(listing)} class="hover:underline">
												{listing.name}
											</a>
										</h2>
										{listing.address ? (
											<p class="mt-2 flex items-center gap-2 text-sm text-slate-600">
												<MapPin class="h-4 w-4 shrink-0" aria-hidden="true" />
												{listing.address}
											</p>
										) : null}
										{!isHotels && (listing.duration || listing.difficultyLevel) ? (
											<p class="mt-2 text-sm text-slate-600">
												{[listing.duration, listing.difficultyLevel].filter(Boolean).join(" · ")}
											</p>
										) : null}
										{listing.description ? (
											<p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-600">
												{listing.description}
											</p>
										) : null}
									</div>
									<a
										href={listingHref(listing)}
										class="text-sm font-semibold text-slate-950 hover:underline"
									>
										Ver detalle
									</a>
								</div>
							</article>
						))}
					</div>
				) : (
					<section class="py-16 text-center">
						<h2 class="text-lg font-semibold text-slate-950">
							Aún no hay opciones para estos filtros
						</h2>
						<p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-600">
							Prueba otro destino, cambia las fechas o vuelve a la exploración general.
						</p>
						<a
							href={isHotels ? "/hotels" : "/tours"}
							class="mt-5 inline-flex text-sm font-semibold text-slate-950 underline underline-offset-4"
						>
							Explorar {verticalLabel.toLowerCase()}
						</a>
					</section>
				)
			}
		</main>
	</div>
</UILayout>
