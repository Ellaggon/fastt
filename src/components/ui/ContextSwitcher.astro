---
import {
	Building2,
	CalendarDays,
	ChevronDown,
	Hotel,
	LayoutDashboard,
	Layers3,
	MapPinned,
} from "@lucide/astro"

export interface ContextSwitcherOption {
	id: string
	label: string
	href: string
	nested?: boolean
	meta?: string
}

export interface ContextSwitcherGroup {
	heading?: string
	options: ContextSwitcherOption[]
}

interface Props {
	label: string
	value: string
	options?: ContextSwitcherOption[]
	groups?: ContextSwitcherGroup[]
	selectedId?: string
	icon?: "accommodation" | "tour" | "service" | "dashboard" | "sales" | "rates"
	menuLabel?: string
	emptyMessage?: string
	ariaLabel?: string
	variant?: "surface" | "topbar"
}

const {
	label,
	value,
	options = [],
	groups,
	selectedId,
	icon = "service",
	menuLabel = "Cambiar selección",
	emptyMessage = "No hay otras opciones disponibles.",
	ariaLabel = `Cambiar ${label.toLowerCase()} actual`,
	variant = "surface",
} = Astro.props
const Icon =
	icon === "accommodation"
		? Hotel
		: icon === "tour"
			? MapPinned
			: icon === "dashboard"
				? LayoutDashboard
				: icon === "sales"
					? CalendarDays
					: icon === "rates"
						? Layers3
						: Building2
const resolvedGroups: ContextSwitcherGroup[] = groups && groups.length > 0 ? groups : [{ options }]
const flatOptions = resolvedGroups.flatMap((group) => group.options)
const selectable = flatOptions.length > 0
const staticValue = String(value ?? "").trim()
const titleOnly = !selectable && !staticValue
---

<div
	class:list={[
		"fastt-context-switcher",
		variant === "topbar" && "fastt-context-switcher--topbar",
		titleOnly && "fastt-context-switcher--title-only",
		!selectable && staticValue && "fastt-context-switcher--static",
	]}
>
	<span class="fastt-context-switcher__label"
		><Icon class="h-4 w-4 shrink-0" aria-hidden="true" /><span
			class="fastt-context-switcher__label-text">{label}</span
		></span
	>
	{
		selectable ? (
			<details class="fastt-context-switcher__select" data-context-switcher>
				<summary class="fastt-context-switcher__trigger" aria-label={ariaLabel}>
					<ChevronDown
						class="fastt-context-switcher__chevron h-4 w-4 shrink-0"
						aria-hidden="true"
					/>
					<span class="fastt-context-switcher__spinner" aria-hidden="true" />
					<span
						class="fastt-context-switcher__value truncate text-xs font-semibold tracking-wide uppercase"
						data-context-switcher-value
					>
						{value}
					</span>
				</summary>
				<div class="fastt-context-switcher__menu">
					<p class="px-2 pb-2 text-xs font-semibold tracking-wide text-slate-400 uppercase">
						{menuLabel}
					</p>
					<div class="space-y-3">
						{resolvedGroups.map((group) =>
							group.options.length ? (
								<div class="space-y-1" data-context-switcher-group={group.heading || undefined}>
									{group.heading ? (
										<p class="fastt-context-switcher__group">{group.heading}</p>
									) : null}
									{group.options.map((option) => {
										const active = option.id === selectedId
										return (
											<a
												href={option.href}
												data-workspace-nav
												data-context-switcher-option
												data-option-label={option.label}
												data-astro-prefetch="viewport"
												aria-current={active ? "page" : undefined}
												class:list={[
													"fastt-context-switcher__option",
													option.nested && "fastt-context-switcher__option--nested",
													active && "fastt-context-switcher__option--active",
												]}
											>
												<span class="min-w-0">
													<span class="block truncate">{option.label}</span>
													{option.meta ? (
														<span class="mt-0.5 block truncate text-[0.6875rem] font-medium text-slate-400">
															{option.meta}
														</span>
													) : null}
												</span>
												{active ? (
													<span class="fastt-context-switcher__current">Actual</span>
												) : null}
											</a>
										)
									})}
								</div>
							) : null
						)}
						{flatOptions.length > 0 && flatOptions.every((option) => option.id === selectedId) ? (
							<p class="px-2 py-2 text-xs leading-5 text-slate-500">{emptyMessage}</p>
						) : null}
					</div>
				</div>
			</details>
		) : staticValue ? (
			<p class="fastt-context-switcher__static">{staticValue}</p>
		) : null
	}
</div>

<style is:global>
	.fastt-context-switcher {
		display: flex;
		max-width: 100%;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem;
	}
	.fastt-context-switcher__label {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: rgb(148 163 184);
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.02em;
		line-height: 1;
		text-transform: uppercase;
	}
	.fastt-context-switcher__select {
		position: relative;
		max-width: min(100%, 24rem);
	}
	.fastt-context-switcher__trigger {
		display: inline-flex;
		min-height: 2.125rem;
		max-width: min(100vw - 2rem, 24rem);
		align-items: center;
		gap: 0.45rem;
		cursor: pointer;
		list-style: none;
		border: 1px solid #000;
		border-radius: var(--fastt-radius-pill);
		background: #000;
		padding: 0.38rem 0.6rem 0.38rem 0.38rem;
		color: rgb(241 245 249);
		font-size: 0.875rem;
		font-weight: 650;
		line-height: 1;
		transition: background-color var(--fastt-motion-standard) ease;
	}
	.fastt-context-switcher__trigger::-webkit-details-marker {
		display: none;
	}
	.fastt-context-switcher__trigger:hover,
	.fastt-context-switcher__select[open] > .fastt-context-switcher__trigger {
		background: rgb(15 23 42);
	}
	.fastt-context-switcher__trigger:focus-visible {
		outline: 2px solid rgb(255 255 255 / 0.92);
		outline-offset: 2px;
	}
	.fastt-context-switcher__chevron {
		transition: transform var(--fastt-motion-standard) ease;
	}
	.fastt-context-switcher__select[open] .fastt-context-switcher__chevron {
		transform: rotate(180deg);
	}
	.fastt-context-switcher__spinner {
		display: none;
		width: 0.875rem;
		height: 0.875rem;
		flex-shrink: 0;
		border: 2px solid rgb(148 163 184 / 0.28);
		border-top-color: rgb(241 245 249);
		border-radius: 9999px;
		animation: fastt-context-switcher-spin 650ms linear infinite;
	}
	.fastt-context-switcher[data-context-switcher-pending] .fastt-context-switcher__select {
		pointer-events: none;
	}
	.fastt-context-switcher[data-context-switcher-pending] .fastt-context-switcher__chevron {
		display: none;
	}
	.fastt-context-switcher[data-context-switcher-pending] .fastt-context-switcher__spinner {
		display: inline-block;
	}
	.fastt-context-switcher[data-context-switcher-pending] .fastt-context-switcher__value {
		opacity: 0.78;
	}
	.fastt-context-switcher__option[data-context-switcher-option-pending] {
		position: relative;
		pointer-events: none;
		background: rgb(241 245 249);
		color: rgb(15 23 42);
	}
	.fastt-context-switcher__option[data-context-switcher-option-pending]::after {
		position: absolute;
		inset: 0.65rem 0.7rem auto auto;
		width: 0.875rem;
		height: 0.875rem;
		content: "";
		border: 2px solid rgb(203 213 225);
		border-top-color: rgb(51 65 85);
		border-radius: 9999px;
		animation: fastt-context-switcher-spin 650ms linear infinite;
	}
	.fastt-context-switcher__static {
		margin: 0;
		color: rgb(241 245 249);
		font-size: 0.875rem;
		font-weight: 650;
		line-height: 1;
	}
	.fastt-context-switcher--topbar .fastt-context-switcher__static {
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.fastt-context-switcher--topbar.fastt-context-switcher--static
		.fastt-context-switcher__label::after {
		content: "·";
		color: rgb(100 116 139);
	}
	.fastt-context-switcher__menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		z-index: 50;
		width: min(22rem, calc(100vw - 2rem));
		border: 1px solid rgb(226 232 240 / 0.9);
		border-radius: 1.1rem;
		background: rgb(255 255 255 / 0.98);
		padding: 0.65rem;
		box-shadow: 0 22px 55px rgb(15 23 42 / 0.16);
		backdrop-filter: blur(18px);
	}
	.fastt-context-switcher__option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border-radius: 0.8rem;
		padding: 0.65rem 0.7rem;
		color: rgb(71 85 105);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}
	.fastt-context-switcher__option:hover {
		background: rgb(248 250 252);
		color: rgb(15 23 42);
	}
	.fastt-context-switcher__option--active {
		background: rgb(241 245 249);
		color: rgb(15 23 42);
	}
	.fastt-context-switcher__group {
		margin: 0;
		padding: 0.35rem 0.7rem 0.15rem;
		color: rgb(148 163 184);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}
	.fastt-context-switcher__option--nested {
		padding-left: 1.35rem;
		font-size: 0.8125rem;
		font-weight: 550;
	}
	.fastt-context-switcher__current {
		border-radius: var(--fastt-radius-pill);
		background: rgb(15 23 42 / 0.08);
		padding: 0.16rem 0.45rem;
		font-size: 0.6875rem;
		font-weight: 700;
		color: rgb(51 65 85);
	}
	.fastt-context-switcher--topbar {
		min-height: 2.125rem;
		flex-wrap: nowrap;
		gap: 0.5rem;
	}
	.fastt-context-switcher--topbar .fastt-context-switcher__select {
		display: inline-block;
		max-width: min(100%, 18rem);
		vertical-align: middle;
	}
	.fastt-context-switcher--topbar .fastt-context-switcher__trigger {
		max-width: 100%;
		gap: 0.35rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		padding: 0;
	}
	.fastt-context-switcher--topbar .fastt-context-switcher__trigger:hover,
	.fastt-context-switcher--topbar
		.fastt-context-switcher__select[open]
		> .fastt-context-switcher__trigger {
		background: transparent;
	}
	@media (max-width: 1023px) {
		.fastt-context-switcher__trigger {
			max-width: min(100%, 18rem);
		}
		.fastt-context-switcher--topbar {
			min-width: 0;
			width: 100%;
			max-width: 100%;
			justify-content: center;
			gap: 0.35rem;
		}
		.fastt-context-switcher--topbar .fastt-context-switcher__label-text {
			display: none;
		}
		.fastt-context-switcher--topbar.fastt-context-switcher--static
			.fastt-context-switcher__label-text {
			display: inline;
		}
		.fastt-context-switcher--topbar.fastt-context-switcher--title-only
			.fastt-context-switcher__label-text {
			display: inline;
		}
		.fastt-context-switcher--topbar .fastt-context-switcher__select {
			min-width: 0;
			max-width: min(100%, 14rem);
		}
		.fastt-context-switcher--topbar .fastt-context-switcher__menu {
			left: 50%;
			width: min(22rem, calc(100vw - 2rem));
			transform: translateX(-50%);
		}
	}
	@keyframes fastt-context-switcher-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fastt-context-switcher__spinner,
		.fastt-context-switcher__option[data-context-switcher-option-pending]::after {
			animation: none;
		}
	}
</style>

<script is:inline>
	;(function () {
		if (window.__fasttContextSwitcherNavInstalled) return
		window.__fasttContextSwitcherNavInstalled = true

		const closeSwitchers = (except) =>
			document.querySelectorAll("[data-context-switcher]").forEach((item) => {
				if (item !== except) item.removeAttribute("open")
			})

		const clearSwitcherPending = () => {
			document.querySelectorAll("[data-context-switcher-pending]").forEach((item) => {
				item.removeAttribute("data-context-switcher-pending")
			})
			document.querySelectorAll("[data-context-switcher-option-pending]").forEach((item) => {
				item.removeAttribute("data-context-switcher-option-pending")
			})
		}

		const setSwitcherPending = (switcherRoot, option, label) => {
			const details = switcherRoot.querySelector("[data-context-switcher]")
			if (details) details.removeAttribute("open")
			switcherRoot.setAttribute("data-context-switcher-pending", "true")
			document
				.querySelectorAll("[data-context-switcher-option-pending]")
				.forEach((item) => item.removeAttribute("data-context-switcher-option-pending"))
			option.setAttribute("data-context-switcher-option-pending", "true")
			const valueEl = switcherRoot.querySelector("[data-context-switcher-value]")
			if (valueEl && label) valueEl.textContent = label
		}

		document.addEventListener(
			"click",
			(event) => {
				const target = event.target
				const option =
					target instanceof Element
						? target.closest("[data-context-switcher] [data-context-switcher-option]")
						: null
				if (!(option instanceof HTMLAnchorElement)) return

				const details = option.closest("[data-context-switcher]")
				if (details) details.removeAttribute("open")

				if (option.getAttribute("aria-current") === "page") {
					event.preventDefault()
					return
				}

				const switcherRoot = option.closest(".fastt-context-switcher")
				if (!switcherRoot) return
				const label = option.dataset.optionLabel || option.textContent?.trim() || ""
				setSwitcherPending(switcherRoot, option, label)
			},
			true
		)

		document.addEventListener("click", (event) => {
			const target = event.target
			const path = typeof event.composedPath === "function" ? event.composedPath() : []
			const switcher =
				(target instanceof Element ? target.closest("[data-context-switcher]") : null) ??
				path.find((node) => node instanceof Element && node.matches("[data-context-switcher]"))
			if (switcher instanceof Element) {
				closeSwitchers(switcher)
				return
			}
			closeSwitchers()
		})
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeSwitchers()
		})
		document.addEventListener("astro:page-load", clearSwitcherPending)
		document.addEventListener("astro:after-swap", clearSwitcherPending)
	})()
</script>
