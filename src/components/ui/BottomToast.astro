---
import { CircleAlert, CircleCheck, CircleX, TriangleAlert, X } from "@lucide/astro"

type BottomToastVariant = "success" | "info" | "warning" | "error"

interface Props {
	message?: string
	variant?: BottomToastVariant
	autoDismissMs?: number
	clearQueryParam?: string
	className?: string
}

const {
	message,
	variant = "success",
	autoDismissMs = 6_000,
	clearQueryParam,
	className = "",
} = Astro.props

const icons = {
	success: CircleCheck,
	info: CircleAlert,
	warning: TriangleAlert,
	error: CircleX,
} as const

const iconClass = {
	success: "text-emerald-400/90",
	info: "text-sky-400/90",
	warning: "text-amber-400/90",
	error: "text-rose-400/90",
} as const

const resolvedVariant = icons[variant] ? variant : "success"
const Icon = icons[resolvedVariant]
const finalClass = ["fastt-bottom-toast-host", className].filter(Boolean).join(" ")
---

<div
	class={`fastt-bottom-toast pointer-events-none fixed inset-x-0 bottom-0 z-50 flex justify-center px-4 pb-4 sm:pb-6 ${finalClass}`}
	data-bottom-toast
	data-bottom-toast-auto-dismiss={String(autoDismissMs)}
	data-bottom-toast-clear-param={clearQueryParam ?? undefined}
	role={resolvedVariant === "error" ? "alert" : "status"}
	aria-live={resolvedVariant === "error" ? "assertive" : "polite"}
>
	<div
		class="pointer-events-auto flex w-full max-w-xl items-start gap-3 rounded-2xl border border-white/10 bg-black/95 px-4 py-3 text-sm leading-6 text-neutral-200 shadow-[0_20px_60px_rgba(0,0,0,0.45)] backdrop-blur-sm"
	>
		<Icon class={`mt-0.5 size-4 shrink-0 ${iconClass[resolvedVariant]}`} aria-hidden="true" />
		<div class="min-w-0 flex-1">
			{message ? <p>{message}</p> : <slot />}
		</div>
		<button
			type="button"
			class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg text-neutral-500 transition hover:bg-white/10 hover:text-neutral-200"
			data-bottom-toast-dismiss
			aria-label="Cerrar aviso"
		>
			<X class="size-4" aria-hidden="true" />
		</button>
	</div>
</div>

<style>
	.fastt-bottom-toast {
		animation: fastt-bottom-toast-in 220ms ease-out;
	}

	.fastt-bottom-toast[data-dismissed="true"] {
		animation: fastt-bottom-toast-out 180ms ease-in forwards;
	}

	@keyframes fastt-bottom-toast-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fastt-bottom-toast-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}

		to {
			opacity: 0;
			transform: translateY(10px);
		}
	}
</style>

<script>
	import { installBottomToastController } from "@/lib/ui/bottomToastClient"

	installBottomToastController()
</script>
