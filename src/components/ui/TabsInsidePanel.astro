---
const { className = "", class: classProp = "", ...props } = Astro.props
const finalClass =
	`fastt-tabs-inside-panel flex w-full max-w-full items-center gap-1 overflow-x-auto border-b border-slate-800 text-sm font-semibold text-slate-300 ${className} ${classProp}`.trim()
---

<nav class={finalClass} data-fastt-tab-standard="workspace" {...props}>
	<slot />
</nav>
