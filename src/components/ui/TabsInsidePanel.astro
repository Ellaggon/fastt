---
const { className = "", class: classProp = "", ...props } = Astro.props
const finalClass =
	`fastt-tabs-inside-panel inline-flex items-center gap-1 overflow-x-auto rounded-[20px] border-0 bg-slate-900/60 p-1 text-sm font-semibold text-slate-300 ring-1 ring-slate-800 backdrop-blur-sm ${className} ${classProp}`.trim()
---

<nav class={finalClass} data-fastt-tab-standard="workspace" {...props}>
	<slot />
</nav>
