---
import Button from "@/components/ui/Button.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"

interface Props {
	ratePlanId: string
	initialCurrency: string
	initialBasePrice: string
	guidedContinueHref?: string | null
	guidedExitHref?: string | null
	backHref?: string
	offeringType?: "accommodation" | "tour"
}

const {
	ratePlanId,
	initialCurrency,
	initialBasePrice,
	guidedContinueHref,
	guidedExitHref,
	backHref = "/rates/plans/manage",
	offeringType = "accommodation",
} = Astro.props
const isTour = offeringType === "tour"
---

<form
	id="pricingForm"
	class="mx-auto max-w-3xl space-y-6"
	data-guided-continue={guidedContinueHref}
	data-guided-exit={guidedExitHref}
>
	<Input type="hidden" name="ratePlanId" value={ratePlanId} />
	<div class="space-y-5">
		<div>
			<h2 class="text-lg font-semibold text-slate-950">Precio base</h2>
			<p class="mt-1 text-sm leading-6 text-slate-500">
				{
					isTour
						? "Es el precio de referencia por participante. Los ajustes por fecha se hacen desde el calendario."
						: "Es el precio de referencia por noche. Los ajustes por fecha se hacen desde el calendario."
				}
			</p>
		</div>
		<div class="grid gap-5 sm:grid-cols-[12rem_minmax(0,1fr)]">
			<FormField
				label="Moneda"
				htmlFor="currency"
				description={isTour
					? "Esta tarifa se cobra en una moneda. Si también aceptas otra, crea una tarifa adicional con su precio."
					: "Se aplica a esta tarifa."}
				required
			>
				<Select id="currency" name="currency" value={initialCurrency} required>
					<option value="USD">USD</option>
					<option value="BOB">BOB</option>
				</Select>
			</FormField>
			<FormField
				label={isTour ? "Precio por participante" : "Precio base por noche"}
				htmlFor="basePrice"
				description="Antes de impuestos, promociones o cambios por fecha."
				required
			>
				<Input
					id="basePrice"
					name="basePrice"
					type="number"
					min="0"
					step="1"
					value={initialBasePrice}
					required
				/>
			</FormField>
		</div>
	</div>
	<p id="pricingFeedback" role="status" class="whitespace-pre-wrap text-sm text-slate-600"></p>
	{
		!guidedContinueHref ? (
			<div class="flex flex-wrap items-center justify-between gap-3 pt-2">
				<Button href={backHref} variant="ghost">
					{" "}
					Volver a tarifas{" "}
				</Button>
				<Button id="submitBtn" type="submit" variant="selection" className="fastt-playbook-cta">
					Guardar precio base
				</Button>
			</div>
		) : null
	}
</form>

<script>
	import { setPlaybookSubmitBusy } from "@/lib/forms/playbookFormBusy"
	import { bindPlaybookFormDraft } from "@/lib/forms/playbookFormDraft"
	import { persistOptionDestination } from "@/lib/forms/tourOptionNavigation"
	function initPricingForm() {
		const form = document.getElementById("pricingForm")
		if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") return
		form.dataset.bound = "true"
		const feedback = document.getElementById("pricingFeedback")
		const draft = bindPlaybookFormDraft(form, {
			key: `rate:${new FormData(form).get("ratePlanId")}:base-price`,
		})
		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			if (form.dataset.saving === "true") return
			const submitter = event.submitter
			const exit =
				submitter instanceof HTMLButtonElement &&
				submitter.name === "playbookNav" &&
				submitter.value === "exit"
			const formData = new FormData(form)
			form.dataset.saving = "true"
			setPlaybookSubmitBusy(form, true, "Guardando…")
			if (feedback) {
				feedback.setAttribute("role", "status")
				feedback.textContent = "Guardando precio…"
			}
			try {
				const response = await fetch("/api/pricing/base-rate", { method: "POST", body: formData })
				if (response.status === 401) {
					window.location.href = "/SignInPage"
					return
				}
				const payload = await response.json().catch(() => ({}))
				if (!response.ok)
					throw new Error(String(payload?.error ?? "No se pudo guardar el precio base."))
				draft.clear()
				if (feedback) feedback.textContent = "Precio guardado."
				const destination = exit ? form.dataset.guidedExit : form.dataset.guidedContinue
				if (destination) {
					const next = await persistOptionDestination(destination)
					form.dataset.saving = "false"
					document.dispatchEvent(new CustomEvent("fastt:playbook-saved", { detail: { form } }))
					window.location.href = next
				} else window.location.reload()
			} catch (error) {
				if (feedback) {
					feedback.setAttribute("role", "alert")
					feedback.textContent = `${error instanceof Error ? error.message : "No se pudo guardar."} Conservamos los datos para reintentar.`
				}
			} finally {
				form.dataset.saving = "false"
				setPlaybookSubmitBusy(form, false)
			}
		})
	}
	initPricingForm()
	document.addEventListener("astro:page-load", initPricingForm)
</script>
