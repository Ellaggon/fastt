---
import Button from "@/components/ui/Button.astro"
import FormField from "@/components/ui/FormField.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"

interface Props {
	ratePlanId: string
	initialCurrency: string
	initialBasePrice: string
	backHref?: string
}

const {
	ratePlanId,
	initialCurrency,
	initialBasePrice,
	backHref = "/rates/plans/manage",
} = Astro.props
---

<form id="pricingForm" class="mx-auto max-w-3xl space-y-6">
	<Input type="hidden" name="ratePlanId" value={ratePlanId} />
	<div class="space-y-5">
		<div>
			<h2 class="text-lg font-semibold text-slate-950">Precio base</h2>
			<p class="mt-1 text-sm leading-6 text-slate-500">
				Es el precio de referencia por noche. Los ajustes por fecha se hacen desde el calendario.
			</p>
		</div>
		<div class="grid gap-5 sm:grid-cols-[12rem_minmax(0,1fr)]">
			<FormField label="Moneda" htmlFor="currency" description="Se aplica a esta tarifa." required>
				<Select id="currency" name="currency" value={initialCurrency} required>
					<option value="USD">USD</option>
					<option value="BOB">BOB</option>
				</Select>
			</FormField>
			<FormField
				label="Precio base por noche"
				htmlFor="basePrice"
				description="Antes de impuestos, promociones o cambios por fecha."
				required
			>
				<Input
					id="basePrice"
					name="basePrice"
					type="number"
					min="0"
					step="1"
					value={initialBasePrice}
					required
				/>
			</FormField>
		</div>
	</div>
	<p id="pricingFeedback" class="whitespace-pre-wrap text-sm text-slate-600"></p>
	<div class="flex flex-wrap items-center justify-between gap-3 pt-2">
		<Button href={backHref} variant="ghost"> Volver a tarifas </Button>
		<Button id="submitBtn" type="submit"> Guardar precio base </Button>
	</div>
</form>

<script type="module">
	const form = document.getElementById("pricingForm")
	const submitBtn = document.getElementById("submitBtn")
	const feedback = document.getElementById("pricingFeedback")

	function setState(state, detail = "") {
		const labels = {
			loading: "Guardando...",
			success: "Guardado correctamente.",
			error: "No se pudo guardar el precio base.",
		}
		if (feedback) feedback.textContent = `${labels[state] ?? ""}${detail ? `\n${detail}` : ""}`
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault()
		if (!(submitBtn instanceof HTMLButtonElement) || !(form instanceof HTMLFormElement)) return
		submitBtn.disabled = true
		setState("loading")
		try {
			const formData = new FormData(form)
			const response = await fetch("/api/pricing/base-rate", { method: "POST", body: formData })
			if (response.status === 401) {
				window.location.href = "/SignInPage"
				return
			}
			const payload = await response.json().catch(() => ({}))
			if (!response.ok) {
				submitBtn.disabled = false
				setState("error", String(payload?.error ?? response.status))
				return
			}
			setState("success")
			window.location.reload()
		} catch (error) {
			submitBtn.disabled = false
			setState("error", `Error de red: ${String(error)}`)
		}
	})
</script>
