---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Input from "@/components/ui/Input.astro"
import Select from "@/components/ui/Select.astro"
import Textarea from "@/components/ui/Textarea.astro"
import { houseRuleCopy } from "@/modules/house-rules/presentation/houseRulePresentation"
import {
	buildHouseRuleGuestSummary,
	type HouseRule,
	type HouseRulePayload,
	type HouseRuleType,
} from "@/modules/house-rules/public"
import { BedDouble, ChevronRight, Cigarette, KeyRound, PawPrint, Shield } from "@lucide/astro"

interface Props {
	type: HouseRuleType
	inheritedRule: HouseRule | null
	overrideRule: HouseRule | null
	actionHref: string
	productId: string
	variantId: string
}

const { type, inheritedRule, overrideRule, actionHref, productId, variantId } = Astro.props

const copy = houseRuleCopy[type]
const Icon =
	{
		Pets: PawPrint,
		Smoking: Cigarette,
		Safety: Shield,
		ExtraBeds: BedDouble,
		Access: KeyRound,
	}[type as "Pets" | "Smoking" | "Safety" | "ExtraBeds" | "Access"] ?? Shield

const inheritedSummary = inheritedRule
	? buildHouseRuleGuestSummary(type, inheritedRule.payloadJson)
	: null
const overrideSummary = overrideRule
	? buildHouseRuleGuestSummary(type, overrideRule.payloadJson)
	: null
const payload = (overrideRule?.payloadJson ?? {}) as HouseRulePayload
const hasOverride = Boolean(overrideRule)

const status = hasOverride
	? { label: "Excepción", variant: "info" as const }
	: { label: "Heredada", variant: "neutral" as const }
const rowClass = [
	"fastt-row-card group scroll-mt-24 overflow-hidden bg-white text-slate-900 transition",
	hasOverride ? "fastt-row-card-info" : "",
].join(" ")
const wellClass = hasOverride
	? "flex size-9 shrink-0 items-center justify-center rounded-lg border border-sky-200 bg-sky-50 text-sky-700"
	: "flex size-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-600"
const impact = hasOverride
	? overrideSummary || "Excepción activa en este espacio"
	: inheritedSummary || "Hereda del alojamiento · sin definir aún"
---

<details
	id={`house-rule-space-${type}`}
	class={rowClass}
	data-house-rule-variant-override={type}
	data-house-rule-variant-mode={hasOverride ? "override" : "inherited"}
	data-house-rule-exception-form
>
	<summary
		class="flex cursor-pointer list-none flex-wrap items-center gap-3 p-4 [&::-webkit-details-marker]:hidden"
	>
		<span class={wellClass}>
			<Icon class="size-4" aria-hidden="true" />
		</span>
		<div class="min-w-0 flex-1">
			<p class="text-sm font-semibold text-slate-950">{copy.label}</p>
			<p class="mt-1 text-sm leading-5 text-slate-500">{impact}</p>
		</div>
		<div class="flex flex-wrap items-center gap-2 sm:justify-end">
			<Badge variant={status.variant}>{status.label}</Badge>
			<ChevronRight
				class="size-4 shrink-0 text-slate-400 transition group-open:rotate-90 group-open:text-[var(--fastt-color-selection)]"
				aria-hidden="true"
			/>
		</div>
	</summary>

	<div class="space-y-4 border-t border-slate-100 px-4 pb-4 pt-4">
		<p class="text-sm leading-6 text-slate-600">{copy.intent}</p>

		<section class="rounded-xl bg-slate-50 p-3" data-house-rule-inherited-block>
			<p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
				Heredada del alojamiento
			</p>
			<p class="mt-2 text-sm leading-6 text-slate-700">
				{
					inheritedSummary ??
						"Sin definir en el alojamiento. Completa esta regla a nivel hotel o define una excepción aquí."
				}
			</p>
		</section>

		{
			hasOverride ? (
				<div
					class="fastt-row-card flex flex-wrap items-start justify-between gap-3 border border-sky-200 bg-sky-50/70 p-3"
					data-house-rule-override-block
				>
					<div class="max-w-2xl min-w-0">
						<p class="text-xs font-semibold tracking-[0.12em] text-sky-800 uppercase">
							Excepción de este espacio
						</p>
						<p class="mt-2 text-sm leading-6 text-slate-800">{overrideSummary}</p>
					</div>
					<form method="POST" action={actionHref}>
						<input type="hidden" name="action" value="delete-house-rule" />
						<input type="hidden" name="ruleId" value={overrideRule?.id ?? ""} />
						<input type="hidden" name="productId" value={productId} />
						<input type="hidden" name="variantId" value={variantId} />
						<Button type="submit" variant="secondary" size="sm">
							Quitar excepción
						</Button>
					</form>
				</div>
			) : null
		}

		{
			hasOverride ? (
				<p class="rounded-xl bg-slate-50 px-3 py-2 text-sm leading-6 text-slate-600">
					Si necesitas cambiarla, quita la excepción y crea una nueva, o actualiza los campos abajo.
				</p>
			) : null
		}

		<form
			method="POST"
			action={actionHref}
			class="grid gap-3 sm:grid-cols-2"
			data-house-rule-variant-form
		>
			<input type="hidden" name="action" value="create-house-rule" />
			<input type="hidden" name="type" value={type} />
			<input type="hidden" name="productId" value={productId} />
			<input type="hidden" name="variantId" value={variantId} />
			<input type="hidden" name="scope" value="variant" />

			{
				type === "Pets" ? (
					<>
						<fieldset class="space-y-2 rounded-xl border border-slate-200 p-3 text-sm">
							<legend class="px-1 font-medium text-slate-700">Mascotas en este espacio</legend>
							<label class="mr-4">
								<input
									type="radio"
									name="allowed"
									value="true"
									checked={payload.allowed === true}
								/>{" "}
								Sí
							</label>
							<label>
								<input
									type="radio"
									name="allowed"
									value="false"
									checked={payload.allowed !== true}
								/>{" "}
								No
							</label>
						</fieldset>
						<label class="space-y-1 text-sm">
							<span class="font-medium text-slate-700">Nota breve</span>
							<Input
								name="feeNote"
								value={payload.feeNote ?? ""}
								placeholder="Ej. solo una mascota pequeña"
							/>
						</label>
					</>
				) : null
			}

			{
				type === "Smoking" ? (
					<>
						<fieldset class="space-y-2 rounded-xl border border-slate-200 p-3 text-sm">
							<legend class="px-1 font-medium text-slate-700">Fumar en este espacio</legend>
							<label class="mr-4">
								<input
									type="radio"
									name="allowed"
									value="true"
									checked={payload.allowed === true}
								/>{" "}
								Permitido con límites
							</label>
							<label>
								<input
									type="radio"
									name="allowed"
									value="false"
									checked={payload.allowed !== true}
								/>{" "}
								No permitido
							</label>
						</fieldset>
						<label class="space-y-1 text-sm" data-smoking-area-field>
							<span class="font-medium text-slate-700">Dónde aplica</span>
							<Select name="smokingArea">
								<option
									value="designated_areas"
									selected={
										!payload.area ||
										payload.area === "not_allowed" ||
										payload.area === "designated_areas"
									}
								>
									Áreas designadas
								</option>
								<option value="outdoors" selected={payload.area === "outdoors"}>
									Solo al aire libre
								</option>
								<option value="rooms" selected={payload.area === "rooms"}>
									Habitaciones designadas
								</option>
								<option value="other" selected={payload.area === "other"}>
									Otra indicación
								</option>
							</Select>
						</label>
					</>
				) : null
			}

			{
				type === "Access" ? (
					<>
						<label class="space-y-1 text-sm">
							<span class="font-medium text-slate-700">Llegada desde</span>
							<Input type="time" name="checkInFrom" value={payload.checkInFrom ?? "15:00"} />
						</label>
						<label class="space-y-1 text-sm">
							<span class="font-medium text-slate-700">Llegada hasta</span>
							<Input type="time" name="checkInUntil" value={payload.checkInUntil ?? "22:00"} />
						</label>
						<label class="space-y-1 text-sm sm:col-span-2">
							<span class="font-medium text-slate-700">Cómo entra el huésped</span>
							<Select name="checkInMethod">
								<option value="self" selected={!payload.method || payload.method === "self"}>
									Llegada autónoma
								</option>
								<option value="host" selected={payload.method === "host"}>
									Con anfitrión o personal
								</option>
								<option value="front_desk" selected={payload.method === "front_desk"}>
									Recepción
								</option>
								<option value="lockbox" selected={payload.method === "lockbox"}>
									Caja de seguridad
								</option>
								<option value="smart_lock" selected={payload.method === "smart_lock"}>
									Cerradura o código
								</option>
								<option value="manual" selected={payload.method === "manual"}>
									Entrega manual
								</option>
							</Select>
						</label>
						<label class="space-y-1 text-sm sm:col-span-2">
							<span class="font-medium text-slate-700">Instrucciones de acceso</span>
							<Textarea
								name="instructions"
								rows={3}
								value={payload.instructions ?? ""}
								placeholder="Ej. código en la puerta lateral"
							/>
						</label>
						<div class="space-y-2 rounded-xl border border-slate-200 p-3 text-sm sm:col-span-2">
							<p class="font-medium text-slate-700">Al llegar</p>
							<label class="block">
								<input type="checkbox" name="idRequired" checked={payload.idRequired === true} />{" "}
								Puede pedirse documento
							</label>
							<label class="block">
								<input
									type="checkbox"
									name="cardRequired"
									checked={payload.cardRequired === true}
								/>{" "}
								Puede pedirse tarjeta
							</label>
						</div>
					</>
				) : null
			}

			{
				type === "Safety" || type === "ExtraBeds" ? (
					<label class="space-y-1 text-sm sm:col-span-2">
						<span class="font-medium text-slate-700">Indicación para huéspedes</span>
						<Textarea
							name="instructions"
							rows={3}
							value={payload.instructions ?? ""}
							placeholder={
								type === "ExtraBeds"
									? "Ej. cuna bajo solicitud con 24 h de aviso"
									: "Ej. no ingresar a zonas de personal"
							}
						/>
					</label>
				) : null
			}

			<div class="sm:col-span-2">
				<Button type="submit" variant="primary" size="sm">
					{hasOverride ? "Guardar excepción" : "Crear excepción"}
				</Button>
			</div>
		</form>
	</div>
</details>

<script>
	document.querySelectorAll<HTMLFormElement>("[data-house-rule-variant-form]").forEach((form) => {
		const areaField = form.querySelector<HTMLElement>("[data-smoking-area-field]")
		if (!areaField) return
		const areaSelect = areaField.querySelector<HTMLSelectElement>('select[name="smokingArea"]')
		const syncSmokingArea = () => {
			const allowed =
				form.querySelector<HTMLInputElement>('input[name="allowed"]:checked')?.value === "true"
			areaField.hidden = !allowed
			if (areaSelect) areaSelect.disabled = !allowed
		}
		form.querySelectorAll<HTMLInputElement>('input[name="allowed"]').forEach((radio) => {
			radio.addEventListener("change", syncSmokingArea)
		})
		syncSmokingArea()
	})
</script>
