---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import { MapPin, Pencil } from "@lucide/astro"
import ProductLocationPreview from "./ProductLocationPreview.astro"
interface Props {
	title: string
	editHref: string
	productName: string
}
const { title, editHref, productName } = Astro.props
---

<Card variant="flush" className="min-w-0 overflow-hidden bg-white text-slate-900">
	<div
		class="flex min-h-[88px] items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 md:px-6"
	>
		<div class="flex min-w-0 items-center gap-3">
			<span class="fastt-section-icon"><MapPin class="size-4" aria-hidden="true" /></span>
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-2">
					<h2 class="text-sm font-semibold text-slate-950">{title}</h2>
					<span class="sr-only" data-product-location-status
						><Badge id="blockBadge-location" variant="neutral">Cargando...</Badge></span
					>
				</div>
				<p id="summaryAddress" class="mt-1 line-clamp-2 text-xs leading-5 text-slate-500">
					Cargando dirección...
				</p>
			</div>
		</div>
		<Button
			href={editHref}
			variant="ghost"
			class="!h-10 !w-10 shrink-0 rounded-lg !p-0"
			aria-label="Editar ubicación"
			title="Editar ubicación"><Pencil size={17} aria-hidden="true" /></Button
		>
	</div>
	<div class="p-2 md:p-3">
		<ProductLocationPreview compact label={`Ubicación de ${productName}`} />
	</div>
</Card>
