---
import Button from "@/components/ui/Button.astro"
import Dialog from "@/components/ui/Dialog.astro"
import Input from "@/components/ui/Input.astro"
import { Trash2 } from "@lucide/astro"

interface Props {
	productId: string
	productName: string
	workspaceSingularLabel: string
	variantsLabel?: string
}

const {
	productId,
	productName,
	workspaceSingularLabel,
	variantsLabel = "habitaciones",
} = Astro.props
const deleteLabel = `Eliminar ${workspaceSingularLabel.toLowerCase()}`
---

<details class="group border-t border-slate-200 pt-6">
	<summary
		class="flex cursor-pointer list-none items-center justify-between gap-3 text-xs font-semibold text-slate-500 transition hover:text-slate-800 [&::-webkit-details-marker]:hidden"
	>
		<span>Acciones avanzadas</span>
		<span class="text-slate-400 transition group-open:rotate-45">+</span>
	</summary>
	<div
		class="mt-3 max-w-2xl rounded-[var(--fastt-radius-card)] bg-slate-50 p-4 ring-1 ring-slate-900/[0.06]"
	>
		<p class="text-xs leading-5 text-slate-500">
			Usa esta opción solo si este {workspaceSingularLabel.toLowerCase()} fue creado por error o ya no
			debe existir en tu operación.
		</p>
		<Button
			type="button"
			variant="ghost"
			size="sm"
			className="mt-3 text-rose-700 hover:bg-rose-50 hover:text-rose-800"
			data-open-product-delete
			data-product-id={productId}
			data-product-name={productName}
		>
			<Trash2 class="h-4 w-4" />
			{deleteLabel}
		</Button>
	</div>
</details>

<Dialog class="w-[min(520px,calc(100%-2rem))]" data-product-delete-dialog={productId}>
	<form
		class="space-y-5 p-5"
		data-product-delete-form
		data-product-id={productId}
		data-product-name={productName}
	>
		<div class="space-y-2">
			<p class="text-xs font-semibold tracking-wide text-rose-700 uppercase">{deleteLabel}</p>
			<h2 class="text-lg font-semibold text-slate-950">Eliminar {productName}</h2>
			<p class="text-sm leading-6 text-slate-600">
				Se eliminarán la ficha, {variantsLabel}, fotos, tarifas, condiciones e inventario asociados.
				Esta acción no puede deshacerse.
			</p>
		</div>
		<label class="block space-y-1.5 text-sm">
			<span class="font-medium text-slate-800">
				Escribe <strong>{productName}</strong> para confirmar
			</span>
			<Input data-product-delete-confirmation autocomplete="off" />
		</label>
		<p class="text-sm text-rose-700" data-product-delete-feedback></p>
		<div class="flex justify-end gap-2 border-t border-slate-200 pt-4">
			<Button type="button" variant="secondary" data-close-product-delete>Cancelar</Button>
			<Button type="submit" variant="danger" data-confirm-product-delete disabled>
				{deleteLabel}
			</Button>
		</div>
	</form>
</Dialog>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-open-product-delete]").forEach((button) => {
		button.addEventListener("click", () => {
			const id = button.dataset.productId
			if (!id) return
			document
				.querySelector<HTMLDialogElement>(`[data-product-delete-dialog="${CSS.escape(id)}"]`)
				?.showModal()
		})
	})

	document.querySelectorAll<HTMLDialogElement>("[data-product-delete-dialog]").forEach((dialog) => {
		const form = dialog.querySelector<HTMLFormElement>("[data-product-delete-form]")
		const input = form?.querySelector<HTMLInputElement>("[data-product-delete-confirmation]")
		const submit = form?.querySelector<HTMLButtonElement>("[data-confirm-product-delete]")
		const feedback = form?.querySelector<HTMLElement>("[data-product-delete-feedback]")
		const productName = String(form?.dataset.productName ?? "")
		const productId = String(form?.dataset.productId ?? "")

		dialog.querySelector("[data-close-product-delete]")?.addEventListener("click", () => {
			dialog.close()
		})
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close()
		})
		dialog.addEventListener("close", () => {
			if (input) input.value = ""
			if (submit) submit.disabled = true
			if (feedback) feedback.textContent = ""
		})
		input?.addEventListener("input", () => {
			if (submit) submit.disabled = input.value.trim() !== productName
		})
		form?.addEventListener("submit", async (event) => {
			event.preventDefault()
			if (!submit || submit.disabled || !productId) return
			submit.disabled = true
			if (feedback) feedback.textContent = "Eliminando..."
			try {
				const response = await fetch(`/api/products/${encodeURIComponent(productId)}/delete`, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ productId }),
				})
				const result = await response.json().catch(() => null)
				if (!response.ok) {
					throw new Error(result?.error || result?.message || "No se pudo eliminar el servicio")
				}
				window.location.assign("/dashboard")
			} catch (error) {
				if (feedback) {
					feedback.textContent =
						error instanceof Error ? error.message : "No se pudo eliminar el servicio"
				}
				submit.disabled = false
			}
		})
	})
</script>
