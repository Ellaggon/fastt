---
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import Dialog from "@/components/ui/Dialog.astro"
import Input from "@/components/ui/Input.astro"
import { Trash2 } from "@lucide/astro"

interface Props {
	productId: string
	productName: string
	workspaceSingularLabel: string
	variantsLabel?: string
}

const {
	productId,
	productName,
	workspaceSingularLabel,
	variantsLabel = "habitaciones",
} = Astro.props
const deleteLabel = `Eliminar ${workspaceSingularLabel.toLowerCase()}`
---

<section class="border-t border-slate-800 pt-6 md:pt-8" data-product-delete-zone>
	<Card variant="flush" className="overflow-hidden border border-rose-200 bg-white text-slate-900">
		<div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between md:p-6">
			<div class="min-w-0">
				<p class="text-sm font-semibold text-slate-950">{deleteLabel}</p>
				<p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
					Solo si este {workspaceSingularLabel.toLowerCase()} fue creado por error o ya no forma parte
					de tu operación. Se borrarán la ficha, {variantsLabel}, fotos, tarifas e inventario
					asociados.
				</p>
			</div>
			<Button
				type="button"
				variant="danger"
				size="sm"
				className="shrink-0"
				data-open-product-delete
				data-product-id={productId}
				data-product-name={productName}
			>
				<Trash2 class="h-4 w-4" aria-hidden="true" />
				{deleteLabel}
			</Button>
		</div>
	</Card>
</section>

<Dialog class="w-[min(520px,calc(100%-2rem))]" data-product-delete-dialog={productId}>
	<form
		class="space-y-5 p-5"
		data-product-delete-form
		data-product-id={productId}
		data-product-name={productName}
	>
		<div class="space-y-2">
			<p class="text-xs font-semibold tracking-wide text-rose-700 uppercase">{deleteLabel}</p>
			<h2 class="text-lg font-semibold text-slate-950">Eliminar {productName}</h2>
			<p class="text-sm leading-6 text-slate-600">
				Se eliminarán la ficha, {variantsLabel}, fotos, tarifas, condiciones e inventario asociados.
				Esta acción no puede deshacerse.
			</p>
		</div>
		<label class="block space-y-1.5 text-sm">
			<span class="font-medium text-slate-800">
				Escribe <strong>{productName}</strong> para confirmar
			</span>
			<Input data-product-delete-confirmation autocomplete="off" />
		</label>
		<p class="text-sm text-rose-700" data-product-delete-feedback></p>
		<div class="flex justify-end gap-2 border-t border-slate-200 pt-4">
			<Button type="button" variant="secondary" data-close-product-delete>Cancelar</Button>
			<Button type="submit" variant="danger" data-confirm-product-delete disabled>
				{deleteLabel}
			</Button>
		</div>
	</form>
</Dialog>

<script>
	if (document.documentElement.dataset.productDeleteControlsBound !== "true") {
		document.documentElement.dataset.productDeleteControlsBound = "true"
		document.addEventListener("click", (event) => {
			const target = event.target
			if (!(target instanceof Element)) return

			const openButton = target.closest<HTMLButtonElement>("[data-open-product-delete]")
			if (openButton) {
				const id = openButton.dataset.productId
				if (!id) return
				document
					.querySelector<HTMLDialogElement>(`[data-product-delete-dialog="${CSS.escape(id)}"]`)
					?.showModal()
				return
			}

			const closeButton = target.closest("[data-close-product-delete]")
			if (closeButton) closeButton.closest("dialog")?.close()
			if (target instanceof HTMLDialogElement) target.close()
		})

		document.addEventListener("input", (event) => {
			const input = event.target
			if (
				!(input instanceof HTMLInputElement) ||
				!input.matches("[data-product-delete-confirmation]")
			) {
				return
			}
			const form = input.closest<HTMLFormElement>("[data-product-delete-form]")
			const submit = form?.querySelector<HTMLButtonElement>("[data-confirm-product-delete]")
			if (submit) submit.disabled = input.value.trim() !== String(form?.dataset.productName ?? "")
		})

		document.addEventListener(
			"close",
			(event) => {
				const dialog = event.target
				if (
					!(dialog instanceof HTMLDialogElement) ||
					!dialog.matches("[data-product-delete-dialog]")
				) {
					return
				}
				const input = dialog.querySelector<HTMLInputElement>("[data-product-delete-confirmation]")
				if (input) input.value = ""
				const submit = dialog.querySelector<HTMLButtonElement>("[data-confirm-product-delete]")
				if (submit) submit.disabled = true
				const feedback = dialog.querySelector<HTMLElement>("[data-product-delete-feedback]")
				if (feedback) feedback.textContent = ""
			},
			true
		)

		document.addEventListener("submit", async (event) => {
			const form = event.target
			if (!(form instanceof HTMLFormElement) || !form.matches("[data-product-delete-form]")) return
			event.preventDefault()
			const submit = form.querySelector<HTMLButtonElement>("[data-confirm-product-delete]")
			const feedback = form.querySelector<HTMLElement>("[data-product-delete-feedback]")
			const productId = String(form.dataset.productId ?? "")
			if (!submit || submit.disabled || !productId) return
			submit.disabled = true
			if (feedback) feedback.textContent = "Eliminando..."
			try {
				const response = await fetch(`/api/products/${encodeURIComponent(productId)}/delete`, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ productId }),
				})
				const result = await response.json().catch(() => null)
				if (!response.ok) {
					throw new Error(result?.error || result?.message || "No se pudo eliminar el servicio")
				}
				window.location.assign("/dashboard")
			} catch (error) {
				if (feedback) {
					feedback.textContent =
						error instanceof Error ? error.message : "No se pudo eliminar el servicio"
				}
				submit.disabled = false
			}
		})
	}
</script>
