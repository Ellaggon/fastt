---
import ContextSwitcher from "@/components/ui/ContextSwitcher.astro"
import { routes } from "@/lib/routes"
import { and, db, eq, Product, sql } from "@/shared/infrastructure/db/compat"

interface Props {
	providerId: string
	productId?: string
	currentName?: string
	target?: "detail" | "rooms" | "house-rules" | "financial"
	variant?: "surface" | "topbar"
}

const {
	providerId,
	productId: productIdProp,
	currentName = "Alojamiento",
	target = "detail",
	variant = "surface",
} = Astro.props
const productId = String(productIdProp ?? Astro.url.searchParams.get("productId") ?? "").trim()
const buildAccommodationHref = (id: string) => {
	if (target === "rooms") return routes.productRoomsForProduct(id)
	if (target === "house-rules") {
		return `${routes.providerHouseRules()}?productId=${encodeURIComponent(id)}`
	}
	if (target === "financial") {
		const params = new URLSearchParams(Astro.url.search)
		params.set("productId", id)
		const query = params.toString()
		return `${Astro.url.pathname}${query ? `?${query}` : ""}`
	}
	return routes.productDetail(id)
}
const accommodations = providerId
	? (
			await db
				.select({ id: Product.id, name: Product.name })
				.from(Product)
				.where(
					and(eq(Product.providerId, providerId), sql`lower(${Product.productType}) = 'hotel'`)
				)
		)
			.map((product) => ({
				id: String(product.id),
				name: String(product.name || "Alojamiento"),
				href: buildAccommodationHref(String(product.id)),
			}))
			.sort((left, right) => left.name.localeCompare(right.name, "es"))
	: []
const currentAccommodation = accommodations.find((item) => item.id === productId) ??
	accommodations[0] ?? {
		id: productId,
		name: currentName,
		href: buildAccommodationHref(productId),
	}
---

<ContextSwitcher
	label="Alojamiento"
	value={currentAccommodation.name}
	options={accommodations.map((item) => ({ id: item.id, label: item.name, href: item.href }))}
	selectedId={currentAccommodation.id}
	icon="accommodation"
	menuLabel="Cambiar alojamiento"
	emptyMessage="No hay otros alojamientos disponibles."
	ariaLabel="Cambiar alojamiento actual"
	variant={variant}
/>
