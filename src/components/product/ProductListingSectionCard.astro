---
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"

interface Props {
	title: string
	subtitle?: string
	badgeId: string
	editHref: string
	editLabel: string
	Icon: (props: Record<string, unknown>) => unknown
	/** Tighter body for tour ficha sections */
	dense?: boolean
	/** Single-row toolbar (no tall body + footer button) */
	compact?: boolean
}

const {
	title,
	subtitle,
	badgeId,
	editHref,
	editLabel,
	Icon,
	dense = false,
	compact = false,
} = Astro.props
---

{
	compact ? (
		<Card variant="flush" className="overflow-hidden bg-white text-slate-900">
			<div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 md:px-6">
				<div class="flex min-w-0 flex-1 items-start gap-3">
					<span class="fastt-section-icon">
						<Icon class="size-4" aria-hidden="true" />
					</span>
					<div class="min-w-0">
						<div class="flex flex-wrap items-center gap-2">
							<p class="text-sm font-semibold text-slate-950">{title}</p>
							<Badge id={badgeId} variant="neutral">
								Cargando...
							</Badge>
						</div>
						<div class="mt-0.5 text-sm leading-5 text-slate-500">
							<slot />
						</div>
					</div>
				</div>
				<Button href={editHref} variant="secondary" size="sm" className="shrink-0">
					{editLabel}
				</Button>
			</div>
		</Card>
	) : (
		<Card
			variant="flush"
			className:list={[
				"flex flex-col overflow-hidden bg-white text-slate-900",
				dense ? "" : "h-full",
			]}
		>
			<div class="border-b border-slate-100 px-5 py-4 md:px-6">
				<div class="flex items-start justify-between gap-3">
					<div class="flex min-w-0 items-start gap-3">
						<span class="fastt-section-icon">
							<Icon class="size-4" aria-hidden="true" />
						</span>
						<div class="min-w-0">
							<p class="text-sm font-semibold text-slate-950">{title}</p>
							{subtitle ? <p class="mt-0.5 text-xs leading-5 text-slate-500">{subtitle}</p> : null}
						</div>
					</div>
					<Badge id={badgeId} variant="neutral">
						Cargando...
					</Badge>
				</div>
			</div>
			<div class:list={["flex flex-col", dense ? "gap-3 p-4 md:p-5" : "flex-1 gap-4 p-5 md:p-6"]}>
				<div class:list={[dense ? "min-h-0 space-y-2" : "min-h-[7rem] flex-1"]}>
					<slot />
				</div>
				<Button
					href={editHref}
					variant="secondary"
					size="sm"
					className="w-full justify-center sm:w-auto sm:self-end"
				>
					{editLabel}
				</Button>
			</div>
		</Card>
	)
}
