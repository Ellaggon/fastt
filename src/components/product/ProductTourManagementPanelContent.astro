---
import Button from "@/components/ui/Button.astro"
import Badge from "@/components/ui/Badge.astro"
import { ArrowRight, CalendarDays, ClipboardList, Eye, Trash2 } from "@lucide/astro"

interface Props {
	isPublished: boolean
	optionSummary: string
	publicationSupport: string
	continueHref: string
	previewHref: string
	departuresHref: string
	publicationHref: string
	deleteLabel: string
	productId: string
	productName: string
	showHeader?: boolean
}

const {
	isPublished,
	optionSummary,
	publicationSupport,
	continueHref,
	previewHref,
	departuresHref,
	publicationHref,
	deleteLabel,
	productId,
	productName,
	showHeader = true,
} = Astro.props
---

{
	showHeader ? (
		<div class="space-y-4 border-b border-slate-100 px-5 py-4 md:px-6">
			<div class="flex items-start justify-between gap-3">
				<p class="text-sm font-semibold text-slate-950">Gestión</p>
				<Badge variant={isPublished ? "success" : "neutral"}>
					{isPublished ? "Publicado" : "Borrador"}
				</Badge>
			</div>
			<div class="space-y-3 text-sm leading-6 text-slate-600">
				<div>
					<p class="font-medium text-slate-800">Opciones y horarios</p>
					<p class="mt-0.5 text-slate-500">{optionSummary}</p>
				</div>
				<div>
					<p class="font-medium text-slate-800">Publicación</p>
					<p class="mt-0.5 text-slate-500">{publicationSupport}</p>
				</div>
			</div>
		</div>
	) : null
}
<div class="grid gap-2 p-5 md:p-6">
	<Button href={continueHref} variant="selection" className="w-full justify-start">
		<ArrowRight class="size-4 shrink-0" aria-hidden="true" />
		Continuar ficha
	</Button>
	<Button href={previewHref} variant="ghost" className="w-full justify-start">
		<Eye class="size-4 shrink-0" aria-hidden="true" />
		Vista previa
	</Button>
	<Button href={departuresHref} variant="ghost" className="w-full justify-start">
		<CalendarDays class="size-4 shrink-0" aria-hidden="true" />
		Opciones y horarios
	</Button>
	<Button href={publicationHref} variant="ghost" className="w-full justify-start">
		<ClipboardList class="size-4 shrink-0" aria-hidden="true" />
		Revisar publicación
	</Button>
	<Button
		href={`/product/${encodeURIComponent(productId)}#experience-requirements`}
		variant="ghost"
		className="w-full justify-start"
	>
		<ClipboardList class="size-4 shrink-0" aria-hidden="true" />
		Operación y requisitos
	</Button>
	<details class="mt-2 border-t border-slate-100 pt-3">
		<summary class="min-h-10 cursor-pointer py-2 text-sm font-medium text-slate-500"
			>Más opciones</summary
		>
		<Button
			type="button"
			variant="ghost"
			className="w-full justify-start !text-red-600 hover:!bg-red-50 hover:!text-red-700"
			data-open-product-delete
			data-product-id={productId}
			data-product-name={productName}
		>
			<Trash2 class="size-4 shrink-0" aria-hidden="true" />
			{deleteLabel}
		</Button>
	</details>
</div>
