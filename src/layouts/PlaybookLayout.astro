---
import {
	TOUR_REQUIREMENT_PRESENTATION,
	type presentTourDiagnostic,
} from "@/lib/tours/tourDiagnosticPresentation"
import { loadTourCommercialContext } from "@/lib/tours/loadTourCommercialContext"
import { withTourCommercialContext } from "@/lib/tours/resolveTourCommercialContext"
import PreparationProgress from "@/components/tours/TourPreparationProgress.astro"
import {
	resolveTourPlaybookContext,
	tourPublicationHref,
} from "@/lib/playbook/tour-playbook-context"
import PlaybookProductContextLine from "@/components/playbook/PlaybookProductContextLine.astro"
import Button from "@/components/ui/Button.astro"
import GuidedPreparationLayout from "@/layouts/GuidedPreparationLayout.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { getProviderIdFromRequest } from "@/lib/auth/getProviderIdFromRequest"
import { getUserFromRequest } from "@/lib/auth/getUserFromRequest"
import {
	ADD_ROOM_PLAYBOOK_TITLE,
	getAddRoomStepById,
	getAddRoomStepPosition,
	getPreviousAddRoomStep,
	isAddRoomTerminalStep,
} from "@/lib/playbook/add-room"
import {
	COMPLETE_TO_PUBLISH_PLAYBOOK_TITLE,
	buildCompleteToPublishHref,
	completeToPublishPreviousHref,
	normalizeCompleteToPublishStep,
} from "@/lib/playbook/complete-to-publish"
import { evaluateAddRoomProgress } from "@/lib/playbook/evaluate-add-room-progress"
import { evaluateLaunchProgress } from "@/lib/playbook/evaluate-launch-progress"
import { evaluateTourLaunchProgress } from "@/lib/playbook/evaluate-tour-launch-progress"
import {
	getApplicableLaunchSteps,
	getLaunchStepById,
	getPreviousLaunchStep,
	LAUNCH_PLAYBOOK_TITLE,
	type LaunchStepId,
} from "@/lib/playbook/launch-accommodation"
import {
	getLaunchLikeStepPosition,
	getLaunchLikeStage,
	resolveLaunchPlaybookDefinition,
} from "@/lib/playbook/launch-playbook-definition"
import {
	LAUNCH_TOUR_PLAYBOOK_ID,
	buildTourPlaybookHref,
	TOUR_LAUNCH_STEPS,
	type TourLaunchStepId,
} from "@/lib/playbook/launch-tour"
import type { PlaybookId } from "@/lib/playbook/types"
import { getTourPublishingStage } from "@/lib/playbook/tour-publishing-stages"
interface Props {
	title?: string
	productType?: string | null
	playbookId?: PlaybookId | null
	active?: boolean
	stepId?: LaunchStepId | TourLaunchStepId | string | null
	productId?: string
	variantId?: string
	ratePlanId?: string
	isHotel?: boolean
	playbookVertical?: string | null
	continueHref?: string | null
	continueLabel?: string
	continueReload?: boolean
	continueDisabled?: boolean
	continueDisabledTitle?: string
	continueFormId?: string | null
	ownsPrimaryCta?: boolean
	hideFooter?: boolean
	lightweight?: boolean
	productDisplayName?: string
	/** When true, the page renders the product context line next to its step heading. */
	deferPlaybookProductContext?: boolean
	playbookProductContextTourIcon?: "ticket" | "compass"
}

const {
	title = "Workspace",
	productType = null,
	playbookId: propPlaybookId = "launch",
	active = false,
	stepId = null,
	productId = "",
	variantId: propVariantId = "",
	ratePlanId: propRatePlanId = "",
	isHotel = false,
	playbookVertical = null,
	continueHref = null,
	continueLabel = "Continuar →",
	continueReload = false,
	continueDisabled = false,
	continueDisabledTitle = "Completa los pasos requeridos para continuar.",
	continueFormId = null,
	ownsPrimaryCta = false,
	hideFooter = false,
	lightweight = false,
	productDisplayName: productDisplayNameProp = "",
	deferPlaybookProductContext = false,
	playbookProductContextTourIcon = "compass",
} = Astro.props

const tourFlow =
	active && (playbookVertical === "tour" || propPlaybookId === "launch-tour")
		? resolveTourPlaybookContext(Astro.url, productId)
		: null
const playbookId = tourFlow?.playbookId ?? propPlaybookId
const isTourPublication = tourFlow?.part === "publish"
const isAddRoom = playbookId === "add-room"
const isComplete = playbookId === "complete-to-publish"
const isTourLaunch = playbookId === LAUNCH_TOUR_PLAYBOOK_ID
let variantId = propVariantId
let ratePlanId = propRatePlanId
let resolvedTourContext: Awaited<ReturnType<typeof loadTourCommercialContext>> | null = null
if (active && productId && (playbookVertical === "tour" || playbookId === "launch-tour")) {
	const user = await getUserFromRequest(Astro.request)
	const providerId = user ? await getProviderIdFromRequest(Astro.request, user) : null
	if (providerId) {
		resolvedTourContext = await loadTourCommercialContext({
			providerId,
			productId,
			request: Astro.request,
			url: Astro.url,
			selection:
				propVariantId || propRatePlanId
					? { variantId: propVariantId, ratePlanId: propRatePlanId }
					: undefined,
		})
		variantId =
			resolvedTourContext && "variantId" in resolvedTourContext
				? (resolvedTourContext.variantId ?? "")
				: ""
		ratePlanId =
			resolvedTourContext && "ratePlanId" in resolvedTourContext
				? (resolvedTourContext.ratePlanId ?? "")
				: ""
	}
}
const launchCtx = {
	productId,
	isHotel,
	variantId: variantId || undefined,
	ratePlanId: ratePlanId || undefined,
}
const addRoomCtx = {
	productId,
	variantId: variantId || undefined,
	ratePlanId: ratePlanId || undefined,
}
const launchLikeDefinition =
	playbookId === "launch" || playbookId === LAUNCH_TOUR_PLAYBOOK_ID
		? resolveLaunchPlaybookDefinition(playbookId, launchCtx)
		: null
const launchLikePosition = launchLikeDefinition
	? getLaunchLikeStepPosition(launchLikeDefinition, stepId)
	: null

let playbookTitle = LAUNCH_PLAYBOOK_TITLE
let stepLabel = ""
let stepGuestImpact = ""
let stepNumber: number | null = null
let totalSteps = 0
let progressPercent = 0
let tourAttention: ReturnType<typeof presentTourDiagnostic> | null = null
let previousHref: string | null = null
let resolvedContinueHref = continueHref?.trim() || null
if (resolvedContinueHref && resolvedTourContext && "options" in resolvedTourContext)
	resolvedContinueHref = withTourCommercialContext(resolvedContinueHref, resolvedTourContext)
let currentStepKnown = false
let stageLabel = ""
let stagePosition = 0
let stageTotal = 0

if (isTourPublication) {
	playbookTitle = "Publicar tour"
	currentStepKnown = true
	if (productId) {
		const user = await getUserFromRequest(Astro.request)
		const providerId = user ? await getProviderIdFromRequest(Astro.request, user) : null
		if (providerId) {
			const { evaluateCompleteToPublishProgress } =
				await import("@/lib/playbook/evaluate-complete-to-publish-progress")
			const progress = await evaluateCompleteToPublishProgress(productId, providerId, {
				currentStepId: stepId,
				request: Astro.request,
				url: Astro.url,
			})
			tourAttention = progress?.tourPresentation ?? null
		}
	}
} else if (isComplete && active && lightweight) {
	playbookTitle = COMPLETE_TO_PUBLISH_PLAYBOOK_TITLE
	currentStepKnown = true
	if (productId) {
		previousHref = completeToPublishPreviousHref(
			productId,
			stepId,
			playbookVertical || (isHotel ? "hotel" : null),
			{ variantId, ratePlanId }
		)
		if (playbookVertical === "tour") {
			const user = await getUserFromRequest(Astro.request)
			const providerId = user ? await getProviderIdFromRequest(Astro.request, user) : null
			if (providerId) {
				const { evaluateCompleteToPublishProgress } =
					await import("@/lib/playbook/evaluate-complete-to-publish-progress")
				const progress = await evaluateCompleteToPublishProgress(productId, providerId, {
					currentStepId: stepId,
					request: Astro.request,
					url: Astro.url,
				})
				tourAttention = progress?.tourPresentation ?? null
			}
		}
	}
	if (playbookVertical === "tour" && stepId) {
		const stage = getTourPublishingStage(stepId)
		stageLabel = stage.label
		stagePosition = stage.position
		stageTotal = stage.total
	}
} else if (isComplete && active && productId) {
	playbookTitle = COMPLETE_TO_PUBLISH_PLAYBOOK_TITLE
	const user = await getUserFromRequest(Astro.request)
	const providerId = user ? await getProviderIdFromRequest(Astro.request, user) : null
	if (providerId) {
		const { evaluateCompleteToPublishProgress } =
			await import("@/lib/playbook/evaluate-complete-to-publish-progress")
		const progress = await evaluateCompleteToPublishProgress(productId, providerId, {
			currentStepId: stepId,
			request: Astro.request,
			url: Astro.url,
		})
		if (progress) {
			tourAttention = progress.tourPresentation ?? null
			progressPercent = progress.progress.progressPercent
			totalSteps = progress.progress.totalSteps
			const current = progress.steps.find((step) => step.isCurrent) ?? progress.steps[0]
			if (current) {
				currentStepKnown = true
				stepLabel = current.label
				stepGuestImpact = current.guestImpact
				stepNumber = progress.steps.findIndex((step) => step.isCurrent) + 1
				if (stepNumber === 0) stepNumber = 1
			}
			previousHref = completeToPublishPreviousHref(
				productId,
				stepId,
				playbookVertical || (isHotel ? "hotel" : null),
				{ variantId, ratePlanId }
			)
			if (!resolvedContinueHref && progress.nextHref) {
				resolvedContinueHref = progress.nextHref
			}
		}
	}
	if (playbookVertical === "tour" && stepId) {
		const stage = getTourPublishingStage(stepId)
		stageLabel = stage.label
		stagePosition = stage.position
		stageTotal = stage.total
	}
} else {
	const currentStep = active
		? isAddRoom
			? getAddRoomStepById(stepId, addRoomCtx)
			: (launchLikePosition?.current ?? getLaunchStepById(stepId, launchCtx))
		: null
	const previousStep =
		active && stepId
			? isAddRoom
				? getPreviousAddRoomStep(stepId, addRoomCtx)
				: (launchLikePosition?.previous ?? getPreviousLaunchStep(stepId, launchCtx))
			: null

	if (isAddRoom) {
		const position = getAddRoomStepPosition(stepId, addRoomCtx)
		stepNumber = position.stepNumber
		totalSteps = position.totalSteps
	} else if (isTourLaunch) {
		stepNumber = launchLikePosition?.stepNumber ?? null
		totalSteps = launchLikePosition?.totalSteps ?? TOUR_LAUNCH_STEPS.length
	} else {
		const applicableSteps = getApplicableLaunchSteps(launchCtx)
		const stepIndex = currentStep
			? applicableSteps.findIndex((step) => step.id === currentStep.id)
			: -1
		stepNumber = stepIndex >= 0 ? stepIndex + 1 : null
		totalSteps = applicableSteps.length
	}

	playbookTitle = isAddRoom
		? ADD_ROOM_PLAYBOOK_TITLE
		: (launchLikeDefinition?.title ?? LAUNCH_PLAYBOOK_TITLE)
	if (currentStep) {
		currentStepKnown = true
		stepLabel = currentStep.label
		stepGuestImpact = currentStep.guestImpact
		if (launchLikeDefinition) {
			const stage = getLaunchLikeStage(launchLikeDefinition, currentStep.id)
			stageLabel = stage.label
			stagePosition = stage.position
			stageTotal = stage.total
		}
	}
	if (previousStep) {
		previousHref = isAddRoom
			? (getPreviousAddRoomStep(stepId, addRoomCtx)?.buildHref(addRoomCtx) ?? null)
			: isTourLaunch
				? previousStep.buildHref({
						productId,
						isHotel: false,
						variantId: variantId || undefined,
						ratePlanId: ratePlanId || undefined,
					})
				: previousStep.id === "create" && productId
					? null
					: (getPreviousLaunchStep(stepId, launchCtx)?.buildHref(launchCtx) ?? null)
	}

	if (active && productId && (!lightweight || isTourLaunch)) {
		const user = await getUserFromRequest(Astro.request)
		const providerId = user ? await getProviderIdFromRequest(Astro.request, user) : null
		if (providerId) {
			const progress = isTourLaunch
				? await evaluateTourLaunchProgress(productId, providerId, {
						variantId,
						ratePlanId,
						currentStepId: stepId,
						request: Astro.request,
						url: Astro.url,
					})
				: isAddRoom
					? await evaluateAddRoomProgress(productId, providerId, {
							variantId,
							ratePlanId,
							currentStepId: stepId,
						})
					: await evaluateLaunchProgress(productId, providerId, {
							isHotel,
							variantId,
							ratePlanId,
							currentStepId: stepId,
						})
			if (progress) {
				if ("tourPresentation" in progress) tourAttention = progress.tourPresentation ?? null
				progressPercent = progress.progress.progressPercent
			}
		}
	}
}

if (isTourLaunch && tourFlow?.returnHref) {
	const withReviewReturn = (href: string) => {
		const url = new URL(href, Astro.url)
		url.searchParams.set("returnTo", tourFlow.returnHref!)
		return url.pathname + url.search
	}
	if (previousHref) previousHref = withReviewReturn(previousHref)
	if (tourAttention)
		tourAttention = {
			...tourAttention,
			stages: tourAttention.stages.map((stage) => ({
				...stage,
				href: withReviewReturn(stage.href),
			})),
		}
}

const exitHref = productId
	? isAddRoom
		? `/product/${encodeURIComponent(productId)}/rooms`
		: `/product/${encodeURIComponent(productId)}`
	: "/dashboard"
const isTerminalStep = isAddRoom
	? isAddRoomTerminalStep(stepId)
	: isComplete
		? stepId === "preview"
		: stepId === "preview"
const showFooter = active && currentStepKnown && !hideFooter
const boundContinueFormId = continueFormId?.trim() || ""
const formBoundContinue = Boolean(boundContinueFormId)
const showHrefContinue = !formBoundContinue && !ownsPrimaryCta
const persistAndExit = formBoundContinue && Boolean(productId) && !isTourPublication
const formContinueLabel = continueLabel === "Continuar →" ? "Guardar y continuar" : continueLabel
const showProgress = active && currentStepKnown && !isTerminalStep && !isTourPublication
const showReadinessMeter = showProgress && !lightweight && !isTourLaunch
const stageProgressPercent =
	stagePosition > 0 && stageTotal > 0 ? Math.round((stagePosition / stageTotal) * 100) : 0
const visualProgressPercent = isTourLaunch
	? Math.min(100, Math.max(0, progressPercent))
	: stageProgressPercent > 0
		? Math.min(100, Math.max(progressPercent, stageProgressPercent))
		: Math.min(100, Math.max(0, progressPercent))
const tourAttentionHref = tourAttention?.primaryAction.href ?? ""
const attentionSection = tourAttention?.nextRequirementId
	? TOUR_REQUIREMENT_PRESENTATION[tourAttention.nextRequirementId].section
	: "preview"
const attentionLaunchStep =
	attentionSection === "photos"
		? "images"
		: attentionSection === "bookingPolicies"
			? "conditions"
			: attentionSection
let guidedAttentionHref = tourAttentionHref
if (tourAttentionHref.startsWith("/provider/")) {
	const target = new URL(tourAttentionHref, Astro.url)
	target.searchParams.set("returnTo", Astro.url.pathname + Astro.url.search)
	guidedAttentionHref = target.pathname + target.search + target.hash
} else if (tourAttention?.nextRequirementId) {
	guidedAttentionHref = isComplete
		? buildCompleteToPublishHref(tourAttentionHref, attentionSection)
		: isTourLaunch
			? buildTourPlaybookHref(
					tourAttentionHref,
					TOUR_LAUNCH_STEPS.find((step) => step.id === attentionLaunchStep)?.id ?? "preview"
				)
			: tourAttentionHref
}

function normalizePlaybookAttentionHref(base: URL, href: string): string {
	try {
		const url = new URL(href, base)
		const params = new URLSearchParams()
		for (const key of [
			"playbook",
			"step",
			"flow",
			"variantId",
			"ratePlanId",
			"vista",
			"focus",
			"productId",
		]) {
			const value = url.searchParams.get(key)?.trim()
			if (value) params.set(key, value)
		}
		const query = params.toString()
		return `${url.pathname}${query ? `?${query}` : ""}`
	} catch {
		return href
	}
}

const currentPlaybookHref = normalizePlaybookAttentionHref(
	Astro.url,
	`${Astro.url.pathname}${Astro.url.search}`
)
const tourAttentionTargetsCurrentStep =
	Boolean(guidedAttentionHref) &&
	normalizePlaybookAttentionHref(Astro.url, guidedAttentionHref) === currentPlaybookHref
/** Playbook pages already host the form; hide self-referential diagnosis cards. */
const activeTourAttention =
	showProgress && tourAttention && !tourAttentionTargetsCurrentStep ? tourAttention : null

const progressHeading =
	isAddRoom && stepNumber && totalSteps
		? `${playbookTitle} - Paso ${stepNumber} de ${totalSteps}`
		: stageLabel && stagePosition > 0 && stageTotal > 0
			? `Etapa ${stagePosition} de ${stageTotal}`
			: stepNumber && totalSteps
				? `Paso ${stepNumber} de ${totalSteps}`
				: "Progreso"
const isTourPreparation = isTourLaunch && !isTourPublication
const showTourStagesRail =
	isTourPreparation || (isComplete && playbookVertical === "tour" && !isTourPublication)
const reviewReturnHref =
	isTourPublication && stepId !== "preview"
		? tourPublicationHref(productId, { variantId, ratePlanId })
		: null
if (isTourPreparation) playbookTitle = "Preparar tour"
if (isTourPublication) {
	playbookTitle = "Publicar tour"
	stepLabel = ""
	previousHref = reviewReturnHref
	resolvedContinueHref = reviewReturnHref
}
// Lightweight controls evaluation cost, never persistence of the current navigation.
const preparationSessionPayload =
	active &&
	productId &&
	(playbookId === "launch" || playbookId === LAUNCH_TOUR_PLAYBOOK_ID || isComplete)
		? {
				productId,
				navigationAt: new Date().toISOString(),
				playbookId,
				vertical:
					playbookId === LAUNCH_TOUR_PLAYBOOK_ID || playbookVertical === "tour"
						? "tour"
						: playbookVertical === "hotel" || isHotel
							? "hotel"
							: "tour",
				stepId: String(stepId ?? "content"),
				variantId,
				ratePlanId,
			}
		: null

let productDisplayName = productDisplayNameProp.trim()
if (!productDisplayName && active && productId) {
	const user = await getUserFromRequest(Astro.request)
	const providerId = user ? await getProviderIdFromRequest(Astro.request, user) : null
	if (providerId) {
		const { getProductFullAggregate } = await import("@/modules/catalog/public")
		const aggregate = await getProductFullAggregate(productId, providerId)
		productDisplayName = String(aggregate?.displayName ?? "").trim()
	}
}

const isTourPlaybookContext =
	playbookVertical === "tour" || playbookId === LAUNCH_TOUR_PLAYBOOK_ID || isTourPublication
const showPlaybookProductContext =
	active && Boolean(productDisplayName) && !deferPlaybookProductContext
const tourPlaybookHeadlinePrefix = isTourPlaybookContext ? productDisplayName.trim() : ""
const showHotelPlaybookProductContext = showPlaybookProductContext && !isTourPlaybookContext
/** One tour title on publish/preview — never "{name} - Revisar y publicar" plus the bare name. */
const showTourPlaybookHeadline =
	isTourPlaybookContext &&
	Boolean(tourPlaybookHeadlinePrefix) &&
	(isTerminalStep || (!showProgress && showPlaybookProductContext))
/** Keeps the stage summary visually paired with each step’s form title. */
const tightTourPlaybookStepSpacing = isTourPlaybookContext && active
const correctionMessages =
	isTourPublication && stepId !== "preview"
		? [
				...new Set(
					(tourAttention?.blockers ?? [])
						.filter(
							(blocker) =>
								normalizeCompleteToPublishStep(
									TOUR_REQUIREMENT_PRESENTATION[blocker.id].section
								) === normalizeCompleteToPublishStep(stepId)
						)
						.map((blocker) => blocker.reason.message)
				),
			]
		: []
const PlaybookShell = active ? GuidedPreparationLayout : WorkspaceLayout
---

<PlaybookShell
	title={title}
	productType={productType ?? playbookVertical}
	playbookTitle={playbookTitle}
	stepLabel={stepLabel}
>
	{
		showProgress || showHotelPlaybookProductContext || showTourPlaybookHeadline ? (
			<div class:list={[tightTourPlaybookStepSpacing ? "mb-2 space-y-1" : "mb-5 space-y-3"]}>
				{showHotelPlaybookProductContext ? (
					<PlaybookProductContextLine
						productName={productDisplayName}
						variantName="Nueva habitación"
						isTour={false}
					/>
				) : null}
				{showTourPlaybookHeadline ? (
					<p class="text-sm leading-snug font-semibold text-slate-300">
						{tourPlaybookHeadlinePrefix}
					</p>
				) : null}
				{showProgress ? (
					<>
						{showTourStagesRail ? (
							<>
								{!isTerminalStep && tourAttention ? (
									<PreparationProgress
										stages={tourAttention.stages}
										activeStageId={getTourPublishingStage(stepId).id}
										stagePosition={stagePosition}
										stageTotal={stageTotal}
										productName={tourPlaybookHeadlinePrefix}
									/>
								) : null}
							</>
						) : (
							<>
								<p class="text-xs font-semibold tracking-wide text-slate-300 uppercase">
									{progressHeading}
								</p>
								{showReadinessMeter ? (
									<div
										class="fastt-progress-track h-1.5 overflow-hidden bg-slate-800"
										role="progressbar"
										aria-label={`Progreso de ${playbookTitle}`}
										aria-valuenow={visualProgressPercent}
										aria-valuemin={0}
										aria-valuemax={100}
									>
										<div
											class="fastt-progress-value h-full"
											style={`width: ${visualProgressPercent}%; background-color: var(--fastt-color-selection);`}
										/>
									</div>
								) : null}
							</>
						)}
					</>
				) : null}
			</div>
		) : null
	}

	{
		activeTourAttention && !isTourPreparation && !isTourPublication ? (
			<aside
				class="fastt-card mb-4 flex flex-wrap items-center justify-between gap-3 border-slate-700 bg-slate-900/40 px-4 py-3 text-sm"
				aria-label="Diagnóstico de la oferta"
			>
				<div>
					<>
						<p class="font-medium">{activeTourAttention.nextLabel}</p>
						<p class="mt-1 text-slate-400">{activeTourAttention.support}</p>
					</>
				</div>
				{activeTourAttention.nextRequirementId ? (
					<a class="shrink-0 font-medium underline underline-offset-4" href={guidedAttentionHref}>
						{activeTourAttention.primaryAction.label}
					</a>
				) : null}
			</aside>
		) : null
	}
	{
		isTourPublication && !isTerminalStep ? (
			<div
				class:list={[
					correctionMessages.length > 0 ? "space-y-2" : "",
					correctionMessages.length > 0 ? (tightTourPlaybookStepSpacing ? "mb-2" : "mb-4") : "",
				]}
				data-tour-publication-correction
			>
				{correctionMessages.length > 0 ? (
					<div id="tour-publication-cause" class="space-y-2">
						{correctionMessages.map((message) => (
							<p class="text-sm text-slate-300">{message}</p>
						))}
					</div>
				) : null}
			</div>
		) : null
	}
	<div class:list={[tightTourPlaybookStepSpacing && "-mt-1"]}>
		{isTourPreparation || isTourPublication ? <div data-tour-navigation-guard-marker /> : null}
		<slot />
	</div>

	{
		preparationSessionPayload ? (
			<p
				data-preparation-save-status
				role="status"
				aria-live="polite"
				class="mt-3 text-sm text-amber-500"
				hidden
			/>
		) : null
	}
	<script define:vars={{ preparationSessionPayload }}>
		if (preparationSessionPayload) {
			const navigationAt = preparationSessionPayload.navigationAt
			const savePreparationSession = () => {
				const navigationUrl = new URL(window.location.href)
				navigationUrl.searchParams.set("playbook", preparationSessionPayload.playbookId)
				if (preparationSessionPayload.vertical === "tour") {
					navigationUrl.searchParams.set("tourFlowVersion", "2")
					navigationUrl.searchParams.set(
						"flow",
						preparationSessionPayload.playbookId === "launch-tour" ? "create" : "complete"
					)
				}
				const lastPath = navigationUrl.pathname + navigationUrl.search
				const url = new URL(window.location.href)
				const selection =
					url.searchParams.has("variantId") || url.searchParams.has("ratePlanId")
						? {
								variantId: url.searchParams.get("variantId"),
								ratePlanId: url.searchParams.get("ratePlanId"),
							}
						: {}
				void fetch("/api/onboarding/preparation-session", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					keepalive: true,
					body: JSON.stringify({
						...preparationSessionPayload,
						...selection,
						lastPath,
						writeVersion: 2,
						navigationAt,
					}),
				})
					.then(async (response) => {
						const status = document.querySelector("[data-preparation-save-status]")
						if (!(status instanceof HTMLElement)) return
						status.hidden = response.ok
						if (!response.ok)
							status.textContent =
								response.status === 409
									? "Recarga la página para guardar el punto de continuación."
									: "No se pudo guardar el punto de continuación. Recarga para reintentar."
					})
					.catch(() => {
						const status = document.querySelector("[data-preparation-save-status]")
						if (status instanceof HTMLElement) {
							status.hidden = false
							status.textContent =
								"No se pudo guardar el punto de continuación. Comprueba la conexión y recarga."
						}
					})
			}
			savePreparationSession()
			window.addEventListener("pagehide", savePreparationSession)
		}
	</script>

	{
		showFooter ? (
			<footer class="fastt-playbook-footer flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-h-10">
					{previousHref ? (
						<Button
							href={previousHref}
							variant="ghost"
							className="text-slate-300 hover:bg-slate-800 hover:text-white"
						>
							{isTourPublication ? "← Volver a publicación" : "← Anterior"}
						</Button>
					) : null}
				</div>
				<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end">
					{persistAndExit && !isTerminalStep ? (
						<Button
							type="submit"
							form={boundContinueFormId}
							name="playbookNav"
							value="exit"
							formnovalidate
							variant="ghost"
							className="text-slate-400 hover:bg-slate-800 hover:text-white"
						>
							Dejar para más tarde
						</Button>
					) : !isTourPublication ? (
						<a
							href={exitHref}
							class="inline-flex h-10 items-center justify-center px-2 text-sm font-medium text-slate-500 transition hover:text-slate-200"
						>
							Dejar para más tarde
						</a>
					) : null}
					{isTerminalStep && isComplete ? (
						<p class="text-sm text-slate-400">Usa el botón Publicar en la vista previa.</p>
					) : isTerminalStep ? (
						<Button href={exitHref} className="fastt-playbook-cta">
							{isAddRoom ? "Ver habitaciones" : "Ir a la ficha"}
						</Button>
					) : formBoundContinue ? (
						<Button
							type="submit"
							form={boundContinueFormId}
							name="playbookNav"
							value="continue"
							className="fastt-playbook-cta"
						>
							{reviewReturnHref ? "Guardar y volver" : formContinueLabel}
						</Button>
					) : showHrefContinue && resolvedContinueHref && continueDisabled ? (
						<Button disabled className="fastt-playbook-cta" title={continueDisabledTitle}>
							{reviewReturnHref ? "Volver a publicación" : continueLabel}
						</Button>
					) : showHrefContinue && resolvedContinueHref ? (
						<Button
							href={resolvedContinueHref}
							className="fastt-playbook-cta"
							reload={continueReload}
						>
							{reviewReturnHref ? "Volver a publicación" : continueLabel}
						</Button>
					) : null}
				</div>
			</footer>
		) : null
	}

	<script
		is:inline
		define:vars={{
			isTourPreparation,
			isTourPublication,
			playbookId,
			productId,
			stepId,
			variantId,
			ratePlanId,
			reviewReturnHref,
			boundContinueFormId,
		}}
	>
		if (isTourPreparation || isTourPublication) {
			for (const form of document.querySelectorAll("form")) {
				if (
					form.id !== boundContinueFormId &&
					form.id !== "tour-slot-profile-form" &&
					!form.querySelector('[name="playbook"]')
				)
					continue
				for (const [name, value] of Object.entries({
					playbook: playbookId,
					tourFlowVersion: "2",
					flow: isTourPublication ? "complete" : "create",
					playbookCurrentStep: stepId,
					playbookVertical: "tour",
					variantId,
					ratePlanId,
					returnTo: reviewReturnHref,
				})) {
					if (!value) continue
					let field = form.querySelector(`[name="${name}"]`)
					if (!field) {
						field = document.createElement("input")
						field.type = "hidden"
						field.name = name
						form.appendChild(field)
					}
					field.value = value
				}
			}
		}
		if (isTourPublication && reviewReturnHref) {
			const focusTourCorrection = () => {
				const form = document.getElementById(boundContinueFormId || "tour-slot-profile-form")
				if (!(form instanceof HTMLFormElement) || form.dataset.publicationFocused) return
				form.dataset.publicationFocused = "true"
				const missing = Array.from(form.elements).find(
					(control) =>
						(control instanceof HTMLInputElement ||
							control instanceof HTMLSelectElement ||
							control instanceof HTMLTextAreaElement) &&
						!control.disabled &&
						control.required &&
						!control.checkValidity()
				)
				const cause = document.getElementById("tour-publication-cause")
				const target =
					missing instanceof HTMLInputElement && missing.type === "file"
						? form.querySelector("#dropzone")
						: missing instanceof HTMLSelectElement
							? missing.closest("[data-fastt-select]")?.querySelector("[data-fastt-select-trigger]")
							: (missing ??
								(Number(form.dataset.requiredImageCount) > 0 && cause?.textContent.trim()
									? form.querySelector("#dropzone")
									: null))
				if (target instanceof HTMLElement) {
					if (cause?.textContent.trim())
						target.setAttribute(
							"aria-describedby",
							[target.getAttribute("aria-describedby"), cause.id].filter(Boolean).join(" ")
						)
					target.focus({ preventScroll: true })
				}
			}
			if (document.readyState === "complete") focusTourCorrection()
			else window.addEventListener("load", focusTourCorrection, { once: true })
			document.addEventListener("astro:page-load", focusTourCorrection, { once: true })
		}
	</script>
</PlaybookShell>

<script>
	import { installTourPreparationNavigationGuard } from "@/lib/forms/tourPreparationNavigationGuard"
	function install() {
		const marker = document.querySelector("[data-tour-navigation-guard-marker]")
		const main = marker?.closest("main")
		if (main instanceof HTMLElement) main.setAttribute("data-tour-navigation-guard", "")
		installTourPreparationNavigationGuard()
	}
	install()
	document.addEventListener("astro:page-load", install)
</script>
