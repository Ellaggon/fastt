---
import ProviderSettingsSubnav from "@/components/provider/ProviderSettingsSubnav.astro"
import ProgressBar from "@/components/ui/ProgressBar.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { ArrowLeft } from "@lucide/astro"
import type { TrustLinkId } from "@/lib/provider-trust-map"

interface Props {
	title?: string
	eyebrow?: string
	heading?: string
	description?: string
	/**
	 * Settings hub tabs (Resumen · Perfil · Equipo).
	 * Off for Verificación: wizard/trust map is its own chrome, not a settings tab.
	 */
	showSettingsTabs?: boolean
	verificationSummary?: { text: string }
	verificationProgress?: { completed: number; total: number } | null
	pendingReviewRequests?: number | null
	/** Per-tab subtitles; hub updates header copy when the trust rail panel changes. */
	verificationPageGuidanceByTab?: Partial<Record<TrustLinkId, string>> | null
}

const {
	title = "Configuración del proveedor",
	heading = "Configuración",
	description = "Administra la identidad, el equipo y la operación del proveedor.",
	showSettingsTabs = true,
	verificationSummary = null,
	verificationProgress = null,
	pendingReviewRequests = null,
	verificationPageGuidanceByTab = null,
} = Astro.props

const currentPath = Astro.url.pathname.replace(/\/$/, "")
const isVerificationPage = currentPath === "/provider/settings/verification"

const verificationPageGuidanceJson =
	verificationPageGuidanceByTab && Object.keys(verificationPageGuidanceByTab).length > 0
		? JSON.stringify(verificationPageGuidanceByTab)
		: null
---

<WorkspaceLayout title={title}>
	<section class="space-y-6 text-slate-200 md:space-y-8" data-provider-settings-shell>
		{
			currentPath === "/provider/compliance/requests" ? (
				<a
					href="/provider/settings"
					class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 hover:text-white"
				>
					<ArrowLeft class="size-4" aria-hidden="true" />
					Configuración
				</a>
			) : !isVerificationPage ? (
				<a
					href="/provider/compliance/requests"
					class="inline-flex text-sm font-semibold underline underline-offset-4"
				>
					Solicitudes del equipo de revisión
				</a>
			) : null
		}
		<header class="flex flex-col gap-2">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl md:text-3xl">
					{heading}
				</h1>
				<div class="flex flex-wrap items-center gap-3">
					<slot name="actions" />
				</div>
			</div>
			{
				!(isVerificationPage && verificationSummary) && (
					<p
						class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6"
						data-verification-page-description={verificationPageGuidanceJson ? "true" : undefined}
						data-verification-page-guidance={verificationPageGuidanceJson ?? undefined}
					>
						{description}
					</p>
				)
			}
			{
				isVerificationPage ? (
					<div
						class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
						data-verification-operational-summary
					>
						{verificationSummary && (
							<p class="max-w-3xl text-sm leading-6 text-slate-200" role="status">
								{verificationSummary.text}
							</p>
						)}
						<a
							href="/provider/compliance/requests"
							class="fastt-button inline-flex min-h-9 w-fit shrink-0 items-center rounded-md border border-slate-700 px-3 text-sm font-semibold text-slate-200 transition-colors hover:border-slate-500 hover:bg-slate-800/70 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-200"
						>
							Solicitudes del equipo de revisión
							{pendingReviewRequests != null && pendingReviewRequests > 0 && (
								<span class="ml-2 rounded-full bg-slate-700 px-2 py-0.5 text-xs tabular-nums">
									{pendingReviewRequests}
								</span>
							)}
						</a>
					</div>
				) : null
			}
			{
				isVerificationPage && verificationProgress && verificationProgress.total > 0 && (
					<div class="mt-2 w-full max-w-lg space-y-2" data-verification-completion-progress>
						<p class="text-xs font-medium text-slate-400 tabular-nums">
							{verificationProgress.completed} de {verificationProgress.total} requisitos
							verificados
						</p>
						<ProgressBar
							value={verificationProgress.completed}
							max={verificationProgress.total}
							variant="selection"
							class="!h-1.5 !bg-slate-800"
							aria-label="Progreso de verificación del negocio"
							aria-valuetext={`${verificationProgress.completed} de ${verificationProgress.total} requisitos verificados`}
						/>
					</div>
				)
			}
		</header>

		{showSettingsTabs ? <ProviderSettingsSubnav /> : null}
		<div class="provider-settings-panel-stage">
			<div
				class="flex flex-col gap-8 md:gap-10 data-[settings-panel-loading]:pointer-events-none"
				data-provider-settings-panel
			>
				<slot />
			</div>
		</div>
	</section>

	<script>
		import "@/pages/provider/settings/_client/settings-funnel-beacon.js"
	</script>
</WorkspaceLayout>

<style is:global>
	.provider-settings-panel-stage {
		position: relative;
		isolation: isolate;
	}

	[data-provider-settings-panel][data-settings-panel-entering] {
		animation: settings-panel-enter 160ms ease-out;
	}
	@keyframes settings-panel-enter {
		from {
			opacity: 0.75;
			transform: translateY(2px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		[data-provider-settings-panel][data-settings-panel-entering] {
			animation: none;
		}
	}
</style>
