---
import ProviderSettingsSubnav from "@/components/provider/ProviderSettingsSubnav.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import type { TrustLinkId } from "@/lib/provider-trust-map"
import {
	formatVerificationProgressBreakdownLine,
	formatVerificationProgressTotalLine,
} from "@/lib/provider-trust-map"

interface Props {
	title?: string
	eyebrow?: string
	heading?: string
	description?: string
	/**
	 * Settings hub tabs (Resumen · Perfil · Equipo).
	 * Off for Verificación: wizard/trust map is its own chrome, not a settings tab.
	 */
	showSettingsTabs?: boolean
	/** Verified readiness above the page title. Navigation position is deliberately separate. */
	readyCount?: number | null
	totalCount?: number | null
	inReviewCount?: number | null
	actionRequiredCount?: number | null
	notStartedCount?: number | null
	notEvaluableCount?: number | null
	readinessPercent?: number | null
	progressLabel?: string
	/** Per-tab subtitles; hub updates header copy when the trust rail panel changes. */
	verificationPageGuidanceByTab?: Partial<Record<TrustLinkId, string>> | null
}

const {
	title = "Configuración del proveedor",
	heading = "Configuración",
	description = "Administra la identidad, el equipo y la operación del proveedor.",
	showSettingsTabs = true,
	readyCount = null,
	totalCount = null,
	inReviewCount = null,
	actionRequiredCount = null,
	notStartedCount = null,
	notEvaluableCount = null,
	readinessPercent = null,
	progressLabel = "Progreso de verificación",
	verificationPageGuidanceByTab = null,
} = Astro.props

const verificationPageGuidanceJson =
	verificationPageGuidanceByTab && Object.keys(verificationPageGuidanceByTab).length > 0
		? JSON.stringify(verificationPageGuidanceByTab)
		: null

const hasProgress =
	typeof readyCount === "number" &&
	readyCount >= 0 &&
	typeof totalCount === "number" &&
	totalCount > 0
const rawPercent =
	typeof readinessPercent === "number" && Number.isFinite(readinessPercent)
		? Math.min(100, Math.max(0, Math.round(readinessPercent)))
		: 0
const visualProgressPercent = hasProgress ? rawPercent : 0
const hasProgressBreakdown =
	hasProgress &&
	typeof inReviewCount === "number" &&
	typeof actionRequiredCount === "number" &&
	typeof notStartedCount === "number"
const progressTotalLine =
	hasProgress && typeof totalCount === "number" && typeof readyCount === "number"
		? formatVerificationProgressTotalLine(readyCount, totalCount)
		: ""
const progressBreakdownLine = hasProgressBreakdown
	? formatVerificationProgressBreakdownLine({
			readyCount: readyCount!,
			inReviewCount: inReviewCount!,
			actionRequiredCount: actionRequiredCount!,
			notStartedCount: notStartedCount!,
			notEvaluableCount: notEvaluableCount ?? 0,
		})
	: progressTotalLine
---

<WorkspaceLayout title={title}>
	<section class="space-y-6 text-slate-200 md:space-y-8" data-provider-settings-shell>
		{
			hasProgress ? (
				<div class="mb-5 space-y-2" data-verification-wizard-progress>
					<div
						class:list={[
							"verification-wizard-progress-label",
							hasProgressBreakdown && "verification-wizard-progress-label--alternate",
						]}
						data-verification-wizard-progress-label={hasProgressBreakdown ? "true" : undefined}
					>
						<p
							class="verification-wizard-progress-label__stack text-xs font-semibold tracking-wide text-slate-400 uppercase"
							data-next-step-progress
						>
							<span class="verification-wizard-progress-label__phase verification-wizard-progress-label__phase--total">
								{progressTotalLine}
							</span>
							{hasProgressBreakdown ? (
								<span
									class="verification-wizard-progress-label__phase verification-wizard-progress-label__phase--breakdown tracking-wide text-slate-400 normal-case"
									aria-hidden="true"
								>
									{progressBreakdownLine}
								</span>
							) : null}
						</p>
						{hasProgressBreakdown ? (
							<span class="sr-only">{`${progressTotalLine}. ${progressBreakdownLine}`}</span>
						) : null}
					</div>
					<div
						class="fastt-progress-track h-1.5 overflow-hidden bg-slate-800"
						role="progressbar"
						aria-valuenow={rawPercent}
						aria-valuemin={0}
						aria-valuemax={100}
						aria-label={progressLabel}
					>
						<div
							class="fastt-progress-value h-full"
							style={`width: ${visualProgressPercent}%; min-width: ${visualProgressPercent > 0 ? "0.75rem" : "0"}; background-color: var(--fastt-color-selection);`}
							data-verification-wizard-bar
						/>
					</div>
				</div>
			) : null
		}

		<header class="flex flex-col gap-2">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl md:text-3xl">
					{heading}
				</h1>
				<div class="flex flex-wrap items-center gap-3">
					<slot name="actions" />
				</div>
			</div>
			<p
				class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6"
				data-verification-page-description={verificationPageGuidanceJson ? "true" : undefined}
				data-verification-page-guidance={verificationPageGuidanceJson ?? undefined}
			>
				{description}
			</p>
		</header>

		{showSettingsTabs ? <ProviderSettingsSubnav /> : null}
		<div class="provider-settings-panel-stage">
			<div
				class="flex flex-col gap-8 md:gap-10 data-[settings-panel-loading]:pointer-events-none"
				data-provider-settings-panel
			>
				<slot />
			</div>
		</div>
	</section>

	<script>
		import "@/pages/provider/settings/_client/settings-funnel-beacon.js"
	</script>
</WorkspaceLayout>

<style is:global>
	.provider-settings-panel-stage {
		position: relative;
		isolation: isolate;
	}

	[data-provider-settings-shell] > header {
		transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1);
	}

	[data-provider-settings-shell] > header[data-settings-header-leaving],
	[data-provider-settings-shell] > header[data-settings-header-entering] {
		opacity: 0;
	}

	[data-provider-settings-panel] {
		transition:
			opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1),
			transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
	}

	[data-provider-settings-panel][data-settings-panel-leaving],
	[data-provider-settings-panel][data-settings-panel-entering] {
		opacity: 0;
		transform: translateY(0.45rem);
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-provider-settings-shell] > header,
		[data-provider-settings-panel] {
			transition: none;
		}

		[data-provider-settings-shell] > header[data-settings-header-leaving],
		[data-provider-settings-shell] > header[data-settings-header-entering],
		[data-provider-settings-panel][data-settings-panel-leaving],
		[data-provider-settings-panel][data-settings-panel-entering] {
			opacity: 1;
			transform: none;
		}
	}
</style>
