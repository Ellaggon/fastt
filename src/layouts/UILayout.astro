---
import Sidebar from "@/components/nav/NavBurger.astro"
import NavLayout from "@/components/nav/NavLayout.astro"
import Layout from "@/layouts/Layout.astro"

const { title, description, canonicalPath, noindex } = Astro.props
---

<Layout title={title} description={description} canonicalPath={canonicalPath} noindex={noindex}>
	<div class="pt-12">
		<NavLayout />
		<Sidebar />
	</div>

	<slot />
</Layout>
