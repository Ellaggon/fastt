---
import { getFeatureFlag } from "@/config/featureFlags"
import Layout from "@/layouts/Layout.astro"

interface Props {
	title?: string
}

const { title = "Centro de Mando FASTT" } = Astro.props
const pathname = Astro.url.pathname
const commandCenterEnabled = getFeatureFlag("COMMAND_CENTER_V2_READ_ENABLED", {
	request: Astro.request,
})
const links = commandCenterEnabled
	? [
			{ href: "/admin", label: "Inicio", exact: true },
			{ href: "/admin/work", label: "Mi trabajo" },
			{ href: "/admin/queues/all", label: "Colas" },
			{ href: "/admin/cases", label: "Casos" },
			{ href: "/admin/audit", label: "Auditoría" },
			{ href: "/admin/policy-exceptions", label: "Políticas" },
		]
	: [
			{ href: "/admin/providers", label: "Proveedores", exact: true },
			{ href: "/admin/audit", label: "Auditoría" },
		]
const isActive = (link: (typeof links)[number]) =>
	link.exact
		? pathname === link.href
		: pathname === link.href || pathname.startsWith(`${link.href}/`)
---

<Layout title={title}>
	<a
		href="#admin-main"
		class="sr-only z-50 rounded-lg bg-white px-4 py-2 text-slate-950 focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
	>
		Saltar al contenido
	</a>
	<div class="min-h-screen bg-slate-950 text-slate-100">
		<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/95 backdrop-blur">
			<div class="mx-auto max-w-[96rem] px-4 sm:px-6">
				<div class="flex min-h-16 flex-wrap items-center justify-between gap-3 py-3">
					<div class="flex items-center gap-4">
						<a
							href={commandCenterEnabled ? "/admin" : "/admin/providers"}
							class="group flex items-center gap-3"
						>
							<span
								class="grid size-9 place-items-center rounded-xl bg-amber-300 font-black text-slate-950"
								>F</span
							>
							<span>
								<span class="block text-sm font-semibold text-white">Centro de Mando</span>
								<span class="block text-[10px] tracking-[0.16em] text-slate-400 uppercase"
									>FASTT interno</span
								>
							</span>
						</a>
						<nav
							class="hidden items-center gap-1 lg:flex"
							aria-label="Navegación del Centro de Mando"
						>
							{
								links.map((link) => (
									<a
										href={link.href}
										aria-current={isActive(link) ? "page" : undefined}
										class:list={[
											"min-h-10 rounded-lg px-3 py-2 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-amber-300",
											isActive(link)
												? "bg-slate-800 text-white"
												: "text-slate-400 hover:bg-slate-900 hover:text-white",
										]}
									>
										{link.label}
									</a>
								))
							}
						</nav>
					</div>
					<div class="flex items-center gap-2">
						<a
							class="rounded-lg px-3 py-2 text-xs text-slate-400 hover:bg-slate-900 hover:text-white"
							href="/admin/providers">Legacy</a
						>
						<a
							class="rounded-lg border border-slate-700 px-3 py-2 text-xs font-medium text-amber-200 hover:border-amber-300"
							href={`/auth/mfa?returnTo=${encodeURIComponent(pathname)}`}>Confirmar MFA</a
						>
					</div>
				</div>
				<nav
					class="flex gap-1 overflow-x-auto pb-3 lg:hidden"
					aria-label="Navegación móvil del Centro de Mando"
				>
					{
						links.map((link) => (
							<a
								href={link.href}
								aria-current={isActive(link) ? "page" : undefined}
								class:list={[
									"min-h-10 shrink-0 rounded-lg px-3 py-2 text-sm font-medium",
									isActive(link) ? "bg-slate-800 text-white" : "text-slate-400",
								]}
							>
								{link.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>
		<main id="admin-main" class="mx-auto max-w-[96rem] px-4 py-6 sm:px-6 sm:py-8" tabindex="-1">
			<slot />
		</main>
	</div>
</Layout>
