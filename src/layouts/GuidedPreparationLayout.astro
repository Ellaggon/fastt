---
import Layout from "@/layouts/Layout.astro"

export interface GuidedPreparationOfferContext {
	productLabel: string
	productName: string
	variantLabel?: string
	variantName?: string
	/** Shown on etapa 1 instead of a saved option name (e.g. “Añadir opción”). */
	playbookLine?: string
}

interface Props {
	title?: string
	playbookTitle?: string
	stepLabel?: string
	offerContext?: GuidedPreparationOfferContext | null
}

const {
	title = "Preparar servicio",
	playbookTitle = "Preparación",
	stepLabel = "",
	offerContext = null,
} = Astro.props
---

<Layout title={title}>
	<a
		href="#guided-preparation-main"
		class="sr-only fixed top-3 left-3 z-50 rounded bg-white px-3 py-2 text-sm font-semibold text-slate-950 focus:not-sr-only"
	>
		Saltar al contenido
	</a>
	<div class="min-h-screen bg-slate-950 text-slate-100">
		<header class="border-b border-slate-800" data-guided-preparation-header>
			<div class="mx-auto flex min-h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
				<a
					href="/dashboard"
					class="text-lg font-semibold text-white"
					aria-label="Fastt, volver al inicio"
				>
					Fastt
				</a>
				<div class="min-w-0 max-w-[min(100%,12rem)] text-right sm:max-w-md">
					{
						offerContext ? (
							<div class="space-y-1 text-sm leading-snug">
								<p class="flex min-w-0 items-baseline justify-end gap-1 font-medium text-slate-200">
									<span class="shrink-0 text-slate-400">{offerContext.productLabel}:</span>
									<span class="min-w-0 max-sm:truncate" title={offerContext.productName}>
										{offerContext.productName}
									</span>
								</p>
								{offerContext.variantLabel && offerContext.variantName ? (
									<p class="flex min-w-0 items-baseline justify-end gap-1 font-medium text-slate-200">
										<span class="shrink-0 text-slate-400">{offerContext.variantLabel}:</span>
										<span class="min-w-0 max-sm:truncate" title={offerContext.variantName}>
											{offerContext.variantName}
										</span>
									</p>
								) : offerContext.playbookLine ? (
									<p
										class="font-medium text-slate-400 max-sm:truncate"
										title={offerContext.playbookLine}
									>
										{offerContext.playbookLine}
									</p>
								) : null}
							</div>
						) : (
							<>
								<p class="truncate text-sm font-medium text-slate-200">{playbookTitle}</p>
								{stepLabel ? (
									<p class="hidden text-xs text-slate-400 sm:block">{stepLabel}</p>
								) : null}
							</>
						)
					}
				</div>
			</div>
		</header>
		<main id="guided-preparation-main" class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-10">
			<slot />
		</main>
	</div>
</Layout>
