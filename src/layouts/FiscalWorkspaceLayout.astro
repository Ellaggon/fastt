---
import FiscalPermissionNotice from "@/components/tax-fees/FiscalPermissionNotice.astro"
import FiscalScopeSwitcher from "@/components/tax-fees/FiscalScopeSwitcher.astro"
import FiscalStatusBar from "@/components/tax-fees/FiscalStatusBar.astro"
import FiscalWorkspaceTabs from "@/components/tax-fees/FiscalWorkspaceTabs.astro"
import Button from "@/components/ui/Button.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import { routes } from "@/lib/routes"

type FiscalTab = "definitions" | "assignments" | "simulator" | "activity"

type ContentLayout = "card" | "stacked"

interface Props {
	title?: string
	activeTab: FiscalTab
	identityLabel: string
	isIdentityConfigured: boolean
	canManageFiscality: boolean
	conflictCount?: number
	pendingSyncCount?: number
	tabCounts?: Partial<Record<FiscalTab, number>>
	scopeOptions?: Array<{ id: string; label: string }>
	selectedScopeId?: string | null
	primaryLabel?: string
	primaryHref?: string
	primaryButtonClass?: string
	contentLayout?: ContentLayout
}

const {
	title = "Fiscalidad de ventas",
	activeTab,
	identityLabel,
	isIdentityConfigured,
	canManageFiscality,
	conflictCount = 0,
	pendingSyncCount = 0,
	tabCounts = {},
	scopeOptions = [],
	selectedScopeId = null,
	primaryLabel,
	primaryHref,
	primaryButtonClass = "",
	contentLayout = "card",
} = Astro.props

const showStackedNotices =
	contentLayout === "stacked" && (conflictCount > 0 || pendingSyncCount > 0 || !canManageFiscality)

const secondaryLinks = [
	{ label: "Identidad fiscal", href: routes.providerSettingsVerificationFiscal() },
	{ label: "Tarifas", href: routes.ratePlansList() },
	{ label: "Finanzas", href: routes.financialSettlements() },
	{ label: "Canales", href: routes.providerSettingsIntegrationsConnections() },
]
---

<WorkspaceLayout title={title}>
	<section class="space-y-6 md:space-y-8">
		<header class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-800 pb-5">
			<div class="min-w-0 space-y-1.5">
				<div
					class="flex flex-wrap items-center gap-1 text-xs font-semibold uppercase tracking-[0.02em] text-slate-400"
				>
					<span>Configuración comercial</span><FiscalScopeSwitcher
						options={scopeOptions}
						selectedId={selectedScopeId}
					/>
				</div>
				<h1 class="text-3xl font-semibold text-slate-100">Fiscalidad de ventas</h1>
				<p class="max-w-2xl text-sm leading-6 text-slate-400">
					Impuestos y cargos que se muestran al huésped.
				</p>
			</div>
			<div class="flex items-center gap-2">
				<details class="relative">
					<summary
						class="fastt-button flex h-10 cursor-pointer list-none items-center border border-white/20 bg-transparent px-4 text-sm font-semibold text-white hover:bg-white/10"
						>Relacionadas</summary
					>
					<div
						class="fastt-soft-box absolute right-0 z-20 mt-2 grid min-w-44 gap-1 rounded-[var(--fastt-radius-card)] border border-slate-200 bg-white p-1 shadow-lg"
					>
						{
							secondaryLinks.map((link) => (
								<a
									class="rounded px-3 py-2 text-sm text-slate-700 hover:bg-slate-50"
									href={link.href}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</details>
				{
					primaryLabel && primaryHref && canManageFiscality ? (
						<Button href={primaryHref} class={primaryButtonClass}>
							{primaryLabel}
						</Button>
					) : null
				}
			</div>
		</header>
		<div class="flex max-w-full flex-wrap items-center gap-x-3 border-b border-slate-800">
			<div class="w-full sm:min-w-0 sm:flex-1">
				<FiscalWorkspaceTabs
					active={activeTab}
					search={Astro.url.searchParams}
					counts={tabCounts}
					class="border-b-0"
				/>
			</div>
			<a
				href={routes.providerSettingsVerificationFiscal()}
				class="inline-flex shrink-0 items-center gap-2 self-stretch border-b-2 border-transparent px-1 text-sm font-medium text-slate-300 hover:border-slate-300 hover:text-white focus:border-slate-300 focus:text-white focus:outline-none"
			>
				<span class="size-1.5 rounded-full bg-emerald-400"></span>
				Identidad fiscal: {identityLabel}
			</a>
		</div>

		{
			contentLayout === "stacked" ? (
				<div class="space-y-5">
					{showStackedNotices ? (
						<div class="fastt-workspace-panel overflow-hidden p-0 text-slate-900">
							<FiscalStatusBar
								identityLabel={identityLabel}
								isIdentityConfigured={isIdentityConfigured}
								conflictCount={conflictCount}
								pendingSyncCount={pendingSyncCount}
								showIdentity={false}
							/>
							<FiscalPermissionNotice canManageFiscality={canManageFiscality} />
						</div>
					) : null}
					<slot />
				</div>
			) : (
				<div class="fastt-card overflow-hidden rounded-lg border border-slate-200 bg-white text-slate-900">
					<FiscalStatusBar
						identityLabel={identityLabel}
						isIdentityConfigured={isIdentityConfigured}
						conflictCount={conflictCount}
						pendingSyncCount={pendingSyncCount}
						showIdentity={false}
					/>
					<FiscalPermissionNotice canManageFiscality={canManageFiscality} />
					<div class="min-w-0 p-4 sm:p-6">
						<slot />
					</div>
				</div>
			)
		}
	</section>
</WorkspaceLayout>
