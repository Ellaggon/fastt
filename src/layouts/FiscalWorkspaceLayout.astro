---
import FiscalPermissionNotice from "@/components/tax-fees/FiscalPermissionNotice.astro"
import FiscalStatusBar from "@/components/tax-fees/FiscalStatusBar.astro"
import FiscalWorkspaceTabs from "@/components/tax-fees/FiscalWorkspaceTabs.astro"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro"
import {
	providerTaxIdentityPresentation,
	type ProviderTaxConfigurationStatus,
} from "@/lib/provider-tax-configuration"
import { routes } from "@/lib/routes"

type FiscalTab = "definitions" | "assignments" | "simulator" | "activity"

type ContentLayout = "card" | "stacked"

interface Props {
	title?: string
	activeTab: FiscalTab
	identityLabel: string
	isIdentityConfigured: boolean
	identityStatus?: ProviderTaxConfigurationStatus | null
	canManageFiscality: boolean
	conflictCount?: number
	pendingSyncCount?: number
	tabCounts?: Partial<Record<FiscalTab, number>>
	primaryLabel?: string
	primaryHref?: string
	primaryButtonClass?: string
	contentLayout?: ContentLayout
}

const {
	title = "Fiscalidad de ventas",
	activeTab,
	identityLabel,
	isIdentityConfigured,
	identityStatus = null,
	canManageFiscality,
	conflictCount = 0,
	pendingSyncCount = 0,
	tabCounts = {},
	primaryLabel,
	primaryHref,
	primaryButtonClass = "",
	contentLayout = "card",
} = Astro.props

const showStackedNotices =
	contentLayout === "stacked" && (conflictCount > 0 || pendingSyncCount > 0 || !canManageFiscality)
const identity = providerTaxIdentityPresentation(identityStatus ?? "not_configured")
---

<WorkspaceLayout title={title}>
	<section class="space-y-6 md:space-y-8">
		<header class="flex flex-col gap-2">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl md:text-3xl">
					Fiscalidad de ventas
				</h1>
				{
					primaryLabel && primaryHref && canManageFiscality ? (
						<Button href={primaryHref} class={`shrink-0 ${primaryButtonClass}`.trim()}>
							{primaryLabel}
						</Button>
					) : null
				}
			</div>
			<p class="max-w-3xl text-sm leading-5 text-slate-300 sm:leading-6">
				Impuestos y cargos que se muestran al huésped.
			</p>
			<a
				href={routes.providerSettingsVerificationFiscal()}
				class="inline-flex w-fit items-center gap-2 text-xs font-semibold text-slate-400 hover:text-slate-200"
			>
				Identidad fiscal
				<Badge variant={identity.darkBadge}>{identity.label}</Badge>
			</a>
		</header>

		<FiscalWorkspaceTabs
			active={activeTab}
			search={Astro.url.searchParams}
			counts={tabCounts}
			class="max-w-full flex-nowrap"
		/>

		{
			contentLayout === "stacked" ? (
				<div class="space-y-5">
					{showStackedNotices ? (
						<div class="fastt-workspace-panel overflow-hidden p-0 text-slate-900">
							<FiscalStatusBar
								identityLabel={identity.label}
								isIdentityConfigured={isIdentityConfigured}
								identityStatus={identityStatus}
								conflictCount={conflictCount}
								pendingSyncCount={pendingSyncCount}
								showIdentity={false}
							/>
							<FiscalPermissionNotice canManageFiscality={canManageFiscality} />
						</div>
					) : null}
					<slot />
				</div>
			) : (
				<div class="fastt-card overflow-hidden rounded-lg border border-slate-200 bg-white text-slate-900">
					<FiscalStatusBar
						identityLabel={identity.label}
						isIdentityConfigured={isIdentityConfigured}
						identityStatus={identityStatus}
						conflictCount={conflictCount}
						pendingSyncCount={pendingSyncCount}
						showIdentity={false}
					/>
					<FiscalPermissionNotice canManageFiscality={canManageFiscality} />
					<div class="min-w-0 p-4 sm:p-6">
						<slot />
					</div>
				</div>
			)
		}
	</section>
</WorkspaceLayout>
