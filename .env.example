# Auth (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AUTH_PASSWORD_RESET_REDIRECT_URL=https://fastt-five.vercel.app/auth/reset-password

# Local-only auth bypass for provider/dashboard development.
# LOCAL_QA_AUTH_USER_ID must be a real User.id that has a ProviderUser link
# for LOCAL_QA_PROVIDER_ID (or leave a stub id — runtime resolves by email).
# LOCAL_QA_AUTH_ENABLED=true
# LOCAL_QA_AUTH_USER_ID=34547ff8-b160-4f1b-ba32-686280393282
# LOCAL_QA_AUTH_EMAIL=ellaggon@gmail.com
# LOCAL_QA_PROVIDER_ID=ee5a2896-e534-43f2-92a1-336d1b8ac6e7

# Internal admin RBAC. Comma-separated emails allowed to access /admin and /api/admin surfaces.
INTERNAL_ADMIN_EMAILS=

# Supabase Postgres (business database, migration target)
# Runtime/serverless traffic should use the Supabase transaction pooler URL.
# Must be a single valid URL (no spaces). If your shell has a corrupted DATABASE_URL,
# Vitest strips it via tests/setup/clean-db-env.ts and reloads from this file.
DATABASE_URL=
SUPABASE_DB_POOLER_URL=
# Direct database URL is reserved for migrations, dumps, restores, and admin tasks.
DIRECT_URL=
# Test database: required for every DB-backed Vitest suite. It must point to a
# separate Supabase project/database, never the runtime URL. Copy these values
# to .env.test locally; CI uses the DATABASE_URL_TEST secret.
# DATABASE_URL_TEST=postgresql://...
# FASTT_TEST_DATABASE=1

# Vercel Cron authenticates scheduled iCal imports with this Bearer secret.
# Generate at least 16 random characters, configure it in Production, and never expose it publicly.
# CRON_SECRET=
# Optional worker tuning (defaults: 20 feeds per run, 3 concurrent downloads).
# EXTERNAL_CALENDAR_SYNC_BATCH_SIZE=20
# EXTERNAL_CALENDAR_SYNC_CONCURRENCY=3
# Encrypts private iCal URLs and OAuth integration tokens with AES-256-GCM. Required in Production.
# Generate independently from payout/OAuth secrets: openssl rand -base64 48
# PROVIDER_INTEGRATION_SECRETS_KEY=
# During rotation, keep old comma-separated keys available until URLs/tokens using old keys are re-encrypted.
# PROVIDER_INTEGRATION_SECRETS_PREVIOUS_KEYS=

# Channex certification fixture: a non-commercial tenant created only by the controlled bootstrap.
# It never falls back to LOCAL_QA_PROVIDER_ID and never targets production.
# CHANNEX_STAGING_API_KEY=
# Optional but recommended: selected staging property to validate during bootstrap.
# CHANNEX_CERTIFICATION_PROPERTY_ID=

# Shared cache (Redis/Upstash). Use REDIS_URL=redis:// or rediss:// for Redis.
# For Upstash REST, use UPSTASH_REDIS_REST_URL=https://... plus UPSTASH_REDIS_REST_TOKEN=...
# Choose the Redis region close to Vercel SSR execution. If Vercel runs in gru1,
# prefer Upstash/AWS sa-east-1. If the fallback is iad1, prefer us-east-1.
REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protects /api/internal/observability/infra-region in deployed environments.
# Bearer token for internal observability endpoints:
# /api/internal/observability/infra-region, prometheus, tours-rollout
# When unset, those endpoints allow only outside production.
# FASTT_INFRA_HEALTH_TOKEN=

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Payout account encryption (AES-256-GCM). Generate locally — do NOT reuse app passwords.
#   openssl rand -base64 48
# Put the output as the value. Required in production; local/test has a deterministic fallback.
PROVIDER_PAYOUT_SECRETS_KEY=

# Transactional email (provider invites, etc.). Default sink: structured log (no inbox).
# EMAIL_PROVIDER=log
# For real delivery (staging/prod on Vercel):
#   1. Verify your domain in Resend (DNS).
#   2. Set EMAIL_PROVIDER=resend, RESEND_API_KEY, EMAIL_FROM (must match verified domain; no .local).
#   3. Set PUBLIC_APP_URL to the deployed origin so invite links are absolute.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Fastt <noreply@your-verified-domain.com>
# Absolute links in emails (optional; falls back to request origin):
# PUBLIC_APP_URL=https://app.example.com
# SITE_URL=https://app.example.com
# Optional live smoke (skips when RESEND_API_KEY unset):
#   INVITE_SMOKE_TO=you@example.com pnpm smoke:invite-resend
# Readiness (no send):
#   pnpm check:email-staging
# Mocked create→mail token→accept E2E:
#   pnpm test:invite-email
# Vercel Preview/Production must set the same EMAIL_* vars after Resend domain verify.

# External alerts for provider integration incidents. Best-effort; empty means UI-only.
# Sends only error/critical incidents, with cooldown to avoid repeated noise.
# PROVIDER_INTEGRATION_INCIDENT_EMAIL_TO=ops@example.com,tech@example.com
# PROVIDER_INTEGRATION_INCIDENT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PROVIDER_INTEGRATION_INCIDENT_NOTIFICATION_COOLDOWN_MINUTES=360
# PROVIDER_INTEGRATION_ALERT_CONSECUTIVE_FAILURES=3

# Integration operational retention. Purge is bounded and never removes queued/running work.
# PROVIDER_INTEGRATION_INACTIVE_EVENT_RETENTION_DAYS=30
# PROVIDER_INTEGRATION_ENDED_EVENT_RETENTION_DAYS=180
# PROVIDER_INTEGRATION_SUCCESSFUL_RUN_RETENTION_DAYS=90
# PROVIDER_INTEGRATION_FAILED_RUN_RETENTION_DAYS=180
# PROVIDER_INTEGRATION_SUCCESSFUL_JOB_RETENTION_DAYS=14
# PROVIDER_INTEGRATION_FAILED_JOB_RETENTION_DAYS=90
# PROVIDER_INTEGRATION_PURGE_BATCH_SIZE=1000

# Payout ownership rail (μ-deposits). Default: simulated (no bank ACH).
# PAYOUT_RAIL_PROVIDER=simulated
# Stripe ACH live (US). Opt-in — never enable by key alone:
# PAYOUT_RAIL_PROVIDER=stripe_connect
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYOUT_RAIL_LIVE=1
# microdeposits (default) = SetupIntent us_bank_account + verify_microdeposits
# financial_connections = FC session (client_secret; completar link en host UI)
# PAYOUT_RAIL_VERIFICATION=microdeposits
# PAYOUT_RAIL_VERIFICATION=financial_connections

# TIN / taxpayer bureau (beyond format). Default: format_only.
# TIN_BUREAU_PROVIDER=format_only
# TIN_BUREAU_PROVIDER=simulated
# TIN_BUREAU_PROVIDER=irs_tin_matching
# TIN_BUREAU_API_KEY=
# TIN_BUREAU_API_URL=https://vendor.example/tin-match
# Opt-in live match (never enable by key alone):
# TIN_BUREAU_LIVE=1

# Identity vendor selfie+liveness (V3 optional market). Default: off (V1–V2 manual UX).
# Host selfie card ONLY when LIVE=1 + API_URL + API_KEY (P3). Never substitutes P0 manual upload / Documentos permission.
# IDENTITY_VENDOR_PROVIDER=off
# IDENTITY_VENDOR_PROVIDER=simulated
# IDENTITY_VENDOR_PROVIDER=persona
# IDENTITY_VENDOR_PROVIDER=jumio
# IDENTITY_VENDOR_API_KEY=
# IDENTITY_VENDOR_API_URL=https://vendor.example/id
# IDENTITY_VENDOR_TEMPLATE_ID=
# Opt-in live session (never enable by key alone):
# IDENTITY_VENDOR_LIVE=1

# Connector auth. Secrets are encrypted in ProviderIntegrationCredential.
# CONNECTOR_AUTH_PROVIDER=none
# CONNECTOR_AUTH_PROVIDER=oauth2
# CONNECTOR_OAUTH_CLIENT_ID=
# CONNECTOR_OAUTH_CLIENT_SECRET=
# CONNECTOR_OAUTH_AUTHORIZE_URL=https://vendor.example/oauth/authorize
# CONNECTOR_OAUTH_TOKEN_URL=https://vendor.example/oauth/token
# Opt-in token exchange (never enable by client id alone):
# CONNECTOR_OAUTH_LIVE=1
# Optional HMAC secret for OAuth state (defaults to client secret):
# CONNECTOR_OAUTH_STATE_SECRET=

# Provider settings funnel telemetry (blocker→CTA→complete).
# SETTINGS_FUNNEL_SINK=log
# Persist + query (ProviderAuditLog entityType=SettingsFunnel):
# SETTINGS_FUNNEL_SINK=db
# SETTINGS_FUNNEL_SINK=both
# SETTINGS_FUNNEL_SINK=noop
# Query: GET /api/admin/providers/settings-funnel
# CLI:   pnpm query:settings-funnel [--provider=id]

# TOKEN_VALUE=
# ASTRO_STUDIO_APP_TOKEN=

# AI agents (opcional)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Tours vertical kill-switches (env-only; default false). Guest x-flag/query cannot re-enable.
# TOURS_CHECKOUT_ENABLED=true
# TOURS_REFUND_HOURS_ENABLED=true
# TOURS_CHECKIN_ENABLED=true
# TOURS_PUBLIC_SEARCH_ENABLED=true

# Tours canary sequence: staging → allowlist → percentage → general (see docs/engineering/tours-rollout-canary.md)
# Stage is fail-closed: unset/typo → off (does not enable traffic).
# TOURS_ROLLOUT_STAGE=staging
# TOURS_PROVIDER_ALLOWLIST=prov_id_1,prov_id_2
# TOURS_ROLLOUT_PERCENT=10
# TOURS_ROLLOUT_STAGING_HOSTS=localhost,staging.example.com
# TOURS_ROLLOUT_DEPLOYMENT_ENV=staging
# Optional pinned stage-entered timestamp (ISO or epoch ms) for dwell window:
# TOURS_ROLLOUT_STAGE_ENTERED_AT=2026-08-01T00:00:00.000Z
# Minimum dwell before expand=true (default 24h):
# TOURS_ROLLOUT_MIN_DWELL_MS=86400000

# Tours rollout alert baselines (shared counters → /api/internal/observability/tours-rollout + prometheus)
# Alert rules: docs/ops/tours-rollout.rules.yml
# TOURS_ROLLOUT_MIN_HOLD_CONFIRM_RATE=0.55
# TOURS_ROLLOUT_MAX_HOLD_FAILURE_RATE=0.35
# TOURS_ROLLOUT_MIN_REDEEM_ISSUED_RATE=0.2
# TOURS_ROLLOUT_MAX_REFUND_QUOTE_GAP_RATE=0.25
# TOURS_ROLLOUT_MIN_SAMPLE_SIZE=20

# Search shadow comparison / rollout
SEARCH_SHADOW_COMPARE=false
SEARCH_SHADOW_SAMPLING_RATE=0.1

# Search health thresholds
SEARCH_MAX_SELLABLE_MISMATCH_RATE=0.01
SEARCH_MAX_REASON_MISMATCH_RATE=0.05
SEARCH_MAX_PRICE_MISMATCH_RATE=0.02
SEARCH_MAX_CRITICAL_MISMATCH_RATE=0.005

# Rollout percentage for the rules/policies UI. 0 disables, 100 enables for everyone.
RULES_UI_ENABLED=100
