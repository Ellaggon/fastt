# Auth (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AUTH_PASSWORD_RESET_REDIRECT_URL=https://fastt-five.vercel.app/auth/reset-password

# Local-only auth bypass for provider/dashboard development.
# LOCAL_QA_AUTH_ENABLED=true
# LOCAL_QA_AUTH_USER_ID=qa-user-ellaggon-gmail-com
# LOCAL_QA_AUTH_EMAIL=ellaggon@gmail.com
# LOCAL_QA_PROVIDER_ID=qa-financial-provider-ellaggon

# Internal admin RBAC. Comma-separated emails allowed to access /admin and /api/admin surfaces.
INTERNAL_ADMIN_EMAILS=

# Astro DB (libsql/Turso)
ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=

# Supabase Postgres (business database, migration target)
# Runtime/serverless traffic should use the Supabase transaction pooler URL.
DATABASE_URL=
SUPABASE_DB_POOLER_URL=
# Direct database URL is reserved for migrations, dumps, restores, and admin tasks.
DIRECT_URL=

# Shared cache (Redis/Upstash). Use REDIS_URL=redis:// or rediss:// for Redis.
# For Upstash REST, use UPSTASH_REDIS_REST_URL=https://... plus UPSTASH_REDIS_REST_TOKEN=...
# Choose the Redis region close to Vercel SSR execution. If Vercel runs in gru1,
# prefer Upstash/AWS sa-east-1. If the fallback is iad1, prefer us-east-1.
REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protects /api/internal/observability/infra-region in deployed environments.
# Use this for regional DB/cache latency checks from preview/production.
# FASTT_INFRA_HEALTH_TOKEN=

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Payout account encryption (AES-256-GCM). Generate locally — do NOT reuse app passwords.
#   openssl rand -base64 48
# Put the output as the value. Required in production; local/test has a deterministic fallback.
PROVIDER_PAYOUT_SECRETS_KEY=

# Transactional email (provider invites, etc.). Default sink: structured log (no inbox).
# EMAIL_PROVIDER=log
# For real delivery (staging/prod on Vercel):
#   1. Verify your domain in Resend (DNS).
#   2. Set EMAIL_PROVIDER=resend, RESEND_API_KEY, EMAIL_FROM (must match verified domain; no .local).
#   3. Set PUBLIC_APP_URL to the deployed origin so invite links are absolute.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Fastt <noreply@your-verified-domain.com>
# Absolute links in emails (optional; falls back to request origin):
# PUBLIC_APP_URL=https://app.example.com
# SITE_URL=https://app.example.com
# Optional live smoke (skips when RESEND_API_KEY unset):
#   INVITE_SMOKE_TO=you@example.com pnpm smoke:invite-resend
# Readiness (no send):
#   pnpm check:email-staging
# Mocked create→mail token→accept E2E:
#   pnpm test:invite-email
# Vercel Preview/Production must set the same EMAIL_* vars after Resend domain verify.

# Payout ownership rail (μ-deposits). Default: simulated (no bank ACH).
# PAYOUT_RAIL_PROVIDER=simulated
# Stripe ACH live (US). Opt-in — never enable by key alone:
# PAYOUT_RAIL_PROVIDER=stripe_connect
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYOUT_RAIL_LIVE=1
# microdeposits (default) = SetupIntent us_bank_account + verify_microdeposits
# financial_connections = FC session (client_secret; completar link en host UI)
# PAYOUT_RAIL_VERIFICATION=microdeposits
# PAYOUT_RAIL_VERIFICATION=financial_connections

# TIN / taxpayer bureau (beyond format). Default: format_only.
# TIN_BUREAU_PROVIDER=format_only
# TIN_BUREAU_PROVIDER=simulated
# TIN_BUREAU_PROVIDER=irs_tin_matching
# TIN_BUREAU_API_KEY=
# TIN_BUREAU_API_URL=https://vendor.example/tin-match
# Opt-in live match (never enable by key alone):
# TIN_BUREAU_LIVE=1

# Connector auth. Default: credentialsRef + smoke (no OAuth).
# CONNECTOR_AUTH_PROVIDER=none
# CONNECTOR_AUTH_PROVIDER=oauth2
# CONNECTOR_OAUTH_CLIENT_ID=
# CONNECTOR_OAUTH_CLIENT_SECRET=
# CONNECTOR_OAUTH_AUTHORIZE_URL=https://vendor.example/oauth/authorize
# CONNECTOR_OAUTH_TOKEN_URL=https://vendor.example/oauth/token
# Opt-in token exchange (never enable by client id alone):
# CONNECTOR_OAUTH_LIVE=1
# Optional HMAC secret for OAuth state (defaults to client secret):
# CONNECTOR_OAUTH_STATE_SECRET=

# Provider settings funnel telemetry (blocker→CTA→complete).
# SETTINGS_FUNNEL_SINK=log
# Persist + query (ProviderAuditLog entityType=SettingsFunnel):
# SETTINGS_FUNNEL_SINK=db
# SETTINGS_FUNNEL_SINK=both
# SETTINGS_FUNNEL_SINK=noop
# Query: GET /api/admin/providers/settings-funnel
# CLI:   pnpm query:settings-funnel [--provider=id]

# TOKEN_VALUE=
# ASTRO_STUDIO_APP_TOKEN=

# AI agents (opcional)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Search shadow comparison / rollout
SEARCH_SHADOW_COMPARE=false
SEARCH_SHADOW_SAMPLING_RATE=0.1

# Search health thresholds
SEARCH_MAX_SELLABLE_MISMATCH_RATE=0.01
SEARCH_MAX_REASON_MISMATCH_RATE=0.05
SEARCH_MAX_PRICE_MISMATCH_RATE=0.02
SEARCH_MAX_CRITICAL_MISMATCH_RATE=0.005

# Rollout percentage for the rules/policies UI. 0 disables, 100 enables for everyone.
RULES_UI_ENABLED=100
